#!/bin/bash

VERBOSE=false
AUR_MODE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Interactive font package installer using fzf.

Options:
  -v, --verbose  Enable verbose output
  --aur          Install fonts from AUR instead of official repos
  -h, --help     Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    --aur)
      AUR_MODE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

source vb-lib-core

if [[ "$AUR_MODE" == true ]]; then
  PREVIEW_CMD='yay -Sii {1}'
else
  PREVIEW_CMD='pacman -Si {1}'
fi

if [[ -f "$XDG_CONFIG_HOME/vibranium/current/theme/fzf" ]]; then
  source "$XDG_CONFIG_HOME/vibranium/current/theme/fzf"
fi

FZF_ARGS=(
  --multi
  --ignore-case
  --highlight-line

  --info 'hidden'
  --border 'bold'

  --border-label ' alt-p: toggle description, alt-j/k: scroll description, ctrl-j/k: next/prev item, tab: multi-select '
  --border-label-pos 'bottom'

  --list-label 'Package list'
  --list-border 'bold'

  --input-label 'Filter packages'
  --input-border 'bold'

  --preview "$PREVIEW_CMD"
  --preview-border 'bold'
  --preview-window 'right:75%:wrap'
  --preview-label 'Package Information'

  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'

  --color "${FZF_COLORS:-pointer:white,marker:green}"
)

_operation_canceled() {
  local color="$RED"

  [[ "$1" == "--positive" ]] && color="$GREEN"

  printf "%s[VIBRANIUM]%s Operation canceled" "$color" "$RESET"
  trap 'exit 1' SIGHUP SIGINT SIGTERM SIGQUIT
  term::disable_input
  # shellcheck disable=SC2034
  read -n1 -r -s -p $'. Press any key to exit' dummy
}

_get_fonts() {
  log Info "Fetching font packages"
  local pkg

  if [[ "$AUR_MODE" == true ]]; then
    local cmd=(yay -Slqa)
  else
    local cmd=(pacman -Slq)
  fi

  while IFS= read -r pkg; do
    case "$pkg" in
      ttf*-nerd-mono | ttf*-nerd | ttf* | \
        otf*-nerd-mono | otf*-nerd | otf*)
        printf '%s\n' "$pkg"
        ;;
    esac
  done < <("${cmd[@]}")
}

trap 'trap "exit 1" SIGINT; printf "\n"; _operation_canceled; exit 1' SIGINT

term::show_header
term::disable_input

(_get_fonts > "$VIBRANIUM_CACHE/${0##*/}.list") &
term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Getting font packages"

LIST="$(< "$VIBRANIUM_CACHE/${0##*/}.list")"
mapfile -t chosen < <(printf "%s\n" "${LIST[@]}" | fzf "${FZF_ARGS[@]}")

term::enable_input
rm -f "$VIBRANIUM_CACHE/${0##*/}.list"

if [[ ${#chosen[@]} -eq 0 ]]; then
  _operation_canceled --positive
  exit 0
fi

log Info "${#chosen[@]} font(s) selected"
if vb-pkg-install --no-logo --no-verify -- "${chosen[@]}"; then
  exec setsid -f fc-cache -f
fi
