#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}
AUR_MODE=false

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Interactive font package installer using fzf.

Options:
  -v, --verbose  Enable verbose output
  --aur          Install fonts from AUR instead of official repos
  -h, --help     Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    --aur)
      AUR_MODE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

source vb-lib-core

# Single preview entry point for the fzf font list: repository metadata
# when the package exists in the official repos, AUR metadata otherwise.
# Keeps FZF_FLAGS below static while preserving per-mode behavior (official
# info in repo mode, AUR info in AUR mode). Exported so fzf's preview
# subshell (bash -c) can call it.
_pkg_info() {
  local pkg=$1
  if pacman -Si "$pkg" 2> /dev/null; then
    return 0
  fi
  if command -v yay > /dev/null 2>&1; then
    yay -Sii "$pkg" 2> /dev/null
  fi
}
export -f _pkg_info

if [[ -f "$VIBRANIUM_STATE/theme/fzf" ]]; then
  source "$VIBRANIUM_STATE/theme/fzf"
fi

FZF_FLAGS=(
  --multi
  --ignore-case
  --highlight-line

  --info 'hidden'
  --border 'bold'

  --border-label ' alt-p: toggle description, alt-j/k: scroll description, alt-b/B: PKGBUILD, alt-i: info, ctrl-j/k: next/prev item, tab: multi-select '
  --border-label-pos 'bottom'

  --list-label 'Package list'
  --list-border 'bold'

  --input-label 'Filter packages'
  --input-border 'bold'

  --preview '_pkg_info {1}'
  --preview-border 'bold'
  --preview-window 'right:75%:wrap'
  --preview-label 'Package Information'

  --bind 'alt-p:toggle-preview'
  --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
  --bind 'alt-B:change-preview:yay -Siia {1}'
  --bind 'alt-i:change-preview:_pkg_info {1}'

  --color "${FZF_COLORS:-pointer:white,marker:green}"
)

font_install_prepare_result() {
  if [[ -z "${term_original_settings:-}" ]]; then
    term::disable_input
  fi
}

font_install_signal_canceled() {
  trap - SIGHUP SIGINT SIGTERM SIGQUIT
  if [[ -n "${VIBRANIUM_CACHE:-}" ]]; then
    rm -f "$VIBRANIUM_CACHE/${0##*/}.list"
  fi
  font_install_prepare_result
  operation::result canceled
  exit 1
}

# Case patterns are ordered from the most specific Nerd Font suffixes to broad
# font prefixes, so one package name is emitted once despite overlapping globs.
_get_fonts() {
  log Info "Fetching font packages"
  local pkg

  if [[ "$AUR_MODE" == true ]]; then
    local cmd=(yay -Slqa)
  else
    local cmd=(pacman -Slq)
  fi

  while IFS= read -r pkg; do
    case "$pkg" in
      ttf*-nerd-mono | ttf*-nerd | ttf* | \
        otf*-nerd-mono | otf*-nerd | otf*)
        printf '%s\n' "$pkg"
        ;;
    esac
  done < <("${cmd[@]}")
}

# The cache file is a hand-off between background enumeration and fzf; signal
# cleanup removes it and restores terminal state so cancellation cannot leave
# a spinner or stale selection list behind.
trap 'font_install_signal_canceled' SIGHUP SIGINT SIGTERM SIGQUIT

term::show_header
term::disable_input

(_get_fonts > "$VIBRANIUM_CACHE/${0##*/}.list") &
term::spinner $! "${Y}[*]${RS} Getting font packages"

mapfile -t _font_list < "$VIBRANIUM_CACHE/${0##*/}.list"
mapfile -t chosen < <(printf '%s\n' "${_font_list[@]}" | fzf "${FZF_FLAGS[@]}")

term::enable_input
rm -f "$VIBRANIUM_CACHE/${0##*/}.list"

if [[ ${#chosen[@]} -eq 0 ]]; then
  font_install_prepare_result
  operation::result noop -- "Operation canceled"
  exit 0
fi

install_args=()
if [[ "$AUR_MODE" == true ]]; then
  install_args+=(--aur)
fi

log Info "${#chosen[@]} font(s) selected"
if vb-pkg-install --no-logo --no-verify "${install_args[@]}" -- "${chosen[@]}"; then
  # The font cache is rebuilt and the shell's font list rescanned without the
  # installer waiting for either, so a freshly installed family shows up in
  # Settings > General > Font Selection instead of on the next shell restart.
  # The whole command is detached, not just its first step: the rescan has to
  # follow the rebuild, and one detached process is what orders them.
  setsid -f vb-cmd-font-refresh &> /dev/null
fi
