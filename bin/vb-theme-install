#!/bin/bash

source vb-lib-cli

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION] [URL|owner/repo]

Install a community theme from a Git repository.

Options:
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

source vb-lib-core

set -- "${1%/}"

_operation_canceled() {
  printf "%s[VIBRANIUM]%s Operation canceled" "$R" "$RS"
  trap 'exit 1' SIGHUP SIGINT SIGTERM SIGQUIT
  term::disable_input

  # shellcheck disable=SC2034
  read -n1 -r -s -p $'. Press any key to exit' dummy
}

trap 'trap "exit 1" INT HUP; printf "\n"; _operation_canceled; exit 1' INT HUP

# Return true if the input looks like a GitHub owner/repo shorthand.
# Accepts alphanumeric characters, hyphens, underscores, and dots on
# both sides of exactly one slash, with no scheme prefix.
_is_owner_repo_format() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]
}

# Expand an owner/repo shorthand into a full GitHub HTTPS clone URL.
# .git is appended so git-clone gets a canonical remote URL.
_owner_repo_to_url() {
  echo "https://github.com/$1.git"
}

if [[ -z "$1" ]]; then
  term::show_header
fi

# If an argument was passed, use it directly and skip the prompt loop.
# If it is owner/repo shorthand, verify the repo exists on GitHub first,
# then expand it to a full URL. A bare https URL is used as-is.
# Otherwise, keep asking until the user gives valid input (or hits Ctrl+C).
if [[ -n "$1" ]]; then
  if _is_owner_repo_format "$1"; then
    # Run the existence check in the background so term::spinner can show progress
    curl -sf -o /dev/null "https://api.github.com/repos/$1" &
    if ! term::spinner $! "${Y}[VIBRANIUM]${RS} Checking repo $1"; then
      vb::print "$R" "GitHub repo $1 does not exist or could not be reached"
      _operation_canceled
      exit 1
    fi
    REPO_URL="$(_owner_repo_to_url "$1")"
  elif [[ "$1" =~ ^https?:// ]]; then
    REPO_URL="$1"
  else
    vb::print "$R" "Argument must be an http(s) URL or owner/repo shorthand"
    _operation_canceled
    exit 1
  fi
else
  while true; do
    read -erp "${Y}[VIBRANIUM]${RS} Git repo: " REPO_URL || {
      _operation_canceled
      exit 1
    }
    REPO_URL="${REPO_URL%/}"

    if [[ -z "$REPO_URL" ]]; then
      vb::print "$R" "No input provided. Try again."
      continue
    fi

    # A full https URL needs no further validation at this stage
    if [[ "$REPO_URL" =~ ^https?:// ]]; then
      break
    fi

    # owner/repo shorthand: check that the repo actually exists before proceeding
    if _is_owner_repo_format "$REPO_URL"; then
      curl -sf -o /dev/null "https://api.github.com/repos/$REPO_URL" &
      if ! term::spinner $! "${Y}[VIBRANIUM]${RS} Checking repo $REPO_URL"; then
        vb::print "$R" "GitHub repo $REPO_URL does not exist. Try again."
        continue
      fi

      REPO_URL="$(_owner_repo_to_url "$REPO_URL")"
      break
    fi

    vb::print "$R" "Provide an http(s) URL or owner/repo shorthand (e.g. user/repo)"
  done
fi

# Extract owner/repo from GitHub URL for the API, stripping scheme, host, and .git suffix
REPO_PATH="${REPO_URL#https://github.com/}"
REPO_PATH="${REPO_PATH%.git}"
REPO_PATH="${REPO_PATH%/}" # guard against a trailing slash

THEME_NAME="${REPO_URL%.git}"
THEME_NAME="${THEME_NAME##*/}"

# Strip the vendor prefix. This leaves a leading dash when the repo name is
# "vibranium-foo-theme", because the prefix pattern ends right before the
# first separator.
THEME_NAME="${THEME_NAME#vibranium}"

# Remove the leading dash that is left after stripping the vendor prefix above.
# Without this, a repo named "vibranium-miasma-theme" produces "-miasma-theme",
# which becomes a folder with a leading dash and a leading space in menus.
THEME_NAME="${THEME_NAME#-}"

# Strip the word "theme" however it appears in what remains.
# "vibranium-theme-miasma" -> after prefix strip: "theme-miasma" -> strip "theme-" -> "miasma"
# "vibranium-miasma-theme" -> after prefix strip: "miasma-theme" -> strip "-theme" -> "miasma"
THEME_NAME="${THEME_NAME#theme-}"
THEME_NAME="${THEME_NAME%-theme}"

THEME_DISP_NAME=""

for _word in ${THEME_NAME//-/ }; do
  THEME_DISP_NAME+="${_word^} "
done

THEME_DISP_NAME="${THEME_DISP_NAME% }"
THEME_NAME_CLR="${B}${THEME_DISP_NAME}${RS}"

THEMES_DIR="$XDG_CONFIG_HOME/vibranium/themes"
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Official themes ship inside the Vibranium repo itself. A community theme whose
# derived name collides with an official one would silently shadow it after install,
# so we refuse early rather than letting that happen.
OFF_THEME_PATH="$VIBRANIUM/themes/$THEME_NAME"
if [[ -d "$OFF_THEME_PATH" ]]; then
  vb::print "$R" "$THEME_NAME_CLR is an official Vibranium theme and cannot be overwritten by a community install."
  _operation_canceled
  exit 1
fi

# Fetch the repo root listing once - checks both candidate files in a single request
# so we don't risk hitting the GitHub API rate limit with two separate calls
CONT_FILE="/tmp/${0##*/}.tmp"
curl -sf "https://api.github.com/repos/$REPO_PATH/contents/" --output "$CONT_FILE" &

if ! term::spinner $! "${Y}[VIBRANIUM]${RS} Checking theme compatibility"; then
  vb::print "$R" "Could not reach repo or repo does not exist"
  _operation_canceled
  exit 1
fi

# Match strictly against the JSON name field - guards against partial matches
# (e.g. a file called "my-colors.list" must not pass)
CONTENTS="$(< "$CONT_FILE")"
if [[ "$CONTENTS" != *'"name": "colors.list"'* ]]; then
  vb::print "$R" "$THEME_NAME_CLR is not a Vibranium-compatible theme"

  rm -f "$CONT_FILE"
  _operation_canceled
  exit 1
fi

vb::print "$G" "$THEME_NAME_CLR is compatible with Vibranium"

rm -f "$CONT_FILE"

# Remove stale copy of this theme if one already exists, keeping user
# wallpapers: a community clone tracks its theme files, so untracked files
# in backgrounds/ are user additions. An archived theme (see vb-theme-remove)
# consists of user wallpapers only.
if [[ -d "$THEME_PATH" ]]; then
  if ! term::ask_yes_no Y "$THEME_NAME_CLR already exists. Do you want to reinstall it?"; then
    _operation_canceled
    exit 1
  fi

  preserved="$(mktemp -d)"
  if [[ -d "$THEME_PATH/.git" ]]; then
    uf=()
    mapfile -d '' -t uf < <(git -C "$THEME_PATH" ls-files --others --exclude-standard -z -- backgrounds)
    for f in "${uf[@]}"; do
      mv "$THEME_PATH/$f" "$preserved"/
    done
  elif [[ -d "$THEME_PATH/backgrounds" ]]; then
    shopt -s nullglob
    for f in "$THEME_PATH/backgrounds"/*; do
      mv "$f" "$preserved"/
    done
    shopt -u nullglob
  fi

  rm -rf "$THEME_PATH"
else
  preserved=""
fi

git clone --quiet --depth 1 "$REPO_URL" "$THEME_PATH" &
if ! term::spinner $! "${Y}[VIBRANIUM]${RS} Downloading $THEME_NAME_CLR" "- ${G}Done${RS}"; then
  vb::print "$R" "Failed to clone theme repo"
  _operation_canceled
  exit 1
fi

# Restore preserved user wallpapers into the fresh clone
if [[ -n "$preserved" ]]; then
  mkdir -p "$THEME_PATH/backgrounds"
  shopt -s nullglob
  for f in "$preserved"/*; do
    mv "$f" "$THEME_PATH/backgrounds"/
  done
  shopt -u nullglob
  rm -rf "$preserved"
fi

exec setsid -f vb-theme-set "$THEME_NAME"
