#!/bin/bash

source vb-lib-cli

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION] [URL|owner/repo]

Install a community theme from a Git repository.

Options:
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

source vb-lib-core

set -- "${1%/}"

CONT_FILE=""
tmp_clone=""
preserved=""

# Error and INT/HUP handlers route through this cleanup. It removes known
# staging/API paths and restores a preserved wallpaper directory when one
# exists; the handoff path does not call it.
theme_install_cleanup() {
  if [[ -n "${tmp_clone:-}" ]]; then
    rm -rf -- "$tmp_clone"
  fi

  if [[ -n "${preserved:-}" ]]; then
    if [[ -n "${THEME_PATH:-}" ]]; then
      mkdir -p "$THEME_PATH/backgrounds"
      shopt -s nullglob
      for f in "$preserved"/*; do
        mv "$f" "$THEME_PATH/backgrounds/"
      done
      shopt -u nullglob
    fi
    rm -rf -- "$preserved"
  fi

  if [[ -n "${CONT_FILE:-}" ]]; then
    rm -f -- "$CONT_FILE"
  fi
}

theme_install_result() {
  local outcome="$1"

  theme_install_cleanup
  if [[ -z "${term_original_settings+x}" ]]; then
    term::disable_input
  fi
  operation::result "$outcome"
}

theme_install_canceled() {
  theme_install_result canceled
}

theme_install_error() {
  theme_install_result error
}

theme_install_interrupt() {
  trap 'exit 1' INT HUP
  printf '\n'
  theme_install_result canceled
  exit 1
}

trap 'theme_install_interrupt' INT HUP

# Return true if the input looks like a GitHub owner/repo shorthand.
# Accepts alphanumeric characters, hyphens, underscores, and dots on
# both sides of exactly one slash, with no scheme prefix.
_is_owner_repo_format() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]
}

# Expand an owner/repo shorthand into a full GitHub HTTPS clone URL.
# .git is appended so git-clone gets a canonical remote URL.
_owner_repo_to_url() {
  local -n _url_out=$1
  _url_out="https://github.com/$2.git"
}

if [[ -z "$1" ]]; then
  term::show_header
fi

# A supplied owner/repo is checked and expanded; an http(s) URL is retained.
# Without an argument, the prompt repeats until the input is accepted.
if [[ -n "$1" ]]; then
  if _is_owner_repo_format "$1"; then
    # Run the existence check in the background so term::spinner can show progress
    curl -sf -o /dev/null "https://api.github.com/repos/$1" &
    if ! term::spinner $! "${Y}[*]${RS} Checking repo $1"; then
      vb::print "$R" "GitHub repo $1 does not exist or could not be reached"
      theme_install_error
      exit 1
    fi
    _owner_repo_to_url REPO_URL "$1"
  elif [[ "$1" =~ ^https?:// ]]; then
    REPO_URL="$1"
  else
    vb::print "$R" "Argument must be an http(s) URL or owner/repo shorthand"
    theme_install_error
    exit 1
  fi
else
  term::enable_input
  while true; do
    if ! term::prompt_line REPO_URL "${Y}[*]${RS} Git repo: "; then
      theme_install_canceled
      exit 1
    fi
    REPO_URL="${REPO_URL%/}"

    if [[ -z "$REPO_URL" ]]; then
      vb::print "$R" "No input provided. Try again."
      continue
    fi

    # An http(s) URL is accepted without repository-shape validation at this stage.
    if [[ "$REPO_URL" =~ ^https?:// ]]; then
      break
    fi

    # owner/repo shorthand: verify the repository exists, then expand it.
    if _is_owner_repo_format "$REPO_URL"; then
      curl -sf -o /dev/null "https://api.github.com/repos/$REPO_URL" &
      if ! term::spinner $! "${Y}[*]${RS} Checking repo $REPO_URL"; then
        vb::print "$R" "GitHub repo $REPO_URL does not exist. Try again."
        continue
      fi

      _owner_repo_to_url REPO_URL "$REPO_URL"
      break
    fi

    vb::print "$R" "Provide an http(s) URL or owner/repo shorthand (e.g. user/repo)"
  done
fi

# REPO_PATH is literal: only the exact https://github.com/ prefix is removed;
# .git and one trailing slash are stripped afterward. Other http(s) URLs are
# not converted into a GitHub API path.
REPO_PATH="${REPO_URL#https://github.com/}"
REPO_PATH="${REPO_PATH%.git}"
REPO_PATH="${REPO_PATH%/}" # guard against a trailing slash

THEME_NAME="${REPO_URL%.git}"
THEME_NAME="${THEME_NAME##*/}"

# Strip the vendor prefix and any separator left by its removal so the
# resulting name remains suitable for a directory and display key.
THEME_NAME="${THEME_NAME#vibranium}"

# Remove the leading separator that can remain after prefix removal.
THEME_NAME="${THEME_NAME#-}"

# Remove only the `theme-` prefix and `-theme` suffix forms.
THEME_NAME="${THEME_NAME#theme-}"
THEME_NAME="${THEME_NAME%-theme}"

THEME_DISP_NAME=""

for _word in ${THEME_NAME//-/ }; do
  THEME_DISP_NAME+="${_word^} "
done

THEME_DISP_NAME="${THEME_DISP_NAME% }"
THEME_NAME_CLR="${B}${THEME_DISP_NAME}${RS}"

THEMES_DIR="$XDG_CONFIG_HOME/vibranium/themes"
THEME_PATH="$THEMES_DIR/$THEME_NAME"

# Refuse a derived name that collides with an official theme, because user
# themes would shadow the shipped directory during discovery.
OFF_THEME_PATH="$VIBRANIUM/themes/$THEME_NAME"
if [[ -d "$OFF_THEME_PATH" ]]; then
  vb::print "$R" "$THEME_NAME_CLR is an official Vibranium theme and cannot be overwritten by a community install."
  theme_install_error
  exit 1
fi

# Fetch the repository root listing once into a script-derived /tmp response.
# The predicate below tests colors.list without a second request; concurrent
# installers can overwrite this shared file, and handled cleanup removes it.
CONT_FILE="/tmp/${0##*/}.tmp"
curl -sf "https://api.github.com/repos/$REPO_PATH/contents/" --output "$CONT_FILE" &

if ! term::spinner $! "${Y}[*]${RS} Checking theme compatibility"; then
  vb::print "$R" "Could not reach repo or repo does not exist"
  theme_install_error
  exit 1
fi

# Compatibility uses a literal substring test for the JSON name field, not a
# full JSON parse; response formatting can affect the result.
_compat_found=false
while IFS= read -r _cont_line || [[ -n $_cont_line ]]; do
  if [[ $_cont_line == *'"name": "colors.list"'* ]]; then
    _compat_found=true
    break
  fi
done < "$CONT_FILE"
if [[ $_compat_found == false ]]; then
  vb::print "$R" "$THEME_NAME_CLR is not a Vibranium-compatible theme"

  rm -f "$CONT_FILE"
  theme_install_error
  exit 1
fi

vb::print "$G" "$THEME_NAME_CLR is compatible with Vibranium"

rm -f "$CONT_FILE"

# Existing managed clones are replaced while user-owned wallpaper paths are
# moved aside and restored. A directory without theme.info is treated as an
# archive or leftover and restored without a prompt.
restored_leftover=false
if [[ -d "$THEME_PATH" && ! -e "$THEME_PATH/theme.info" ]]; then
  vb::print "$Y" "$THEME_NAME_CLR leftovers found, restoring seamlessly"

  tmp_clone="$(mktemp -d)"
  git clone --quiet --depth 1 "$REPO_URL" "$tmp_clone" &
  if ! term::spinner $! "${Y}[*]${RS} Downloading $THEME_NAME_CLR" "- ${G}Done${RS}"; then
    rm -rf "$tmp_clone"
    vb::print "$R" "Failed to clone theme repo"
    theme_install_error
    exit 1
  fi

  preserved="$(mktemp -d)"
  shopt -s nullglob
  for f in "$THEME_PATH/backgrounds"/*; do
    mv "$f" "$preserved"/
  done
  shopt -u nullglob

  rm -rf "$THEME_PATH"
  mv "$tmp_clone" "$THEME_PATH"
  restored_leftover=true
elif [[ -d "$THEME_PATH" ]]; then
  if ! term::ask_yes_no Y "$THEME_NAME_CLR already exists. Do you want to reinstall it?"; then
    theme_install_canceled
    exit 1
  fi

  preserved="$(mktemp -d)"
  if [[ -d "$THEME_PATH/.git" ]]; then
    # git ls-files --others --exclude-standard returns untracked, non-ignored
    # paths under backgrounds. Those paths are treated as user-owned
    # wallpapers; tracked files and tracked wallpaper edits remain managed and
    # are replaced by the fresh checkout.
    uf=()
    mapfile -d '' -t uf < <(git -C "$THEME_PATH" ls-files --others --exclude-standard -z -- backgrounds)
    for f in "${uf[@]}"; do
      mv "$THEME_PATH/$f" "$preserved"/
    done
  elif [[ -d "$THEME_PATH/backgrounds" ]]; then
    shopt -s nullglob
    for f in "$THEME_PATH/backgrounds"/*; do
      mv "$f" "$preserved"/
    done
    shopt -u nullglob
  fi

  rm -rf "$THEME_PATH"
else
  preserved=""
fi

if ! $restored_leftover; then
  git clone --quiet --depth 1 "$REPO_URL" "$THEME_PATH" &
  if ! term::spinner $! "${Y}[*]${RS} Downloading $THEME_NAME_CLR" "- ${G}Done${RS}"; then
    vb::print "$R" "Failed to clone theme repo"
    theme_install_error
    exit 1
  fi
fi

# Restore preserved user wallpapers into the fresh clone
if [[ -n "$preserved" ]]; then
  mkdir -p "$THEME_PATH/backgrounds"
  shopt -s nullglob
  for f in "$preserved"/*; do
    mv "$f" "$THEME_PATH/backgrounds"/
  done
  shopt -u nullglob
  rm -rf "$preserved"
fi

# Hand off after clone and wallpaper restoration complete; theme-set performs
# template rendering and dependent reloads.
exec setsid -f vb-theme-set "$THEME_NAME"
