#!/usr/bin/env bash

source vb-core-lib

_usage() {
    cat <<EOF
Usage: ${0##*/} [OPTION]... [PACKAGE]...

Uninstall packages in Vibranium

Options:
  --no-logo         Do not display the logo at startup
  --no-dummy        Do not wait for a key press after completion or cancellation

If no PACKAGE is provided, list explicitly installed packages and use fzf for interactive selection.
Packages are filtered to those installed. Before removal, detects and disables enabled systemd units (services/sockets)
from the packages to clean up broken symlinks to systemd folders.
EOF
}

_ask_for_sudo() {
    echo -e "${YELLOW}[VIBRANIUM]${RESET} Pacman needs sudo to uninstall packages"
    sudo -v
}

_handle_systemd() {
    user_enabled_units=()
    system_enabled_units=()

    echo -e "${YELLOW}[VIBRANIUM]${RESET} Getting systemd service information..."

    declare -A seen_system=()
    declare -A seen_user=()

    # map unit -> package for user and system scope
    declare -A unit_pkg_user=()
    declare -A unit_pkg_system=()

    for pkg in "${PACKAGES[@]}"; do
        while IFS= read -r file; do
            [[ -z "$file" ]] && continue

            # extract the path (second field). pacman -Ql uses a single space separator.
            path="${file#* }"

            case "$path" in
                */systemd/*.service|*/systemd/*.socket)
                    unit="${path##*/}"

                    # classify user vs system by presence of "systemd/user"
                    if [[ "$path" == *"/systemd/user/"* ]]; then
                        # dedupe
                        [[ -n "${seen_user[$unit]}" ]] && continue
                        seen_user[$unit]=1

                        # record which package provided this unit
                        unit_pkg_user[$unit]="$pkg"

                        # check enabled state for user unit
                        if systemctl -q --user is-enabled "$unit" 2>/dev/null; then
                            user_enabled_units+=("$unit")
                        fi
                    else
                        # system-level unit (includes /usr/lib/systemd/system and /etc/systemd/system)
                        [[ -n "${seen_system[$unit]}" ]] && continue

                        seen_system[$unit]=1

                        # record which package provided this unit
                        unit_pkg_system[$unit]="$pkg"

                        # check enabled state for system unit; use sudo as systemctl --system may require privileges
                        if sudo systemctl -q is-enabled "$unit" 2>/dev/null; then
                            system_enabled_units+=("$unit")
                        fi
                    fi
                    ;;
                *)
                    # ignore other files
                    ;;
            esac
        done < <(pacman -Ql "$pkg" 2>/dev/null)
    done

    # export maps so other functions can see them (declare -g for bash)
    # if your bash does not support declare -gA, make these global by other means
    declare -gA VIB_unit_pkg_user=()
    declare -gA VIB_unit_pkg_system=()

    for k in "${!unit_pkg_user[@]}"; do VIB_unit_pkg_user[$k]="${unit_pkg_user[$k]}"; done
    for k in "${!unit_pkg_system[@]}"; do VIB_unit_pkg_system[$k]="${unit_pkg_system[$k]}"; done
}

_ask_yes_no_all() {
    local default="$1"
    local prompt="$2"

    # Show cursor
    printf '\e[?25h'

    while true; do
        read -p "$prompt (Y/n/all): " -r answer

        answer="${answer:-$default}"

        case "$answer" in
            [Yy][Ee][Ss]|[Yy])
                return 0
                ;;
            [Nn][Oo]|[Nn])
                return 1
                ;;
            [Aa][Ll][Ll])
                return 2
                ;;
            *)
                # Clear line and retry
                printf "\r\e[K"
                ;;
        esac
    done

    # Hide cursor before returning
    printf '\e[?25l'
}

# Disables detected systemd units (services or sockets) for each package individually if they are enabled.
# It checks if the unit is enabled, prompts the user for confirmation before disabling each unit.
# Adds 'all' option to disable all units for the current package.
_disable_systemd_units() {
    local pids=()
    local task_units=()
    local task_pkgs=()
    local task_scopes=()

    # Group enabled units by package and scope for easier processing
    declare -A pkg_user_units=()
    declare -A pkg_system_units=()

    for unit in "${user_enabled_units[@]}"; do
        pkg="${VIB_unit_pkg_user[$unit]:-unknown}"
        pkg_user_units["$pkg"]+="$unit "
    done

    for unit in "${system_enabled_units[@]}"; do
        pkg="${VIB_unit_pkg_system[$unit]:-unknown}"
        pkg_system_units["$pkg"]+="$unit "
    done

    # Process user scope by package
    for pkg in "${!pkg_user_units[@]}"; do

        local units=(${pkg_user_units["$pkg"]})
        local remaining_units=("${units[@]}")

        while [ ${#remaining_units[@]} -gt 0 ]; do
            unit="${remaining_units[0]}"

            _ask_yes_no_all Y "${BLUE}[VIBRANIUM]${RESET} Disable unit '${BLUE}${unit}${RESET}' from package '${GREEN}${pkg}${RESET}' (user scope) before removal?"

            local response=$?

            if [ $response -eq 0 ]; then  # Yes
                systemctl -q --user --now disable "$unit" &

                pids+=("$!")
                task_units+=("$unit")
                task_pkgs+=("$pkg")
                task_scopes+=("user")
                remaining_units=("${remaining_units[@]:1}")

            elif [ $response -eq 2 ]; then  # All
                echo -e "${BLUE}[VIBRANIUM]${RESET} Disabling all units..."

                for u in "${remaining_units[@]}"; do
                    systemctl -q --user --now disable "$u" &

                    pids+=("$!")
                    task_units+=("$u")
                    task_pkgs+=("$pkg")
                    task_scopes+=("user")
                done

                remaining_units=()

            else  # No
                remaining_units=("${remaining_units[@]:1}")
            fi
        done
    done

    # Process system scope by package
    for pkg in "${!pkg_system_units[@]}"; do

        local units=(${pkg_system_units["$pkg"]})
        local remaining_units=("${units[@]}")

        while [ ${#remaining_units[@]} -gt 0 ]; do

            unit="${remaining_units[0]}"

            _ask_yes_no_all Y "${BLUE}[VIBRANIUM]${RESET} Disable unit '${BLUE}${unit}${RESET}' from package '${GREEN}${pkg}${RESET}' (system scope) before removal?"

            local response=$?

            if [ $response -eq 0 ]; then  # Yes
                sudo systemctl -q --now disable "$unit" &

                pids+=("$!")

                task_units+=("$unit")
                task_pkgs+=("$pkg")
                task_scopes+=("system")
                remaining_units=("${remaining_units[@]:1}")

            elif [ $response -eq 2 ]; then  # All
                echo -e "${BLUE}[VIBRANIUM]${RESET} Disabling all units..."

                for u in "${remaining_units[@]}"; do
                    sudo systemctl -q --now disable "$u" &

                    pids+=("$!")
                    task_units+=("$u")
                    task_pkgs+=("$pkg")
                    task_scopes+=("system")
                done

                remaining_units=()

            else  # No
                remaining_units=("${remaining_units[@]:1}")
            fi
        done
    done

    # Wait for background disable commands to finish and report results
    local idx=0
    for pid in "${pids[@]}"; do
        wait "$pid"
        idx=$((idx + 1))
    done
}

_operation_canceled() {
    local color="$RED"
    local exit_after=false

    case "$1" in
        --positive)
            color="$GREEN"
            ;;
        --exit)
            exit_after=true
            ;;
    esac

    printf "%s[VIBRANIUM]%s Operation canceled" "$color" "$RESET"

    if [[ $NO_DUMMY == false ]]; then
        read -n1 -r -s -p $'. Press any key to exit' dummy
        printf '\e[?25h' # Show cursor
    fi

    if [[ $exit_after == true ]]; then
        exit 1
    fi
}

_uninstallation_complete() {
    printf "%s[VIBRANIUM]%s Uninstallation complete" "$GREEN" "$RESET"

    if [[ $NO_DUMMY == false ]]; then
        read -n1 -r -p $'. Press any key to exit' dummy
        printf '\e[?25h' # Show cursor
    fi
}

# Displays an overview of packages about to be uninstalled.
# Formats differently based on the number of packages for readability.
_show_overview() {
    local packages=("${PACKAGES[@]}")

    if [[ "${#packages[@]}" -gt 0 ]]; then
        if [[ "${#packages[@]}" -le 3 ]]; then
            echo -e "${BLUE}[VIBRANIUM]${RESET} You're about to uninstall the following packages: ${YELLOW}${packages[@]}${RESET}"
        else
            echo -e "${BLUE}[VIBRANIUM]${RESET} You're about to uninstall the following packages:"
            for pkg in "${packages[@]}"; do
                echo -e "\t   - ${YELLOW}${pkg}${RESET}"
            done
        fi
    fi
}
_uninstall_packages() {
    if ! sudo -v; then
        _operation_canceled
        exit 1
    fi

    if sudo pacman -Rns "${PACKAGES[@]}"; then
        return 0
    else
        return 1
    fi
}

_get_installed_packages() {
    mapfile -t PACKAGES < <(pacman -Qqe)
}

_choose_packages() {
    local chosen=()

    mapfile -t chosen < <(printf "%s\n" "${PACKAGES[@]}" | fzf "${FZF_ARGS[@]}")

    [[ "${#chosen[@]}" -eq 0 ]] && return 1
    PACKAGES=("${chosen[@]}")
}

SUDO_PROMPT="$(printf '%s[VIBRANIUM]%s Password for %s: ' "$RED" "$RESET" "$USER")"
export SUDO_PROMPT

NO_LOGO=false
NO_DUMMY=false
PACKAGES=()

FZF_ARGS=(
    --multi
    --ignore-case
    --highlight-line

    --info 'hidden'
    --border 'bold'

    --border-label ' alt-p: toggle description, alt-j/k: scroll description, ctrl-j/k: next/prev item, tab: multi-select '
    --border-label-pos 'bottom'

    --list-label 'Package list'
    --list-border 'bold'

    --input-label 'Filter packages'
    --input-border 'bold'

    --preview 'pacman -Qii {1}'
    --preview-border 'bold'
    --preview-window 'right:75%:wrap'
    --preview-label 'Package Information'

    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'

    --color 'pointer:white,marker:green'
)

trap 'printf "\n"; _operation_canceled --exit' SIGHUP SIGINT

while [[ $# -gt 0 ]]; do
    case "$1" in
        --no-logo)
            NO_LOGO=true
            shift
            ;;
        --no-dummy)
            NO_DUMMY=true
            shift
            ;;
        --help)
            _usage
            ;;
        --)
            shift
            break
            ;;
        --*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

if [[ $NO_LOGO == false ]]; then
    printf "\n%s%s%s\n\n" "$YELLOW" "$(< "$VIBRANIUM/logo.txt")" "$RESET"
fi

# Hide cursor
printf '\e[?25l'

if [[ $# -gt 0 ]]; then
    PACKAGES=("$@")

    if ! _ask_for_sudo; then
        _operation_canceled
        exit 1
    fi
else
    if ! command -v fzf > /dev/null; then
        if term::is_headless; then
            notify-send -r 4 "Vibranium" "<b><i>fzf</i></b> not found!"
        fi

        log::error "fzf is not installed!"
        exit 1
    fi

    _get_installed_packages

    if _choose_packages; then
        : # Proceed
    else
        _operation_canceled --positive
        exit 0
    fi
fi

_show_overview

if term::ask_yes_no Y "Proceed with uninstallation?"; then
    if ! _ask_for_sudo; then
        _operation_canceled
        exit 1
    fi

    _handle_systemd
    _disable_systemd_units

    if _uninstall_packages; then
        _uninstallation_complete
    else
        _operation_canceled
        exit 1
    fi
else
    _operation_canceled
fi
