#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vibranium-core-lib"

state="$(< "$VIBRANIUM_STATE/night-light")"

if [[ "$state" == "active" ]]; then
    icon="\udb80\udf35"
    current="$(grep -oP '(?<=temperature = ).*' "$XDG_CONFIG_HOME/hypr/hyprsunset.conf")"
    guide="<span foreground='${WAYBAR_ACCENT}'>Night Light temperature:</span> <span foreground='${WAYBAR_YELLOW}'>${current}K</span>"

    if [[ $VIBRANIUM_BAR_SHOW_SHORTCUT_HINTS == true ]]; then
        guide="  $guide "
        guide+="\n<span foreground='${WAYBAR_MUTED}'>----------------------------------</span>"
        guide+="\n <span foreground='${WAYBAR_ACCENT}'>Scroll wheel:</span> <span foreground='${WAYBAR_YELLOW}'>adjust temperature</span>"
        guide+="\n <span foreground='${WAYBAR_ACCENT}'>Left click:</span>   <span foreground='${WAYBAR_YELLOW}'>toggle night light</span>"
    fi

    printf '{"text": "%s", "tooltip": "%s"}' "$icon" "$guide"
else
    printf '{"text": ""}'
fi
