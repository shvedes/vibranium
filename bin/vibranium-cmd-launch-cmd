#!/usr/bin/env bash

# Launch a command in a new session.

usage() {
    cat << EOF
Usage: $(basename "$0") COMMAND [ARGUMENTS...]

Launch COMMAND in a new session using setsid.

Options:
  -h, --help  Display this help and exit
EOF
}

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
    "")
        echo "$(basename "$0"): missing COMMAND" >&2
        echo "Try '$(basename "$0") --help' for more information." >&2
        exit 1
        ;;
esac

cmd="$1"
shift

if ! command -v "$cmd" >/dev/null 2>&1; then
    echo "$(basename "$0"): command not found: $cmd" >&2
    exit 127
fi

exec setsid "$cmd" "$@"
