#!/bin/bash

# overcomplicated launcher based on rofi, which can:
# - launch applications
# - open local files in default applications
# - open links
# - search the internet
#
# please note that internet search may often be unavailable when vibranium_global_app_launcher_auto_select is set to true.
# this script can also open three additional menus with custom categories to open:
# - ai pwas
# - power menu
# - common websites pwas

source vb-lib-cli

VERBOSE=false

OPT_ARGS=""

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

A rofi-based application launcher that can launch apps, open local files,
follow links, perform internet searches, and display custom category menus.

Options:
      --ai        Show only ai pwa entries (drun category: AI)
      --web       Show only pre-installed web app PWA entries (drun category: Webapp)
      --pwa       Show user-installed web app PWA entries (drun category: PWA)
      --power     Show only power-management entries (drun category: Power)
  -v, --verbose   Enable verbose output
  -h, --help      Display this help and exit

Input Handling (default mode):
  file://<path>   Open the file in its default application via app2unit-open
  https://<url>   Open the url in the default browser via app2unit-open
  <path>          Open a local path that exists on disk
  <query>         Search in a preffered search engine
  <command>       Execute the command
EOF
}

_open_file() {
  local file="${1#file://}"
  log Info "Opening file: $file"
  # source app2unit creates a transient systemd scope so the launched
  # xdg-open process is tracked and cleaned up with the session.
  setsid -f app2unit -s app-graphical.slice -- xdg-open "$file" &> /dev/null
  log Info "File open done: $file"
}

_open_link() {
  local link="$1"
  log Info "Opening link: $link"
  # app2unit-open wraps the browser call in a transient systemd scope
  # so it inherits the graphical session's cgroup. If a browser window
  # already exists, the scope is created for nothing, but the overhead
  # is negligible and it prevents orphaned browser processes on logout.
  setsid -f app2unit-open -s app-graphical.slice "$link" &> /dev/null &
  log Info "Link open dispatched: $link"
}

# Keywords are defined in the user's advanced settings file as
# "keyword:command" pairs. The keyword is everything before the first
# colon; the action is everything after (eval'd). If input is
# "keyword rest...", the rest is appended as arguments to the action.
# This lets users define shortcuts like "play:vb-cmd-play-mpd --search"
# and invoke "play metallica" to run "vb-cmd-play-mpd --search metallica".
_handle_keyword() {
  local input="$1"
  local entry keyword action extra

  log Info "Keyword handler input: $input"
  # shellcheck disable=SC2154
  for entry in "${vb_launcher_keywords[@]+"${vb_launcher_keywords[@]}"}"; do
    keyword="${entry%%:*}"
    action="${entry#*:}"

    if [[ "$input" == "$keyword" ]]; then
      log Info "Keyword exact match: $keyword -> $action"
      if ! eval "$action"; then
        log Error "Keyword '$keyword' returned non zero exit code!"
        exit 1
      fi
      return 0
    fi

    if [[ "$input" == "$keyword "* ]]; then
      extra="${input#"$keyword" }"
      log Info "Keyword match with args: $keyword -> $action $extra"
      if ! eval "$action $extra"; then
        log Error "Keyword '$keyword' returned non zero exit code!"
        exit 1
      fi
      return 0
    fi
  done
  log Info "No keyword matched"
  return 1
}

_search_the_internet() {
  local input="$*"
  local engine

  case "$SEARCH_ENGINE" in
    "duckduckgo")
      local engine="https://duckduckgo.com/?q="
      ;;
    "google")
      local engine="https://www.google.com/search?q="
      ;;
    "brave")
      local engine="https://search.brave.com/search?q="
      ;;
    "bing")
      local engine="https://bing.com/search?q="
      ;;
  esac

  log Info "Searching $SEARCH_ENGINE for: $input"
  setsid -f app2unit -S both -s app-graphical.slice -- xdg-open "${engine}${input}" &> /dev/null
}

MODE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --web | --ai | --power | --pwa)
      MODE="$1"
      log Info "Mode: $1"
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if pidof -q rofi; then
  log Info "Existing rofi found, killing"
  killall rofi
  exit 0
fi

source vb-lib-core

if [[ -f "${VIBRANIUM_USER_SETTINGS}.functions" ]]; then
  log Info "Sourcing user functions: ${VIBRANIUM_USER_SETTINGS}.functions"
  source "${VIBRANIUM_USER_SETTINGS}.functions"
fi

log Info "Sourcing advanced settings: ${VIBRANIUM_USER_SETTINGS}.advanced"
source "${VIBRANIUM_USER_SETTINGS}.advanced"

helpers::check \
  VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_WEBAPPS \
  VIBRANIUM_GLOBAL_APP_LAUNCHER_AUTO_SELECT \
  VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_ICONS \
  VIBRANIUM_GLOBAL_SEARCH_ENGINE

AUTO_SELECT="$VIBRANIUM_GLOBAL_APP_LAUNCHER_AUTO_SELECT"
SHOW_ICONS="$VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_ICONS"
SEARCH_ENGINE="$VIBRANIUM_GLOBAL_SEARCH_ENGINE"
log Info "Config: auto_select=$AUTO_SELECT show_icons=$SHOW_ICONS engine=$SEARCH_ENGINE"

case "$MODE" in
  --web | --ai | --power | --pwa)
    log Info "Category mode: ${MODE#--}"
    OPT_ARGS+=(
      -disable-history
      -icon-theme Vibranium
      -no-fixed-num-lines true
      -theme-str 'configuration {show-icons: true;}'
      -theme-str 'element-icon {enabled: true;}'
    )

    LAUNCHER_MODE="${MODE/--/}"

    if [[ "$AUTO_SELECT" == true ]]; then
      # Don't enable auto-select for Power menu: accidentally confirming a
      # power action (logout, reboot) on single-result display is dangerous.
      if [[ "$LAUNCHER_MODE" =~ ^(ai|web|pwa)$ ]]; then
        log Info "Auto-select enabled for $LAUNCHER_MODE"
        OPT_ARGS+=(-auto-select true)
      fi
    fi

    case "$MODE" in
      --power)
        OPT_ARGS+=(-drun-categories Power -display-drun "Power")
        log Info "drun categories: Power"
        ;;
      --web)
        OPT_ARGS+=(-drun-categories WebApp -display-drun "Web Apps")
        log Info "drun categories: WebApp"
        ;;
      --pwa)
        OPT_ARGS+=(-drun-categories PWA -display-drun "PWA")
        log Info "drun categories: PWA"
        ;;
      --ai)
        OPT_ARGS+=(-drun-categories AI -display-drun "AIs")
        log Info "drun categories: AI"
        ;;
    esac
    ;;
  *)
    SHOW_WEBAPPS="$VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_WEBAPPS"
    log Info "SHOW_WEBAPPS=$SHOW_WEBAPPS"

    EXCLUDE="Power"

    if [[ "$SHOW_WEBAPPS" != true ]]; then
      EXCLUDE+=",WebApp,PWA,AI"
    fi

    log Info "Excluding categories: $EXCLUDE"
    OPT_ARGS+=(-drun-exclude-categories "$EXCLUDE")

    if [[ "$SHOW_WEBAPPS" == true ]]; then
      OPT_ARGS+=(-icon-theme Vibranium)
    fi

    if [[ "$AUTO_SELECT" == true ]]; then
      log Info "Auto-select enabled for default mode"
      OPT_ARGS+=(-auto-select true)
    fi

    LAUNCHER_MODE="default"
    ;;
esac
log Info "Launcher mode set: $LAUNCHER_MODE"

if [[ "$SHOW_ICONS" = true ]]; then
  log Info "Icons enabled via theme-str"
  OPT_ARGS+=(-theme-str 'configuration {show-icons: true;} element-icon {enabled: true;}')
fi

# rofi -show drun normally executes the selected entry directly. By
# overriding run-command with "echo {cmd} {args}", we capture what would
# be executed and handle the dispatch ourselves below.
log Info "Launching rofi with args: ${OPT_ARGS[*]}"
read -r INPUT < <(rofi -show drun -run-command "echo {cmd} {args}" "${OPT_ARGS[@]}" 2> /dev/null)
log Info "Rofi exited, input: ${INPUT:-(empty)}"

case "$INPUT" in
  "file://"*)
    _open_file "$INPUT"
    ;;
  "https://"*)
    _open_link "$INPUT"
    ;;
  "DBus launch" | "")
    log Info "Empty/DBus launch, exiting"
    exit 0
    ;;
  *)
    # Keywords take precedence over all other input types.
    if _handle_keyword "$INPUT"; then
      log Info "Keyword handled, exiting"
      exit 0
    fi

    # Split the rofi output into command and arguments.
    CMD="${INPUT%% *}"
    ARGS="${INPUT#"$CMD"}"
    ARGS="${ARGS# }"
    log Info "Parsed: CMD=$CMD ARGS=$ARGS"

    if [[ -x "$CMD" ]] || command -v "$CMD" > /dev/null; then
      log Info "Executable found: $CMD"
      # Vibranium-internal commands are eval'd directly so they inherit the
      # caller's environment without spawning a new shell.
      if [[ "$CMD" == vb* ]]; then
        log Info "Internal Vibranium command, eval: $INPUT"
        eval "$INPUT"
        exit 0
      elif [[ "$ARGS" =~ ^steam:// ]]; then
        # Steam URIs (steam://rungameid/...) must be handled by Steam itself;
        # xdg-open does not route them correctly in all configurations.
        log Info "Steam URI detected, eval: $INPUT"
        eval "$INPUT"
        exit 0
      fi

      # Geniunely don't understand why shellcheck is upset here.
      # shellcheck disable=2218
      log Info "Launching via vb-launch-cmd: $CMD $ARGS"
      # shellcheck disable=2086
      setsid -f vb-launch-cmd -- $CMD $ARGS
      log Info "vb-launch-cmd exit code: $?"
    elif [[ -e "$INPUT" ]]; then
      log Info "Local path exists: $INPUT"
      setsid -f app2unit -s app-graphical.slice -- xdg-open "$INPUT" &> /dev/null
      log Info "app2unit path open exit: $?"
    else
      # Web search is only available in the default mode.
      # When auto-select is on, the first search result is selected instantly
      # and there is no way to type a query, so web search is disabled.
      if [[ "$LAUNCHER_MODE" == "default" ]]; then
        if [[ "$AUTO_SELECT" = true ]]; then
          log Info "Web search skipped (auto-select active)"
          exit 1
        fi
        _search_the_internet "$INPUT"
        log Info "Internet search dispatched"
      else
        log Info "Web search unavailable in $LAUNCHER_MODE mode"
      fi
    fi
    ;;
esac
