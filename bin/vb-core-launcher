#!/usr/bin/bash

# shellcheck disable=SC2086
# Overcomplicated launcher based on rofi, which can:
#	- Launch applications
#	- Open local files in default applications
#	- Open links
#	- Search the internet
#
# Please note that internet search may often be unavailable when VIBRANIUM_GLOBAL_APP_LAUNCHER_AUTO_SELECT is set to true.
# This script can also open three additional menus with custom categories to open:
#	- AI PWAs
#	- Power menu
#	- Common websites PWAs

source vb-lib-core

if pidof -q rofi; then
  killall rofi
  exit 0
fi

helpers::check \
  VIBRANIUM_GLOBAL_APP_LAUNCHER_AUTO_SELECT \
  VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_ICONS \
  VIBRANIUM_GLOBAL_SEARCH_ENGINE

auto_select="$VIBRANIUM_GLOBAL_APP_LAUNCHER_AUTO_SELECT"
show_icons="$VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_ICONS"
search_engine="$VIBRANIUM_GLOBAL_SEARCH_ENGINE"

search_engine() {
  case "$search_engine" in
  "google") echo "https://www.google.com/search?q=" ;;
  "duckduckgo") echo "https://duckduckgo.com/?q=" ;;
  "bing") echo "https://bing.com/search?q=" ;;
  "brave") echo "https://search.brave.com/search?q=" ;;
  esac
}

process_input() {
  local input="$*"

  case "$input" in
  "file://"*)
    # Open in default app (media viewer, text editor, whatever)
    input="${input#file://}"
    app2unit-open "$input" &>/dev/null &
    ;;
  "https://"*)
    # Open in default browser
    app2unit-open "$input" &>/dev/null &
    ;;
  "DBus launch")
    # org.telegram.desktop.desktop for example
    # Let DBus do its thing
    exit 0
    ;;
  *)
    local cmd="${input%% *}"
    local args="${input#"$cmd"}"

    if [[ -x "$cmd" ]] || command -v "$cmd" >/dev/null 2>&1; then
      app2unit "$cmd" $args
    elif [[ -e "$input" ]]; then
      app2unit-open "$input" &>/dev/null &
    else
      if [[ "$LAUNCHER_MODE" == "default" ]]; then
        [[ "$auto_select" = true ]] && {
          exit 1
        }
        app2unit-open "$(search_engine)${input}" &>/dev/null &
      fi
    fi
    ;;
  esac
}

set_rofi_flags() {
  local mode="$1"
  local -n _out="$2"

  _out=()

  case "$mode" in
  --web | --ai | --power)
    _out+=(
      -disable-history
      -icon-theme Vibranium
      -no-fixed-num-lines true
      -theme-str 'configuration {show-icons: true;}'
      -theme-str 'element-icon {enabled: true;}'
    )
    ;;
  esac

  if [[ "$auto_select" == true ]]; then
    if [[ "$mode" =~ ^--(default|ai|web)$ ]]; then
      _out+=(-auto-select true)
    fi
  fi

  case "$mode" in
  --power) _out+=(-drun-categories Power -display-drun "Power") ;;
  --web) _out+=(-drun-categories WebApp -display-drun "Web Apps") ;;
  --ai) _out+=(-drun-categories AI -display-drun "AIs") ;;
  esac
}

case "$1" in
--web | --ai | --power)
  set_rofi_flags "$1" opt_args
  LAUNCHER_MODE="${1/--/}"
  ;;
*)
  helpers::check \
    VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_WEBAPPS \
    VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_AI

  WEB_APPS="$VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_WEBAPPS"
  AI="$VIBRANIUM_GLOBAL_APP_LAUNCHER_SHOW_AI"

  EXCLUDE="Power"

  [[ $WEB_APPS != true ]] && EXCLUDE+=",WebApp"
  [[ $AI != true ]] && EXCLUDE+=",AI"

  opt_args+=(-drun-exclude-categories "$EXCLUDE")

  [[ $WEB_APPS == true || $AI == true ]] && {
    opt_args+=(-icon-theme Vibranium)
  }
  LAUNCHER_MODE="default"
  ;;
esac

if [[ "$show_icons" = true ]]; then
  opt_args+=(-theme-str 'configuration {show-icons: true;} element-icon {enabled: true;}')
fi

read -r input < <(rofi -show drun -run-command "echo {cmd} {args}" "${opt_args[@]}" 2>/dev/null)

if [[ ! -z "$input" ]]; then
  process_input "${input[@]}"
fi
