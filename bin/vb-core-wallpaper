#!/usr/bin/bash

THEME="$(<"$XDG_CONFIG_HOME/vibranium/current/theme.name")"
WALLS="$XDG_CONFIG_HOME/vibranium/current/theme/backgrounds"
UWALLS="$XDG_CONFIG_HOME/vibranium/themes/$THEME/backgrounds"
STATE_FILE="$VIBRANIUM_STATE/wallpaper/$THEME"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION] <image>

Set wallappers in Vibranium.

Supported formats: jpeg, jpegxl, png, gif, pnm, tga, tiff, webp, bmp, svg.

Options:
  --next          Set the next wallpaper
  --prev          Set the previous wallpaper
  --get           Get the current wallpaper
  <image>         Path to an image file (.png, .jpg, .jpeg, .webp) to set as wallpaper

If no OPTION is provided, the script expects an image file as an argument.
EOF
}

get_wallpaper() {
  local current
  while IFS= read -r line; do
    current="${line#*image: }"
    echo "$current"
  done < <(awww query)
}

copy_uwall() {
  # In case if user set new wallpaper via thunar context menu
  # (e,g. user's own picture, downloaded from the internet) we
  # should copy this file to the folder that contains user wallpapers
  # only. Why copy? In case if original file gets deleted
  if [[ ! -f "$WALLS/${WALLPAPER_PATH##*/}" ]]; then
    mkdir -p "$UWALLS"
    cp "$WALLPAPER_PATH" "$UWALLS/"
    WALLPAPER_PATH="$UWALLS/${WALLPAPER_PATH##*/}"
  fi
}

cycle_wallpaper() {
  local mode="$1"
  local current files
  local idx next prev found
  local candidate

  # Read all wallpaper files (regular files or potential symlinks)
  mapfile -t files < <(
    find "$WALLS" -maxdepth 1 \( -type f -o -type l \) 2>/dev/null |
      while IFS= read -r f; do
        if [[ -f "$f" ]]; then
          printf '%s\n' "$f"
        fi
      done
  )

  # Exit if no wallpapers found
  if ((${#files[@]} == 0)); then
    return 1
  fi

  # Get current wallpaper
  current="$(get_wallpaper)"

  found=0
  idx=0

  # Find index of current wallpaper in the files array
  if [ -n "$current" ]; then
    for i in "${!files[@]}"; do
      if [ "${files[$i]}" = "$current" ]; then
        idx=$i
        found=1
        break
      fi
    done
  fi

  case "$mode" in
  --next)
    if ((found)); then
      # Wrap around using modulo
      next=$(((idx + 1) % ${#files[@]}))
      candidate="${files[$next]}"
    else
      # Default to first wallpaper if current not found
      candidate="${files[0]}"
    fi
    ;;
  --prev)
    if ((found)); then
      # Wrap around safely
      prev=$(((idx - 1 + ${#files[@]}) % ${#files[@]}))
      candidate="${files[$prev]}"
    else
      # Default to last wallpaper
      candidate="${files[${#files[@]}-1]}"
    fi
    ;;
  esac

  # Do nothing if candidate is the same as current wallpaper
  # This handles the case of a single wallpaper in the directory
  if [[ "$candidate" == "$current" ]]; then
    return 0
  fi

  printf "%s" "$candidate"
}

service_status() {
  systemctl -q --user is-active awww
}

feature_enabled() {
  source vb-lib-core

  helpers::check VIBRANIUM_GLOBAL_SHOW_WALLPAPER
  if [[ $VIBRANIUM_GLOBAL_SHOW_WALLPAPER == true ]]; then
    if ! service_status; then
      systemctl -q --user enable --now awww
    fi
  else
    return 1
  fi
}

case "$1" in
"" | -h | --help)
  usage
  exit 0
  ;;
-g | --get)
  get_wallpaper
  exit 0
  ;;
--next | --prev)
  if ! feature_enabled; then
    echo "Error: this feature is disabled." >&2
    echo "To enable, go to Vibranium Menu > Settings > Misc > Show wallpaper." >&2
    exit 1
  fi

  WALLPAPER_PATH="$(cycle_wallpaper "$1")"
  ;;
*.png | *.jpg | *.jpeg | *.jpegxl | *.webp | *.gif | *.pnm | *.tga | *.tiff | *.bmp | *.svg)
  if ! feature_enabled; then
    echo "Error: this feature is disabled." >&2
    echo "To enable, go to Vibranium Menu > Settings > Misc > Show wallpaper." >&2
    exit 1
  fi

  WALLPAPER_PATH="$(realpath "$1")"

  if [[ ! -f "$WALLPAPER_PATH" ]]; then
    log::error "${YELLOW}${WALLPAPER_PATH}${RESET} doesn't exist!"
    exit 1
  fi

  if [[ $1 == *.gif && ! -f "$UWALLS/${1##*/}" ]]; then
    notify-send -r 3 -t 6000 "Vibranium - Wallpapers" "GIF images might take a while to load. Please wait."
  fi

  copy_uwall
  ;;
-*)
  echo "Error: unknown flag option: ${1}." >&2
  echo "Try ${0##*/} --help for more information." >&2
  exit 1
  ;;
esac

awww img -t fade --transition-duration 0.5 --transition-step 255 "$WALLPAPER_PATH" &
ln -sf "$WALLPAPER_PATH" "$XDG_CONFIG_HOME/vibranium/current/background"

# Update the state file
printf "%s" "$WALLPAPER_PATH" >"$STATE_FILE"
