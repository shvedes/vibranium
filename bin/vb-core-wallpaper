#!/usr/bin/env bash

if [[ "$CHASSIS_TYPE" == vm ]]; then
    if [[ -t 1 ]]; then
        echo "not available in a VM" >&2
    else
        if [[ "${BASH_SOURCE[1]}" != vb-theme-set ]]; then
            notify-send -r 3 -u critical -t 5000 "Wallpaper Manager" \
                "This feature isn't available in a VM"
        fi
    fi
    exit 1
fi

source vb-core-lib

CURRENT_THEME="$(vb-theme-get)"
WALLS="$XDG_CONFIG_HOME/vibranium/theme/current/backgrounds"
USER_WALLPAPERS="$XDG_CONFIG_HOME/vibranium/theme/wallpapers/$CURRENT_THEME"

toggle_wallpaper() {
    local mode="$1"
    local current files user_files
    local idx next prev found

    mapfile -t files < <(find "$WALLS" -maxdepth 1 -type f,l | sort)
    mapfile -t user_files < <(find "$USER_WALLPAPERS" -maxdepth 1 -type f,l | sort)

    files+=("${user_files[@]}")

    # If it is empty (somehow) - exit
    [ ${#files[@]} -eq 0 ] && return 1

    current="$(vb-cmd-get-wallpaper)"

    found=0
    idx=0

    if [ -n "$current" ]; then
        for i in "${!files[@]}"; do
            if [ "${files[$i]}" = "$current" ]; then
                idx=$i
                found=1
                break
            fi
        done
    fi

    case "$mode" in
        --next)
            if (( found )); then
                next=$(((idx + 1) % ${#files[@]}))
                printf "%s\n" "${files[$next]}"
            else
                printf "%s\n" "${files[0]}"
            fi
            ;;
        --prev)
            if (( found )); then
                prev=$(((idx - 1 + ${#files[@]}) % ${#files[@]}))
                printf "%s\n" "${files[$prev]}"
            else
                printf "%s\n" "${files[${#files[@]}-1]}"
            fi
            ;;
        *)
            return 2
            ;;
    esac
}

update_configs() {
    local hyprlock_conf hyprpaper_conf state_file
    local wallpaper="$1"

    hyprlock_conf="$XDG_CONFIG_HOME/hypr/hyprlock.conf"
    hyprpaper_conf="$XDG_CONFIG_HOME/hypr/hyprpaper.conf"
    state_file="$VIBRANIUM_STATE/wallpaper/$CURRENT_THEME"

    printf "splash = false\n" > "$hyprpaper_conf"
    printf "wallpaper:monitor = \nwallpaper:path = %s" "$wallpaper" >> "$hyprpaper_conf"

    printf "%s" "$wallpaper" > "$state_file"
    sed -i "s|^\([[:space:]]*path = \).*|\1$wallpaper|" "$hyprlock_conf"
}

usage() {
    cat <<EOF
Usage: ${0##*/} [OPTION] <image>

Options:
  --next          Set the next wallpaper
  --prev          Set the previous wallpaper
  <image>         Path to an image file (.png, .jpg, .jpeg, .webp) to set as wallpaper

If no OPTION is provided, the script expects an image file as an argument.
EOF
}

helpers::check VIBRANIUM_GLOBAL_SHOW_WALLPAPER

if [[ $VIBRANIUM_GLOBAL_SHOW_WALLPAPER == true ]]; then
    if ! systemctl -q --user is-active hyprpaper; then
        systemctl -q --user enable --now hyprpaper
    fi
else
    log::error "Wallpaper daemon isn't running!"
    exit 1
fi

case "$1" in
    "")
        usage
        exit 0
        ;;
    --next|--prev)
        WALLPAPER_PATH="$(toggle_wallpaper "$1")"
        ;;
    *.png|*.jpg|*.jpeg|*.webp)
        WALLPAPER_PATH="$(realpath "$1")"

        if [[ ! -f "$WALLPAPER_PATH" ]]; then
            log::error "$WALLPAPER_PATH doesn't exist!"
            exit 1
        fi
        ;;
    *)
        usage
        exit 1
        ;;
esac

hyprctl -q hyprpaper wallpaper ", $WALLPAPER_PATH"

# In case if user set new wallpaper via thunar context menu
# (e,g. user's own picture, downloaded from the internet) we
# should copy this file to the folder that contains user wallpapers
# only. Why copy? In case if original file gets deleted
if [[ ! -f "$WALLS/${WALLPAPER_PATH##*/}" ]]; then

    mkdir -p "$USER_WALLPAPERS"

    if [[ ! -f "$USER_WALLPAPERS/${WALLPAPER_PATH##*/}" ]]; then
        cp "$WALLPAPER_PATH" "$USER_WALLPAPERS/"
        WALLPAPER_PATH="$USER_WALLPAPERS/${WALLPAPER_PATH##*/}"
    fi
fi

update_configs "$WALLPAPER_PATH"
