#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

log Info "${0##*/} started: state_file=$VIBRANIUM_STATE/wallpaper.state"

WALLPAPER_STATE="$VIBRANIUM_STATE/wallpaper.state"
WALLS="$XDG_CONFIG_HOME/vibranium/current/theme/backgrounds"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION] <image>

Set wallpapers in Vibranium.

Supported formats: jpeg, jpegxl, png, pnm, tga, tiff, webp, bmp, svg.

Options:
  --next          Set the next wallpaper
  --prev          Set the previous wallpaper
  --get           Get the current wallpaper
  -h, --help      Display this help and exit
  -v, --verbose   Enable verbose output
  <image>         Path to an image file (.png, .jpg, .jpeg, .webp) to set as wallpaper

If no OPTION is provided, the script expects an image file as an argument.
EOF
}

write_wallpaper_state() {
  local theme="$1"
  local path="$2"
  local found=0
  local -a lines=()
  local line

  # Read all existing entries into memory first.
  # This is necessary because we will truncate the file on write,
  # so we cannot read and write it at the same time.
  if [[ -f "$WALLPAPER_STATE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      lines+=("$line")
    done <"$WALLPAPER_STATE"
  fi

  # Write all entries back, replacing the one for this theme in place.
  # The > redirect truncates the file before the first printf runs,
  # which is safe because all lines are already loaded into the array.
  # State file format: one theme="path" entry per line, e.g.
  #   nord="nord/wallpaper-01.jpg"
  {
    for line in "${lines[@]}"; do
      if [[ "$line" == "${theme}="* ]]; then
        printf '%s="%s"\n' "$theme" "$path"
        found=1
      else
        printf '%s\n' "$line"
      fi
    done

    # Theme not yet in the file - append as a new entry.
    if (( found == 0 )); then
      printf '%s="%s"\n' "$theme" "$path"
    fi
  } >"$WALLPAPER_STATE"
}

# Resolve the current wallpaper path. The symlink at
# vibranium/current/background is the primary source; if it is missing
# (e.g. on first run before any wallpaper has been set), fall back to
# querying awww for its active image.
get_wallpaper() {
  local link="$XDG_CONFIG_HOME/vibranium/current/background"
  local -n _source="$1"

  _source="$(readlink -s "$link")"

  if [[ -z "$_source" ]]; then
    while IFS= read -r line; do
      # awww query output: "active: on\nimage: /path/to/img"
      _source="${line#*image: }"
    done < <(awww query)
  fi
}

# Cycle to the next or previous wallpaper in the active theme's
# backgrounds directory. Returns the selected path (or nothing when
# there is only one wallpaper and it is already active).
cycle_wallpaper() {
  local -n _result="$1"
  local mode="$2"
  local current files
  local idx next prev found
  local candidate

  mapfile -t files < <(find "$WALLS" -maxdepth 1 -xtype f 2>/dev/null | sort)
  log Info "cycle_wallpaper: mode=$mode files=${#files[@]}"

  if ((${#files[@]} == 0)); then
    log Info "No wallpaper files found in $WALLS"
    return 1
  fi

  get_wallpaper current
  log Info "current wallpaper: $current"

  found=0
  idx=0

  # Locate the current wallpaper's position in the sorted file list.
  if [[ -n "$current" ]]; then
    for i in "${!files[@]}"; do
      if [[ "${files[$i]}" == "$current" ]]; then
        idx=$i
        found=1
        break
      fi
    done
  fi

  log Info "current index: $idx (found=$found)"

  case "$mode" in
  --next)
    if ((found)); then
      next=$(((idx + 1) % ${#files[@]}))
      candidate="${files[$next]}"
    else
      candidate="${files[0]}"
    fi
    ;;
  --prev)
    if ((found)); then
      prev=$(((idx - 1 + ${#files[@]}) % ${#files[@]}))
      candidate="${files[$prev]}"
    else
      candidate="${files[${#files[@]} - 1]}"
    fi
    ;;
  esac

  log Info "candidate: $candidate"

  if [[ "$candidate" == "$current" ]]; then
    log Info "candidate matches current, nothing to do"
    return 0
  fi

  _result="$candidate"
  log Info "new wallpaper selected: $candidate"
}

feature_enabled() {
  source vb-lib-core

  helpers::check VIBRANIUM_GLOBAL_SHOW_WALLPAPER
  if [[ $VIBRANIUM_GLOBAL_SHOW_WALLPAPER == true ]]; then
    if ! systemctl -q --user is-active awww.service; then
      systemctl -q --user enable --now awww.service
    fi
  else
    return 1
  fi
}

action=""
raw_path=""

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  -g | --get)
    action="get"
    ;;
  --next)
    action="next"
    ;;
  --prev)
    action="prev"
    ;;
  --)
    shift
    break
    ;;
  -*)
    log Error "unknown option: $1"
    log Error "Try ${0##*/} --help for more information."
    exit 1
    ;;
  *)
    raw_path="$1"
    ;;
  esac
  shift
done

# Normalize file extension to lowercase so that .JPG, .PNG, etc. are
# treated identically to their lowercase counterparts.
_dispatch=""
if [[ -n "$raw_path" ]]; then
  _dispatch="$raw_path"
  if [[ "$_dispatch" != -* ]]; then
    _fname="${_dispatch##*/}"
    if [[ "$_fname" == *"."* ]]; then
      _ext="${_fname##*.}"
      _ext_lower="${_ext,,}"
      if [[ "$_ext" != "$_ext_lower" ]]; then
        _dispatch="${_dispatch%"$_fname"}${_fname%"$_ext"}${_ext_lower}"
      fi
    fi
  fi
fi

THEME="$(<"$XDG_CONFIG_HOME/vibranium/current/theme.name")"
UWALLS="$XDG_CONFIG_HOME/vibranium/themes/$THEME/backgrounds"

if [[ -z "$action" && -z "$_dispatch" ]]; then
  usage
  exit 0
fi

if [[ "$action" == "get" ]]; then
  get_wallpaper CURRENT
  echo "$CURRENT"
  exit 0
fi

if [[ "$action" == "next" || "$action" == "prev" ]]; then
  if ! feature_enabled; then
    exit 0
  fi

  WALLPAPER_PATH=""
  cycle_wallpaper WALLPAPER_PATH "--$action"

  if [[ -z "$WALLPAPER_PATH" ]]; then
    exit 0
  fi
elif [[ -n "$_dispatch" ]]; then
  case "$_dispatch" in
  *.png | *.jpg | *.jpeg | *.jpegxl | *.webp | *.pnm | *.tga | *.tiff | *.bmp | *.svg)
    if ! feature_enabled; then
      exit 0
    fi

    WALLPAPER_PATH="$(realpath "$raw_path")"

    if [[ ! -f "$WALLPAPER_PATH" ]]; then
      log Error "'$WALLPAPER_PATH' doesn't exist!"
      exit 1
    fi

    if [[ ! -f "$WALLS/${WALLPAPER_PATH##*/}" ]]; then
      log Info "Copying external wallpaper from $WALLPAPER_PATH to theme backgrounds"
      mkdir -p "$UWALLS"
      cp "$WALLPAPER_PATH" "$UWALLS/"
      cp "$WALLPAPER_PATH" "$XDG_CONFIG_HOME/vibranium/current/theme/backgrounds/"
      WALLPAPER_PATH="$UWALLS/${WALLPAPER_PATH##*/}"
      log Info "Wallpaper copied, new path: $WALLPAPER_PATH"
    fi
    ;;
  *)
    log Error "unsupported file format: $_dispatch"
    log Error "Try ${0##*/} --help for more information."
    exit 1
    ;;
  esac
fi

log Info "Setting wallpaper: $WALLPAPER_PATH"
log Info "awww img command: fade duration=0.5 step=255 path=$WALLPAPER_PATH"
awww img -t fade --transition-duration 0.5 --transition-step 255 "$WALLPAPER_PATH" &
ln -sf "$WALLPAPER_PATH" "$XDG_CONFIG_HOME/vibranium/current/background"
log Info "Symlink updated: $XDG_CONFIG_HOME/vibranium/current/background -> $WALLPAPER_PATH"

# Update the state file
write_wallpaper_state "$THEME" "$WALLPAPER_PATH"
log Info "Wallpaper state written: theme=$THEME path=$WALLPAPER_PATH"
