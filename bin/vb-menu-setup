#!/usr/bin/env bash

source vb-lib-core
source vb-lib-cfgr

_launch() {
  vb-core-term --floating -- "$1"
  helpers::ui::close_menus
}

_build() {
  cfgr::item::action --label "Secure Boot" --func "_launch vb-setup-sboot"
  cfgr::item::action --label "Firewall" --func "_launch vb-setup-ufw"
  cfgr::item::action --label "Docker" --func "_launch vb-setup-docker"
  cfgr::item::action --label "QEMU" --func "_launch vb-setup-qemu"
}

cfgr::run "Setup" "_build"
