#!/usr/bin/env bash

source vb-lib-core
source vb-lib-cfgr

_die() { helpers::ui::close_menus; }

_build() {
  cfgr::item::action --label "Secure Boot" --func "vb-core-term --floating -- vb-setup-sboot; _die "
  cfgr::item::action --label "Firewall" --func "vb-core-term --floating -- vb-setup-ufw; _die "
  cfgr::item::action --label "Docker" --func "vb-core-term --floating -- vb-setup-docker; _die "
  cfgr::item::action --label "QEMU" --func "vb-core-term --floating -- vb-setup-qemu; _die "
}

cfgr::run "Setup" "_build"
