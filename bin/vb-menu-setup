#!/usr/bin/env bash

source vb-lib-core

OPTIONS=(
  "Secure Boot"
  "Firewall"
  "Docker"
  "QEMU"
)

while true; do
  helpers::ui::menu CHOSEN "Setup" "ESC to go back" -- "${OPTIONS[@]}"
  [[ -z "$CHOSEN" ]] && break

  case "$CHOSEN" in
    "QEMU") vb-core-term --floating -- vb-setup-qemu ;;
    "Docker") vb-core-term --floating -- vb-setup-docker ;;
    "Firewall") vb-core-term --floating -- vb-setup-ufw ;;
    "Secure Boot") vb-core-term --floating -- vb-setup-secure-boot ;;
  esac

  helpers::ui::close_menus
done
