#!/usr/bin/env bash

source vb-core-lib

OPTIONS=(
    "QEMU"
)

while true; do
    helpers::ui::menu CHOSEN "Setup" "ESC to go back" -- "${OPTIONS[@]}"
    [[ -z "$CHOSEN" ]] && break

    case "$CHOSEN" in
        "QEMU")
            vb-core-term --floating -- vb-setup-qemu
            helpers::ui::close_menus
            ;;
    esac
done
