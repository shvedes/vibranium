#!/usr/bin/env bash

_usage() {
    cat <<EOF
Usage: ${0##*/} [OPTION]...

List available X11 cursor themes.

The script scans standard icon directories and prints themes in the format:
  directory|theme name

Options:
  -h, --help     display this help and exit
EOF
}

if [[ "$1" =~ ^(-h|--help)$ ]]; then
    _usage
    exit 0
fi

parse_cursor_theme() {
    local file="$1"
    local line name
    local in_section=false

    # parse "Name=" inside [Icon Theme] section
    while IFS= read -r line; do
        case "$line" in
            "[Icon Theme]")
                in_section=true
                ;;
            "["*)
                in_section=false
                ;;
            Name=*)
                if [[ $in_section == true ]]; then
                    name=${line#Name=}
                    break
                fi
                ;;
        esac
    done < "$file"

    # if name found, store under theme directory name
    [[ -n "$name" ]] || return

    local dir=${file%/*}
    dir=${dir##*/}

    THEMES["$dir"]="$name"
}

SEARCH_DIRS=(
    "/usr/share/icons"
    "$XDG_DATA_HOME/icons"
    "$HOME/.icons"
)

declare -A THEMES

for base in "${SEARCH_DIRS[@]}"; do
    [[ -d "$base" ]] || continue

    # iterate theme directories (one level deep) using glob
    for theme_dir in "$base"/*/; do
        [[ -d "$theme_dir" ]] || continue

        # remove trailing slash for consistent naming
        theme_dir="${theme_dir%/}"

        # check whether this theme actually contains cursors
        if [[ -d "$theme_dir/cursors" ]]; then
            if [[ -f "$theme_dir/cursor.theme" ]]; then
                parse_cursor_theme "$theme_dir/cursor.theme"
            elif [[ -f "$theme_dir/index.theme" ]]; then
                parse_cursor_theme "$theme_dir/index.theme"
            else
                dir_name=${theme_dir##*/}
                THEMES["$dir_name"]="$dir_name"
            fi
        fi
    done
done

for dir in "${!THEMES[@]}"; do
    printf "%s|%s\n" "$dir" "${THEMES[$dir]}"
done

