#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION] <image>

Open an image with imv in Vibranium.

Options:
  -h, --help      Display this help and exit
  -v, --verbose   Enable verbose output
  <image>         Path to an image file to open
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ -z "$1" ]]; then
  log Info "No file arg, opening picker"
  if ! command -v zenity > /dev/null; then
    log Error "Zenity not found"
    [[ -t 1 ]] && vb-cmd-dep-notify --name "Image Viewer" --deps zenity
    exit 1
  fi

  file="$(zenity --title="Select File" --file-selection --file-filter="Image File | *.png *.jpg *.jpeg *.ppm *.webp" 2> /dev/null)"

  # no files were chosen
  if [[ ! -f "$file" ]]; then
    log Info "No file selected"
    exit 1
  fi
  log Info "Selected file: $file"
else
  file="$1"
  log Info "Using file: $file"
fi

log Info "Opening using xdg-open"
exec xdg-open "$file"
