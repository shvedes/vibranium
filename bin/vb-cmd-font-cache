#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]...

Update font cache.

Options:
  -v, --verbose   Enable verbose output
  -h, --help      Display this help and exit

This command forces a rebuild of the fontconfig cache using fc-cache -f.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      usage
      exit 1
      ;;
  esac
done

log Info "Rebuilding font cache"
# Force a full rebuild: -f ignores timestamps and re-scans every font
# directory. Without -f, fc-cache only updates directories whose mtime
# has changed since the last run.
fc-cache -f
