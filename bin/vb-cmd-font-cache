#!/usr/bin/bash

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

_usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]...

Update font cache.

Options:
  -h, --help      display this help and exit

This command forces a rebuild of the fontconfig cache using fc-cache -f.
EOF
}

case "$1" in
"") true ;;
-h | --help)
  _usage
  exit 0
  ;;
*)
  _usage
  exit 1
  ;;
esac

fc-cache -f
