#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

A basic screenshot utility for Vibranium.

Options:
  --screen    Capture active screen
  --window    Capture active window
  --region    Capture selected region
  --annotate  Annotate taken screenshot
  -v, --verbose Enable verbose output
  -h, --help  Display this help and exit
EOF
}

# Copy the screenshot path to the clipboard as a text/uri-list so
# pasting in a file manager or chat app treats it as a file reference
# rather than a plain-text path.
copy() {
  printf 'file://%s' "$1" | wl-copy --type text/uri-list
}

notify() {
  if [[ $VIBRANIUM_SCREENSHOT_SHOW_NOTIFICATION == false ]]; then
    return 0
  fi

  case "$1" in
  region) local target='Selected region' ;;
  window) local target='Active window' ;;
  screen) local target='Active screen' ;;
  esac

  if [[ $VIBRANIUM_SCREENSHOT_SAVE_TO_DISK == true ]]; then
    local message='saved to disk'
  else
    local message='captured'
  fi

  notify-send -r 3 -t 1500 'Screenshot' "$target $message"
}

set_output_file() {
  local -n _path=$1

  # When saving to disk is disabled, the screenshot is written to the
  # runtime directory (tmpfs) and exists only until reboot. Otherwise
  # it goes to ~/Pictures/Screenshots/ with a timestamped filename.
  if [[ $VIBRANIUM_SCREENSHOT_SAVE_TO_DISK == false ]]; then
    _path="$VIBRANIUM_RUNTIME/screenshot.$FILETYPE"
    return
  fi

  local dir timestamp
  dir="${XDG_PICTURES_DIR:-$HOME}/Screenshots"
  printf -v timestamp '%(%Y-%m-%d_%H-%M-%S)T' -1

  if [[ ! -d "$dir" ]]; then
    mkdir -p "$dir"
  fi

  _path="$dir/screenshot-$timestamp.$FILETYPE"
}

# slurp interactive region selector.
#   -d  draw borders
#   -w 1  border width in px
#   -b / -c  overlay color from Vibranium theme variables
# Output format matches grim's -g geometry syntax: WxH+X+Y
select_region() {
  local -n _region=$1
  local result result_rc

  result="$(slurp -d -w 1 -b "${P_GRAY}33" -c "${P_ACCENT}" 2>/dev/null)"
  result_rc=$?

  if ((result_rc != 0)) || [[ -z $result ]]; then
    return 1
  fi

  _region="$result"
}

# Extract the focused window's geometry from Hyprland as a grim-compatible
# geometry string: "X,Y WxH" (e.g. "100,50 1920x1080").
# hyprctl -j activewindow returns the window's at[] and size[] arrays;
# the jq expression formats them directly.
get_window_geometry() {
  local -n _geometry=$1
  local result expression

  expression='"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
  result="$(hyprctl -j activewindow | jq -r "$expression")"

  if [[ $result == *null* ]]; then
    return 1
  fi

  _geometry="$result"
}

capture() {
  local monitor
  local target="$1"
  local output_file

  set_output_file output_file
  log Info "Capturing $target screenshot -> $output_file"

  case "$target" in
  region)
    local region
    if ! select_region region; then
      exit 1
    fi

    grim "${GRIM_OPTS[@]}" -g "$region" "$output_file"
    ;;
  window)
    local geometry
    if ! get_window_geometry geometry; then
      exit 1
    fi

    grim "${GRIM_OPTS[@]}" -g "$geometry" "$output_file"

    if [[ $FLASH_BORDER == true ]]; then
      hypr::flash::border
    fi
    ;;
  screen)
    monitor="$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')"
    grim "${GRIM_OPTS[@]}" -o "$monitor" "$output_file"

    if [[ $FLASH_SCREEN == true ]]; then
      hypr::flash::screen
    fi
    ;;
  esac

  if [[ ! -f $output_file ]]; then
    exit 1
  fi

  copy "$output_file"
  notify "$target"

  if [[ $ANNOTATE == true ]]; then
    exec setsid -f app2unit vb-util-image-annotator "$output_file"
  fi
}

init() {
  source vb-lib-core

  helpers::check \
    VIBRANIUM_SCREENSHOT_FILE_TYPE \
    VIBRANIUM_SCREENSHOT_SAVE_TO_DISK \
    VIBRANIUM_SCREENSHOT_JPEG_QUALITY \
    VIBRANIUM_SCREENSHOT_FLASH_SCREEN \
    VIBRANIUM_SCREENSHOT_FLASH_BORDER \
    VIBRANIUM_SCREENSHOT_AUTO_ANNOTATE \
    VIBRANIUM_SCREENSHOT_CAPTURE_CURSOR \
    VIBRANIUM_SCREENSHOT_SHOW_NOTIFICATION

  FILETYPE="$VIBRANIUM_SCREENSHOT_FILE_TYPE"
  FLASH_SCREEN=$VIBRANIUM_SCREENSHOT_FLASH_SCREEN
  FLASH_BORDER=$VIBRANIUM_SCREENSHOT_FLASH_BORDER
  ANNOTATE=$VIBRANIUM_SCREENSHOT_AUTO_ANNOTATE
  CURSOR=$VIBRANIUM_SCREENSHOT_CAPTURE_CURSOR

  GRIM_OPTS=()

  # grim -c includes the cursor in the screenshot.
  if [[ $CURSOR == true ]]; then
    GRIM_OPTS+=(-c)
  fi

  GRIM_OPTS+=(-t "$FILETYPE")

  # grim -q sets JPEG quality (0-100); only applicable for jpeg/jpg output.
  if [[ $FILETYPE =~ ^jp(e)?g$ ]]; then
    GRIM_OPTS+=(-q "$VIBRANIUM_SCREENSHOT_JPEG_QUALITY")
  fi
}

check_deps() {
  local dep missing=()

  for dep in grim slurp jq; do
    if ! command -v "$dep" >/dev/null; then
      missing+=("$dep")
    fi
  done

  if ((${#missing[@]} > 0)); then
    vb-cmd-dep-notify --name 'Screenshot Utility' --deps "${missing[*]}"
    return 1
  fi
}

MODE=''
# Tracks whether --annotate was passed on the command line.
# When true, annotation is forced regardless of VIBRANIUM_SCREENSHOT_AUTO_ANNOTATE.
EXPLICIT_ANNOTATE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  --region | --window | --screen)
    MODE="${1#--}"
    shift
    ;;
  --annotate)
    EXPLICIT_ANNOTATE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown option: $1" >&2
    echo "Try '${0##*/} --help' for more information" >&2
    exit 1
    ;;
  esac
done

# No capture mode given — nothing to do.
if [[ -z $MODE ]]; then
  usage
  exit 0
fi

if slurp_pid="$(pidof slurp)"; then
  kill "$slurp_pid"
  exit 1
fi

if ! check_deps; then
  exit 1
fi

init

# --annotate was passed explicitly: force annotation, ignoring the
# VIBRANIUM_SCREENSHOT_AUTO_ANNOTATE builtin setting.
if [[ $EXPLICIT_ANNOTATE == true ]]; then
  ANNOTATE=true
fi

capture "$MODE"
