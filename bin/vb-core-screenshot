#!/usr/bin/env bash

# Overcomplicated (as usual) script for creating screenshots.
# All-in wrapper for grim & slurp with a bunch of user settings on top.

source "$VIBRANIUM_PATH/vb-core-lib"

usage() {
    cat << EOF
Usage: vb-core-screenshot [OPTION]

Options:
  --region    Select region
  --window    Select window
  --screen    Select screen
  -h, --help  Display this help and exit
EOF
}

notification() {
    local target message is_on_disk

    is_on_disk="$VIBRANIUM_SCREENSHOT_SAVE_TO_DISK"

    case "$1" in
        "--region") target="Selected region" ;;
        "--window") target="Active window" ;;
        "--screen") target="Active screen" ;;
    esac

    if [[ "$is_on_disk" == true ]]; then
        message="saved to disk"
    else
        message="captured"
    fi

    notify-send -r 1 -t 1500 "Vibranium" "$target $message"
}

if [[ "$1" =~ ^-(h|-help)$ ]]; then
    usage
    exit 0
elif [[ $# -lt 1 ]] || [[ ! $1 =~ ^--(region|window|screen) ]]; then
    usage
    exit 1
fi

if slurp_pid="$(pidof slurp)"; then
    print_warn "Killing existing process"
    kill "$slurp_pid"
    exit 1
fi

if ! missing_str="$(vb-cmd-is-present jq grim slurp)"; then
    read -r -a missing <<< "$missing_str"
    notify-send -r 2 -t 0 -u critical "$(basename "$0")" "Missing cli utilities: ${missing[*]}"
    exit 1
fi

# Load and validate settings
check_enum VIBRANIUM_SCREENSHOT_FILE_TYPE "jpg" png jpeg jpg ppm

check_bool VIBRANIUM_GLOBAL_COPY_TO_CLIPBOARD true
check_bool VIBRANIUM_SCREENSHOT_INCLUDE_CURSOR false
check_bool VIBRANIUM_SCREENSHOT_SAVE_TO_DISK true
check_bool VIBRANIUM_SCREENSHOT_SHOW_NOTIFICATION true

notify="$VIBRANIUM_SCREENSHOT_SHOW_NOTIFICATION"
use_clipboard="$VIBRANIUM_GLOBAL_COPY_TO_CLIPBOARD"
show_cursor="$VIBRANIUM_SCREENSHOT_INCLUDE_CURSOR"
save_file="$VIBRANIUM_SCREENSHOT_SAVE_TO_DISK"
filetype="$VIBRANIUM_SCREENSHOT_FILE_TYPE"

# Build grim options
opt_options=()

# If JPEG is selected, we must check whether its quality is set beyond the possible range (0-100)
if [[ $filetype =~ jp(e)?g ]]; then
    check_int VIBRANIUM_SCREENSHOT_JPEG_QUALITY 80 int
    jpg_quality="$VIBRANIUM_SCREENSHOT_JPEG_QUALITY"

    opt_options+=(-t jpeg -q "$jpg_quality")

    # Let's imagine that you are watching a video or playing a video game
    # and you want to quickly capture a frame to send to a friend or simply enlarge it in a photo editing program.
    # JPEG compression is great, of course, but right now we need all the details of the image!
    if is_fullscreen && [[ "$1" == "screen" ]]; then
        check_int VIBRANIUM_SCREENSHOT_JPEG_QUALITY_FULLSCREEN 100 int
        jpg_fullscreen_quality="$VIBRANIUM_SCREENSHOT_JPEG_QUALITY_FULLSCREEN"

        # Only use fullscreen quality if it's not a reference and greater than current quality
        if [[ $jpg_fullscreen_quality != "$jpg_quality" ]] && ((jpg_fullscreen_quality > jpg_quality)); then
            # Validate quality bounds
            if ((jpg_fullscreen_quality > 100)); then
                jpg_fullscreen_quality=100
            elif ((jpg_fullscreen_quality < 50)); then
                jpg_fullscreen_quality=50
            fi
            jpg_quality=$jpg_fullscreen_quality
        fi
    fi

    # Validate quality bounds (0-100)
    if ((jpg_quality < 0 || jpg_quality > 100)); then
        jpg_quality=80
    fi
else
    opt_options+=(-t "${filetype}")
fi

# Determine output file path (disk or RAM)
if [[ $save_file == true ]]; then
    output_dir="${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots"
    output_file="${output_dir}/$(date +"screenshot-%Y-%m-%d_%H-%M-%S").${filetype}"
    mkdir -p "$output_dir"
else
    output_file="/tmp/screenshot.${filetype}"
fi

if [[ $show_cursor == true ]]; then
    opt_options+=(-c)
fi

animations_enabled="$(
    [[ $(hyprctl -j getoption animations:enabled | jq -r '.int') == "0" ]] && {
        echo false
    } || {
        echo true
    }
)"

case "$1" in
    "--region")
        selected_region="$(slurp -d -w 1 -b "${P_GRAY}"33 -c "${P_ACCENT}" 2>/dev/null)"
        if [[ -z "$selected_region" ]]; then
            print_warn "Selection cancelled"
            exit 1
        fi
        grim "${opt_options[@]}" -g - "$output_file" <<< "$selected_region"
        ;;
    "--window")
        check_bool VIBRANIUM_GLOBAL_FLASH_BORDER true
        check_bool VIBRANIUM_SCREENSHOT_FLASH_BORDER true

        g_flash_border="$VIBRANIUM_GLOBAL_FLASH_BORDER"
        l_flash_border="$VIBRANIUM_SCREENSHOT_FLASH_BORDER"

        # Parse active window geometry
        if ! window_geometry="$(hyprctl -j activewindow | jq -r '.at[0] as $x | .at[1] as $y | .size[0] as $w | .size[1] as $h | "\($x),\($y) \($w)x\($h)"')"; then
            print_error "Failed to determine active window geometry"
            notify-send -r 4 -u critical -t 3000 "Vibranium - Screenshot Utility" "Failed to determine active window geometry"
            exit 1
        fi

        # Optionally flash border to indicate target
        if [[ $g_flash_border == true && $l_flash_border == true ]]; then
            if [[ $animations_enabled == false ]]; then
                print_warn "Ignoring border flashing effect due to disabled animations"
            fi
            _flash border &
        fi

        grim -g "$window_geometry" "${opt_options[@]}" "$output_file" &
        # Wait for the final file write so that
        # the statement below does not evaluate to false.
        wait $!
        ;;

    "--screen")
        check_bool VIBRANIUM_SCREENSHOT_FLASH_SCREEN true
        check_bool VIBRANIUM_GLOBAL_FLASH_SCREEN true

        g_flash_screen="$VIBRANIUM_GLOBAL_FLASH_SCREEN"
        l_flash_screen="$VIBRANIUM_SCREENSHOT_FLASH_SCREEN"

        if [[ $g_flash_screen == true && $l_flash_screen == true ]]; then
            _flash screen &
            if [[ $animations_enabled == false ]]; then
                print_warn "Ignoring screen flashing effect due to disabled animations"
            fi
        fi

        grim "${opt_options[@]}" "$output_file" &
        # Wait for the final file write so that
        # the statement below does not evaluate to false.
        wait $!
        ;;
esac

# Ensure output file exists
if [[ ! -f $output_file ]]; then
    notify-send -r 3 -t 3000 -u critical "Vibranium" "Screenshot failed!"
    print_error "Unable to save file!"
    exit 1
fi

# Show notification
if [[ $notify == true ]]; then
    notification "$1"
fi

# Copy the image to the Wayland clipboard with the correct MIME type
if [[ $use_clipboard == true ]]; then
    printf "file://%s" "${output_file}" | wl-copy --type text/uri-list
fi
