#!/usr/bin/bash

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

A basic screenshot utility for Vibranium.

Options:
  --region    Capture region
  --window    Capture window
  --screen    Capture screen
  -h, --help  Display this help and exit
EOF
}

copy() {
  printf "file://%s" "$1" | wl-copy --type text/uri-list
}

notify() {
  local target message is_on_disk

  if [[ $VIBRANIUM_SCREENSHOT_SHOW_NOTIFICATION == false ]]; then
    return 0
  fi

  is_on_disk="$VIBRANIUM_SCREENSHOT_SAVE_TO_DISK"

  case "$1" in
  "region") target="Selected region" ;;
  "window") target="Active window" ;;
  "screen") target="Active screen" ;;
  esac

  if [[ "$is_on_disk" == true ]]; then
    message="saved to disk"
  else
    message="captured"
  fi

  notify-send -r 3 -t 1500 "Screenshot" "$target $message"
}

set_output_dir() {
  mkdir -p "${XDG_PICTURES_DIR:-$HOME}/Screenshots"
  printf "%s" "${XDG_PICTURES_DIR:-$HOME}/Screenshots"
}

set_output_file() {
  if [[ $VIBRANIUM_SCREENSHOT_SAVE_TO_DISK == false ]]; then
    printf "$VIBRANIUM_RUNTIME/screenshot.%s" "$FILETYPE"
    return
  fi

  local date
  date="$(date +"%Y-%m-%d_%H-%M-%S")"

  printf "%s/screenshot-%s.%s" "$(set_output_dir)" "$date" "$FILETYPE"
}

select_region() {
  local region
  region="$(slurp -d -w 1 -b "${P_GRAY}33" -c "${P_ACCENT}" 2>/dev/null)"

  if [[ -z $region ]]; then
    return 1
  fi

  printf "%s" "$region"
}

get_window_geometry() {
  local geometry
  geometry="$(hyprctl -j activewindow | jq -r '"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"')"

  if [[ $geometry == *null* ]]; then
    return 1
  fi

  printf "%s" "$geometry"
}

capture() {
  local target="$1"
  local geometry region
  local output_file

  output_file="$(set_output_file)"

  case "$target" in
  region)

    if ! region="$(select_region)"; then
      exit 1
    fi

    # shellcheck disable=SC2068
    grim ${GRIM_OPTS[@]} -g "$region" "$output_file"
    ;;
  window)

    if ! geometry="$(get_window_geometry)"; then
      exit 1
    fi

    # shellcheck disable=SC2068
    grim ${GRIM_OPTS[@]} -g "$geometry" "$output_file"

    if [[ $FLASH_BORDER == true ]]; then
      hypr::flash::border
    fi
    ;;
  screen)
    # shellcheck disable=SC2068
    grim ${GRIM_OPTS[@]} "$output_file"

    if [[ $FLASH_SCREEN == true ]]; then
      hypr::flash::screen
    fi
    ;;
  esac

  if [[ ! -f "$output_file" ]]; then
    exit 1
  fi

  copy "$output_file"
  notify "$target"

  if [[ $ANNOTATE == true ]]; then
    exec setsid -f app2unit vb-util-image-annotator "$output_file"
  fi

}

init() {
  source vb-lib-core

  helpers::check \
    VIBRANIUM_SCREENSHOT_FILE_TYPE \
    VIBRANIUM_SCREENSHOT_SAVE_TO_DISK \
    VIBRANIUM_SCREENSHOT_JPEG_QUALITY \
    VIBRANIUM_SCREENSHOT_FLASH_SCREEN \
    VIBRANIUM_SCREENSHOT_FLASH_BORDER \
    VIBRANIUM_SCREENSHOT_AUTO_ANNOTATE \
    VIBRANIUM_SCREENSHOT_CAPTURE_CURSOR \
    VIBRANIUM_SCREENSHOT_SHOW_NOTIFICATION

  FILETYPE="$VIBRANIUM_SCREENSHOT_FILE_TYPE"
  FLASH_SCREEN=$VIBRANIUM_SCREENSHOT_FLASH_SCREEN
  FLASH_BORDER=$VIBRANIUM_SCREENSHOT_FLASH_BORDER
  ANNOTATE=$VIBRANIUM_SCREENSHOT_AUTO_ANNOTATE
  CURSOR=$VIBRANIUM_SCREENSHOT_CAPTURE_CURSOR

  GRIM_OPTS=()

  if [[ $CURSOR == true ]]; then
    GRIM_OPTS+=(-c)
  fi

  GRIM_OPTS+=(-t "$FILETYPE")

  if [[ $FILETYPE =~ jp(e)?g ]]; then
    GRIM_OPTS+=(-q "$VIBRANIUM_SCREENSHOT_JPEG_QUALITY")
  fi
}

check_deps() {
  local missing=()
  local deps=(grim slurp jq)

  for d in "${deps[@]}"; do
    if ! command -v "$d" >/dev/null; then
      missing+=("$d")
    fi
  done

  if ((${#missing[@]} > 0)); then
    vb-cmd-dep-notify --name "Screenshot Utility" --deps "${missing[*]}"
    return 1
  fi
}

case "$1" in
--region | --window | --screen)
  if slurp_pid="$(pidof slurp)"; then
    kill "$slurp_pid"
    exit 1
  fi

  if ! check_deps; then
    exit 1
  fi

  init
  capture "${1/--/}"
  ;;
-h | --help | "")
  usage
  exit 0
  ;;
*)
  echo "Unknown option: $1." >&2
  echo "Use flag --help to see available options." >&2
  exit 1
  ;;
esac
