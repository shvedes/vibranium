#!/bin/bash

source vb-lib-cli

VERBOSE=false

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

A basic screenshot utility for Vibranium.

Options:
  --screen    Capture active screen
  --window    Capture active window
  --region    Capture selected region
  --annotate  Annotate taken screenshot
  -v, --verbose Enable verbose output
  -h, --help  Display this help and exit
EOF
}

copy() {
  log Info "Copying to clipboard: $1"
  printf 'file://%s' "$1" | wl-copy --type text/uri-list
  log Info "Copied to clipboard: $1"
}

notify() {
  log Info "Sending notification for target: $1"

  if [[ $VIBRANIUM_SCREENSHOT_SHOW_NOTIFICATION == false ]]; then
    log Info "Notification suppressed"
    return 0
  fi

  case "$1" in
    region)
      local target='Selected region'
      ;;
    window)
      local target='Active window'
      ;;
    screen)
      local target='Active screen'
      ;;
  esac

  if [[ $VIBRANIUM_SCREENSHOT_SAVE_TO_DISK == true ]]; then
    local message='saved to disk'
  else
    local message='captured'
  fi

  notify-send -r 3 -t 1500 'Screenshot' "$target $message"
  log Info "Notification: $target $message"
}

set_output_file() {
  local -n _path=$1

  if [[ $VIBRANIUM_SCREENSHOT_SAVE_TO_DISK == false ]]; then
    _path="$VIBRANIUM_RUNTIME/screenshot.$FILETYPE"
    log Info "Output: $_path (tmpfs)"
    return
  fi

  local dir timestamp
  dir="${XDG_PICTURES_DIR:-$HOME}/Screenshots"
  printf -v timestamp '%(%Y-%m-%d_%H-%M-%S)T' -1

  if [[ ! -d "$dir" ]]; then
    mkdir -p "$dir"
  fi

  _path="$dir/screenshot-$timestamp.$FILETYPE"
  log Info "Output: $_path (disk)"
}

select_region() {
  local -n _region=$1
  local result result_rc

  log Info "Selecting region via slurp"
  result="$(slurp -d -w 1 -b "${P_GRAY}33" -c "${P_ACCENT}" 2> /dev/null)"
  result_rc=$?

  if ((result_rc != 0)) || [[ -z $result ]]; then
    log Info "Region selection cancelled"
    return 1
  fi

  _region="$result"
  log Info "Region selected: $_region"
}

get_window_geometry() {
  local -n _geometry=$1
  local result expression

  log Info "Getting active window geometry"
  expression='"\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])"'
  result="$(hyprctl -j activewindow | jq -r "$expression")"

  if [[ $result == *null* ]]; then
    log Info "No active window geometry found"
    return 1
  fi

  _geometry="$result"
  log Info "Window geometry: $_geometry"
}

capture() {
  local monitor
  local target="$1"
  local output_file

  set_output_file output_file
  log Info "Capturing $target screenshot -> $output_file"

  case "$target" in
    region)
      local region
      if ! select_region region; then
        exit 1
      fi

      grim "${GRIM_OPTS[@]}" -g "$region" "$output_file"
      log Info "grim: region=$region output=$output_file"
      ;;
    window)
      local geometry
      if ! get_window_geometry geometry; then
        exit 1
      fi

      grim "${GRIM_OPTS[@]}" -g "$geometry" "$output_file"
      log Info "grim: geometry=$geometry output=$output_file"

      if [[ $FLASH_BORDER == true ]]; then
        hypr::flash::border
        log Info "Border flash triggered"
      fi
      ;;
    screen)
      monitor="$(hyprctl -j monitors | jq -r '.[] | select(.focused) | .name')"
      log Info "Monitor: $monitor"
      grim "${GRIM_OPTS[@]}" -o "$monitor" "$output_file"
      log Info "grim: monitor=$monitor output=$output_file"

      if [[ $FLASH_SCREEN == true ]]; then
        hypr::flash::screen
        log Info "Screen flash triggered"
      fi
      ;;
  esac

  if [[ ! -f $output_file ]]; then
    log Error "Screenshot file not found: $output_file"
    exit 1
  fi

  log Info "Screenshot saved: $output_file"

  copy "$output_file"
  notify "$target"

  if [[ $ANNOTATE == true ]]; then
    log Info "Launching annotator for: $output_file"
    exec setsid -f app2unit vb-util-image-annotator "$output_file"
  fi
}

init() {
  log Info "Initializing screenshot config"
  source vb-lib-core

  helpers::check \
    VIBRANIUM_SCREENSHOT_FILE_TYPE \
    VIBRANIUM_SCREENSHOT_SAVE_TO_DISK \
    VIBRANIUM_SCREENSHOT_JPEG_QUALITY \
    VIBRANIUM_SCREENSHOT_FLASH_SCREEN \
    VIBRANIUM_SCREENSHOT_FLASH_BORDER \
    VIBRANIUM_SCREENSHOT_AUTO_ANNOTATE \
    VIBRANIUM_SCREENSHOT_CAPTURE_CURSOR \
    VIBRANIUM_SCREENSHOT_SHOW_NOTIFICATION

  FILETYPE="$VIBRANIUM_SCREENSHOT_FILE_TYPE"
  FLASH_SCREEN=$VIBRANIUM_SCREENSHOT_FLASH_SCREEN
  FLASH_BORDER=$VIBRANIUM_SCREENSHOT_FLASH_BORDER
  ANNOTATE=$VIBRANIUM_SCREENSHOT_AUTO_ANNOTATE
  CURSOR=$VIBRANIUM_SCREENSHOT_CAPTURE_CURSOR

  GRIM_OPTS=()

  if [[ $CURSOR == true ]]; then
    GRIM_OPTS+=(-c)
  fi

  GRIM_OPTS+=(-t "$FILETYPE")

  if [[ $FILETYPE =~ ^jp(e)?g$ ]]; then
    GRIM_OPTS+=(-q "$VIBRANIUM_SCREENSHOT_JPEG_QUALITY")
  fi

  log Info "Config loaded: filetype=$FILETYPE cursor=$CURSOR annotate=$ANNOTATE flash_screen=$FLASH_SCREEN flash_border=$FLASH_BORDER"
}

check_deps() {
  local dep missing=()
  log Info "Verifying dependencies: grim slurp jq"

  for dep in grim slurp jq; do
    if ! command -v "$dep" > /dev/null; then
      missing+=("$dep")
    fi
  done

  if ((${#missing[@]} > 0)); then
    log Error "Missing dependencies: ${missing[*]}"
    vb-cmd-dep-notify --name 'Screenshot Utility' --deps "${missing[*]}"
    return 1
  fi
}

MODE=''
EXPLICIT_ANNOTATE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    --region | --window | --screen)
      MODE="${1#--}"
      log Info "Mode: $MODE"
      shift
      ;;
    --annotate)
      EXPLICIT_ANNOTATE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log Error "Unknown option: $1"
      log Error "Try '${0##*/} --help' for more information"
      exit 1
      ;;
  esac
done

if [[ -z $MODE ]]; then
  usage
  exit 0
fi

if slurp_pid="$(pidof slurp)"; then
  log Info "Killing existing slurp (PID: $slurp_pid)"
  kill "$slurp_pid"
  exit 1
fi

if ! check_deps; then
  exit 1
fi

init

if [[ $EXPLICIT_ANNOTATE == true ]]; then
  ANNOTATE=true
  log Info "Annotation forced via --annotate flag"
fi

log Info "Capturing mode=$MODE"
capture "$MODE"
