#!/bin/bash

if [[ $CHASSIS_TYPE == vm ]]; then
  log Error "Screen recording is not available in a VM"
  exit 1
fi

VERBOSE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

SELF="${0##*/}"
LOG_FILE="$VIBRANIUM_CACHE/$SELF.log"

log Info "$SELF started: log_file=$LOG_FILE"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Basic screen recording utility created for Vibranium.

Options:
  --region    Record region
  --screen    Record screen
  --portal    Use xdg-desktop-portal
  --stop      Stop active recording
  -v, --verbose Enable verbose output
  -h, --help  Display this help and exit
EOF
}

get_output_dir() {
  local -n _dir=$1
  log Info "Resolving output directory"
  _dir="${XDG_VIDEOS_DIR:-$HOME/Videos}/Screencasts"

  if [[ ! -d "$_dir" ]]; then
    mkdir -p "$_dir"
    log Info "Created output directory: $_dir"
  fi
  log Info "Output directory resolved: $_dir"
}

output_file() {
  local -n _path=$1
  local dir timestamp

  get_output_dir dir
  printf -v timestamp '%(%Y-%m-%d_%H-%M-%S)T' -1
  _path="$dir/recording-$timestamp.$EXT"
  log Info "Output file: $_path"
}

visualize() {
  log Info "Visualizing recording state"

  vb-refresh-waybar-module recording

  if [[ $VIBRANIUM_RECORDING_FLASH_SCREEN == true ]]; then
    hypr::flash::screen
    log Info "Screen flash triggered"
  fi
}

copy() {
  local dir newest='' f
  log Info "Copying latest recording to clipboard"
  get_output_dir dir

  for f in "$dir"/recording-*; do
    if [[ ! -f $f ]]; then
      continue
    fi

    if [[ -z $newest || $f -nt $newest ]]; then
      newest=$f
    fi
  done

  log Info "Newest recording file: ${newest:-none}"

  if [[ -n $newest ]]; then
    printf 'file://%s' "$newest" | wl-copy -t text/uri-list
    log Info "Copied to clipboard: $newest"
  fi
}

set_recording_area() {
  local -n _area=$1
  local target="${2#--}"

  log Info "Setting recording area: $target"
  case "$target" in
    portal)
      _area="$target"
      log Info "Recording area: portal"
      ;;
    region)
      local slurp_flags=(-b "${P_GRAY}33" -c "${P_ACCENT}" -f '%wx%h+%x+%y')
      local selected_region

      selected_region="$(slurp "${slurp_flags[@]}" 2> /dev/null)" || return 1
      _area="$selected_region"
      log Info "Recording region: $_area"
      ;;
    screen)
      local monitor
      monitor="$(hyprctl -j monitors | jq -r '.[] | select(.focused == true) | .name')"
      _area="$monitor"
      log Info "Recording screen: $_area"
      ;;
  esac
}

init_recording() {
  local opt_flags=()
  local fps frm codec quality capture_sink capture_source

  if [[ -n ${1:-} ]]; then
    opt_flags=(-encoder cpu)
    log Info "Fallback mode: CPU encoding forced"
  fi

  if [[ -z $AREA ]]; then
    log Error "Recording area not set"
    exit 1
  fi

  log Info "init_recording: area=$AREA fallback=${1:-none}"

  fps="$VIBRANIUM_RECORDING_FPS"
  EXT="$VIBRANIUM_RECORDING_CONTAINER_TYPE"
  frm="$VIBRANIUM_RECORDING_FRAMERATE_MODE"
  codec="$VIBRANIUM_RECORDING_VIDEO_CODEC"
  quality="$VIBRANIUM_RECORDING_QUALITY"

  capture_sink="$VIBRANIUM_RECORDING_CAPTURE_SINK"
  capture_source="$VIBRANIUM_RECORDING_CAPTURE_SOURCE"

  log Info "Recording config: fps=$fps ext=$EXT codec=$codec quality=$quality fm=$frm"

  if [[ $capture_source == true && $capture_sink == true ]]; then
    opt_flags+=(-a "default_input|default_output")
    log Info "Audio: mic + system output"
  elif [[ $capture_source == true ]]; then
    opt_flags+=(-a "default_input")
    log Info "Audio: mic only"
  elif [[ $capture_sink == true ]]; then
    opt_flags+=(-a 'default_output')
    log Info "Audio: system output only"
  fi

  local out_file
  output_file out_file

  gpu-screen-recorder \
    "${opt_flags[@]}" \
    -q "$quality" \
    -w "$AREA" \
    -k "$codec" \
    -fm "$frm" \
    -c "$EXT" \
    -f "$fps" \
    -o "$out_file" &> "$LOG_FILE" &

  RECORDING_PID=$!
  log Info "GSR launched -> $out_file"

  if [[ $AREA == portal ]]; then
    local deadline=$((SECONDS + 3))
    while ((SECONDS < deadline)); do
      if ! kill -0 "$RECORDING_PID" 2> /dev/null; then
        return 1
      fi
      sleep 0.2
    done
    return 0
  else
    sleep 0.2
    kill -0 "$RECORDING_PID" 2> /dev/null
  fi
}

fallback_notification() {
  local msg
  msg="Screen recording completed in fallback mode.\n"
  msg+="Video was encoded on the CPU instead of the GPU.\n"
  msg+="This may reduce quality and system performance.\n\n"
  msg+="Please make sure your GPU supports selected codec.\n"
  msg+="Click here to see the logs"

  local action
  action="$(notify-send --action=true -r 4 -u critical -t 25000 "Screen Recording" "$msg")"

  if [[ $action == 0 ]]; then
    xdg-terminal-exec -- "${EDITOR:-nvim}" "${LOG_FILE}.latest_fallback"
  fi
}

both_failed_notification() {
  local msg
  msg="Failed to start screen recording in both normal and fallback modes.\n"
  msg+="Click here to see the lock."

  local action
  action="$(notify-send --action=true -r 4 -u critical -t 25000 "Screen Recording" "$msg")"

  if [[ $action == 0 ]]; then
    xdg-terminal-exec -- "${EDITOR:-nvim}" "${LOG_FILE}.latest_failed"
  fi
}

start_recording() {
  log Info "Initializing recording"

  helpers::check \
    VIBRANIUM_RECORDING_FPS \
    VIBRANIUM_RECORDING_QUALITY \
    VIBRANIUM_RECORDING_VIDEO_CODEC \
    VIBRANIUM_RECORDING_FLASH_SCREEN \
    VIBRANIUM_RECORDING_CAPTURE_SINK \
    VIBRANIUM_RECORDING_CAPTURE_SOURCE \
    VIBRANIUM_RECORDING_CONTAINER_TYPE \
    VIBRANIUM_RECORDING_FRAMERATE_MODE

  local rec_status
  init_recording
  rec_status=$?

  log Info "init_recording exit status: $rec_status"

  if ((rec_status == 0)); then
    log Info "Recording started (PID: $RECORDING_PID)"
    echo "$RECORDING_PID" > "$VIBRANIUM_RUNTIME/recording-ongoing"
    visualize
    return 0
  fi

  if [[ $AREA == portal ]]; then
    log Info "Recording cancelled by user"
    return 0
  fi

  log Info "init_recording exit code: $rec_status, trying fallback"
  VIBRANIUM_RECORDING_VIDEO_CODEC="h264"
  VIBRANIUM_RECORDING_CONTAINER_TYPE="mp4"

  mv "$LOG_FILE" "${LOG_FILE}.latest_fallback"

  if ! init_recording --fallback; then
    mv "$LOG_FILE" "${LOG_FILE}.latest_failed"
    log Error "Failed to start recording in fallback mode"
    both_failed_notification
    exit 1
  fi

  echo "$RECORDING_PID" > "$VIBRANIUM_RUNTIME/recording-ongoing"
  touch "$VIBRANIUM_CACHE/fallback_mode"
  visualize
  log Info "Recording started in fallback mode"
}

stop_rec() {
  local pid="$1"

  log Info "Stopping recording (PID: $pid)"

  visualize
  kill "$pid"
  log Info "Kill signal sent to PID $pid"

  if [[ -f "$VIBRANIUM_CACHE/fallback_mode" ]]; then
    log Info "Fallback notification path"
    fallback_notification
    rm "$VIBRANIUM_CACHE/fallback_mode"
  else
    log Info "Standard notification path"
    notify-send -r 3 "Screen Recorder" "Recording saved"
  fi

  rm -f "$VIBRANIUM_RUNTIME/recording-ongoing"
  log Info "Recording state file removed"

  sleep 0.1

  vb-refresh-waybar-module recording && copy
}

get_ongoing_pid() {
  local -n _pid=$1
  local state_file

  state_file="$VIBRANIUM_RUNTIME/recording-ongoing"
  if [[ -f $state_file ]]; then
    _pid="$(< "$state_file")"
    log Info "Ongoing recording PID: $_pid"
  else
    log Info "No ongoing recording state file at $state_file"
  fi
}

ensure_deps() {
  local missing=()
  log Info "Verifying dependencies: gpu-screen-recorder jq"

  for pkg in gpu-screen-recorder jq; do
    if ! command -v "$pkg" > /dev/null; then
      missing+=("$pkg")
    fi
  done

  if ((${#missing[@]} > 0)); then
    log Error "Missing dependencies: ${missing[*]}"
    vb-cmd-dep-notify \
      --name "Screen Recording" \
      --deps "${missing[*]}"
    return 1
  fi
}

MODE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --region | --screen | --portal)
      MODE="$1"
      shift
      break
      ;;
    --stop)
      MODE="$1"
      shift
      break
      ;;
    *)
      log Error "Unknown option: $*"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
  esac
done

log Info "MODE parsed: $MODE"

case "$MODE" in
  --region | --screen | --portal)
    log Info "Starting recording in ${MODE#--} mode"

    if [[ -f "$VIBRANIUM_RUNTIME/recording-ongoing" ]]; then
      log Error "Recording already in progress"
      log Error "Use --stop to stop the active recording"
      exit 1
    fi

    if ! ensure_deps; then
      exit 1
    fi

    source vb-lib-core

    if ! set_recording_area AREA "$MODE"; then
      log Info "Area selection cancelled or failed"
      exit 1
    fi

    log Info "Recording area set: AREA=$AREA"
    start_recording
    log Info "start_recording returned"
    ;;
  --stop)
    log Info "Stopping active recording"

    get_ongoing_pid GSR_PID

    if [[ -n $GSR_PID ]]; then
      source vb-lib-core
      stop_rec "$GSR_PID"
      exit 0
    else
      log Error "No active recording to stop"
      exit 1
    fi
    ;;
  "")
    usage
    exit 0
    ;;
esac
