#!/bin/bash

source vb-lib-cli

if [[ $CHASSIS_TYPE == vm ]]; then
  log Error "Screen recording is not available in a VM"
  exit 1
fi

VERBOSE=${VERBOSE:-false}

SELF="${0##*/}"
LOG_FILE="$VIBRANIUM_CACHE/$SELF.log"

log Info "$SELF started: log_file=$LOG_FILE"

usage() {
  shcat << EOF
Usage: ${0##*/} [--stop]

Basic screen recording utility created for Vibranium.

With no arguments, starts recording the screen.

Options:
  --stop      Stop active recording
  -v, --verbose Enable verbose output
  -h, --help  Display this help and exit
EOF
}

get_output_dir() {
  local -n _dir=$1
  log Info "Resolving output directory"
  # Generated recordings live directly under one stable Screencasts root, so
  # the newest-file scan has a well-defined candidate set.
  _dir="${XDG_VIDEOS_DIR:-$HOME/Videos}/Screencasts"

  if [[ ! -d "$_dir" ]]; then
    mkdir -p "$_dir"
    log Info "Created output directory: $_dir"
  fi
  log Info "Output directory resolved: $_dir"
}

output_file() {
  local -n _path=$1
  local dir timestamp

  get_output_dir dir
  printf -v timestamp '%(%Y-%m-%d_%H-%M-%S)T' -1
  _path="$dir/recording-$timestamp.$EXT"
  log Info "Output file: $_path"
}

visualize() {
  log Info "Visualizing recording state"

}

# Offer a recorded file to the clipboard as a URI-list, so a paste target
# receives a path it can open rather than the media bytes.
copy() {
  local -n _path=$1
  local file="$_path" uri

  if [[ -z $file || ! -f $file ]]; then
    log Error "No finalized recording to offer, clipboard copy skipped"
    return 1
  fi

  # A file URI must percent-encode the characters that would terminate or
  # reparse the path. The percent sign is substituted first, so its own
  # replacements are not encoded a second time; path separators stay literal,
  # as a file URI requires.
  uri="$file"
  uri="${uri//\%/%25}"
  uri="${uri// /%20}"
  uri="${uri//\#/%23}"
  uri="${uri//\?/%3F}"

  # The trailing newline terminates the uri-list. wl-copy forks, so the offer
  # outlives this process instead of dying with the clipboard-less pipe.
  if printf '%s\n' "file://$uri" | wl-copy -t text/uri-list; then
    log Info "Copied to clipboard: $file"
  else
    log Error "Clipboard copy failed: $file"
    return 1
  fi
}

set_recording_area() {
  local -n _area=$1

  log Info "Setting recording area: screen"
  local monitor=""
  IFS= read -r monitor < <(hyprctl -j monitors | jq -r '.[] | select(.focused == true) | .name') || true
  _area="$monitor"
  log Info "Recording screen: $_area"
}

init_recording() {
  local opt_flags=()
  local fps frm codec quality capture_sink capture_source

  # A nonempty first positional argument selects CPU fallback; the caller
  # uses --fallback, and the text of the argument is not inspected.
  if [[ -n ${1:-} ]]; then
    opt_flags=(-encoder cpu)
    log Info "Fallback mode: CPU encoding forced"
  fi

  if [[ -z $AREA ]]; then
    log Error "Recording area not set"
    exit 1
  fi

  log Info "init_recording: area=$AREA fallback=${1:-none}"

  fps="$RECORDING_FPS"
  EXT="$RECORDING_CONTAINER_TYPE"
  frm="$RECORDING_FRAMERATE_MODE"
  codec="$RECORDING_VIDEO_CODEC"
  quality="$RECORDING_QUALITY"

  capture_sink="$RECORDING_CAPTURE_SINK"
  capture_source="$RECORDING_CAPTURE_SOURCE"

  log Info "Recording config: fps=$fps ext=$EXT codec=$codec quality=$quality fm=$frm"

  if [[ $capture_source == true && $capture_sink == true ]]; then
    opt_flags+=(-a "default_input|default_output")
    log Info "Audio: mic + system output"
  elif [[ $capture_source == true ]]; then
    opt_flags+=(-a "default_input")
    log Info "Audio: mic only"
  elif [[ $capture_sink == true ]]; then
    opt_flags+=(-a 'default_output')
    log Info "Audio: system output only"
  fi

  # The path is published through a global because a stop runs as a separate
  # process: start_recording persists it next to the PID so the stop path can
  # name the exact file instead of inferring it from a directory scan.
  output_file RECORDING_OUT_FILE

  # The focused monitor name is passed through as one recorder argument.
  gpu-screen-recorder \
    "${opt_flags[@]}" \
    -q "$quality" \
    -w "$AREA" \
    -k "$codec" \
    -fm "$frm" \
    -c "$EXT" \
    -f "$fps" \
    -o "$RECORDING_OUT_FILE" &> "$LOG_FILE" &

  # $! is the PID assigned to the background launch. kill -0 only confirms
  # that this process remains alive; it does not prove encoder initialization
  # or successful recording.
  RECORDING_PID=$!
  log Info "GSR launched -> $RECORDING_OUT_FILE"

  sleep 0.2
  kill -0 "$RECORDING_PID" 2> /dev/null
}

fallback_notification() {
  local msg
  msg="Screen recording completed in fallback mode.\n"
  msg+="Video was encoded on the CPU instead of the GPU.\n"
  msg+="This may reduce quality and system performance.\n\n"
  msg+="Please make sure your GPU supports selected codec.\n"
  msg+="Click here to see the logs"

  local action=""
  IFS= read -r action < <(notify-send --action=true -r 4 -a "Screen Recorder" -u critical -t 25000 "Screen Recording" "$msg") || true

  if [[ $action == 0 ]]; then
    xdg-terminal-exec -- "${EDITOR:-nvim}" "${LOG_FILE}.latest_fallback"
  fi
}

both_failed_notification() {
  local msg
  msg="Failed to start screen recording in both normal and fallback modes.\n"
  msg+="Click here to see the lock."

  local action=""
  IFS= read -r action < <(notify-send --action=true -r 4 -a "Screen Recorder" -u critical -t 25000 "Screen Recording" "$msg") || true

  if [[ $action == 0 ]]; then
    xdg-terminal-exec -- "${EDITOR:-nvim}" "${LOG_FILE}.latest_failed"
  fi
}

start_recording() {
  log Info "Initializing recording"

  local rec_status
  init_recording
  rec_status=$?

  log Info "init_recording exit status: $rec_status"

  if ((rec_status == 0)); then
    log Info "Recording started (PID: $RECORDING_PID)"
    # The output path is written before the PID file: the PID file's presence is
    # the ongoing marker the shell watches, so this ordering keeps the invariant
    # that a visible recording always has a recoverable output path.
    echo "$RECORDING_OUT_FILE" > "$VIBRANIUM_RUNTIME/recording-out-file"
    echo "$RECORDING_PID" > "$VIBRANIUM_RUNTIME/recording-ongoing"
    visualize
    return 0
  fi

  log Info "init_recording exit code: $rec_status, trying fallback"
  RECORDING_VIDEO_CODEC="h264"
  RECORDING_CONTAINER_TYPE="mp4"

  # The retry replaces codec and container, rotates the first log, and then
  # launches a second process. Success is recorded only after that retry passes
  # the same liveness check.
  mv "$LOG_FILE" "${LOG_FILE}.latest_fallback"

  if ! init_recording --fallback; then
    mv "$LOG_FILE" "${LOG_FILE}.latest_failed"
    log Error "Failed to start recording in fallback mode"
    both_failed_notification
    exit 1
  fi

  # The retry replaced the codec and container, so it also chose a new output
  # path; this is the one the running recorder writes to.
  echo "$RECORDING_OUT_FILE" > "$VIBRANIUM_RUNTIME/recording-out-file"
  echo "$RECORDING_PID" > "$VIBRANIUM_RUNTIME/recording-ongoing"
  touch "$VIBRANIUM_CACHE/fallback_mode"
  visualize
  log Info "Recording started in fallback mode"
}

stop_rec() {
  local pid="$1"

  log Info "Stopping recording (PID: $pid)"

  visualize
  # Sending the signal is not a wait: the recorder finalizes the container only
  # after it handles the signal and exits, so the flush is awaited below instead
  # of assumed.
  kill "$pid"
  log Info "Kill signal sent to PID $pid"

  wait_recorder "$pid"

  # Both helpers take a variable name, following the nameref convention the rest
  # of this script uses; SC2034 cannot see the write through the reference.
  # shellcheck disable=SC2034
  local out_file
  get_recording_out_file out_file
  copy out_file

  if [[ -f "$VIBRANIUM_CACHE/fallback_mode" ]]; then
    log Info "Fallback notification path"
    fallback_notification
    rm "$VIBRANIUM_CACHE/fallback_mode"
  else
    log Info "Standard notification path"
    notify-send -r 3 -a "Screen Recorder" "Recording saved" "Recording has been saved to the default folder"
  fi

  rm -f "$VIBRANIUM_RUNTIME/recording-ongoing" "$VIBRANIUM_RUNTIME/recording-out-file"
  log Info "Recording state files removed"
}

# Block until the recorder PID disappears. The recorder is not a child of this
# process, so the loop observes the PID going away but cannot reap it; the
# deadline bounds the wait so a recorder that ignores the signal cannot hold up
# the clipboard offer or the notification.
wait_recorder() {
  local pid="$1"
  local deadline=$((SECONDS + 5))

  while kill -0 "$pid" 2> /dev/null; do
    if ((SECONDS >= deadline)); then
      log Error "Recorder PID $pid still alive after 5s, container may be incomplete"
      return 1
    fi

    sleep 0.1
  done

  log Info "Recorder PID $pid exited, container finalized"
}

get_ongoing_pid() {
  local -n _pid=$1
  local state_file

  # The state file is trusted as a PID string; no ownership or process identity
  # check is performed here, so stale contents are delegated to kill handling.
  state_file="$VIBRANIUM_RUNTIME/recording-ongoing"
  if [[ -f $state_file ]]; then
    IFS= read -r _pid < "$state_file" || true
    log Info "Ongoing recording PID: $_pid"
  else
    log Info "No ongoing recording state file at $state_file"
  fi
}

# Resolve the file the running recorder encodes to. An empty result leaves the
# caller to skip the clipboard offer rather than offer an unrelated file.
get_recording_out_file() {
  local -n _path=$1
  local state_file="$VIBRANIUM_RUNTIME/recording-out-file"
  local dir newest='' f

  if [[ -f $state_file ]]; then
    IFS= read -r _path < "$state_file" || true
    log Info "Recording output file: $_path"
    return 0
  fi

  # A recording begun before this state file existed has no persisted path, so
  # the newest file in the output directory is the only recoverable candidate.
  log Info "No recording output state file at $state_file, falling back to a directory scan"
  get_output_dir dir

  # The `-nt` comparison selects the most recently modified regular file even
  # when the shell expands no matches; the explicit -f test drops the literal
  # unmatched glob.
  for f in "$dir"/recording-*; do
    if [[ ! -f $f ]]; then
      continue
    fi

    if [[ -z $newest || $f -nt $newest ]]; then
      newest=$f
    fi
  done

  _path="$newest"
  log Info "Scanned recording file: ${newest:-none}"
}

ensure_deps() {
  local missing=()
  log Info "Verifying dependencies: gpu-screen-recorder jq"

  for pkg in gpu-screen-recorder jq; do
    if ! command -v "$pkg" > /dev/null; then
      missing+=("$pkg")
    fi
  done

  if ((${#missing[@]} > 0)); then
    log Error "Missing dependencies: ${missing[*]}"
    vb-cmd-dep-notify \
      --name "Screen Recording" \
      --deps "${missing[*]}"
    return 1
  fi
}

MODE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --stop)
      MODE="$1"
      shift
      break
      ;;
    *)
      log Error "Unknown option: $*"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
  esac
done

log Info "MODE parsed: $MODE"

case "$MODE" in
  "")
    log Info "Starting screen recording"

    # The marker prevents a second start only when it is present; it is not a
    # lock, so simultaneous invocations can still race until either writes it.
    if [[ -f "$VIBRANIUM_RUNTIME/recording-ongoing" ]]; then
      log Error "Recording already in progress"
      log Error "Use --stop to stop the active recording"
      exit 1
    fi

    if ! ensure_deps; then
      exit 1
    fi

    source vb-lib-core

    if ! set_recording_area AREA; then
      log Info "Area resolution failed"
      exit 1
    fi

    log Info "Recording area set: AREA=$AREA"
    start_recording
    log Info "start_recording returned"
    ;;
  --stop)
    log Info "Stopping active recording"

    get_ongoing_pid GSR_PID

    if [[ -n $GSR_PID ]]; then
      source vb-lib-core
      stop_rec "$GSR_PID"
      exit 0
    else
      log Error "No active recording to stop"
      exit 1
    fi
    ;;
esac
