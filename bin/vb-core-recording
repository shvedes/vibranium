#!/usr/bin/bash

if [[ $CHASSIS_TYPE == vm ]]; then
  echo "Error: screen recording isn't available in a VM!" >&2
  exit 1
fi

SELF="${0##*/}"
LOG_FILE="$VIBRANIUM_CACHE/$SELF.log"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Options:
  --region    Record region
  --screen    Record screen
  --portal    Use xdg-desktop-portal
  -h, --help  Display this help and exit
EOF
}

get_output_dir() {
  mkdir -p "${XDG_VIDEOS_DIR:-$HOME/Videos}/Screencasts"
  printf "%s" "${XDG_VIDEOS_DIR:-$HOME/Videos}/Screencasts"
}

output_file() {
  printf "%s/recording-%s.%s" "$(get_output_dir)" \
    "$(date +"%Y-%m-%d_%H-%M-%S")" "$EXT"
}

visualize() {
  vb-cmd-refresh-bar-module recording

  helpers::check VIBRANIUM_RECORDING_FLASH_SCREEN
  if [[ $VIBRANIUM_RECORDING_FLASH_SCREEN == true ]]; then
    hypr::flash::screen &
  fi
}

copy() {
  local last_file
  last_file="$(find "$(get_output_dir)" -type f -name 'recording-*' -printf "%T@ %p\n" | sort -n | tail -1 | cut -d' ' -f2-)"
  [[ -n "$last_file" ]] && {
    printf "file://%s" "$last_file" | wl-copy -t text/uri-list
  }
}

set_rec_area() {
  local target="${1/--/}"

  case "$target" in
  portal)
    printf '%s' "$target"
    ;;
  region)
    local slurp_flags=(-b "${P_GRAY}33" -c "$P_ACCENT" -f '%wx%h+%x+%y')
    local selected_region
    selected_region="$(slurp "${slurp_flags[@]}" 2>/dev/null)"

    printf "%s" "$selected_region"
    return 0
    ;;
  screen)
    local monitor
    monitor="$(hyprctl -j monitors | jq -r '.[] | select(.focused == true) | .name')"
    printf '%s' "$monitor"
    ;;
  esac
}

init_recording() {
  local opt_flags=()

  if [[ ! -z ${1:-} ]]; then
    opt_flags=(-encoder cpu)
  fi

  if [[ -z "$AREA" ]]; then
    exit 1
  fi

  FPS="$VIBRANIUM_RECORDING_FPS"
  EXT="$VIBRANIUM_RECORDING_CONTAINER_TYPE"
  FRM="$VIBRANIUM_RECORDING_FRAMERATE_MODE"
  CODEC="$VIBRANIUM_RECORDING_VIDEO_CODEC"
  QUALITY="$VIBRANIUM_RECORDING_QUALITY"

  CAPTURE_SINK="$VIBRANIUM_RECORDING_CAPTURE_SINK"
  CAPTURE_SOURCE="$VIBRANIUM_RECORDING_CAPTURE_SOURCE"
  USE_RNNOISE=$VIBRANIUM_RECORDING_USE_RNNOISE

  local rnnoise_present=$(pactl list short sources | grep -q rnnoise_source && echo true || echo false)

  if [[ $CAPTURE_SOURCE == true ]]; then
    if [[ $USE_RNNOISE == true && $rnnoise_present == true ]]; then
      input_node='rnnoise_source'
    else
      input_node='default_input'
    fi
  fi

  if [[ $CAPTURE_SOURCE == true && $CAPTURE_SINK == true ]]; then
    opt_flags+=(-a "${input_node}|default_output")
  elif [[ $CAPTURE_SOURCE == true ]]; then
    opt_flags+=(-a "${input_node}")
  elif [[ $CAPTURE_SINK == true ]]; then
    opt_flags+=(-a 'default_output')
  fi

  # Capture the output path before launch so we can watch for its creation.
  # This also avoids calling output_file() twice (skewed timestamps).
  local out_file
  out_file="$(output_file)"

  gpu-screen-recorder \
    ${opt_flags[@]} \
    -q "$QUALITY" \
    -w "$AREA" \
    -k "$CODEC" \
    -fm "$FRM" \
    -c "$EXT" \
    -f "$FPS" \
    -o "$out_file" &>"$LOG_FILE" &

  local pid=$!

  if [[ "$AREA" == "portal" ]]; then
    # gsr blocks here waiting for the user to pick a capture source.
    # Poll for a short startup window: if the process dies within it,
    # the picker was dismissed or gsr hit an early error. If it survives,
    # the picker was accepted and recording is underway.
    local deadline=$((SECONDS + 3))
    while ((SECONDS < deadline)); do
      if ! kill -0 "$pid" 2>/dev/null; then
        return 1
      fi
      sleep 0.2
    done
    return 0
  else
    # Region/screen start recording immediately. A brief wait is enough
    # to catch any startup failure before declaring success.
    sleep 0.2
    kill -0 "$pid" 2>/dev/null
  fi
}

fallback_notification() {
  local msg

  msg="Screen recording completed in fallback mode.\n"
  msg+="Video was encoded on the CPU instead of the GPU.\n"
  msg+="This may reduce quality and system performance.\n\n"
  msg+="Please make sure your GPU supports selected codec.\n"
  msg+="Click here to see the logs"

  local action="$(notify-send --action=true -r 4 -u critical -t 25000 "Screen Recording" "$msg")"

  if [[ $action == "0" ]]; then
    xdg-terminal-exec -- "${EDITOR:-nvim}" "${LOG_FILE}.latest_fallback"
  fi
}

both_failed_notification() {
  local msg

  msg="Failed to start screen recording in both normal and fallback modes.\n"
  msg+="Click here to see the lock."

  local action="$(notify-send --action=true -r 4 -u critical -t 25000 "Screen Recording" "$msg")"

  if [[ $action == "0" ]]; then
    xdg-terminal-exec -- "${EDITOR:-nvim}" "${LOG_FILE}.latest_failed"
  fi
}

start_rec() {
  helpers::check \
    VIBRANIUM_RECORDING_FPS \
    VIBRANIUM_RECORDING_QUALITY \
    VIBRANIUM_RECORDING_VIDEO_CODEC \
    VIBRANIUM_RECORDING_USE_RNNOISE \
    VIBRANIUM_RECORDING_CAPTURE_SINK \
    VIBRANIUM_RECORDING_CAPTURE_SOURCE \
    VIBRANIUM_RECORDING_CONTAINER_TYPE \
    VIBRANIUM_RECORDING_FRAMERATE_MODE

  local rec_status
  init_recording
  rec_status=$?

  if ((rec_status == 0)); then
    visualize
    log::info "recording started"
    return 0
  fi

  # In portal mode a non-zero exit without an output file always means
  # the picker was dismissed -- no encoder was ever selected so fallback
  # makes no sense, and a second picker would just confuse the user.
  if [[ "$AREA" == "portal" ]]; then
    log::info "recording cancelled by user"
    return 0
  fi

  log::warn "failed to start recording. Using fallback mode"
  VIBRANIUM_RECORDING_VIDEO_CODEC="h264"
  VIBRANIUM_RECORDING_CONTAINER_TYPE="mp4"

  mv "$LOG_FILE" "${LOG_FILE}.latest_fallback"

  if ! init_recording --fallback; then
    mv "$LOG_FILE" "${LOG_FILE}.latest_failed"
    log::error "failed to start recording in fallback mode"
    both_failed_notification
    exit 1
  fi

  touch "$VIBRANIUM_CACHE/fallback_mode"
  visualize
  log::info "recording started in fallback mode"
}

ensure_deps() {
  local missing=()

  for pkg in gpu-screen-recorder jq; do
    if ! command -v $pkg >/dev/null; then
      missing+=($pkg)
    fi
  done

  if ((${#missing[@]} == 0)); then
    return
  fi

  vb-cmd-dep-notify \
    --name "Screen Recording" \
    --deps "${missing[*]}"
  exit 1
}

stop_rec() {
  source vb-lib-core

  if pid="$(pidof gpu-screen-recorder)"; then
    visualize
    kill $pid

    if [ -f "$VIBRANIUM_CACHE/fallback_mode" ]; then
      fallback_notification
      rm "$VIBRANIUM_CACHE/fallback_mode"
    else
      # Do not show "Recording saved" when ran in fallback
      notify-send -r 3 "Screen Recorder" "Recording saved"
    fi

    # Wait for the pid
    sleep 0.1

    vb-cmd-refresh-bar-module recording
    copy
    exit 0
  else
    echo "No active GSR instance found" >&2
    exit 1
  fi
}

case "$1" in
--region | --screen | --portal)
  AREA="$(set_rec_area "$1")"
  source vb-lib-core
  start_rec
  ;;
-h | --help)
  usage
  exit 0
  ;;
"")
  stop_rec
  ;;
*)
  usage
  exit 1
  ;;
esac
