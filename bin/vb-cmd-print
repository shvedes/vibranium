#!/bin/bash

source vb-lib-cli

VERBOSE=false

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION] [FILE]...

Print files via the system default CUPS printer.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

if [[ "$CHASSIS_TYPE" == vm ]]; then
  log Error "Not available in a VM"
  notify-send -r 4 -t 3000 -u critical "Print Manager" \
    "This feature is not available in a VM!"
  exit 1
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

set -uo pipefail

# Per-process temporary working directory.
WORK_DIR="/tmp/vb-print-$$"

cleanup() {
  if [[ -d "$WORK_DIR" ]]; then
    rm -rf "$WORK_DIR"
  fi
}

trap cleanup EXIT

have_libreoffice=false
have_inkscape=false

command -v libreoffice &> /dev/null && have_libreoffice=true
command -v inkscape &> /dev/null && have_inkscape=true

if ! systemctl -q is-active cups.service; then
  notify-send -r 4 -u critical -t 20000 "Print System Service Is Not Running" \
    "Enable with 'systemctl enable --now cups.service'"
  exit 1
fi

# Determine the system default printer via lpstat -d.
# The LANG override ensures English output for the string match.
# Format: "system default destination: <printer_name>"
lpstat_out=$(env LANG="en_US.UTF-8" lpstat -d 2> /dev/null)
default_printer=""

if [[ "$lpstat_out" == *"system default destination:"* ]]; then
  default_printer="${lpstat_out#*system default destination: }"
fi

log Info "Default printer: ${default_printer:-none}"

if [[ -z "$default_printer" ]]; then
  notify-send -r 4 -u critical -t 10000 "No Default Printer Found" \
    "No system default printer is configured.\nTo add a printer, use <b>Print Settings</b> in app launcher"
  exit 1
fi

mkdir -p "$WORK_DIR"

succeeded=0    # Number of files printed successfully.
failed=0       # Number of files that failed.
failed_body="" # Notification body with failed file names.

# Converts the file if necessary, then spools it to the default printer.
# Returns 0 on success, 1 on conversion or spool failure.
print_file() {
  local file="$1"

  local base="${file##*/}" # Strip directory path.
  local ext="${base##*.}"  # Extract file extension.
  ext="${ext,,}"           # Normalize extension to lowercase.

  # Path that will be sent to lp.
  local to_print

  # Defaults to direct printing.
  to_print="$file"

  case "$ext" in
    # Reliable via CUPS (through cups-filters).
    pdf | ps)
      ;;

    # Usually fine via filters (images, text).
    jpg | jpeg | png | gif | bmp | tiff | tif | \
      txt | text | log | md | rst | csv | tsv | \
      html | htm | xhtml | \
      eps)
      ;;

    # Better to convert via LibreOffice for consistency.
    odt | ott | sxw | \
      doc | docx | dot | dotx | rtf | \
      ods | ots | sxc | \
      xls | xlsx | xlsm | xlt | xltx | \
      odp | otp | sxi | \
      ppt | pptx | pptm | pot | potx | \
      odg | otg)
  if $have_libreoffice; then
    log Info "Converting $file via LibreOffice"
    out="$WORK_DIR/${base%.*}.pdf"
    libreoffice --headless --convert-to pdf \
      --outdir "$WORK_DIR" "$file" &> /dev/null || return 1

        # Print the converted PDF instead of the source file.
        to_print="$out"
      fi
      ;;

    svg)
      if $have_inkscape; then
        log Info "Converting $file via Inkscape"
        out="$WORK_DIR/${base%.*}.pdf"
        inkscape --export-type=pdf \
          --export-filename="$out" "$file" \
          &> /dev/null || return 1

        # Print the converted PDF instead of the source file.
        to_print="$out"
      fi
      ;;

    # Everything else: let CUPS try
    *)
      ;;
  esac

  log Info "Spooling $to_print to $default_printer"

  if ! lp -d "$default_printer" "$to_print" &> /dev/null; then
    log Error "failed to print $to_print"
    return 1
  fi
}

# Queue handling
for file in "$@"; do
  # Skip anything that is not a regular file.
  if [[ ! -f "$file" ]]; then
    ((failed++)) || true
    failed_body+=$'\n'"  ${file##*/} (not a file)"
    continue
  fi

  # Print one file at a time.
  if print_file "$file"; then
    ((succeeded++)) || true
  else
    ((failed++)) || true
    failed_body+=$'\n'"  ${file##*/}"
  fi
done

# Summary notification
if ((failed == 0)); then
  notify-send -r 3 -t 5000 "$succeeded File(s) Queued" "Sent to: $default_printer"
elif ((succeeded == 0)); then
  notify-send -r 4 -u critical -t 10000 "All $failed File(s) Failed" "$failed_body"
else
  notify-send -r 3 -t 5000 "$succeeded File(s) Queued, $failed File(s) Failed" "Failed:$failed_body"
fi
