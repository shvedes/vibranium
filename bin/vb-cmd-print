#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION] [FILE]...

Print files via the system default CUPS printer.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

if [[ "$CHASSIS_TYPE" == vm ]]; then
  log Error "Not available in a VM"
  notify-send -r 4 -a "Vibranium" -t 3000 -u critical "Print Manager" \
    "This feature is not available in a VM!"
  exit 1
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

set -uo pipefail

# The PID suffix isolates simultaneous invocations, and the EXIT trap removes
# converter artifacts when a later file or spool operation fails.
WORK_DIR="/tmp/vb-print-$$"

cleanup() {
  if [[ -d "$WORK_DIR" ]]; then
    rm -rf "$WORK_DIR"
  fi
}

trap cleanup EXIT

have_libreoffice=false
have_inkscape=false

command -v libreoffice &> /dev/null && have_libreoffice=true
command -v inkscape &> /dev/null && have_inkscape=true

if ! systemctl -q is-active cups.service; then
  notify-send -r 4 -a "Vibranium" -u critical -t 20000 "Print System Service Is Not Running" \
    "Enable with 'systemctl enable --now cups.service'"
  exit 1
fi

# Determine the system default printer via lpstat -d. The command sets LANG,
# but LC_ALL or LC_MESSAGES can take precedence; the parser matches the
# English prefix when present.
# Format: "system default destination: <printer_name>"
lpstat_out=$(env LANG="en_US.UTF-8" lpstat -d 2> /dev/null)
default_printer=""

if [[ "$lpstat_out" == *"system default destination:"* ]]; then
  default_printer="${lpstat_out#*system default destination: }"
fi

log Info "Default printer: ${default_printer:-none}"

if [[ -z "$default_printer" ]]; then
  notify-send -r 4 -a "Vibranium" -u critical -t 10000 "No Default Printer Found" \
    "No system default printer is configured.\nTo add a printer, use <b>Print Settings</b> in app launcher"
  exit 1
fi

mkdir -p "$WORK_DIR"

succeeded=0    # Files accepted by lp for queueing.
failed=0       # Files that failed conversion or queue submission.
failed_body="" # Notification body listing failed input names.

# Convert when needed, then submit the selected path to lp. Return 0 when
# conversion and queue submission succeed, 1 on either failure.
print_file() {
  local file="$1"

  local base="${file##*/}" # Strip directory path.
  local ext="${base##*.}"  # Extract file extension.
  ext="${ext,,}"           # Normalize extension to lowercase.

  # Converter availability is established once per batch; a missing converter leaves
  # the original path in place and lets CUPS decide whether it can print it.
  local to_print

  to_print="$file"

  case "$ext" in
    # PDF and PostScript are passed to CUPS without local conversion.
    pdf | ps)
      ;;

    # Images and text are passed to CUPS without local conversion.
    jpg | jpeg | png | gif | bmp | tiff | tif | \
      txt | text | log | md | rst | csv | tsv | \
      html | htm | xhtml | \
      eps)
      ;;

    # Office formats use LibreOffice conversion when available.
    odt | ott | sxw | \
      doc | docx | dot | dotx | rtf | \
      ods | ots | sxc | \
      xls | xlsx | xlsm | xlt | xltx | \
      odp | otp | sxi | \
      ppt | pptx | pptm | pot | potx | \
      odg | otg)
  if $have_libreoffice; then
    log Info "Converting $file via LibreOffice"
    out="$WORK_DIR/${base%.*}.pdf"
    libreoffice --headless --convert-to pdf \
      --outdir "$WORK_DIR" "$file" &> /dev/null || return 1

        to_print="$out"
      fi
      ;;

    # SVG uses Inkscape conversion when available.
    svg)
      if $have_inkscape; then
        log Info "Converting $file via Inkscape"
        out="$WORK_DIR/${base%.*}.pdf"
        inkscape --export-type=pdf \
          --export-filename="$out" "$file" \
          &> /dev/null || return 1

        to_print="$out"
      fi
      ;;

    # Unsupported extensions are passed to CUPS without local conversion.
    *)
      ;;
  esac

  log Info "Spooling $to_print to $default_printer"

  if ! lp -d "$default_printer" "$to_print" &> /dev/null; then
    log Error "failed to print $to_print"
    return 1
  fi
}

for file in "$@"; do
  # `-f` accepts paths that resolve to regular files, including symlinks.
  if [[ ! -f "$file" ]]; then
    ((failed++)) || true
    failed_body+=$'\n'"  ${file##*/} (not a file)"
    continue
  fi

  if print_file "$file"; then
    ((succeeded++)) || true
  else
    ((failed++)) || true
    failed_body+=$'\n'"  ${file##*/}"
  fi
done

# Summary notification
# Replacement IDs coalesce repeated notifications; the title, body, severity,
# and timeout distinguish the outcome shown to the user.
if ((failed == 0)); then
  notify-send -r 3 -a "Vibranium" -t 5000 "$succeeded File(s) Queued" "Sent to: $default_printer"
elif ((succeeded == 0)); then
  notify-send -r 4 -a "Vibranium" -u critical -t 10000 "All $failed File(s) Failed" "$failed_body"
else
  notify-send -r 3 -a "Vibranium" -t 5000 "$succeeded File(s) Queued, $failed File(s) Failed" "Failed:$failed_body"
fi
