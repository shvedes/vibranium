#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION] <package:binary>...

Check whether required packages are installed.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit

Examples:
  ${0##*/} cliphist:cliphist
  ${0##*/} neovim:nvim,vi
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  log Error "missing package arguments"
  usage
  exit 1
fi

log Info "Checking $(($#)) package(s)"

# Entry syntax: <package_name>:<binary_name[,binary_name,...]>
# The colon separates the human-readable package name from the actual
# binaries to check. Multiple binaries may be comma-separated (any one
# suffices). When no colon is present, the entire entry is treated as
# both the package name and the binary name.
#
# Example: cliphist:cliphist       -> checks for cliphist binary
#          neovim:nvim,vi          -> checks for nvim OR vi binary
missing=()

for entry in "$@"; do
  package="${entry%%:*}"
  binaries="${entry#*:}"

  if [[ $binaries == "$package" ]]; then
    binaries="$package"
  fi

  for binary in ${binaries//,/ }; do
    if ! command -v "$binary" > /dev/null; then
      missing+=("$binary")
    fi
  done
done

if ((${#missing[@]} != 0)); then
  printf '%s\n' "${missing[@]}"
  exit 1
fi
