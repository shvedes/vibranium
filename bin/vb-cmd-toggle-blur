#!/usr/bin/env bash

if [[ $CHASSIS_TYPE == "vm" ]]; then
    notify-send -r 734 -t 5000 -u critical "Vibranium" \
        "For the sake of VM's performance keep blur disabled, please"
    exit 1
fi

CONF="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.conf"

usage() {
    cat << EOF
Usage: $(basename "$0") [OPTIONS]

Toggle window blur in Hyprland.

Options:
  -q, --quiet  Do not print 'enabled' or 'disabled'.
  -h, --help   Show this help and exit
EOF
}

QUIET=false

for arg in "$@"; do
    case "$arg" in
        -q|--quiet) QUIET=true ;;
        -h|--help) usage; exit 0 ;;
        *) ;;
    esac
done

case "$(hyprctl -j getoption decoration:blur:enabled | jq -r '.int')" in
    0) BLUR_ENABLED=false ;;
    1) BLUR_ENABLED=true ;;
esac

POWER_PROFILE="$(vb-cmd-get-power)"
RESPECT_PP="$(vb-cmd-get-option "VIBRANIUM_GLOBAL_RESPECT_POWER_PROFILE")"

if [[ $BLUR_ENABLED == false ]]; then
    if [[ $RESPECT_PP == true && $POWER_PROFILE != "power-saver" ]]; then
        vb-cmd-edit-wm-config decoration:blur:enabled:true "$CONF"
        [[ "$QUIET" = false ]] && echo "enabled"
    elif [[ $RESPECT_PP == true && $POWER_PROFILE == "power-saver" ]]; then
        if [[ -t 1 ]]; then
            echo "\$VIBRANIUM_GLOBAL_RESPECT_POWER_PROFILE set to true"
            exit 1
        fi
    else
        vb-cmd-edit-wm-config decoration:blur:enabled:true "$CONF"
        [[ "$QUIET" = false ]] && echo "enabled"
    fi
else
    vb-cmd-edit-wm-config decoration:blur:enabled:false "$CONF"
    [[ "$QUIET" = false ]] && echo "disabled"
fi

if [[ "$(hyprctl -j getoption misc:disable_autoreload | jq -r '.int')" == "1" ]]; then
    hyprctl -q reload config-only &
fi
