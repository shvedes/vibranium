#!/usr/bin/bash

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Closes all open windows using hyprctl.

Options:
  -h, --help    display this help and exit

EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Error: unknown option: ${1}." >&2
    echo "Try ${0##*/} for more information." >&2
    exit 1
    ;;
  esac
done

mapfile -t window_addresses < <(hyprctl clients -j | jq -r ".[].address")

for addr in "${window_addresses[@]}"; do
  hyprctl dispatch closewindow "address:$addr"
done
