#!/bin/bash

source vb-lib-cli

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Update all installed community themes.

Options:
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log Error "unknown option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
  esac
done

source vb-lib-core

_theme_update_interrupt() {
  trap '' HUP INT TERM QUIT
  printf '\n'
  term::enable_input
  exit 1
}

trap '_theme_update_interrupt' HUP INT TERM QUIT

_spinner() {
  local pid=$1 msg="$2" delay=0.07 interactive=false
  # shellcheck disable=SC1003
  local spinstr=('/' '-' '\' '|')

  if [[ -t 1 && -z "${NO_COLOR+x}" ]]; then
    interactive=true
  fi

  if $interactive; then
    while kill -0 "$pid" 2> /dev/null; do
      for c in "${spinstr[@]}"; do
        printf '\r\033[K%s %s' "$msg" "$c"
        sleep "$delay"
      done
    done
  fi

  wait "$pid"
  return $?
}

_display_name() {
  local -n _dn_out=$1
  local _dn_name="$2" _dn_word _dn_text=
  for _dn_word in ${_dn_name//-/ }; do
    _dn_text+="${_dn_word^} "
  done
  _dn_out="${_dn_text% }"
}

term::show_header

THEMES_DIR="$XDG_CONFIG_HOME/vibranium/themes"
UPD_THEMES=()
SKIPPED=0
UPTOD=0
FAILED=()

# Discovery includes every user theme directory without an official counterpart.
# The .git check skips only directories without a repository; a user directory
# with .git is treated as an updatable clone.
if [[ -d "$THEMES_DIR" ]]; then
  mapfile -t themes < <(
    find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' |
      while read -r folder; do
        if [[ ! -d "$VIBRANIUM/themes/$folder" ]]; then
          echo "$folder"
        fi
      done
  )
else
  themes=()
fi

if ((${#themes[@]} == 0)); then
  vb::print "$Y" "No community themes installed"
  operation::result success "No themes to update"
  exit 0
fi

_sorted_themes=("${themes[@]}")
for ((_si = 1; _si < ${#_sorted_themes[@]}; _si++)); do
  _sk=${_sorted_themes[_si]}
  _sj=$((_si - 1))
  while ((_sj >= 0)) && [[ ${_sorted_themes[_sj]} > $_sk ]]; do
    _sorted_themes[_sj + 1]=${_sorted_themes[_sj]}
    _sj=$((_sj - 1))
  done
  _sorted_themes[_sj + 1]=$_sk
done
themes=("${_sorted_themes[@]}")

term::disable_input

for theme in "${themes[@]}"; do
  theme_path="$THEMES_DIR/$theme"
  _display_name display "$theme"
  display="${B}${display}${RS}"

  (sleep 0.1) &
  _spinner $! "${Y}[*]${RS} ${Y}Checking${RS} $display"

  if [[ ! -d "$theme_path/.git" ]]; then
    ((SKIPPED++))
    continue
  fi

  # A dirty tracked tree is skipped because ff-only cannot reconcile local
  # edits safely. Untracked files are outside the check, but an incoming file
  # collision still makes the fast-forward pull fail.
  if ! git -C "$theme_path" diff --quiet HEAD 2> /dev/null; then
    ((SKIPPED++))
    continue
  fi

  # This count is local and does not fetch. A stale @{upstream} ref can
  # undercount, while an absent ref produces an empty value that is treated
  # as up to date.
  behind=$(git -C "$theme_path" rev-list --count 'HEAD..@{upstream}' 2> /dev/null)

  if [[ -z "$behind" ]] || ((behind == 0)); then
    ((UPTOD++))
    continue
  fi

  # Pulls run one theme at a time and may fail independently. Aggregate
  # counters preserve partial progress instead of aborting the whole batch.
  git -C "$theme_path" pull --ff-only &
  if ! _spinner $! "${Y}[*]${RS} ${G}Updating${RS} $display"; then
    FAILED+=("$display")
    continue
  fi

  UPD_THEMES+=("$display")
done

if [[ -t 1 && -z "${NO_COLOR+x}" ]]; then
  printf '\r\033[K%s[*]%s All themes processed\n' "$G" "$RS"
else
  printf '[*] All themes processed\n'
fi

if ((${#UPD_THEMES[@]} > 0)); then
  vb::print "$G" "Updated themes:"
  for t in "${UPD_THEMES[@]}"; do
    echo -e "\t   - ${B}$t${RS}"
  done
fi

vb::print "$G" "Updated ${G}${#UPD_THEMES[@]}${RS} theme(s), ${C}$UPTOD${RS} already up to date, ${R}${#FAILED[@]}${RS} failed, ${B}$SKIPPED${RS} skipped"

if ((${#FAILED[@]} > 0)); then
  for failed in "${FAILED[@]}"; do
    echo "  ${R}-${RS} $failed"
  done
fi

if ((${#FAILED[@]} > 0)); then
  operation::result warning "All done"
else
  operation::result success "All done"
fi
