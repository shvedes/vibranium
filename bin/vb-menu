#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"

OPTIONS=(
    "Settings"
    "Packages"
    "Tweaks"
    "Help"
)

INDEX=0

while true; do
    CHOSEN="$(printf "%s\n" "${OPTIONS[@]}" | rofi_cmd "Vibranium" "ESC to exit" -selected-row "$INDEX")"
    [ -z "$CHOSEN" ] && break

    for i in "${!OPTIONS[@]}"; do
        if [ "${OPTIONS[$i]}" == "$CHOSEN" ]; then
            INDEX="$i"
            break
        fi
    done

    case "$CHOSEN" in
        "Settings")
            "$VIBRANIUM_PATH/configure/vibranium-main-menu"
            ;;
        "Help")
            vb-menu-help
            ;;
        "Packages")
            vb-menu-pkg
            ;;
        "Tweaks")
            while true; do
                tweaks_opts=("System" "Apps")
                tweaks_chosen="$(printf "%s\n" "${tweaks_opts[@]}" | rofi_cmd "Tweaks" "ESC to go back")"
                [[ -z $tweaks_chosen ]] && break

                case "$tweaks_chosen" in
                    "Apps")
                        vb-menu-tweaks
                        ;;
                    "System")
                        vb-menu-tweaks-system
                        ;;
                esac
            done
            ;;
        *)
            continue
            ;;
    esac
done
