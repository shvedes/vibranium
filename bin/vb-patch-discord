#!/usr/bin/bash

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Patch Discord with Vencord.

Options:
  -u, --uninstall  Uninstall Vencord and OpenASAR
  -h, --help       Show this help and exit
EOF
}

ACTION="install"

for arg in "$@"; do
  case "$arg" in
    -h|--help)
      usage
      exit 0
      ;;
    -u|--uninstall|-uninstall)
      ACTION="uninstall"
      ;;
    *)
      printf '%s: invalid option -- %s\n' "${0##*/}" "$arg" >&2
      printf 'Try "%s --help" for more information.\n' "${0##*/}" >&2
      exit 2
      ;;
  esac
done

PATCH_PATH="${XDG_CONFIG_HOME:-$HOME/.config}/discord"
URL='https://github.com/Vendicated/VencordInstaller/releases/latest/download/VencordInstallerCli-Linux'
CLI="/tmp/vencord-installer"

echo "==> Downloading Vencord CLI installer"

if command -v wget >/dev/null; then
  wget -q "$URL" -O "$CLI"
elif command -v curl >/dev/null; then
  curl -fsSL "$URL" -o "$CLI"
else
  echo "==> ERROR: Neither wget nor curl is installed" >&2
  exit 1
fi

if (($?)); then
  echo "==> ERROR: Couldn't download Vencord CLI installer" >&2
  exit 1
fi

chmod +x "$CLI"

if [ "$ACTION" = "uninstall" ]; then
  echo "==> Uninstalling Vencord from Discord"
  "$CLI" -uninstall -uninstall-openasar -location "$PATCH_PATH"
else
  echo "==> Patching Discord"
  "$CLI" -install -install-openasar -location "$PATCH_PATH"
fi

if (($?)); then
  echo "==> ERROR: Vencord CLI installer failed" >&2
  exit 1
fi

rm -rf "$CLI"
