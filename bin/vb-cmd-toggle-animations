#!/usr/bin/bash

# Toggle Hyprland animations on/off.
# Ensures the config block exists, reads the current state, flips it, reloads config,
# and optionally outputs 'enabled' or 'disabled'.

CONF="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.conf"
HYPRLOCK_CONF="$XDG_CONFIG_HOME/hypr/hyprlock.conf"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [--help]

Toggle Hyprland animations on/off

Options:
  -h, --help  Show this help and exit
EOF
}

case "$1" in
-h | --help)
  usage
  exit 0
  ;;
"")
  :
  ;;
*)
  echo "Error: unknown option: $1" >&2
  echo "Try '${0##*/} --help' for more information" >&2
  exit 1
  ;;
esac

# Ensure animations block exists
if ! vb-cmd-edit-wm-config --get animations:enabled "$CONF" >/dev/null; then
  VALUE=$(hyprctl -j getoption animations:enabled | jq -r '.set')
  vb-cmd-edit-wm-config animations:enabled:$VALUE "$CONF"
fi

case "$(vb-cmd-edit-wm-config --get animations:enabled "$CONF")" in
true) vb-cmd-edit-wm-config 'animations:enabled:false' "$CONF" ;;
false) vb-cmd-edit-wm-config 'animations:enabled:true' "$CONF" ;;
esac

hyprctl -q reload config-only &
