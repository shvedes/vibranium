#!/usr/bin/env bash

# Toggle Hyprland animations on/off.
# Ensures the config block exists, reads the current state, flips it, reloads config,
# and optionally outputs 'enabled' or 'disabled'.

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.conf.d"
CONF="$CONF_DIR/look-and-feel.conf"

usage() {
    cat << EOF
Usage: $(basename "$0") [--quiet] [--help]

Toggle Hyprland animations on/off.

Options:
  --quiet     Do not print 'enabled' or 'disabled'.
  -h, --help  Show this help and exit
EOF
}

QUIET=false

# CLI parsing
for arg in "$@"; do
    case "$arg" in
        --quiet) QUIET=true ;;
        -h|--help) usage; exit 0 ;;
        *) ;;
    esac
done

# Ensure animations block exists
if ! grep -qE '^[[:space:]]*animations[[:space:]]*{' "$CONF" 2>/dev/null; then
    VALUE=$(hyprctl -j getoption animations:enabled | jq -r '.set')
    printf "\n\nanimations {\n\tenabled = %s\n}" "$VALUE" >> "$CONF"
fi

# Read current state from config
ANIMATIONS_ENABLED="$(sed -n '/animations[[:space:]]*{/,/}/{s/.*enabled[[:space:]]*=[[:space:]]*\([^;]*\).*/\1/p}' "$CONF")"

# Toggle
case "$ANIMATIONS_ENABLED" in
    true)
        sed -i '/animations[[:space:]]*{/,/}/{s/\(enabled[[:space:]]*=[[:space:]]*\).*/\1false/}' "$CONF"
        [[ "$QUIET" = false ]] && echo "disabled"
        ;;
    false)
        sed -i '/animations[[:space:]]*{/,/}/{s/\(enabled[[:space:]]*=[[:space:]]*\).*/\1true/}' "$CONF"
        [[ "$QUIET" = false ]] && echo "enabled"
        ;;
esac

# Reload config asynchronously
hyprctl -q reload config-only &
