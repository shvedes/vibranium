#!/usr/bin/bash

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF OPTION_NAME

Print the value of the specified Vibranium option.

Options:
  -h, --help  Display this help and exit
EOF
}

case "$1" in
-h | --help)
  usage
  exit 0
  ;;
"")
  echo "Error: missing OPTION_NAME" >&2
  echo "Try '$SELF --help' for more information." >&2
  exit 1
  ;;
esac

source vb-lib-core

helpers::check "$1"

if [[ -n "${!1+x}" ]]; then
  printf '%s\n' "${!1}"
fi
