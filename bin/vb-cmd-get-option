#!/bin/bash

source vb-lib-cli

VERBOSE=false

SELF="${0##*/}"

usage() {
  shcat << EOF
Usage: $SELF OPTION_NAME

Print the value of the specified Vibranium option.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -eq 0 ]]; then
  log Error "missing OPTION_NAME"
  log Error "Try --help for more information"
  exit 1
fi

log Info "Getting option: $1"

source vb-lib-core

helpers::check "$1"

# "${!1}" is Bash indirect variable expansion: it resolves to the value
# of the variable whose name is stored in $1 (e.g. if $1="SOME_VAR",
# "${!1}" expands to $SOME_VAR). The +x test checks whether the variable
# exists without triggering "unbound variable" errors under set -u.
if [[ -n "${!1+x}" ]]; then
  printf '%s\n' "${!1}"
fi
