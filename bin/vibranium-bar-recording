#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vibranium-core-lib"

if ! pidof gpu-screen-recorder &> /dev/null; then
    printf '{"text": ""}'
    exit 0
fi

icon="\uf28d"
tooltip=" <span foreground='${WAYBAR_ACCENT}'><b>Screen recording is active</b></span> \n"

if [[ $VIBRANIUM_BAR_SHOW_SHORTCUT_HINTS == true ]]; then
    tooltip+="<span foreground='${WAYBAR_MUTED}'>----------------------------</span>\n"
    tooltip+=" <span foreground='${WAYBAR_ACCENT}'><b>CTRL ALT + R:</b></span> "
    tooltip+="<span foreground='${WAYBAR_RED}'><b>stop recording</b></span>\n "
    tooltip+="<span foreground='${WAYBAR_ACCENT}'><b>Left click:</b></span>   "
    tooltip+="<span foreground='${WAYBAR_RED}'><b>stop recording</b></span> "
else
    tooltip+="<span foreground='${WAYBAR_MUTED}'>----------------------------</span>\n"
    tooltip+=" <span foreground='${WAYBAR_RED}'><b>\tclick to stop</b></span> "
fi

printf '{"text": "%s", "tooltip": "%s"}' "$icon" "$tooltip"
