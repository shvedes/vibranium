#!/usr/bin/bash

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF -- COMMAND [ARGS...]

Focus existing window matching COMMAND, or launch it via app2unit.

Options:
  -h, --help     Show this help and exit
EOF
}

if ! (($#)); then
  usage >&2
  exit 1
fi

while (($#)); do
  case "$1" in
  --)
    shift
    break
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Error: unknown option -- $*" >&2
    echo "Try '$SELF --help' for more information" >&2
    exit 1
    ;;
  esac
done

(($#)) || {
  echo "Error: missing COMMAND after --" >&2
  exit 1
}

COMMAND=("$@")

APP_NAME="${COMMAND[0]##*/}"
WINDOW_PATTERN="$APP_NAME"

WINDOW_ADDRESS="$(
  jq -r --arg p "$WINDOW_PATTERN" '
    first(
      .[]
      | select(
          (.class | test("\\b" + $p + "\\b"; "i")) or
          (.title | test("\\b" + $p + "\\b"; "i"))
        )
      | .address
    )
  ' < <(hyprctl -j clients)
)"

if [[ -n "$WINDOW_ADDRESS" ]]; then
  [[ -t 0 ]] && echo "Focusing existing window"
  hyprctl -q dispatch focuswindow "address:$WINDOW_ADDRESS"
else
  exec setsid -f app2unit -- "${COMMAND[@]}"
fi
