#!/usr/bin/bash

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF -- COMMAND [ARGS...]

Focus existing window matching COMMAND, or launch it via app2unit.

Options:
  -h, --help     Show this help and exit
EOF
}

focus_or_launch() {
  local -a cmd=("$@")

  local match_key="${cmd[0]##*/}"
  match_key="${match_key,,}"

  local window_address
  window_address="$(
    jq -r --arg key "$match_key" '
      . as $clients |

      # Phase 1: exact match against .class and .initialClass.
      (
        try first(
          $clients[]
          | (.class        // "" | ascii_downcase) as $c
          | (.initialClass // "" | ascii_downcase) as $ic
          | select($c == $key or $ic == $key)
          | .address
        )
      )

      //

      # Phase 2: partial match — either the class is a substring of the
      # key or the key is a substring of the class. The empty-string
      # guard prevents "" from matching everything via contains().
      # Example: key="google-chrome-stable", class="google-chrome" ->
      # "google-chrome-stable" contains "google-chrome" -> match.
      (
        try first(
          $clients[]
          | (.class        // "" | ascii_downcase) as $c
          | (.initialClass // "" | ascii_downcase) as $ic
          | select(
              ($c  != "" and (($c  | contains($key)) or ($key | contains($c))))  or
              ($ic != "" and (($ic | contains($key)) or ($key | contains($ic))))
            )
          | .address
        )
      )
    ' 2>/dev/null < <(hyprctl -j clients)
  )"

  if [[ -n "$window_address" ]]; then
    hyprctl -q dispatch focuswindow "address:$window_address"
  else
    exec setsid -f app2unit -- "${cmd[@]}"
  fi
}

if ! (($#)); then
  usage >&2
  exit 1
fi

source vb-lib-core

while (($#)); do
  case "$1" in
  --)
    shift
    break
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Error: unknown option -- $*" >&2
    echo "Try '$SELF --help' for more information" >&2
    exit 1
    ;;
  esac
done

(($#)) || {
  echo "Error: missing COMMAND after --" >&2
  exit 1
}

COMMAND=("$@")

helpers::check VIBRANIUM_GLOBAL_APP_LAUNCHER_ALWAYS_FOCUS

if [[ "$VIBRANIUM_GLOBAL_APP_LAUNCHER_ALWAYS_FOCUS" == true ]]; then
  # shellcheck disable=SC2068
  focus_or_launch ${COMMAND[@]}
else
  # shellcheck disable=SC2068
  exec setsid -f app2unit -- ${COMMAND[@]}
fi
