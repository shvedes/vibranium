#!/bin/bash

VERBOSE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Toggle systemd-coredump on/off.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

_is_disabled() {
  local pattern
  # sysfs/procfs value is a single line, so pattern[0] is always the value.
  mapfile -t pattern < /proc/sys/kernel/core_pattern
  [[ "${pattern[0]}" == "|/bin/false" ]]
}

_as_root=(pkexec su-bridge --root --)
[[ -t 1 ]] && _as_root=(sudo)

if _is_disabled; then
  log Info "Enabling coredumps"
  if ! "${_as_root[@]}" bash -c \
    'rm -f /etc/sysctl.d/99-coredump.conf; sysctl --system >/dev/null'; then
    exit 1
  fi
  echo "[${0##*/}] systemd-coredump enabled. No reboot required"
else
  log Info "Disabling coredumps"
  c='kernel.core_pattern=|/bin/false'
  _r=' > /etc/sysctl.d/99-coredump.conf; sysctl --system >/dev/null'
  if ! "${_as_root[@]}" bash -c \
    "printf '$c\n'$_r"; then
    exit 1
  fi
  echo "[${0##*/}] systemd-coredump disabled. No reboot required"
fi
