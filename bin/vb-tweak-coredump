#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Toggle systemd-coredump on/off.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

_is_disabled() {
  local pattern
  # sysfs/procfs value is a single line, so pattern[0] is always the value.
  mapfile -t pattern < /proc/sys/kernel/core_pattern
  [[ "${pattern[0]}" == "|/bin/false" ]]
}

_as_root=(pkexec su-bridge --root --)
if [[ -t 1 ]]; then
  _as_root=(sudo)
fi

if _is_disabled; then
  log Info "Enabling coredumps"
  cmd="rm -f /etc/sysctl.d/99-coredump.conf;"
  cmd+="sysctl --system"
  if ! "${_as_root[@]}" bash -c "$cmd > /dev/null"; then
    exit 1
  fi
  notify-send -r 3 "Systemd Coredump enabled" "No reboot required"
  echo "[${0##*/}] systemd-coredump enabled. No reboot required"
else
  log Info "Disabling coredumps"
  c='kernel.core_pattern=|/bin/false'
  _r=' > /etc/sysctl.d/99-coredump.conf; sysctl --system >/dev/null'
  if ! "${_as_root[@]}" bash -c \
    "printf '$c\n'$_r"; then
    exit 1
  fi
  notify-send -r 3 "Systemd Coredump Disabled" "No reboot required"
  echo "[${0##*/}] systemd-coredump disabled. No reboot required"
fi
