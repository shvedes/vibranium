#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"
source "$XDG_CONFIG_HOME/vibranium/theme/current/vibranium-lib-theme"

usage() {
    cat << EOF
Usage: $(basename "$0") [--help]

Suspend or resume the currently active window in Hyprland.
Sends a desktop notification with the window name and new state.

Options:
  -h, --help   Show this help and exit
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0
esac

# Get active window PID and class
read -r PID NAME <<< "$(hyprctl -j activewindow | jq -r '[.pid,.class]|@tsv')"

if [[ -z $PID ]]; then
    notify-send -r 3 -t 3000 -u critical "Vibranium" "No active window!"
    exit 1
fi

# Read process state
read _ _ state _ < /proc/$PID/stat

if [[ $state != T ]]; then
    kill -STOP "$PID"
    msg="suspended"
else
    kill -CONT "$PID"
    msg="restored"
fi

notify-send -r 1 "Vibranium" "<span foreground='${P_YELLOW}'>${NAME}</span> $msg"
