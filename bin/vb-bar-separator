#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"

show() {
    printf '{"text": "|"}'
    exit
}

for f in /run/systemd/inhibit/*; do
    [[ -f $f ]] || continue
    while IFS= read -r line; do
        case $line in
            *=Vibranium) show ;;
        esac
    done < "$f"
done

paths=(
  "$VIBRANIUM_RUNTIME/vb-timer.remaining"
  "$VIBRANIUM_RUNTIME/confirm-kill"

  "$VIBRANIUM_STATE/update.available"
  "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/reading-mode.conf"
)

for p in "${paths[@]}"; do
  [[ -e "$p" ]] && show
done

printf '{"text": ""}'
