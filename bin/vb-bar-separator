#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"

show() {
    printf '{"text": "|"}'
    exit
}

for f in /run/systemd/inhibit/*; do
    [[ -f $f ]] || continue
    while IFS= read -r line; do
        case $line in
            *=Vibranium) show ;;
        esac
    done < "$f"
done

paths=(
  "$VIBRANIUM_STATE/update.available"
  "$XDG_RUNTIME_DIR/vb-timer.remaining"
  "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/reading-mode.conf"
  "$XDG_RUNTIME_DIR/vb-core-force-kill.confirm"
)

for p in "${paths[@]}"; do
  [[ -e "$p" ]] && show
done

[[ $VIBRANIUM_BAR_COLOR_PICKER_MODULE_ENABLE == true ]] && show

printf '{"text": ""}'
