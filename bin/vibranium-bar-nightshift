#!/usr/bin/env bash

state="$(< "$XDG_STATE_HOME/vibranium/nightshift")"
if [[ $state == "active" ]]; then
    config="$XDG_CONFIG_HOME/hypr/hyprsunset.conf"
    current="$(grep -oP '(?<=temperature = ).*' "$config")"
    tooltip="Night Light temperature: ${current}K"
    printf '{"text": "%s", "tooltip": "%s"}' "\\udb80\\udf35" "$tooltip"
else
    printf '{"text": ""}'
fi
