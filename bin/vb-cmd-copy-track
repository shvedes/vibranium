#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

SELF="${0##*/}"

usage() {
  shcat << EOF
Usage: $SELF [OPTION]

Copy URI of the currently playing track to the clipboard.
Supports MPD and Playerctl.

Options:
  -n, --notify  Show desktop notification
  -v, --verbose Enable verbose output
  -h, --help    Display this help and exit
EOF
}

# Parse MPD's music_directory from mpd.conf using a regex that matches
# optional leading whitespace, the directive, and the quoted path.
# Expands a leading ~ to $HOME since MPD allows tilde paths in config.
mpd_music_dir() {
  local -n _mpd_music_dir_out=$1
  local dir=
  local line

  # The scan stops at the first matching directive, so duplicate entries later
  # in the file do not replace the selected music directory.
  while IFS= read -r line; do
    [[ $line =~ ^[[:space:]]*music_directory[[:space:]]*\"(.*)\" ]] && {
      dir="${BASH_REMATCH[1]}"
      break
    }
  done < "$XDG_CONFIG_HOME/mpd/mpd.conf"

  if [[ -z "$dir" ]]; then
    return 1
  fi

  if [[ "$dir" == "~"* ]]; then
    dir="${dir/#\~/$HOME}"
  fi

  _mpd_music_dir_out="$dir"
}

# Decode %XX sequences back to their original bytes. Replaces % with \x
# and lets printf '%b' interpret the resulting escape sequences.
_url_decode() {
  local -n _url_decode_out=$1
  local str="$2"
  printf -v _url_decode_out '%b' "${str//%/\\x}"
}

# URL-encode a URI path using Bash's character-wise substring loop. The
# unreserved case preserves `/` as a path separator; other characters use
# printf's numeric-character conversion for %XX.
_url_encode() {
  local -n _url_encode_out=$1
  local str="$2" c i hex
  _url_encode_out=""
  for ((i = 0; i < ${#str}; i++)); do
    c="${str:i:1}"
    case "$c" in
      [a-zA-Z0-9./_~-]) _url_encode_out+="$c" ;;
      *) printf -v hex '%%%02X' "'$c"; _url_encode_out+="$hex" ;;
    esac
  done
}

# The status probe is separate from fifo existence: a fifo can remain after
# the daemon stops, while `%state%` reflects the live control connection.
mpd_is_playing() {
  [[ "$(mpc status %state% 2> /dev/null)" == "playing" ]]
}

notify=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -n | --notify)
      notify=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log Error "Invalid option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
  esac
done

log Info "Copying current track"

file=""

# Prefer MPD when its control fifo exists (indicating the daemon is active
# and reachable), falling back to playerctl for all other MPRIS players.
# The fifo check avoids triggering socket activation on a stopped MPD.
if command -v mpc > /dev/null && [[ -p "$XDG_RUNTIME_DIR/mpd.fifo" ]] && mpd_is_playing; then
  track="$(mpc current -f '%file%')"
  music_dir=
  mpd_music_dir music_dir || exit $?

  # An empty track or directory must not become a misleading `file://` URI.
  if [[ -n "$track" && -n "$music_dir" ]]; then
    encoded=
    _url_encode encoded "$music_dir/$track"
    file="file://$encoded"
  fi

elif playerctl status &> /dev/null; then
  # Playerctl supplies the URL directly, so this branch preserves whatever URI
  # the active MPRIS player reports without local path conversion.
  file="$(playerctl metadata --format '{{xesam:url}}' 2> /dev/null)"
fi

if [[ -z "$file" ]]; then
  log Error "no track currently playing"
  if [[ "$notify" == true ]]; then
    notify-send -a "Vibranium" -u critical -t 3000 -r 4 "Vibranium" "No track currently playing"
  fi
  exit 1
fi

# The explicit MIME type selects the URI-list clipboard offer; the pipeline
# sends the URI bytes without appending a newline.
printf '%s' "$file" | wl-copy --type text/uri-list

if [[ "$notify" == true ]]; then
  if [[ "$file" =~ ^https?:// ]]; then
    # The clipboard retains the complete URI; the non-HTTP(S) notification
    # path percent-decodes its final URI component for display.
    msg="Link copied to clipboard"
  else
    decoded=
    _url_decode decoded "${file##*/}"
    msg="<i><b>$decoded</b></i> copied to clipboard"
  fi
  notify-send -r 3 -a "Vibranium" "Vibranium" "$msg"
fi
