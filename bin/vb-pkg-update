#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}
HOOK_DIR="$VIBRANIUM/default/hooks/update"
UHOOK_DIR="$XDG_CONFIG_HOME/vibranium/hooks/update"

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]...

Perform system update (official repos by default, AUR with --aur)

Options:
  --no-logo         Do not display the logo at startup
  --no-dummy        Do not wait for a key press after completion or cancellation
  --aur             Update AUR packages instead of official repositories
  -v, --verbose     Enable verbose output
  -h, --help        Display this help and exit
EOF
}

_operation_canceled() {
  term::disable_input
  printf "%s[VIBRANIUM]%s Operation canceled" "$R" "$RS"

  if [[ "$NO_DUMMY" == "false" && -t 0 ]]; then
    trap 'exit 1' SIGHUP SIGINT SIGTERM SIGQUIT
    # shellcheck disable=SC2034
    read -n1 -r -s -p $'. Press any key to exit' dummy
  fi
}

_update_complete() {
  trap '' SIGHUP SIGINT SIGTERM SIGQUIT
  printf "\r\033[K%s[VIBRANIUM]%s %s" "$G" "$RS" "$@"

  if [[ "$NO_DUMMY" == "false" && -t 0 ]]; then
    # shellcheck disable=SC2034
    read -n1 -r -p $'. Press any key to exit' dummy
  fi

  printf '\e[?25h' # Show cursor
}

_check_updates() {
  log Info "Checking updates (aur=$AUR_MODE)"
  if [[ "$AUR_MODE" == true ]]; then
    mapfile -t PKG_LIST < <(yay -Qum 2> /dev/null)
  else
    mapfile -t PKG_LIST < <(pacman -Qu)
  fi

  if ((${#PKG_LIST[@]} == 0)); then
    log Info "No updates found"
    return 1
  fi

  log Info "${#PKG_LIST[@]} update(s) available"
}

# Temporarily enable the sleep inhibitor during the update to prevent
# the system from suspending while packages are being installed.  The
# trap on RETURN restores the original inhibitor state when the function
# completes (whether successful or not).
_perform_update() {
  log Info "Starting update (aur=$AUR_MODE)"
  local need_inhibit=1

  systemctl -q --user is-active vibranium-inhibit@idle && need_inhibit=
  systemctl -q --user is-active vibranium-inhibit@sleep && need_inhibit=

  if [[ -n $need_inhibit ]]; then
    log Info "Activating sleep inhibitor"
    systemctl -q --user start vibranium-inhibit@sleep
    vb-refresh-waybar-module inhibitor
  fi

  cleanup() {
    log Info "Cleaning up sleep inhibitor"
    if [[ -n $need_inhibit ]]; then
      systemctl -q --user stop vibranium-inhibit@sleep
      vb-refresh-waybar-module inhibitor
    fi
  }

  trap cleanup RETURN

  if [[ "$AUR_MODE" == true ]]; then
    yes | yay -Sua --noconfirm --sudoloop
  else
    sudo pacman -Su --noconfirm
  fi
}

# Return 0 when any updated package is a kernel, graphics driver,
# display server, or networking component that requires a reboot.
_check_important() {
  log Info "Checking for important updates"
  local important_regex='^(systemd|linux(-headers|-lts|-zen|-hardened)?|networkmanager|iwd|mesa|nvidia)$'

  for pkg_line in "${PKG_LIST[@]}"; do
    local pkg="${pkg_line%% *}"
    if [[ $pkg =~ $important_regex ]]; then
      log Info "Important package updated: $pkg"
      return 0
    fi
  done

  return 1
}

# When invoked from the Waybar pacman module (no TTY attached), open a
# terminal window running this script so the user sees the interactive
# update flow.
if [[ ! -t 1 ]]; then
  xdg-terminal-exec --title="${0##*/}" --app-id=org.vb.term.float -- "$0"
  exit
fi

if ! systemd-inhibit --json=short | jq -e '.[] | select(.why == "System update is active")' > /dev/null; then
  exec systemd-inhibit --what=idle --who=Vibranium --why="System update is active" --mode=block -- "$0" "$@"
fi

source vb-lib-core

SUDO_PROMPT="$(printf '%s[VIBRANIUM]%s Password for %s: ' "$R" "$RS" "$USER")"
export SUDO_PROMPT

NO_LOGO=false
NO_DUMMY=false
AUR_MODE=false
PKG_LIST=()

trap 'trap "exit 1" SIGHUP SIGINT SIGTERM SIGQUIT; term::disable_input; _operation_canceled; exit 1' SIGHUP SIGINT SIGTERM SIGQUIT

while (($# > 0)); do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    --no-logo)
      NO_LOGO=true
      shift
      ;;
    --no-dummy)
      NO_DUMMY=true
      shift
      ;;
    --aur)
      AUR_MODE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    --*)
      log Error "Unknown option: $1"
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

if [[ $NO_LOGO == false ]]; then
  term::show_header
fi

# Refresh the sudo timestamp before the long-running pacman call so the
# password prompt appears at the start rather than mid-update.
if ! sudo -n true 2> /dev/null; then
  if [[ "$AUR_MODE" == true ]]; then
    vb::print "$Y" "${G}yay${RS} needs ${R}sudo${RS} for ${B}AUR${RS} operations"
  else
    vb::print "$Y" "${G}pacman${RS} needs ${R}sudo${RS} to update repos"
  fi
fi
if ! sudo -v; then
  _operation_canceled
  exit 1
fi

term::disable_input

if [[ "$AUR_MODE" == true ]]; then
  yay -Sy &> /dev/null &
else
  sudo pacman -Sy &> /dev/null &
fi

pid=$!

term::spinner $pid "${Y}[VIBRANIUM]${RS} Refreshing repositories" "- ${G}Done!${RS}"

if ! _check_updates; then
  rm -f "$VIBRANIUM_CACHE"/pkg-updates.*
  if [[ "$AUR_MODE" == true ]]; then
    _update_complete "AUR is up to date"
  else
    _update_complete "You are up to date"
  fi
  vb-refresh-waybar-module pacman &
  exit 0
fi

if [[ "$AUR_MODE" == true ]]; then
  vb::print "$Y" "${#PKG_LIST[@]} AUR package(s) are awaiting updates"
  vb::print "$Y" "Starting AUR update..."
else
  vb::print "$Y" "${#PKG_LIST[@]} package(s) are awaiting updates"
  vb::print "$Y" "Starting system update..."
fi

if ! _perform_update; then
  vb::print "$R" "Something went wrong"
  _operation_canceled
  exit 1
fi

# Remove package list cache
rm -f "$VIBRANIUM_CACHE"/pkg-updates.*

# Update the Waybr module
setsid -f vb-refresh-waybar-module pacman

# Regenerate the Lua bytecode for the Hyprland config editor.
# In case if Lua was updated.
source vb-cmd-editor-luac

shopt -s nullglob
for _hook in "$HOOK_DIR"/*.sh "$UHOOK_DIR"/*.sh; do
  setsid -f "$_hook" &> /dev/null
done

if _check_important; then
  vb::print "$Y" "Important system components have been updated"

  if term::ask_yes_no Y "Restart now?"; then
    term::disable_input
    trap '' SIGHUP SIGINT SIGTERM SIGQUIT

    for i in {5..1}; do
      for dots in "" "." ".." "..."; do
        printf "\r\033[K%s[VIBRANIUM]%s Restarting in %d%s" "$Y" "$RS" "$i" "$dots"
        sleep 0.25
      done
    done

    systemctl reboot
    exit 0
  else
    if [[ "$AUR_MODE" == true ]]; then
      _update_complete "AUR update complete. Restart required"
    else
      _update_complete "System update complete. Restart required"
    fi
  fi
else
  if [[ "$AUR_MODE" == true ]]; then
    _update_complete "AUR update complete"
  else
    _update_complete "System update complete"
  fi
fi
