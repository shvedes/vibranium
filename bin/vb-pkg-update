#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}
HOOK_DIR="$VIBRANIUM/default/hooks/update"
UHOOK_DIR="$XDG_CONFIG_HOME/vibranium/hooks/update"

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]... [PACKAGE...]

Perform system update (official repos by default, AUR with --aur).
When PACKAGE names are given, only those packages are updated; without
them every available update of the selected source is installed.

Options:
  --no-logo         Do not display the logo at startup
  --no-dummy        Do not wait for a key press after completion or cancellation
  --aur             Update AUR packages instead of official repositories
  --both            Update official repositories and AUR packages together
  -v, --verbose     Enable verbose output
  -h, --help        Display this help and exit
EOF
}

update_prepare_result() {
  if [[ -z "${term_original_settings:-}" ]]; then
    term::disable_input
  fi
}

# Result and signal handlers share the same terminal preparation contract.
# operation::result owns presentation and terminal restoration; NO_DUMMY
# changes only whether it waits for a key.
update_result() {
  local outcome="$1"
  shift

  update_prepare_result
  if [[ "$NO_DUMMY" == true ]]; then
    operation::result "$outcome" --no-wait "$@"
  else
    operation::result "$outcome" "$@"
  fi
}

update_signal_canceled() {
  trap - SIGHUP SIGINT SIGTERM SIGQUIT

  update_prepare_result
  if [[ "$NO_DUMMY" == true ]]; then
    operation::result canceled --no-wait
  else
    operation::result canceled
  fi

  exit 1
}

# An empty query result is treated as the no-update path: the caller clears
# generated package counts and refreshes status without invoking a package
# manager update transaction.
_check_updates() {
  log Info "Checking updates (aur=$AUR_MODE, both=$BOTH_MODE)"
  if [[ "$BOTH_MODE" == true ]]; then
    # yay -Qu lists repo and AUR updates together.
    mapfile -t PKG_LIST < <(yay -Qu 2> /dev/null)
  elif [[ "$AUR_MODE" == true ]]; then
    # -Qum restricts the same query to foreign (AUR) packages only.
    mapfile -t PKG_LIST < <(yay -Qum 2> /dev/null)
  else
    mapfile -t PKG_LIST < <(pacman -Qu)
  fi

  if ((${#PKG_LIST[@]} == 0)); then
    log Info "No updates found"
    return 1
  fi

  log Info "${#PKG_LIST[@]} update(s) available"
}

# Without explicit names, source mode selects the transaction shape:
# official-only upgrades use pacman, AUR-only upgrades use yay -Sua, and
# combined mode uses yay -Su. The explicit and combined paths retain
# --needed to avoid redundant reinstall work.
_perform_update() {
  log Info "Starting update (aur=$AUR_MODE, both=$BOTH_MODE, targets=${#PKG_LIST[@]}, explicit=$EXPLICIT_COUNT)"

  # Explicit mode receives only CLI targets in PKG_LIST; each entry is reduced
  # to the text up to its first space for the update command.
  if ((EXPLICIT_COUNT > 0)); then
    local names=()
    local entry
    for entry in "${PKG_LIST[@]}"; do
      names+=("${entry%% *}")
    done
    if [[ "$BOTH_MODE" == true ]]; then
      # yay resolves repo and AUR names in one run.
      yes | yay -S --needed --noconfirm --sudoloop "${names[@]}"
    elif [[ "$AUR_MODE" == true ]]; then
      yes | yay -S --needed --noconfirm --sudoloop "${names[@]}"
    else
      sudo pacman -S --needed --noconfirm "${names[@]}"
    fi
    return $?
  fi

  if [[ "$BOTH_MODE" == true ]]; then
    # yay -Su upgrades repos and AUR together in a single pass.
    yes | yay -Su --needed --noconfirm --sudoloop
  elif [[ "$AUR_MODE" == true ]]; then
    yes | yay -Sua --noconfirm --sudoloop
  else
    sudo pacman -Su --noconfirm
  fi
}

# Returns success when a queried package name matches the reboot-sensitive
# allowlist; the check does not inspect versions, files, or service state.
_check_important() {
  log Info "Checking for important updates"
  local important_regex='^(systemd|linux(-headers|-lts|-zen|-hardened)?|networkmanager|iwd|mesa|nvidia)$'

  for pkg_line in "${PKG_LIST[@]}"; do
    local pkg="${pkg_line%% *}"
    if [[ $pkg =~ $important_regex ]]; then
      log Info "Important package updated: $pkg"
      return 0
    fi
  done

  return 1
}

# A non-TTY invocation cannot show the interactive flow, so it is relaunched
# in a terminal window.
if [[ ! -t 1 ]]; then
  xdg-terminal-exec --title="${0##*/}" --app-id=org.vb.term.float -- "$0" "$@"
  exit
fi

source vb-lib-core

printf -v SUDO_PROMPT '%s[*]%s Password for %s: ' "$R" "$RS" "$USER"
export SUDO_PROMPT

NO_LOGO=false
NO_DUMMY=false
AUR_MODE=false
BOTH_MODE=false
PKG_LIST=()
EXPLICIT_COUNT=0

trap 'update_signal_canceled' SIGHUP SIGINT SIGTERM SIGQUIT

while (($# > 0)); do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    --no-logo)
      NO_LOGO=true
      shift
      ;;
    --no-dummy)
      NO_DUMMY=true
      shift
      ;;
    --aur)
      AUR_MODE=true
      shift
      ;;
    --both)
      BOTH_MODE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    --*)
      log Error "Unknown option: $1"
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

# Remaining args are explicit package names. Assign after parsing so flags
# like --both do not land in the target list.
PKG_LIST=("$@")
EXPLICIT_COUNT=${#PKG_LIST[@]}

# --both covers AUR, so it is not treated as AUR-only.
if [[ "$BOTH_MODE" == true ]]; then
  AUR_MODE=false
fi

if [[ $NO_LOGO == false ]]; then
  term::show_header
fi

# Refresh the sudo timestamp so a password prompt appears at command start,
# not during the long-running update.
if ! sudo -n true 2> /dev/null; then
  if [[ "$AUR_MODE" == true || "$BOTH_MODE" == true ]]; then
    vb::print "$Y" "${G}yay${RS} needs ${R}sudo${RS} for ${B}AUR${RS} operations"
  else
    vb::print "$Y" "${G}pacman${RS} needs ${R}sudo${RS}"
  fi
fi
if ! sudo -v; then
  update_result error
  exit 1
fi

term::disable_input

# The selected update transaction follows this independent official metadata
# synchronization. AUR-only and combined modes still use pacman for this
# shared prerequisite.
sudo pacman -Sy

# Specific targets were passed on the command line - skip the scan and
# install exactly those. Otherwise check what is available to update.
if ((EXPLICIT_COUNT == 0)); then
  if ! _check_updates; then
    rm -f "$VIBRANIUM_CACHE"/pkg-updates.*
    if [[ "$AUR_MODE" == true ]]; then
      printf '\r\033[K'
      update_result noop -- "AUR is up to date"
      vb-shell arch-updates refresh > /dev/null
    else
      printf '\r\033[K'
      update_result noop -- "You are up to date"
      vb-shell arch-updates refresh > /dev/null
    fi
    exit 0
  fi
fi

if ((EXPLICIT_COUNT > 0)); then
  vb::print "$Y" "${#PKG_LIST[@]} selected package(s): ${PKG_LIST[*]}"
  vb::print "$Y" "Starting update (aur=$AUR_MODE, both=$BOTH_MODE)..."
elif [[ "$AUR_MODE" == true ]]; then
  vb::print "$Y" "${#PKG_LIST[@]} AUR package(s) are awaiting updates"
  vb::print "$Y" "Starting AUR update..."
elif [[ "$BOTH_MODE" == true ]]; then
  vb::print "$Y" "${#PKG_LIST[@]} package(s) are awaiting updates (official + AUR)"
  vb::print "$Y" "Starting full system update..."
else
  vb::print "$Y" "${#PKG_LIST[@]} package(s) are awaiting updates"
  vb::print "$Y" "Starting system update..."
fi

if ! _perform_update; then
  vb::print "$R" "Something went wrong"
  update_result error
  exit 1
fi

# The wildcard removes every generated package-update cache entry rather than
# only the selected source, so status consumers cannot observe stale counts.
rm -f "$VIBRANIUM_CACHE"/pkg-updates.*

# nullglob makes absent hook directories contribute zero paths. Each hook
# is detached with setsid, so hook completion is not aggregated with the
# package manager's exit status.
shopt -s nullglob
for _hook in "$HOOK_DIR"/*.sh "$UHOOK_DIR"/*.sh; do
  setsid -f "$_hook" &> /dev/null
done

# The reboot decision is name-based: _check_important inspects queried package
# names, not changed files or service state. An explicit target can match the
# allowlist without a file change; declining leaves the components pending.
if _check_important; then
  vb::print "$Y" "Important system components have been updated"

  if term::ask_yes_no Y "Restart now?"; then
    term::disable_input

    for i in {5..1}; do
      for dots in "" "." ".." "..."; do
        printf "\r\033[K%s[*]%s Restarting in %d%s" "$Y" "$RS" "$i" "$dots"
        sleep 0.25
      done
    done

    systemctl reboot
    exit 0
  else
    if [[ "$AUR_MODE" == true ]]; then
      printf '\r\033[K'
      update_result success -- "AUR update complete. Restart required"
      vb-shell arch-updates refresh > /dev/null
    else
      printf '\r\033[K'
      update_result success -- "System update complete. Restart required"
      vb-shell arch-updates refresh > /dev/null
    fi
  fi
else
  if [[ "$AUR_MODE" == true ]]; then
    printf '\r\033[K'
    update_result success -- "AUR update complete"
    vb-shell arch-updates refresh > /dev/null
  else
    printf '\r\033[K'
    update_result success -- "System update complete"
    vb-shell arch-updates refresh > /dev/null
  fi
fi
