#!/usr/bin/env bash

STATE="$VIBRANIUM_STATE/cursor-theme"
QUIET=0
SELECTED_FOLDER=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -q|--quiet)
            QUIET=1
            shift
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            if [[ -z "$SELECTED_FOLDER" ]]; then
                SELECTED_FOLDER="$1"
            fi
            shift
            ;;
    esac
done

if [[ -z "$SELECTED_FOLDER" ]]; then
    if [[ -f "$STATE" ]]; then
        SELECTED_FOLDER="$(< "$STATE")"
    else
        SELECTED_FOLDER="Adwaita"
    fi
fi

GTK_SETTINGS=(
    "$XDG_CONFIG_HOME/gtk-3.0/settings.ini"
    "$XDG_CONFIG_HOME/gtk-4.0/settings.ini"
    "$HOME/.gtkrc-2.0"
)

if [[ ! -d "$XDG_DATA_HOME/icons/default" ]]; then
    mkdir -p "$XDG_DATA_HOME/icons/default"
    printf "[Icon Theme]\nInherits=" \
        > "$XDG_DATA_HOME/icons/default/index.theme"
fi

sed -i "/Inherits/s/=.*/=${SELECTED_FOLDER}/" "$XDG_DATA_HOME/icons/default/index.theme"
sed -i "/gtk-cursor-theme-name/s/=.*/=${SELECTED_FOLDER}/" "${GTK_SETTINGS[@]}"

printf "%s" "$SELECTED_FOLDER" > "$STATE"

hyprctl -q setcursor "$SELECTED_FOLDER" 24
gsettings set org.gnome.desktop.interface cursor-size 24
gsettings set org.gnome.desktop.interface cursor-theme "$SELECTED_FOLDER"

if [[ ! "$1" == "--quiet" ]]; then
    notify-send -r 3 -t 7000 "Vibranium" "Some X11 apps (e.g. Steam) need a full restart to apply the new cursor theme"
fi

