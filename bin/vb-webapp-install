#!/bin/bash

# shellcheck disable=SC2034

source vb-lib-cli

ICON_DIR="$XDG_DATA_HOME/applications/icons"
SELF="${0##*/}"

VERBOSE=${VERBOSE:-false}

# Parser state starts with empty strings and false booleans. Interactive mode
# populates the fields it prompts for; flags can still set non-prompted state.

APP_URL=""
APP_NAME=""
ICON_REF=""
CUSTOM_EXEC=""
MIME_TYPES=""
EXTRA_KW=""
CATEGORY=""
OWN_PROFILE=false
FORCE=false
INT_MODE=false

usage() {
  shcat << EOF
Usage: $SELF [OPTION]...

Install a Progressive Web App shortcut as a .desktop launcher entry.

Options:
  --url URL           Web app URL to install
  --name NAME         App display name (default: fetched from page <title>)
  --icon REF          Icon URL or filename inside the icons directory
  --exec CMD          Custom Exec= value (default: vb-launch-webapp URL)
  --mime-types TYPES  MimeType= value for the .desktop file
  --keywords KW       Extra keywords, semicolon-separated (appended to auto-generated ones)
  --category CAT      Categories= value for the .desktop file (e.g. Network;WebBrowser)
  --own-profile       Launch the PWA in its own isolated browser profile
  -f, --force         Install over existing .desktop file without prompting
  -v, --verbose       Enable verbose output
  -h, --help          Show this help and exit

If --url is not provided, the script runs in interactive mode and prompts
for all required fields. In non-interactive mode (--url given), a missing
--name is resolved automatically by fetching the page <title>.

When --own-profile is set, the launcher receives a --profile-directory flag
derived from the URL hostname, giving the PWA its own cookies and session.
Note: --own-profile is ignored when --exec is also provided.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    --url)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for --url"
        exit 1
      }
      APP_URL="$2"
      shift 2
      ;;
    --name)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for --name"
        exit 1
      }
      APP_NAME="$2"
      shift 2
      ;;
    --icon)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for --icon"
        exit 1
      }
      ICON_REF="$2"
      shift 2
      ;;
    --exec)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for --exec"
        exit 1
      }
      CUSTOM_EXEC="$2"
      shift 2
      ;;
    --mime-types)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for --mime-types"
        exit 1
      }
      MIME_TYPES="$2"
      shift 2
      ;;
    --keywords)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for --keywords"
        exit 1
      }
      EXTRA_KW="$2"
      shift 2
      ;;
    --category)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for --category"
        exit 1
      }
      CATEGORY="$2"
      shift 2
      ;;
    -f | --force)
      FORCE=true
      shift
      ;;
    --own-profile)
      OWN_PROFILE=true
      shift
      ;;
    --)
      shift
      break
      ;;
    --* | -*)
      log Error "Unknown option: $1"
      exit 1
      ;;
    *)
      log Error "Unexpected argument: $1. Use flags to pass values"
      exit 1
      ;;
  esac
done

# The absence of --url selects interactive mode. Resolving it here lets the
# Chromium preflight report through the same result helpers as the prompts.
[[ -z $APP_URL ]] && INT_MODE=true

webapp_install_prepare_result() {
  if [[ -z "${term_original_settings+x}" ]]; then
    term::disable_input
  fi
}

webapp_install_canceled() {
  [[ $INT_MODE == true ]] || return
  webapp_install_prepare_result
  operation::result canceled
}

webapp_install_interrupt() {
  trap 'exit 1' INT
  printf '\n'
  webapp_install_canceled
  exit 1
}

webapp_install_duplicate_canceled() {
  [[ $INT_MODE == true ]] || return
  webapp_install_prepare_result
  operation::result noop -- "Operation canceled"
}

webapp_install_error() {
  [[ $INT_MODE == true ]] || return
  webapp_install_prepare_result
  operation::result error
}

webapp_install_complete() {
  webapp_install_prepare_result
  operation::result success -- "Installation complete"
}

# Derive semicolon-separated keywords from a URL. Multi-label hosts contribute
# components longer than two characters; a one-label host contributes itself.
# The last path segment is split on space, hyphen, underscore, dot, and slash,
# then short and common stop-word tokens are removed before capitalization.
_auto_keywords_from_url() {
  local -n _akw_out=$1
  local url="$2"

  local host="${url#*://}"
  host="${host%%/*}"
  host="${host%%\?*}"
  host="${host%%#*}"
  host="${host#www.}"

  IFS='.' read -ra parts <<< "$host"

  local keywords=""
  local count="${#parts[@]}"

  if ((count < 2)); then
    local cap="${parts[0]^}"
    keywords="${cap};"
  else
    for ((i = 0; i < count - 1; i++)); do
      ((${#parts[$i]} > 2)) || continue
      local cap="${parts[$i]^}"
      keywords+="${cap};"
    done
  fi

  local _after_proto="${url#*://}"
  local path=""
  if [[ "$_after_proto" == */* ]]; then
    path="${_after_proto#*/}"
    path="${path%%\?*}"
    path="${path%%#*}"
  fi

  if [[ -z "$path" || "$path" == "/" ]]; then
    _akw_out="$keywords"
    return
  fi

  local last_segment="${path##*/}"

  if [[ -z "$last_segment" ]]; then
    path="${path%/}"
    last_segment="${path##*/}"
  fi

  last_segment="${last_segment//%20/ }"
  last_segment="${last_segment//%2D/-}"
  last_segment="${last_segment//%5F/_}"

  IFS=' -_./' read -ra words <<< "$last_segment"

  local -A stop_words=(
    [the]=1 [a]=1 [an]=1 [and]=1 [or]=1 [of]=1 [in]=1 [on]=1 [for]=1
    [with]=1 [to]=1 [from]=1 [by]=1 [at]=1 [as]=1 [is]=1 [are]=1
    [be]=1 [this]=1 [that]=1 [these]=1 [those]=1 [it]=1 [its]=1
    [but]=1 [not]=1
  )

  for word in "${words[@]}"; do
    [[ -z "$word" ]] || ((${#word} <= 2)) && continue
    local lower="${word,,}"
    [[ ${stop_words[$lower]} ]] && continue
    local capitalized="${word^}"
    keywords+="${capitalized};"
  done

  _akw_out="$keywords"
}

# Fetch with bounded time and redirects, then extract the title with sed. curl
# without --fail accepts HTTP error bodies; transport, timeout, redirect-limit,
# and URL errors return 1, while a successful fetch with no title yields no output.
_fetch_page_title() {
  local -n _fpt_out=$1
  local _fpt_url="$2"
  local _fpt_html _fpt_line _fpt_low _fpt_after _fpt_seg _fpt_raw _fpt_cap _fpt_tail
  local _fpt_in=false

  # Override curl's default user agent; challenge pages can still be returned
  # and are handled by the title checks below.
  local _fpt_ua='Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36'

  _fpt_out=""
  _fpt_html="$(curl -sL --max-time 10 --max-redirs 3 -A "$_fpt_ua" "$_fpt_url" 2> /dev/null)" || return 1

  # Collect from the first case-insensitive <title line through the first
  # case-sensitive </title>, mirroring the previous sed address range.
  _fpt_acc=""
  while IFS= read -r _fpt_line || [[ -n $_fpt_line ]]; do
    if ! $_fpt_in; then
      _fpt_low=${_fpt_line,,}
      [[ $_fpt_low == *'<title'* ]] || continue
      _fpt_in=true
      _fpt_acc=$_fpt_line
    else
      _fpt_acc+=$'\n'$_fpt_line
    fi
    [[ $_fpt_acc == *'</title>'* ]] && break
  done <<< "$_fpt_html"
  [[ -n $_fpt_acc ]] || return 0

  # Inner text between the tags with edge whitespace trimmed. Offsets map
  # one-to-one because tag matching only inspects ASCII characters.
  _fpt_low=${_fpt_acc,,}
  _fpt_after=${_fpt_low#*<title}
  _fpt_seg=${_fpt_acc:$((${#_fpt_low} - ${#_fpt_after}))}
  [[ $_fpt_seg == *'>'* ]] || return 0
  _fpt_seg=${_fpt_seg#*>}
  _fpt_raw=${_fpt_seg%%'<'*}
  _fpt_tail=${_fpt_seg:${#_fpt_raw}}
  _fpt_tail=${_fpt_tail#'<'}
  _fpt_tail=${_fpt_tail#"${_fpt_tail%%[![:space:]]*}"}
  [[ $_fpt_tail == '/title>'* ]] || return 0
  _fpt_cap=${_fpt_raw#"${_fpt_raw%%[![:space:]]*}"}
  _fpt_cap=${_fpt_cap%"${_fpt_cap##*[![:space:]]}"}
  _fpt_out=$_fpt_cap
  return 0
}

# Send HEAD with bounded time and redirects. Without --fail, any completed HTTP
# response succeeds; transport, timeout, and redirect-limit errors fail.
_check_url_reachable() {
  local url="$1"
  local urls=()

  if [[ ! $url =~ :// ]]; then
    urls=("https://$url" "http://$url")
  else
    [[ $url =~ ^https?:// ]] || return 1
    urls=("$url")
  fi

  for u in "${urls[@]}"; do
    curl -sLI --max-time 10 --max-redirs 3 "$u" &> /dev/null && return 0
  done

  return 1
}

# Generated entries match exact Exec= patterns. Native Chrome entries use a
# case-insensitive whole-file fixed-string search, so unrelated fields containing
# the URL can also match. Print the first path and return 0, or return 1.
_find_webapp_by_url() {
  local -n _fwb_out=$1
  local _fwb_url="$2"
  local _fwb_lc="${_fwb_url,,}"
  local f line exec_val _fwb_flc

  for f in "$XDG_DATA_HOME/applications"/'PWA - '*.desktop "$XDG_DATA_HOME/applications"/chrome-*.desktop; do
    [[ -f "$f" ]] || continue

    if [[ "$f" == */chrome-*.desktop ]]; then
      while IFS= read -r line || [[ -n $line ]]; do
        _fwb_flc=${line,,}
        if [[ $_fwb_flc == *"$_fwb_lc"* ]]; then
          _fwb_out="$f"
          return 0
        fi
      done < "$f"
      continue
    fi

    while IFS= read -r line; do
      [[ $line == Exec=* ]] || continue
      exec_val="${line#Exec=}"
      case "$exec_val" in
        "vb-launch-webapp $_fwb_url" | "vb-launch-webapp --own-profile $_fwb_url")
          _fwb_out="$f"
          return 0
          ;;
      esac
    done < "$f"
  done

  return 1
}

_normalize_url() {
  local -n _nu_out=$1
  local url="$2"

  # Remove trailing slashes only. Scheme-less input uses the first completed
  # HEAD response, preferring HTTPS; host case, ports, dots, queries, and
  # fragments remain part of duplicate identity.
  while [[ $url == */ ]]; do url="${url%/}"; done

  # Generic scheme detection preserves non-HTTP schemes, but the subsequent
  # reachability check accepts only HTTP(S) and rejects them.
  if [[ $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    _nu_out="$url"
    return
  fi

  if curl -sIL --max-time 5 "https://$url" > /dev/null 2>&1; then
    _nu_out="https://$url"
    return
  fi

  if curl -sIL --max-time 5 "http://$url" > /dev/null 2>&1; then
    _nu_out="http://$url"
    return
  fi

  _nu_out="https://$url"
}

_ask_for_icon() {
  local -n _afi_out=$1
  local _afi_ref
  term::prompt_line _afi_ref "${B}[*]${RS} Icon URL / path / name (or Enter for default): ${B}" || _afi_ref=""
  _afi_out="$_afi_ref"
}

_strip_title() {
  local -n _st_out=$1
  local s="$2"

  # Flatten line breaks and tabs, replace slash, collapse and trim spaces,
  # remove one leading dot, and use App for an empty result.
  s=${s//$'\n'/ }
  s=${s//$'\r'/ }
  s=${s//$'\t'/ }
  s=${s//\//-}

  while [[ $s == *"  "* ]]; do
    s=${s//"  "/" "}
  done

  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"

  [[ $s == .* ]] && s="${s#.}"
  [[ -z $s ]] && s="App"

  _st_out="$s"
}

# Return the themed fallback icon key.
_fallback_icon() {
  local -n _fbi_out=$1
  _fbi_out="web-browser"
}

# Resolve HTTP(S) icon URLs to ICON_DIR downloads, use a matching file under
# ICON_DIR, or pass other references through. Empty and failed URLs emit
# web-browser.
_resolve_icon() {
  local -n _ri_out=$1
  local _ri_ref="$2"
  local _ri_name="$3"

  if [[ -z $_ri_ref ]]; then
    _fallback_icon _ri_out
    return
  fi

  if [[ $_ri_ref =~ ^https?:// ]]; then
    # curl writes the final path directly. Failure short-circuits the size check
    # and can leave a partial file, which is neither selected nor cleaned here.
    local _ri_ext="${_ri_ref##*.}"
    [[ $_ri_ext =~ ^(png|jpg|jpeg|ico|svg)$ ]] || _ri_ext="png"
    local _ri_path="$ICON_DIR/$_ri_name.$_ri_ext"
    if curl -fsSL -o "$_ri_path" "$_ri_ref" 2> /dev/null && [[ -s $_ri_path ]]; then
      _ri_out="$_ri_path"
    else
      _fallback_icon _ri_out
    fi
    return
  fi

  if [[ -f "$ICON_DIR/$_ri_ref" ]]; then
    _ri_out="$ICON_DIR/$_ri_ref"
    return
  fi

  _ri_out="$_ri_ref"
}

_write_desktop() {
  local name="$1" exec_cmd="$2" icon="$3" keywords="$4" mime="$5" category="$6"
  local file="$XDG_DATA_HOME/applications/$name.desktop"

  # Shell redirection truncates the destination and streams the base heredoc
  # non-atomically; optional fields are appended later. Values are not escaped,
  # and Exec= percent sequences are emitted for the launcher parser to interpret.
  shcat > "$file" << EOF
[Desktop Entry]
Version=1.0
Name=${name#PWA - }
Comment=$name
Exec=$exec_cmd
TryExec=chromium
Terminal=false
Type=Application
Icon=$icon
StartupNotify=true
Categories=PWA;${category}
OnlyShowIn=Hyprland;
EOF

  # Optional fields are appended only when populated, avoiding empty MimeType
  # and Keywords keys with ambiguous desktop-entry semantics.
  if [[ -n $mime ]]; then
    printf 'MimeType=%s\n' "$mime" >> "$file"
  fi

  if [[ -n $keywords ]]; then
    printf 'Keywords=%s\n' "$keywords" >> "$file"
  fi

  log Info "Created PWA file: '$file'"
}

# Shared state and colors load after argument parsing, keeping help and option
# errors independent of the runtime environment.

source vb-lib-core

# Generated entries launch the site in Chromium's app mode, so the desktop file
# is inert without the binary. A custom --exec can replace the launcher, but the
# entry still has to be Chromium-backed to be a PWA at all.
if ! command -v chromium &> /dev/null; then
  if [[ $INT_MODE == true ]]; then
    term::show_header --color red
    vb::print "$R" "Chromium is not installed"
    vb::print "$R" "PWA entries run as Chromium app windows, so they cannot be created without it"
  else
    log Error "Chromium is not installed"
    log Error "PWA entries run as Chromium app windows, so they cannot be created without it"
  fi

  webapp_install_canceled
  exit 1
fi

if ! [[ -d "$ICON_DIR" ]]; then
  mkdir -p "$ICON_DIR"
fi

if [[ $INT_MODE == true ]]; then
  trap 'webapp_install_interrupt' INT
  term::show_header

  term::enable_input
  while true; do
    if ! term::prompt_line APP_URL "${Y}[*]${RS} PWA URL: ${B}"; then
      webapp_install_canceled
      exit 1
    fi

    if [[ -n $APP_URL ]]; then
      break
    fi
  done

  # Duplicate preflight uses HTTPS for scheme-less input without probing, so an
  # existing HTTP entry can survive both this check and the later name check.
  while [[ $APP_URL == */ ]]; do APP_URL="${APP_URL%/}"; done
  if [[ ! $APP_URL =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    CHECK_URL="https://$APP_URL"
  else
    CHECK_URL="$APP_URL"
  fi

  _url_ovw_ok=false
  if [[ $FORCE == true ]]; then
    _url_ovw_ok=true
  else
    _dup_file=""
    if _find_webapp_by_url _dup_file "$CHECK_URL"; then
      vb::print "$Y" "Duplicate found: ${B}${_dup_file##*/}${RS}"
      if term::ask_yes_no Y "This PWA is already installed. Overwrite it?"; then
        _url_ovw_ok=true
        if [[ "$_dup_file" == */chrome-*.desktop ]]; then
          _icon=""
          while IFS= read -r _line; do
            if [[ "$_line" == Icon=* ]]; then
              _icon="${_line#Icon=}"
              break
            fi
          done < "$_dup_file"
          # Native Chrome cleanup removes the prior entry prior to replacement
          # validation and deletes icons by basename across the tree, so a
          # later failure can also remove an icon shared by another entry.
          rm -f -- "$_dup_file"

          if [[ -n "$_icon" ]]; then
            find "$XDG_DATA_HOME/icons" -name "${_icon}.png" -delete 2> /dev/null
          fi
        fi
      else
        webapp_install_duplicate_canceled
        exit 1
      fi
    fi
  fi

  vb::print "$Y" "Probing URL availability..."
  _normalize_url APP_URL "$APP_URL"
  _check_url_reachable "$APP_URL" &

  if ! term::spinner $! "${Y}[*]${RS} Verifying URL"; then
    vb::print "$R" "Could not reach ${B}http(s)://${APP_URL#*://}${RS}"
    vb::print "$R" "Check the URL or your connection."
    webapp_install_error
    exit 1
  fi

  # The title spool uses a script-specific runtime path, so concurrent
  # interactive installs can overwrite or remove each other's title data.
  _fetch_page_title "$APP_URL" > "$VIBRANIUM_RUNTIME/$SELF.tmp" &
  if term::spinner $! "${Y}[*]${RS} Fetching page title"; then
    PAGE_TITLE=""
    IFS= read -r PAGE_TITLE < "$VIBRANIUM_RUNTIME/$SELF.tmp" || [[ -n $PAGE_TITLE ]]
  else
    PAGE_TITLE=""
  fi

  rm -f "$VIBRANIUM_RUNTIME/$SELF.tmp" &

  _strip_title PAGE_TITLE "$PAGE_TITLE"

  # Challenge pages can replace the requested title. Match their common title
  # prefixes or Cloudflare branding case-insensitively; nocasematch is
  # shell-global, and successful setup is cleared rather than restored.
  _title_chall=false
  if shopt -s nocasematch 2> /dev/null; then
    [[ $PAGE_TITLE =~ ^(Just a moment|Please Wait|Attention Required|Access Denied)|Cloudflare ]] &&
      _title_chall=true
    shopt -u nocasematch
  fi

  if [[ $_title_chall == true ]]; then
    vb::print "$R" "Page title could not be fetched (human verification detected)"
    vb::print "$R" "Enter the PWA name manually below"
    PAGE_TITLE=""
  fi

  term::enable_input
  if [[ -n $PAGE_TITLE && $PAGE_TITLE != "App" ]]; then
    vb::print "$Y" "Auto-generated name: ${B}${PAGE_TITLE}${RS}"
    if ! term::prompt_line APP_NAME "${B}[*]${RS} PWA name (Enter to keep the name above): "; then
      webapp_install_canceled
      exit 1
    fi
    APP_NAME="PWA - ${APP_NAME:-$PAGE_TITLE}"
  else
    while true; do
      if ! term::prompt_line APP_NAME "${Y}[*]${RS} PWA name: "; then
        webapp_install_canceled
        exit 1
      fi
      if [[ -n $APP_NAME ]]; then
        break
      fi
      vb::print "$R" "Name cannot be empty"
    done
    APP_NAME="PWA - $APP_NAME"
  fi

  if [[ $_url_ovw_ok == false && $FORCE == false && -f "$XDG_DATA_HOME/applications/$APP_NAME.desktop" ]]; then
    vb::print "$Y" "A PWA named ${B}${APP_NAME#PWA - }${RS} is already installed."
    if ! _prompt_overwrite; then
      webapp_install_canceled
      exit 1
    fi
  fi

  if term::ask_yes_no N "Launch this PWA in its own isolated browser profile?"; then
    OWN_PROFILE=true
  fi

  AUTO_KW=""
  _auto_keywords_from_url AUTO_KW "$APP_URL"

  if [[ -n "$AUTO_KW" ]]; then
    vb::print "$B" "Hint: keywords are special words that can be used as a search query in the app launcher"
    vb::print "$Y" "Auto-detected keywords: ${B}${AUTO_KW//;/ }${RS}"
    term::ask_yes_no Y "Would you like to keep auto-generated keywords?" || AUTO_KW=""
  fi

  term::enable_input
  term::prompt_line EXTRA_KW_RAW "${B}[*]${RS} Additional keywords (space-separated, or Enter to skip): $B" || EXTRA_KW_RAW=""
  term::disable_input

  EXTRA_KW=""
  # Prompt input is whitespace-tokenized, so shell-style quoting does not preserve
  # grouped keyword tokens; each token becomes one semicolon-terminated keyword.
  for kw in $EXTRA_KW_RAW; do EXTRA_KW+="${kw};"; done
  KEYWORDS="${AUTO_KW}${EXTRA_KW}"

  term::enable_input
  term::prompt_line CATEGORY "${B}[*]${RS} Category (e.g. Network;WebBrowser, or Enter to skip): ${B}" || CATEGORY=""
  term::disable_input

  # APP_URL is interpolated into the favicon query without URL encoding. curl
  # writes the final PNG directly, so failure can leave a partial artifact.
  FAVICON_URL="https://www.google.com/s2/favicons?domain=${APP_URL}&sz=128"
  if term::ask_yes_no Y "Would you like to keep the web page's original icon?"; then
    curl -fsSL -o "$ICON_DIR/$APP_NAME.png" "$FAVICON_URL" 2> /dev/null &
    if term::spinner $! "${Y}[*]${RS} Downloading favicon of the URL" && [[ -s "$ICON_DIR/$APP_NAME.png" ]]; then
      ICON_REF="$APP_NAME.png"
    else
      vb::print "$R" "Could not fetch favicon automatically. Enter a PNG icon URL manually"
      vb::print "$R" "See ${B}https://dashboardicons.com${RS} for a large library"
      term::enable_input
      _ask_for_icon ICON_REF
      term::disable_input
    fi
  else
    term::enable_input
    _ask_for_icon ICON_REF
    term::disable_input
  fi

  _resolve_icon ICON_PATH "$ICON_REF" "$APP_NAME"

  # Interactive mode always constructs vb-launch-webapp; CUSTOM_EXEC is
  # consulted only in the CLI branch. OWN_PROFILE selects the --own-profile
  # launcher flag, while vb-launch-webapp owns browser data-directory persistence.
  if [[ $OWN_PROFILE == true ]]; then
    EXEC_COMMAND="vb-launch-webapp --own-profile $APP_URL"
  else
    EXEC_COMMAND="vb-launch-webapp $APP_URL"
  fi

else
  log Info "Using CLI mode"

  _normalize_url APP_URL "$APP_URL"

  log Info "Using URL: '$APP_URL'"

  log Info "Checking for duplicates"
  dup_file=""
  if _find_webapp_by_url dup_file "$APP_URL"; then
    log Info "Duplicate found: ${dup_file##*/}"
    if [[ $FORCE == false ]]; then
      log Error "Already installed for '$APP_URL', exiting"
      log Error "Use --force to mitigate this"
      exit 1
    fi

    # --force suppresses refusal for generated entries too, but only native Chrome
    # matches are removed here. A generated duplicate at another path remains.
    log Info "Found duplicate. --force is being used, ignoring"
    if [[ "$dup_file" == */chrome-*.desktop ]]; then
      _icon=""
      while IFS= read -r _line; do
        [[ "$_line" == Icon=* ]] && {
          _icon="${_line#Icon=}"
          break
        }
      done < "$dup_file"
      # As in interactive mode, native cleanup removes the prior entry prior to
      # replacement validation and deletes icons by basename, so a later failure
      # can remove an icon shared by another entry.
      rm -f -- "$dup_file"
      [[ -n "$_icon" ]] && find "$XDG_DATA_HOME/icons" -name "${_icon}.png" -delete 2> /dev/null
    fi
  else
    log Info "No duplicates found"
  fi

  log Info "Checking URL availability"
  if ! _check_url_reachable "$APP_URL"; then
    log Error "Could not reach $APP_URL"
    exit 1
  fi

  log Info "URL '$APP_URL' is available"

  if [[ -z $APP_NAME ]]; then
    log Info "No --name provided; trying to fetch by URL title"
    if _fetch_page_title APP_NAME "$APP_URL"; then
      log Info "Fetched page title: '$APP_NAME'"
    else
      log Warn "Failed to fetch URL title"
    fi
  fi

  _strip_title APP_NAME "$APP_NAME"
  [[ -z $APP_NAME || $APP_NAME == "App" ]] && exit 1

  [[ $APP_NAME != "PWA - "* ]] && APP_NAME="PWA - $APP_NAME"

  [[ $FORCE == false && -f "$XDG_DATA_HOME/applications/$APP_NAME.desktop" ]] && {
    log Error "Desktop file exists for $APP_NAME, exiting"
    exit 1
  }

  log Info "Generating keywords"
  AUTO_KW=""
  _auto_keywords_from_url AUTO_KW "$APP_URL"

  KEYWORDS="${AUTO_KW}${EXTRA_KW}"
  log Info "Desktop entry keywords: '$KEYWORDS'"

  _resolve_icon ICON_PATH "$ICON_REF" "$APP_NAME"
  log Info "Desktop entry icon: '$ICON_PATH'"

  if [[ -n $CUSTOM_EXEC ]]; then
    log Info "Using provided --exec: '$CUSTOM_EXEC'"
    EXEC_COMMAND="$CUSTOM_EXEC"
  elif [[ $OWN_PROFILE == true ]]; then
    log Info "Using isolated profile"
    EXEC_COMMAND="vb-launch-webapp --own-profile $APP_URL"
  else
    EXEC_COMMAND="vb-launch-webapp $APP_URL"
  fi
fi

log Info "Full exec command: '$EXEC_COMMAND'"

log Info "Writing desktop entry: '${APP_NAME}.desktop'"
_write_desktop "$APP_NAME" "$EXEC_COMMAND" "$ICON_PATH" "$KEYWORDS" "$MIME_TYPES" "$CATEGORY"

if [[ $INT_MODE == true ]]; then
  vb::print "$G" "${B}${APP_NAME#PWA - }${RS} has been installed"
  vb::print "$G" "You can find it in the app launcher"
  webapp_install_complete
  exit 0
fi
