#!/usr/bin/env bash

source vb-lib-core

ICON_DIR="$HOME/.local/share/applications/icons"

# ---------------------------------------------------------------------------
# Flags populated by argument parsing below. All default to empty; interactive
# mode fills them via prompts, non-interactive mode via --flags.
# ---------------------------------------------------------------------------

APP_URL=""
APP_NAME=""
ICON_REF=""
CUSTOM_EXEC=""
MIME_TYPES=""
EXTRA_KEYWORDS=""
CATEGORY=""
INTERACTIVE_MODE=false

_usage() {
  cat <<EOF
Usage: ${0##*/} [OPTION]...

Install a Progressive Web App shortcut as a .desktop launcher entry.

Options:
  --url URL           Web app URL to install
  --name NAME         App display name (default: fetched from page <title>)
  --icon REF          Icon URL or filename inside the icons directory
  --exec CMD          Custom Exec= value (default: vb-webapp-launch URL)
  --mime-types TYPES  MimeType= value for the .desktop file
  --keywords KW       Extra keywords, semicolon-separated (appended to auto-generated ones)
  --category CAT      Categories= value for the .desktop file (e.g. Network;WebBrowser)
  -h, --help          Show this help and exit

If --url is not provided, the script runs in interactive mode and prompts
for all required fields. In non-interactive mode (--url given), a missing
--name is resolved automatically by fetching the page <title>.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    _usage
    exit 0
    ;;
  --url)
    [[ $# -ge 2 ]] || {
      echo "Missing value for $1" >&2
      exit 1
    }
    APP_URL="$2"
    shift 2
    ;;
  --name)
    [[ $# -ge 2 ]] || {
      echo "Missing value for $1" >&2
      exit 1
    }
    APP_NAME="$2"
    shift 2
    ;;
  --icon)
    [[ $# -ge 2 ]] || {
      echo "Missing value for $1" >&2
      exit 1
    }
    ICON_REF="$2"
    shift 2
    ;;
  --exec)
    [[ $# -ge 2 ]] || {
      echo "Missing value for $1" >&2
      exit 1
    }
    CUSTOM_EXEC="$2"
    shift 2
    ;;
  --mime-types)
    [[ $# -ge 2 ]] || {
      echo "Missing value for $1" >&2
      exit 1
    }
    MIME_TYPES="$2"
    shift 2
    ;;
  --keywords)
    [[ $# -ge 2 ]] || {
      echo "Missing value for $1" >&2
      exit 1
    }
    EXTRA_KEYWORDS="$2"
    shift 2
    ;;
  --category)
    [[ $# -ge 2 ]] || {
      echo "Missing value for $1" >&2
      exit 1
    }
    CATEGORY="$2"
    shift 2
    ;;
  --)
    shift
    break
    ;;
  --* | -*)
    echo "Unknown option: $1" >&2
    exit 1
    ;;
  *)
    echo "Unexpected argument: '$1'. Use flags to pass values." >&2
    exit 1
    ;;
  esac
done

_operation_complete() {
  term::disable_input

  printf "%s[VIBRANIUM]%s " "$GREEN" "$RESET"
  read -n1 -r -p $'Installation complete. Press any key to exit ' dummy

  term::enable_input
}

_operation_canceled() {
  # The blocking read is only appropriate in interactive mode. In non-interactive
  # mode all output is already suppressed, so there is nothing to wait on.
  [[ $INTERACTIVE_MODE == true ]] || return

  term::disable_input

  printf "%s[VIBRANIUM]%s Operation canceled" "$RED" "$RESET"
  read -n1 -r -s -p $'. Press any key to exit' dummy

  term::enable_input
}

# ---------------------------------------------------------------------------
# Derive auto-keywords from a URL.
# Strips the protocol and www., splits the hostname on dots, drops the TLD
# (last component), capitalizes each part, and emits them joined by semicolons.
# Additionally extracts the last path segment, splits it on -, _, ., and spaces,
# skips common English stop words (the, to, a, an, etc.), capitalizes the
# remaining words, and appends them.
# Example: https://www.nasa.gov/gallery/journey-to-the-moon/ -> "Nasa;Journey;Moon;"
# ---------------------------------------------------------------------------
_auto_keywords_from_url() {
  local url="$1"

  local host="${url#*://}" # remove protocol
  host="${host%%/*}"       # remove path
  host="${host%%\?*}"      # remove query
  host="${host%%#*}"       # remove fragment
  host="${host#www.}"      # strip www.

  IFS='.' read -ra parts <<<"$host"

  local keywords=""
  local count="${#parts[@]}"

  if ((count < 2)); then
    # Single component
    local cap="${parts[0]^}"
    keywords="${cap};"
  else
    # All parts except the last (TLD)
    for ((i = 0; i < count - 1; i++)); do
      # Skip parts that are too short (e.g. "co" in .co.uk)
      ((${#parts[$i]} > 2)) || continue
      local cap="${parts[$i]^}"
      keywords+="${cap};"
    done
  fi

  # Extract the path portion, but only when a '/' actually follows the host.
  # Without this guard, a domain-only URL like "https://example.com" leaves
  # path="example.com" after the protocol strip, causing the TLD to be split
  # out as a keyword in the segment loop below.
  local _after_proto="${url#*://}"
  local path=""
  if [[ "$_after_proto" == */* ]]; then
    path="${_after_proto#*/}" # remove host
    path="${path%%\?*}"       # remove query string
    path="${path%%#*}"        # remove fragment
  fi

  if [[ -z "$path" || "$path" == "/" ]]; then
    echo "$keywords"
    return
  fi

  # Extract ONLY the very last segment after the final '/'
  local last_segment="${path##*/}"

  # If the URL ends with '/', last_segment will be empty -> fall back to previous segment
  if [[ -z "$last_segment" ]]; then
    # Remove trailing / and take the new last segment
    path="${path%/}"
    last_segment="${path##*/}"
  fi

  # Basic URL decoding for common cases
  last_segment="${last_segment//%20/ }"
  last_segment="${last_segment//%2D/-}"
  last_segment="${last_segment//%5F/_}"

  # Split on -, _, ., / and spaces
  IFS=' -_./' read -ra words <<<"$last_segment"

  # Common stop words (lowercase)
  local -A stop_words=(
    [the]=1 [a]=1 [an]=1 [and]=1 [or]=1 [of]=1 [in]=1 [on]=1 [for]=1
    [with]=1 [to]=1 [from]=1 [by]=1 [at]=1 [as]=1 [is]=1 [are]=1
    [be]=1 [this]=1 [that]=1 [these]=1 [those]=1 [it]=1 [its]=1
    [but]=1 [not]=1
  )

  for word in "${words[@]}"; do
    [[ -z "$word" || ${#word} -le 2 ]] && continue

    local lower="${word,,}"
    [[ ${stop_words[$lower]} ]] && continue

    # Capitalize first letter
    local capitalized="${word^}"
    keywords+="${capitalized};"
  done

  printf '%s' "$keywords"
}

# ---------------------------------------------------------------------------
# Fetch the HTML of a URL and extract the content of the <title> tag.
# Prints the title (stripped of leading/trailing whitespace) on stdout.
# Returns 0 on any HTTP response, 1 if curl could not connect at all.
# The -f flag is intentionally omitted so that error pages (4xx/5xx) still
# return a body; we only want to detect network-level failures here.
# ---------------------------------------------------------------------------
_fetch_page_title() {
  local url="$1"
  local html
  html="$(curl -sL --max-time 10 --max-redirs 3 "$url" 2>/dev/null)" || return 1

  printf '%s\n' "$html" |
    sed -n '/<title/I{
      :a
      /<\/title>/!{N; ba}
      s/.*<title[^>]*>[[:space:]]*\([^<]*\)[[:space:]]*<\/title>.*/\1/ip
      q
    }'
}

# ---------------------------------------------------------------------------
# Check that a URL is reachable by sending an HTTP HEAD request.
# Uses a 10-second timeout and follows up to 3 redirects.
# Returns 0 if the server responds with any HTTP status, 1 otherwise.
# ---------------------------------------------------------------------------
_check_url_reachable() {
  local url="$1"
  local urls=()

  if [[ ! $url =~ :// ]]; then
    urls=("https://$url" "http://$url")
  else
    [[ $url =~ ^https?:// ]] || return 1
    urls=("$url")
  fi

  for u in "${urls[@]}"; do
    curl -sLI --max-time 10 --max-redirs 3 "$u" &>/dev/null && return 0
  done

  return 1
}

# ---------------------------------------------------------------------------
# Scan all installed .desktop files for one whose Exec= line was written by
# this tool for the given URL. Prints the matching file path and returns 0
# if found, returns 1 otherwise.
# ---------------------------------------------------------------------------
_find_webapp_by_url() {
  local url="$1"
  local dir="$HOME/.local/share/applications"
  local f line

  for f in "$dir/PWA - "*.desktop; do
    [[ -f "$f" ]] || continue

    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line == "Exec=vb-webapp-launch $url" ]]; then
        echo "$f"
        return 0
      fi
      [[ $line == '['*']' ]] && [[ $line != '[Desktop Entry]' ]] && break
    done <"$f"
  done

  return 1
}

_normalize_url() {
  local url="$1"

  # Already has scheme -> leave as is
  if [[ $url =~ ^[a-zA-Z][a-zA-Z0-9+.-]*: ]]; then
    printf '%s\n' "$url"
    return
  fi

  # Try https first
  if curl -sIL --max-time 5 "https://$url" >/dev/null 2>&1; then
    printf 'https://%s\n' "$url"
    return
  fi

  # Fallback to http
  if curl -sIL --max-time 5 "http://$url" >/dev/null 2>&1; then
    printf 'http://%s\n' "$url"
    return
  fi

  printf 'https://%s' "$url"
}

_ask_for_icon() {
  local ref

  read -rp "${BLUE}[VIBRANIUM]${RESET} Icon URL / path / name (or Enter for default): ${BLUE}" ref
  [[ -z $ref ]] && ref="webbrowser-app"
  printf "%s" "$ref"
}

_strip_title() {
  local s="$1"

  # Remove newlines and tabs (most annoying cases)
  s=${s//$'\n'/ }
  s=${s//$'\r'/ }
  s=${s//$'\t'/ }

  # Replace slash (only truly illegal char)
  s=${s//\//-}

  # Collapse double spaces (cheap pass)
  while [[ $s == *"  "* ]]; do
    s=${s//"  "/" "}
  done

  # Trim leading/trailing spaces
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"

  # Prevent hidden files
  [[ $s == .* ]] && s="${s#.}"

  # Fallback
  [[ -z $s ]] && s="App"

  printf '%s\n' "$s"
}

# ---------------------------------------------------------------------------
# Main logic
# ---------------------------------------------------------------------------

if [[ -z $APP_URL ]]; then
  # Interactive mode: --url was not supplied, prompt for everything.

  INTERACTIVE_MODE=true
  trap "printf '\n';_operation_canceled; exit 1" INT
  term::show_header

  # Ask for the URL first so we can pull a suggested name from it.
  while true; do
    term::enable_input
    read -rp "${YELLOW}[VIBRANIUM]${RESET} PWA URL: ${BLUE}" APP_URL
    term::disable_input
    if [[ -n $APP_URL ]]; then
      break
    fi
  done

  APP_URL="$(_normalize_url "$APP_URL")"

  # Check for an existing installation with this URL before spending time on
  # reachability or title fetching. Set a flag on confirmation so the name
  # check below does not prompt again for the same collision.
  _url_overwrite_confirmed=false
  if _dup_file="$(_find_webapp_by_url "$APP_URL")"; then
    _dup_file="${_dup_file##*/}"
    if term::ask_yes_no Y "This PWA is already installed. Overwrite it?"; then
      _url_overwrite_confirmed=true
    else
      _operation_canceled
      exit 1
    fi
  fi

  # Verify reachability before doing anything else.
  _check_url_reachable "$APP_URL" &
  if ! term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Verifying URL"; then
    echo "${RED}[VIBRANIUM]${RESET} Could not reach ${BLUE}http(s)://${APP_URL#*://}${RESET}"
    echo "${RED}[VIBRANIUM]${RESET} Check the URL or your connection."
    _operation_canceled
    exit 1
  fi

  tmpfile=$(mktemp)
  _fetch_page_title "$APP_URL" >"$tmpfile" &

  if term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Fetching page title"; then
    PAGE_TITLE=$(<"$tmpfile")
  else
    echo "${RED}[VIBRANIUM]${RESET} Failed to fetch page title"
    PAGE_TITLE=""
  fi

  rm -f "$tmpfile"

  # Check if the page title contains illegal characters.
  # If so - fix them.
  case "$PAGE_TITLE" in
  *$'\n'* | *$'\r'* | *$'\t'* | */* | " "* | *" ")
    PAGE_TITLE=$(_strip_title "$PAGE_TITLE")
    ;;
  esac

  term::enable_input

  if [[ -n $PAGE_TITLE ]]; then
    echo "${YELLOW}[VIBRANIUM]${RESET} Auto-generated name: ${BLUE}${PAGE_TITLE}${RESET}"
    # Show the suggested name; accept on Enter, or type to override.
    read -rp "${BLUE}[VIBRANIUM]${RESET} PWA name (Enter to keep the name above): $BLUE" APP_NAME
    APP_NAME="PWA - ${APP_NAME:-$PAGE_TITLE}"
  else
    # No title found; require explicit input.
    while true; do
      read -rp "${YELLOW}[VIBRANIUM]${RESET} PWA name: " APP_NAME

      # Got name - exit loop
      if [[ -n $APP_NAME ]]; then
        break
      fi

      echo "${RED}[VIBRANIUM]${RESET} Name cannot be empty"
    done
  fi

  term::disable_input

  # Check for a name collision only if the URL check did not already confirm
  # an overwrite (which would target the same .desktop file in the normal case).
  if [[ $_url_overwrite_confirmed == "false" &&
    -f "$HOME/.local/share/applications/$APP_NAME.desktop" ]]; then
    echo "${YELLOW}[VIBRANIUM]${RESET} A PWA named ${BLUE}${APP_NAME/PWA - /}${RESET} is already installed."
    if ! _prompt_overwrite; then
      _operation_canceled
      exit 1
    fi
  fi

  # Auto-generate keywords from the URL and let the user add more.
  AUTO_KEYWORDS="$(_auto_keywords_from_url "$APP_URL")"

  echo "${BLUE}[VIBRANIUM]${RESET} Hint: keywords are special words that can be used as a search query in the app launcher"
  echo "${YELLOW}[VIBRANIUM]${RESET} Auto-detected keywords: ${BLUE}${AUTO_KEYWORDS//;/ }${RESET}"

  if ! term::ask_yes_no Y "Would you like to keep auto-generated keywords?"; then
    AUTO_KEYWORDS=""
  fi

  term::enable_input
  read -rp "${BLUE}[VIBRANIUM]${RESET} Additional keywords (space-separated, or Enter to skip): $BLUE" EXTRA_KW_RAW
  term::disable_input

  # Convert the user's space-separated extras into semicolon-separated form.
  EXTRA_KEYWORDS=""
  if [[ -n $EXTRA_KW_RAW ]]; then
    for kw in $EXTRA_KW_RAW; do
      EXTRA_KEYWORDS+="${kw};"
    done
  fi
  KEYWORDS="${AUTO_KEYWORDS}${EXTRA_KEYWORDS}"

  # Prompt for an optional .desktop Categories= value.
  # Standard categories: https://specifications.freedesktop.org/menu-spec/latest/category-registry.html
  term::enable_input
  read -rp "${BLUE}[VIBRANIUM]${RESET} Category (e.g. Network;WebBrowser, or Enter to skip): ${BLUE}" CATEGORY
  term::disable_input

  mkdir -p "$ICON_DIR"

  # Try to fetch the favicon from Google's service; fall back to manual input.
  FAVICON_URL="https://www.google.com/s2/favicons?domain=${APP_URL}&sz=128"

  if term::ask_yes_no Y "Would you like to keep the web page's original icon?"; then
    curl -fsSL -o "$ICON_DIR/$APP_NAME.png" "$FAVICON_URL" 2>/dev/null &

    if term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Downloading favicon of the URL" && [[ -s "$ICON_DIR/$APP_NAME.png" ]]; then
      ICON_REF="$APP_NAME.png"
    else
      echo "${RED}[VIBRANIUM]${RESET} Could not fetch favicon automatically. Enter a PNG icon URL manually"
      echo "${RED}[VIBRANIUM]${RESET} See ${BLUE}https://dashboardicons.com${RESET} for a large library"
      ICON_REF="$(_ask_for_icon)"
    fi
  else
    ICON_REF="$(_ask_for_icon)"
  fi

  CUSTOM_EXEC=""
  MIME_TYPES=""
else
  # Non-interactive mode: --url was supplied. Suppress all output.
  exec >/dev/null 2>&1

  APP_URL="$(_normalize_url "$APP_URL")"

  # Abort early on URL collision before touching the network.
  if _dup_file="$(_find_webapp_by_url "$APP_URL")"; then
    echo "${RED}[VIBRANIUM]${RESET} A PWA for this URL is already installed (${BLUE}${_dup_file##*/}${RESET})"
    _operation_canceled
    exit 1
  fi

  if ! _check_url_reachable "$APP_URL"; then
    echo "${RED}[VIBRANIUM]${RESET} Could not reach given URL"
    echo "${RED}[VIBRANIUM]${RESET} Please verify that URL exists or check your connection"
    _operation_canceled
    exit 1
  fi

  # If no name was supplied via --name, attempt to pull it from the page title.
  if [[ -z $APP_NAME ]]; then
    APP_NAME="$(_fetch_page_title "$APP_URL")" || true
  fi

  # Abort on name collision once APP_NAME is known.
  if [[ -f "$HOME/.local/share/applications/$APP_NAME.desktop" ]]; then
    echo "${RED}[VIBRANIUM]${RESET} A PWA named ${BLUE}$APP_NAME${RESET} is already installed"
    _operation_canceled
    exit 1
  fi

  AUTO_KEYWORDS="$(_auto_keywords_from_url "$APP_URL")"
  KEYWORDS="${AUTO_KEYWORDS}${EXTRA_KEYWORDS}"

fi

if [[ -z $APP_NAME || -z $APP_URL ]]; then
  echo "${RED}[VIBRANIUM]${RESET} Could not determine app name. Pass it via --name."
  _operation_canceled
  exit 1
fi

mkdir -p "$ICON_DIR"

# Resolve ICON_REF to a local path, downloading if it is a URL.
if [[ $ICON_REF =~ ^https?:// ]]; then
  # Preserve the file extension from the URL if recognisable, else default png.
  local_ext="${ICON_REF##*.}"
  [[ $local_ext =~ ^(png|jpg|jpeg|ico)$ ]] || local_ext="png"

  ICON_PATH="$ICON_DIR/$APP_NAME.$local_ext"

  if ! curl -fsSL -o "$ICON_PATH" "$ICON_REF" 2>/dev/null || [[ ! -s $ICON_PATH ]]; then
    # Use a generic system icon as fallback rather than aborting the install.
    echo "${RED}[VIBRANIUM]${RESET} Could not fetch givenURL. Using fallback icon"
    ICON_PATH="webbrowser-app"
  fi
else
  # Treat as a filename relative to ICON_DIR (non-interactive shorthand).
  if [[ -f "$ICON_DIR/$ICON_REF" ]]; then
    ICON_PATH="$ICON_DIR/$ICON_REF"
  else
    # Assume that icon lives in XDG-respected icon pack
    ICON_PATH="$ICON_REF"
  fi
fi

EXEC_COMMAND="${CUSTOM_EXEC:-vb-webapp-launch $APP_URL}"
DESKTOP_FILE="$HOME/.local/share/applications/$APP_NAME.desktop"

cat >"$DESKTOP_FILE" <<EOF
[Desktop Entry]
Version=1.0
Name=${APP_NAME/PWA - /}
Comment=$APP_NAME
Exec=$EXEC_COMMAND
Terminal=false
Type=Application
Icon=$ICON_PATH
StartupNotify=true
Categories=PWA;${CATEGORY}
EOF

if [[ -n $MIME_TYPES ]]; then
  echo "MimeType=$MIME_TYPES" >>"$DESKTOP_FILE"
fi

if [[ -n $KEYWORDS ]]; then
  echo "Keywords=$KEYWORDS" >>"$DESKTOP_FILE"
fi

if [[ $INTERACTIVE_MODE == "true" ]]; then
  echo "${GREEN}[VIBRANIUM]${RESET} ${BLUE}${APP_NAME/PWA - /}${RESET} has been installed"
  echo "${GREEN}[VIBRANIUM]${RESET} You can find it in the app launcher"
  _operation_complete
fi
