#!/usr/bin/env bash

source "$XDG_CONFIG_HOME/vibranium/theme/current/vibranium-lib-theme"

_set_city() {
    local opt city

    opt="VIBRANIUM_BAR_WEATHER_MODULE_CITY"

    # Wait for the internet connection
    while ! curl -s --max-time 5 -I --fail https://clients3.google.com/generate_204 > /dev/null; do
        sleep 1
    done

    city="$(curl -s --max-time 5 http://ip-api.com/json | jq -r '.city')"

    "$VIBRANIUM_PATH"/configure/option-validate "$opt"
    sed -i "s|^${opt}=.*|${opt}=\"${city}\"|" \
        "$XDG_CONFIG_HOME/vibranium/settings"
}

_get_power_profile() {
    local battery_status

    if [[ "$VIBRANIUM_IS_LAPTOP" == false ]]; then
        echo "performance"
    else
        battery_status=$(< /sys/class/power_supply/BAT0/status)

        if [[ "$battery_status" == "Charging" ]]; then
            echo "performance"
        else
            echo "balanced"
        fi
    fi
}

msg+="\nPress <span foreground='${P_YELLOW}'><b>SUPER + A</b></span>      to open app launcher\n"
msg+="Press <span foreground='${P_YELLOW}'><b>CTRL + ALT + V</b></span> to open Vibranium menu\n"
msg+="<b>Right-click</b> to dismiss this notification"
notify-send -r 1 -t 1800000 "Welcome to Vibranium" "$msg"

if [[ "$VIBRANIUM_IS_VIRTUAL_MACHINE" == true ]]; then
    msg="\n<span foreground='${P_YELLOW}'><b><i>You need to be aware of certain things</i></b></span>:\n\n"
    msg+="<span foreground='${P_ACCENT}'><b>•</b></span> "
    msg+="<span foreground='${P_RED}'><b>Screen recording is not available</b></span>\n"
    msg+="  <span foreground='${P_ACCENT}'><b>•</b></span> "
    msg+="<i>If you still want this feature, please create an MR</i>\n"
    msg+="<span foreground='${P_ACCENT}'><b>•</b></span> "
    msg+="<span foreground='${P_RED}'><b>Do not expect power profiles to work as expected</b></span>\n"
    msg+="<span foreground='${P_ACCENT}'><b>•</b></span> "
    msg+="<span foreground='${P_RED}'><b>Some effects will not work due to the nature of the virtual GPU</b></span>\n"
    msg+="<span foreground='${P_ACCENT}'><b>•</b></span> "
    msg+="<span foreground='${P_RED}'><b>Overall performance will be worse than on real hardware</b></span>\n\n"
    msg+="Use <span foreground='${P_YELLOW}'><b>Vibranium</b></span> on a virtual machine for informational purposes only.\n"
    msg+="Many things have not been tested, so there may be unexpected surprises.\n"
    msg+="Only <span foreground='${P_YELLOW}'><b>QEMU</b></span> has been tested; "
    msg+="<span foreground='${P_YELLOW}'><b>Virtualbox</b></span> & "
    msg+="<span foreground='${P_YELLOW}'><b>VMware</b></span> are not supported.\n\n"
    msg+="<b>Right-click</b> to dismiss this notification"
    notify-send -r 2 -t 1800000 "Vibranium Is Running On a Virtual Machine" "$msg"
fi

chromium --no-startup-window --set-theme-color="25, 35, 48" &
vibranium-core-power-profile-set "$(_get_power_profile)"

_set_city
rm "$VIBRANIUM_STATE/first-boot"
