#!/usr/bin/env bash

_usage() {
  cat <<EOF
Usage: ${0##*/} [OPTION]

Options:
  --show      Show clipboard history
  --clear     Clear clipboard history
  -h, --help  Show this help and exit
EOF
}

_show() {
  source vb-lib-core

  local chosen
  helpers::ui::menu chosen "Clipboard" "search..." -display-columns 2 -- "${ENTRIES[@]}"

  if [[ ! -z "$chosen" ]]; then
    if [[ "$chosen" =~ ^file:// ]]; then
      printf "%s" "$chosen" | cliphist decode | wl-copy -n --type text/uri-list
    else
      printf "%s" "$chosen" | cliphist decode | wl-copy -n
    fi
  fi
}

_clear() {
  # if it's open
  # at the moment
  # of invocation
  killall -q rofi

  cliphist wipe
  wl-copy --clear
}

_ensure_service() {
  if ! systemctl -q --user is-active cliphist; then
    systemctl -q --user enable --now cliphist
  fi
}

_ensure_deps() {
  if ! missing="$(vb-cmd-is-present rofi cliphist)"; then
    [[ -t 1 ]] && vb-cmd-dep-notify --name "Clipboard Manager" --deps "$missing"
    exit 1
  fi
}

case "$1" in
"--show")
  _ensure_deps
  _ensure_service

  ENTRIES=()
  mapfile -t ENTRIES < <(cliphist list)

  if ((${#ENTRIES[@]} == 0)); then
    notify-send -t 1000 -r 3 "Clipboard Manager" "<i>Clipboard is empty!</i>"
    exit 1
  fi

  _show
  ;;
"--clear")
  _ensure_service
  _clear
  ;;
"-h" | "--help" | "")
  _usage
  exit 0
  ;;
*)
  _usage
  exit 1
  ;;
esac
