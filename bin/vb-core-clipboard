#!/bin/bash

VERBOSE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Options:
  --show      Show clipboard history
  --clear     Clear clipboard history
  -v, --verbose Enable verbose output
  -h, --help  Show this help and exit
EOF
}

_check_deps() {
  log Info "Checking deps: cliphist rofi"
  local missing=()
  local deps=(cliphist rofi)

  for d in "${deps[@]}"; do
    if ! command -v "$d" > /dev/null; then
      missing+=("$d")
    fi
  done

  if ((${#missing[@]} > 0)); then
    log Info "Missing deps: ${missing[*]}"
    vb-cmd-dep-notify \
      --name "Clipboard Manager" \
      --deps "${missing[*]}"
    return 1
  fi
  log Info "All deps available"
}

MODE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    --show)
      MODE="show"
      log Info "Mode: show"
      shift
      ;;
    --clear)
      MODE="clear"
      log Info "Mode: clear"
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log Error "unknown option: $*"
      log Error "Try '${0##*/} --help' for more information"
      exit 1
      ;;
  esac
done

case "$MODE" in
  show)
    log Info "Entering show mode"

    if pidof -q rofi; then
      log Info "Existing rofi found, toggling off"
      killall rofi
      log Info "Rofi killed, exiting show mode"
      exit 0
    fi

    if ! _check_deps; then
      exit 1
    fi

    log Info "Checking cliphist service"
    if ! systemctl -q --user is-active cliphist.service; then
      log Info "cliphist.service inactive, starting"
      systemctl -q --user enable --now cliphist.service
      log Info "cliphist.service started"
    fi

    source vb-lib-core

    ENTRIES=()
    mapfile -t ENTRIES < <(cliphist list)
    log Info "Clipboard entries: ${#ENTRIES[@]}"

    if ((${#ENTRIES[@]} == 0)); then
      log Info "Clipboard empty"
      notify-send -t 1000 -r 3 \
        "Clipboard Manager" \
        "<i>Clipboard is empty!</i>"
      log Info "Empty clipboard notification sent"
      exit 1
    fi

    log Info "Opening rofi menu with ${#ENTRIES[@]} entries"
    helpers::ui::menu chosen "Clipboard" "search..." \
      -display-columns 2 -- "${ENTRIES[@]}"
    log Info "User selection received: ${chosen:-(none)}"

    if [[ -n "$chosen" ]]; then
      log Info "Selected: $chosen"
      if [[ "$chosen" =~ file:// ]]; then
        log Info "Copying as text/uri-list"
        printf "%s" "$chosen" | cliphist decode | wl-copy -n --type text/uri-list
        log Info "URI copy exit code: $?"
      else
        log Info "Copying as plain text"
        printf "%s" "$chosen" | cliphist decode | wl-copy -n
        log Info "Text copy exit code: $?"
      fi
    else
      log Info "No selection made"
    fi
    ;;
  clear)
    log Info "Entering clear mode"

    if ! _check_deps; then
      exit 1
    fi

    log Info "Checking cliphist service"
    if ! systemctl -q --user is-active cliphist.service; then
      log Info "cliphist.service inactive, starting"
      systemctl -q --user enable --now cliphist.service
      log Info "Service enabled for clear, exit code: $?"
      exit 0
    fi

    log Info "Clearing: rofi, wl-copy, cliphist"
    killall -q rofi
    log Info "Rofi killed for clear"
    wl-copy --clear
    log Info "wl-copy clear exit: $?"
    cliphist wipe
    log Info "cliphist wipe exit: $?"
    ;;
  *)
    usage
    exit 0
    ;;
esac
