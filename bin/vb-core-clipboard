#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ "$level" == "Error" ]] || ($VERBOSE && [[ -t 0 ]]); then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Options:
  --show      Show clipboard history
  --clear     Clear clipboard history
  -v, --verbose Enable verbose output
  -h, --help  Show this help and exit
EOF
}

_check_deps() {
  local missing=()
  local deps=(cliphist rofi)

  for d in "${deps[@]}"; do
    if ! command -v "$d" >/dev/null; then
      missing+=("$d")
    fi
  done

  if ((${#missing[@]} > 0)); then
    vb-cmd-dep-notify \
      --name "Clipboard Manager" \
      --deps "${missing[*]}"
    return 1
  fi
}

MODE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  --show)
    MODE="show"
    shift
    ;;
  --clear)
    MODE="clear"
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    log Error "unknown option: $*"
    log Error "Try '${0##*/} --help' for more information"
    exit 1
    ;;
  esac
done

case "$MODE" in
show)
  log Info "Showing clipboard history"

  # If rofi is already running from a previous --show, kill it to toggle
  # the picker closed. This matches the common rofi-as-a-popup pattern.
  if pidof -q rofi; then
    killall rofi
    exit 0
  fi

  if ! _check_deps; then
    exit 1
  fi

  if ! systemctl -q --user is-active cliphist.service; then
    systemctl -q --user enable --now cliphist.service
  fi

  source vb-lib-core

  ENTRIES=()
  mapfile -t ENTRIES < <(cliphist list)

  if ((${#ENTRIES[@]} == 0)); then
    notify-send -t 1000 -r 3 \
      "Clipboard Manager" \
      "<i>Clipboard is empty!</i>"
    exit 1
  fi

  helpers::ui::menu chosen "Clipboard" "search..." \
    -display-columns 2 -- "${ENTRIES[@]}"

  if [[ -n "$chosen" ]]; then
    # cliphist list entries with file:// URIs must be decoded and copied
    # as text/uri-list so Wayland compositors handle them as file transfers
    # rather than plain text. Non-URI entries are copied as plain text.
    if [[ "$chosen" =~ file:// ]]; then
      printf "%s" "$chosen" | cliphist decode | wl-copy -n --type text/uri-list
    else
      printf "%s" "$chosen" | cliphist decode | wl-copy -n
    fi
  fi
  ;;
clear)
  log Info "Clearing clipboard history"

  if ! _check_deps; then
    exit 1
  fi

  if ! systemctl -q --user is-active cliphist.service; then
    systemctl -q --user enable --now cliphist.service
    exit 0
  fi

  killall -q rofi
  wl-copy --clear
  cliphist wipe
  ;;
*)
  usage
  exit 0
  ;;
esac
