#!/usr/bin/env bash

_usage() {
    cat << EOF
Usage: ${0##*/} [OPTION]

Options:
  --show      Show clipboard history
  --clear     Clear clipboard history
  -h, --help  Show this help and exit
EOF
}

_is_empty() {
    local entries=()
    mapfile -t entries < <(cliphist list)

    if (( ${#entries[@]} == 0 )); then
        return 0
    else
        return 1
    fi
}

_show_() {
    source vb-core-lib

    local chosen
    chosen="$(cliphist list \
        | helpers::ui::menu \
        "Clipboard" "search" \
        -display-columns 2
    )"

    if [[ ! -z "$chosen" ]]; then
        printf "%s" "$chosen" \
            | cliphist decode \
            | wl-copy -t text-uri-list
    fi
}

_clear() {
    # if open it's
    # at the moment
    # of invocation
    killall -q rofi

    cliphist wipe
    wl-copy --clear
}

_ensure_service() {
    local status
    status="$(systemctl --user is-active cliphist)"

    if [[ ! "$status" == "active" ]]; then
        systemctl -q --user enable --now cliphist
    fi
}

_ensure_deps() {
    if ! missing="$(vb-cmd-is-present rofi cliphist)"; then
        [[ -t 1 ]] && vb-cmd-dep-notify --name "Clipboard Manager" --deps "$missing"
        exit 1
    fi
}

case "$1" in
    "--show")
        _ensure_deps
        _ensure_service

        # showo only if not empty
        if ! _is_empty; then
            _show_
        fi
        ;;
    "--clear")
        _ensure_deps
        _ensure_service

        _clear
        ;;
    "-h"|"--help"|"")
        _usage
        exit 0
        ;;
    *)
        _usage
        exit 1
        ;;
esac
