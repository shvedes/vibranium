#!/bin/bash

# Robust lib sourcing: works even when $VIBRANIUM/bin is not on PATH
# (e.g. Quickshell services spawning via absolute path).
# The first source follows the caller's PATH; the fallback resolves this
# script's directory so an absolute-path launch does not depend on PATH.
if ! source vb-lib-cli 2>/dev/null; then
  _vb_dir="$(cd "${BASH_SOURCE[0]%/*}" && pwd)"
  # shellcheck source=/dev/null
  # The fallback suppresses the second source error, but a successful source is
  # still required for log and shcat to be defined.
  source "$_vb_dir/vb-lib-cli" 2>/dev/null || true
fi

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [--pretty] [--size] [--pairs] [THEME]

List available X11 cursor themes.

  THEME      folder name of a single cursor theme

Without flags scans for cursor themes and prints folder names

Options:
  --pretty   use human-readable name from .theme file instead of folder name
  --size     append available cursor pixel sizes
  --pairs    print "folder<TAB>display name" pairs, sorted by folder
             (single-process, stable pairing for menu dropdowns)
  -v, --verbose   Enable verbose output
  -h, --help display this help and exit
EOF
}

FLAG_PRETTY=false
FLAG_SIZE=false
FLAG_PAIRS=false
THEME_ARG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    --pretty)
      FLAG_PRETTY=true
      shift
      ;;
    --size)
      FLAG_SIZE=true
      shift
      ;;
    --pairs)
      FLAG_PAIRS=true
      shift
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -n "$THEME_ARG" ]]; then
        echo "error: unexpected argument: $1" >&2
        exit 1
      fi
      THEME_ARG="$1"
      shift
      ;;
  esac
done

# Parse the human-readable Name from an exact [Icon Theme] section. The first
# matching Name= wins; duplicate headers are not disambiguated, and the
# directory name is the fallback.
parse_cursor_theme() {
  local file="$1"
  local line name
  local in_section=false

  while IFS= read -r line; do
    case "$line" in
      "[Icon Theme]")
        in_section=true
        ;;
      "["*)
        in_section=false
        ;;
      Name=*)
        if [[ $in_section == true ]]; then
          name="${line#Name=}"
          break
        fi
        ;;
    esac
  done < "$file"

  local dir="${file%/*}"
  dir="${dir##*/}"

  THEMES["$dir"]="${name:-$dir}"
}

# Parse little-endian Xcursor table-of-contents entries in Python to collect
# and sort sizes; Bash cannot parse the binary structs. Type 0xfffd0002 marks
# size entries.
print_all_sizes() {
  # Bash passes display/path pairs without an output delimiter; Python
  # reconstructs pairs by position, which keeps the interface stable when a
  # display name contains spaces.
  python3 - "$@" << 'PYEOF'
import sys, struct

args = sys.argv[1:]
pairs = zip(args[0::2], args[1::2])

for name, path in pairs:
    try:
        with open(path, 'rb') as fh:
            if fh.read(4) != b'Xcur':
                print(name)
                continue
            fh.read(8)
            ntoc, = struct.unpack('<I', fh.read(4))
            sizes = set()
            for _ in range(ntoc):
                typ, sub = struct.unpack('<II', fh.read(8))
                fh.read(4)
                if typ == 0xfffd0002:
                    sizes.add(sub)
            if sizes:
                print(name, *sorted(sizes))
            else:
                print(name)
    except Exception:
        print(name)
PYEOF
}

# Register theme metadata. cursor.theme takes precedence over index.theme;
# the directory name is the fallback, and duplicate folder names follow the
# declared search order.
register_theme() {
  local theme_path="$1"
  local dir_name="${theme_path##*/}"

  THEME_DIRS["$dir_name"]="$theme_path/cursors"

  if [[ -f "$theme_path/cursor.theme" ]]; then
    parse_cursor_theme "$theme_path/cursor.theme"
  elif [[ -f "$theme_path/index.theme" ]]; then
    parse_cursor_theme "$theme_path/index.theme"
  else
    THEMES["$dir_name"]="$dir_name"
  fi
}

# Standard cursor theme search order: system-wide, then user-local.
SEARCH_DIRS=(
  "/usr/share/icons"
  "${XDG_DATA_HOME:-$HOME/.local/share}/icons"
  "$HOME/.icons"
)

declare -A THEMES
declare -A THEME_DIRS

if [[ -n "$THEME_ARG" ]]; then
  log Info "Looking up theme: $THEME_ARG"
  for base in "${SEARCH_DIRS[@]}"; do
    if [[ -d "$base/$THEME_ARG/cursors" ]]; then
      register_theme "$base/$THEME_ARG"
      break
    fi
  done

  if [[ ${#THEMES[@]} -eq 0 ]]; then
    log Error "Theme not found: $THEME_ARG"
    exit 1
  fi
else
  log Info "Scanning cursor themes in ${SEARCH_DIRS[*]}"
  for base in "${SEARCH_DIRS[@]}"; do
    if [[ -d "$base" ]]; then
      for theme_dir in "$base"/*/; do
        if [[ -d "$theme_dir" ]]; then
          theme_dir="${theme_dir%/}"
          if [[ -d "$theme_dir/cursors" ]]; then
            register_theme "$theme_dir"
          fi
        fi
      done
    fi
  done
  log Info "Found ${#THEMES[@]} cursor themes"
fi

# Only the first regular file in each theme's cursors directory is passed to
# the Xcursor parser; the size list describes that representative file, not a
# merge of every cursor variant.
# Sorting happens after associative-array collection because Bash does not
# guarantee key order. LC_ALL=C fixes collation.
_sorted_dirs=()
for _k in "${!THEMES[@]}"; do _sorted_dirs+=("$_k"); done
_saved_lc="${LC_ALL:-}"
LC_ALL=C
for ((i = 0; i < ${#_sorted_dirs[@]}; i++)); do
  for ((j = 0; j < ${#_sorted_dirs[@]} - i - 1; j++)); do
    if [[ "${_sorted_dirs[j]}" > "${_sorted_dirs[j+1]}" ]]; then
      _tmp="${_sorted_dirs[j]}"
      _sorted_dirs[j]="${_sorted_dirs[j+1]}"
      _sorted_dirs[j+1]="$_tmp"
    fi
  done
done
LC_ALL="$_saved_lc"
if [[ $FLAG_SIZE == true ]]; then
  size_args=()
  for dir in "${_sorted_dirs[@]}"; do
    if [[ $FLAG_PRETTY == true ]]; then
      display="${THEMES[$dir]}"
    else
      display="$dir"
    fi
    for f in "${THEME_DIRS[$dir]}"/*; do
      if [[ -f "$f" ]]; then
        size_args+=("$display" "$f")
        break
      fi
    done
  done
  print_all_sizes "${size_args[@]}"
elif [[ $FLAG_PAIRS == true ]]; then
  # Emit folder<TAB>display pairs in one process, sorted by folder, so each
  # row can be consumed without separate scans.
  for dir in "${_sorted_dirs[@]}"; do
    printf "%s\t%s\n" "$dir" "${THEMES[$dir]}"
  done
else
  for dir in "${_sorted_dirs[@]}"; do
    if [[ $FLAG_PRETTY == true ]]; then
      printf "%s\n" "${THEMES[$dir]}"
    else
      printf "%s\n" "$dir"
    fi
  done
fi
