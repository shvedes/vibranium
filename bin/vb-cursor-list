#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [--pretty] [--size] [THEME]

List available X11 cursor themes.

  THEME      folder name of a single cursor theme

Without flags scans for cursor themes and prints folder names

Options:
  --pretty   use human-readable name from .theme file instead of folder name
  --size     append available cursor pixel sizes
  -v, --verbose   Enable verbose output
  -h, --help display this help and exit
EOF
}

FLAG_PRETTY=false
FLAG_SIZE=false
THEME_ARG=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    --pretty)
      FLAG_PRETTY=true
      shift
      ;;
    --size)
      FLAG_SIZE=true
      shift
      ;;
    -*)
      echo "unknown option: $1" >&2
      exit 1
      ;;
    *)
      if [[ -n "$THEME_ARG" ]]; then
        echo "error: unexpected argument: $1" >&2
        exit 1
      fi
      THEME_ARG="$1"
      shift
      ;;
  esac
done

# Parse a freedesktop.org .theme file to extract the human-readable
# Name from the [Icon Theme] section.  Falls back to the directory name
# when no .theme file or Name entry exists.
parse_cursor_theme() {
  local file="$1"
  local line name
  local in_section=false

  while IFS= read -r line; do
    case "$line" in
      "[Icon Theme]")
        in_section=true
        ;;
      "["*)
        in_section=false
        ;;
      Name=*)
        if [[ $in_section == true ]]; then
          name="${line#Name=}"
          break
        fi
        ;;
    esac
  done < "$file"

  local dir="${file%/*}"
  dir="${dir##*/}"

  THEMES["$dir"]="${name:-$dir}"
}

# Parse the Xcursor binary format (.cursor files) to extract available
# pixel sizes.  Each cursor file has a header with a table of contents
# containing type+size entries; type 0xfffd0002 indicates a size entry.
# Bash cannot parse binary structs, so this is delegated to Python 3.
print_all_sizes() {
  python3 - "$@" << 'PYEOF'
import sys, struct

args = sys.argv[1:]
pairs = zip(args[0::2], args[1::2])

for name, path in pairs:
    try:
        with open(path, 'rb') as fh:
            if fh.read(4) != b'Xcur':
                print(name)
                continue
            fh.read(8)
            ntoc, = struct.unpack('<I', fh.read(4))
            sizes = set()
            for _ in range(ntoc):
                typ, sub = struct.unpack('<II', fh.read(8))
                fh.read(4)
                if typ == 0xfffd0002:
                    sizes.add(sub)
            if sizes:
                print(name, *sorted(sizes))
            else:
                print(name)
    except Exception:
        print(name)
PYEOF
}

# Populate THEMES[name]=display_name and THEME_DIRS[name]=cursors_path
# from a cursor theme directory.  Checks cursor.theme first (KDE/XCursor
# convention), then index.theme (freedesktop icon theme), then falls back
# to the directory name.
register_theme() {
  local theme_path="$1"
  local dir_name="${theme_path##*/}"

  THEME_DIRS["$dir_name"]="$theme_path/cursors"

  if [[ -f "$theme_path/cursor.theme" ]]; then
    parse_cursor_theme "$theme_path/cursor.theme"
  elif [[ -f "$theme_path/index.theme" ]]; then
    parse_cursor_theme "$theme_path/index.theme"
  else
    THEMES["$dir_name"]="$dir_name"
  fi
}

# Standard cursor theme search order: system-wide, then user-local.
SEARCH_DIRS=(
  "/usr/share/icons"
  "${XDG_DATA_HOME:-$HOME/.local/share}/icons"
  "$HOME/.icons"
)

declare -A THEMES
declare -A THEME_DIRS

if [[ -n "$THEME_ARG" ]]; then
  log Info "Looking up theme: $THEME_ARG"
  for base in "${SEARCH_DIRS[@]}"; do
    if [[ -d "$base/$THEME_ARG/cursors" ]]; then
      register_theme "$base/$THEME_ARG"
      break
    fi
  done

  if [[ ${#THEMES[@]} -eq 0 ]]; then
    log Error "Theme not found: $THEME_ARG"
    exit 1
  fi
else
  log Info "Scanning cursor themes in ${SEARCH_DIRS[*]}"
  for base in "${SEARCH_DIRS[@]}"; do
    if [[ -d "$base" ]]; then
      for theme_dir in "$base"/*/; do
        if [[ -d "$theme_dir" ]]; then
          theme_dir="${theme_dir%/}"
          if [[ -d "$theme_dir/cursors" ]]; then
            register_theme "$theme_dir"
          fi
        fi
      done
    fi
  done
  log Info "Found ${#THEMES[@]} cursor themes"
fi

if [[ $FLAG_SIZE == true ]]; then
  size_args=()
  for dir in "${!THEMES[@]}"; do
    if [[ $FLAG_PRETTY == true ]]; then
      display="${THEMES[$dir]}"
    else
      display="$dir"
    fi
    for f in "${THEME_DIRS[$dir]}"/*; do
      if [[ -f "$f" ]]; then
        size_args+=("$display" "$f")
        break
      fi
    done
  done
  print_all_sizes "${size_args[@]}"
else
  for dir in "${!THEMES[@]}"; do
    if [[ $FLAG_PRETTY == true ]]; then
      printf "%s\n" "${THEMES[$dir]}"
    else
      printf "%s\n" "$dir"
    fi
  done
fi
