#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vibranium-core-lib"

current_theme="$(vibranium-theme-get)"

conf="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprpaper.conf"
user_wallpapers="${XDG_CONFIG_HOME:-$HOME/.config}/vibranium/theme/wallpapers/$current_theme"
walls="${XDG_CONFIG_HOME:-$HOME/.config}/vibranium/theme/current/backgrounds"
state_file="$VIBRANIUM_STATE/wallpaper/$current_theme"

if ! missing_str="$(vibranium-utils-is-installed hyprpaper jq)"; then
    read -r -a missing <<< "$missing_str"
    notify-send -r 4 -t 5000 -u critical "$(basename "$0")" "Missing dependencies: ${missing[*]}"
    exit 1
fi

toggle_wallpaper() {
    local mode="$1"
    local current
    local files
    local idx next prev

    mapfile -t files < <(find "${walls}/" -type f,l | sort)

    # Sort user wallpapers after builtins
    mapfile -t user_files < <(find "${user_wallpapers}/" -type f,l | sort)

    files+=("${user_files[@]}")

    # If it is empty (somehow) - exit
    [ ${#files[@]} -eq 0 ] && return 1

    current="$(vibranium-cmd-get-wallpaper)"
    idx=0

    for i in "${!files[@]}"; do
        if [ "${files[$i]}" = "$current" ]; then
            idx=$i
            break
        fi
    done

    # Next / Prev
    case "$mode" in
        --next)
            next=$(((idx + 1) % ${#files[@]}))
            printf "%s\n" "${files[$next]}"
            ;;
        --prev)
            prev=$(((idx - 1 + ${#files[@]}) % ${#files[@]}))
            printf "%s\n" "${files[$prev]}"
            ;;
    esac
}

usage() {
    cat << EOF
Usage:
    $(basename "$0") <image>.[png/jpg/webp]
    $(basename "$0") --next | --prev
EOF
}

if [[ -z "$1" ]]; then
    usage
    exit 1
elif [[ "$1" =~ --(next|prev) ]]; then
    wallpaper_path="$(toggle_wallpaper "$1")"
elif [[ "$1" =~ \.(png|jp(e)?g|webp)$ ]]; then
    wallpaper_path="$(realpath "$1")"
else
    usage
fi

mkdir -p "$user_wallpapers" "$VIBRANIUM_STATE/wallpaper"

check_bool VIBRANIUM_GLOBAL_SHOW_WALLPAPER true
wallpaper_enabled="$VIBRANIUM_GLOBAL_SHOW_WALLPAPER"

if [[ $wallpaper_enabled == true ]]; then
    if [[ "$(systemctl --user is-active hyprpaper)" != "active" ]]; then
        warn "${YELLOW}hyprpaper.service${RESET} wasn't active!"
        msg="For some reason, the wallpaper daemon wasn't enabled.\n"
        msg+="The system service has been enabled"
        notify-send -r 1 -t 5000 "Vibranium" "$msg"
        systemctl -q --user enable --now hyprpaper &
    fi
else
    exit 0
fi

log "New wallpaper: ${YELLOW}$wallpaper_path${RESET}"

# In case if user set new wallpaper via thunar context menu
# (e,g. user's own picture, downloaded from the internet) we
# should copy this file to the folder that contains user wallpapers
# only. Why copy? In case if original file gets deleted
if [[ ! -f "$walls/$(basename "$wallpaper_path")" ]]; then
    log "Copying new custom user wallpaper"
    cp "$wallpaper_path" "$user_wallpapers/"
    wallpaper_path="$user_wallpapers/$(basename "$WALLPAPER_PATH")"
fi

# Update on all monitors
log "Setting new wallpaper via ${YELLOW}hyprctl${RESET}"
hyprctl -q hyprpaper wallpaper ", $wallpaper_path"

# Save hyprpaper config
log "Generating config file"
printf "# Auto-generated file! All changes will be overwritten.\nsplash = false\n" > "$conf"
printf "wallpaper:monitor = \nwallpaper:path = %s" "$wallpaper_path" >> "$conf"

log "Updating state file"
printf "%s" "$wallpaper_path" > "$state_file"

log "Updating lockscreen background"
vibranium-cmd-refresh-lockscreen
