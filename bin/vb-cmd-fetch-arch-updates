#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ $level == "Error" ]] || ($VERBOSE && [[ -t 0 ]]); then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

CACHE_FILE="$VIBRANIUM_CACHE/pkg-updates.list"
TIMESTAMP_FILE="$VIBRANIUM_CACHE/pkg-updates.timestamp"
INTERVAL=$((3 * 24 * 60 * 60)) # 3 real days
THRESHOLD=125                  # packages

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Fetch new updates from Arch Linux repositories and the AUR.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Show this help and exit

Notes:
  This is an auxiliary script for fetch-arch-updates.service.
  This script is also launched by the "Updates" bar module
  if it is enabled.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    log Error "unknown option: $*"
    log Error "Try --help for more information"
    exit 1
    ;;
  esac
done

log Info "Fetching package updates"

missing=()

command -v checkupdates >/dev/null 2>&1 || missing+=("checkupdates")
command -v yay >/dev/null 2>&1 || missing+=("yay")

if ((${#missing[@]} > 0)); then
  notify-send -r 3 -t 120000 \
    "Could Not Fetch System Updates" \
    "Missing required dependencies: ${missing[*]}"
  exit 1
fi

# Wait for network connectivity before querying repos.
# 1.1.1.1 (Cloudflare DNS) is used because it is generally reachable
# even when DNS resolution for other hosts would fail.
# Times out after 30 seconds to avoid hanging indefinitely.
NETWORK_REACHABLE=false

for _ in {1..30}; do
  if ping -c 1 8.8.8.8 &>/dev/null; then
    NETWORK_REACHABLE=true
    break
  fi
  sleep 1
done

if ! $NETWORK_REACHABLE; then
  log Warn "Network not reachable after 30s, skipping update check"
  exit 0
fi

: >"$CACHE_FILE"
checkupdates --nocolor 2>/dev/null >>"$CACHE_FILE"
yay -Qua --color=never 2>/dev/null >>"$CACHE_FILE"

mapfile -t LINES <"$CACHE_FILE"
TOTAL_COUNT=${#LINES[@]}

# Only show the nag notification when the update count exceeds THRESHOLD
# and at least INTERVAL seconds have passed since the last nag, to avoid
# annoying the user on every poll cycle.
if ((TOTAL_COUNT >= THRESHOLD)); then
  TIMESTAMP_NOW=$EPOCHSECONDS
  TIMESTAMP_LAST=0

  if [[ -f "$TIMESTAMP_FILE" ]]; then
    TIMESTAMP_LAST=$(<"$TIMESTAMP_FILE")
    # Validate that the stored value is a plausible Unix timestamp
    # (within a reasonable range for the current system).
    [[ $TIMESTAMP_LAST =~ ^[0-9]+$ ]] || TIMESTAMP_LAST=0
  fi

  if ((TIMESTAMP_NOW - TIMESTAMP_LAST >= INTERVAL)); then
    notify-send -r 3 -t 120000 \
      "$TOTAL_COUNT Packages Are Awaiting Updates" \
      "On Arch it is recommended to update your system regularly"

    printf "%s" "$TIMESTAMP_NOW" >"$TIMESTAMP_FILE"
  fi
fi
