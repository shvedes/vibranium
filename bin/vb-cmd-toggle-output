#!/bin/bash

usage() {
  cat << EOF
Usage: ${0##*/} [OPTION]...
Cycle to the next available PipeWire audio output.

Options:
  -h, --help       display this help text and exit

Exit status:
  0   output switched successfully (or only one output present)
  1   no audio devices found

Examples:
  ${0##*/}            cycle to the next audio output
  ${0##*/} --help     show this help text
EOF
}

notify() {
  local icon="$1" summary="$2" body="$3"

  if [[ $VIBRANIUM_GLOBAL_USE_OSD == true ]]; then
    swayosd-client \
      --monitor "$focused_monitor" \
      --custom-message "$body" \
      ${icon:+--custom-icon "$icon"}
  else
    if [[ -n $icon ]]; then
      local icon_path
      icon_path="$(find "$XDG_DATA_HOME/icons/Papirus" -name "${icon}.svg" 2> /dev/null | head -n1)"
    fi
    notify-send -r 2 -t 2000 ${icon_path:+-i "$icon_path"} "$summary" "$body"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "unknown option: '$1'. Try ${0##*/} --help"
      exit 1
      ;;
    *)
      echo "unknown option: '$1'. Try ${0##*/} --help"
      exit 1
      ;;
  esac
  shift
done

source vb-core-lib

helpers::check VIBRANIUM_GLOBAL_USE_OSD

focused_monitor="$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')"

# Discover available sinks
sinks=$(pactl -f json list sinks |
  jq '[.[] | select((.ports | length == 0) or ([.ports[]? | .availability != "not available"] | any))]')

sinks_count=$(echo "$sinks" | jq '. | length')

if [[ $sinks_count -eq 0 ]]; then
  notify "" "Vibranium" "No audio devices found"
  exit 1
fi

if [[ $sinks_count -eq 1 ]]; then
  notify-send -r 2 "Vibranium" "Only one audio output available — nothing to switch to"
  exit 0
fi

# Determine next sink
current_sink_name=$(pactl get-default-sink)
current_sink_index=$(echo "$sinks" | jq -r --arg name "$current_sink_name" 'map(.name) | index($name)')

if [[ $current_sink_index != "null" ]]; then
  next_sink_index=$(((current_sink_index + 1) % sinks_count))
else
  next_sink_index=0
fi

next_sink=$(echo "$sinks" | jq -r ".[$next_sink_index]")
next_sink_name=$(echo "$next_sink" | jq -r '.name')

# Resolve human-readable description
next_sink_description=$(echo "$next_sink" | jq -r '.description')

if [[ $next_sink_description == "(null)" || $next_sink_description == "null" || -z $next_sink_description ]]; then
  sink_id=$(echo "$next_sink" | jq -r '.properties."object.id"')
  next_sink_description=$(wpctl status |
    grep -E "\s+\*?\s+${sink_id}\." |
    sed -E 's/^.*[0-9]+\.\s+//' |
    sed -E 's/\s+\[.*$//')
fi

# Determine volume icon state
next_sink_volume=$(echo "$next_sink" | jq -r '.volume | to_entries[0].value.value_percent | sub("%"; "")')
next_sink_is_muted=$(echo "$next_sink" | jq -r '.mute')

if [[ $next_sink_is_muted == "true" || $next_sink_volume -eq 0 ]]; then
  icon_state="muted"
elif [[ $next_sink_volume -le 33 ]]; then
  icon_state="low"
elif [[ $next_sink_volume -le 66 ]]; then
  icon_state="medium"
else
  icon_state="high"
fi

# Switch and notify
if [[ $next_sink_name != "$current_sink_name" ]]; then
  pactl set-default-sink "$next_sink_name"
fi

notify "volume-level-${icon_state}" "Output Device" "$next_sink_description"
