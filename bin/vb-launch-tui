#!/bin/bash

source vb-lib-cli

SELF="${0##*/}"

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: $SELF [OPTIONS] -- COMMAND [ARGS...]

Focus existing window matching COMMAND, or launch it in a terminal.

Options:
  --title      Override window title
  --app-id     Override application ID
  -v, --verbose Enable verbose output
  -h, --help   Show this help and exit
EOF
}

# APP_ID and TITLE are terminal-launch metadata; the focus query independently
# matches only the executable basename against .class and .initialClass.
focus_or_launch() {
  local -a cmd=("$@")

  local match_key="${cmd[0]##*/}"
  match_key="${match_key,,}"
  log Info "Focus or launch TUI: key=$match_key app_id=$APP_ID title=$TITLE cmd=${cmd[*]}"

  # Matching is limited to class metadata and is deliberately ordered: an
  # exact name wins over the broader substring phase.
  # jq errors are suppressed because an invalid client list has the same
  # user-visible outcome as no match: launch a new terminal window.
  local window_address
  window_address="$(
    jq -r --arg key "$match_key" '
      . as $clients |

      # Phase 1: exact match against .class and .initialClass.
      (
        try first(
          $clients[]
          | (.class        // "" | ascii_downcase) as $c
          | (.initialClass // "" | ascii_downcase) as $ic
          | select($c == $key or $ic == $key)
          | .address
        )
      )

      //

      # Phase 2: partial match - either the class is a substring of the
      # key or the key is a substring of the class. The empty-string
      # guard prevents "" from matching everything via contains().
      # Example: key="google-chrome-stable", class="google-chrome" ->
      # "google-chrome-stable" contains "google-chrome" -> match.
      (
        try first(
          $clients[]
          | (.class        // "" | ascii_downcase) as $c
          | (.initialClass // "" | ascii_downcase) as $ic
          | select(
              ($c  != "" and (($c  | contains($key)) or ($key | contains($c))))  or
              ($ic != "" and (($ic | contains($key)) or ($key | contains($ic))))
            )
          | .address
        )
      )
    ' 2> /dev/null < <(hyprctl -j clients)
  )"

  if [[ -n "$window_address" ]]; then
    # The address branch focuses the existing window; only an empty match
    # transfers ownership to a newly launched terminal.
    log Info "Focusing existing terminal window: address=$window_address"
    hyprctl -q dispatch "hl.dsp.focus({window = 'address:${window_address}'})"
  else
    log Info "No matching terminal window, launching: ${cmd[*]}"
    exec setsid -f xdg-terminal-exec \
      --app-id="$APP_ID" \
      --title="$TITLE" \
      -- "${cmd[@]}" \
      </dev/null >/dev/null 2>&1
  fi
}

APP_ID=""
TITLE=""

(($#)) || {
  usage >&2
  exit 1
}

while (($#)); do
  case "$1" in
    --app-id=*)
      APP_ID="${1#*=}"
      shift
      ;;
    --app-id)
      [[ -n "$2" ]] || {
        log Error "missing value for --app-id"
        exit 1
      }
      APP_ID="$2"
      shift 2
      ;;
    --title=*)
      TITLE="${1#*=}"
      shift
      ;;
    --title)
      [[ -n "$2" ]] || {
        log Error "missing value for --title"
        exit 1
      }
      TITLE="$2"
      shift 2
      ;;
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    --)
      shift
      break
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log Error "unknown option -- $*"
      log Error "Try --help for more information"
      exit 1
      ;;
  esac
done

if ! (($#)); then
  log Error "missing COMMAND after --"
  exit 1
fi

source vb-lib-core

COMMAND=("$@")

# Executable validation runs prior to the focus/launch decision, including when
# a matching window already exists; unavailable commands still exit.
if ! command -v "${COMMAND[0]}" > /dev/null; then
  log::error "${COMMAND[0]} not found int PATH!"
  [[ -t 0 ]] || notify-send -r 3 -a Vibranium -u critical -t 10000 \
    "TUI Applcations" "<b>${COMMAND[0]}</b> not found in PATH!"
  exit 1
fi

# Identity metadata is filled only after option parsing, so explicit values
# remain unchanged while the basename supplies stable fallback identities.
APP_NAME="${COMMAND[0]##*/}"
: "${APP_ID:=org.vb.term.$APP_NAME}"
: "${TITLE:=$APP_NAME}"

# An absent focus preference does not prevent a launch; the direct path remains
# available.
if [[ "$APP_LAUNCHER_ALWAYS_FOCUS" == true ]]; then
  # shellcheck disable=SC2068
  focus_or_launch "${COMMAND[@]}"
else
  log Info "Always-focus disabled, launching directly"
  # Detached stdio and exec transfer terminal lifetime to xdg-terminal-exec,
  # keeping this wrapper from retaining pipes or blocking the caller.
  # shellcheck disable=SC2068
  exec setsid -f xdg-terminal-exec \
    --app-id="$APP_ID" \
    --title="$TITLE" \
    -- "${COMMAND[@]}" \
    </dev/null >/dev/null 2>&1
fi
