#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ $level == "Error" ]] || ($VERBOSE && [[ -t 0 ]]); then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF [OPTION]

Switch keyboard layout for the main Hyprland keyboard.
Mainly used by the Waybar module.

Notes:
  Don't bind this script with keyboard shortcuts;
  use Hyprland's native config.

Options:
  --next            Switch to next layout (default)
  --prev            Switch to previous layout
  --notify          Notify after switch
  -v, --verbose     Enable verbose output
  -h, --help        Display this help and exit
EOF
}

NOTIFY=false
action="next"

while [[ $# -gt 0 ]]; do
  case "${1:-}" in
  --next)
    action="next"
    shift
    ;;
  --prev)
    action="prev"
    shift
    ;;
  --notify)
    NOTIFY=true
    shift
    ;;
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    log Error "invalid option: $1"
    log Error "Try --help for more information"
    exit 1
    ;;
  esac
done

log Info "Action: $action"

devices_json="$(hyprctl -j devices)"
device="$(jq -r '.keyboards[] | select(.main == true) | .name' <<<"$devices_json")"

if [[ -z "$device" ]]; then
  log Error "no main keyboard found"
  log Error "no main keyboard found"

  if command -v notify-send >/dev/null 2>&1; then
    notify-send -r 4 -t 3000 -u critical \
      "Vibranium" \
      "Could not detect your default keyboard"
  fi

  exit 1
fi

log Info "Switching layout on $device to $action"
if ! hyprctl -q switchxkblayout "$device" "$action"; then
  log Error "failed to switch keyboard layout"
  exit 1
fi

# Re-query devices after switching — the cached JSON from before the
# switch still holds the old keymap and would produce a stale notification.
if $NOTIFY; then
  layout="$(hyprctl -j devices | jq -r '.keyboards[] | select(.main == true) | .active_keymap')"

  notify-send -r 4 -t 3000 "Keyboard Layout: $layout"
fi
