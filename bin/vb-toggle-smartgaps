#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

FILE="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/smart-gaps.lua"
SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF [OPTION]

Toggle Hyprland smart gaps configuration.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    break
    ;;
  esac
done

log Info "Toggling smart gaps"

# The presence of smart-gaps.lua enables the rule; removing it reverts
# to the default gaps defined in the main Hyprland config.
if [[ -f "$FILE" ]]; then
  rm -f "$FILE"
else
  # Both workspace rule and window rule are needed: the workspace rule
  # sets gaps_out/gaps_in to 0 on all non-float windows, and the window
  # rule suppresses decorations (title bars, borders) which would waste
  # space when gaps are removed.
  shcat >"$FILE" <<EOF
hl.workspace_rule({
  workspace = "w[tv1] w[g0] s[false]", -- 1 tiled, no groups, not special
  gaps_out = 0,
  gaps_in = 0,
})

hl.window_rule({
  match = {
    float = false,
    workspace = "w[tv1] w[g0] s[false]",
  },
  decorate = false
})
EOF
fi

hyprctl -q reload config-only
