#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ $level == "Error" ]] || ($VERBOSE && [[ -t 0 ]]); then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF [OPTION]...
Cycle to the next available PipeWire audio output.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit

Exit status:
  0   output switched successfully (or only one output present)
  1   no audio devices found
EOF
}

notify() {
  local summary="$1" body="$2" monitor icon

  icon="/usr/share/icons/Papirus/24x24/panel/volume-level-high.svg"

  if [[ $VIBRANIUM_GLOBAL_USE_OSD == true ]]; then
    monitor="$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')"
    swayosd-client --monitor "$monitor" --custom-message "$body" ${icon:+--custom-icon "$icon"}
  else
    notify-send -r 2 -t 2000 -i "$icon" "$summary" "$body"
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --)
    shift
    break
    ;;
  *)
    log Error "unknown option -- $*"
    log Error "Try --help for more information"
    exit 1
    ;;
  esac
  shift
done

if ! command -v jq >/dev/null; then
  vb-cmd-dep-notify --name "Output Switcher" --deps "jq"
  exit 1
fi

source vb-lib-core

helpers::check VIBRANIUM_GLOBAL_USE_OSD

# Discover available sinks
sinks=$(pactl -f json list sinks | jq '[.[] | select((.ports | length == 0) or ([.ports[]? | .availability != "not available"] | any))]')

sinks_count=$(jq '. | length' <<<"$sinks")

if [[ $sinks_count -eq 0 ]]; then
  notify "Vibranium" "No audio devices found"
  exit 1
fi

if [[ $sinks_count -eq 1 ]]; then
  notify-send -r 2 "Vibranium" "Only one audio output available — nothing to switch to"
  exit 0
fi

log Info "Cycling audio output"

# Determine next sink
current_sink_name=$(pactl get-default-sink)
current_sink_index=$(jq -r --arg name "$current_sink_name" 'map(.name) | index($name)' <<<"$sinks")

if [[ $current_sink_index != "null" ]]; then
  next_sink_index=$(((current_sink_index + 1) % sinks_count))
else
  next_sink_index=0
fi

next_sink=$(jq -r ".[$next_sink_index]" <<<"$sinks")
next_sink_name=$(jq -r '.name' <<<"$next_sink")

# Resolve human-readable description
next_sink_description=$(jq -r '.description' <<<"$next_sink")

if [[ $next_sink_description == "(null)" || $next_sink_description == "null" || -z $next_sink_description ]]; then
  sink_id=$(jq -r '.properties."object.id"' <<<"$next_sink")
  next_sink_description=""

  while IFS= read -r line; do
    if [[ $line =~ [[:space:]]*\*?[[:space:]]+${sink_id}\. ]]; then
      desc="${line#*[0-9]. }"
      desc="${desc%%[*]*}"
      next_sink_description="${desc#"${desc%%[![:space:]]*}"}"
      next_sink_description="${next_sink_description%"${next_sink_description##*[![:space:]]}"}"
      break
    fi
  done < <(wpctl status)
fi

# Switch and notify
if [[ $next_sink_name != "$current_sink_name" ]]; then
  pactl set-default-sink "$next_sink_name"
fi

notify "Output Device" "$next_sink_description"
