#!/usr/bin/bash

source vb-lib-core

DESKTOP_DIR="$XDG_DATA_HOME/applications"
ICON_DIR="$DESKTOP_DIR/icons"
WEBAPP_DATA_DIR="$XDG_DATA_HOME/webapps"

FZF_ARGS=(
  --multi
  --ignore-case
  --highlight-line

  --delimiter $'\t'
  --with-nth 1

  --info 'hidden'
  --border 'bold'

  --border-label ' alt-p: toggle preview, ctrl-j/k: next/prev item, tab: multi-select'
  --border-label-pos 'bottom'

  --list-label 'PWA List'
  --list-border 'bold'

  --input-label 'Filter PWAs'
  --input-border 'bold'

  --preview 'cat {2}'
  --preview-border 'bold'
  --preview-window 'right:50%:wrap'
  --preview-label 'Desktop File'

  --bind 'alt-p:toggle-preview'

  --color 'pointer:white,marker:green'
)

_operation_canceled() {
  term::disable_input
  printf "%s[VIBRANIUM]%s Operation canceled" "$RED" "$RESET"
  read -r -n1 -s -p $'. Press any key to exit' _dummy
  term::enable_input
}

_operation_complete() {
  term::disable_input
  printf "%s[VIBRANIUM]%s " "$GREEN" "$RESET"
  read -r -n1 -p $'Removal complete. Press any key to exit ' _dummy
  term::enable_input
}

_shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

_usage() {
  _shcat <<'EOF'
Usage: vb-webapp-remove [OPTION]...

Remove Progressive Web App shortcuts as .desktop launcher entries.
If no options are provided, the script runs in interactive mode.

Options:
  --file FILE...      .desktop file(s) to remove (basename or full path)
  -h, --help          Show this help and exit
EOF
}

_has_webapp_exec() {
  local line
  while IFS= read -r line; do
    [[ "$line" == Exec=*vb-launch-webapp* ]] && return 0
  done < "$1"
  return 1
}

_desktop_name() {
  local line
  while IFS= read -r line; do
    if [[ "$line" == Name=* ]]; then
      line="${line#Name=}"
      echo "${line#PWA - }"
      return
    fi
  done < "$1"
}

# ---------------------------------------------------------------------------
# Derive the browser data directory name from a URL.
# Must stay in sync with the identically named function in vb-launch-webapp;
# both must produce the same string for the same URL or removal will miss the
# data directory the launcher created.
# ---------------------------------------------------------------------------
_profile_dir_from_url() {
  local url="$1"
  local host="${url#*://}"
  host="${host%%[/?#:]*}"
  host="${host,,}"
  host="${host//\./-}"
  printf '%s' "$host"
}

_remove_pwa() {
  local name="$1" desktop_path="$2"
  local removed=false exec_line=""

  # Read the Exec= line before removing the file; the URL embedded in it is
  # needed to derive the browser data directory path when --own-profile was used.
  if [[ -f "$desktop_path" ]]; then
    local line
    while IFS= read -r line; do
      if [[ "$line" == Exec=* ]]; then
        exec_line="${line#Exec=}"
        break
      fi
    done < "$desktop_path"
    rm -f -- "$desktop_path"
    removed=true
  fi

  [[ -f "$ICON_DIR/PWA - $name.png" ]] && {
    rm -f -- "$ICON_DIR/PWA - $name.png"
    removed=true
  }

  # If the PWA was installed with --own-profile, remove its isolated browser
  # data directory. The URL is always the last whitespace-separated token on
  # the Exec= line regardless of other flags between the command and the URL.
  if [[ "$exec_line" == *--own-profile* ]]; then
    local url="${exec_line##* }"
    local data_dir="$WEBAPP_DATA_DIR/$(_profile_dir_from_url "$url")"
    if [[ -d "$data_dir" ]]; then
      rm -rf -- "$data_dir"
      echo "${GREEN}[VIBRANIUM]${RESET} Removed browser data for ${BLUE}${name}${RESET}"
    fi
  fi

  if [[ "$removed" == true ]]; then
    echo "${GREEN}[VIBRANIUM]${RESET} Removed ${BLUE}${name}${RESET}"
  else
    echo "No such PWA: ${BLUE}${name}${RESET}" >&2
  fi
}

DESKTOP_FILES=()
INTERACTIVE=true

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    _usage
    exit 0
    ;;

  --file)
    INTERACTIVE=false
    shift
    if [[ $# -eq 0 ]]; then
      echo "${RED}[VIBRANIUM]${RESET} Error: --file requires at least one .desktop file argument" >&2
      echo "Try ${0##*/} --help for more information" >&2
      exit 1
    fi
    while [[ $# -gt 0 && "$1" != -* ]]; do
      if [[ "$1" != *.desktop ]]; then
        echo "${RED}[VIBRANIUM]${RESET} Error: not a .desktop file: $1" >&2
        echo "Try ${0##*/} --help for more information" >&2
        exit 1
      fi
      DESKTOP_FILES+=("$1")
      shift
    done
    ;;

  *)
    echo "Unknown option: $1" >&2
    echo "${0##*/} --help for more information" >&2
    exit 1
    ;;
  esac
done

# --- Resolve targets ---

TARGET_NAMES=()
TARGET_PATHS=()

if [[ $INTERACTIVE == true ]]; then
  declare -A PWA_MAP

  shopt -s nullglob
  for file in "$DESKTOP_DIR"/'PWA - '*.desktop; do
    _has_webapp_exec "$file" \
    && PWA_MAP["$(_desktop_name "$file")"]="$file"
  done
  shopt -u nullglob

  if ((${#PWA_MAP[@]} == 0)); then
    term::show_header --color red
    echo "${RED}[VIBRANIUM]${RESET} No PWAs found"
    _operation_canceled
    exit 1
  fi

  mapfile -t SELECTED < <(
    for name in "${!PWA_MAP[@]}"; do
      printf '%s\t%s\n' "$name" "${PWA_MAP[$name]}"
    done | sort | fzf "${FZF_ARGS[@]}"
  )

  term::show_header

  if ((${#SELECTED[@]} == 0)); then
    _operation_canceled
    exit 1
  fi

  ((${#SELECTED[@]} == 1)) && suffix="" || suffix="s"
  if ! term::ask_yes_no Y "You're about to remove ${#SELECTED[@]} PWA${suffix}. Continue?"; then
    _operation_canceled
    exit 1
  fi

  for entry in "${SELECTED[@]}"; do
    TARGET_NAMES+=("${entry%%$'\t'*}")
    TARGET_PATHS+=("${entry##*$'\t'}")
  done

else
  for file_arg in "${DESKTOP_FILES[@]}"; do
    [[ "$file_arg" == */* ]] && desktop_path="$file_arg" || desktop_path="$DESKTOP_DIR/$file_arg"

    if [[ ! -f "$desktop_path" ]]; then
      echo "No such file: $file_arg" >&2
      continue
    fi

    filename="${desktop_path##*/}"
    if [[ "$filename" != PWA\ -\ *.desktop ]]; then
      echo "Warning: not a PWA file: $filename" >&2
      continue
    fi

    TARGET_NAMES+=("$(_desktop_name "$desktop_path")")
    TARGET_PATHS+=("$desktop_path")
  done
fi

for i in "${!TARGET_NAMES[@]}"; do
  _remove_pwa "${TARGET_NAMES[$i]}" "${TARGET_PATHS[$i]}"
done

[[ $INTERACTIVE == true ]] && _operation_complete
