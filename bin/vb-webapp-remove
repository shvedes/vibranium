#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

source vb-lib-core

DESKTOP_DIR="$XDG_DATA_HOME/applications"
ICON_DIR="$DESKTOP_DIR/icons"
WEBAPP_DATA_DIR="$XDG_DATA_HOME/webapps"

if [[ -f "$VIBRANIUM_STATE/theme/fzf" ]]; then
  source "$VIBRANIUM_STATE/theme/fzf"
fi

FZF_ARGS=(
  --multi
  --ignore-case
  --highlight-line

  --delimiter $'\t'
  --with-nth 1

  --info 'hidden'
  --border 'bold'

  --border-label ' alt-p: toggle preview, ctrl-j/k: next/prev item, tab: multi-select'
  --border-label-pos 'bottom'

  --list-label 'PWA List'
  --list-border 'bold'

  --input-label 'Filter PWAs'
  --input-border 'bold'

  --preview 'cat {2}'
  --preview-border 'bold'
  --preview-window 'right:50%:wrap'
  --preview-label 'Desktop File'

  --bind 'alt-p:toggle-preview'

  --color "${FZF_COLORS:-pointer:white,marker:green}"
)

webapp_remove_prepare_result() {
  if [[ -z "${term_original_settings+x}" ]]; then
    term::disable_input
  fi
}

webapp_remove_canceled() {
  webapp_remove_prepare_result
  operation::result canceled
}

webapp_remove_error() {
  webapp_remove_prepare_result
  operation::result error
}

webapp_remove_complete() {
  webapp_remove_prepare_result
  operation::result success -- "Removal complete"
}

usage() {
  shcat << 'EOF'
Usage: vb-webapp-remove [OPTION]...

Remove Progressive Web App shortcuts as .desktop launcher entries.
If no options are provided, the script runs in interactive mode.

Options:
  --file FILE...      .desktop file(s) to remove (basename or full path)
  -h, --help          Show this help and exit
EOF
}

_has_webapp_exec() {
  local line
  while IFS= read -r line; do
    [[ "$line" == Exec=*vb-launch-webapp* ]] && return 0
  done < "$1"
  return 1
}

_desktop_name() {
  local -n _dn_out=$1
  local _dn_file="$2" _dn_line _dn_val=""
  while IFS= read -r _dn_line || [[ -n $_dn_line ]]; do
    if [[ $_dn_line == Name=* ]]; then _dn_val=$_dn_line; break; fi
  done < "$_dn_file"
  _dn_val=${_dn_val#Name=}
  _dn_out=${_dn_val#PWA - }
}

_is_chrome_webapp() {
  local _icw_line
  while IFS= read -r _icw_line || [[ -n $_icw_line ]]; do
    [[ $_icw_line == Exec=*--app-id=* ]] && return 0
  done < "$1" 2>/dev/null
  return 1
}

_chrome_icon_basename() {
  local -n _cib_out=$1
  local _cib_file="$2" _cib_line
  _cib_out=""
  while IFS= read -r _cib_line || [[ -n $_cib_line ]]; do
    if [[ $_cib_line == Icon=* ]]; then _cib_out=${_cib_line#Icon=}; return 0; fi
  done < "$_cib_file" 2>/dev/null
  return 1
}

_profile_dir_from_url() {
  # Host-only normalization intentionally aliases paths and ports on the same
  # hostname to one browser data directory.
  local -n _pdu_out=$1
  local _pdu_url="$2"
  local _pdu_host="${_pdu_url#*://}"
  _pdu_host="${_pdu_host%%[/?#:]*}"
  _pdu_host="${_pdu_host,,}"
  _pdu_host="${_pdu_host//\./-}"
  _pdu_out="$_pdu_host"
}

_remove_pwa() {
  local name="$1" desktop_path="$2"
  local removed=false exec_line=""

  # Capture Exec= while the entry exists because profile cleanup needs its
  # final token after desktop removal.
  if [[ -f "$desktop_path" ]]; then
    local line
    while IFS= read -r line; do
      if [[ "$line" == Exec=* ]]; then
        exec_line="${line#Exec=}"
        break
      fi
    done < "$desktop_path"
    rm -f -- "$desktop_path"
    removed=true
  fi

  # The desktop file is already gone when classification runs, so the Chrome
  # branch is skipped and native entries take the PWA icon path.
  if _is_chrome_webapp "$desktop_path"; then
    local icon_basename=""
    _chrome_icon_basename icon_basename "$desktop_path" || true
    if [[ -n "$icon_basename" ]]; then
      find "$XDG_DATA_HOME/icons" -name "${icon_basename}.png" -delete 2>/dev/null
      removed=true
    fi
  elif [[ -f "$ICON_DIR/PWA - $name.png" ]]; then
    rm -f -- "$ICON_DIR/PWA - $name.png"
    removed=true
  fi

  # Profile cleanup takes the text after the final literal space in any Exec=
  # value. A trailing space yields an empty URL, which maps to WEBAPP_DATA_DIR
  # itself; non-interactive mode does not validate command origin or URL shape.
  if [[ "$exec_line" == *--own-profile* ]]; then
    local url="${exec_line##* }"
    local _pdu_host=""
    _profile_dir_from_url _pdu_host "$url"
    local data_dir
    data_dir="$WEBAPP_DATA_DIR/$_pdu_host"
    if [[ -d "$data_dir" ]]; then
      # Launcher deletion precedes recursive profile cleanup, so interruption
      # can leave orphaned browser data without a desktop entry.
      rm -rf -- "$data_dir"
      vb::print "$G" "Removed browser data for ${B}${name}${RS}"
    fi
  fi

  if [[ "$removed" == true ]]; then
    vb::print "$G" "Removed ${B}${name}${RS}"
  else
    log Error "No such PWA: $name"
  fi
}

DESKTOP_FILES=()
INTERACTIVE=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;

    --file)
      INTERACTIVE=false
      shift
      if [[ $# -eq 0 ]]; then
        log Error "--file requires at least one .desktop file argument"
        log Error "Try --help for more information"
        exit 1
      fi
      while [[ $# -gt 0 && "$1" != -* ]]; do
        if [[ "$1" != *.desktop ]]; then
          log Error "Not a .desktop file: $1"
          log Error "Try --help for more information"
          exit 1
        fi
        DESKTOP_FILES+=("$1")
        shift
      done
      ;;

    *)
      log Error "Unknown option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
  esac
done

# Resolve interactive or CLI targets into parallel name and path arrays.

TARGET_NAMES=()
TARGET_PATHS=()

if [[ $INTERACTIVE == true ]]; then
  declare -A PWA_MAP
  # Display names key the map, so duplicate Name= values retain only the last
  # enumerated path for that name.

  shopt -s nullglob
  _wdr_dn=""
  cname=""
  for file in "$DESKTOP_DIR"/'PWA - '*.desktop; do
    _has_webapp_exec "$file" &&
      _desktop_name _wdr_dn "$file" &&
      PWA_MAP["$_wdr_dn"]="$file"
  done
  for file in "$DESKTOP_DIR"/chrome-*.desktop; do
    _is_chrome_webapp "$file" && {
      _desktop_name cname "$file" &&
      PWA_MAP["[chrome] $cname"]="$file"
    }
  done
  shopt -u nullglob

  if ((${#PWA_MAP[@]} == 0)); then
    term::show_header --color red
    vb::print "$R" "No PWAs found"
    webapp_remove_error
    exit 1
  fi

  # The hidden tab-delimited field carries paths through fzf, so spaces remain
  # inside each field. Literal tabs in either the display name or path break the
  # two-field encoding and subsequent extraction.
  _wdr_rows=()
  for name in "${!PWA_MAP[@]}"; do
    _wdr_rows+=("$name"$'\t'"${PWA_MAP[$name]}")
  done
  for ((_wdr_i = 1; _wdr_i < ${#_wdr_rows[@]}; _wdr_i++)); do
    _wdr_key=${_wdr_rows[_wdr_i]}
    _wdr_j=$((_wdr_i - 1))
    while ((_wdr_j >= 0)) && [[ ${_wdr_rows[_wdr_j]} > $_wdr_key ]]; do
      _wdr_rows[_wdr_j + 1]=${_wdr_rows[_wdr_j]}
      _wdr_j=$((_wdr_j - 1))
    done
    _wdr_rows[_wdr_j + 1]=$_wdr_key
  done
  mapfile -t SELECTED < <(printf '%s\n' "${_wdr_rows[@]}" | fzf "${FZF_ARGS[@]}")

  term::show_header

  if ((${#SELECTED[@]} == 0)); then
    webapp_remove_canceled
    exit 1
  fi

  ((${#SELECTED[@]} == 1)) && suffix="" || suffix="s"
  if ! term::ask_yes_no Y "You're about to remove ${#SELECTED[@]} PWA${suffix}. Continue?"; then
    webapp_remove_canceled
    exit 1
  fi

  for entry in "${SELECTED[@]}"; do
    TARGET_NAMES+=("${entry%%$'\t'*}")
    TARGET_PATHS+=("${entry##*$'\t'}")
  done

else
  # Missing or foreign entries are skipped individually, and no aggregate
  # error is retained for the final exit status.
  for file_arg in "${DESKTOP_FILES[@]}"; do
    # Full paths are accepted verbatim; only PWA or Chrome filename shape is
    # checked, rather than confinement to DESKTOP_DIR.
    [[ "$file_arg" == */* ]] && desktop_path="$file_arg" || desktop_path="$DESKTOP_DIR/$file_arg"

    if [[ ! -f "$desktop_path" ]]; then
      log Error "No such file: $file_arg"
      continue
    fi

    filename="${desktop_path##*/}"
    if [[ "$filename" != PWA\ -\ *.desktop && "$filename" != chrome-*.desktop ]]; then
      log Warn "not a PWA/Chrome webapp file: $filename"
      continue
    fi

    _wdr_dn=""
    _desktop_name _wdr_dn "$desktop_path"
    TARGET_NAMES+=("$_wdr_dn")
    TARGET_PATHS+=("$desktop_path")
  done
fi

# Removal is sequential and non-transactional across a multi-selection; an
# interruption can leave only the prefix that completed.
for i in "${!TARGET_NAMES[@]}"; do
  _remove_pwa "${TARGET_NAMES[$i]}" "${TARGET_PATHS[$i]}"
done

if [[ $INTERACTIVE == true ]]; then
  webapp_remove_complete
  exit 0
fi
