#!/usr/bin/env bash

source vb-lib-core

ICON_DIR="$HOME/.local/share/applications/icons"
DESKTOP_DIR="$HOME/.local/share/applications"

FZF_ARGS=(
  --multi
  --prompt '❯ '
  --marker '❯ '
  --pointer '◆'
  --separator '-'
  --scrollbar '|'
  --info 'right'
  --ghost 'search...'
  --color 'pointer:blue'
)

_operation_canceled() {
  term::disable_input
  printf "%s[VIBRANIUM]%s Operation canceled" "$RED" "$RESET"
  read -r -n1 -s -p $'. Press any key to exit' _dummy
  term::enable_input
}

_operation_complete() {
  term::disable_input
  printf "%s[VIBRANIUM]%s " "$GREEN" "$RESET"
  read -r -n1 -p $'Removal complete. Press any key to exit ' _dummy
  term::enable_input
}

_usage() {
  cat <<'EOF'
Usage: vb-webapp-remove [OPTION]... [NAME]...

Remove Progressive Web App shortcuts as .desktop launcher entries.
If no NAMEs or --file options are provided, the script runs in interactive mode.

Options:
  --file FILE...      .desktop file(s) to remove (basename or full path)
  -h, --help          Show this help and exit
EOF
}

_remove_pwa() {
  local name="$1"
  local desktop_path="$2"
  local removed=false

  [[ -f "$desktop_path" ]] && {
    rm -f -- "$desktop_path"
    removed=true
  }
  [[ -f "$ICON_DIR/PWA - $name.png" ]] && {
    rm -f -- "$ICON_DIR/PWA - $name.png"
    removed=true
  }

  if [[ "$removed" == true ]]; then
    [[ $INTERACTIVE == true ]] &&
      echo "${GREEN}[VIBRANIUM]${RESET} Removed ${BLUE}${name}${RESET}" ||
      echo "Removed ${BLUE}${name}${RESET}"
  else
    echo "No such PWA: ${BLUE}${name}${RESET}" >&2
  fi
}

_desktop_name() {
  local file="$1"
  local name
  name=$(grep '^Name=' "$file" | head -1)
  name="${name#Name=}"
  name="${name#PWA - }"
  echo "$name"
}

APP_NAMES=()
DESKTOP_FILES=()
INTERACTIVE=true

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    _usage
    exit 0
    ;;

  --file)
    INTERACTIVE=false
    shift
    if [[ $# -eq 0 ]]; then
      echo "${RED}[VIBRANIUM]${RESET} Error: --file requires at least one .desktop file argument" >&2
      echo "Try ${0##*/} --help for more information" >&2
      exit 1
    fi
    while [[ $# -gt 0 && "$1" != -* ]]; do
      if [[ "$1" != *.desktop ]]; then
        echo "${RED}[VIBRANIUM]${RESET} Error: not a .desktop file: $1" >&2
        echo "Try ${0##*/} --help for more information" >&2
        exit 1
      fi
      DESKTOP_FILES+=("$1")
      shift
    done
    ;;

  -*)
    echo "Unknown option: $1" >&2
    echo "${0##*/} --help for more information" >&2
    exit 1
    ;;

  *)
    echo "Unknown option: $1" >&2
    echo "${0##*/} --help for more information" >&2
    exit 1
    ;;
  esac
done

if [[ ${#APP_NAMES[@]} -gt 0 && ${#DESKTOP_FILES[@]} -gt 0 ]]; then
  echo "${RED}[VIBRANIUM]${RESET} Error: use either positional PWA names or --file, not both" >&2
  echo "Try ${0##*/} --help for more information" >&2
  exit 1
fi

# --- Resolve targets: parallel arrays of (name, desktop_path) ---

TARGET_NAMES=()
TARGET_PATHS=()

if [[ $INTERACTIVE == true ]]; then
  term::show_header

  declare -A PWA_MAP
  while IFS= read -r -d '' file; do
    if grep -q '^Exec=.*vb-webapp-launch.*' "$file"; then
      PWA_MAP["$(_desktop_name "$file")"]="$file"
    fi
  done < <(find "$DESKTOP_DIR" -name 'PWA - *.desktop' -print0)

  if ((${#PWA_MAP[@]} == 0)); then
    term::show_header --color red
    echo "${RED}[VIBRANIUM]${RESET} No PWAs found"
    _operation_canceled
    exit 1
  fi

  mapfile -t SELECTED < <(printf '%s\n' "${!PWA_MAP[@]}" | sort | fzf "${FZF_ARGS[@]}")

  if ((${#SELECTED[@]} == 0)); then
    _operation_canceled
    exit 1
  fi

  count=${#SELECTED[@]}
  ((count == 1)) && suffix="" || suffix="s"

  if ! term::ask_yes_no Y "You're about to remove $count PWA${suffix}. Continue?"; then
    _operation_canceled
    exit 1
  fi

  for name in "${SELECTED[@]}"; do
    TARGET_NAMES+=("$name")
    TARGET_PATHS+=("${PWA_MAP[$name]}")
  done

else
  for name in "${APP_NAMES[@]}"; do
    TARGET_NAMES+=("$name")
    TARGET_PATHS+=("$DESKTOP_DIR/PWA - $name.desktop")
  done

  for file_arg in "${DESKTOP_FILES[@]}"; do
    [[ "$file_arg" == */* ]] && desktop_path="$file_arg" || desktop_path="$DESKTOP_DIR/$file_arg"

    if [[ ! -f "$desktop_path" ]]; then
      echo "No such file: $file_arg" >&2
      continue
    fi

    filename="${desktop_path##*/}"

    if [[ "$filename" != PWA\ -\ *.desktop ]]; then
      echo "Warning: not a PWA file: $filename" >&2
      continue
    fi

    TARGET_NAMES+=("$(_desktop_name "$desktop_path")")
    TARGET_PATHS+=("$desktop_path")
  done
fi

# --- Remove all targets ---

for i in "${!TARGET_NAMES[@]}"; do
  _remove_pwa "${TARGET_NAMES[$i]}" "${TARGET_PATHS[$i]}"
done

[[ $INTERACTIVE == true ]] && _operation_complete
