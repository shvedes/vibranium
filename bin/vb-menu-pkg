#!/usr/bin/env bash

source vb-core-lib

ACTIONS=(
    "Install"
    "Uninstall"
    "System update"
)

while true; do
    CHOSEN="$(printf "%s\n" "${ACTIONS[@]}" | helpers::ui::menu "Packages" "ESC to go back")"
    [[ -z $CHOSEN ]] && break

    case "$CHOSEN" in
        "Install")
            while true; do
                install_chosen="$(printf "Package\nFont" | helpers::ui::menu "Install" "ESC to go back")"
                [[ -z "$install_chosen" ]] && break

                case "$install_chosen" in
                    "Package")
                        vb-core-term vb-pkg-install
                        vb-cmd-kill-rofi
                        exit 0
                        ;;
                    "Font")
                        vb-core-term vb-pkg-font-install
                        vb-cmd-kill-rofi
                        exit 0
                        ;;
                    *)
                        continue
                        ;;
                esac
            done
            ;;
        "Uninstall")
            while true; do
                uninstall_chosen="$(printf "Package\nFont" | helpers::ui::menu "Uninstall" "ESC to go back")"
                [[ -z "$uninstall_chosen" ]] && break

                case "$uninstall_chosen" in
                    "Package")
                        vb-core-term vb-pkg-uninstall
                        vb-cmd-kill-rofi
                        exit 0
                        ;;
                    "Font")
                        vb-core-term vb-pkg-font-remove
                        vb-cmd-kill-rofi
                        exit 0
                        ;;
                    *)
                        continue
                        ;;
                esac
            done
            ;;
        "System update")
            vb-core-term vb-pkg-sysupdate
            vb-cmd-kill-rofi
            exit 0
            ;;
        *)
            continue
            ;;
    esac
done
