#!/usr/bin/env bash

source vb-lib-core
source vb-lib-cfgr

_launch() {
  vb-core-term --floating -- "$1"
  helpers::ui::close_menus
}

_build_install() {
  _b() {
    cfgr::item::action --label "Package" --func "_launch vb-pkg-install"
    cfgr::item::action --label "Font" --func "_launch vb-pkg-font-install"
  }
  cfgr::run "Install" "_b"
}

_build_remove() {
  _b() {
    cfgr::item::action --label "Package" --func "_launch vb-pkg-remove"
    cfgr::item::action --label "Font" --func "_launch vb-pkg-font-remove"
  }
  cfgr::run "Uninstall" "_b"
}

_build() {
  cfgr::item::action --label "Install" --func "_build_install"
  cfgr::item::action --label "Uninstall" --func "_build_remove"
  cfgr::item::action --label "System update" --func "_launch vb-pkg-update"
  cfgr::item::action --label "Vibranium update" --func "_launch vb-update"
}

cfgr::run "Packages" "_build"
