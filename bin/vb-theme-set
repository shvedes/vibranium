#!/usr/bin/env bash

# shellcheck disable=SC2206

source vb-lib-core

# Populated by _discover_themes at startup.
# FAMILIES maps family display name -> space-separated variant display names.
# STANDALONE_THEMES maps display name -> display name (value == key).
# FOLDER_MAP maps the "CHOSEN" key (Family-Variant or standalone Name)
# to the actual directory name under the themes source.
declare -A FAMILIES=()
declare -A STANDALONE_THEMES=()
declare -A FOLDER_MAP=()

# Maps folder name -> "true"/"false". Populated by _discover_in_dir.
# If a folder has no light metadata at all, the key is absent and apply_theme
# falls back to the folder-name regex as a last resort.
declare -A THEME_LIGHT=()
#
# Maps folder name -> "official" | "user". Drives which source path is used
# as the base copy in apply_theme; user-only themes skip the official copy step.
declare -A THEME_SOURCE=()

CURRENT_THEME_PATH="$XDG_CONFIG_HOME/vibranium/current/theme"
NEXT_THEME_PATH="$XDG_CONFIG_HOME/vibranium/current/next-theme"
THEME_NAME_FILE="$XDG_CONFIG_HOME/vibranium/current/theme.name"
USER_THEMES_PATH="$XDG_CONFIG_HOME/vibranium/themes"

# "tokyonight-night" -> "Tokyonight-Night"
capitalize() {
  local IFS=- parts result=()
  read -ra parts <<<"$1"
  local part
  for part in "${parts[@]}"; do
    result+=("${part^}")
  done
  printf "${result[*]}"
}

# Process one themes directory and register every theme found into the
# global FAMILIES / STANDALONE_THEMES / FOLDER_MAP / THEME_LIGHT / THEME_SOURCE maps.
#
# source_label ("official" or "user") is recorded per folder so apply_theme
# knows which base path to copy from. User entries win on collision, allowing
# a user-local copy of an official theme to fully replace it.
#
# For each subdirectory the light/dark flag is resolved in priority order:
#   1. LIGHT= field in theme.info  (native format)
#   2. theme.light file            (Omarchy-compatible fallback)
#   3. Absent — apply_theme falls back to a folder-name regex at runtime
#
# Family/variant metadata priority:
#   1. theme.info (FAMILY= / VARIANT= fields)
#   2. Derived from folder name — no file written for unrecognised folders
#      (safe for bare git repos dropped into the directory)
_discover_in_dir() {
  local dir="$1"
  local source_label="${2:-official}"
  local theme_dir folder family variant light chosen key val

  for theme_dir in "$dir"/*/; do
    [[ -d "$theme_dir" ]] || continue

    folder="${theme_dir%/}"
    folder="${folder##*/}"

    family=""
    variant=""
    light=""

    if [[ -f "$theme_dir/theme.info" ]]; then
      # Read all recognised fields; silently ignore blank/unknown lines
      while IFS='=' read -r key val; do
        case "$key" in
        FAMILY) family="$val" ;;
        VARIANT) variant="$val" ;;
        LIGHT) light="$val" ;;
        esac
      done <"$theme_dir/theme.info"
    else
      # Fallback: derive family/variant from folder name; do NOT write theme.info
      if [[ "$folder" != *-* ]]; then
        family=""
        variant="${folder^}"
      else
        local prefix="${folder%%-*}"
        local suffix="${folder#*-}"
        family="${prefix^}"
        variant="${suffix^}"
      fi

      # Omarchy-compatible light flag: read from theme.light if present
      if [[ -f "$theme_dir/theme.light" ]]; then
        light="$(<"$theme_dir/theme.light")"
        light="${light,,}" # normalise to lowercase
      fi
    fi

    [[ -n "$light" ]] && THEME_LIGHT["$folder"]="$light"

    # A user folder whose name matches an existing official theme is a plain
    # override: leave THEME_SOURCE as "official" so apply_theme performs the
    # base+overlay copy, and skip re-registering to prevent a duplicate menu entry.
    # A user folder with no official counterpart — regardless of whether it has
    # a .git directory — is a new user-authored theme and must be registered.
    if [[ "$source_label" == "user" && -d "$VIBRANIUM/themes/$folder" ]]; then
      continue
    fi

    # User entries overwrite official ones so a user-local copy takes full precedence
    THEME_SOURCE["$folder"]="$source_label"

    if [[ -z "$family" ]]; then
      STANDALONE_THEMES["$variant"]="$variant"
      FOLDER_MAP["$variant"]="$folder"
    else
      if [[ -z "${FAMILIES[$family]+_}" ]]; then
        FAMILIES["$family"]="$variant"
      else
        FAMILIES["$family"]+=" $variant"
      fi
      chosen="${family}-${variant}"
      FOLDER_MAP["$chosen"]="$folder"
    fi
  done
}

_discover_themes() {
  _discover_in_dir "$VIBRANIUM/themes" "official"

  # User themes in $USER_THEMES_PATH are layered on top of official ones.
  # A folder present in both acts as a full user-override of the official theme
  # (source_label "user" wins the collision). A folder present only here is a
  # user-local theme with no official counterpart.
  if [[ -d "$USER_THEMES_PATH" ]]; then
    _discover_in_dir "$USER_THEMES_PATH" "user"
  fi
}

get_current_target_basename() {
  if [[ -f "$THEME_NAME_FILE" ]]; then
    cat "$THEME_NAME_FILE"
  else
    echo ""
  fi
}

is_current_theme() {
  local theme="$1"
  local curr_basename
  curr_basename="$(get_current_target_basename)"

  [[ -z "$curr_basename" ]] && return 1
  [[ "${curr_basename,,}" == "${theme,,}" ]]
}

# Sort keys descending by length
_sort_by_length_desc() {
  local -n _arr="$1"
  local key
  mapfile -t _arr < <(
    for key in "${_arr[@]}"; do
      printf '%d %s\n' "${#key}" "$key"
    done | sort -rn | while read -r _ key; do
      printf '%s\n' "$key"
    done
  )
}

_build_family_keys() {
  # Populate the nameref array with sorted family+standalone keys
  local -n _keys="$1"
  _keys=(
    "${!FAMILIES[@]}"
    "${!STANDALONE_THEMES[@]}"
  )
  _sort_by_length_desc _keys
}

_find_index() {
  # Echo the 0-based index of $2 in array named $1, or 0 if not found
  local -n _arr="$1"
  local needle="$2"
  local i
  for i in "${!_arr[@]}"; do
    [[ "${_arr[$i]}" == "$needle" ]] && {
      echo "$i"
      return
    }
  done
  echo 0
}

pick_family() {
  local selected_row="${1:-0}"
  local keys=()
  _build_family_keys keys

  local family_chosen
  while true; do
    helpers::ui::menu \
      family_chosen "Theme" "" \
      -selected-row "$selected_row" \
      -theme-str 'window{width: 300px;}' \
      -- "${keys[@]}"
    [[ -z "$family_chosen" ]] && exit 0

    local k
    for k in "${keys[@]}"; do
      [[ "$k" == "$family_chosen" ]] && {
        echo "$family_chosen"
        return 0
      }
    done
  done
}

pick_variant() {
  local family="$1"
  local selected_row="${2:-0}"
  local variants=(${FAMILIES[$family]})
  _sort_by_length_desc variants

  local items=() v
  for v in "${variants[@]}"; do
    items+=("${v//-/ }")
  done

  local display
  while true; do
    helpers::ui::menu display "$family" "flavor" -selected-row "$selected_row" -- "${items[@]}"
    [[ -z "$display" ]] && return 1

    for v in "${items[@]}"; do
      [[ "$v" == "$display" ]] && {
        echo "$display"
        return 0
      }
    done
  done
}

apply_theme() {
  local chosen="$1"
  local folder_name="$2"

  # Resolve the base source path: user-only themes copy from USER_THEMES_PATH;
  # official themes (with or without a user overlay) copy from VIBRANIUM/themes.
  local source_label="${THEME_SOURCE[$folder_name]:-official}"
  local src_path
  if [[ "$source_label" == "user" ]]; then
    src_path="$USER_THEMES_PATH/$folder_name"
  else
    src_path="$VIBRANIUM/themes/$folder_name"
  fi

  if [[ ! -d "$src_path" ]]; then
    log::error "Theme folder $src_path does not exist."
    exit 1
  fi

  if is_current_theme "$folder_name"; then
    log::error "Already on $chosen"
    notify-send -r 4 -t 1500 "Theme Selector" "Already on $chosen"
    exit 1
  fi

  # Stage into next-theme first so the swap into current is atomic.
  # This means a crash or signal mid-copy can't leave current/theme half-written.
  rm -rf "$NEXT_THEME_PATH"
  mkdir -p "$NEXT_THEME_PATH"
  mkdir -p "$CURRENT_THEME_PATH"

  # Base layer: official theme (or the user-only theme when there is no official counterpart).
  # Exclude backgrounds/ from the synchronous pass — it's the only thing that's ever slow.
  find "$src_path" -maxdepth 1 -mindepth 1 ! -name "backgrounds" -exec cp -r {} "$NEXT_THEME_PATH/" \;

  if [[ -d "$src_path/backgrounds" ]]; then
    mkdir -p "$NEXT_THEME_PATH/backgrounds"
    cp -rl "$src_path/backgrounds/." "$NEXT_THEME_PATH/backgrounds/"
  fi

  # Overlay layer: user customisations on top of an official base.
  # Files present in USER_THEMES_PATH/$folder_name overwrite their official
  # counterparts; files absent from the overlay are inherited from the base.
  if [[ "$source_label" == "official" && -d "$USER_THEMES_PATH/$folder_name" ]]; then
    find "$USER_THEMES_PATH/$folder_name" -maxdepth 1 -mindepth 1 \
      ! -name "backgrounds" -exec cp -r {} "$NEXT_THEME_PATH/" \;

    if [[ -d "$USER_THEMES_PATH/$folder_name/backgrounds" ]]; then
      cp -rl "$USER_THEMES_PATH/$folder_name/backgrounds/." "$NEXT_THEME_PATH/backgrounds/"
    fi
  fi

  vb-theme-set-templates

  # Atomic swap: replace current with the fully-built staging directory
  rm -rf "$CURRENT_THEME_PATH"
  mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

  # Record the active theme name for is_current_theme and external tooling
  echo "$folder_name" >"$THEME_NAME_FILE"

  # Determine light/dark from discovery metadata; fall back to folder-name
  # regex for themes that carry no light flag in either theme.info or theme.light
  local is_light=false
  if [[ -n "${THEME_LIGHT[$folder_name]+_}" ]]; then
    [[ "${THEME_LIGHT[$folder_name]}" == "true" ]] && is_light=true
  elif [[ $folder_name =~ (light|latte|dawn)$ ]]; then
    is_light=true
  fi

  if $is_light; then
    local icon_theme="Papirus-Light"

    sed -i "/custom_palette/s/=.*/=false/" "$XDG_CONFIG_HOME/qt6ct/qt6ct.conf"
    sed -i "/custom_palette/s/=.*/=false/" "$XDG_CONFIG_HOME/qt5ct/qt5ct.conf"
  else
    local icon_theme="Papirus-Dark"

    sed -i "/custom_palette/s/=.*/=true/" "$XDG_CONFIG_HOME/qt6ct/qt6ct.conf"
    sed -i "/custom_palette/s/=.*/=true/" "$XDG_CONFIG_HOME/qt5ct/qt5ct.conf"
  fi

  # QT{5,6}CT won't detect this change automatically, so trigger
  touch "$XDG_CONFIG_HOME/qt6ct/qt6ct.conf" "$XDG_CONFIG_HOME/qt5ct/qt5ct.conf"

  gsettings set org.gnome.desktop.interface icon-theme "$icon_theme"
}

get_wallpaper() {
  local state_dir="$VIBRANIUM_STATE/wallpaper"
  local state_file="$state_dir/${1,,}"

  if [[ ! -d $state_dir ]]; then
    mkdir -p "$state_dir"
  else
    if [[ -f "$state_file" ]]; then
      local saved_wallpaper
      saved_wallpaper="$(<"$state_file")"
      if [[ -f "$saved_wallpaper" ]]; then
        echo "$saved_wallpaper"
        return 0
      fi
    fi
  fi

  find "$CURRENT_THEME_PATH/backgrounds/" -type f | head -n1
}

show_help() {
  cat <<EOF
Usage: ${0##*/} [OPTION]... [THEME]

Apply a Vibranium theme. With no THEME argument an interactive picker is
launched. With a THEME argument the theme is applied non-interactively.

Options:
  -h, --help        Show this help text and exit
  -l, --list        List all available theme names and exit

Arguments:
  THEME             Theme to apply. Accepted formats (case-insensitive):
                    gruvbox-hard      folder name
                    Gruvbox-Hard      capitalized folder name
                    "Gruvbox Hard"    space-separated family + variant

                    Standalone themes (no variant) are passed as a single
                    word, e.g.: evergarden

Examples:
  ${0##*/}                        Launch interactive picker
  ${0##*/} gruvbox-hard           Apply by folder name directly
  ${0##*/} Catppuccin-Mocha       Apply by capitalized name
  ${0##*/} "Tokyonight Night"     Apply with a space-separated name
EOF
}

list_themes() {
  local family variant
  local -a names=()

  for family in "${!FAMILIES[@]}"; do
    for variant in ${FAMILIES[$family]}; do
      names+=("${FOLDER_MAP[${family}-${variant}]}")
    done
  done

  for family in "${!STANDALONE_THEMES[@]}"; do
    names+=("${FOLDER_MAP[$family]}")
  done

  printf '%s\n' "${names[@]}" | sort
}

# Discover themes before any command handling
_discover_themes

case "${1-}" in
-h | --help)
  show_help
  exit 0
  ;;
-l | --list)
  list_themes
  exit 0
  ;;
esac

if [[ -n "$1" ]]; then
  # Normalise spaces to hyphens ("Tokyonight Night" -> "Tokyonight-Night")
  INPUT_THEME="${1// /-}"

  # Fast path: $1 is already a valid theme folder name (case-insensitive).
  # Check official themes dir first, then user themes dir, before attempting
  # any family/variant parsing so callers can pass folder names directly.
  if [[ -d "$VIBRANIUM/themes/${INPUT_THEME,,}" ]]; then
    FOLDER_NAME="${INPUT_THEME,,}"
    CHOSEN="$(capitalize "$FOLDER_NAME")"
  elif [[ -d "$USER_THEMES_PATH/${INPUT_THEME,,}" ]]; then
    FOLDER_NAME="${INPUT_THEME,,}"
    CHOSEN="$(capitalize "$FOLDER_NAME")"
  else
    # Structured path: Family[-Variant] parsing against discovered data
    FAMILY="${INPUT_THEME%%-*}"
    VARIANT="${INPUT_THEME#*-}"

    if [[ -z "${FAMILIES[$FAMILY]+_}" ]]; then
      log::error "Family '$FAMILY' not found. Run '${0##*/} --list' to see available themes."
      exit 1
    fi

    VARIANT_FOUND=false
    for v in ${FAMILIES[$FAMILY]}; do
      if [[ "${v,,}" == "${VARIANT,,}" ]]; then
        VARIANT_FOUND=true
        VARIANT="$v" # use the canonical casing from discovery
        break
      fi
    done

    if ! $VARIANT_FOUND; then
      log::error "Variant '$VARIANT' not found in family '$FAMILY'. Run '${0##*/} --list' to see available themes."
      exit 1
    fi

    CHOSEN="${FAMILY}-${VARIANT}"
    FOLDER_NAME="${FOLDER_MAP[$CHOSEN]}"
  fi
else
  declare -A _last_variant_row=()
  _family_row=0

  while true; do
    FAMILY="$(pick_family "$_family_row")" || exit 1
    [ -z "$FAMILY" ] && exit 1

    # Remember which row this family sits on for when we return
    _fkeys=()
    _build_family_keys _fkeys
    _family_row="$(_find_index _fkeys "$FAMILY")"

    if [[ -n "${STANDALONE_THEMES[$FAMILY]+_}" ]]; then
      CHOSEN="${STANDALONE_THEMES[$FAMILY]}"
      FOLDER_NAME="${FOLDER_MAP[$CHOSEN]}"
      break
    fi

    VARIANT_DISPLAY="$(pick_variant "$FAMILY" "${_last_variant_row[$FAMILY]:-0}")"
    if [[ -z "$VARIANT_DISPLAY" ]]; then
      # Escape pressed - go back to family menu with cursor restored
      continue
    fi

    # Remember which variant row was chosen for this family
    _vvariants=(${FAMILIES[$FAMILY]})
    _sort_by_length_desc _vvariants
    _vitems=()
    for _vv in "${_vvariants[@]}"; do _vitems+=("${_vv//-/ }"); done
    _last_variant_row[$FAMILY]="$(_find_index _vitems "$VARIANT_DISPLAY")"

    VARIANT="${VARIANT_DISPLAY// /-}"
    CHOSEN="${FAMILY}-${VARIANT}"
    FOLDER_NAME="${FOLDER_MAP[$CHOSEN]}"
    break
  done
fi

if [[ -z "$FOLDER_NAME" ]]; then
  log::error "Theme '$CHOSEN' could not be resolved to a folder."
  exit 1
fi

# Verify the resolved folder actually exists in at least one source location
if [[ ! -d "$VIBRANIUM/themes/$FOLDER_NAME" && ! -d "$USER_THEMES_PATH/$FOLDER_NAME" ]]; then
  log::error "Theme '$CHOSEN' could not be resolved to a folder."
  exit 1
fi

apply_theme "$CHOSEN" "$FOLDER_NAME"

touch "$XDG_CONFIG_HOME/alacritty/alacritty.toml"
vb-core-wallpaper "$(get_wallpaper "$FOLDER_NAME")" &

killall -s USR2 btop &>/dev/null

vb-cmd-reload --quiet

vb-theme-set-browser &
vb-theme-set-gtk &

vb-theme-set-obsidian &
vb-theme-set-svg &
