#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

# extglob enables the non-background globs used when copying a theme,
# while dotglob includes hidden metadata and nullglob prevents an empty
# match from becoming a literal path during copy operations.
shopt -s extglob dotglob nullglob

# Populated by _discover_themes at startup.
# FAMILIES maps family display name -> space-separated variant display names.
# STANDALONE_THEMES maps display name -> display name (value == key).
# FOLDER_MAP maps the "CHOSEN" key (Family-Variant or standalone Name)
# to the actual directory name under the themes source.
declare -A FAMILIES=()
declare -A STANDALONE_THEMES=()
declare -A FOLDER_MAP=()

# Maps folder name -> "true"/"false". Populated by _discover_in_dir.
# If a folder has no light metadata at all, the key is absent and the
# theme reads as dark.
declare -A THEME_LIGHT=()
#
# Maps folder name -> "official" | "user". Drives which source path is used
# as the base copy in apply_theme; user-only themes skip the official copy step.
declare -A THEME_SOURCE=()

CURRENT_THEME_PATH="$VIBRANIUM_STATE/theme"
NEXT_THEME_PATH="$VIBRANIUM_CACHE/next-theme"
THEME_NAME_FILE="$VIBRANIUM_STATE/theme.name"
USER_THEMES_PATH="$XDG_CONFIG_HOME/vibranium/themes"
HOOK_DIR="$XDG_CONFIG_HOME/vibranium/hooks/theme"

SELF="${0##*/}"
FORCE=false

# $XDG_CONFIG_HOME/vibranium/settings.advanced can provide family, variant, or
# folder-glob entries that hide themes from the picker.
vb_hidden_themes=()

_settings_adv="$XDG_CONFIG_HOME/vibranium/settings.advanced"
if [[ -f $_settings_adv ]]; then
  log Info "sourcing settings.advanced"
  source "$_settings_adv"
fi
unset _settings_adv

# "tokyonight-night" -> "Tokyonight-Night"
capitalize() {
  local -n _cap_out=$1
  local -a _cap_parts=()
  local IFS=- _cap_part
  read -ra _cap_parts <<< "$2"
  local -a _cap_result=()
  for _cap_part in "${_cap_parts[@]}"; do
    _cap_result+=("${_cap_part^}")
  done
  _cap_out="${_cap_result[*]}"
}

# "morning-lavender" -> "Morning Lavender"  (hyphens become spaces, each word capitalised)
# Used for community themes that have no theme.info and would otherwise be
# mis-parsed as a family/variant pair by the hyphen heuristic.
capitalize_words() {
  local -n _cw_out=$1
  local -a _cw_parts=()
  local IFS=- _cw_part
  read -ra _cw_parts <<< "$2"
  local _cw_text=""
  for _cw_part in "${_cw_parts[@]}"; do
    _cw_text+="${_cw_part^} "
  done
  _cw_out="${_cw_text% }"
}

# Returns 0 if the theme should be hidden from the picker via the
# vb_hidden_themes array in settings.advanced, 1 otherwise. Entries are
# case-insensitive and support bash glob wildcards:
#   "catppuccin"        -- hide the whole family
#   "catppuccin/latte"  -- hide a single variant
#   "gruvbox-*"         -- hide by folder-name glob
_theme_hidden() {
  local folder="$1" family="$2" variant="$3"
  local entry fam var

  ((${#vb_hidden_themes[@]} > 0)) || return 1

  for entry in "${vb_hidden_themes[@]}"; do
    if [[ "$entry" == */* ]]; then
      fam="${entry%%/*}"
      var="${entry#*/}"
      if [[ -n "$family" ]]; then
        # shellcheck disable=SC2053
        if [[ "${family,,}" == ${fam,,} ]]; then
          # shellcheck disable=SC2053
          if [[ "${variant,,}" == ${var,,} ]]; then
            return 0
          fi
        fi
      fi
    else
      # shellcheck disable=SC2053
      if [[ -n "$family" && "${family,,}" == ${entry,,} ]]; then
        return 0
      fi
      # shellcheck disable=SC2053
      if [[ -z "$family" && "${variant,,}" == ${entry,,} ]]; then
        return 0
      fi
      # shellcheck disable=SC2053
      if [[ "${folder,,}" == ${entry,,} ]]; then
        return 0
      fi
    fi
  done

  return 1
}

# Registers each theme directory and records its source. A user directory
# matching an official folder remains an overlay on the official base; a
# user-only directory supplies its own source. theme.info supplies family,
# variant, and light metadata, with filename-based fallbacks.
_discover_in_dir() {
  local dir="$1"
  local source_label="${2:-official}"
  local theme_dir folder family variant light chosen key val

  log Info "discovering $source_label themes in $dir"

  for theme_dir in "$dir"/*/; do
    if [[ ! -d "$theme_dir" ]]; then
      continue
    fi

    # Archived wallpapers of an uninstalled community theme; not a theme.
    [[ -e "$theme_dir/.uninstalled" ]] && continue

    folder="${theme_dir%/}"
    folder="${folder##*/}"

    family=""
    variant=""
    light=""

    if [[ -f "$theme_dir/theme.info" ]]; then
      # Read all recognised fields; silently ignore blank/unknown lines
      while IFS='=' read -r key val; do
        [[ $key == FAMILY ]] && family=$val
        [[ $key == VARIANT ]] && variant=$val
        [[ $key == LIGHT ]] && light=$val
      done < "$theme_dir/theme.info"
    else
      # Fallback: derive display name from folder name; do NOT write theme.info.
      # For official themes, a hyphen splits family from variant (e.g.
      # "tokyonight-night" -> family "Tokyonight", variant "Night").
      # For user/community themes, hyphens are word separators in a name;
      # there is no reliable way to know that "morning-lavender" is meant as a
      # family/variant pair rather than a two-word standalone name, so every
      # user theme without an explicit theme.info is always standalone.
      if [[ "$source_label" == "user" ]]; then
        family=""
        capitalize_words variant "$folder"
      elif [[ "$folder" != *-* ]]; then
        family=""
        variant="${folder^}"
      else
        local prefix="${folder%%-*}"
        local suffix="${folder#*-}"
        family="${prefix^}"
        variant="${suffix^}"
      fi
    fi

    [[ -n "$light" ]] && THEME_LIGHT["$folder"]="$light"

    if _theme_hidden "$folder" "$family" "$variant"; then
      log Info "  $folder: hidden via vb_hidden_themes, skipping"
      continue
    fi

    # A user folder whose name matches an existing official theme is a plain
    # override: leave THEME_SOURCE as "official" so apply_theme performs the
    # base+overlay copy, and skip re-registering to prevent a duplicate menu entry.
    # A user folder with no official counterpart - regardless of whether it has
    # a .git directory - is a new user-authored theme and must be registered.
    if [[ "$source_label" == "user" && -d "$VIBRANIUM/themes/$folder" ]]; then
      log Info "  $folder: user override of official theme, skipping re-registration"
      continue
    fi

    # Record the source used by apply_theme; matching user folders remain overlays.
    THEME_SOURCE["$folder"]="$source_label"

    if [[ -z "$family" ]]; then
      STANDALONE_THEMES["$variant"]="$variant"
      FOLDER_MAP["$variant"]="$folder"
    else
      if [[ -z "${FAMILIES[$family]+_}" ]]; then
        FAMILIES["$family"]="$variant"
      else
        FAMILIES["$family"]+=" $variant"
      fi
      chosen="${family}-${variant}"
      FOLDER_MAP["$chosen"]="$folder"
    fi

    log Info "  $folder ($source_label) -> ${family:-standalone}${family:+/$variant}"
  done
}

# A family with one variant is represented as a standalone display key so
# the picker exposes a leaf instead of an empty family branch. FOLDER_MAP
# retains the concrete directory name for the eventual application.
_promote_singles() {
  local family variants chosen display
  for family in "${!FAMILIES[@]}"; do
    read -ra variants <<< "${FAMILIES[$family]}"
    ((${#variants[@]} == 1)) || continue
    chosen="${family}-${variants[0]}"
    display="${family} ${variants[0]}"
    STANDALONE_THEMES["$display"]="$display"
    FOLDER_MAP["$display"]="${FOLDER_MAP[$chosen]}"
    unset "FAMILIES[$family]"
  done
}

_discover_themes() {
  _discover_in_dir "$VIBRANIUM/themes" "official"

  # Official folders are registered first. Matching user folders overlay the
  # official base; user-only folders supply their own source.
  if [[ -d "$USER_THEMES_PATH" ]]; then
    _discover_in_dir "$USER_THEMES_PATH" "user"
  fi

  _promote_singles

  log Info "discovery complete: ${#FAMILIES[@]} families, ${#STANDALONE_THEMES[@]} standalone"
}

is_current_theme() {
  local theme="$1" curr_basename
  [[ -f "$THEME_NAME_FILE" ]] || return 1
  IFS= read -r curr_basename < "$THEME_NAME_FILE" || [[ -n $curr_basename ]]
  [[ -z "$curr_basename" ]] && return 1
  [[ "${curr_basename,,}" == "${theme,,}" ]]
}

# Resolves the persisted folder name to its discovered family/variant or
# standalone key; matching is informational and does not apply a theme.
_resolve_active_theme() {
  [[ -f "$THEME_NAME_FILE" ]] || return
  local curr_folder
  IFS= read -r curr_folder < "$THEME_NAME_FILE" || [[ -n $curr_folder ]]
  [[ -z "$curr_folder" ]] && return

  local family variant
  for family in "${!FAMILIES[@]}"; do
    for variant in ${FAMILIES[$family]}; do
      local key="${family}-${variant}"
      if [[ "${FOLDER_MAP[$key]}" == "$curr_folder" ]]; then
        log Info "active theme resolved: $family/$variant ($curr_folder)"
        return
      fi
    done
  done

  for family in "${!STANDALONE_THEMES[@]}"; do
    if [[ "${FOLDER_MAP[$family]}" == "$curr_folder" ]]; then
      log Info "active theme resolved: $family ($curr_folder)"
      return
    fi
  done
}

apply_theme() {
  local chosen="$1"
  local folder_name="$2"

  # Resolve the base source path: user-only themes copy from USER_THEMES_PATH;
  # official themes (with or without a user overlay) copy from VIBRANIUM/themes.
  local source_label="${THEME_SOURCE[$folder_name]:-official}"
  local src_path

  if [[ "$source_label" == "user" ]]; then
    src_path="$USER_THEMES_PATH/$folder_name"
  else
    src_path="$VIBRANIUM/themes/$folder_name"
  fi

  log Info "applying $chosen | folder=$folder_name source=$source_label src=$src_path"

  if [[ ! -d "$src_path" ]]; then
    log Error "theme folder $src_path does not exist."
    exit 1
  fi

  if is_current_theme "$folder_name" && ! $FORCE; then
    log Error "already on $chosen"
    notify-send -r 4 -a "Vibranium" "Theme Selector" "Already on $chosen"
    exit 1
  fi

  # Build the replacement under NEXT_THEME_PATH. The rm+mv commit removes the
  # current directory first and therefore has a visibility gap.
  rm -rf "$NEXT_THEME_PATH"
  mkdir -p "$NEXT_THEME_PATH" "$NEXT_THEME_PATH/backgrounds" "$CURRENT_THEME_PATH"

  # Base layer: official theme (or the user-only theme when there is no official counterpart).
  # Exclude backgrounds/ from the synchronous pass - it's the only thing that's ever slow.
  local files=("$src_path"/!(backgrounds))

  if ((${#files[@]} > 0)); then
    cp -a -- "${files[@]}" "$NEXT_THEME_PATH/"
  fi

  # Wallpapers are hard-linked to avoid copying large files. The staged and
  # source paths share an inode until one path is replaced; in-place edits are
  # visible through both paths.
  if [[ -d "$src_path/backgrounds" ]]; then
    cp -rl "$src_path/backgrounds/." "$NEXT_THEME_PATH/backgrounds/"
  fi

  # Overlay layer: user customisations on top of an official base.
  # Files present in USER_THEMES_PATH/$folder_name overwrite their official
  # counterparts; files absent from the overlay are inherited from the base.
  if [[ "$source_label" == "official" && -d "$USER_THEMES_PATH/$folder_name" ]]; then
    log Info "user overlay found in $USER_THEMES_PATH/$folder_name, merging"
    files=("$USER_THEMES_PATH/$folder_name"/!(backgrounds))

    if ((${#files[@]} > 0)); then
      cp -a -- "${files[@]}" "$NEXT_THEME_PATH/"
    fi

    if [[ -d "$USER_THEMES_PATH/$folder_name/backgrounds" ]]; then
      cp -rl "$USER_THEMES_PATH/$folder_name/backgrounds/." "$NEXT_THEME_PATH/backgrounds/"
    fi
  fi

  # Resolve LIGHT from theme.info; absent metadata reads as dark. Export the
  # result for template rendering so mode-relative placeholders receive it.
  local is_light=false

  if [[ -n "${THEME_LIGHT[$folder_name]+_}" ]]; then
    [[ "${THEME_LIGHT[$folder_name]}" == "true" ]] && is_light=true
  fi

  log Info "light/dark detection: is_light=$is_light"

  export VB_THEME_IS_LIGHT="$is_light"
  export NEXT_THEME_NAME="$folder_name"

  # Create missing config files from templates
  vb-theme-set-templates

  # Commit the fully built staging directory. Removing the current directory
  # first creates a short visibility gap; the subsequent rename installs it.
  rm -rf "$CURRENT_THEME_PATH"
  mv "$NEXT_THEME_PATH" "$CURRENT_THEME_PATH"

  # The wallpaper watcher receives theme.name through Watch.subscribe. Writing
  # the name once the new backgrounds tree is in place orders the event after
  # the tree commit.
  printf "%s" "$folder_name" > "$THEME_NAME_FILE"

  if $is_light; then
    local icon_theme="Papirus-Light"
    local color_scheme="prefer-light"
  else
    local icon_theme="Papirus-Dark"
    local color_scheme="prefer-dark"
  fi

  custom_palette=true

  log Info "scheme=$color_scheme icon=$icon_theme custom_palette=$custom_palette"

  for v in 5 6; do
    _qt_conf="$XDG_CONFIG_HOME/qt${v}ct/qt${v}ct.conf"
    [[ -f $_qt_conf ]] || continue
    _qt_out=""
    while IFS= read -r _qt_line || [[ -n $_qt_line ]]; do
      if [[ $_qt_line == *custom_palette* && $_qt_line == *=* ]]; then
        _qt_line=${_qt_line%%=*}'='"$custom_palette"
      fi
      _qt_out+="$_qt_line"$'\n'
    done < "$_qt_conf"
    printf '%s' "$_qt_out" > "$_qt_conf"
  done

  # These gsettings writes are detached and unjoined, so they are best effort;
  # the committed directory does not guarantee desktop-setting convergence.
  gsettings set org.gnome.desktop.interface icon-theme "$icon_theme" &
  gsettings set org.gnome.desktop.interface color-scheme "$color_scheme" &
}

usage() {
  shcat << EOF
Usage: $SELF [OPTION]... [THEME]

Apply a Vibranium theme. With no THEME argument an interactive picker is
launched. With a THEME argument the theme is applied non-interactively.

Options:
  -v, --verbose     Enable verbose output
  -h, --help        Show this help text and exit
  -l, --list        List all available theme names and exit
  -f, --force       Forcefully set the active theme if selected

Arguments:
  THEME             Theme to apply. Accepted formats (case-insensitive):
                    gruvbox-hard      folder name
                    Gruvbox-Hard      capitalized folder name
                    "Gruvbox Hard"    space-separated family + variant

                    Standalone themes (no variant) are passed as a single
                    word, e.g.: evergarden

Examples:
  $SELF                        Launch interactive picker
  $SELF gruvbox-hard           Apply by folder name directly
  $SELF Catppuccin-Mocha       Apply by capitalized name
  $SELF "Tokyonight Night"     Apply with a space-separated name
EOF
}

list_themes() {
  local key family variant
  local -a names=()

  for family in "${!FAMILIES[@]}"; do
    for variant in ${FAMILIES[$family]}; do
      key="${family}-${variant}"
      names+=("${FOLDER_MAP[$key]}")
    done
  done

  for family in "${!STANDALONE_THEMES[@]}"; do
    names+=("${FOLDER_MAP[$family]}")
  done

  local i j key
  for ((i = 1; i < ${#names[@]}; i++)); do
    key=${names[i]}
    j=$((i - 1))

    while ((j >= 0)) && [[ ${names[j]} > $key ]]; do
      names[j + 1]=${names[j]}
      ((j--))
    done

    names[j + 1]=$key
  done

  printf '%s\n' "${names[@]}"
}

log Info "Starting theme selector"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -f | --force)
      FORCE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -l | --list)
      _discover_themes
      list_themes
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

_discover_themes

if [[ -n "$1" ]]; then
  # Normalise spaces to hyphens ("Tokyonight Night" -> "Tokyonight-Night")
  INPUT_THEME="${1// /-}"

  # Check official and user theme directories directly, without family/variant
  # parsing, so folder names remain valid inputs.
  if [[ -d "$VIBRANIUM/themes/${INPUT_THEME,,}" ]]; then
    FOLDER_NAME="${INPUT_THEME,,}"
    capitalize CHOSEN "$FOLDER_NAME"
  elif [[ -d "$USER_THEMES_PATH/${INPUT_THEME,,}" && ! -e "$USER_THEMES_PATH/${INPUT_THEME,,}/.uninstalled" ]]; then
    FOLDER_NAME="${INPUT_THEME,,}"
    capitalize CHOSEN "$FOLDER_NAME"
  else
    # Structured path: Family[-Variant] parsing against discovered data
    FAMILY="${INPUT_THEME%%-*}"
    VARIANT="${INPUT_THEME#*-}"

    if [[ -z "${FAMILIES[$FAMILY]+_}" ]]; then
      _display="${FAMILY} ${VARIANT}"
      if [[ -n "${STANDALONE_THEMES[$_display]+_}" ]]; then
        CHOSEN="$_display"
        FOLDER_NAME="${FOLDER_MAP[$_display]}"
      else
        log Error "family '$FAMILY' not found. Run '$SELF --list' to see available themes."
        exit 1
      fi
    else
      VARIANT_FOUND=false
      for v in ${FAMILIES[$FAMILY]}; do
        if [[ "${v,,}" == "${VARIANT,,}" ]]; then
          VARIANT_FOUND=true
          VARIANT="$v" # use the canonical casing from discovery
          break
        fi
      done

      if ! $VARIANT_FOUND; then
        log Error "variant '$VARIANT' not found in family '$FAMILY'. Run '$SELF --list' to see available themes."
        exit 1
      fi

      CHOSEN="${FAMILY}-${VARIANT}"
      FOLDER_NAME="${FOLDER_MAP[$CHOSEN]}"
    fi
  fi
else
  qs -p "$VIBRANIUM/shell" ipc call themePicker toggle > /dev/null 2>&1

  source vb-lib-core
  _resolve_active_theme

  declare -A _last_variant_row=()
  _family_row=0
fi

log Info "resolved: chosen=$CHOSEN folder=$FOLDER_NAME"

if [[ -z "$FOLDER_NAME" ]]; then
  log Error "theme '$CHOSEN' could not be resolved to a folder."
  exit 1
fi

# Verify the resolved folder actually exists in at least one source location
if [[ ! -d "$VIBRANIUM/themes/$FOLDER_NAME" && ! -d "$USER_THEMES_PATH/$FOLDER_NAME" ]]; then
  log Error "theme '$CHOSEN' could not be resolved to a folder."
  exit 1
fi

apply_theme "$CHOSEN" "$FOLDER_NAME"
log Info "theme files staged, applying wallpaper and reloading config"
vb-shell wallpaper refresh
touch "$XDG_CONFIG_HOME/alacritty/alacritty.toml"
hyprctl -q reload config-only
killall --quiet -s USR2 btop

log Info "running theme-set-* scripts"
# Theme setters are detached; the template renderer is skipped because
# apply_theme already rendered the staged tree.
for f in "$VIBRANIUM"/bin/vb-theme-set-*; do
  if [[ "${f##*/}" =~ templates$ ]]; then
    continue
  fi

  log Info "running '${f##*/}'"
  setsid -f "$f"
done

# Apply custom user hooks
# User hooks receive the committed folder name in THEME and run detached;
# their completion is not awaited here.
if [[ -d "$HOOK_DIR" ]]; then
  # shellcheck disable=SC2206
  HOOK_FILES=($HOOK_DIR/*.sh)

  if ((${#HOOK_FILES[@]} == 0)); then
    exit 0
  fi

  for hook in "${HOOK_FILES[@]}"; do
    log Info "running user hook '${hook##*/}'"
    env THEME="$FOLDER_NAME" setsid -f bash "$hook"
  done
fi
