#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"
source "$VIBRANIUM_PATH/configure/configure-lib"

INDEX=0

while true; do
    source "$VIBRANIUM_USER_SETTINGS"

    OPTIONS=(
        "Show HEX preview : $VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW"
        "Preview in notification : $VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR"
    )

    mapfile -t OPTIONS < <(align_options "${OPTIONS[@]}")
    CHOSEN="$(printf "%s\n" "${OPTIONS[@]}" | rofi_cmd "Color picker" "ESC to go back" -selected-row "$INDEX")"
    [ -z "$CHOSEN" ] && break

    for i in "${!OPTIONS[@]}"; do
        if [ "${OPTIONS[$i]}" = "$CHOSEN" ]; then
            INDEX="$i"
            break
        fi
    done

    case "$CHOSEN" in
        "Show HEX preview"*)
            toggle_bool "VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW"
            ;;
        "Preview in notification"*)
            toggle_bool "VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR"
            ;;
    esac
done
