#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vibranium-core-lib"
source "$VIBRANIUM_PATH/configure/configure-lib"

_pacman_weather_specific() {
    local options chosen index animate_loading \
        show_separators animate_updates

    index=0

    while true; do
        source "$VIBRANIUM_USER_SETTINGS"

        animate_loading="$VIBRANIUM_BAR_SHOW_ANIMATION"
        show_separators="$VIBRANIUM_BAR_SHOW_SEPARATOR"
        animate_updates="$VIBRANIUM_BAR_SHOW_ANIMATION_ON_REEXEC"

        options=(
            "Animate loading : $animate_loading"
            "Animate updates : $animate_updates"
            "Show separators : $show_separators"
        )
        chosen="$(printf "%s\n" "${options[@]}" | rofi_cmd "Extras" "ESC to go back" -selected-row "$index")"
        [[ -z "$chosen" ]] && return

        for i in "${!options[@]}"; do
            if [ "${options[$i]}" = "$chosen" ]; then
                index="$i"
                break
            fi
        done

        case "$chosen" in
            "Animate loading"*) toggle_bool "VIBRANIUM_BAR_SHOW_ANIMATION" ;;
            "Show separators"*) toggle_bool "VIBRANIUM_BAR_SHOW_SEPARATOR" ;;
            "Animate updates"*) toggle_bool "VIBRANIUM_BAR_SHOW_ANIMATION_ON_REEXEC"
        esac

        vibranium-cmd-refresh-waybar-module pacman &
        vibranium-cmd-refresh-waybar-module weather &
    done
}

_update_module_setting() {
    local var="$1"
    local type="$2"
    local rofi_title="$3"
    local rofi_subtitle="$4"
    local validation_regex="$5"
    local error_message="$6"
    local quote_value="$7"
    local module_name="$8"
    local enabled_var="$9"

    local current_value="${!var}"
    rofi_subtitle="${rofi_subtitle//\{current\}/$current_value}"

    while true; do
        new_value="$(printf "Enter new value ($type)" | rofi_cmd "$rofi_title" "$rofi_subtitle")"
        [ -z "$new_value" ] && break
        if [[ ! "$new_value" =~ $validation_regex ]]; then
            if [[ -n "$error_message" ]]; then
                notify-send -r 1 -u critical -t 2000 "Vibranium" "$error_message"
            fi
            continue
        fi
        option-validate "$var"
        if [[ "$quote_value" == "yes" ]]; then
            sed -i "s|^${var}=.*|${var}=\"${new_value}\"|" "$VIBRANIUM_USER_SETTINGS"
        else
            sed -i "/^${var}/s/=.*/=${new_value}/" "$VIBRANIUM_USER_SETTINGS"
        fi
        if [[ "${!enabled_var}" == false ]]; then
            notify-send -r 1 -t 5000 "Vibranium" \
                "The value has been changed. Don't forget to enable the module."
        fi
        vibranium-cmd-refresh-waybar-module "$module_name" &
        break
    done
}

INDEX=0

while true; do
    OPTIONS=("Pacman" "Weather")

    pacman_enabled="$VIBRANIUM_BAR_PACMAN_MODULE_ENABLE"
    weather_enabled="$VIBRANIUM_BAR_WEATHER_MODULE_ENABLE"

    if [[ "$pacman_enabled" == true && "$weather_enabled" == true ]]; then
        OPTIONS+=("<b>Pacman and Weather specific</b>")
    fi

    CHOSEN="$(printf "%s\n" "${OPTIONS[@]}" | rofi_cmd "Module settings" "ESC to go back" -selected-row "$INDEX")"
    [ -z "$CHOSEN" ] && exit 0

    for i in "${!OPTIONS[@]}"; do
        if [ "${OPTIONS[$i]}" = "$CHOSEN" ]; then
            INDEX="$i"
            break
        fi
    done

    case "$CHOSEN" in
        "<b>Pacman and Weather"*)
            _pacman_weather_specific
            ;;
        "Weather")
            update_module_setting "VIBRANIUM_BAR_WEATHER_MODULE_CITY" "string" \
                "City" "current is {current}" '^[A-Za-z]+$' "Invalid city name!" "yes" "weather" "weather_enabled"
            ;;

        "Pacman")
            update_module_setting "VIBRANIUM_BAR_PACMAN_MODULE_MINIMUM_PACKAGES_REQUIRED" "int" \
                "Display if ≥ N updates" "ESC to go back" '^[0-9]+$' "" "no" "pacman" "pacman_enabled"
            ;;
    esac
done
