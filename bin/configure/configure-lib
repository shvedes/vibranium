# update_enum "VAR_NAME" "rofi_title" "opt1" "[opt2...opt6]"
update_enum() {
    local var_name="$1"
    local title="$2"
    local options=("${@:3}")

    while true; do
        chosen="$(printf "%s\n" "${options[@]}" | rofi_cmd "$title" "ESC to go back")"
        [[ -z "$chosen" ]] && break

        # Check if the chosen option is in the list
        if [[ " ${options[*]} " =~ " ${chosen} " ]]; then
            option-validate "$var_name"
            sed -i "/^${var_name}=/s/=.*/=\"${chosen// /_}\"/" "$VIBRANIUM_USER_SETTINGS"
            break
        fi
    done
}

