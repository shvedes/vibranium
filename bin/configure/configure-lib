#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"
export PATH="$PATH:$VIBRANIUM_PATH/configure"

toggle_bool() {
    local verbose
    local setting_name
    local current_value

    if [ "$1" = "-v" ]; then
        verbose=true
        setting_name="$2"
    else
        verbose=false
        setting_name="$1"
    fi

    option-validate "$setting_name"
    eval "current_value=\$$setting_name"

    case "$current_value" in
        "true")
            sed -i "/^${setting_name}=/s/=.*/=false/" "$VIBRANIUM_USER_SETTINGS"
            [ "$verbose" = "true" ] && echo "false"
            ;;
        "false")
            sed -i "/^${setting_name}=/s/=.*/=true/" "$VIBRANIUM_USER_SETTINGS"
            [ "$verbose" = "true" ] && echo "true"
            ;;
    esac
}

align_options() {
    local options=("$@")
    local max_len=0
    local has_colon_options=()

    for option in "${options[@]}"; do
        if [[ "$option" =~ ^(.*)\ :\ (.*)$ ]]; then
            local label="${BASH_REMATCH[1]}"

            local clean_label
            clean_label=$(echo "$label" | sed 's/<[^>]*>//g')

            local len=${#clean_label}
            if (( len > max_len )); then
                max_len=$len
            fi
            has_colon_options+=("$option")
        fi
    done

    local aligned_options=()
    for option in "${options[@]}"; do
        if [[ "$option" =~ ^(.*)\ :\ (.*)$ ]]; then
            local label="${BASH_REMATCH[1]}"
            local value="${BASH_REMATCH[2]}"

            local clean_label
            clean_label=$(echo "$label" | sed 's/<[^>]*>//g')

            local len=${#clean_label}
            local padding=$((max_len - len))
            local padded_label="$label"

            for ((j=0; j<padding; j++)); do
                padded_label+=" "
            done

            if [[ "${value,,}" == "true" ]]; then
                value="yes"
            elif [[ "${value,,}" == "false" ]]; then
                value="no"
            fi
            aligned_options+=("$padded_label : $value")
        else
            aligned_options+=("$option")
        fi
    done

    for aligned in "${aligned_options[@]}"; do
        echo "$aligned"
    done
}

# Usage:
# edit_digit [--verify] "Prompt base" "Rofi title" "int|float" min max [OPTION_NAME] [SETTINGS_FILE]
#
# --verify  check-only mode: validate input and print it, do not call option-validate
#     and do not modify any files
edit_digit() {
    local check_only=false

    # parse flags
    while [[ "$1" == -* ]]; do
        case "$1" in
            --verify) check_only=true ;;
            *) return 1 ;;
        esac
        shift
    done

    local prompt_base="$1"
    local rofi_title="$2"
    local type="$3"    # "int" or "float"
    local min_val="$4"
    local max_val="$5"
    local opt_name="${6:-}"
    local settings_file="$VIBRANIUM_USER_SETTINGS"

    local range_text="${min_val}-${max_val}"
    local prompt="${prompt_base} (${type})"

    while true; do
        local input
        input="$(printf "%s\n" "$prompt" | rofi_cmd "$rofi_title" "$range_text")"

        # rofi cancelled
        [[ -z "$input" ]] && return 1
        [[ "$input" = "$prompt" ]] && continue

        # trim whitespace
        input="${input#"${input%%[![:space:]]*}"}"
        input="${input%"${input##*[![:space:]]}"}"

        local valid=true

        if [[ "$type" == "int" ]]; then
            if ! [[ "$input" =~ ^[0-9]+$ ]]; then
                valid=false
            else
                local inrange
                inrange=$(awk -v v="$input" -v lo="$min_val" -v hi="$max_val" \
                          'BEGIN { v+=0; lo+=0; hi+=0; print (v >= lo && v <= hi) }')
                [[ "$inrange" != 1 ]] && valid=false
            fi

        elif [[ "$type" == "float" ]]; then
            if ! [[ "$input" =~ ^[0-9]*\.?[0-9]+$ ]]; then
                valid=false
            else
                local inrange
                inrange=$(awk -v v="$input" -v lo="$min_val" -v hi="$max_val" \
                          'BEGIN { v+=0; lo+=0; hi+=0; print (v >= lo && v <= hi) }')
                [[ "$inrange" != 1 ]] && valid=false

                if [[ "$valid" == true ]]; then
                    input=$(awk -v v="$input" '
                        BEGIN {
                            v+=0
                            if (v == int(v)) printf "%d.0", int(v)
                            else printf "%g", v
                        }')
                fi
            fi
        else
            return 1
        fi

        if [[ "$valid" == false ]]; then
            notify-send -r 5 -u critical -t 1500 "Vibranium" \
                "A ${type} between ${min_val} and ${max_val}!"
            continue
        fi

        # check-only mode: just return the validated value
        if [[ "$check_only" == true ]]; then
            printf "%s" "$input"
            return 0
        fi

        # full edit mode
        if [[ -n "$opt_name" ]]; then
            option-validate "$opt_name" || return 1

            if grep -qE "^${opt_name}=" "$settings_file" 2>/dev/null; then
                sed -i "/^${opt_name}/s/=.*/=${input}/" "$settings_file"
            else
                printf "%s=%s\n" "$opt_name" "$input" >> "$settings_file"
            fi
        fi

        printf "%s" "$input"
        return 0
    done
}

