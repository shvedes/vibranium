#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"
source "$VIBRANIUM_PATH/configure/configure-lib"

_vol_boost() {
    local var current_vol

    var="VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED"

    if [[ "$(toggle_bool -v "$var")" == false ]]; then
        current_vol=$(wpctl get-volume "@DEFAULT_AUDIO_SINK@")

        # Check if current_vol contains a floating point number
        # ([0-9]+\.[0-9]+) captures the first occurrence like "0.75", "1.23", etc.
        [[ $current_vol =~ ([0-9]+\.[0-9]+) ]] && {
            # If the regex matched, BASH_REMATCH[1] contains the captured number
            # Overwrite current_vol with the extracted numeric value
            current_vol="${BASH_REMATCH[1]}"
        }

        # Check if current_vol is greater than 1.00
        # Matches:
        #  - 1.10 to 1.49
        #  - exactly 1.50
        #  - any integer 2 or higher (overkill)
        [[ $current_vol =~ ^(1\.[1-4][0-9]|1\.50|[2-9]) ]] && {
            wpctl set-volume @DEFAULT_AUDIO_SINK@ 1.00
            notify-send -r 1 -t 5000 "Vibranium" \
                "The volume level set back to 100%"
        }
    fi
}

_a_feedback() {
    while true; do
        source "$VIBRANIUM_USER_SETTINGS"

        local audio_feedback="$VIBRANIUM_VOLUME_USE_AUDIO_FEEDBACK"

        local options=("Audio feedback : $audio_feedback")

        # Add variant option IF audio feedback is enabled
        if [[ "$audio_feedback" == true ]]; then
            # Split for the sake of line width
            local variant="${VIBRANIUM_VOLUME_AUDIO_FEEDBACK_VARIANT%?} "
            variant+="${VIBRANIUM_VOLUME_AUDIO_FEEDBACK_VARIANT: -1}"
            options+=("Variant : $variant")
        fi

        mapfile -t options < <(align_options "${options[@]}")

        local chosen
        chosen="$(printf "%s\n" "${options[@]}" | rofi_cmd "Audio feedback" "ESC to go back")"

        [[ -z "$chosen" ]] && break

        case "$chosen" in
            *"Audio"*)
                toggle_bool "VIBRANIUM_VOLUME_USE_AUDIO_FEEDBACK"
                ;;
            "Variant"*)
                handle_audio_variant
                ;;
        esac
    done
}

_a_feedback_variant() {
    while true; do
        local variant_options=("variant 1" "variant 2" "variant 3")
        local current_option opt

        # Split for cleaner code
        opt="VIBRANIUM_VOLUME_AUDIO_FEEDBACK_VARIANT"
        current_option="\$$opt"

        local chosen
        chosen="$(printf "%s\n" "${variant_options[@]}" | rofi_cmd "Audio variant" "ESC to go back")"
        [[ -z "$chosen" ]] && break

        # Skip if choice matches current variant
        [[ "$chosen" == "$current_option" ]] && break

        if [[ ! "${variant_options[*]}" =~ $chosen ]]; then
            continue
        fi

        option-validate "$opt"
        sed -i "/^${opt}/s/=.*/=\"${chosen// /}\"/" \
            "$VIBRANIUM_USER_SETTINGS"
        break
    done
}

INDEX=0

while true; do
    source "$VIBRANIUM_USER_SETTINGS"

    OPTIONS=(
        "Boost up to 150% : $VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED"
        "Visual feedback : $VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK"
        "Audio feedback : $VIBRANIUM_VOLUME_USE_AUDIO_FEEDBACK"
        "Volume step : $VIBRANIUM_VOLUME_ADJUSTMENT_STEP"
    )

    if [[ "$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK" == true ]]; then
        if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
            OPTIONS+=("Use OSD : $VIBRANIUM_VOLUME_USE_OSD")
        fi
    fi

    OPTIONS+=("<b>Open volume mixer</b>")

    mapfile -t OPTIONS < <(align_options "${OPTIONS[@]}")
    CHOSEN="$(printf "%s\n" "${OPTIONS[@]}" | rofi_cmd "Audio" "ESC to go back" -selected-row "$INDEX")"
    [ -z "$CHOSEN" ] && break

    for i in "${!OPTIONS[@]}"; do
        if [ "${OPTIONS[$i]}" = "$CHOSEN" ]; then
            INDEX="$i"
            break
        fi
    done

    case "$CHOSEN" in
        *"Open volume mixer"*)
            vb-cmd-terminal wiremix
            vb-cmd-kill-rofi
            exit 0
            ;;
        "Boost up to"*)
            _vol_boost
            ;;
        "Visual"*)
            toggle_bool "VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK"
            ;;
        "Use OSD"*)
            toggle_bool "VIBRANIUM_VOLUME_USE_OSD"
            ;;
        "Audio"*)
            _a_feedback
            ;;
        "Volume step"*)
            edit_digit "Volume adjustment step" "Volume step" \
                "int" 1 25 "VIBRANIUM_VOLUME_ADJUSTMENT_STEP"
            ;;
    esac
done
