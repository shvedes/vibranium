#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"
source "$VIBRANIUM_PATH/configure/configure-lib"

INDEX=0

while true; do
    source "$VIBRANIUM_USER_SETTINGS"

    OPTIONS=(
        "Use DDC protocol : $VIBRANIUM_BRIGHTNESS_USE_DDC_CONTROL"
        "Brightnes step : $VIBRANIUM_BRIGHTNESS_STEP"
    )

    if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
        OPTIONS+=("OSD feedback	: $VIBRANIUM_BRIGHTNESS_USE_OSD")
    fi

    mapfile -t OPTIONS < <(align_options "${OPTIONS[@]}")
    CHOSEN="$(printf "%s\n" "${OPTIONS[@]}" | rofi_cmd "Brightness" "ESC to go back" -selected-row "$INDEX")"
    [ -z "$CHOSEN" ] && break

    for i in "${!OPTIONS[@]}"; do
        if [ "${OPTIONS[$i]}" = "$CHOSEN" ]; then
            INDEX="$i"
            break
        fi
    done

    case "$CHOSEN" in
        "Use DDC"*)
            toggle_bool "VIBRANIUM_BRIGHTNESS_USE_DDC_CONTROL"
            ;;
        *"OSD"*)
            toggle_bool "VIBRANIUM_BRIGHTNESS_USE_OSD"
            ;;
        "Brightnes step"*)
            edit_digit "Brightness adjustment step" "Brightness" \
                "int" 2 20 "VIBRANIUM_BRIGHTNESS_STEP"
            ;;
    esac
done
