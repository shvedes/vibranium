#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"
source "$VIBRANIUM_PATH/configure/configure-lib"

INDEX=0
WAYBAR_CONFIG="$XDG_CONFIG_HOME/waybar/config.jsonc"

while true; do
    source "$VIBRANIUM_USER_SETTINGS"

    unit_ststus="$(systemctl --user is-active waybar)"
    [[ $unit_ststus == active ]] && ENABLED=true || ENABLED=false


    POSITION="$(sed -n 's/.*"position"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$WAYBAR_CONFIG")"
    HEIGHT="$(sed -n 's/.*"height"[[:space:]]*:[[:space:]]*\([^"]*\),.*/\1/p' "$WAYBAR_CONFIG")"
    ICON_SPACING="$(sed -n 's/.*"spacing"[[:space:]]*:[[:space:]]*\([^"]*\),.*/\1/p' "$WAYBAR_CONFIG")"

    OPTIONS=("Enabled : $ENABLED")

    if [[ "$ENABLED" == true ]]; then
        OPTIONS+=(
            "Position : $POSITION"
            "Spacing : ${ICON_SPACING:-?}"
            "Height : ${HEIGHT:-?}"
            "<b>Module list</b>"
            "<b>Module settings</b>"
        )
    fi


    mapfile -t OPTIONS < <(align_options "${OPTIONS[@]}")
    CHOSEN="$(printf "%s\n" "${OPTIONS[@]}" | rofi_cmd "Waybar options" "ESC to go back" -selected-row "$INDEX")"
    [ -z "$CHOSEN" ] && break

    for i in "${!OPTIONS[@]}"; do
        if [ "${OPTIONS[$i]}" = "$CHOSEN" ]; then
            INDEX="$i"
            break
        fi
    done

    case "$CHOSEN" in
        "Enabled"*)
            case "$ENABLED" in
                "true") systemctl --user disable --now waybar ;;
                "false") systemctl --user enable --now waybar ;;
            esac
        ;;
        "Spacing"*)
            while true; do
                prompt="Icon spacing (int)"
                input="$(printf "%s" "$prompt" | rofi_cmd "Icon spacing" "-6 - 16")"
                [[ -z "$input" ]] && break

                [[ ! "$input" =~ ^-?[0-9]+$ ]] && {
                    notify-send -r 1 -t 2000 "Vibranium" "An integer between -6 and 16"
                    continue
                }

                if ((input > 16 || input < -6)); then
                    notify-send -r 1 -t 2000 "Vibranium" "An integer between -6 and 16"
                    continue
                fi

                sed -i -E "s/(\"spacing\"\s*:\s*)-?[0-9]+/\1${input}/" "$WAYBAR_CONFIG"
                systemctl --user restart waybar
                break
            done
            ;;
        "Height"*)
            while true; do
                prompt="Waybar height (int)"
                input="$(printf "%s" "$prompt" | rofi_cmd "Bar height" "30-45")"
                [[ -z "$input" ]] && break

                [[ ! "$input" =~ ^[0-9]+$ ]] && {
                    notify-send -r 1 -t 2000 "Vibranium" "An integer between 30-50"
                    continue
                }

                # 30 is minimum allowed height due to specific modules
                if ((input > 50 || input < 30)); then
                    notify-send -r 1 -t 2000 "Vibranium" "An integer between 30-50"
                    continue
                fi

                sed -i -E "s/(\"height\"\s*:\s*)[0-9]+/\1${input}/" "$WAYBAR_CONFIG"
                systemctl --user restart waybar
                break
            done
            ;;
        "Position"*)
            case "$POSITION" in
                top)    vb-cmd-waybar-position --bottom ;;
                bottom) vb-cmd-waybar-position --top ;;
            esac
            ;;
        *"Module list"*)    waybar-toggle-modules   ;;
        *"Module settings"*) configure-waybar-module ;;
    esac
done
