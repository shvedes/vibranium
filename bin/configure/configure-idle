#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"
source "$VIBRANIUM_PATH/configure/configure-lib"

INDEX=0

_set_idle_timeout() {
    local title="$1"          # "Lock" / "Sleep"
    local prompt="$2"         # prompt text
    local timer_index="$3"    # 1 = lock, 2 = sleep
    local min_value="$4"      # empty or lock_timeout

    while true; do
        input="$(printf "%s\n" "$prompt" | rofi_cmd "$title timeout" "in minutes")"
        [ -z "$input" ] && break
        [ "$input" = "$prompt" ] && continue

        [[ ! "$input" =~ ^[0-9]+$ ]] && {
            notify-send -r 3 -u critical -t 1500 "Vibranium" "Only integers allowed!"
            continue
        }

        if [[ -n "$min_value" ]] && (( input <= min_value )); then
            notify-send -r 3 -u critical -t 3000 "Vibranium" \
                "$title timeout must be greater than $min_value!"
            continue
        fi

        _update_timeout "$timer_index" $((input * 60))
        systemctl --user restart hypridle
        break
    done
}

get_timeouts() {
    local config
    config="$XDG_CONFIG_HOME/hypr/hypridle.conf"

    awk '
        /^\s*listener\s*{/{f=1; next}
        /^\s*}/{f=0; next}
        f && /^\s*timeout\s*=/ {
            match($0, /timeout\s*=\s*([0-9]+)/, a)
            print a[1]
        }
    ' "$config"
}

while true; do
    source "$VIBRANIUM_USER_SETTINGS"

    mapfile -t timeouts < <(get_timeouts)

    lock_timeout="${timeouts[0]}"
    sleep_timeout="${timeouts[1]}"

    lock_timeout=$((lock_timeout / 60))
    sleep_timeout=$((sleep_timeout / 60))

    inhibit_type="$VIBRANIUM_GLOBAL_INHIBIT_TYPE"

    OPTIONS=(
        "Lock  after : $lock_timeout min"
        "Sleep after : $sleep_timeout min"
        "<b>Inhibit type</b> : $inhibit_type"
        "What is this?"
    )

    mapfile -t OPTIONS < <(align_options "${OPTIONS[@]}")

    CHOSEN="$(printf "%s\n" "${OPTIONS[@]}" | rofi_cmd "Idle timeouts" "ESC to go back" -selected-row "$INDEX")"
    [ -z "$CHOSEN" ] && break

    for i in "${!OPTIONS[@]}"; do
        if [ "${OPTIONS[$i]}" = "$CHOSEN" ]; then
            INDEX="$i"
            break
        fi
    done

    case "$CHOSEN" in
        *"Inhibit"*)
            update_enum VIBRANIUM_GLOBAL_INHIBIT_TYPE "Sleep type" idle sleep
            ;;
        "Lock"*)
            _set_idle_timeout "Lock" "Lock timeout (int)" 1
            ;;
        "Sleep"*)
            _set_idle_timeout \
                "Sleep" "Sleep timeout (int)" 2 "$lock_timeout"
            ;;
        "What"*)
            msg="<span foreground='${P_ACCENT}'><b>•</b></span> "
            msg+="<b>Time of inactivity until screen lock</b>\n"
            msg+="<span foreground='${P_ACCENT}'><b>•</b></span> "
            msg+="<b>Time of inactivity before the system sleeps</b>\n\n"

            msg+="<b>Inhibit types:</b>\n"

            msg+="<span foreground='${P_ACCENT}'><b>sleep</b></span> — "
            msg+="The session may lock normally, but the PC is prevented from going to sleep.\n"

            msg+="<span foreground='${P_ACCENT}'><b>idle</b></span> — "
            msg+="The system thinks you are active, so automatic locking does not trigger."

            notify-send -r 2 -t 15000 "What is this?" "$msg"
            ;;
    esac
done
