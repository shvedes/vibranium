#!/usr/bin/env bash

# Toggle a persistent systemd-inhibit to prevent idle suspend.
# If an inhibitor is already running, kills it; otherwise starts a new one.
# Refreshes the Vibranium Waybar inhibitor module after action.

source vb-core-lib

usage() {
    cat << EOF
Usage: $(basename "$0") [OPTION]

Toggle systemd idle inhibitor for Vibranium.

Options:
  -h, --help   Show this help and exit
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0
esac

pid="$(systemd-inhibit --no-pager | awk '/Vibranium/ {print $4}')"

if [[ -n "$pid" ]]; then
    kill "$pid"
else
    check_enum VIBRANIUM_GLOBAL_INHIBIT_TYPE "idle" idle sleep
    type="$VIBRANIUM_GLOBAL_INHIBIT_TYPE"

    setsid -f systemd-inhibit \
        --what="$type" \
        --who="Vibranium" \
        --why="Manual sleep inhibition" \
        sleep infinity &
fi

vb-cmd-refresh-bar-module inhibitor &
