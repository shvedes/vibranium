#!/usr/bin/env bash

# Toggle a persistent systemd-inhibit to prevent idle suspend.
# If an inhibitor is already running, stops it; otherwise starts a new one.
# Refreshes the Vibranium Waybar inhibitor module after action.

source vb-lib-core

_usage() {
  cat <<EOF
Usage: ${0##*/} [OPTION]

Toggle systemd idle inhibitor.

Options:
  -h, --help   Show this help and exit
EOF
}

case "${1:-}" in
-h | --help)
  _usage
  exit 0
  ;;
-*)
  echo "Error: uknown option: $1" >&2
  echo "Try ${0##*/} --help" >&2
  exit 1
  ;;
esac

helpers::check VIBRANIUM_GLOBAL_INHIBIT_TYPE
TYPE="$VIBRANIUM_GLOBAL_INHIBIT_TYPE"
UNIT="vibranium-inhibit@$TYPE"

if systemctl -q --user is-active $UNIT; then
  systemctl -q --user stop $UNIT
else
  systemctl -q --user start $UNIT
fi

vb-cmd-refresh-bar-module inhibitor
