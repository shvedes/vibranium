#!/usr/bin/bash

SELF="${0##*/}"
CLIENTS=(ncmpcpp rmpc cmus vimpc)

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF [OPTION]

Detect an installed MPD client.
If a window exists, focus it. Otherwise launch it.

Options:
  -h, --help  Display this help and exit
EOF
}

case "$1" in
-h | --help)
  usage
  exit 0
  ;;
"") ;;
*)
  echo "Error: invalid option '$1'" >&2
  echo "Try '$SELF --help' for more information." >&2
  exit 1
  ;;
esac

if ! command -v mpd >/dev/null; then
  echo "Error: MPD is not installed" >&2
  exit 1
fi

for c in "${CLIENTS[@]}"; do
  if command -v "$c" >/dev/null 2>&1; then
    CLIENT="$c"
    break
  fi
done

if [[ ! -n $CLIENT ]]; then
  echo "Could not find installed MPD client" >&2
  notify-send -r 4 -t 3000 "Vibranium" "Could not find installed MPD client!"
  exit 1
fi

WINDOW_ADDRESS=$(
  hyprctl clients -j | jq -r --arg p "$CLIENT" '
        first(
            .[]
            | select(
                (.class | test("\\b" + $p + "\\b"; "i")) or
                (.title | test("\\b" + $p + "\\b"; "i"))
            )
            | .address
        )
    '
)

if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
else
  xdg-terminal-exec --app-id=mpd --title="$CLIENT" -- "$CLIENT"
fi
