#!/usr/bin/env bash

CLIENTS=(ncmpcpp rmpc cmus vimpc)

usage() {
  cat << EOF
Usage: ${0##*/} [OPTION]

Detect an installed MPD client.
If a window exists, focus it. Otherwise launch it.

Options:
  -h, --help  Display this help and exit
EOF
}

case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  "") ;;
  *)
    echo "${0##*/}: invalid option '$1'" >&2
    echo "Try '${0##*/} --help' for more information." >&2
    exit 1
    ;;
esac

command -v mpd > /dev/null 2>&1 || exit 1

CLIENT=""

for c in "${CLIENTS[@]}"; do
  if command -v "$c" > /dev/null 2>&1; then
    CLIENT="$c"
    break
  fi
done

if [[ -z $CLIENT ]]; then
  exit 1
fi

WINDOW_ADDRESS=$(
  hyprctl clients -j | jq -r --arg p "$CLIENT" '
        first(
            .[]
            | select(
                (.class | test("\\b" + $p + "\\b"; "i")) or
                (.title | test("\\b" + $p + "\\b"; "i"))
            )
            | .address
        )
    '
)

if [[ -n $WINDOW_ADDRESS ]]; then
  hyprctl dispatch focuswindow "address:$WINDOW_ADDRESS"
else
  exec setsid vb-core-term -- "$CLIENT"
fi
