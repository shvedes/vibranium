#!/usr/bin/env bash

for f in /run/systemd/inhibit/*; do
    [[ -f $f ]] || continue
    if grep -q '=Vibranium' "$f"; then
        shown=true
        break
    fi
done

if [[ -n "$shown" ]]; then
    source vb-core-lib

    helpers::check VIBRANIUM_GLOBAL_INHIBIT_TYPE
    type="$VIBRANIUM_GLOBAL_INHIBIT_TYPE"

    if [[ "$type" == "idle" ]]; then
        tooltip="Blocking screen lock"
    else
        tooltip="Blocking system sleep"
    fi

    printf '{"text": "%s", "tooltip": "%s"}' "\uf023" "$tooltip"
else
    printf '{"text": ""}'
fi
