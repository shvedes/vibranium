#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF [OPTION]...

Lock the session and suspend the system.
Handle Hyprland animation transitions.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Error: unknown option -- $1" >&2
    echo "Try '$SELF --help' for more information." >&2
    exit 1
    ;;
  esac
done

log Info "Locking session and suspending"

# Lock session first
vb-cmd-lock-session

# Save the current animations state so we can restore it after wake.
# Fading the screen gamma to 0 before suspend creates a smooth
# fade-to-black effect when animations are enabled.
ANIMATIONS_ENABLED="$(hyprctl -j getoption animations:enabled | jq -r '.int')"
if ((ANIMATIONS_ENABLED == 1)); then
  hyprctl -q hyprsunset gamma 0
  sleep 1
fi

# Disable the sleep inhibitor before suspending because systemctl
# suspend requires a sleep-capable state and the inhibitor would block it.
if systemctl -q --user is-active vibranium-inhibit@sleep.service; then
  vb-toggle-inhibitor
fi

if ! sc_out="$(systemctl suspend 2>&1)"; then
  msg="Failed to suspend the system.\n\n"
  msg+="Command: <b>systemctl suspend</b>\n\n"
  msg+="Error output:\n<b>$sc_out</b>"

  notify-send -u critical -t 30000 \
    "Vibranium" "$msg"
fi

# Post-wake: restore screen gamma after a short delay to let the
# compositor and GPU re-initialise.
if ((ANIMATIONS_ENABLED == 1)); then
  sleep 2
  hyprctl -q hyprsunset gamma 100
fi
