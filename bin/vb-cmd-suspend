#!/usr/bin/bash

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF [OPTION]...

Lock the session and suspend the system.
Handle Hyprland animation transitions.

Options:
  -h, --help     display this help and exit
EOF
}

case "${1-}" in
-h | --help)
  usage
  exit 0
  ;;
"")
  :
  ;;
*)
  echo "Error: unknown option: $1" >&2
  echo "Try '$SELF --help' for more information." >&2
  exit 1
  ;;
esac

vb-cmd-lock-session

ANIMATIONS_ENABLED="$(hyprctl -j getoption animations:enabled | jq -r '.int')"

if ((ANIMATIONS_ENABLED == 1)); then
  hyprctl -q hyprsunset gamma 0
  sleep 1
fi

# Disable sleep ihibitor (sleep block) first since it
# will require sudo in order to suspend.
if systemctl -q --user is-active vibranium-inhibit@sleep.service; then
  vb-toggle-inhibitor
fi

systemctl suspend

if ((ANIMATIONS_ENABLED == 1)); then
  sleep 2
  hyprctl -q hyprsunset gamma 100
fi
