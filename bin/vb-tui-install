#!/bin/bash

# shellcheck disable=SC2034

source vb-lib-cli

ICON_DIR="$XDG_DATA_HOME/applications/icons"
SELF="${0##*/}"

VERBOSE=${VERBOSE:-false}

# Parser state starts with empty strings and false booleans. Interactive mode
# populates the fields it prompts for; flags can still set non-prompted state.

TUI_EXEC=""
TUI_EXEC_RAW=""
APP_NAME=""
ICON_REF=""
CUSTOM_EXEC=""
EXTRA_KEYWORDS=""
CATEGORY=""
EXEC_ARGS=""
FLOAT=false
INTERACTIVE_MODE=false

usage() {
  shcat << EOF
Usage: $SELF [OPTION]...

Install a TUI application shortcut as a .desktop launcher entry.

Options:
  --exec CMD          TUI command to launch
  --args ARGS         Positional arguments passed to the TUI command
  --name NAME         App display name
  --icon REF          Icon URL or filename inside the icons directory
  --custom-exec CMD   Override the full Exec= value
  --keywords KW       Extra keywords, semicolon-separated
  --category CAT      Extra Categories= value
  --float             Launch in a floating window
  -v, --verbose       Enable verbose output
  -h, --help          Show this help and exit

If --exec is not provided, the script runs in interactive mode and prompts
for all required fields.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    --exec)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for $1"
        exit 1
      }
      TUI_EXEC="$2"
      TUI_EXEC_RAW="$2"
      shift 2
      ;;
    --args)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for $1"
        exit 1
      }
      EXEC_ARGS="$2"
      shift 2
      ;;
    --name)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for $1"
        exit 1
      }
      APP_NAME="$2"
      shift 2
      ;;
    --icon)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for $1"
        exit 1
      }
      ICON_REF="$2"
      shift 2
      ;;
    --custom-exec)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for $1"
        exit 1
      }
      CUSTOM_EXEC="$2"
      shift 2
      ;;
    --keywords)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for $1"
        exit 1
      }
      EXTRA_KEYWORDS="$2"
      shift 2
      ;;
    --category)
      [[ $# -ge 2 ]] || {
        log Error "Missing value for $1"
        exit 1
      }
      CATEGORY="$2"
      shift 2
      ;;
    --float)
      FLOAT=true
      shift
      ;;
    --)
      shift
      break
      ;;
    --* | -*)
      log Error "Unknown option: $1"
      exit 1
      ;;
    *)
      log Error "Unexpected argument: $1. Use flags to pass values"
      exit 1
      ;;
  esac
done

tui_install_prepare_result() {
  # operation::result restores a previously captured terminal state. Capture
  # one here when interactive helpers have not already disabled input.
  if [[ -z "${term_original_settings+x}" ]]; then
    term::disable_input
  fi
}

tui_install_canceled() {
  [[ $INTERACTIVE_MODE == true ]] || return

  tui_install_prepare_result
  operation::result canceled
}

tui_install_interrupt() {
  trap 'exit 1' INT
  printf '\n'
  tui_install_canceled
  exit 1
}

tui_install_complete() {
  tui_install_prepare_result
  operation::result success -- "Installation complete"
}

# Derive a display name from the text after the final slash and first literal
# space, then uppercase its first character.
_name_from_exec() {
  local -n _nfe_out=$1
  local _nfe_base="${2##*/}"
  _nfe_base="${_nfe_base%% *}"
  _nfe_out="${_nfe_base^}"
}

# Resolve a command name with Bash command -v; functions, builtins, and aliases
# can also match. Return command -v's status.
_check_exec_exists() {
  command -v "$1" &> /dev/null
}

# Scan TUI entries' first TryExec= field in the main desktop group. Requested
# and stored values are reduced to text after the final slash before comparison.
# Print the matching path and return 0; return 1 when no entry matches.
_find_tuiapp_by_tryexec() {
  local exec_cmd="${1##*/}"
  local dir="$XDG_DATA_HOME/applications"
  local file line value

  for file in "$dir"/TUI*.desktop; do
    [[ -f $file ]] || continue
    while IFS= read -r line; do
      case "$line" in
        TryExec=*)
          value="${line#TryExec=}"
          [[ "${value##*/}" == "$exec_cmd" ]] && {
            echo "$file"
            return 0
          }
          # TryExec appears at most once per [Desktop Entry]; stop reading.
          break
          ;;
        # Any section header other than the opening [Desktop Entry] means we
        # have left the main block; TryExec cannot appear below this point.
        "["*)
          [[ "$line" == "[Desktop Entry]" ]] || break
          ;;
      esac
    done < "$file"
  done

  return 1
}

_ask_for_icon() {
  local -n _afi_out=$1
  local _afi_ref
  term::prompt_line _afi_ref "${B}[*]${RS} Icon URL / path / name (or Enter for default): ${B}" || _afi_ref=""
  [[ -z $_afi_ref ]] && _afi_ref="terminal"
  _afi_out="$_afi_ref"
}

# Resolve HTTP(S) icon URLs to cached files. Other references use a matching
# file under ICON_DIR or pass through; empty and failed URLs emit vb-console.
_resolve_icon() {
  local -n _ri_out=$1
  local _ri_ref="$2"
  local _ri_name="$3"

  if [[ -z $_ri_ref ]]; then
    _ri_out="vb-console"
    return
  fi

  if [[ $_ri_ref =~ ^https?:// ]]; then
    # curl writes the final cache path directly. A failed transfer short-circuits
    # the size check and can leave a partial file, which is not selected or cleaned
    # in this call.
    local _ri_ext="${_ri_ref##*.}"
    [[ $_ri_ext =~ ^(png|jpg|jpeg|ico|svg)$ ]] || _ri_ext="png"
    local _ri_path="$ICON_DIR/$_ri_name.$_ri_ext"
    if curl -fsSL -o "$_ri_path" "$_ri_ref" 2> /dev/null && [[ -s $_ri_path ]]; then
      _ri_out="$_ri_path"
    else
      _ri_out="vb-console"
    fi
    return
  fi

  if [[ -f "$ICON_DIR/$_ri_ref" ]]; then
    _ri_out="$ICON_DIR/$_ri_ref"
  else
    _ri_out="$_ri_ref"
  fi
}

_build_exec_command() {
  local -n _bec_out=$1
  local _bec_cmd="$2"
  local _bec_float="$3"

  if [[ $_bec_float == true ]]; then
    _bec_out="vb-launch-tui --app-id=org.vb.term.float -- $_bec_cmd"
  else
    _bec_out="vb-launch-tui -- $_bec_cmd"
  fi
}

_write_desktop() {
  local name="$1" exec_cmd="$2" icon="$3" keywords="$4" category="$5"
  local file="$XDG_DATA_HOME/applications/$name.desktop"

  # Shell redirection truncates the destination as heredoc content is written.
  # Values receive no desktop-entry escaping; Exec= percent sequences are emitted
  # literally for the desktop parser to interpret.
  shcat > "$file" << EOF
[Desktop Entry]
Version=1.0
Name=${name#TUI - }
Comment=$name
TryExec=$TUI_EXEC_RAW
Exec=$exec_cmd
Terminal=false
Type=Application
Icon=$icon
StartupNotify=true
Categories=TUI;${category}
Keywords=tui;console;terminal;$TUI_EXEC_RAW;${keywords}
OnlyShowIn=Hyprland;
EOF
}

# TUI_EXEC_RAW is the executable identity written to TryExec and Keywords.

# A custom Exec without --exec still needs a TryExec identity. The first literal
# space delimits the token; tabs remain part of it.
if [[ -z $TUI_EXEC_RAW && -n $CUSTOM_EXEC ]]; then
  TUI_EXEC_RAW="${CUSTOM_EXEC%% *}"
fi

source vb-lib-core

if [[ ! -f "$ICON_DIR" ]]; then
  mkdir -p "$ICON_DIR"
fi

if [[ -z $TUI_EXEC && -z $CUSTOM_EXEC ]]; then
  INTERACTIVE_MODE=true
  trap 'tui_install_interrupt' INT
  term::show_header

  term::enable_input
  while true; do
    if ! term::prompt_line TUI_EXEC "${Y}[*]${RS} TUI command (e.g. lazygit, btop): ${B}"; then
      tui_install_canceled
      exit 1
    fi

    if [[ -n $TUI_EXEC ]]; then
      break
    fi
    vb::print "$R" "Command cannot be empty"
  done

  if ! _check_exec_exists "${TUI_EXEC%% *}"; then
    vb::print "$Y" "Warning: ${B}${TUI_EXEC%% *}${RS} was not found in \$PATH."
    if ! term::ask_yes_no N "Continue anyway?"; then
      tui_install_canceled
      exit 1
    fi
  fi

  # Check by exec identity, not by name, to catch the same binary registered
  # under a different display name.
  # Path prefixes are stripped from both values for comparison. A match only
  # gates confirmation; a different APP_NAME leaves the matched entry in place
  # because the matched path is neither removed nor selected as the output.
  if _find_tuiapp_by_tryexec "$TUI_EXEC" &> /dev/null; then
    vb::print "$Y" "A TUI app for ${B}${TUI_EXEC##*/}${RS} is already installed."
    if ! term::ask_yes_no Y "Overwrite it?"; then
      tui_install_canceled
      exit 1
    fi
  fi

  term::prompt_line EXEC_ARGS "${B}[*]${RS} Arguments (e.g. --option1 value --option2, or Enter to skip): ${B}" || EXEC_ARGS=""

  _suggested_name=""
  _name_from_exec _suggested_name "$TUI_EXEC"
  vb::print "$Y" "Suggested name: ${B}${_suggested_name}${RS}"
  if ! term::prompt_line APP_NAME "${B}[*]${RS} App name (Enter to keep the name above): ${B}"; then
    tui_install_canceled
    exit 1
  fi
  APP_NAME="TUI - ${APP_NAME:-$_suggested_name}"

  if term::ask_yes_no N "Launch in a floating window?"; then
    FLOAT=true
  fi

  vb::print "$B" "Hint: keywords help the app launcher find this entry by search terms"
  term::prompt_line EXTRA_KW_RAW "${B}[*]${RS} Keywords (space-separated, or Enter to skip): ${B}" || EXTRA_KW_RAW=""

  EXTRA_KEYWORDS=""
  # Prompt input is intentionally whitespace-tokenized, and each token becomes
  # one semicolon-terminated keyword rather than preserving quoted groups.
  for kw in $EXTRA_KW_RAW; do EXTRA_KEYWORDS+="${kw};"; done

  term::prompt_line CATEGORY "${B}[*]${RS} Extra categories (e.g. System;Monitor, or Enter to skip): ${B}" || CATEGORY=""

  _ask_for_icon ICON_REF

  # TUI_EXEC_RAW retains arguments embedded in the command; the separately
  # supplied EXEC_ARGS value is appended only to the generated launch command.
  TUI_EXEC_RAW="$TUI_EXEC"

  if [[ -n $EXEC_ARGS ]]; then
    TUI_EXEC="$TUI_EXEC $EXEC_ARGS"
  fi

  _resolve_icon ICON_PATH "$ICON_REF" "$APP_NAME"
  _build_exec_command EXEC_COMMAND "$TUI_EXEC" "$FLOAT"

else
  if [[ -z $APP_NAME ]]; then
    if [[ -n $TUI_EXEC ]]; then
      _name_from_exec APP_NAME "$TUI_EXEC"
    else
      APP_NAME="TUI App"
    fi
  fi

  if [[ $APP_NAME != "TUI - "* ]]; then
    APP_NAME="TUI - $APP_NAME"
  fi

  log Info "Installing TUI app: ${APP_NAME#TUI - } (exec=$TUI_EXEC_RAW)"

  if [[ -n $TUI_EXEC_RAW ]] && _find_tuiapp_by_tryexec "$TUI_EXEC_RAW" &> /dev/null; then
    log Info "App already installed, exiting"
    exit 1
  fi

  if [[ -n $TUI_EXEC ]]; then
    # TUI_EXEC_RAW retains arguments embedded in the --exec payload; the separate
    # --args value is appended only to the generated launch command.
    TUI_EXEC_RAW="$TUI_EXEC"
  fi

  if [[ -n $EXEC_ARGS ]]; then
    TUI_EXEC="$TUI_EXEC $EXEC_ARGS"
  fi

  _resolve_icon ICON_PATH "$ICON_REF" "$APP_NAME"
  if [[ -n $CUSTOM_EXEC ]]; then
    EXEC_COMMAND="$CUSTOM_EXEC"
  else
    _build_exec_command EXEC_COMMAND "$TUI_EXEC" "$FLOAT"
  fi
fi

# APP_NAME also supplies the desktop filename; slash-separated values are not
# reduced to a safe basename by this script.
log Info "Writing desktop entry: $APP_NAME"
_write_desktop "$APP_NAME" "$EXEC_COMMAND" "$ICON_PATH" "$EXTRA_KEYWORDS" "$CATEGORY"

if [[ $INTERACTIVE_MODE == true ]]; then
  vb::print "$G" "${B}${APP_NAME#TUI - }${RS} has been installed"
  vb::print "$G" "You can find it in the app launcher"
  tui_install_complete
  exit 0
fi
