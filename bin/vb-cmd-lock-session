#!/usr/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Lock the current session.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Error: unknown option: $1" >&2
    usage
    exit 1
    ;;
  esac
done

# Reset the keyboard layout to index 0 (typically US English) before
# locking so the lock screen password prompt always uses a known layout
# regardless of what the user had active.
log Info "Locking session"
hyprctl -q switchxkblayout all 0

if ! systemctl -q --user is-active hyprlock.service; then
  systemctl -q --user start hyprlock.service
fi
