#!/bin/bash

VERBOSE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Toggle Waybar visibility using SIGUSR1.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log Error "unknown option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
  esac
done

# SIGUSR1 is Waybar's built-in toggle signal.  No config reload is
# needed; Waybar handles this signal internally.
log Info "Toggling Waybar visibility"
pkill -SIGUSR1 waybar
