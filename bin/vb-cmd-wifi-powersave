#!/usr/bin/bash

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF [--on|--off|--get]

Toggle Wi-Fi power saving on all wireless interfaces.

Note: this script is being used by a udev rule, which is
      is installed on a portable devices by default.
      This script is not intended to be launched by a
      regular user, but you can. Requires sudo privileges.

Options:
  --on      enable power saving
  --off     disable power saving
  --get     show current power saving state for each interface
  --help    display this help and exit
EOF
}

case "${1:-}" in
--on | --off)
  # strip leading '--'
  value="${1#--}"
  ;;
--get)
  value="get"
  ;;
--help)
  usage
  exit 0
  ;;
"")
  usage >&2
  exit 1
  ;;
*)
  echo "Error: unknown option: $1" >&2
  echo "Try '$SELF --help' for more information" >&2
  exit 1
  ;;
esac

found=0

while IFS= read -r iface; do
  if [ "$value" = "get" ]; then
    state=$(iw dev "$iface" get power_save 2>/dev/null) || {
      printf "  %-12s (unable to query)\n" "$iface:" >&2
      continue
    }
    printf "  %-12s %s\n" "$iface:" "$state"
  else
    if ((EUID != 0)); then
      # Launched by user, not by the udev rule
      if sudo iw dev "$iface" set power_save "$value" 2>/dev/null; then
        found=$((found + 1))
      fi
    else
      if iw dev "$iface" set power_save "$value" 2>/dev/null; then
        found=$((found + 1))
      fi
    fi
  fi
  found=$((found + 1))
done < <(iw dev | awk '/^\s+Interface / { print $2 }')

if ((found == 0)); then
  echo "no wireless interfaces found" >&2
  exit 1
fi
