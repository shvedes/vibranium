#!/usr/bin/env bash

usage() {
    cat << EOF
Usage: $(basename "$0") [DIRECTORY]

Open a new Alacritty terminal window with specified working directory.

Arguments:
  DIRECTORY   Optional. Working directory for the new terminal window.
              Defaults to the user's home directory ($HOME).

Options:
  -h, --help  Show this help and exit
EOF
}

# Parse CLI arguments
case "$1" in
    -h|--help) usage; exit 0 ;;
esac

WORKDIR="${1:-$HOME}"

if [[ ! -d "$WORKDIR" ]]; then
    notify-send \
        -r 2 \
        -t 5000 \
        -u critical \
        "Terminal Emulator" \
        "Directory <i><b>$WORKDIR</b></i> does not exist!"
    exit 1
fi

alacritty msg create-window --working-directory "$WORKDIR"
