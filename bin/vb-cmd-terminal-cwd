#!/usr/bin/env bash

# Open a new Alacritty terminal window, optionally in a specified directory.
# Uses an existing Alacritty process if one is running.

source "$VIBRANIUM_PATH/vb-core-lib"

usage() {
    cat << EOF
Usage: $(basename "$0") [DIRECTORY]

Open a new Alacritty terminal window.

Arguments:
  DIRECTORY   Optional. Working directory for the new terminal window.
              Defaults to the user's home directory (\$HOME).

Options:
  -h, --help  Show this help and exit
EOF
}

# Parse CLI arguments
case "${1:-}" in
    -h|--help) usage; exit 0 ;;
    "") usage; exit 1 ;;
esac

WORKDIR="${1:-$HOME}"
ARGS=()

if pidof -q alacritty; then
    ARGS+=(msg create-window)
fi

ARGS+=(--working-directory)

if [[ ! -d "$WORKDIR" ]]; then
    notify-send -r 4 -u critical -t 3000 "Vibranium" \
        "Directory <span foreground='${P_YELLOW}'><b>$WORKDIR</b></span> does not exist!"
    exit 1
fi

exec setsid alacritty "${ARGS[@]}" "$WORKDIR"
