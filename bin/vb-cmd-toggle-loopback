#!/usr/bin/env bash

source vb-core-lib

LOOP_NAME="mic_loop"

helpers::check VIBRANIUM_VOLUME_SOURCE_LOOPBACK_VOLUME
helpers::check VIBRANIUM_VOLUME_SOURCE_LOOPBACK

VOL="${VIBRANIUM_VOLUME_SOURCE_LOOPBACK_VOLUME}%"

print_help() {
    cat <<EOF
Usage: ${0##*/} [OPTIONS]

Enable default microphone loopback (aka hear my voice)

Options:
      --help Show this help and exit
EOF
}

get_default_source() {
    pactl info | awk -F': ' '/Default Source/ {print $2}'
}

get_default_sink() {
    pactl info | awk -F': ' '/Default Sink/ {print $2}'
}

find_module_ids() {
    pactl list short modules | awk -v name="$LOOP_NAME" '$0 ~ name {print $1}'
}

get_loopback_volume() {
    if [[ $VIBRANIUM_VOLUME_SOURCE_LOOPBACK == false ]]; then
        exit 1
    fi

    local module_id sink_input vol
    module_id=$(find_module_ids | head -n1)

    if [[ -z "$module_id" ]]; then
        echo "no loopback"
        exit 1
    fi

    sink_input=$(find_sink_input_id "$module_id")
    if [[ -z "$sink_input" ]]; then
        echo "no sink input"
        exit 1
    fi

    vol=$(pactl list sink-inputs | awk -v id="$sink_input" '
        $1=="Sink" && $2=="Input" && $3=="#"id {found=1}
        found && /Volume:/ {gsub(/%/,"",$5); print $5; exit}
    ')
    echo "$vol"
    exit 0
}

find_sink_input_id() {
    local module_id="$1"
    pactl list sink-inputs | awk -v mid="$module_id" '
        /^Sink Input #[0-9]+$/ { id = substr($3, 2) }
        /^\s*Owner Module: / { if ($3 == mid) { print id; exit } }
    '
}

ACTION="apply"
if ! OPTS=$(getopt -o h -l help,get-volume -- "$@"); then
    exit 2
fi

eval set -- "$OPTS"

while true; do
    case "$1" in
        --help)
            ACTION="help"
            shift
            ;;
        --get-volume)
            get_loopback_volume
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

case "$ACTION" in
    help)
        print_help
        exit 0
        ;;
    apply)
        # If the setting is not enabled, unload any existing loopback modules
        if [[ "$VIBRANIUM_VOLUME_SOURCE_LOOPBACK" != "true" ]]; then
            MODULE_IDS=$(find_module_ids || true)
            if [[ -n "${MODULE_IDS}" ]]; then
                # Unload every matching module id
                while IFS= read -r mid; do
                    [[ -z "$mid" ]] && continue
                    pactl unload-module "$mid" >/dev/null 2>&1 || true
                done <<< "$MODULE_IDS"
            fi
            exit 0
        fi

        # If enabled: update volume for existing modules if present
        MODULE_IDS=$(find_module_ids || true)
        if [[ -n "${MODULE_IDS}" ]]; then
            while IFS= read -r mid; do
                [[ -z "$mid" ]] && continue
                SINK_INPUT_ID=$(find_sink_input_id "$mid")
                if [[ -n "$SINK_INPUT_ID" ]]; then
                    pactl set-sink-input-volume "$SINK_INPUT_ID" "$VOL" >/dev/null 2>&1 || true
                fi
            done <<< "$MODULE_IDS"
            exit 0
        else
            # Create loopback
            SOURCE=$(get_default_source)
            SINK=$(get_default_sink)
            if [[ -z "${SOURCE:-}" || -z "${SINK:-}" ]]; then
                exit 1
            fi

            NEW_MODULE_ID=$(pactl load-module module-loopback \
                source="$SOURCE" \
                sink="$SINK" \
                latency_msec=10 \
                adjust_latency=true \
                loopback_name="$LOOP_NAME" 2>/dev/null || true)

            # Wait for sink-input to appear and set volume
            for i in {1..10}; do
                SINK_INPUT_ID=$(find_sink_input_id "$NEW_MODULE_ID")
                if [[ -n "$SINK_INPUT_ID" ]]; then
                    pactl set-sink-input-volume "$SINK_INPUT_ID" "$VOL" >/dev/null 2>&1 || true
                    break
                fi
                sleep 0.1
            done
            exit 0
        fi
        ;;
    *)
        exit 2
        ;;
esac
