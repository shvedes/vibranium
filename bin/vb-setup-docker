#!/bin/bash

source vb-lib-core

export SUDO_PROMPT="$VIBRANIUM_SUDO_PROMPT"

PACKAGES=(docker docker-compose)

_operation_canceled() {
  printf "%s[VIBRANIUM]%s Operation canceled" "$R" "$RS"
  trap 'exit 1' SIGHUP SIGINT SIGTERM SIGQUIT
  # shellcheck disable=SC2034
  read -n1 -r -s -p $'. Press any key to exit' dummy
}

_operation_complete() {
  printf "%s[VIBRANIUM]%s Setup complete" "$G" "$RS"
  trap '' SIGHUP SIGINT SIGTERM SIGQUIT
  # shellcheck disable=SC2034
  read -n1 -r -p $'. Press any key to exit ' dummy
}

_add_user_to_group() {
  if ! id -nG "$USER" | grep -qw docker; then
    vb::print "$Y" "Adding ${P}${USER}${RS} to the '${P}docker${RS}' group"
    sudo usermod -aG docker "$USER"
    return 0 # was added
  fi
  return 1 # already a member
}

_configure_daemon() {
  local desired
  desired=$(
    cat << 'EOF'
{
    "log-driver": "json-file",
    "log-opts": { "max-size": "10m", "max-file": "5" },
    "dns": ["172.17.0.1"],
    "bip": "172.17.0.1/16"
}
EOF
  )

  if [ -f /etc/docker/daemon.json ] &&
    printf '%s' "$desired" | diff -q - /etc/docker/daemon.json &> /dev/null; then
    vb::print "$G" "Docker daemon config: already up to date, skipping"
    return 1 # unchanged
  fi

  vb::print "$Y" "Configuring Docker daemon (log rotation + DNS)"
  sudo mkdir -p /etc/docker

  if [[ -f /etc/docker/daemon.json ]]; then
    vb::print "$G" "Backing up existing ${B}deamon.json${RS}"
    sudo mv /etc/docker/daemon.json /etc/docker/daemon.json.bak
  fi

  printf "%s" "$desired" | sudo tee /etc/docker/daemon.json > /dev/null
  return 0 # written
}

_configure_resolved() {
  local conf=/etc/systemd/resolved.conf.d/20-docker-dns.conf
  local desired=$'[Resolve]\nDNSStubListenerExtra=172.17.0.1'

  if [ -f "$conf" ] &&
    printf '%s' "$desired" | diff -q - "$conf" &> /dev/null; then
    vb::print "$G" "systemd-resolved config: already up to date, skipping"
    return 1 # unchanged
  fi

  vb::print "$Y" "Exposing systemd-resolved to the Docker network"
  sudo mkdir -p /etc/systemd/resolved.conf.d

  if [[ -f "$conf" ]]; then
    vb::print "$G" "Backing up existing ${B}20-docker-dns.conf${RS}"
    sudo mv "$conf" "$conf.bak"
  fi

  printf "%s" "$desired" | sudo tee "$conf" > /dev/null
  sudo systemctl restart systemd-resolved
  return 0 # written
}

_configure_no_block_boot() {
  local conf=/etc/systemd/system/docker.service.d/no-block-boot.conf
  local desired=$'[Unit]\nDefaultDependencies=no'

  if [ -f "$conf" ] &&
    printf '%s' "$desired" | diff -q - "$conf" &> /dev/null; then
    vb::print "$G" "Boot-block prevention drop-in: already up to date, skipping"
    return 1 # unchanged
  fi

  vb::print "$Y" "Preventing Docker from blocking boot (${B}network-online.target${RS})"
  sudo mkdir -p /etc/systemd/system/docker.service.d

  if [[ -f "$conf" ]]; then
    vb::print "$G" "Backing up existing ${B}no-block-boot.conf${RS}"
    sudo mv "$conf" "$conf.bak"
  fi

  printf '%s' "$desired" | sudo tee "$conf" > /dev/null
  return 0 # written
}

_configure_ufw() {
  # Skip entirely if ufw is not installed or not active
  if ! command -v ufw &> /dev/null; then
    return 2 # ufw absent
  fi
  if ! sudo ufw status 2> /dev/null | grep -q "^Status: active"; then
    return 2 # ufw inactive
  fi

  local dns_rule_present=false
  local ufw_docker_present=false

  # DNS rule: look for our comment tag in the ruleset
  if sudo ufw status verbose 2> /dev/null | grep -q 'allow-docker-dns'; then
    dns_rule_present=true
  fi

  # ufw-docker: it appends a clearly-marked block to /etc/ufw/after.rules
  if grep -q 'BEGIN UFW AND DOCKER' /etc/ufw/after.rules 2> /dev/null; then
    ufw_docker_present=true
  fi

  if $dns_rule_present && $ufw_docker_present; then
    vb::print "$G" "UFW Docker rules: already in place, skipping"
    return 1 # unchanged
  fi

  vb::print "$Y" "Configuring UFW for Docker"

  if ! $dns_rule_present; then
    sudo ufw allow in proto udp from 172.16.0.0/12 to 172.17.0.1 port 53 \
      comment 'allow-docker-dns' &> /dev/null
  fi

  if ! $ufw_docker_present; then
    local ufw_docker_url="https://raw.githubusercontent.com/chaifeng/ufw-docker/refs/heads/master/ufw-docker"
    curl -ssfL "$ufw_docker_url" | sudo bash -s -- install &> /dev/null
  fi

  return 0 # applied
}

# ─────────────────────────────────────────────────────────────

term::show_header
term::disable_input

if systemctl -q is-enabled docker.socket 2> /dev/null ||
  systemctl -q is-enabled docker.service 2> /dev/null; then
  vb::print "$G" "Docker is already set up and working"
  _operation_complete
  exit 0
fi

vb::print "$Y" "You're about to setup Docker"

if ! term::ask_yes_no Y "Proceed with setup?"; then
  _operation_canceled
  exit 1
fi

term::disable_input
if term::ask_yes_no Y "Would you like to install LazyDocker as well?"; then
  vb-tui-install \
    --exec "lazydocker" \
    --name "Lazy Docker" \
    --icon "docker-desktop" \
    --category "System" \
    --keywords "VM;Container;Apps"
  PACKAGES+=(lazydocker)
fi

if ! vb-pkg-install --embedded -- "${PACKAGES[@]}"; then
  _operation_canceled
  exit 1
fi

summary_rules=()

# ── Systemd unit ──────────────────────────────────────────────
if term::ask_yes_no Y "Enable systemd socket? (${G}recommended${RS} - starts Docker on first use)"; then
  term::disable_input
  vb::print "$Y" "Enabling docker.socket"
  sudo systemctl -q enable --now docker.socket
  summary_rules+=("Docker unit: ${G}docker.socket${RS} enabled and started")
else
  vb::print "$Y" "Enabling docker.service"
  sudo systemctl -q enable --now docker.service
  summary_rules+=("Docker unit: ${G}docker.service${RS} enabled and started")
fi

# ── Daemon configuration ──────────────────────────────────────
if _configure_daemon; then
  summary_rules+=("Daemon config: ${G}written${RS} (log rotation, DNS bridge)")
else
  summary_rules+=("Daemon config: ${P}unchanged${RS}")
fi

# ── systemd-resolved DNS stub ─────────────────────────────────
if _configure_resolved; then
  summary_rules+=("systemd-resolved: ${G}updated${RS} (172.17.0.1 stub listener added)")
else
  summary_rules+=("systemd-resolved: ${P}unchanged${RS}")
fi

# ── Boot-block prevention ─────────────────────────────────────
if _configure_no_block_boot; then
  sudo systemctl daemon-reload
  summary_rules+=("Boot-block drop-in: ${G}written${RS}")
else
  summary_rules+=("Boot-block drop-in: ${P}unchanged${RS}")
fi

# ── UFW firewall rules ────────────────────────────────────────
_configure_ufw
case $? in
  0)
    summary_rules+=("UFW: ${G}Docker rules applied${RS} (DNS stub + ufw-docker)")
    ;;
  1)
    summary_rules+=("UFW: ${P}unchanged${RS}")
    ;;
  2)
    summary_rules+=("UFW: ${Y}not active${RS}, skipped")
    ;;
esac

# ── Docker group ──────────────────────────────────────────────
if _add_user_to_group; then
  vb::print "$Y" "A re-login is needed for the group change to take effect"
  summary_rules+=("User ${P}${USER}${RS}: ${G}added${RS} to the ${P}docker${RS} group (re-login required)")
else
  summary_rules+=("User ${P}${USER}${RS}: already in the ${P}docker${RS} group")
fi

vb::print "$B" "If you want to fine-tune your Docker configuration, consider reading ${B}docker(1)${RS}"

echo ""
vb::print "$B" "── Summary ─────────────────────────────"
for rule in "${summary_rules[@]}"; do
  vb::print "$B" " • $rule"
done
vb::print "$B" "─────────────────────────────────────────"
echo ""

_operation_complete
