#!/bin/bash

source vb-lib-cli
source vb-lib-core

set -euo pipefail

_pause() {
  term::disable_input
  # shellcheck disable=SC2034
  read -n1 -r -p $'\e[0;33m[VIBRANIUM]\e[0m Press any key to exit' dummy
}

_fail() {
  vb::print "$R" "$1" >&2
  _pause
  exit 1
}

# Check for any dirty state (unstaged, staged, or untracked files) and
# stash them before the pull so the working tree is clean.  The stash
# is re-applied after the update via _apply_stash / _restore_stash_and_fail.
_check_and_stash() {
  if [[ -n "$(git -C "$VIBRANIUM" status --porcelain)" ]]; then
    vb::print "$Y" "Stashing local changes..."

    if ! git -C "$VIBRANIUM" stash push --include-untracked -m "autostash before update" -q; then
      _fail "Failed to stash local changes."
    fi

    stashed=true
    vb::print "$G" "Local changes stashed"
  else
    vb::print "$G" "No local changes to stash"
  fi

  if [[ -f "$VIBRANIUM/bin/vb-cmd-edit-wm-config" ]] && file "$VIBRANIUM/bin/vb-cmd-edit-wm-config" | grep -q ELF; then
    rm -f "$VIBRANIUM/bin/vb-cmd-edit-wm-config"
    vb::print "$Y" "Removed old compiled vb-cmd-edit-wm-config"
  fi
}

_apply_stash() {
  if [[ "$stashed" == true ]]; then
    if ! git -C "$VIBRANIUM" stash apply -q; then
      _fail "Stash apply failed due to conflicts. Your changes are preserved in the stash (check 'git stash list'). Resolve conflicts in the working tree, then run 'git stash drop'."
    fi

    git -C "$VIBRANIUM" stash drop -q
    vb::print "$G" "Stash applied"
  fi
}

_restore_stash_and_fail() {
  local msg="$1"
  if [[ "$stashed" == true ]]; then
    if ! git -C "$VIBRANIUM" stash pop -q; then
      vb::print "$Y" "WARNING: Could not restore stashed changes automatically." >&2
      vb::print "$Y" "Check 'git stash list' and restore manually." >&2
    fi
  fi
  _fail "$msg"
}

usage() {
  shcat >&2 << EOF
Usage: ${0##*/} [OPTION]... [CHANNEL]

Update Vibranium to the latest version.

Options:
      --nuke            discard all local changes and reset to remote state
      --help            display this help and exit
EOF
}

_detect_channel() {
  local branch
  branch=$(git -C "$VIBRANIUM" branch --show-current)
  if [[ -z "$branch" ]]; then
    echo "release"
  elif [[ "$branch" == "master" ]]; then
    echo "upstream"
  else
    _fail "On unknown branch '$branch'. Specify a channel."
  fi
}

_nuke() {
  local channel target

  if [[ -n "$channel_arg" ]]; then
    channel="$channel_arg"
  else
    channel="$(_detect_channel)"
  fi

  vb::print "$R" "WARNING: This will DISCARD ALL local changes, stashes, and untracked files."
  if ! term::ask_yes_no N "Are you sure?"; then
    vb::print "$Y" "Nuke aborted"
    _pause
    exit 0
  fi

  if ! term::ask_yes_no N "Really? This cannot be undone."; then
    vb::print "$Y" "Nuke aborted"
    _pause
    exit 0
  fi

  git -C "$VIBRANIUM" fetch --all --tags --prune --prune-tags &> /dev/null &
  if ! term::spinner $! "${Y}[VIBRANIUM]${RS} Fetching latest from remote..." "${G}✔${RS}" "${R}✘${RS}"; then
    _fail "Failed to fetch updates."
  fi

  if [[ "$channel" == "release" ]]; then
    local latest_tag
    latest_tag=$(git -C "$VIBRANIUM" for-each-ref --sort=-version:refname --format='%(refname:short)' --count=1 'refs/tags/*')
    if [[ -z "$latest_tag" ]]; then
      _fail "No release tags found."
    fi
    target=$(git -C "$VIBRANIUM" rev-parse "${latest_tag}^{}")
  else
    local remote_ref
    case "$channel" in
      upstream)
        remote_ref="origin/master"
        ;;
      *)
        remote_ref="origin/$channel"
        ;;
    esac
    if ! git -C "$VIBRANIUM" rev-parse --verify "$remote_ref" &> /dev/null; then
      _fail "Remote branch '$remote_ref' not found. Verify your channel name or check available remotes with 'git branch -r'."
    fi
    target="$remote_ref"
  fi

  vb::print "$Y" "Resetting to $target..."
  if ! git -C "$VIBRANIUM" reset --hard "$target"; then
    _fail "Failed to reset to $target."
  fi

  vb::print "$Y" "Cleaning untracked files..."
  git -C "$VIBRANIUM" clean -fdx

  vb::print "$Y" "Clearing all stashes..."
  git -C "$VIBRANIUM" stash clear

  rm -f "$VIBRANIUM_STATE/update.available" || true
  vb-refresh-waybar-module vb-update
  vb::print "$G" "Repository reset to clean state"
}

_update() {
  local channel
  # stashed must not be local so _check_and_stash and _apply_stash can share it
  stashed=false

  if [[ -n "$channel_arg" ]]; then
    channel="$channel_arg"
  else
    channel="$(_detect_channel)"
  fi

  git -C "$VIBRANIUM" fetch --all --tags --prune --prune-tags &> /dev/null &
  if ! term::spinner $! "${Y}[VIBRANIUM]${RS} Getting updates from remote" "" ""; then
    _fail "Failed to fetch updates. Check your network or repository permissions."
  fi

  if [[ "$channel" == "release" ]]; then
    local latest_tag current_tag latest_commit current_commit

    latest_tag=$(git -C "$VIBRANIUM" for-each-ref --sort=-version:refname --format='%(refname:short)' --count=1 'refs/tags/*')

    # Use ^{} to dereference annotated tags to their underlying commit,
    # so the comparison against HEAD (always a commit hash) is valid
    latest_commit=$(git -C "$VIBRANIUM" rev-parse "${latest_tag}^{}")
    current_commit=$(git -C "$VIBRANIUM" rev-parse HEAD)
    current_tag=$(git -C "$VIBRANIUM" describe --tags --exact-match --always --abbrev=7 2> /dev/null)

    vb::print "$Y" "Local:  $current_tag ($current_commit)"
    vb::print "$Y" "Remote: $latest_tag ($latest_commit)"

    if [[ "$current_commit" == "$latest_commit" ]]; then
      vb::print "$G" "You are up to date"
      rm -f "$VIBRANIUM_STATE/update.available" || true
      vb-refresh-waybar-module vb-update
      _pause
      exit 0
    fi

    _check_and_stash

    vb::print "$Y" "Updating to ${latest_tag}..."
    if ! git -C "$VIBRANIUM" merge --ff-only "$latest_tag" -q; then
      _restore_stash_and_fail "Failed to fast-forward to $latest_tag."
    fi

    _apply_stash

    if ! vb-update-migrate; then
      _fail "Update to $latest_tag succeeded but migration failed. Please check manually."
    fi

    vb::print "$G" "Vibranium updated to $latest_tag"

  else
    local remote_ref
    case "$channel" in
      upstream)
        remote_ref="origin/master"
        ;;
      *)
        remote_ref="origin/$channel"
        ;;
    esac

    if ! git -C "$VIBRANIUM" rev-parse --verify "$remote_ref" &> /dev/null; then
      _fail "Remote branch '$remote_ref' not found. Verify your channel name or check available remotes with 'git branch -r'."
    fi

    local remote_commit current_commit remote_short current_short behind

    remote_commit=$(git -C "$VIBRANIUM" rev-parse "$remote_ref")
    remote_short=$(git -C "$VIBRANIUM" rev-parse --short "$remote_ref")
    current_commit=$(git -C "$VIBRANIUM" rev-parse HEAD)
    current_short=$(git -C "$VIBRANIUM" rev-parse --short HEAD)
    behind=$(git -C "$VIBRANIUM" rev-list HEAD.."$remote_ref" --count)

    vb::print "$Y" "Local:  $current_short ($current_commit)"
    vb::print "$Y" "Remote: $remote_short ($remote_commit)"

    if ((behind == 0)); then
      if [[ "$current_commit" == "$remote_commit" ]]; then
        vb::print "$G" "You are up to date"
      else
        local ahead
        ahead=$(git -C "$VIBRANIUM" rev-list "$remote_ref"..HEAD --count)
        vb::print "$G" "You are $ahead commit(s) ahead of remote, nothing to pull"
      fi
      rm -f "$VIBRANIUM_STATE/update.available" || true
      vb-refresh-waybar-module vb-update
      _pause
      exit 0
    fi

    vb::print "$Y" "$behind new commit(s) available"

    _check_and_stash

    vb::print "$Y" "Updating to latest upstream..."

    # We already fetched, so merge rather than pull to avoid a second fetch
    if ! git -C "$VIBRANIUM" merge --ff-only "$remote_ref" -q; then
      _restore_stash_and_fail "Failed to merge upstream changes."
    fi

    _apply_stash

    if ! vb-update-migrate; then
      _fail "Update succeeded but migration failed. Please check manually."
    fi

    vb::print "$G" "Vibranium updated to $remote_short ($channel)"
  fi

  vb-cmd-reload --quiet
  _pause
}

nuke=false
channel_arg=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --nuke)
      nuke=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --*)
      echo "${0##*/}: unknown option '$1'" >&2
      echo "Try '${0##*/} --help' for more information." >&2
      exit 1
      ;;
    *)
      if [[ -z "$channel_arg" ]]; then
        channel_arg="$1"
      else
        echo "${0##*/}: unexpected argument '$1'" >&2
        echo "Try '${0##*/} --help' for more information." >&2
        exit 1
      fi
      shift
      ;;
  esac
done

term::show_header
term::disable_input

if [[ "$nuke" == true ]]; then
  _nuke
  _pause
  exit 0
fi

if term::ask_yes_no Y "Proceed with update?"; then
  _update
  rm -f "$VIBRANIUM_STATE/update.available" || true
  vb-refresh-waybar-module vb-update
else
  vb::print "$R" "Operation aborted"
  _pause
  exit 1
fi
