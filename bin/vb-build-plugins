#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

SELF="${0##*/}"

usage() {
  shcat << EOF
Usage: $SELF [OPTION]...

Regenerate launcher plugin main.js files from their canonical sources.

Options:
  --check           Report drift without writing
  -v, --verbose     Enable verbose output
  -h, --help        Show this help and exit
EOF
}

ROOT="$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)"
PLUGIN_ROOT="$ROOT/shell/features/launcher/plugins"

MAP=(
  "color|shell/common/math/Color.js|// --- launcher shape ---"
)

# Read a file into the nameref target, stripping trailing newlines the way
# command substitution does, without forking a subshell.
read_file() {
  local -n rf_target=$1
  local rf_path=$2
  rf_target=""
  local rf_line
  while IFS= read -r rf_line || [[ -n $rf_line ]]; do
    rf_target+="$rf_line"$'\n'
  done < "$rf_path"
  while [[ $rf_target == *$'\n' ]]; do
    rf_target="${rf_target%$'\n'}"
  done
}

# Copy the canonical engine into the nameref target, dropping the QML-only
# lines that a plugin scope cannot parse.
strip_canonical() {
  local -n sc_target=$1
  local sc_path=$2
  sc_target=""
  local sc_line
  local pragma_re import_re
  pragma_re='^[[:blank:]]*\.pragma[[:blank:]][[:blank:]]*library[[:blank:]]*;*[[:blank:]]*$'
  import_re='^[[:blank:]]*\.import[[:blank:]].*as[[:blank:]][A-Za-z_$][A-Za-z0-9_$]*[[:blank:]]*;*[[:blank:]]*$'
  while IFS= read -r sc_line || [[ -n $sc_line ]]; do
    if [[ $sc_line =~ $pragma_re ]]; then
      continue
    fi
    if [[ $sc_line =~ $import_re ]]; then
      continue
    fi
    sc_target+="$sc_line"$'\n'
  done < "$sc_path"
  while [[ $sc_target == *$'\n' ]]; do
    sc_target="${sc_target%$'\n'}"
  done
}

# Copy the adapter (from the marker line to EOF) into the nameref target.
read_adapter() {
  local -n ra_target=$1
  local ra_path=$2
  local ra_marker=$3
  ra_target=""
  local ra_line ra_found=0
  while IFS= read -r ra_line || [[ -n $ra_line ]]; do
    if ((ra_found == 0)); then
      if [[ $ra_line == *"$ra_marker"* ]]; then
        ra_found=1
      fi
    fi
    if ((ra_found)); then
      ra_target+="$ra_line"$'\n'
    fi
  done < "$ra_path"
  while [[ $ra_target == *$'\n' ]]; do
    ra_target="${ra_target%$'\n'}"
  done
}

# Compute the sha256 of a string into the nameref target without command
# substitution, parsing sha256sum's output with read.
# shellcheck disable=SC2034
hash_string() {
  local -n hs_target=$1
  local hs_input=$2
  hs_target=""
  local hs_hash hs_rest
  while read -r hs_hash hs_rest; do
    hs_target="$hs_hash"
    break
  done < <(printf '%s' "$hs_input" | sha256sum)
}

CHECK=0

while (($# > 0)); do
  case "$1" in
    --check)
      CHECK=1
      shift
      ;;
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      log Error "unknown option: $1"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
    *)
      log Error "unexpected argument: $1"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
  esac
done

set -uo pipefail

fail=0
for entry in "${MAP[@]}"; do
  plugin="${entry%%|*}"
  rest="${entry#*|}"
  canonical="$ROOT/${rest%%|*}"
  marker="${rest#*|}"
  main="$PLUGIN_ROOT/$plugin/main.js"

  if [[ ! -f "$canonical" ]]; then
    log Error "canonical missing for $plugin: $canonical"
    fail=1
    continue
  fi
  if [[ ! -f "$main" ]]; then
    log Error "plugin main missing: $main"
    fail=1
    continue
  fi

  marker_found=0
  mf_line=""
  while IFS= read -r mf_line || [[ -n $mf_line ]]; do
    if [[ $mf_line == *"$marker"* ]]; then
      marker_found=1
      break
    fi
  done < "$main"
  if ((marker_found == 0)); then
    log Error "marker missing in $main: $marker"
    fail=1
    continue
  fi

  engine=""
  adapter=""
  current=""
  strip_canonical engine "$canonical"
  read_adapter adapter "$main" "$marker"
  expected="$engine"$'\n'"$adapter"
  read_file current "$main"

  if [[ "$expected" == "$current" ]]; then
    current_hash=""
    hash_string current_hash "$current"
    echo "vb-build-plugins: $plugin/main.js up to date ($current_hash)"
    continue
  fi
  engine_hash=""
  hash_string engine_hash "$engine"
  echo "vb-build-plugins: $plugin/main.js differs from canonical + adapter"
  echo "  canonical: $canonical ($engine_hash)"
  echo "  adapter marker: $marker"
  if ((CHECK == 1)); then
    fail=1
    continue
  fi
  printf '%s' "$expected" > "$main"
  expected_hash=""
  hash_string expected_hash "$expected"
  echo "  wrote $main ($expected_hash)"
done

exit "$fail"
