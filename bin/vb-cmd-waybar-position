#!/usr/bin/env bash

WAYBAR_CONF="${XDG_CONFIG_HOME-:$HOME/.config}/waybar/config.jsonc"
DUNST_CONF="${XDG_CONFIG_HOME-:$HOME/.config}/dunst/dunstrc"

usage() {
    cat << EOF
Usage: ${0##*/} [--top|--bottom] [--help]

Move Waybar and Dunst notifications to the top or bottom of the screen.

Options:
  --top       Move modules to the top
  --bottom    Move modules to the bottom
  -h, --help  Show this help and exit
EOF
}

TARGET=""

for arg in "$@"; do
    case "$arg" in
        --top)    TARGET="top" ;;
        --bottom) TARGET="bottom" ;;
        -h|--help|"") usage; exit 0 ;;
        *) echo "Unknown option: $arg" >&2; usage; exit 1 ;;
    esac
done

CURRENT_POSITION="$(grep position "$WAYBAR_CONF" | awk -F'"' '{print $4}')"

[[ "$CURRENT_POSITION" == "$TARGET" ]] && exit 0

sed -i "/position/s/${CURRENT_POSITION}/${TARGET}/" "$WAYBAR_CONF"

case "$TARGET" in
    top)    ORIGIN="top-right"    ;;
    bottom) ORIGIN="bottom-right" ;;
esac

if [[ ! -f "$DUNST_CONF" ]]; then
    printf "[global]\norigin = %s\n" "$ORIGIN" > "$DUNST_CONF"
elif ! grep -q origin "$DUNST_CONF"; then
    printf "\norigin = %s\n" "$ORIGIN" >> "$DUNST_CONF"
else
    sed -i "/origin/s/${CURRENT_POSITION}/${TARGET}/" "$DUNST_CONF"
fi

systemctl --user restart waybar
vb-cmd-refresh-dunst
