#!/bin/bash

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION | PROFILE]

Set power profiles in Vibranium.

Options:
  --next           Next power profile
  --prev           Previous power profile
  --get            Get the active power profile
  --list           List available power profiles
  -f, --force      Force rebuild state file
  -q, --quiet      Be quiet (cli and notification)
  -h, --help       Display this help and exit
  -v, --verbose    Enable verbose output

  [PROFILE]    Set a specific profile (see: powerprofilesctl list)
EOF
}

notify() {
  local profile="$1"
  local icon=""
  local label=""

  log Info "Preparing notification for profile=$profile"

  if [[ $QUIET == true ]]; then
    log Info "Notification suppressed (quiet mode)"
    return
  fi

  case "$profile" in
    "performance")
      icon="power-profile-performance-symbolic"
      label="Performance"
      ;;
    "balanced")
      icon="power-profile-balanced-symbolic"
      label="Balanced"
      ;;
    "power-saver")
      icon="power-profile-power-saver-symbolic"
      label="Powersave"
      ;;
    *)
      icon="battery-symbolic"
      label="$profile"
      ;;
  esac

  source vb-lib-core

  helpers::check \
    VIBRANIUM_GLOBAL_USE_OSD \
    VIBRANIUM_BAR_POWER_PROFILE_MODULE_ENABLE

  # Skip notification when waybar is active AND the power-profile module
  # is enabled, because the module itself reflects the current profile
  # visually in the bar. Only notify directly when waybar is off (e.g.
  # fullscreen game) or the module is disabled by the user.
  local module_enabled="$VIBRANIUM_BAR_POWER_PROFILE_MODULE_ENABLE"

  if ! systemctl -q --user is-active waybar || [[ ! $module_enabled == "true" ]]; then
    if [[ $VIBRANIUM_GLOBAL_USE_OSD == "true" ]]; then
      swayosd-client --custom-message "$label" --custom-icon "$icon"
    else
      notify-send -r 3 -t 1500 "Power Management" "Power profile set to <b>${label,,}</b>"
    fi
  fi

  log Info "Notification sent: profile=$profile label=$label"
}

get_power_profile() {
  local state="$VIBRANIUM_STATE/power-profile"
  if [[ -f "$state" ]]; then
    IFS=: read -r _ profile < "$state"
    printf '%s\n' "$profile"
    return
  fi

  local active
  active="$(powerprofilesctl get)"
  printf '%s\n' "$active"
}

set_power_profile() {
  local target="$1"
  log Info "Setting power profile to $target"
  powerprofilesctl set "$target" &
  log Info "powerprofilesctl set command issued in background (target=$target)"
  _write_state "$target"
}

_write_state() {
  local current="$1"
  {
    printf 'current:%s\n\n' "$current"
    printf '%s\n' "${PROFILES[@]}"
  } > "$VIBRANIUM_STATE/power-profile"
  log Info "State saved: current=$current profiles=${PROFILES[*]}"
}

_load_state() {
  local state="$VIBRANIUM_STATE/power-profile"
  local _detected

  log Info "Loading state from: $state (force=$FORCE)"

  if [[ -f "$state" ]] && [[ $FORCE == false ]]; then
    mapfile -t _lines < "$state"
    CURRENT="${_lines[0]#current:}"
    PROFILES=("${_lines[@]:2}")

    if [[ ${#PROFILES[@]} -gt 0 ]]; then
      log Info "State loaded: current=$CURRENT profiles=${PROFILES[*]}"
      return
    fi
  fi

  # Cold start or repair: regenerate profiles from powerprofilesctl
  log Info "Cold start: detecting profiles via powerprofilesctl"
  _detected=()
  while IFS= read -r line; do
    # Match profile lines: optional leading whitespace/asterisk, then name, then colon.
    # Extract the profile name into BASH_REMATCH[1] and discard the rest.
    if [[ "$line" =~ ^[*[:space:]]+([a-zA-Z0-9-]+):$ ]]; then
      _detected+=("${BASH_REMATCH[1]}")
    fi
  done < <(powerprofilesctl list)

  log Info "Profiles detected: ${_detected[*]}"

  PROFILES=()

  for profile in balanced performance power-saver; do
    for detected in "${_detected[@]}"; do
      if [[ "$detected" == "$profile" ]]; then
        PROFILES+=("$profile")
      fi
    done
  done

  if [[ -z "$CURRENT" ]]; then
    CURRENT="$(powerprofilesctl get)"
  fi

  log Info "Profiles ordered: ${PROFILES[*]}"
  _write_state "$CURRENT"
}

VERBOSE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

ACTION="next"
QUIET="false"
FORCE=false
SELF="${0##*/}"

log Info "$SELF started"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -q | --quiet)
      QUIET=true
      shift
      ;;
    --next | --prev)
      ACTION="${1/--/}"
      log Info "Action: $ACTION"
      shift
      ;;
    -f | --force)
      FORCE=true
      shift
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --get)
      get_power_profile
      exit 0
      ;;
    --list)
      _load_state
      printf "%s\n" \
        "${PROFILES[@]}"
      exit 0
      ;;
    "")
      ACTION="next"
      shift
      ;;
    -*)
      log Error "Unknown option: $*"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
    *)
      TARGET_PROFILE="$1"
      log Info "Target profile: $TARGET_PROFILE"
      shift
      ;;
  esac
done

log Info "Args parsed: action=$ACTION quiet=$QUIET force=$FORCE target=$TARGET_PROFILE"

if ! command -v powerprofilesctl > /dev/null; then
  log Error "missing required dependencies: power-profiles-daemon"
  vb-cmd-dep-notify --name "Power Management" --deps "power-profiles-daemon"
  exit 1
fi
log Info "powerprofilesctl: available"

_load_state

if [[ ${#PROFILES[@]} -eq 0 ]]; then
  log Error "could not determine available power profiles"
  exit 1
fi

log Info "Current profile: $CURRENT"
log Info "Profile count: ${#PROFILES[@]}"

# Validate the target profile against the ordered list from _load_state.
# The first guard rejects an explicit TARGET_PROFILE that is not available.
# The second guard is reached when no TARGET_PROFILE was given and the
# script must calculate the next/prev index.
if [[ -n "$TARGET_PROFILE" ]] && [[ ! " ${PROFILES[*]} " == *" $TARGET_PROFILE "* ]]; then
  log Error "Unknown profile: $TARGET_PROFILE"
  log Error "Available: ${PROFILES[*]}"
  exit 1
fi

log Info "Validating target: $TARGET_PROFILE"
if [[ ! " ${PROFILES[*]} " == *" $TARGET_PROFILE "* ]]; then
  current_index=0

  for i in "${!PROFILES[@]}"; do
    if [[ "${PROFILES[$i]}" == "$CURRENT" ]]; then
      current_index=$i
      break
    fi
  done
  log Info "Current index resolved: $current_index for profile=$CURRENT"

  # Wrap-around modulo arithmetic for cycling through the profile list.
  # The "+ ${#PROFILES[@]}" in the "prev" branch ensures the result
  # stays non-negative before the modulo.
  case "$ACTION" in
    "next")
      next_index=$(((current_index + 1) % ${#PROFILES[@]}))
      log Info "Next profile: current_index=$current_index next_index=$next_index"
      ;;
    "prev")
      next_index=$(((current_index - 1 + ${#PROFILES[@]}) % ${#PROFILES[@]}))
      log Info "Previous profile: current_index=$current_index next_index=$next_index"
      ;;
  esac

  TARGET_PROFILE="${PROFILES[$next_index]}"

  if [[ $QUIET == false ]]; then
    echo "$TARGET_PROFILE"
  fi
fi

log Info "Resolved target profile: $TARGET_PROFILE"
set_power_profile "$TARGET_PROFILE"
vb-refresh-waybar-module power-profile &

notify "$TARGET_PROFILE"
log Info "$SELF completed: target=$TARGET_PROFILE"
