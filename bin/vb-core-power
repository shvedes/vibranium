#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"

if ! missing="$(vb-cmd-is-present powerprofilesctl)"; then
    print_error "missing required dependencies: power-profiles-daemon"
    is_headless && vb-cmd-dep-notify --name "Clipboard Manager" --deps "power-profiles-daemon"
    exit 1
fi

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTION]

Set power profiles in Vibranium.

Options:
  --next       Next power profile
  --prev       Previous power profile
  -q, --quiet  Do not output in console

  [profile]    Set specified profile. Can be power-saver,balanced,performance
EOF
}

notify() {
    local feedback_enabled gl_use_osd pp_use_osd

    check_bool VIBRANIUM_GLOBAL_POWER_PROFILE_USE_FEEDBACK false
    feedback_enabled="$VIBRANIUM_GLOBAL_POWER_PROFILE_USE_FEEDBACK"

    if [[ $feedback_enabled  == false ]]; then
        return 0
    fi

    local profile="$1"
    local icon=""
    local label=""

    case "$profile" in
        "performance")
            icon="power-profile-performance-symbolic"
            label="Performance"
            ;;
        "balanced")
            icon="power-profile-balanced-symbolic"
            label="Balanced"
            ;;
        "power-saver")
            icon="power-profile-power-saver-symbolic"
            label="Powersave"
            ;;
    esac

    check_bool VIBRANIUM_GLOBAL_POWER_PROFILE_USE_OSD true

    pp_use_osd="$VIBRANIUM_GLOBAL_POWER_PROFILE_USE_OSD"
    gl_use_osd="$VIBRANIUM_GLOBAL_USE_OSD"

    if [[ $gl_use_osd = true && $pp_use_osd = true ]]; then
        swayosd-client --custom-message "$label" --custom-icon "$icon"
    else
        notify-send -r 2 -t 1500 "Vibranium" "Power profile set to <b>${label,,}</b>"
    fi
}

update_cache() { echo "$1" > "$VIBRANIUM_STATE/power-profile"; }

toggle_blur() {
    local respect_pp blur_enabled

    check_bool VIBRANIUM_GLOBAL_RESPECT_POWER_PROFILE true
    respect_pp="$VIBRANIUM_GLOBAL_RESPECT_POWER_PROFILE"

    blur_enabled="$(hyprctl -j getoption decoration:blur:enabled | jq -r '.int')"

    if [[ "$TARGET_PROFILE" == "power-saver" ]]; then
        if [[ $respect_pp == true ]]; then
            if [[ "$blur_enabled" == 1 ]]; then
                touch "$VIBRANIUM_STATE/blur.restore"
                vb-cmd-toggle-blur --quiet
            fi
        fi
    else
        if [[ $blur_enabled == 0 && -f $VIBRANIUM_STATE/blur.restore ]]; then
            vb-cmd-toggle-blur --quiet
            rm "$VIBRANIUM_STATE/blur.restore"
        fi
    fi
}

ACTION="next"
QUIET="false"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -q|--quiet)
            QUIET=true
            shift
            ;;
        --next|--prev)
            ACTION="${1/--/}"
            shift
            ;;
        power-saver|balanced|performance)
            TARGET_PROFILE="$1"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --*)
            echo "Unknown option: $@." >&2
            echo "Use flag --help to see available options." >&2
            exit 1
            ;;
        *)
            echo "Unknown profile: $1." >&2
            echo "Use flag --help to see available options." >&2
            exit 1
            ;;
    esac
done

USER_ARGS=()
PROFILES=("power-saver" "balanced" "performance")
CURRENT="$(vb-cmd-get-power)"

if [[ ! " ${PROFILES[*]} " == *" $TARGET_PROFILE "* ]]; then
    current_index=0

    for i in "${!PROFILES[@]}"; do
        if [[ "${PROFILES[$i]}" == "$CURRENT" ]]; then
            current_index=$i
            break
        fi
    done

    case "$ACTION" in
        "next")
            next_index=$(((current_index + 1) % ${#PROFILES[@]}))
            ;;
        "prev")
            next_index=$(((current_index - 1 + ${#PROFILES[@]}) % ${#PROFILES[@]}))
            ;;
    esac

    TARGET_PROFILE="${PROFILES[$next_index]}"

    if [[ $QUIET == false ]]; then
        echo "$TARGET_PROFILE"
    fi
fi

vb-cmd-refresh-bar-module power-profile &
powerprofilesctl set "$TARGET_PROFILE" &
update_cache "$TARGET_PROFILE"
notify "$TARGET_PROFILE"
toggle_blur
