#!/bin/bash

source vb-lib-core

helpers::check \
  VIBRANIUM_BAR_CPU_TEMP_MODULE_ENABLE \
  VIBRANIUM_BAR_GPU_TEMP_MODULE_ENABLE \
  VIBRANIUM_BAR_RAM_MODULE_ENABLE \
  VIBRANIUM_BAR_DISK_MODULE_ENABLE

if [[
  "$VIBRANIUM_BAR_CPU_TEMP_MODULE_ENABLE" == true ||
  "$VIBRANIUM_BAR_GPU_TEMP_MODULE_ENABLE" == true ||
  "$VIBRANIUM_BAR_RAM_MODULE_ENABLE" == true ||
  "$VIBRANIUM_BAR_DISK_MODULE_ENABLE" == true
]]; then
  printf '{"text":"|","tooltip":false}'
else
  printf '{"text":""}'
fi
