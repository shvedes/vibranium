#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vibranium-core-lib"

ACTIONS=()

if [[ -f "$XDG_RUNTIME_DIR/vibranium-timer.remaining" ]]; then
    ACTIONS+=("Stop timer")
else
    ACTIONS+=("Set timer")
fi

ACTIONS+=(
    "Toggle read mode"
    "Toggle inhibitor"
)

if command -v syncthing > /dev/null; then
    ACTIONS+=("Launch Syncthing")
fi

ACTIONS+=("Reload Vibranium")

if command -v pass > /dev/null; then
    ACTIONS+=("Password manager")
fi

if [[ "$(systemctl --user is-active mpd)" == "active" ]]; then
    mpd_status="$(mpc status 2>/dev/null)"
fi

spotify_status="$(playerctl -p spotify status)"
if [[ "$mpd_status" == *"[playing]"* || "$spotify_status" == "Playing" ]]; then
    ACTIONS+=("Copy playing track")
fi

CHOSEN="$(printf "%s\n" "${ACTIONS[@]}" | rofi_cmd "Utilities" "search...")"

case "$CHOSEN" in
    "Toggle read mode")
        vibranium-cmd-toggle-readmode
        exit 0
        ;;
    "Copy playing track")
        vibranium-cmd-copy-track --notify
        exit 0
        ;;
    *"Stop timer"*)
        pkill -f vibranium-utils-timer
        exit 0
        ;;
    "Set timer")
        setsid vibranium-utils-timer
        exit 0
        ;;
    "Launch Syncthing")
        vibranium-app-syncthing
        exit 0
        ;;
    "Reload Vibranium")
        vibranium-utils-reload
        exit 0
        ;;
    "Toggle inhibitor")
        vibranium-cmd-toggle-inhibit
        exit 0
        ;;
    "Password manager")
        vibranium-utils-password-manager
        ;;
    "" | *)
        exit 1
        ;;
esac
