#!/usr/bin/env bash

# Update Hyprlock configuration to use the current Vibranium wallpaper
# with optional blur/dim effect.

source "$VIBRANIUM_PATH/vibranium-core-defaults"
source "${XDG_CONFIG_HOME:-$HOME/.config}/vibranium/settings"

HYPRLOCK_CONF="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprlock.conf"
CURRENT_WALLPAPER="$(vibranium-cmd-get-wallpaper)"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/hyprlock"
mkdir -p "$CACHE_DIR"

usage() {
    cat << EOF
Usage: $(basename "$0") [--help]

Update the Hyprlock configuration to use the current wallpaper,
applying blur or dim effects according to Vibranium settings.

Options:
  -h, --help   Show this help and exit
EOF
}

# CLI parsing
case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

# If wallpaper display is disabled
if [[ "$VIBRANIUM_GLOBAL_SHOW_WALLPAPER" == "false" ]]; then
    sed -i "s|^\([[:space:]]*path = \).*|\1 |" "$HYPRLOCK_CONF"
    exit 0
fi

# Determine effect type
if [[ "$VIBRANIUM_GLOBAL_BLUR_LOCKSCREEN_BACKGROUND" == false ]]; then
    TYPE="dimmed-${VIBRANIUM_GLOBAL_DIM_LOCKSCREEN_STRENGTH}"
else
    TYPE="blurred-${VIBRANIUM_GLOBAL_BLUR_LOCKSCREEN_STRENGTH}"
fi

# Cached image path
BASENAME="$(basename "${CURRENT_WALLPAPER%.*}")"
CACHED_IMG="$CACHE_DIR/${BASENAME}-${TYPE}.jpg"

# Update hyprlock.conf
sed -i "s|^\([[:space:]]*path = \).*|\1$CACHED_IMG|" "$HYPRLOCK_CONF"

# If cached image does not exist, refresh asynchronously
if [[ ! -f "$CACHED_IMG" ]]; then
    exec setsid vibranium-cmd-refresh-lockscreen "$CURRENT_WALLPAPER"
fi

exit 0
