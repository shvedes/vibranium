#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

LOOP_NAME="mic_loop"
ACTION="apply"
SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: $SELF [OPTIONS]

Enable default microphone loopback (aka hear my voice)

Note: you will not be able to toggle it from the shell.
Use Vibranium Menu > Settings > Audio instead.

Options:
    -h, --help         Show this help and exit
    --get-volume       Print current loopback volume and exit
    -v, --verbose      Enable verbose output
EOF
}

get_default_source() {
  local line
  while IFS= read -r line; do
    if [[ "$line" == "Default Source: "* ]]; then
      printf '%s\n' "${line#Default Source: }"
      return
    fi
  done < <(pactl info)
}

get_default_sink() {
  local line
  while IFS= read -r line; do
    if [[ "$line" == "Default Sink: "* ]]; then
      printf '%s\n' "${line#Default Sink: }"
      return
    fi
  done < <(pactl info)
}

find_module_ids() {
  pactl list short modules | awk -v name="$LOOP_NAME" '$0 ~ name {print $1}'
}

get_loopback_volume() {
  if [[ $VIBRANIUM_VOLUME_SOURCE_LOOPBACK == false ]]; then
    exit 1
  fi

  local module_id sink_input vol
  # Read only the first module id; process substitution avoids a pipe and head.
  read -r module_id < <(find_module_ids)

  if [[ -z "$module_id" ]]; then
    log Info "no loopback"
    exit 1
  fi

  sink_input=$(find_sink_input_id "$module_id")
  if [[ -z "$sink_input" ]]; then
    log Info "no sink input"
    exit 1
  fi

  vol=$(pactl list sink-inputs | awk -v id="$sink_input" '
        $1=="Sink" && $2=="Input" && $3=="#"id {found=1}
        found && /Volume:/ {gsub(/%/,"",$5); print $5; exit}
    ')
  echo "$vol"
  exit 0
}

find_sink_input_id() {
  local module_id="$1"
  pactl list sink-inputs | awk -v mid="$module_id" '
        /^Sink Input #[0-9]+$/ { id = substr($3, 2) }
        /^\s*Owner Module: / { if ($3 == mid) { print id; exit } }
    '
}

# Parse arguments before sourcing the lib so that -h/--help is free of side
# effects. The lib is sourced further below, only when an action needs it.
while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --get-volume)
    ACTION="get-volume"
    shift
    ;;
  *)
    printf '%s: unknown option: %s\n' "$SELF" "$1" >&2
    exit 2
    ;;
  esac
done

# Source only now that we know we need runtime config values.
source vb-lib-core

helpers::check \
  VIBRANIUM_VOLUME_SOURCE_LOOPBACK_VOLUME \
  VIBRANIUM_VOLUME_SOURCE_LOOPBACK

VOL="${VIBRANIUM_VOLUME_SOURCE_LOOPBACK_VOLUME}%"

log Info "Action: $ACTION"

case "$ACTION" in
get-volume)
  get_loopback_volume
  ;;
apply)
  # If the setting is not enabled, unload any existing loopback modules.
  if [[ "$VIBRANIUM_VOLUME_SOURCE_LOOPBACK" != "true" ]]; then
    MODULE_IDS=$(find_module_ids || true)
    if [[ -n "${MODULE_IDS}" ]]; then
      # Unload every matching module id.
      while IFS= read -r mid; do
        [[ -z "$mid" ]] && continue
        pactl unload-module "$mid" >/dev/null 2>&1 || true
      done <<<"$MODULE_IDS"
    fi
    exit 0
  fi

  # If enabled: update volume for existing modules if present.
  MODULE_IDS=$(find_module_ids || true)
  if [[ -n "${MODULE_IDS}" ]]; then
    while IFS= read -r mid; do
      [[ -z "$mid" ]] && continue
      SINK_INPUT_ID=$(find_sink_input_id "$mid")
      if [[ -n "$SINK_INPUT_ID" ]]; then
        pactl set-sink-input-volume "$SINK_INPUT_ID" "$VOL" >/dev/null 2>&1 || true
      fi
    done <<<"$MODULE_IDS"
    exit 0
  else
    # Create loopback.
    SOURCE=$(get_default_source)
    SINK=$(get_default_sink)
    if [[ -z "${SOURCE:-}" || -z "${SINK:-}" ]]; then
      exit 1
    fi

    NEW_MODULE_ID=$(pactl load-module module-loopback \
      source="$SOURCE" \
      sink="$SINK" \
      latency_msec=10 \
      adjust_latency=true \
      loopback_name="$LOOP_NAME" 2>/dev/null || true)

    # Wait for the sink-input to appear, then set initial volume.
    for i in {1..10}; do
      SINK_INPUT_ID=$(find_sink_input_id "$NEW_MODULE_ID")
      if [[ -n "$SINK_INPUT_ID" ]]; then
        pactl set-sink-input-volume "$SINK_INPUT_ID" "$VOL" >/dev/null 2>&1 || true
        break
      fi
      sleep 0.1
    done
    exit 0
  fi
  ;;
*)
  exit 2
  ;;
esac
