#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}
SELF="${0##*/}"

usage() {
  shcat << EOF
Usage: $SELF [OPTIONS] [folder]

Remove an installed community theme.

With no folder, opens the remover in the shell. With a folder, removes
it non-interactively (used by the shell picker rows).

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

while (($# > 0)); do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --)
      shift
      break
      ;;
    -*)
      log Error "unknown option: $1"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

source vb-lib-core

# With no folder, the shell picker handles selection. A supplied child name
# takes the direct removal path and is validated below.
if (($# == 0)) || [[ -z "${1:-}" ]]; then
  if command -v vb-shell > /dev/null 2>&1 && vb-shell themeRemover toggle > /dev/null 2>&1; then
    exit 0
  fi
  log Error "shell not running; pass a theme folder instead"
  log Error "Try '$SELF --help' for more information"
  exit 1
fi

if (($# > 1)); then
  log Error "expected at most one folder"
  log Error "Try '$SELF --help' for more information"
  exit 1
fi

THEMES_DIR="$XDG_CONFIG_HOME/vibranium/themes"
THEME_NAME_FILE="$VIBRANIUM_STATE/theme.name"
FALLBACK_THEME="Nightfox"

chosen_name="$1"

# The input is used as a single child name under THEMES_DIR. Reject path
# separators and dot components; existence and official-shadow checks decide
# whether it is removable.
if [[ "$chosen_name" == *"/"* || "$chosen_name" == "." || "$chosen_name" == ".." ]]; then
  log Error "invalid theme folder: $chosen_name"
  exit 1
fi

chosen_path="$THEMES_DIR/$chosen_name"

if [[ ! -d "$chosen_path" ]]; then
  notify-send -r 3 -a "Vibranium" -t 5000 "Vibranium" "Theme folder not found: $chosen_path"
  exit 1
fi

if [[ -d "$VIBRANIUM/themes/$chosen_name" ]]; then
  notify-send -r 3 -a "Vibranium" -t 5000 "Vibranium" "Not a community theme: $chosen_name"
  exit 1
fi

log Info "Removing $chosen_name"

# Capture the persisted active name for the fallback comparison with
# chosen_name; deletion does not change the saved value.
current_theme=""
if [[ -f "$THEME_NAME_FILE" ]]; then
  IFS= read -r current_theme < "$THEME_NAME_FILE" || [[ -n $current_theme ]]
fi

# Archive only untracked, non-ignored wallpaper paths; tracked edits remain
# managed. NUL-delimited output keeps each path as one filesystem entry, and
# a second removal purges the archive.
preserved=""
uf=()
if [[ -e "$chosen_path/.uninstalled" ]]; then
  rm -rf "$chosen_path"
elif [[ -d "$chosen_path/.git" ]]; then
  preserved="$(mktemp -d)"

  mapfile -d '' -t uf < <(git -C "$chosen_path" ls-files --others --exclude-standard -z -- backgrounds)

  for f in "${uf[@]}"; do
    mv "$chosen_path/$f" "$preserved"/
  done

  rm -rf "$chosen_path"

  if ((${#uf[@]} > 0)); then
    mkdir -p "$chosen_path/backgrounds"
    for f in "$preserved"/*; do
      mv "$f" "$chosen_path/backgrounds"/
    done
    touch "$chosen_path/.uninstalled"
  fi
  rm -rf "$preserved"
else
  rm -rf "$chosen_path"
fi

# This branch targets the flat wallpaper map, {"<theme>":"<path>"}.
# `del(.[$k])` removes that top-level key; it does not address a nested key
# in a shell `{"data":{...}}` document. jq writes through a temporary file;
# mv commits only a successful parse, and failure leaves existing state.
wallpaper_json="$VIBRANIUM_STATE/wallpaper.json"
if [[ -f "$wallpaper_json" ]] && command -v jq > /dev/null 2>&1; then
  tmp="$(mktemp)"
  if jq --arg k "$chosen_name" 'del(.[$k])' "$wallpaper_json" > "$tmp" 2> /dev/null; then
    mv "$tmp" "$wallpaper_json"
  else
    rm -f "$tmp"
  fi
fi

# Display name for the farewell notice (packaging affixes stripped).
# These substitutions affect presentation only; chosen_name remains the
# exact directory and JSON key used by the removal transaction.
clean_name="$chosen_name"
clean_name="${clean_name/vibranium-theme-/}"
clean_name="${clean_name/-vibranium-theme/}"
clean_name="${clean_name/theme-vibranium-/}"
clean_name="${clean_name/-theme-vibranium/}"
display=""
old_ifs="$IFS"
IFS=-
# shellcheck disable=SC2162
read -ra parts <<< "$clean_name"
for part in "${parts[@]}"; do
  display+="${part^} "
done
IFS="$old_ifs"
display="${display% }"

# Switch to the fallback when the removed theme is the active one.
if [[ "$current_theme" == "$chosen_name" ]]; then
  vb-theme-set "$FALLBACK_THEME"
fi

notify-send -r 3 -a "Vibranium" "Vibranium" "$display has been removed"
