#!/usr/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Remove an installed community theme.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Error: unknown option: $1" >&2
    echo "Try '${0##*/} --help' for more information." >&2
    exit 1
    ;;
  esac
done

source vb-lib-core

THEMES_DIR="$XDG_CONFIG_HOME/vibranium/themes"
THEME_NAME_FILE="$XDG_CONFIG_HOME/vibranium/current/theme.name"
FALLBACK_THEME="Nightfox"

# Collect removable user themes: dirs inside USER_THEMES_PATH that have no
# official counterpart. Overrides (same name as an official theme) are excluded
# because removing them would expose the unmodified official theme, not uninstall
# anything meaningful from the user's perspective.
mapfile -t community_themes < <(
  find "$THEMES_DIR" -mindepth 1 -maxdepth 1 -type d,l -printf '%f\n' |
    while read -r folder; do
      if [[ ! -d "$VIBRANIUM/themes/$folder" ]]; then
        echo "$folder"
      fi
    done
)

if ((${#community_themes[@]} == 0)); then
  notify-send -r 3 -t 2000 "Vibranium" "No Omarchy themes installed"
  exit 0
fi

_capitalize() {
  parts=() result=()

  local IFS=-            # Split words by '-'
  read -ra parts <<<"$1" # Read input string into array 'parts' using IFS='-'

  local part
  for part in "${parts[@]}"; do
    # Capitalize first character of each part
    result+=("${part^}")
  done

  local IFS=' '
  printf '%s' "${result[*]}"
}

# Build capitalized display names; map display -> folder for reverse lookup
menu_items=()
declare -A display_to_folder=()
declare -A display_to_clean=()

for folder in "${community_themes[@]}"; do
  clean_name="$folder"

  clean_name="${clean_name/vibranium-theme-/}"
  clean_name="${clean_name/-vibranium-theme/}"
  clean_name="${clean_name/theme-vibranium-/}"
  clean_name="${clean_name/-theme-vibranium/}"

  clean_name="${clean_name/omarchy-theme-/}"
  clean_name="${clean_name/-omarchy-theme/}"
  clean_name="${clean_name/theme-omarchy-/}"
  clean_name="${clean_name/-theme-omarchy/}"

  display="$(_capitalize "$clean_name")"
  menu_items+=("$display")

  display_to_folder["$display"]="$folder"
  display_to_clean["$display"]="$clean_name"
done

chosen_display=""
helpers::ui::menu chosen_display "Uninstall theme" "" -selected-row 0 -- "${menu_items[@]}"

if [[ -z "$chosen_display" ]]; then
  exit 0
fi

chosen_name="${display_to_folder[$chosen_display]}"
chosen_clean="${display_to_clean[$chosen_display]}"
chosen_path="$THEMES_DIR/$chosen_name"

if [[ ! -d "$chosen_path" ]]; then
  notify-send -r 3 -t 5000 "Vibranium" "Theme folder not found: $chosen_path"
  exit 1
fi

# Read the active theme name before deletion; if current/ is a symlink to the
# active theme directory, rm -rf below would dangle it and make the file
# unreadable, leaving current_theme empty and skipping the fallback switch.
current_theme=""
if [[ -f "$THEME_NAME_FILE" ]]; then
  current_theme="$(<"$THEME_NAME_FILE")"
fi

rm -rf "$chosen_path"

# Update the state file;
# don't store data of now deleted themes.
state_file="$VIBRANIUM_STATE/wallpaper.state"

if [[ -f "$state_file" ]]; then
  lines=() # Array to store all lines from the file

  # Read the file line by line into the array
  # The '|| [[ -n "$line" ]]' ensures the last line is processed
  # even if it doesn't end with a newline
  while IFS= read -r line || [[ -n "$line" ]]; do
    lines+=("$line")
  done <"$state_file"

  {
    # Iterate over the collected lines
    for line in "${lines[@]}"; do
      # Skip the line that matches the selected key (chosen_name=...)
      [[ "$line" == "${chosen_name}="* ]] && continue

      # Print all other lines as-is
      printf '%s\n' "$line"
    done
  } >"$state_file" # Overwrite the original file with filtered content
fi

# If the removed theme was the active one, fall back to the default
if [[ "$current_theme" == "$chosen_clean" ]]; then
  vb-theme-set "$FALLBACK_THEME"
fi

notify-send -r 3 "Vibranium" "$chosen_display has been removed"
