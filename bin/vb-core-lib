#####################################
### VIBRANIUM SETTINGS VALIDATION ###
#####################################

# Provides a unified configuration validation system for Vibranium options.
# It parses a defaults file to extract metadata (types, defaults, allowed values, ranges)
# for each configuration variable and caches this information in associative arrays.
# This caching allows for efficient validation of multiple variables without re-reading
# the file each time, significantly improving performance for scripts that check many options.
#
# Purpose:
# - Centralize validation logic to avoid hard-coded defaults in multiple functions.
# - Enable easy updates to defaults by editing the file without changing code.
# - Support bool, int (with optional range), and string (with optional enums) types.
#
# How it works:
# - At script initialization, `helpers::parse_defaults` reads and parses the entire defaults file once.
# - Metadata is stored in global associative arrays for quick access.
# - `helpers::check_option` uses this cache to validate and normalize a given variable.
# - If invalid or unset, it falls back to the default value and logs a warning.

# Declare global associative arrays to cache parsed metadata
declare -A OPTION_DEFAULTS OPTION_TYPES OPTION_ALLOWEDS OPTION_MINS OPTION_MAXS

# This function parses the defaults file once at startup to cache all option metadata.
# It scans the file line-by-line, extracting type, default, allowed values, and ranges
# for each variable. This single-pass parsing optimizes for multiple subsequent validations.
#
# Usage: no arguments needed.
helpers::parse_defaults() {

    local -a lines
    # Read the entire defaults file into an array for processing
    mapfile -t lines < "$VIBRANIUM_PATH/vb-core-defaults"

    # Initialize temporary variables for accumulating metadata per option block
    local current_var=""
    local options_line=""
    local default_value=""
    local type=""
    local -a allowed
    local min_range="" max_range=""

    # Loop through each line in the file
    for line in "${lines[@]}"; do
        # Check if the line is a variable assignment (e.g., VIBRANIUM_VAR="value")
        if [[ "$line" =~ ^VIBRANIUM_[A-Z_]+=\"?.*\"?$ ]]; then
            # Extract the variable name from the assignment
            current_var="${line%%=*}"
            current_var="${current_var%%\"}"

            # If we have accumulated metadata for the previous variable, store it in cache
            if [[ -n "$current_var" && -n "$default_value" ]]; then
                OPTION_DEFAULTS["$current_var"]="$default_value"
                OPTION_TYPES["$current_var"]="$type"

                # Store allowed values as space-separated string if present
                if [[ -n "${allowed[*]}" ]]; then
                    OPTION_ALLOWEDS["$current_var"]="${allowed[*]}"
                fi

                # Store range if present
                if [[ -n "$min_range" ]]; then
                    OPTION_MINS["$current_var"]="$min_range"
                    OPTION_MAXS["$current_var"]="$max_range"
                fi
            fi

            # Reset accumulators for the new variable block
            options_line=""
            default_value=""
            type=""
            allowed=()
            min_range=""
            max_range=""

        # Extract default value from comment line
        elif [[ "$line" == "# Default is "* ]]; then
            default_value="${line#*# Default is }"
            default_value="${default_value## }"
            default_value="${default_value%% }"

        # Extract and parse options line for type and constraints
        elif [[ "$line" == "# Available options:"* ]]; then
            options_line="${line#*# Available options: }"
            options_line="${options_line## }"
            options_line="${options_line%% }"

            # Split options line into words
            local -a options_words
            IFS=' ' read -r -a options_words <<< "$options_line"

            # Normalize type to lowercase and handle synonyms
            type="${options_words[0],,}"
            [[ "$type" == "integer" ]] && type="int"

            # Parse allowed values for string type
            if [[ "$type" == "string" ]]; then
                for ((k=1; k<${#options_words[@]}; k++)); do
                    local opt="${options_words[k]}"
                    opt="${opt//\'/}"
                    opt="${opt//\"/}"
                    allowed+=("$opt")
                done

            # Parse range for int type
            elif [[ "$type" == "int" ]]; then
                for ((k=1; k<${#options_words[@]}; k++)); do
                    if [[ "${options_words[k]}" == "between" && -n "${options_words[k+1]}" ]]; then
                        if [[ "${options_words[k+2]}" == "and" && -n "${options_words[k+3]}" ]]; then
                            min_range="${options_words[k+1]}"
                            max_range="${options_words[k+3]}"
                            break
                        fi
                    fi
                done
            fi
        fi
    done

    # Store metadata for the last variable if the file ends with one
    if [[ -n "$current_var" && -n "$default_value" ]]; then
        OPTION_DEFAULTS["$current_var"]="$default_value"
        OPTION_TYPES["$current_var"]="$type"

        # Store allowed values as space-separated string if present
        if [[ -n "${allowed[*]}" ]]; then
            OPTION_ALLOWEDS["$current_var"]="${allowed[*]}"
        fi

        # Store range if present
        if [[ -n "$min_range" ]]; then
            OPTION_MINS["$current_var"]="$min_range"
            OPTION_MAXS["$current_var"]="$max_range"
        fi
    fi
}

# This function validates a single variable using cached metadata.
# It checks if the variable is set and valid based on its type and constraints.
# If unset or invalid, it sets the default and logs a warning.
# Normalization is applied where applicable (e.g., lowercase bool, clean int).
#
# Usage: helpers::check_option <var_name>
# Returns: 0 on success (validated or fallback), 1 if not found in cache.
helpers::check() {
    # Get the current value of the variable
    local var_name="$1"
    local val="${!var_name}"

    # Check if metadata exists in cache
    if [[ -z "${OPTION_DEFAULTS[$var_name]}" ]]; then
        log::warn "Variable $var_name not found in defaults."
        return 1
    fi

    # Retrieve cached metadata
    local default_value="${OPTION_DEFAULTS[$var_name]}"
    local type="${OPTION_TYPES[$var_name]}"
    local allowed_str="${OPTION_ALLOWEDS[$var_name]}"
    local -a allowed=($allowed_str)
    local min_range="${OPTION_MINS[$var_name]}"
    local max_range="${OPTION_MAXS[$var_name]}"

    # Handle unset variable by falling back to default
    if [[ -z "$val" ]]; then
        log::warn "$var_name is unset. Falling back to defaults."
        printf -v "$var_name" '%s' "$default_value"
        return 0
    fi

    # Prepare normalized value and validity flag
    local normalized_val="$val"
    local is_valid=true

    # Validate and normalize based on type
    case "$type" in
        bool)
            # Normalize to lowercase
            normalized_val="${val,,}"

            # Check for valid boolean values
            if [[ "$normalized_val" != "true" && "$normalized_val" != "false" ]]; then
                is_valid=false
            fi
            ;;

        int)
            # Normalize comma to dot for decimal
            normalized_val="${val//,/.}"

            # Define regex for numeric validation
            local num_re='^-?[0-9]+(\.[0-9]+)?$'

            # Check if matches numeric pattern
            if ! [[ "$normalized_val" =~ $num_re ]]; then
                is_valid=false
            else
                # Extract sign
                local sign=""
                [[ "$normalized_val" == -* ]] && sign="-" normalized_val="${normalized_val#-}"

                # Split integer and fractional parts
                local int_part="${normalized_val%%.*}"
                local frac_part="${normalized_val#*.}"
                if [[ "$frac_part" == "$normalized_val" ]]; then frac_part=""; else frac_part=".${frac_part}"; fi

                # Remove leading zeros from integer part
                int_part="${int_part##+(0)}"
                [[ -z "$int_part" ]] && int_part="0"

                # Reassemble normalized value
                normalized_val="${sign}${int_part}${frac_part}"

                # Check range if defined
                if [[ -n "$min_range" && -n "$max_range" ]]; then
                    if (( ${normalized_val%%.*} < min_range || ${normalized_val%%.*} > max_range )); then
                        is_valid=false
                    fi
                fi
            fi
            ;;

        string)
            # If enums are defined, check against them
            if [[ ${#allowed[@]} -gt 0 ]]; then
                local ok=false
                for a in "${allowed[@]}"; do
                    if [[ "$val" == "$a" ]]; then
                        ok=true
                        break
                    fi
                done

                if [[ "$ok" != true ]]; then
                    is_valid=false
                fi
            fi
            # No enums: any non-empty string is valid (unset already handled)
            ;;

        *)
            # Unsupported type: skip validation
            ;;
    esac

    # Apply fallback if invalid, else set normalized value
    if [[ "$is_valid" != true ]]; then
        log::warn "Invalid value for $var_name. Falling back to defaults."
        printf -v "$var_name" '%s' "$default_value"
    else
        printf -v "$var_name" '%s' "$normalized_val"
    fi
}

term::ask_yes_no() {
    local default="${1:-Y}"
    local message="$2"
    local input prompt hint

    default="${default^^}"

    # Set hint based on default
    case "$default" in
        Y) hint="(Y/n)" ;;
        N) hint="(y/N)" ;;
        *) hint="(Y/n)"; default="Y" ;;
    esac

    while true; do
        # Show cursor
        printf '\e[?25h'

        prompt=$'\e[0;33m[VIBRANIUM]\e[0m '"${message} ${hint}: "

        printf "%s" "$prompt"
        read -r input

        # Use default if empty
        [[ -z "$input" ]] && input="$default"

        case "$input" in
            [Yy][Ee][Ss]|[Yy])
                # Hide cursor before returning
                printf '\e[?25l'
                return 0
                ;;
            [Nn][Oo]|[Nn])
                # Hide cursor before returning
                printf '\e[?25l'
                return 1
                ;;
            *)
                # Clear line and retry
                printf "\r\e[K"
                ;;
        esac
    done
}


# A term::spinner utility function.
# Displays an animated term::spinner in the terminal while a given process (PID) is running.
#
# Usage: long_running_command & term::spinner $! "Doing stuff..." "Done"
#
# Parameters:
# $1 - PID of the process to wait for.
# $2 - Message to display alongside the term::spinner.
# $3 - (Optional) Final message to display when the process completes.
#
# The term::spinner uses Unicode braille characters for a smooth animation.
# It clears itself once the process finishes, and optionally prints a success message.
term::spinner() {
    # The PID of the process to watch
    local pid=$1

    # The message to show while spinning
    local msg="$2"

    # Delay between term::spinner frames (seconds)
    local delay=0.1
    local spinstr

    spinstr=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

    # ANSI sequence to clear the current line
    local clear_line="\r\033[K"

    # While the process exists, animate the term::spinner
    while kill -0 "$pid" 2> /dev/null; do
        for i in "${spinstr[@]}"; do
            printf "\r${msg} %s" "${i} "
            sleep $delay
        done
    done

    # Clear the term::spinner once finished
    printf "%b" "$clear_line"

    # Print the final message if provided
    if [ -n "$3" ]; then
        printf "%s %s\n" "$msg" "$3"
    else
        printf "%s\n" "$msg"
    fi
}


term::is_headless() {
    [[ -t 1 ]] || return 0 && return 1
}

log::error() {
    [[ -t 2 ]] && printf "[ERROR] %s\n" "$*" >&2
}

log::warn() {
    [[ -t 1 ]] && printf "[WARN] %s\n" "$*"
}

log::info() {
    [[ -t 1 ]] && printf "[INFO] %s\n" "$*"
}

# Self-explanatory
# https://wiki.hypr.land/Configuring/Dispatchers/#fullscreenstate
hypr::is_fullscreen() {
    [[ "$(hyprctl -j activewindow | jq '.fullscreen')" = 2 ]]
}

hypr::flash::border() {
    [[ "$(hyprctl -j getoption animations:enabled | jq -r '.int')" == 0 ]] && return 0

    hyprctl -q "keyword general:col.active_border rgb(cdcecf)"
    sleep 0.2
    hyprctl -q reload config-only
}

hypr::flash::screen() {
    local anim_status="$(hyprctl -j getoption animations:enabled | jq -r '.int')"
    [[ $anim_status == 0 ]] && return 0

    hyprctl -q hyprsunset gamma 150
    hyprctl -q hyprsunset gamma 100
}

#############################
##### Configure helpers #####
#############################

# Ensures that a given option exists in the user settings file.
# If it's missing, appends the default value from the defaults file.
helpers::configure::verify_option() {
    local var="$1"
    [[ -z $var ]] && return 2

    local settings_file="$VIBRANIUM_USER_SETTINGS"
    local defaults_file="$VIBRANIUM_PATH/vb-core-defaults"

    local def_line
    def_line="$(awk -F= -v v="$var" '$1==v{print; exit}' "$defaults_file")" || return 1
    [[ -z $def_line ]] && return 1

    awk -v var="$var" -v newline="$def_line" '
        BEGIN { inserted=0 }

        # Preserve header/comments exactly as-is until first VIBRANIUM_ var
        !vars_started && !/^VIBRANIUM_/ { header[++h]=$0; next }

        {
            vars_started=1

            # Collect only VIBRANIUM_* assignments
            if ($0 ~ /^VIBRANIUM_[A-Za-z_]+=/) {
                split($0,a,"=")
                key=a[1]
                vars[key]=$0
                next
            }
        }

        END {
            # Overwrite or add the required variable
            split(newline,a,"=")
            vars[a[1]]=newline

            # Print header first
            for (i=1;i<=h;i++) print header[i]

            # Sort keys (I am a bit a perfectionist)
            n=asorti(vars, idx)
            for (i=1;i<=n;i++) print vars[idx[i]]
        }
    ' "$settings_file" > "$settings_file.tmp" && mv "$settings_file.tmp" "$settings_file"
}

# Flips a boolean value of a passed variable.
# Flag '-v' returns the new value
helpers::configure::toggle_bool() {
    local verbose
    local setting_name
    local current_value

    if [ "$1" = "-v" ]; then
        verbose=true
        setting_name="$2"
    else
        verbose=false
        setting_name="$1"
    fi

    helpers::configure::verify_option "$setting_name"
    eval "current_value=\$$setting_name"

    case "$current_value" in
        "true")
            sed -i "/^${setting_name}=/s/=.*/=false/" "$VIBRANIUM_USER_SETTINGS"
            [ "$verbose" = "true" ] && echo "false"
            ;;
        "false")
            sed -i "/^${setting_name}=/s/=.*/=true/" "$VIBRANIUM_USER_SETTINGS"
            [ "$verbose" = "true" ] && echo "true"
            ;;
    esac
}

# Aligns menu option labels to the same width for pretty column output.
# Expects items in "label : value" format, ignores HTML tags when measuring
# label length, pads shorter labels with spaces, and normalizes boolean
# values (true/false -> yes/no). Non-matching lines are passed through unchanged.
helpers::configure::build_menu() {
    local options=("$@")
    local max_len=0
    local has_colon_options=()

    for option in "${options[@]}"; do
        if [[ "$option" =~ ^(.*)\ :\ (.*)$ ]]; then
            local label="${BASH_REMATCH[1]}"

            local clean_label
            clean_label=$(echo "$label" | sed 's/<[^>]*>//g')

            local len=${#clean_label}
            if (( len > max_len )); then
                max_len=$len
            fi
            has_colon_options+=("$option")
        fi
    done

    local aligned_options=()
    for option in "${options[@]}"; do
        if [[ "$option" =~ ^(.*)\ :\ (.*)$ ]]; then
            local label="${BASH_REMATCH[1]}"
            local value="${BASH_REMATCH[2]}"

            local clean_label
            clean_label=$(echo "$label" | sed 's/<[^>]*>//g')

            local len=${#clean_label}
            local padding=$((max_len - len))
            local padded_label="$label"

            for ((j=0; j<padding; j++)); do
                padded_label+=" "
            done

            if [[ "${value,,}" == "true" ]]; then
                value="yes"
            elif [[ "${value,,}" == "false" ]]; then
                value="no"
            fi
            aligned_options+=("$padded_label : $value")
        else
            aligned_options+=("$option")
        fi
    done

    for aligned in "${aligned_options[@]}"; do
        echo "$aligned"
    done
}

# Prompts the user for a numeric value via menu, validates type and range,
# optionally runs in verification-only mode, and can persist the result
# to the user settings file under the given option name. Supports integers
# and floats, trims whitespace, normalizes float formatting, and retries
# on invalid input with an error notification.
helpers::configure::set_digit() {
    local check_only=false

    # parse flags
    while [[ "$1" == -* ]]; do
        case "$1" in
            --verify) check_only=true ;;
            *) return 1 ;;
        esac
        shift
    done

    local prompt_base="$1"
    local rofi_title="$2"
    local type="$3"    # "int" or "float"
    local min_val="$4"
    local max_val="$5"
    local opt_name="${6:-}"
    local settings_file="$VIBRANIUM_USER_SETTINGS"

    local range_text="${min_val}-${max_val}"
    local prompt="${prompt_base} (${type})"

    while true; do
        local input
        input="$(printf "%s\n" "$prompt" | helpers::ui::menu "$rofi_title" "$range_text")"

        [[ -z "$input" ]] && return 1
        [[ "$input" = "$prompt" ]] && continue

        input="${input#"${input%%[![:space:]]*}"}"
        input="${input%"${input##*[![:space:]]}"}"

        local valid=true

        if [[ "$type" == "int" ]]; then
            if ! [[ "$input" =~ ^[0-9]+$ ]]; then
                valid=false
            else
                local inrange
                inrange=$(awk -v v="$input" -v lo="$min_val" -v hi="$max_val" \
                          'BEGIN { v+=0; lo+=0; hi+=0; print (v >= lo && v <= hi) }')
                [[ "$inrange" != 1 ]] && valid=false
            fi

        elif [[ "$type" == "float" ]]; then
            if ! [[ "$input" =~ ^[0-9]*\.?[0-9]+$ ]]; then
                valid=false
            else
                local inrange
                inrange=$(awk -v v="$input" -v lo="$min_val" -v hi="$max_val" \
                          'BEGIN { v+=0; lo+=0; hi+=0; print (v >= lo && v <= hi) }')
                [[ "$inrange" != 1 ]] && valid=false

                if [[ "$valid" == true ]]; then
                    input=$(awk -v v="$input" '
                        BEGIN {
                            v+=0
                            if (v == int(v)) printf "%d.0", int(v)
                            else printf "%g", v
                        }')
                fi
            fi
        else
            return 1
        fi

        if [[ "$valid" == false ]]; then
            notify-send -r 6 -u critical -t 1500 "Vibranium" \
                "A ${type} between ${min_val} and ${max_val}!"
            continue
        fi

        # check-only mode: just return the validated value
        if [[ "$check_only" == true ]]; then
            printf "%s" "$input"
            return 0
        fi

        if [[ -n "$opt_name" ]]; then
            helpers::configure::verify_option "$opt_name" || return 1

            if grep -qE "^${opt_name}=" "$settings_file" 2>/dev/null; then
                sed -i "/^${opt_name}/s/=.*/=${input}/" "$settings_file"
            else
                printf "%s=%s\n" "$opt_name" "$input" >> "$settings_file"
            fi
        fi

        printf "%s" "$input"
        return 0
    done
}

# Presents a menu of string options to the user, validates the selection,
# and saves the chosen value to the user settings file under the given
# variable name.
helpers::configure::set_string() {
    local var_name="$1"
    local title="$2"
    shift 2
    local raw_options=("$@")

    local labels=()
    local values=()

    # Split Pretty:Value
    for opt in "${raw_options[@]}"; do
        if [[ "$opt" == *:* ]]; then
            labels+=("${opt%%:*}")
            values+=("${opt#*:}")
        else
            labels+=("$opt")
            values+=("$opt")
        fi
    done

    while true; do
        chosen_label="$(printf "%s\n" "${labels[@]}" | helpers::ui::menu "$title" "ESC to go back")"
        [[ -z "$chosen_label" ]] && break

        # Find index of selected label
        for i in "${!labels[@]}"; do
            if [[ "${labels[$i]}" == "$chosen_label" ]]; then
                chosen_value="${values[$i]}"
                helpers::configure::verify_option "$var_name"
                sed -i "/^${var_name}=/s|=.*|=\"${chosen_value// /_}\"|" "$VIBRANIUM_USER_SETTINGS"
                return
            fi
        done
    done
}
