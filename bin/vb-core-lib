#####################################
### VIBRANIUM SETTINGS VALIDATION ###
#####################################

# Provides a unified configuration validation system for Vibranium options.
# It parses a defaults file to extract metadata (types, defaults, allowed values, ranges)
# for each configuration variable and caches this information in associative arrays.
# This caching allows for efficient validation of multiple variables without re-reading
# the file each time, significantly improving performance for scripts that check many options.
#
# Purpose:
# - Centralize validation logic to avoid hard-coded defaults in multiple functions.
# - Enable easy updates to defaults by editing the file without changing code.
# - Support bool, int (with optional range), and string (with optional enums) types.
#
# How it works:
# - Metadata is stored in global associative arrays for quick access.
# - `helpers::check` uses this cache to validate and normalize a given variable.
# - If invalid or unset, it falls back to the default value and logs a warning.

# Declare global associative arrays to cache parsed metadata
declare -A OPTION_DEFAULTS OPTION_TYPES OPTION_ALLOWEDS OPTION_MINS OPTION_MAXS

# This function parses the defaults file once at startup to cache all option metadata.
# It scans the file line-by-line, extracting type, default, allowed values, and ranges
# for each variable. This single-pass parsing optimizes for multiple subsequent validations.
#
# Usage: no arguments needed.
helpers::parse_defaults() {
    local line
    # cur_var tracks the most recently seen variable name — used as the associative array key
    local cur_var="" cur_type="" cur_default="" cur_min="" cur_max=""
    # cur_allowed is an array because a string enum can have multiple valid values
    local -a cur_allowed=()
    # words is a scratch array for splitting constraint lines into tokens
    local -a words=()

    # IFS= + read -r: preserves leading whitespace and backslashes exactly as-is in the file
    # The `|| [[ -n $line ]]` guard catches the last line if the file has no trailing newline
    while IFS= read -r line || [[ -n $line ]]; do

        # Variable assignment — metadata accumulated above belongs to this variable.
        # The comment block PRECEDES the assignment in the defaults file, so by the time
        # we hit `VAR=`, we've already collected its type/default/constraints in cur_* vars.
        if [[ $line =~ ^(VIBRANIUM_[A-Z_]+)= ]]; then
            cur_var=${BASH_REMATCH[1]}   # BASH_REMATCH[1] is the first capture group

            # Only store if we actually found a default — guards against malformed entries
            if [[ -n $cur_default ]]; then
                OPTION_DEFAULTS[$cur_var]=$cur_default
                OPTION_TYPES[$cur_var]=$cur_type

                # ${#cur_allowed[@]} -gt 0: only write the allowed list if it's non-empty.
                # We join the array into a space-delimited string for storage because bash
                # associative arrays can't hold arrays as values — it gets split back out later.
                [[ ${#cur_allowed[@]} -gt 0 ]] && OPTION_ALLOWEDS[$cur_var]="${cur_allowed[*]}"

                # Only store min/max if a range was actually defined for this variable
                if [[ -n $cur_min ]]; then
                    OPTION_MINS[$cur_var]=$cur_min
                    OPTION_MAXS[$cur_var]=$cur_max
                fi
            fi

            # Reset accumulator state for the next variable's comment block.
            # cur_var is intentionally NOT reset here — it's needed by the end-of-file
            # safety net below in case the file ends without a blank line after the last assignment.
            cur_type="" cur_default="" cur_min="" cur_max=""
            cur_allowed=()

        # Type and constraints line — expected format in the defaults file:
        #   # Available options: string 'val1' 'val2'
        #   # Available options: integer between 1 and 100
        #   # Available options: bool
        elif [[ $line == '# Available options: '* ]]; then
            # Strip the prefix, then split on whitespace into an indexed array
            read -ra words <<< "${line#'# Available options: '}"

            # Normalize to lowercase so "Integer"/"INTEGER" all become "int"
            cur_type=${words[0],,}

            # The defaults file uses "integer" but internally we shorten it to "int"
            # to keep the case statements tidy
            [[ $cur_type == integer ]] && cur_type=int

            # Always reset these — a previous variable's constraints must not bleed through
            cur_allowed=()
            cur_min="" cur_max=""

            case $cur_type in
                string)
                    local w
                    # words[0] is the type itself; everything from index 1 onward are enum values.
                    # The slice "${words[@]:1}" gives us all elements starting at index 1.
                    for w in "${words[@]:1}"; do
                        # Strip surrounding single or double quotes from each enum value
                        # (the defaults file wraps string enums in quotes for readability)
                        cur_allowed+=("${w//[\'\"]}")
                    done
                    ;;
                int)
                    # Expect: "int between N and M"
                    # words[1]="between", words[2]=N, words[3]="and", words[4]=M
                    # The -} default on words[1] and words[3] avoids unbound variable errors
                    # if the line is malformed and shorter than expected
                    if [[ ${words[1]-} == between && ${words[3]-} == and ]]; then
                        cur_min=${words[2]}
                        cur_max=${words[4]}
                    fi
                    ;;
                # bool has no extra constraints — presence of the type is sufficient
            esac

        # Default value line — expected format:
        #   # Default is 'some_value'   (strings are quoted)
        #   # Default is 42             (ints/bools are bare)
        elif [[ $line == '# Default is '* ]]; then
            cur_default=${line#'# Default is '}
            # Remove any surrounding quotes used for readability in the file.
            # Two separate substitutions because bash parameter expansion can't
            # match alternation (i.e. no single `//['"]` that removes both in one pass cleanly).
            cur_default=${cur_default//\'/}
            cur_default=${cur_default//\"}
        fi

    done < "$VIBRANIUM_PATH/vb-core-defaults"

    # Safety net: if the file ends without a trailing newline after the last assignment,
    # the while loop exits before we get a chance to flush cur_* into the arrays.
    # cur_var was preserved from the reset block above precisely for this case.
    if [[ -n $cur_var && -n $cur_default ]]; then
        OPTION_DEFAULTS[$cur_var]=$cur_default
        OPTION_TYPES[$cur_var]=$cur_type

        [[ ${#cur_allowed[@]} -gt 0 ]] && OPTION_ALLOWEDS[$cur_var]="${cur_allowed[*]}"

        if [[ -n $cur_min ]]; then
            OPTION_MINS[$cur_var]=$cur_min
            OPTION_MAXS[$cur_var]=$cur_max
        fi
    fi
}

# This function validates a single variable using cached metadata.
# It checks if the variable is set and valid based on its type and constraints.
# If unset or invalid, it sets the default and logs a warning.
# Normalization is applied where applicable (e.g., lowercase bool, clean int).
#
# Usage: helpers::check_option <var_name>
# Returns: 0 on success (validated or fallback), 1 if not found in cache.
helpers::check() {
    # Lazy-load: only parse the defaults file on the very first call.
    # ${#OPTION_DEFAULTS[@]} gives the number of keys — 0 means the cache is cold.
    if [[ ${#OPTION_DEFAULTS[@]} -eq 0 ]]; then
        helpers::parse_defaults
    fi

    local var_name=$1
    # Indirect expansion: ${!var_name} reads the value of the variable whose *name*
    # is stored in var_name — effectively a runtime dereference / pointer follow
    local val=${!var_name}

    # ${OPTION_DEFAULTS[$var_name]+x}: the +x trick tests key *existence* in the associative
    # array without caring about the value. Without +x, an empty string would look like unset.
    if [[ -z ${OPTION_DEFAULTS[$var_name]+x} ]]; then
        log::warn "Variable $var_name not found in defaults"
        return 1
    fi

    local default_value=${OPTION_DEFAULTS[$var_name]}
    local type=${OPTION_TYPES[$var_name]}

    # If the variable is completely empty/unset, skip validation and just apply the default
    if [[ -z $val ]]; then
        log::warn "$var_name is unset. Using defalut ($default_value)"
        # printf -v writes into a variable by name — the only portable way to do indirect
        # assignment in bash without eval. Equivalent to: declare $var_name="$default_value"
        printf -v "$var_name" '%s' "$default_value"
        return 0
    fi

    # normalized will hold the cleaned-up version of val to write back if valid.
    # We don't mutate val itself so we can still reference the original in error messages.
    local normalized=$val
    local is_valid=true

    case $type in
        bool)
            # Lowercase via ,, operator so "True"/"TRUE"/"true" all pass
            normalized=${val,,}
            # Booleans must be exactly "true" or "false" — nothing else
            [[ $normalized != true && $normalized != false ]] && is_valid=false
            ;;

        int)
            # Normalize comma-as-decimal-separator (e.g. European locale "3,14" → "3.14")
            normalized=${val//,/.}

            # The regex does several things at once:
            #   ^(-?)       — optional leading minus, captured so we can reconstruct the sign
            #   0*          — consume (discard) any leading zeros to avoid octal misparse later
            #   ([0-9]+)    — the actual integer digits
            #   (\.[0-9]+)? — optional fractional part (we keep it but ignore it for range checks)
            if [[ ! $normalized =~ ^(-?)0*([0-9]+)(\.[0-9]+)?$ ]]; then
                is_valid=false
            else
                local sign=${BASH_REMATCH[1]}
                local int_part=${BASH_REMATCH[2]}   # leading zeros already stripped by 0* group
                local frac_part=${BASH_REMATCH[3]}  # empty or ".digits"

                # Rebuild a clean normalized form: sign + stripped-zero int + optional fraction
                normalized="${sign}${int_part}${frac_part}"

                # Only do range check if a min was defined for this variable
                local min=${OPTION_MINS[$var_name]-}  # -} gives empty string if key absent

                if [[ -n $min ]]; then
                    local max=${OPTION_MAXS[$var_name]}

                    # 10# prefix forces base-10 interpretation so "08" and "09" don't
                    # trigger bash's "invalid octal" arithmetic error.
                    # The sign is prepended *outside* the 10# to handle negatives correctly.
                    local signed_int=$(( ${sign}10#$int_part ))
                    (( signed_int < 10#$min || signed_int > 10#$max )) && is_valid=false
                fi
            fi
            ;;

        string)
            # Pull the space-joined allowed list back out of the associative array.
            # The -} provides an empty string default so the variable is never unbound.
            local allowed_str=${OPTION_ALLOWEDS[$var_name]-}
            if [[ -n $allowed_str ]]; then
                # Word-split the stored string back into an array — reverses the join done in parse_defaults
                local -a allowed=($allowed_str)
                local a found=false

                # Linear scan: compare val against every allowed value.
                # Quoted "$a" prevents glob expansion on the right-hand side of ==.
                for a in "${allowed[@]}"; do
                    [[ $val == "$a" ]] && found=true && break
                done

                [[ $found == false ]] && is_valid=false
            fi
            # If no allowed list exists, any non-empty string is considered valid
            ;;
    esac

    if [[ $is_valid == false ]]; then
        log::warn "Invalid value for $var_name. Using defalut ($default_value)"
        printf -v "$var_name" '%s' "$default_value"
    else
        # Write the normalized form back — this is the important part for int/bool:
        # the caller's variable ends up with leading zeros stripped, correct case, etc.
        printf -v "$var_name" '%s' "$normalized"
    fi
}

term::ask_yes_no() {
    local default="${1:-Y}"
    local message="$2"
    local input prompt hint

    default="${default^^}"

    # Set hint based on default
    case "$default" in
        Y) hint="(Y/n)" ;;
        N) hint="(y/N)" ;;
        *) hint="(Y/n)"; default="Y" ;;
    esac

    while true; do
        # Show cursor
        printf '\e[?25h'

        prompt=$'\e[0;33m[VIBRANIUM]\e[0m '"${message} ${hint}: "

        printf "%s" "$prompt"
        read -r input

        # Use default if empty
        [[ -z "$input" ]] && input="$default"

        case "$input" in
            [Yy][Ee][Ss]|[Yy])
                # Hide cursor before returning
                printf '\e[?25l'
                return 0
                ;;
            [Nn][Oo]|[Nn])
                # Hide cursor before returning
                printf '\e[?25l'
                return 1
                ;;
            *)
                # Clear line and retry
                printf "\r\e[K"
                ;;
        esac
    done
}


# A term::spinner utility function.
# Displays an animated term::spinner in the terminal while a given process (PID) is running.
#
# Usage: long_running_command & term::spinner $! "Doing stuff..." "Done"
#
# Parameters:
# $1 - PID of the process to wait for.
# $2 - Message to display alongside the term::spinner.
# $3 - (Optional) Final message to display when the process completes.
#
# The term::spinner uses Unicode braille characters for a smooth animation.
# It clears itself once the process finishes, and optionally prints a success message.
term::spinner() {
    # The PID of the process to watch
    local pid=$1

    # The message to show while spinning
    local msg="$2"

    # Delay between term::spinner frames (seconds)
    local delay=0.1
    local spinstr

    spinstr=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

    # ANSI sequence to clear the current line
    local clear_line="\r\033[K"

    # While the process exists, animate the term::spinner
    while kill -0 "$pid" 2> /dev/null; do
        for i in "${spinstr[@]}"; do
            printf "\r${msg} %s" "${i} "
            sleep $delay
        done
    done

    # Clear the spinner once finished
    printf "%b" "$clear_line"

    # Print the final message if provided
    if [ -n "$3" ]; then
        printf "%s %s\n" "$msg" "$3"
    else
        printf "%s\n" "$msg"
    fi
}


term::is_headless() {
    [[ -t 1 ]] || return 0 && return 1
}

log::error() {
    [[ -t 2 ]] && printf "[ERROR] %s\n" "$*" >&2
}

log::warn() {
    [[ -t 1 ]] && printf "[WARN] %s\n" "$*"
}

log::info() {
    [[ -t 1 ]] && printf "[INFO] %s\n" "$*"
}

# Self-explanatory
# https://wiki.hypr.land/Configuring/Dispatchers/#fullscreenstate
hypr::is_fullscreen() {
    [[ "$(hyprctl -j activewindow | jq '.fullscreen')" = 2 ]]
}

hypr::flash::border() {
    [[ "$(hyprctl -j getoption animations:enabled | jq -r '.int')" == 0 ]] && return 0

    hyprctl -q "keyword general:col.active_border rgb(cdcecf)"
    sleep 0.2
    hyprctl -q reload config-only
}

hypr::flash::screen() {
    local anim_status="$(hyprctl -j getoption animations:enabled | jq -r '.int')"
    [[ $anim_status == 0 ]] && return 0

    hyprctl -q hyprsunset gamma 150
    hyprctl -q hyprsunset gamma 100
}

#############################
##### Configure helpers #####
#############################

# Ensures that a given option exists in the user settings file.
# If it's missing, appends the default value from the defaults file.
helpers::configure::verify_option() {
    local var="$1"
    [[ -z $var ]] && return 2

    local settings_file="$VIBRANIUM_USER_SETTINGS"
    local defaults_file="$VIBRANIUM_PATH/vb-core-defaults"

    local def_line
    def_line="$(awk -F= -v v="$var" '$1==v{print; exit}' "$defaults_file")" || return 1
    [[ -z $def_line ]] && return 1

    awk -v var="$var" -v newline="$def_line" '
        BEGIN { inserted=0 }

        # Preserve header/comments exactly as-is until first VIBRANIUM_ var
        !vars_started && !/^VIBRANIUM_/ { header[++h]=$0; next }

        {
            vars_started=1

            # Collect only VIBRANIUM_* assignments
            if ($0 ~ /^VIBRANIUM_[A-Za-z_]+=/) {
                split($0,a,"=")
                key=a[1]
                vars[key]=$0
                next
            }
        }

        END {
            # Overwrite or add the required variable
            split(newline,a,"=")
            vars[a[1]]=newline

            # Print header first
            for (i=1;i<=h;i++) print header[i]

            # Sort keys (I am a bit a perfectionist)
            n=asorti(vars, idx)
            for (i=1;i<=n;i++) print vars[idx[i]]
        }
    ' "$settings_file" > "$settings_file.tmp" && mv "$settings_file.tmp" "$settings_file"
}

# Flips a boolean value of a passed variable.
# Flag '-v' returns the new value
helpers::configure::toggle_bool() {
    local verbose
    local setting_name
    local current_value

    if [ "$1" = "-v" ]; then
        verbose=true
        setting_name="$2"
    else
        verbose=false
        setting_name="$1"
    fi

    helpers::configure::verify_option "$setting_name"
    eval "current_value=\$$setting_name"

    case "$current_value" in
        "true")
            sed -i "/^${setting_name}=/s/=.*/=false/" "$VIBRANIUM_USER_SETTINGS"
            [ "$verbose" = "true" ] && echo "false"
            ;;
        "false")
            sed -i "/^${setting_name}=/s/=.*/=true/" "$VIBRANIUM_USER_SETTINGS"
            [ "$verbose" = "true" ] && echo "true"
            ;;
    esac
}

# Aligns menu option labels to the same width for pretty column output.
# Expects items in "label : value" format, ignores HTML tags when measuring
# label length, pads shorter labels with spaces, and normalizes boolean
# values (true/false -> yes/no). Non-matching lines are passed through unchanged.
helpers::configure::build_menu() {
    local options=("$@")
    local max_len=0
    local has_colon_options=()

    for option in "${options[@]}"; do
        if [[ "$option" =~ ^(.*)\ :\ (.*)$ ]]; then
            local label="${BASH_REMATCH[1]}"

            local clean_label
            clean_label=$(echo "$label" | sed 's/<[^>]*>//g')

            local len=${#clean_label}
            if (( len > max_len )); then
                max_len=$len
            fi
            has_colon_options+=("$option")
        fi
    done

    local aligned_options=()
    for option in "${options[@]}"; do
        if [[ "$option" =~ ^(.*)\ :\ (.*)$ ]]; then
            local label="${BASH_REMATCH[1]}"
            local value="${BASH_REMATCH[2]}"

            local clean_label
            clean_label=$(echo "$label" | sed 's/<[^>]*>//g')

            local len=${#clean_label}
            local padding=$((max_len - len))
            local padded_label="$label"

            for ((j=0; j<padding; j++)); do
                padded_label+=" "
            done

            if [[ "${value,,}" == "true" ]]; then
                value="yes"
            elif [[ "${value,,}" == "false" ]]; then
                value="no"
            fi
            aligned_options+=("$padded_label : $value")
        else
            aligned_options+=("$option")
        fi
    done

    for aligned in "${aligned_options[@]}"; do
        echo "$aligned"
    done
}

# Prompts the user for a numeric value via menu, validates type and range,
# optionally runs in verification-only mode, and can persist the result
# to the user settings file under the given option name. Supports integers
# and floats, trims whitespace, normalizes float formatting, and retries
# on invalid input with an error notification.
helpers::configure::set_digit() {
    local check_only=false

    # parse flags
    while [[ "$1" == -* ]]; do
        case "$1" in
            --verify) check_only=true ;;
            *) return 1 ;;
        esac
        shift
    done

    local prompt_base="$1"
    local rofi_title="$2"
    local type="$3"    # "int" or "float"
    local min_val="$4"
    local max_val="$5"
    local opt_name="${6:-}"
    local settings_file="$VIBRANIUM_USER_SETTINGS"

    local range_text="${min_val}-${max_val}"
    local prompt="${prompt_base} (${type})"

    while true; do
        local input
        input="$(printf "%s\n" "$prompt" | helpers::ui::menu "$rofi_title" "$range_text")"

        [[ -z "$input" ]] && return 1
        [[ "$input" = "$prompt" ]] && continue

        input="${input#"${input%%[![:space:]]*}"}"
        input="${input%"${input##*[![:space:]]}"}"

        local valid=true

        if [[ "$type" == "int" ]]; then
            if ! [[ "$input" =~ ^[0-9]+$ ]]; then
                valid=false
            else
                local inrange
                inrange=$(awk -v v="$input" -v lo="$min_val" -v hi="$max_val" \
                          'BEGIN { v+=0; lo+=0; hi+=0; print (v >= lo && v <= hi) }')
                [[ "$inrange" != 1 ]] && valid=false
            fi

        elif [[ "$type" == "float" ]]; then
            if ! [[ "$input" =~ ^[0-9]*\.?[0-9]+$ ]]; then
                valid=false
            else
                local inrange
                inrange=$(awk -v v="$input" -v lo="$min_val" -v hi="$max_val" \
                          'BEGIN { v+=0; lo+=0; hi+=0; print (v >= lo && v <= hi) }')
                [[ "$inrange" != 1 ]] && valid=false

                if [[ "$valid" == true ]]; then
                    input=$(awk -v v="$input" '
                        BEGIN {
                            v+=0
                            if (v == int(v)) printf "%d.0", int(v)
                            else printf "%g", v
                        }')
                fi
            fi
        else
            return 1
        fi

        if [[ "$valid" == false ]]; then
            notify-send -r 6 -u critical -t 1500 "Vibranium" \
                "A ${type} between ${min_val} and ${max_val}!"
            continue
        fi

        # check-only mode: just return the validated value
        if [[ "$check_only" == true ]]; then
            printf "%s" "$input"
            return 0
        fi

        if [[ -n "$opt_name" ]]; then
            helpers::configure::verify_option "$opt_name" || return 1

            if grep -qE "^${opt_name}=" "$settings_file" 2>/dev/null; then
                sed -i "/^${opt_name}/s/=.*/=${input}/" "$settings_file"
            else
                printf "%s=%s\n" "$opt_name" "$input" >> "$settings_file"
            fi
        fi

        printf "%s" "$input"
        return 0
    done
}

# Presents a menu of string options to the user, validates the selection,
# and saves the chosen value to the user settings file under the given
# variable name.
helpers::configure::set_string() {
    local var_name="$1"
    local title="$2"
    shift 2
    local raw_options=("$@")

    local labels=()
    local values=()

    # Split Pretty:Value
    for opt in "${raw_options[@]}"; do
        if [[ "$opt" == *:* ]]; then
            labels+=("${opt%%:*}")
            values+=("${opt#*:}")
        else
            labels+=("$opt")
            values+=("$opt")
        fi
    done

    while true; do
        chosen_label="$(printf "%s\n" "${labels[@]}" | helpers::ui::menu "$title" "ESC to go back")"
        [[ -z "$chosen_label" ]] && break

        # Find index of selected label
        for i in "${!labels[@]}"; do
            if [[ "${labels[$i]}" == "$chosen_label" ]]; then
                chosen_value="${values[$i]}"
                helpers::configure::verify_option "$var_name"
                sed -i "/^${var_name}=/s|=.*|=\"${chosen_value// /_}\"|" "$VIBRANIUM_USER_SETTINGS"
                return
            fi
        done
    done
}
