#!/usr/bin/env bash

source vb-core-lib

export SUDO_PROMPT="$VIBRANIUM_SUDO_PROMPT"

_operation_canceled() {
    printf "%s[VIBRANIUM]%s Operation canceled" "$RED" "$RESET"
    read -n1 -r -s -p $'. Press any key to exit' dummy

    term::enable_input
}

_operation_complete() {
    printf "%s[VIBRANIUM]%s Setup complete" "$GREEN" "$RESET"
    read -n1 -r -p $'. Press any key to exit ' dummy

    term::enable_input
}

_add_user_to_group() {
    if groups | grep -qw libvirt; then
        return 1   # already a member
    fi

    echo -e "${YELLOW}[VIBRANIUM]${RESET} Adding ${CYAN}${USER}${RESET} to the '${CYAN}libvirt${RESET}' group"
    sudo usermod -aG libvirt "$USER"
    return 0   # was added
}

_enable_systemd_units() {
    local sockets=()

    mapfile -t sockets < <(pacman -Ql libvirt | awk '/\/systemd\/.*\.(socket)$/ && $2 !~ /@/ {print $2}')

    for socket in "${sockets[@]}"; do
        sudo systemctl -q enable --now "${socket##*/}" &
    done

    # sudo systemctl -q enable --now dnsmasq.service &
}

_configure_virsh_network() {
    # Redirect to /dev/null in case it's already active
    sudo virsh -q net-autostart default 2>/dev/null || true
    sudo virsh -q net-start default 2>/dev/null || true
}

_configure_ufw() {
    if ! command -v ufw &>/dev/null; then
        return 2   # ufw absent
    fi

    local conf=/etc/libvirt/network.conf
    local desired=$'# Vibranium overrides below\nfirewall_backend = "iptables"'

    if grep -q '^firewall_backend' "$conf" 2>/dev/null; then
        echo -e "${GREEN}[VIBRANIUM]${RESET} UFW libvirt config: already up to date, skipping"
        return 1   # unchanged
    fi

    echo -e "${YELLOW}[VIBRANIUM]${RESET} Configuring firewall for libvirt"
    echo -e "\n\n$desired" | sudo tee -a "$conf" >/dev/null
    return 0       # applied
}

# ─────────────────────────────────────────────────────────────

term::show_header
term::disable_input

# if command -v virsh > /dev/null; then
#     if systemctl -q is-enabled libvirtd.socket ||
#         systemctl -q is-enabled libvirtd.service; then
#         echo -e "${GREEN}[VIBRANIUM]${RESET} QEMU is already set up and running"
#         _operation_complete
#         exit 0
#     fi
# fi

echo -e "${YELLOW}[VIBRANIUM]${RESET} You're about to setup QEMU VM (${BLUE}libvirt${RESET})"

if ! term::ask_yes_no Y "Proceed with setup?"; then
    _operation_canceled
    exit 1
fi

if ! vb-pkg-install --embedded -- libvirt dnsmasq qemu-desktop virt-manager; then
    _operation_canceled
    exit 1
fi

summary_rules=()

# ── User group ────────────────────────────────────────────────
if _add_user_to_group; then
    echo -e "${YELLOW}[VIBRANIUM]${RESET} A system restart is recommended for the group change to take effect"
    summary_rules+=("User ${CYAN}${USER}${RESET}: ${GREEN}added${RESET} to the ${CYAN}libvirt${RESET} group (restart recommended)")
else
    summary_rules+=("User ${CYAN}${USER}${RESET}: already in the ${CYAN}libvirt${RESET} group")
fi

# ── Systemd units ─────────────────────────────────────────────
echo -e "${YELLOW}[VIBRANIUM]${RESET} Enabling systemd units"
_enable_systemd_units
summary_rules+=("Systemd units: ${GREEN}enabled and started${RESET}")

# ── Virtual network ───────────────────────────────────────────
echo -e "${YELLOW}[VIBRANIUM]${RESET} Setting up virtual network"
_configure_virsh_network
summary_rules+=("Virtual network: ${GREEN}default network autostart configured${RESET}")

# ── UFW firewall rules ────────────────────────────────────────
_configure_ufw
case $? in
    0) summary_rules+=("UFW: ${GREEN}libvirt iptables backend configured${RESET}") ;;
    1) summary_rules+=("UFW: ${CYAN}unchanged${RESET}") ;;
    2) summary_rules+=("UFW: ${YELLOW}not present${RESET}, skipped") ;;
esac

echo ""
echo -e "${BLUE}[VIBRANIUM]${RESET} ── Summary ─────────────────────────────"
for rule in "${summary_rules[@]}"; do
    echo -e "${BLUE}[VIBRANIUM]${RESET}  • $rule"
done
echo -e "${BLUE}[VIBRANIUM]${RESET} ─────────────────────────────────────────"
echo ""

if term::ask_yes_no Y "Launch VM Manager now?"; then
    exec setsid -f virt-manager &>/dev/null
else
    _operation_complete
fi
