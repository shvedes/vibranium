#!/usr/bin/env bash

enabled="$(vb-cmd-get-option VIBRANIUM_BAR_NIGHT_LIGHT_MOUDLE_ENABLE)"
if [[ $enabled == false ]]; then
  printf '{"text": ""}'
  exit 0
fi

state="$(< "$XDG_STATE_HOME/vibranium/nightshift")"

if [[ $state == "active" ]]; then
  config="$XDG_CONFIG_HOME/hypr/hyprsunset.conf"
  current="$(grep -oP '(?<=temperature = ).*' "$config")"
  tooltip="Night Light temperature: ${current}K"
  printf '{"text": "%s", "tooltip": "%s"}' "\\udb80\\udf35" "$tooltip"
else
  printf '{"text": "%s", "tooltip": "Night Light is suspended"}' "\\udb80\\udf35"
fi
