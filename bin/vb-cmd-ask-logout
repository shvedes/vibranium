#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ "$level" == "Error" ]] || ($VERBOSE && [[ -t 0 ]]); then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Show a logout confirmation dialog.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    log Error "unknown option: $1"
    usage
    exit 1
    ;;
  esac
done

# rofi -sync makes the call block until the user makes a selection
# (otherwise -dmenu returns immediately with an empty result).
# -hover-select and -me-accept-entry MousePrimary allow click-to-select
# without requiring Enter, matching common logout dialog behaviour.
rofi_opts=(
  -sync
  -dmenu
  -p "Log out?"
  -hover-select
  -me-select-entry ''
  -me-accept-entry MousePrimary
  -theme-str 'window{width: 250px;}'
)

if [[ "$(printf "Yes\nNo" | rofi "${rofi_opts[@]}")" == "Yes" ]]; then
  vb-core-stop-session
fi
