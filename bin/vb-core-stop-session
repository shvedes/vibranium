#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTIONS]

Terminate the current session forcefully.

Options:
    -v, --verbose     Enable verbose output
    -h, --help        Show this help and exit
EOF
}

log Info "${0##*/} started"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log Error "Unknown option: $1"
      log Error "Try '${0##*/}' --help for more information"
      exit 1
      ;;
  esac
done

# Some applications can remain alive during session teardown and block the
# UWSM stop request.

# Target names are matched globally, not limited to descendants of this shell;
# SIGKILL bypasses application cleanup handlers before the stop request.
APPS=("Discord" "vesktop" "spotify" "steam" "steamwebhelper")

# Forced application cleanup is isolated from the hook run below, so hooks
# cannot prevent signal delivery but can act after it completes.
log Info "Killing frozen applications: ${APPS[*]}"
# A missing name makes killall return nonzero, but the loop has no errexit
# behavior and continues so one absent application cannot suppress the others.
for app in "${APPS[@]}"; do
  killall -s KILL "$app"
done

# Shutdown hooks run as child Bash processes. Their variables and traps are
# isolated, and a nonzero child status does not stop later hooks.
# Without nullglob, an unmatched pattern remains a literal path in the array;
# the non-empty count can therefore include a path that is not a hook file.
HOOKS=("$XDG_CONFIG_HOME"/vibranium/hooks/shutdown/*.sh)

log Info "Shutdown hooks: ${#HOOKS[@]} found"

if ((${#HOOKS[@]} > 0)); then
  log Info "Running shutdown hooks"
  for hook in "${HOOKS[@]}"; do
    log Info "Executing hook: $hook"
    bash "$hook"
  done
fi

# uwsm stop initiates the Wayland session shutdown via UWSM. If it
# fails, show the error in a persistent notification so the user knows
# the session may not have terminated fully.
# The failure branch preserves the captured text in the notification, but it
# does not re-raise uwsm's exit status; callers must use the notification or
# log rather than this script's final status.
if ! out="$(uwsm stop 2>&1)"; then
  log Error "uwsm stop failed: $out"
  notify-send -r 4 -a "Vibranium Shell" -u critical \
    "Failed to Log Out!" "UWSM shows this error: \n\n${out}"
else
  log Info "uwsm stop completed successfully"
fi
