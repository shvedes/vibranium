#!/usr/bin/env bash

usage() {
    cat << EOF
Usage: ${0##*/} [COMMAND [ARGS...]]

Open the default terminal (Alacritty). If COMMAND is provided,
it will be executed inside the terminal.

Options:
  -h, --help   Show this help and exit
EOF
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

args=()
class="alacritty"

if [[ $# -ge 1 ]]; then
    cmd="$1"

    if ! command -v "$cmd" > /dev/null; then
        echo "$cmd: command not found" >&2
        exit 1
    fi

    shift
    class="${cmd##*/}"
    args=(-e "$cmd" "$@")
fi

if [[ "$(systemctl --user is-active alacritty)" == "inactive" ]]; then
    systemctl --user enable --now alacritty
fi

alacritty msg create-window --class "$class" --title "$class" "${args[@]}"
