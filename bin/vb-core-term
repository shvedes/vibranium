#!/usr/bin/env bash

source vb-core-lib

helpers::check VIBRANIUM_GLOBAL_TERMINAL

# Supported terminal backends.
# Order matters for auto-detection.
readonly ALLOWED_TERMINALS=(alacritty foot)

usage() {
    cat << EOF
Usage: ${0##*/} [OPTIONS] [--] [COMMAND [ARGS...]]

Open the default terminal. If COMMAND is provided, it will be
executed inside the terminal.

Supported terminals: ${ALLOWED_TERMINALS[*]}
Terminal precedence: --terminal flag > VIBRANIUM_GLOBAL_TERMINAL env var > auto-detect

Options:
  -h, --help              Show this help and exit
  --terminal TERM         Terminal to use (${ALLOWED_TERMINALS[*]})
  --floating              Open terminal as a floating window
  --directory DIR         Set the working directory for the new terminal window
  --hold                  Keep the window open after the command exits
  --title TITLE           Set the window title (default is COMMAND basename)
  --                      End of options; next token is COMMAND even if it starts with -
EOF
}

FLOATING=false
WORKDIR=""
HOLD=false
TITLE=""
TERMINAL_FLAG=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        --terminal)
            if [[ -z "${2-}" ]]; then
                echo "--terminal requires an argument" >&2
                exit 1
            fi
            TERMINAL_FLAG="$2"
            shift 2
            ;;
        --floating)
            FLOATING=true
            shift
            ;;
        --directory)
            if [[ -z "${2-}" ]]; then
                echo "--directory requires an argument" >&2
                exit 1
            fi
            WORKDIR="$2"
            shift 2
            ;;
        --hold)
            HOLD=true
            shift
            ;;
        --title)
            if [[ -z "${2-}" ]]; then
                echo "--title requires an argument" >&2
                exit 1
            fi
            TITLE="$2"
            shift 2
            ;;
        # Everything after -- is treated as the command, even if it looks like a flag
        --)
            shift
            break
            ;;
        *)
            echo "Unknown option: $1" >&2
            echo "Use '--' to separate options from a command, e.g.: ${0##*/} --floating -- btop" >&2
            exit 1
            ;;
    esac
done

# Check whether a given terminal name is in the allowed list
is_allowed_terminal() {
    local t="$1"
    local allowed
    for allowed in "${ALLOWED_TERMINALS[@]}"; do
        if [[ "$t" == "$allowed" ]]; then
            return 0
        fi
    done
    return 1
}

# Walk the allowed list and return the first terminal found in PATH
detect_terminal() {
    local t
    for t in "${ALLOWED_TERMINALS[@]}"; do
        if command -v "$t" > /dev/null 2>&1; then
            echo "$t"
            return
        fi
    done
    echo ""
}

# Resolve which terminal to use.
# --terminal flag takes priority, then the VIBRANIUM_GLOBAL_TERMINAL env var, then auto-detect.
# Both explicit sources are validated so bad values fail loudly instead of silently falling through.
if [[ -n "$TERMINAL_FLAG" ]]; then
    if ! is_allowed_terminal "$TERMINAL_FLAG"; then
        echo "Unsupported terminal: '$TERMINAL_FLAG'" >&2
        echo "Allowed terminals: ${ALLOWED_TERMINALS[*]}" >&2
        exit 1
    fi
    TERMINAL="$TERMINAL_FLAG"
elif [[ -n "${VIBRANIUM_GLOBAL_TERMINAL-}" ]]; then
    if ! is_allowed_terminal "$VIBRANIUM_GLOBAL_TERMINAL"; then
        echo "Unsupported terminal in VIBRANIUM_GLOBAL_TERMINAL: '$VIBRANIUM_GLOBAL_TERMINAL'" >&2
        echo "Allowed terminals: ${ALLOWED_TERMINALS[*]}" >&2
        exit 1
    fi
    TERMINAL="$VIBRANIUM_GLOBAL_TERMINAL"
else
    TERMINAL="$(detect_terminal)"
fi

if [[ -z "$TERMINAL" ]]; then
    echo "No supported terminal emulator found (${ALLOWED_TERMINALS[*]})" >&2
    exit 1
fi

# Reject a non-existent working directory early so the user gets a visible
# notification rather than a silent failure inside the terminal process
if [[ -n "$WORKDIR" ]]; then
    if [[ ! -d "$WORKDIR" ]]; then
        notify-send \
            -r 4 \
            -t 4000 \
            -u critical \
            "Terminal Emulator" \
            "Directory <i><b>$WORKDIR</b></i> does not exist!"
        exit 1
    fi
fi

# If a terminal window whose title matches PATTERN already exists, focus it
# and return 0. Returns 1 when no match is found so the caller can proceed
# with a normal launch.
focus_if_running() {
    local pattern="$1"
    local address
    address=$(
        hyprctl clients -j | jq -r --arg p "$pattern" '
            first(
                .[]
                | select(
                    (.class | test("\\b" + $p + "\\b"; "i")) or
                    (.title | test("\\b" + $p + "\\b"; "i"))
                )
                | .address
            )
        '
    )

    if [[ -z "$address" ]]; then
        return 1
    fi
    hyprctl -q dispatch focuswindow "address:$address"
}

# Default window title and app class used across all backends
title="Vibranium Terminal"
class="org.vb.term"
cmd_args=()

# If a command was given, verify it exists and collect it together with its
# arguments. The command basename becomes the window title unless --title overrides it.
if [[ $# -ge 1 ]]; then
    cmd="$1"

    if ! command -v "$cmd" > /dev/null; then
        echo "$cmd: command not found" >&2
        exit 1
    fi

    shift
    title="${cmd##*/}"
    cmd_args=("$cmd" "$@")
fi

# --title always wins over the auto-derived command name
if [[ -n "$TITLE" ]]; then
    title="$TITLE"
fi

# Populate the global term_args array for alacritty.
# Alacritty runs as a persistent user service and accepts new windows
# through IPC via "alacritty msg create-window", so we start the service
# if it isn't already active. The command is passed with -e.
build_alacritty_args() {
    local wclass="$1"

    if ! systemctl -q --user is-active alacritty 2>/dev/null; then
        systemctl -q --user enable --now alacritty 2>/dev/null || true
    fi

    term_args=(
        alacritty msg create-window
        --class "$wclass"
        --title "$title"
    )

    if [[ "$HOLD" == "true" ]]; then
        term_args+=(--hold)
    fi

    if [[ -n "$WORKDIR" ]]; then
        term_args+=(--working-directory "$WORKDIR")
    fi

    if [[ ${#cmd_args[@]} -gt 0 ]]; then
        term_args+=(-e "${cmd_args[@]}")
    fi
}

# Populate the global term_args array for foot.
# Foot also runs as a persistent user service; clients connect to it via
# footclient. The command is passed as plain trailing arguments with no -e flag.
build_foot_args() {
    local wclass="$1"

    if ! systemctl -q --user is-active foot-server.socket 2>/dev/null; then
        systemctl -q --user enable --now foot-server.socket 2>/dev/null || true
    fi

    term_args=(footclient
        --app-id "$wclass"
        --title "$title"
    )

    if [[ "$HOLD" == "true" ]]; then
        term_args+=(--hold)
    fi

    if [[ -n "$WORKDIR" ]]; then
        term_args+=(--working-directory "$WORKDIR")
    fi

    if [[ ${#cmd_args[@]} -gt 0 ]]; then
        term_args+=("${cmd_args[@]}")
    fi
}

# If a window for this TUI command is already open, focus it and stop —
# all other flags (--floating, --directory, --hold, …) are ignored.
if [[ ${#cmd_args[@]} -gt 0 ]]; then
    if focus_if_running "$title"; then
        echo "Focusing existing window"
        exit 0
    fi
fi

# Floating windows get a distinct app class so Hyprland window rules can
# target them separately. The built command is shell-quoted into a single
# string and handed to hyprctl, which spawns it with the float rule applied.
if [[ "$FLOATING" == "true" ]]; then
    float_class="${class}.float"
    term_args=()

    case "$TERMINAL" in
        alacritty) build_alacritty_args "$float_class" ;;
        foot)      build_foot_args      "$float_class" ;;
    esac

    cmdline="$(printf '%q ' "${term_args[@]}")"
    cmdline="${cmdline% }"

    rule="[float; size monitor_w*0.7 monitor_h*0.7; move center]"
    hyprctl -q dispatch exec "$rule $cmdline"
    exit 0
fi

# Non-floating: build and exec the terminal command directly
term_args=()

case "$TERMINAL" in
    alacritty) build_alacritty_args "$class" ;;
    foot)      build_foot_args      "$class" ;;
esac

exec "${term_args[@]}"

