#!/usr/bin/env bash

FILE="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/smart-gaps.conf"

usage() {
    cat << EOF
Usage: ${0##*/} [--help]

Toggle Hyprland smart gaps configuration.

Options:
  -h, --help   Show this help and exit
EOF
}

case "${1:-}" in
    -h|--help) usage; exit 0
esac

mapfile -t gaps < <(
    hyprctl -j --batch \
        'getoption general:gaps_in;
         getoption general:gaps_out' | \
    jq -r '.custom | split(" ")[0]'
)

gaps_in=${gaps[0]}
gaps_out=${gaps[1]}

if (( gaps_in == 0 && gaps_out == 0 )); then
    notify-send -r 3 "Vibranium" "You don't have any gaps at all!"
    exit 1
fi

if [[ -f "$FILE" ]]; then
    rm "$FILE"
else
    cat > "$FILE" << EOF
workspace = w[tv1]s[false], gapsout:0, gapsin:0
workspace = f[1]s[false], gapsout:0, gapsin:0

windowrule = border_size 0, match:float 0, match:workspace w[tv1]s[false]
windowrule = rounding 0, match:float 0, match:workspace w[tv1]s[false]
windowrule = border_size 0, match:float 0, match:workspace f[1]s[false]
windowrule = rounding 0, match:float 0, match:workspace f[1]s[false]
EOF
fi

hyprctl -q reload config-only &
