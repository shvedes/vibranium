#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}
SELF="${0##*/}"
CLI_TIME=

usage() {
  shcat << EOF
Usage: $SELF [OPTION]...

Set a countdown timer. Without options, shows a rofi-based duration picker.

Options:
  -s, --seconds N  Start a countdown of N seconds
  -m, --minutes N  Start a countdown of N minutes
  -H, --hours N    Start a countdown of N hours
  -v, --verbose    Enable verbose output
  -h, --help       Show this help and exit
EOF
}

source vb-lib-core

while (($# > 0)); do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -s | --seconds)
      CLI_TIME=$((CLI_TIME + $2))
      shift 2
      ;;
    -m | --minutes)
      CLI_TIME=$((CLI_TIME + $2 * 60))
      shift 2
      ;;
    -H | --hours)
      CLI_TIME=$((CLI_TIME + $2 * 3600))
      shift 2
      ;;
    *)
      log Error "Unknown option: $1"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
  esac
done

state="$VIBRANIUM_RUNTIME/vb-timer.remaining"
ring="/usr/share/sounds/freedesktop/stereo/alarm-clock-elapsed.oga"
paplay_pid=""
inhibit_pidfile="$VIBRANIUM_RUNTIME/vb-timer.inhibit.pid"
inhibit_pid=""

# Clean up state, waybar, inhibit process, and alarm.
cleanup() {
  rm -f "$state" "$inhibit_pidfile"
  vb-refresh-waybar-module timer
  [[ -n "$inhibit_pid" ]] && kill "$inhibit_pid" &> /dev/null
  [[ -n "$paplay_pid" ]] && kill -s KILL "$paplay_pid" &> /dev/null
}

trap 'cleanup; exit 0' EXIT INT TERM

# If another timer instance is running, kill it by PID file.
if [[ -f "$inhibit_pidfile" ]]; then
  old_pid=$(< "$inhibit_pidfile")
  kill "$old_pid" &> /dev/null
  sleep 0.5
fi

# Bypass interactive picker when CLI flags were given.
if [[ -n "$CLI_TIME" ]]; then
  if ((CLI_TIME <= 0)); then
    log Error "Time must be a positive integer"
    exit 1
  fi
  sleep_time=$CLI_TIME
else
  options=("Seconds" "Minutes" "Hours")
  while true; do
    helpers::ui::menu chosen "Set timer for" "ESC to go back" -- "${options[@]}"
    if [[ -z "$chosen" ]]; then
      exit 1
    fi

    if [[ ! " ${options[*]} " == *" $chosen "* ]]; then
      continue
    fi

    while true; do
      prompt="Int, in ${chosen,}"
      helpers::ui::menu sub_chosen "Set timer" "ESC to go back" -- "$prompt"

      if [[ -z "$sub_chosen" ]]; then
        break
      fi

      if [[ ! "$sub_chosen" =~ ^[0-9]+$ ]]; then
        continue
      fi

      case "$chosen" in
        Seconds)
          sleep_time="$sub_chosen"
          ;;
        Minutes)
          sleep_time=$((sub_chosen * 60))
          ;;
        Hours)
          sleep_time=$((sub_chosen * 3600))
          ;;
      esac
      break 2
    done
  done
fi

if [[ -z "$sleep_time" ]] || ((sleep_time <= 0)); then
  exit 0
fi

# systemd-inhibit blocks idle suspension for the duration of the timer.
# --what=idle is used instead of --what=sleep so the screen can still
# turn off while the timer is running, but the system will not suspend.
# setsid detaches the inhibit process from the terminal so it survives
# the script's exit.  The PID is saved so cleanup can kill it precisely.
setsid systemd-inhibit --what=idle --why="Sleep is inhibited because of the active timer" sleep "$sleep_time" &
inhibit_pid=$!
echo "$inhibit_pid" > "$inhibit_pidfile"
log Info "Timer started: ${sleep_time}s"

# Countdown loop: write remaining seconds to the state file every tick
# and signal waybar to re-read it.  sleep 1 & wait avoids accumulating
# sub-second drift across iterations.
time_remaining=$sleep_time
while ((time_remaining > 0)); do
  echo "$time_remaining" > "$state"
  vb-refresh-waybar-module timer
  ((time_remaining--))
  sleep 1 &
  wait $!
done

echo "timed out" > "$state"
vb-refresh-waybar-module timer
log Info "Timer expired"

# Play the alarm sound in a loop until the user kills this script
# (cleanup traps INT/TERM and stops paplay via the saved PID).
while true; do
  paplay --volume 32500 "$ring" &
  paplay_pid=$!
  wait "$paplay_pid"
done
