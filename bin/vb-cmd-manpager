#!/bin/bash

source vb-lib-cli

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]...

Search and read installed manual pages using fzf.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

VERBOSE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      log Error "Invalid option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
    *)
      log Error "Unexpected argument: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
  esac
done

if ! command -v fzf > /dev/null; then
  log Error "fzf is not installed"
  exit 1
fi

# Auto-detect an editor if none is set. The preference order is nvim ->
# vim -> neovide -> vi -> less, matching the most common terminal editors.
if [[ -z $EDITOR ]]; then
  log Info "EDITOR not set, detecting..."
  for ed in nvim vim neovide vi less; do
    if command -v "$ed" > /dev/null 2>&1; then
      EDITOR="$ed"
      break
    fi
  done
fi

export EDITOR

if [[ -f "$XDG_CONFIG_HOME/vibranium/current/theme/fzf" ]]; then
  source "$XDG_CONFIG_HOME/vibranium/current/theme/fzf"
fi

FZF_ARGS=(
  --layout=reverse
  --border=sharp
  --border-label ' alt-p: toggle preview | alt-j/j: scroll preview '
  --border-label-pos 'bottom'
  --input-label 'search man pages'
  --preview-window 'right:60%:border-sharp'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --preview 'MANPAGER=cat man {1} 2>/dev/null'
  --prompt '> '
)
FZF_ARGS+=(--color "${FZF_COLORS:-pointer:white,marker:green}")

# Set MANPAGER based on the detected editor so that opening a man page
# from fzf uses the appropriate viewer. vim/nvim users get the +Man!
# plugin integration; nano gets -v (view mode); others use the editor
# directly as the pager.
if [[ -z $MANPAGER ]]; then
  case "$EDITOR" in
    *nvim | *vim)
      export MANPAGER="$EDITOR +Man!"
      ;;
    *nano)
      export MANPAGER="$EDITOR -v"
      ;;
    *)
      export MANPAGER="$EDITOR"
      ;;
  esac
fi

# Loop: show fzf with a live preview of the selected man page.
# man -k . lists every installed man page; sed strips the description
# after " - " and inserts a space before the section parenthesis so
# fzf's {1} extract matches the page name only.
while true; do
  selected=$(
    man -k . 2> /dev/null |
      sed 's/ - .*//; s/\([^ ]\)(/\1 (/' |
      fzf "${FZF_ARGS[@]}"
  )

  [[ -z "$selected" ]] && exit 0

  # Parse the selected entry: extract page name (before paren) and section.
  # Format from man -k:  "page_name (section)"
  page="${selected%%(*}"
  page="${page% }"

  tmp="${selected#*(}"
  section="${tmp%%)*}"

  man "$section" "$page"
done
