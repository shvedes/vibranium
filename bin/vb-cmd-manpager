#!/bin/bash

source vb-lib-cli

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]...

Search and read installed manual pages using fzf.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

VERBOSE=${VERBOSE:-false}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      log Error "Invalid option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
    *)
      log Error "Unexpected argument: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
  esac
done

if ! command -v fzf > /dev/null; then
  log Error "fzf is not installed"
  exit 1
fi

# The fzf preview explicitly sets MANPAGER=cat for that child process; a
# post-selection man invocation uses the exported MANPAGER when configured.
# When EDITOR is unset, the first installed command in this order is used:
# nvim, vim, neovide, vi, then less.
if [[ -z $EDITOR ]]; then
  log Info "EDITOR not set, detecting..."
  for ed in nvim vim neovide vi less; do
    if command -v "$ed" > /dev/null 2>&1; then
      EDITOR="$ed"
      break
    fi
  done
fi

export EDITOR

if [[ -f "$VIBRANIUM_STATE/theme/fzf" ]]; then
  source "$VIBRANIUM_STATE/theme/fzf"
fi

# Keep all UI options in one array so theme values and preview commands retain
# their boundaries when the array is expanded into fzf.
FZF_ARGS=(
  --layout=reverse
  --border=sharp
  --border-label ' alt-p: toggle preview | alt-j/j: scroll preview '
  --border-label-pos 'bottom'
  --input-label 'search man pages'
  --preview-window 'right:60%:border-sharp'
  --bind 'alt-p:toggle-preview'
  --bind 'alt-k:preview-up,alt-j:preview-down'
  --preview 'MANPAGER=cat man {1} 2>/dev/null'
  --prompt '> '
)
FZF_ARGS+=(--color "${FZF_COLORS:-pointer:white,marker:green}")

# When MANPAGER is unset, derive it from the detected editor: vim/nvim use
# +Man!, nano uses -v, and other editors run directly. An explicit MANPAGER
# remains unchanged.
if [[ -z $MANPAGER ]]; then
  case "$EDITOR" in
    *nvim | *vim)
      export MANPAGER="$EDITOR +Man!"
      ;;
    *nano)
      export MANPAGER="$EDITOR -v"
      ;;
    *)
      export MANPAGER="$EDITOR"
      ;;
  esac
fi

# man -k . searches installed manual-page descriptions; sed strips the
# description after " - " and inserts a space before the section parenthesis
# so fzf's {1} extract matches the page name only.
while true; do
  selected=$(
    man -k . 2> /dev/null |
      while IFS= read -r _man_line; do
        _man_line="${_man_line%% - *}"
        if [[ $_man_line =~ ([^[:space:]])\((.*) ]]; then
          _man_line="${BASH_REMATCH[1]} (${BASH_REMATCH[2]}"
        fi
        printf '%s\n' "$_man_line"
      done |
      fzf "${FZF_ARGS[@]}"
  )

  # Command substitution carries only fzf's selected line into this loop; an
  # empty result is treated as cancellation rather than a malformed page.
  [[ -z "$selected" ]] && exit 0

  # Parse the selected entry: extract page name (before paren) and section.
  # Format from man -k:  "page_name (section)"
  page="${selected%%(*}"
  page="${page% }"

  tmp="${selected#*(}"
  section="${tmp%%)*}"

  # The split relies on the normalized `name (section)` shape produced above;
  # after man exits, the loop starts a new fzf invocation with a fresh query.
  man "$section" "$page"
done
