#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]... CHANNEL
Switch the Vibranium update channel to CHANNEL.

  -v, --verbose   enable verbose output
  -h, --help      display this help and exit

CHANNEL must be one of:

  release         detach HEAD to the latest release tag
  upstream        switch to the upstream branch
  <branch>        switch to the named remote branch
EOF
}

CHANNEL=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      log Error "Unrecognized option: $1"
      log Error "Try '${0##*/} --help' for more information."
      exit 1
      ;;
    *)
      if [[ -n "$CHANNEL" ]]; then
        log Error "Too many arguments"
        log Error "Try '${0##*/} --help' for more information."
        exit 1
      fi
      CHANNEL="$1"
      shift
      ;;
  esac
done

if [[ -z "$CHANNEL" ]]; then
  log Error "Missing operand"
  log Error "Try '${0##*/} --help' for more information."
  exit 1
fi

case "$CHANNEL" in
  release | upstream) ;;
  *" "* | "")
    log Error "Invalid channel: $CHANNEL"
    log Error "Try '${0##*/} --help' for more information."
    exit 1
    ;;
esac

# Send a desktop notification when stdout is not a terminal (i.e. when
# invoked from a launcher or hook rather than interactively).
# Empty urgency is intentionally passed as an empty expansion, which omits
# notify-send's -u option while retaining normal notifications.
notify() {
  local urgency="${1:-normal}" message="$2"

  if [[ ! -t 1 ]]; then
    notify-send -r 1 -a "Vibranium" ${urgency:+-u "$urgency"} "Vibranium" "$message"
  fi
}

# die converts a failed Git mutation into a user-visible notification when
# stdout is noninteractive, then gives the caller a nonzero status.
die() {
  log Error "$*"
  notify critical "$*"
  exit 1
}

# An empty branch name is treated as detached state. A failed git query can
# also produce an empty result, so the dirty-worktree check is skipped in
# either case.
CURRENT=""
IFS= read -r CURRENT < <(git -C "$VIBRANIUM" branch --show-current) || true

# Skip dirty check when detached (release) so untracked files don't
# block switching from a read-only checkout.
if [[ -n "$CURRENT" ]]; then
  # Porcelain output is captured as an array because each status record is one
  # element; the count detects any tracked, staged, or untracked change without
  # parsing filenames. Process-substitution failure can leave _st empty,
  # which this code treats as a clean worktree.
  mapfile -t _st < <(git -C "$VIBRANIUM" status --porcelain)
  CHANGES=${#_st[@]}

  if ((CHANGES > 0)); then
    MSG="you have unsaved changes. Commit them first or stash them with: git stash"
    log Error "$MSG"
    if [[ ! -t 2 ]]; then
      notify-send -r 4 -a "Vibranium" -u critical -t 7000 "Vibranium" "$MSG"
    fi
    exit 1
  fi
fi

case "$CHANNEL" in
  release)
    # Version sorting selects the greatest tag according to Git's
    # version:refname comparator; an empty result makes the detach attempt
    # fail through die.
    LATEST=""
    IFS= read -r LATEST < <(git -C "$VIBRANIUM" for-each-ref --sort=-version:refname --format='%(refname:short)' --count=1 'refs/tags/*') || true
    git -C "$VIBRANIUM" switch --detach "$LATEST" || die "failed to switch to '$LATEST'"
    log Info "Switched to release: $LATEST"
    echo "Switched to $LATEST."
    notify "" "Switched to $LATEST"
    ;;
  # The upstream target is the local master branch, a repository layout
  # assumption rather than a remote lookup or branch creation operation.
  upstream)
    git -C "$VIBRANIUM" switch master || die "failed to switch to 'master'"
    log Info "Switched to upstream"
    echo "Switched to upstream."
    notify "" "Switched to upstream"
    ;;
  # Any other name is a remote branch. The fetch validates it: an unknown
  # branch fails here through die instead of switching. A fetched
  # origin/<branch> lets switch create the local tracking branch.
  *)
    git -C "$VIBRANIUM" fetch origin "$CHANNEL" || die "branch '$CHANNEL' not found on origin"
    git -C "$VIBRANIUM" switch "$CHANNEL" || die "failed to switch to '$CHANNEL'"
    log Info "Switched to branch: $CHANNEL"
    echo "Switched to $CHANNEL."
    notify "" "Switched to $CHANNEL"
    ;;
esac

# Reload and update service are deliberately backgrounded, so the channel
# switch reports success once Git returns and does not wait for consumers to
# reload or for the service to enter its running state.
vb-cmd-reload -q &
systemctl -q --user start vibranium-update.service &
