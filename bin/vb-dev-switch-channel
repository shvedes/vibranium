#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ $level == "Error" ]] || ($VERBOSE && [[ -t 0 ]]); then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]... CHANNEL
Switch the Vibranium update channel to CHANNEL.

  -h, --help      display this help and exit

CHANNEL must be one of:

  release         detach HEAD to the latest release tag
  upstream        switch to the upstream branch
  dev             switch to the dev branch
EOF
}

CHANNEL=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -*)
      log Error "Unrecognized option: $1"
      log Error "Try '${0##*/} --help' for more information."
      exit 1
      ;;
    *)
      if [[ -n "$CHANNEL" ]]; then
        log Error "Too many arguments"
        log Error "Try '${0##*/} --help' for more information."
        exit 1
      fi
      CHANNEL="$1"
      shift
      ;;
  esac
done

if [[ -z "$CHANNEL" ]]; then
  log Error "Missing operand"
  log Error "Try '${0##*/} --help' for more information."
  exit 1
fi

case "$CHANNEL" in
  release | upstream | dev) ;;
  *)
    log Error "Invalid channel: $CHANNEL"
    log Error "Try '${0##*/} --help' for more information."
    exit 1
    ;;
esac

GIT="git -C $VIBRANIUM"

# Send a desktop notification when stdout is not a terminal (i.e. when
# invoked from a launcher or hook rather than interactively).
notify() {
  local urgency="${1:-normal}" message="$2"

  if [[ ! -t 1 ]]; then
    notify-send -r 1 ${urgency:+-u "$urgency"} "Vibranium" "$message"
  fi
}

die() {
  log Error "$*"
  notify critical "$*"
  exit 1
}

CURRENT="$($GIT branch --show-current)"

# When on a release tag (branch name starts with "v"), skip the dirty
# check because detached HEAD is expected and the checkout is read-only.
if [[ ! "$CURRENT" =~ ^v[0-9] ]]; then
  CHANGES="$($GIT status --porcelain | wc -l)"

  if ((CHANGES > 0)); then
    MSG="you have unsaved changes. Commit them first or stash them with: git stash"
    log Error "$MSG"
    if [[ ! -t 2 ]]; then
      notify-send -r 4 -u critical -t 7000 "Vibranium" "$MSG"
    fi
    exit 1
  fi
fi

# Each channel writes its name to update.channel so that vb-update-fetch
# knows which remote ref to track.  The reload and update service are
# backgrounded: the reload may take hundreds of ms and the update fetch
# can pend on network I/O.
case "$CHANNEL" in
  release)
    LATEST="$($GIT tag --sort=-creatordate | head -n 1)"
    $GIT switch --detach "$LATEST" || die "failed to switch to '$LATEST'"

    echo "release" > "$VIBRANIUM_STATE/update.channel"
    log Info "Switched to release: $LATEST"
    echo "Switched to $LATEST."
    notify "" "Switched to $LATEST"
    ;;
  upstream)
    $GIT switch master || die "failed to switch to 'master'"

    echo "upstream" > "$VIBRANIUM_STATE/update.channel"
    log Info "Switched to upstream"
    echo "Switched to upstream."
    notify "" "Switched to upstream"
    ;;
  dev)
    $GIT switch dev || die "failed to switch to 'dev'"

    echo "dev" > "$VIBRANIUM_STATE/update.channel"
    log Info "Switched to dev"
    echo "Switched to dev."
    notify "" "Switched to dev"
    ;;
esac

vb-cmd-reload -q &
systemctl -q --user start vibranium-update.service &
