#!/usr/bin/env bash

if ! command -v syncthing > /dev/null; then
    if [[ ! -t 1 ]]; then
        notify-send -r 4 -u critical -t 5000 \
        "Vibranium" "Syncthing is not installed!"
    fi

    echo "error: syncthing is not installed!" >&2
    exit 1
fi

if ! systemctl -q --user is-active syncthing; then
    systemctl -q --user enable --now syncthing
fi

if command -v chromium > /dev/null; then
    vb-cmd-launch-cmd chromium --app="https://127.0.0.1:8384"
else
    syncthing browser
fi

