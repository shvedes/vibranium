#!/usr/bin/env bash

source vb-core-lib

help() {
    cat <<EOF
Usage: ${0##*/} [OPTION]...

Toggle reading mode in Hyprland by applying or removing a screen shader.

Options:
  --help    Display this help and exit
EOF
}

_grayscale_enabled() {
    local opt
    opt="$(hyprctl -j getoption decoration:screen_shader | jq -r '.str')"
    if [[ "$opt" == "[[EMPTY]]" || "$opt" =~ ^()$ ]]; then
        return 1
    else
        return 0
    fi
}

if [ "$1" = "--help" ]; then
    help
    exit 0
fi

helpers::check VIBRANIUM_GLOBAL_READING_MODE_SHADER_TYPE

shader="$VIBRANIUM/default/hypr/shaders/${VIBRANIUM_GLOBAL_READING_MODE_SHADER_TYPE}.glsl"
config="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/reading-mode.conf"

if _grayscale_enabled; then
    rm -f "$config"
else
    echo "decoration:screen_shader = $shader" > "$config"
fi

hyprctl -q reload config-only &
vb-cmd-refresh-bar-module reading-mode
