#!/usr/bin/env bash

source vb-lib-core

SPICETIFY_FILE="$XDG_CONFIG_HOME/spicetify/config-xpui.ini"
CHROMIUM_FILE="$XDG_CONFIG_HOME/chromium-flags.conf"

# if command -v spotify > /dev/null && command -v spicetify > /dev/null; then
#     if ! grep -q "adblock" "$SPICETIFY_FILE"; then
#         OPTIONS=("Install Spotify adblock")
#     else
#         OPTIONS=("Remove Spotify adblock")
#     fi
# fi

if command -v chromium > /dev/null; then
  if ! grep -q "oauth2-client-id" "$CHROMIUM_FILE"; then
    OPTIONS+=("Enable Google sync for Chromium")
  else
    OPTIONS+=("Disable Google sync for Chromium")
  fi
fi

if [[ "${#OPTIONS[@]}" -eq 0 ]]; then
  notify-send -r 4 -t 5000 -u critical "Vibranium" "There are no tweaks available"
  exit 1
fi

helpers::ui::menu CHOSEN "App Tweaks" "ESC to go back" -- "${OPTIONS[@]}"
[[ -z "$CHOSEN" ]] && exit

case "$CHOSEN" in
  "Install Spotify adblock")
    vb-tweak-spotify install
    helpers::ui::close_menus
    exit 0
    ;;
  "Remove Spotify adblock")
    vb-tweak-spotify remove
    helpers::ui::close_menus
    exit 0
    ;;
  "Enable Google sync for Chromium")
    vb-tweak-chromium enable
    ;;
  "Disable Google sync for Chromium")
    vb-tweak-chromium disable
    ;;
esac
