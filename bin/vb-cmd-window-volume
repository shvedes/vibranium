#!/usr/bin/bash

STEP="5"
ACTION=""
SELF="${0##*/}"

# Shoutout to https://github.com/Vladimir-csp
# for this neat solution.
shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<-EOF
Usage: $SELF [OPTIONS]

Adjust the volume of the currently focused Hyprland window.

Please note that processes that use ALSA as their output
may not be picked up by this script (e.g. Telegram).

Options:
  -u, --up             Window volume up
  -d, --down           Window volume down
  -t, --toggle         Window volume toggle
  -s, --step PERCENT   Volume step size in percent (default: $STEP)
  -h, --help           Show this help message and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -s | --step)
    STEP="$2"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  -u | -d | -t)
    ACTION="${1#-}"
    shift
    ;;
  --up | --down | --toggle)
    ACTION="${1#--}"
    shift
    ;;
  *)
    echo "$SELF: unknown option '$1'" >&2
    usage >&2
    exit 1
    ;;
  esac
done

if [[ -z "$ACTION" ]]; then
  echo "$SELF: action required (--up|--down|--toggle)" >&2
  usage >&2
  exit 1
fi

# parse both pid and title out of one hyprctl call and one jq invocation,
# rather than forking jq twice on the same JSON string
read -r ACTIVE_PID WINDOW_TITLE < <(
  hyprctl -j activewindow | jq -r '[.pid, .title] | @tsv'
)

# guard: hyprctl returns {} on an empty workspace; jq yields "null" for .pid
if [[ -z "$ACTIVE_PID" || "$ACTIVE_PID" == "null" ]]; then
  exit 1
fi

# collect the focused pid and all its descendants into a flat list
# so that apps which emit audio from a child process are also matched
collect_pids() {
  local root="$1"

  # read the entire process table once into awk, build a parent->children map,
  # then do a BFS from root -- no subprocess per node, no recursion overhead
  ps -e -o pid=,ppid= | awk -v root="$root" '
    { children[$2] = children[$2] " " $1 }
    END {
      queue[1] = root
      depth = 1
      while (depth > 0) {
        new_depth = 0
        for (i = 1; i <= depth; i++) {
          p = queue[i]
          print p
          if (p in children) {
            n = split(children[p], kids)
            for (j = 1; j <= n; j++)
              next_queue[++new_depth] = kids[j]
          }
        }
        depth = new_depth
        for (i = 1; i <= depth; i++) queue[i] = next_queue[i]
        delete next_queue
      }
    }
  '
}

mapfile -t ALL_PIDS < <(collect_pids "$ACTIVE_PID")

# Previously this used pw-dump, which serializes the ENTIRE PipeWire object
# graph (nodes, ports, links, devices, modules, clients -- typically hundreds
# to thousands of objects) before jq can filter it.
#
# pactl list sink-inputs only enumerates active audio streams (typically
# under 10 entries), so it is orders of magnitude cheaper to parse.
#
# Each output line is: SINK_INPUT_ID VOLUME_PCT MUTED
# where MUTED is "yes" or "no".
mapfile -t SINK_DATA < <(
  pactl list sink-inputs | awk -v pids="${ALL_PIDS[*]}" '
    BEGIN {
      n = split(pids, a)
      for (i = 1; i <= n; i++) pid_set[a[i]] = 1
    }

    /^Sink Input #/ {
      # flush the previous record if it matched a target pid
      if (id != "" && matched) print id, vol, muted
      id   = $3;  sub(/#/, "", id)
      vol  = 100
      muted = "no"
      matched = 0
    }

    /^[[:space:]]+Mute:/ { muted = $2 }

    /^[[:space:]]+Volume:/ {
      # the Volume line looks like:
      #   front-left: 65536 / 100% / 0.00 dB,   front-right: ...
      # walk fields to find the first "NNN%" token and strip the percent sign
      for (i = 1; i <= NF; i++) {
        if ($i ~ /^[0-9]+%[,]?$/) {
          vol = $i + 0
          break
        }
      }
    }

    /application\.process\.id/ {
      gsub(/"/, "", $NF)
      if ($NF in pid_set) matched = 1
    }

    END { if (id != "" && matched) print id, vol, muted }
  '
)

if [[ ${#SINK_DATA[@]} -eq 0 ]]; then
  exit 0
fi

# track the first matched stream's resulting state for the notification;
# computed here rather than re-queried via wpctl get-volume after the fact
first_new_vol=""
first_new_muted=""

for SINK_ENTRY in "${SINK_DATA[@]}"; do
  read -r sink_id sink_vol sink_muted <<<"$SINK_ENTRY"

  case "$ACTION" in
  up)
    new_vol=$((sink_vol + STEP))
    ((new_vol > 100)) && new_vol=100
    pactl set-sink-input-volume "$sink_id" "${new_vol}%"
    new_muted="$sink_muted"
    ;;
  down)
    new_vol=$((sink_vol - STEP))
    ((new_vol < 0)) && new_vol=0
    pactl set-sink-input-volume "$sink_id" "${new_vol}%"
    new_muted="$sink_muted"
    ;;
  toggle)
    pactl set-sink-input-mute "$sink_id" toggle
    new_vol="$sink_vol"
    # invert mute locally -- no re-query needed
    [[ "$sink_muted" == "yes" ]] && new_muted="no" || new_muted="yes"
    ;;
  esac

  # only the first stream drives the notification
  if [[ -z "$first_new_vol" ]]; then
    first_new_vol="$new_vol"
    first_new_muted="$new_muted"
  fi
done

# scale current volume into 0-100 relative to max_vol_pct so the bar
# stays proportional when the above-100% boost is enabled
bar_value=$((first_new_vol * 100 / 100))
icons_folder="/usr/share/icons/Papirus/16x16/symbolic/status"

if [[ "$first_new_muted" == "yes" ]]; then
  notify-send -r 2 -i "$icons_folder/audio-volume-muted-symbolic.svg" -t 1000 "$WINDOW_TITLE Muted"
else
  notify-send -r 2 -i "$icons_folder/audio-volume-high-symbolic.svg" -t 1000 "$WINDOW_TITLE" -h "int:value:$bar_value"
fi
