#!/usr/bin/env bash

PERCENT=""
URGENCY=""
FORCE=0

SCRIPT_NAME="${0##*/}"

# Thresholds and their urgency are built into the script, so it has
# everything it needs in a single standalone invocation with no args.
# Order matters: when several thresholds are crossed in one run, the
# last one processed is the one left visible (see -r below).
KNOWN_THRESHOLDS=(25 15 5)

declare -A THRESHOLD_URGENCY=(
  [25]="normal"
  [15]="critical"
  [5]="critical"
)

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<-EOF
	Usage: ${SCRIPT_NAME} [OPTION]...

	Send a desktop notification when battery capacity reaches a low threshold.
	Meant to be invoked by udev on power_supply uevents.

	With no options, every built-in threshold (${KNOWN_THRESHOLDS[*]}) is
	checked in one run, each with its own built-in urgency.

	  -p, --percent=PERCENT   Check only this threshold instead of all built-in ones
	  -u, --urgency=LEVEL     Low, normal, critical; overrides the built-in urgency
	  -f, --force             Ignore existing notified state
	  -h, --help              Show this help and exit
	EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -p | --percent)
    PERCENT="$2"
    shift 2
    ;;

  --percent=*)
    PERCENT="${1#*=}"
    shift
    ;;

  -p?*)
    PERCENT="${1#-p}"
    shift
    ;;

  -u | --urgency)
    URGENCY="$2"
    shift 2
    ;;

  --urgency=*)
    URGENCY="${1#*=}"
    shift
    ;;

  -u?*)
    URGENCY="${1#-u}"
    shift
    ;;

  -f | --force)
    FORCE=1
    shift
    ;;

  -h | --help)
    usage
    exit 0
    ;;

  *)
    printf '%s: unknown option: %s\n' "$SCRIPT_NAME" "$1" >&2
    exit 1
    ;;
  esac
done

if [[ -n "$URGENCY" ]]; then
  case "$URGENCY" in
  low | normal | critical)
    ;;
  *)
    printf '%s: urgency must be low, normal, or critical\n' "$SCRIPT_NAME" >&2
    exit 1
    ;;
  esac
fi

if [[ -n "$PERCENT" ]] && ! [[ "$PERCENT" =~ ^[0-9]+$ ]]; then
  printf '%s: percent must be integer\n' "$SCRIPT_NAME" >&2
  exit 1
fi

BATTERY_PATHS=()

for CANDIDATE in /sys/class/power_supply/*; do
  if [[ -f "$CANDIDATE/type" ]] && [[ "$(<"$CANDIDATE/type")" == "Battery" ]]; then
    BATTERY_PATHS+=("$CANDIDATE")
  fi
done

if [[ ${#BATTERY_PATHS[@]} -eq 0 ]]; then
  printf '%s: no battery found\n' "$SCRIPT_NAME" >&2
  exit 1
fi

TOTAL_NOW=0
TOTAL_FULL=0

for BAT in "${BATTERY_PATHS[@]}"; do
  if [[ -f "$BAT/energy_now" ]] && [[ -f "$BAT/energy_full" ]]; then
    ((TOTAL_NOW += $(<"$BAT/energy_now")))
    ((TOTAL_FULL += $(<"$BAT/energy_full")))
  elif [[ -f "$BAT/charge_now" ]] && [[ -f "$BAT/charge_full" ]]; then
    ((TOTAL_NOW += $(<"$BAT/charge_now")))
    ((TOTAL_FULL += $(<"$BAT/charge_full")))
  else
    ((TOTAL_NOW += $(<"$BAT/capacity")))
    ((TOTAL_FULL += 100))
  fi
done

if [[ -z "$VIBRANIUM_RUNTIME" ]]; then
  VIBRANIUM_RUNTIME="${XDG_RUNTIME_DIR:-/run/user/$EUID}/vibranium"
fi

if ! [[ -d "$VIBRANIUM_RUNTIME" ]]; then
  mkdir -p "$VIBRANIUM_RUNTIME"
fi

# Single state file for this script, one notified threshold per line.
STATE_FILE="$VIBRANIUM_RUNTIME/${SCRIPT_NAME}.state"
NOTIFIED=()

if [[ -f "$STATE_FILE" ]]; then
  while IFS= read -r LINE; do
    [[ -n "$LINE" ]] || continue
    NOTIFIED+=("$LINE")
  done <"$STATE_FILE"
fi

# Drop entries for thresholds no longer in KNOWN_THRESHOLDS.
FILTERED=()

for ENTRY in "${NOTIFIED[@]}"; do
  for KNOWN in "${KNOWN_THRESHOLDS[@]}"; do
    if [[ "$ENTRY" == "$KNOWN" ]]; then
      FILTERED+=("$ENTRY")
      break
    fi
  done
done

NOTIFIED=("${FILTERED[@]}")

is_notified() {
  local CANDIDATE="$1"
  local ENTRY

  for ENTRY in "${NOTIFIED[@]}"; do
    if [[ "$ENTRY" == "$CANDIDATE" ]]; then
      return 0
    fi
  done

  return 1
}

remove_notified() {
  local CANDIDATE="$1"
  local ENTRY
  local RESULT=()

  for ENTRY in "${NOTIFIED[@]}"; do
    if [[ "$ENTRY" != "$CANDIDATE" ]]; then
      RESULT+=("$ENTRY")
    fi
  done

  NOTIFIED=("${RESULT[@]}")
}

add_notified() {
  local CANDIDATE="$1"

  if ! is_notified "$CANDIDATE"; then
    NOTIFIED+=("$CANDIDATE")
  fi
}

write_state() {
  if [[ ${#NOTIFIED[@]} -eq 0 ]]; then
    rm -f "$STATE_FILE"
  else
    printf '%s\n' "${NOTIFIED[@]}" >"$STATE_FILE"
  fi
}

# Reset, or notify for, a single threshold against the current capacity.
process_threshold() {
  local THRESH="$1"
  local THIS_URGENCY="$2"
  local TIME

  if ((CAPACITY > THRESH)); then
    remove_notified "$THRESH"
    return
  fi

  if is_notified "$THRESH" && ((FORCE != 1)); then
    return
  fi

  if [[ "$THIS_URGENCY" == "critical" ]]; then
    TIME=0
  else
    TIME=15000
  fi

  add_notified "$THRESH"

  if [[ "$THIS_URGENCY" == "critical" ]]; then
    if ((CAPACITY <= 5)); then
      local message="The battery at less than 5%!"
    else
      local message="The battery is at ${CAPACITY}%"
    fi
  fi

  notify-send -u "$THIS_URGENCY" -t "$TIME" -r 4455 \
    "You Are Low On Battery" "$message"
}

CAPACITY=$((TOTAL_NOW * 100 / TOTAL_FULL))

# Clear all notified thresholds while the system is charging.
# This allows notifications to trigger again after unplugging.
if [[ -f /sys/class/power_supply/AC/online ]] &&
  [[ "$(</sys/class/power_supply/AC/online)" == 1 ]]; then
  NOTIFIED=()
  write_state
  exit 0
fi

# Fallback charging detection for systems where AC is unavailable.
CHARGING=0

for BAT in "${BATTERY_PATHS[@]}"; do
  if [[ -f "$BAT/status" ]] && [[ "$(<"$BAT/status")" == "Charging" ]]; then
    CHARGING=1
    break
  fi
done

if ((CHARGING == 1)); then
  NOTIFIED=()
  write_state
  exit 0
fi

if [[ -n "$PERCENT" ]]; then
  THRESHOLDS_TO_CHECK=("$PERCENT")
else
  THRESHOLDS_TO_CHECK=("${KNOWN_THRESHOLDS[@]}")
fi

for THRESH in "${THRESHOLDS_TO_CHECK[@]}"; do
  if [[ -n "$URGENCY" ]]; then
    THIS_URGENCY="$URGENCY"
  else
    THIS_URGENCY="${THRESHOLD_URGENCY[$THRESH]:-normal}"
  fi

  process_threshold "$THRESH" "$THIS_URGENCY"
done

write_state
