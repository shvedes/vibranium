#!/bin/bash

VERBOSE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Print current Secure Boot status.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit

Exit status:
  0  secure boot is enabled
  1  secure boot is disabled
  2  secure boot is in setup mode
  3  pending reboot
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log Error "unknown option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
  esac
done

log Info "Querying Secure Boot status"

if [[ -f "$VIBRANIUM_STATE/secure-boot-setup.complete" ]]; then
  echo "pending reboot"
  exit 3
fi

# Parse bootctl status output to determine Secure Boot state.
# Sample output lines:
#   Secure Boot: disabled
#   Secure Boot: disabled (setup)
#   Secure Boot: enabled (user)
# Fields 3 and 4 are concatenated to form the status tag.
while IFS= read -r line; do
  if [[ $line == *"Secure Boot"* ]]; then
    read -r -a fields <<< "$line"
    sb_status="${fields[2]}${fields[3]}"
    break
  fi
done < <(bootctl status 2> /dev/null)

if [[ "$sb_status" == "disabled" ]]; then
  echo "disabled"
  exit 1
elif [[ "$sb_status" == "disabled(setup)" ]]; then
  echo "setup"
  exit 2
elif [[ "$sb_status" == "enabled"* ]]; then
  echo "enabled"
  exit 0
fi
