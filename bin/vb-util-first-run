#!/usr/bin/env bash

WORKER="$VIBRANIUM_RUNTIME/worker.active"
FIRSTBOOT_HOOKS="$VIBRANIUM/install/first-run"

# Set Waybar icon
echo "Finishing installation..." > "$WORKER"
vb-cmd-refresh-bar-module worker

# Generate XDG directories
xdg-user-dirs-update --force

for hook in "${FIRSTBOOT_HOOKS}"/*.sh; do
  echo "Running "${hook##*/}"." > "$WORKER"
  vb-cmd-refresh-bar-module worker

  bash "$hook"
done

# Remove Waybar icon
rm -f "$VIBRANIUM_RUNTIME/worker.active"
vb-cmd-refresh-bar-module worker

# Remove first run marker
rm -f "$VIBRANIUM_STATE/first-run"
