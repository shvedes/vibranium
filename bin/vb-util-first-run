#!/bin/bash

FIRSTBOOT_HOOKS="$VIBRANIUM/install/first-run"

if [[ ! -f "$VIBRANIUM_STATE/first-run" ]]; then
  echo "First run marker doesn't exists!" >&2
  exit 1
fi

# --force requests an unconditional rewrite of the XDG user-directory config.
# This script relies on the first-run marker to avoid invoking it again.
xdg-user-dirs-update --force

# Glob expansion orders hooks lexically; their numeric filename prefixes carry
# the required initialization sequence. With no matches, the literal glob path
# becomes one failed child invocation, which the completion path still tolerates.
for hook in "${FIRSTBOOT_HOOKS}"/*.sh; do
  # Each hook runs in a child Bash process, preventing shell options, variables,
  # and traps from leaking into the runner or subsequent hooks.
  bash "$hook"
done

# No fail-fast guard is active, so command and hook failures do not stop later
# iterations, and the marker is removed after the final attempt.
rm -f "$VIBRANIUM_STATE/first-run"
