#!/usr/bin/env bash

source "$XDG_CONFIG_HOME/vibranium/current/theme/vb-lib-theme"

# Checking file existance is faster
# than calling pacman -Q.
if [[ ! -f /usr/lib/rofi/emoji.so ]]; then
  vb-pkg-install --no-verify -- rofi-emoji
  exit 0
fi

if pidof -q rofi; then
  killall rofi
  exit 0
fi

rofi -modi emoji -show emoji -p "Emoji" \
  -theme-str "window{width: 400px;}" \
  -emoji-format "{emoji} {name}"
