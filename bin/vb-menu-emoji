#!/usr/bin/env bash

source "$XDG_CONFIG_HOME/vibranium/theme/current/vibranium-lib-theme"

if [[ ! -f /usr/lib/rofi/emoji.so ]]; then
    msg="The emoji menu requires "
    msg+="<span foreground='${P_YELLOW}'><b>rofi-emoji</b></span>, "
    msg+="which is not installed.\n\n"

    notify-send -r 4 -t 5000 "Vibranium" "$msg"
    vb-pkg-install rofi-emoji
    exit 0
fi

if pidof -q rofi; then
    killall rofi
    exit 0
fi

rofi -modi emoji -show emoji -p "Emoji" \
    -theme-str "window{width: 400px;}" \
    -emoji-format "{emoji} {name}"
