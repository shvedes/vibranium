#!/bin/bash

source vb-lib-cli

SELF="${0##*/}"

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: $SELF [OPTION]... URL

Open a Progressive Web App (PWA) in Vibranium.
If a window for the URL already exists, focus it instead.

Arguments:
  URL              Target URL to open or focus

Options:
  --own-profile    Launch in a separate browser data directory derived from the URL
                   hostname. The directory is stored under $XDG_DATA_HOME/webapps/
                   and is completely invisible to the main browser instance (no shared
                   profile picker, no shared session, cookies, or extensions).
  -v, --verbose    Enable verbose output
  -h, --help       Show this help message and exit

Examples:
  $SELF https://example.com
  $SELF --own-profile https://mail.example.com
EOF
}

get_default_browser() {
  local -n _out="$1"
  local browser=""

  log Info "Detecting default browser"

  # Fast path: mimeapps.list
  # Only the first HTTP handler is considered; semicolon-separated alternatives
  # are discarded, and xdg-mime is consulted only when that field is absent.
  if [[ -f "$XDG_CONFIG_HOME/mimeapps.list" ]]; then
    while IFS='=' read -r key value; do
      if [[ ! $key == "x-scheme-handler/http" ]]; then
        continue
      fi
      browser="${value%%;*}"
      break
    done < "$XDG_CONFIG_HOME/mimeapps.list"
  fi

  # Fallback
  if [[ -z $browser ]]; then
    IFS= read -r browser < <(xdg-mime query default x-scheme-handler/http 2> /dev/null) || browser=""
  fi

  _out="$browser"
}

# Derive a Chromium user-data directory name from a URL. The normalized host
# is a sharing key, so distinct URLs on one host can resolve to the same
# directory; path, port, query, and fragment distinctions are dropped.
# The directory is stored under $XDG_DATA_HOME/webapps/<name>, separate from
# the main browser data directory.
# Example: https://app.example.com/path -> app-example-com
_profile_dir_from_url() {
  local -n _pdu_out="$1"
  local url="$2"
  local host="${url#*://}"
  host="${host%%[/?#:]*}"
  host="${host,,}"
  host="${host//\./-}"
  _pdu_out="$host"
}

focus_or_launch() {
  local -a cmd=("$@")

  log Info "Focus or launch webapp: URL=$URL host=$host own_profile=$OWN_PROFILE"

  # Extract the hostname from the URL global for window matching.
  # Strip the scheme (e.g. "https://"), then strip any path, port,
  # query string, or fragment that follows the host.
  local host="${URL#*://}"
  host="${host%%[/?#:]*}"
  host="${host,,}"

  # Chrome PWA window classes begin with `chrome-` followed by the encoded
  # hostname and a profile suffix. A raw startswith match can also accept a
  # longer hostname that shares this prefix; --own-profile uses the same class
  # shape with a separate data root.
  # jq `try` only suppresses errors raised while evaluating the expression; it
  # neither repairs malformed input JSON nor filters a null .address.
  local window_address
  window_address="$(
    hyprctl -j clients | jq -r --arg host "$host" '
      try first(
        .[]
        | (.class        // "" | ascii_downcase) as $c
        | (.initialClass // "" | ascii_downcase) as $ic
        | select(
            ($c  | startswith("chrome-\($host)")) or
            ($ic | startswith("chrome-\($host)"))
          )
        | .address
      )
    ' 2> /dev/null
  )"

  if [[ -n "$window_address" ]]; then
    log Info "Focusing existing PWA window: address=$window_address"
    hyprctl -q dispatch "hl.dsp.focus({window = 'address:${window_address}'})"
  else
    log Info "No matching PWA window, launching: ${cmd[*]}"
    exec setsid -f app2unit -- "${cmd[@]}"
  fi
}

# Argument parsing

OWN_PROFILE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --own-profile)
      OWN_PROFILE=true
      shift
      ;;
    --)
      shift
      break
      ;;
    --* | -*)
      log Error "unknown option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
    *)
      # First non-flag argument is the URL; stop parsing options.
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  log Error "missing URL"
  log Error "Try --help for more information"
  exit 1
fi

source vb-lib-core

URL="$1"

get_default_browser browser

# This selects a supported desktop-entry family; the actual Exec token is
# resolved from matching .desktop files below.
case $browser in
  google-chrome* | brave-browser* | microsoft-edge* | opera* | vivaldi* | helium*) ;;
  *)
    browser="chromium.desktop"
    ;;
esac

execs=()

for dir in ~/.local/share/applications ~/.nix-profile/share/applications /usr/share/applications; do
  if [[ ! -d $dir ]]; then
    continue
  fi

  for f in "$dir"/$browser; do
    if [[ ! -f $f ]]; then
      continue
    fi

    while IFS= read -r line; do
      if [[ ! $line == Exec=* ]]; then
        continue
      fi
      line=${line#Exec=}
      # Only the first Exec token is retained; desktop-entry arguments and
      # field codes are not interpreted by this wrapper.
      execs+=("${line%% *}")
    done < "$f"
  done
done

# Fallback if nothing found
# The first collected token is used without local validation; the no-entry
# fallback is the literal name `chromium`.
if ! ((${#execs[@]})); then
  execs=("chromium")
fi

# An own-profile launch uses a separate Chromium user-data directory under
# this root. The normalized host key can be shared by distinct same-host URLs;
# isolation is per data-directory key, not a guarantee of one directory per
# URL. A separate data dir remains outside the main browser's profile picker.
WEBAPP_DATA_DIR="$XDG_DATA_HOME/webapps"

# Passing the URL through --app requests browser app-mode metadata, which is
# the identity used by the PWA window matcher.
browser_cmd=("${execs[0]}" --app="$URL")
if [[ $OWN_PROFILE == true ]]; then
  profile_dir=""
  _profile_dir_from_url profile_dir "$URL"
  log Info "Own profile enabled, data dir: $WEBAPP_DATA_DIR/$profile_dir"
  browser_cmd+=(--user-data-dir="$WEBAPP_DATA_DIR/$profile_dir")
fi

log Info "Browser command: ${browser_cmd[*]}"
# The focus preference comes from the shared settings projection; when it is
# disabled, the direct branch skips compositor lookup and starts a new app.
if [[ "$APP_LAUNCHER_ALWAYS_FOCUS" == true ]]; then
  focus_or_launch "${browser_cmd[@]}"
else
  log Info "Always-focus disabled, launching directly"
  # setsid detaches app2unit from the terminal session, but inherited stdio
  # remains attached unless the command itself redirects it.
  exec setsid -f app2unit -- "${browser_cmd[@]}"
fi
