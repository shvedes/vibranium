#!/bin/bash

# Overcomplicated script that manages brightness control using raw sysfs values
# as well as the DDC protocol for external monitors. The script uses a single state file
# (lines in the "i2c:output:level" format) to cache active values for both methods
# to speed up subsequent script executions.
# This is ESPECIALLY useful for the DDC method, because ddcutil is known to be quite slow.
# Thanks to the state file, changing brightness with DDC takes milliseconds instead of 500-700-1000ms.
#
# The script can accept parameters such as up | down for relative brightness adjustment with dynamic steps using Vibranium settings,
# as well as absolute values such as 20, 50, 100, etc.
# Gamma dimming (via hyprsunset) extends the effective range below 0% when
# the hardware backlight is already at its minimum.

# CHASSIS_TYPE is set early in the session based on
# systemd-detect-virt --chassis; skip brightness control entirely
# when running inside a VM because neither sysfs backlight nor DDC
# passthrough are guaranteed to work.
if [[ "$CHASSIS_TYPE" == "vm" ]]; then
  notify-send -r 4 "Vibranium - Brightness" -u critical -t 5000 \
    "Brightness control is not available inside of a Virtual Machine"
  exit 1
fi

SELF="${0##*/}"
QUIET=false
FORCE=false
VERBOSE=false
LOCKFILE="$VIBRANIUM_RUNTIME/$SELF.lock"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

log() {
  local level="$1"; shift
  if [[ $level == "Error" ]] || ($VERBOSE && [[ -t 0 ]]); then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

usage() {
  shcat <<EOF
Usage: $SELF [OPTIONS]

Adjust screen brightness.

Options:
    --up              Increase brightness
    --down            Decrease brightness
    --set             Set brightness to <0-100>%
    -f, --force       Bypass state file, work directly with ddcutil
    -q, --quiet       Do not display notification or OSD
    -v, --verbose     Enable verbose output
    -h, --help        Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    usage
    exit 0
    ;;
  --up | --down)
    ACTION="$1"
    shift
    ;;
  --set)
    # --set requires a following integer in the range 0-100
    if [[ ! "$2" =~ ^[0-9]+$ ]] || (($2 < 0 || $2 > 100)); then
      log Error "--set requires an integer between 0 and 100"
      exit 1
    fi
    ACTION="$1"
    SET_VALUE="$2"
    shift 2
    ;;
  -f | --force)
    FORCE=true
    shift
    ;;
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -q | --quiet)
    QUIET=true
    shift
    ;;
  *)
    log Error "unknown option: $*"
    log Error "Try '$SELF --help' for more information"
    exit 1
    ;;
  esac
done

# No action flag was provided — print usage and exit cleanly
if [[ -z "$ACTION" ]]; then
  usage
  exit 0
fi

# Open the lockfile on fd 9 and acquire a non-blocking exclusive lock.
# flock -n returns nonzero when another instance holds the lock, so we
# exit silently — the running instance will handle the request.
exec 9>"$LOCKFILE" || {
  log Error "another instance of $SELF is already running!"
  exit 1
}
flock -n 9 || exit 0

source vb-lib-core

helpers::check \
  VIBRANIUM_GLOBAL_USE_OSD \
  VIBRANIUM_BRIGHTNESS_STEP \
  VIBRANIUM_BRIGHTNESS_NOTIFY

# One line per monitor in the format:
#   i2c:output:level
# where any field may be empty when not yet known (e.g. the level before the
# first DDC read). The "output" (monitor name) is the key. Both the i2c bus
# discovery and the brightness cache read/write through these helpers so that
# updating one field never clobbers the other.
STATE_FILE="$VIBRANIUM_STATE/monitors"

# Load the unified state into the bus_map / level_map associative arrays.
# Caller must declare them. Returns nothing useful; just populates the maps.
load_state() {
  local i2c output level gamma
  [[ -f "$STATE_FILE" ]] || return 0

  # Parse each line of the state file ("i2c:output:level:gamma"), splitting on
  # colons. Lines without an output name are considered corrupted and skipped.
  # The optional 4th field (gamma) is read but not used here — it is queried
  # separately by load_gamma().
  while IFS=: read -r i2c output level gamma; do
    [[ -n "$output" ]] || continue
    bus_map["$output"]="$i2c"
    level_map["$output"]="$level"
  done <"$STATE_FILE"
}

# Write the bus_map / level_map associative arrays back to the unified state
# file. The file is tiny, so we build the whole content in a single string and
# write it with one redirection. Caller must have the maps declared and populated.
save_state() {
  local output content="" current_gamma=100

  # Preserve the existing gamma from the state file (defaulting to 100 when
  # the file is missing or all lines use the old 3-field format).
  while IFS=: read -r _ _ _ current_gamma; do
    [[ "$current_gamma" =~ ^[0-9]+$ ]] && ((current_gamma >= GAMMA_MIN && current_gamma <= 100)) && break
    current_gamma=100
  done <"$STATE_FILE" 2>/dev/null

  # Every known output lives in level_map after a load_state (even bus-only
  # entries get an empty level), so iterating it covers all keys. Outputs that
  # somehow exist only in bus_map are picked up by the second pass.
  for output in "${!bus_map[@]}"; do
    content+="${bus_map[$output]}:$output:${level_map[$output]}:$current_gamma"$'\n'
  done

  for output in "${!level_map[@]}"; do
    [[ -n "${bus_map[$output]+x}" ]] && continue
    content+=":$output:${level_map[$output]}:$current_gamma"$'\n'
  done

  printf '%s' "$content" >"$STATE_FILE"
}

# Gamma dimming. 10-100 where 100 = normal, stored as a 4th colon-separated
# field on every monitor entry in the state file (i2c:output:level:gamma).
# Writing all lines keeps gamma in sync across monitors since it is a global
# GPU property applied via hyprsunset, not per-output.
GAMMA_MIN=10

# Read gamma from the first monitor line that has a 4th field.  Defaults to
# 100 when the file is missing or all lines use the old 3-field format.
load_gamma() {
  local gamma=""
  [[ -f "$STATE_FILE" ]] || { echo 100; return; }
  while IFS=: read -r _ _ _ gamma; do
    [[ "$gamma" =~ ^[0-9]+$ ]] && ((gamma >= GAMMA_MIN && gamma <= 100)) && { echo "$gamma"; return; }
  done <"$STATE_FILE"
  echo 100
}

# Rewrite every line of the monitors file with the new gamma value.  When
# the file does not exist (e.g. raw sysfs path that never runs DDC), create
# a sentinel entry so gamma persists across script invocations.  The sentinel
# format (::level:gamma) is invisible to load_state() which skips blank
# output fields, but load_gamma() reads the 4th field from any line.
save_gamma() {
  local new_gamma="$1" content="" i2c output level gamma

  if [[ ! -f "$STATE_FILE" ]]; then
    printf '::0:%d\n' "$new_gamma" >"$STATE_FILE"
    return
  fi

  while IFS=: read -r i2c output level gamma; do
    content+="$i2c:$output:$level:$new_gamma"$'\n'
  done <"$STATE_FILE"
  printf '%s' "$content" >"$STATE_FILE"
}

apply_gamma() {
  hyprctl -q hyprsunset gamma "$1"
}

# Detect monitors via DDC and merge their i2c buses into the unified state,
# preserving any cached brightness levels.
get_i2c_bus() {
  declare -A bus_map level_map
  local new_info output bus

  # Parse ddcutil detect output (expected format):
  #   DRM_connector: card1-eDP-1   -> skip (internal laptop panel)
  #   DRM_connector: card1-DP-3    -> name becomes "DP-3"
  #   I2C bus: /dev/i2c-6          -> bus becomes "6"
  #   VCP version: ...             -> emit "DP-3:6"
  # The awk state machine tracks skip across multi-line connector blocks.
  new_info="$(ddcutil detect 2>/dev/null | awk '
        /I2C bus:/ {
            bus=$NF
            sub("/dev/i2c-", "", bus)
        }
        /DRM_connector:/ {
            skip=0
            name=$2
            if (name ~ /^card[0-9]+-eDP/) skip=1
            sub(/^card[0-9]+-/, "", name)
        }
        /This is a laptop/ { skip=1 }
        /VCP version/ && !skip { print name ":" bus }
    ')"

  # Load existing cache so levels (and other buses) survive the rewrite
  load_state

  # Merge newly detected buses (overrides cached bus entries only)
  while IFS=: read -r output bus; do
    if [[ -n "$output" && -n "$bus" ]]; then
      bus_map["$output"]="$bus"
    fi
  done <<<"$new_info"

  save_state
}

ensure_i2c_cache() {
  declare -A bus_map level_map
  load_state

  [[ -n "${bus_map[$ACTIVE_MONITOR]:-}" ]]
}

set_i2c_bus() {
  local -n _result="$1"
  declare -A bus_map level_map

  # With --force, skip the state file cache entirely and always run a
  # fresh ddcutil detect. Otherwise use the cached bus if available.
  if [[ $FORCE == true ]]; then
    get_i2c_bus
  elif ! ensure_i2c_cache; then
    log Info "I2C bus cache for the active monitor not found, running detect"
    get_i2c_bus
  fi

  load_state
  _result="${bus_map[$ACTIVE_MONITOR]}"
}

get_brightness_cache() {
  local -n _result="$1"

  # With --force, bypass the state file and return empty to force a fresh
  # ddcutil read.
  if [[ $FORCE == true ]]; then
    return 0
  fi

  declare -A bus_map level_map
  load_state

  # If no entry for the active monitor, return empty to trigger a fresh fetch
  _result="${level_map[$ACTIVE_MONITOR]:-}"
}

update_brightness_cache() {
  local new_value="$1"
  declare -A bus_map level_map

  load_state

  # Update the brightness for the active monitor, leaving its i2c bus intact
  level_map["$ACTIVE_MONITOR"]="$new_value"

  save_state
}

osd() {
  local value="$1"
  local icon progress

  # Set specific icons depending on the current brightness level (icons are taken from the active icon pack)
  if ((value <= 30)); then
    icon="brightness-low-symbolic"
  elif ((value <= 70)); then
    icon="brightness-symbolic"
  else
    icon="brightness-high-symbolic"
  fi

  # Integer-only approximation:
  # We scale everything by 100 to avoid floating point.
  # Target formula: 0.02 + value * 0.0098
  # Multiply by 100 -> 2 + value * 0.98
  # Then approximate 0.98 as 98/100 (integer division will truncate).
  local p
  p=$((2 + value * 98 / 100))

  # p is now in range:
  # value=0   -> p=2   (represents 0.02)
  # value=100 -> p=100 (represents 1.00)

  # Handle the upper bound explicitly:
  # Without this, p=100 would be formatted as "0.100" instead of "1.00"
  if ((p == 100)); then
    printf -v progress "1.00"
  else
    # Format as fixed-point:
    # "0.%02d" -> always 2 digits after decimal (e.g. 2 -> 0.02, 37 -> 0.37)
    printf -v progress "0.%02d" "$p"
  fi

  # I can't imagine a situation where this service would be turned off,
  # but let it be here just in case
  if ! systemctl -q --user is-active swayosd; then
    log Info "Activating swayosd.service"
    systemctl --user enable --now swayosd.service
  fi

  swayosd-client --custom-icon="$icon" --custom-progress="$progress"
}

# Fetch monitors and active window in one hyprctl batch call, then extract
# the focused monitor name, total monitor count, and fullscreen state via jq.
# @tsv emits tab-separated values so the three fields can be read with IFS=$'\t'.
HYPRLAND_DATA="$(hyprctl -j --batch 'monitors; activewindow' 2>/dev/null)"

IFS=$'\t' read -r ACTIVE_MONITOR MONITOR_COUNT FULLSCREEN_STATE < <(
  jq -rs '[
    (.[0][] | select(.focused) | .name),
    (.[0] | length | tostring),
    (.[1].fullscreen | tostring)
  ] | @tsv' <<<"$HYPRLAND_DATA"
)

log Info "Active monitor: $ACTIVE_MONITOR"

if [[ -z "$ACTIVE_MONITOR" ]]; then
  notify-send -r 1 -t 3000 -u critical "Vibranium - Brightness" "Cannot get the active monitor!"
  exit 1
fi

# Decide between DDC (external monitors) and raw sysfs (internal laptop panel).
# The heuristics:
#   1. No /sys/class/backlight/ device -> no built-in panel -> must use DDC.
#   2. /sys/class/backlight/ exists but the focused monitor name does not
#      start with eDP -> external monitor on a laptop with a closed lid -> DDC.
#   3. Otherwise -> raw sysfs access to the built-in backlight.
if ! compgen -G "/sys/class/backlight/*" >/dev/null; then
  if ! command -v ddcutil >/dev/null; then
    vb-cmd-dep-notify --name "Brightness Control" --deps ddcutil
    exit 1
  fi

  method="ddc"
  set_i2c_bus I2C_BUS
  log Info "Using DDC method, I2C bus: $I2C_BUS"

  # TODO: As far as I know, optimal values for --sleep-multiplier can vary from a monitor to a monitor,
  # and while it works well on one monitor, it may not work at all on another.
  # In this case, we need to create a mini-algorithm that will calculate and record valid values for the monitor and use them.
  ddcutil_flags=(--sleep-multiplier 0.13 --noverify --skip-ddc-checks --maxtries 1,1,1)
else
  if [[ -n "$ACTIVE_MONITOR" && ! "$ACTIVE_MONITOR" =~ ^eDP ]]; then
    method="ddc"
    set_i2c_bus I2C_BUS
  else
    method="raw"
    log Info "Using raw sysfs method"
  fi
fi

if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
  if ! command -v swayosd-client >/dev/null; then
    vb-cmd-dep-notify --name "Brightness Control" --deps swayosd
    exit 1
  fi
fi

step=$VIBRANIUM_BRIGHTNESS_STEP
log Info "Action: $ACTION, method: $method, step: $step"

# Load current gamma state before entering method-specific dispatch.  The
# same (action, step, current-brightness) tuple determines whether we adjust
# hardware backlight or hyprsunset gamma.
GAMMA=$(load_gamma)

case "$method" in
"ddc")
  get_brightness_cache current
  if [[ ! $current =~ ^[0-9]+$ ]]; then
    # --sleep-multiplier 0.13 is aggressive and some monitors need a few
    # tries before they respond on the I2C bus. Retry up to 5 times to
    # work around transient DDC NACKs; the loop exits early once a valid
    # value (0-100) is obtained.
    for ((i = 0; i < 5; i++)); do
      line_output=$(ddcutil --bus "$I2C_BUS" "${ddcutil_flags[@]}" getvcp 10 2>/dev/null)
      # Match the current brightness value in ddcutil output format:
      #   VCP code 0x10 (...): current value =   25, max value =   100
      # The value follows "current value =" with variable whitespace.
      if [[ "$line_output" =~ current\ value\ =\ +([0-9]+) ]]; then
        current="${BASH_REMATCH[1]}"
      fi
      if [[ $current =~ ^[0-9]+$ ]] && ((current >= 0 && current <= 100)); then
        break
      fi
    done
    [[ $FORCE == false ]] && log Warn "cache not found!"
    # No need to persist "$current" here: the final value ("$new") is written
    # below, and doing both would race two background writers on the same file.
  fi

  case "$ACTION" in
  "--up")
    if ((GAMMA < 100)); then
      new_gamma=$((GAMMA + step))
      ((new_gamma > 100)) && new_gamma=100
      apply_gamma "$new_gamma"
      save_gamma "$new_gamma"
      GAMMA=$new_gamma
      log Info "Gamma raised to $GAMMA (brightness unchanged at $current)"
      if ((GAMMA == 100)); then
        new=$current
      fi
    else
      ((current == 100)) && exit 0
      new=$((current + step))
      ((new > 100)) && new=100
    fi
    ;;
  "--down")
    if ((current == 0 && GAMMA > GAMMA_MIN)); then
      new_gamma=$((GAMMA - step))
      ((new_gamma < GAMMA_MIN)) && new_gamma=$GAMMA_MIN
      apply_gamma "$new_gamma"
      save_gamma "$new_gamma"
      GAMMA=$new_gamma
      log Info "Gamma lowered to $GAMMA (brightness at minimum)"
    else
      ((current == 0)) && exit 0
      new=$((current - step))
      ((new < 0)) && new=0
    fi
    ;;
  "--set")
    # Absolute set resets gamma to normal to keep the result predictable.
    if ((GAMMA != 100)); then
      apply_gamma 100
      save_gamma 100
      GAMMA=100
      log Info "Gamma reset to 100"
    fi
    new=$SET_VALUE
    ;;
  esac

  if [[ -n "$new" ]]; then
    log Info "Setting brightness to $new (current: $current)"
    ddcutil --bus "$I2C_BUS" "${ddcutil_flags[@]}" setvcp 10 "$new" &>/dev/null &
    update_brightness_cache "$new" &
  fi

  if [[ "$VIBRANIUM_BRIGHTNESS_NOTIFY" == false ]]; then
    exit 0
  fi

  if ((GAMMA < 100)); then
    # Gamma dimming active — swayosd OSD only covers 0-100, so use
    # notify-send with the effective "below zero" caption.
    if ((FULLSCREEN_STATE == 2)); then
      exit 0
    fi
    if [[ "$QUIET" == false ]]; then
      dim_bar=$(( (GAMMA - GAMMA_MIN) * 100 / (100 - GAMMA_MIN) ))
      notify-send -r 2 -t 1000 "Brightness -$((100 - GAMMA))%" -h int:value:"$dim_bar"
    fi
  elif [[ -n "$new" ]]; then
    if [[ $VIBRANIUM_GLOBAL_USE_OSD == true && $QUIET == false ]]; then
      osd "$new" &
    else
      if ((MONITOR_COUNT > 1)); then
        source="($ACTIVE_MONITOR) "
      fi

      # Suppress the notification when the active window is fullscreen.
      # Dunst queues notifications during fullscreen and shows them only
      # after exiting fullscreen, which makes them stale and irrelevant.
      #
      # We don't apply this rule to OSD notifications because
      # it defeats the purpose of OSDs
      if ((FULLSCREEN_STATE == 2)); then
        exit 0
      fi

      if [[ "$QUIET" == false ]]; then
        notify-send -r 2 -t 1000 "Brightness $source${new}%" -h int:value:"$new"
      fi
    fi
  fi
  ;;
"raw")
  # swayosd delegation is only safe when gamma is at normal (100) because
  # swayosd-client --brightness only understands 0-100 and would conflict
  # with gamma-based dimming below that range.
  if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true && "$VIBRANIUM_BRIGHTNESS_NOTIFY" != "false" && "$QUIET" == false && "$GAMMA" == "100" ]]; then
    # Translate action into swayosd's (±)number / absolute syntax:
    #   --up   -> +<step>   e.g. +5
    #   --down -> -<step>   e.g. -5
    #   --set  -> <value>   e.g. 60  (swayosd treats bare integers as absolute)
    case "$ACTION" in
    "--up")
      swayosd_arg="+${step}"
      ;;
    "--down")
      swayosd_arg="-${step}"
      ;;
    "--set")
      swayosd_arg="$SET_VALUE"
      ;;
    esac

    if [[ "$QUIET" == false ]]; then
      swayosd-client --brightness="$swayosd_arg"
    fi
  else
    # Read current and max brightness from the kernel
    current_raw=$(</sys/class/backlight/*/brightness)
    max_raw=$(</sys/class/backlight/*/max_brightness)
    current=$((current_raw * 100 / max_raw))

    case "$ACTION" in
    "--up")
      if ((GAMMA < 100)); then
        new_gamma=$((GAMMA + step))
        ((new_gamma > 100)) && new_gamma=100
        apply_gamma "$new_gamma"
        save_gamma "$new_gamma"
        GAMMA=$new_gamma
        log Info "Gamma raised to $GAMMA (brightness unchanged at $current)"
        if ((GAMMA == 100)); then
          new_pct=$current
          new_raw=$(((new_pct * max_raw + 99) / 100))
        fi
      else
        new_pct=$((current + step))
        ((new_pct > 100)) && new_pct=100
        new_raw=$(((new_pct * max_raw + 99) / 100))
      fi
      ;;
    "--down")
      if ((current == 0 && GAMMA > GAMMA_MIN)); then
        # Hardware at minimum; transition to gamma dimming.
        new_gamma=$((GAMMA - step))
        ((new_gamma < GAMMA_MIN)) && new_gamma=$GAMMA_MIN
        apply_gamma "$new_gamma"
        save_gamma "$new_gamma"
        GAMMA=$new_gamma
        log Info "Gamma lowered to $GAMMA (brightness at minimum)"
      else
        new_pct=$((current - step))
        ((new_pct < 0)) && new_pct=0
        new_raw=$(((new_pct * max_raw + 99) / 100))
      fi
      ;;
    "--set")
      if ((GAMMA != 100)); then
        apply_gamma 100
        save_gamma 100
        GAMMA=100
        log Info "Gamma reset to 100"
      fi
      new_pct=$SET_VALUE
      new_raw=$(((new_pct * max_raw + 99) / 100))
      ;;
    esac

    if [[ -n "${new_raw+x}" ]]; then
      # Clamp raw value
      ((new_raw > max_raw)) && new_raw=$max_raw
      ((new_raw < 0)) && new_raw=0

      new=$((new_raw * 100 / max_raw))

      echo "$new_raw" >/sys/class/backlight/*/brightness
    fi

    if [[ "$VIBRANIUM_BRIGHTNESS_NOTIFY" == "false" ]]; then
      exit 0
    fi

    if ((GAMMA < 100)); then
      if [[ "$QUIET" == false ]]; then
        dim_bar=$(( (GAMMA - GAMMA_MIN) * 100 / (100 - GAMMA_MIN) ))
        notify-send -r 1 -t 1000 "Brightness -$((100 - GAMMA))%" -h int:value:"$dim_bar"
      fi
    elif [[ -n "${new_raw+x}" ]]; then
      if [[ "$QUIET" == false ]]; then
        notify-send -r 1 -t 1000 "Brightness ${new}%" -h int:value:"$new"
      fi
    fi
  fi
  ;;
esac
