#!/bin/bash

source vb-lib-cli

if [[ "$CHASSIS_TYPE" == "vm" ]]; then
	notify-send -r 4 -a "Vibranium" "Vibranium - Brightness" -u critical -t 5000 \
		"Brightness control is not available inside of a Virtual Machine"
	exit 1
fi

SELF="${0##*/}"
QUIET=false
FORCE=false
VERBOSE=${VERBOSE:-false}
MONITOR_ARG=""
ORIGINAL_ARGS=("$@")
LOCKFILE="$VIBRANIUM_RUNTIME/$SELF.lock"

usage() {
	shcat << EOF
Usage: $SELF [OPTIONS]

Adjust screen brightness.

Options:
    --up              Increase brightness
    --down            Decrease brightness
    --set             Set brightness to <-90-100>%
    --calibrate       Re-calibrate DDC timeouts for external monitors
    --monitor         Target one or more monitors (comma-separated: HDMI-A-1,eDP-1)
    -f, --force       Bypass state file, work directly with ddcutil
    -q, --quiet       Do not display notification
    -v, --verbose     Enable verbose output
    -h, --help        Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		-h | --help)
			usage
			exit 0
			;;
		--calibrate)
			if [[ -n "$ACTION" ]]; then
				log Error "--calibrate cannot be combined with other actions"
				exit 1
			fi
			ACTION="--calibrate"
			shift
			;;
		--up | --down)
			if [[ -n "$ACTION" ]]; then
				log Error "mutually exclusive actions: $ACTION and $1"
				exit 1
			fi
			ACTION="$1"
			shift
			;;
		--set)
			if [[ -n "$ACTION" ]]; then
				log Error "mutually exclusive actions: $ACTION and --set"
				exit 1
			fi
			# Strip optional trailing "%" before validation.
			SET_VALUE="${2%\%}"
			# --set requires an integer in the range -90..100.
			# Negative values map to hardware minimum + gamma dimming.
			if [[ ! "$SET_VALUE" =~ ^-?[0-9]+$ ]] || ((SET_VALUE < -90 || SET_VALUE > 100)); then
				log Error "--set requires an integer between -90 and 100"
				exit 1
			fi
			ACTION="$1"
			shift 2
			;;
		--monitor)
			if [[ -z "${2:-}" ]]; then
				log Error "--monitor requires a monitor name"
				exit 1
			fi
			MONITOR_ARG="$2"
			shift 2
			;;
		-f | --force)
			FORCE=true
			shift
			;;
		-v | --verbose)
			export VERBOSE=true
			shift
			;;
		-q | --quiet)
			QUIET=true
			shift
			;;
		*)
			log Error "unknown option: $*"
			log Error "Try '$SELF --help' for more information"
			exit 1
			;;
	esac
done

if [[ -z "$ACTION" ]]; then
	log Info "No action specified, showing usage"
	usage
	exit 0
fi

# Fan-out runs at a point where this script has not opened fd 9. Each
# recursive invocation then opens and locks its own descriptor for one target.
# Dispatch comma-separated monitors to per-monitor invocations.
# Each sub-call inherits all other flags but targets a single monitor.
if [[ -n "$MONITOR_ARG" && "$MONITOR_ARG" == *,* ]]; then
	IFS=, read -ra MONITORS <<< "$MONITOR_ARG"
	BASE_ARGS=()
	skip_next=false
	for arg in "${ORIGINAL_ARGS[@]}"; do
		if $skip_next; then
			skip_next=false
			continue
		fi
		if [[ "$arg" == --monitor ]]; then
			skip_next=true
			continue
		fi
		BASE_ARGS+=("$arg")
	done
	log Info "Dispatching to ${#MONITORS[@]} monitors: ${MONITORS[*]}"
	for mon in "${MONITORS[@]}"; do
		mon="${mon//[[:space:]]/}"
		[[ -z "$mon" ]] && continue
		"$0" "${BASE_ARGS[@]}" --monitor "$mon"
	done
	exit 0
fi

# Open the lockfile on fd 9 and use a non-blocking exclusive lock. A failed
# open reports an error; a failed flock exits without queueing or forwarding.
exec 9> "$LOCKFILE" || {
	log Error "another instance of $SELF is already running!"
	exit 1
}
flock -n 9 || exit 0
log Info "Lock acquired ($LOCKFILE)"

source vb-lib-core

log Info "Config: step=$BRIGHTNESS_STEP, notify=$BRIGHTNESS_NOTIFY"

# These maps hold the current state snapshot; helpers may reload or rewrite
# the state file when bus discovery or persistence requires it.
declare -A bus_map=() level_map=() mult_map=()
GAMMA=100

# One line per monitor in the format:
#   output:i2c:level:gamma:mult
# where any field may be empty when not yet known (e.g. the level before the
# first DDC read). The "output" (monitor name) is the key. Both the i2c bus
# discovery and the brightness cache read/write through these helpers so that
# updating one field never clobbers the other. The first line is a comment
# ("#output:i2c:level:gamma:mult") that also acts as a format version marker.
STATE_FILE="$VIBRANIUM_STATE/monitors"
STATE_HEADER="# output:i2c:level:gamma:mult"

# Load the unified state into the global bus_map / level_map / mult_map / GAMMA.
# The maps are declared globally once; this function resets and repopulates them.
# Each call is a full file read, so callers minimise invocations.
load_state() {
	local _gamma_seen _first_line
	[[ -f "$STATE_FILE" ]] || return 0

	# Only the first line is checked against the format header. A mismatch
	# discards the file; when it matches, later lines enter the field loop.
	read -r _first_line < "$STATE_FILE"
	if [[ "$_first_line" != "$STATE_HEADER" ]]; then
		log Warn "State file is invalid. Removing."
		rm -f "$STATE_FILE"
		return 0
	fi

	bus_map=()
	level_map=()
	mult_map=()
	GAMMA=100

	log Info "Loading $STATE_FILE"

	# Bash read assigns missing trailing fields as empty strings, which keeps
	# gamma-only sentinels and monitor rows on the same five-field parser.
	while IFS=: read -r output i2c level gamma mult; do
		# Ignore header comment ($STATE_HEADER)
		[[ "$output" == \#* ]] && continue

		# Monitor data line (non-empty output) populates the maps.
		if [[ -n "$output" ]]; then
			bus_map["$output"]="$i2c"
			level_map["$output"]="$level"

			if [[ -n "$mult" && "$mult" =~ ^[0-9]+$ ]]; then
				if ((mult >= MULT_HUNDREDTHS_MIN && mult <= MULT_HUNDREDTHS_MAX)); then
					mult_map["$output"]=$mult
				fi
			fi
		fi

		# Sentinel lines (empty output) carry gamma-only state for raw method.
		if [[ -z "${_gamma_seen+x}" && "$gamma" =~ ^[0-9]+$ ]]; then
			if ((gamma >= GAMMA_MIN && gamma <= 100)); then
				GAMMA=$gamma
				_gamma_seen=true
			fi
		fi
	done < "$STATE_FILE"
}

# Write the global bus_map / level_map / mult_map / GAMMA back to the state
# file. The in-memory globals are authoritative, so save_state does not re-read
# the file before writing.
# When no monitor entries exist (raw-only session) a sentinel line preserves
# GAMMA so dimming state survives across invocations.
save_state() {
	local content="$STATE_HEADER"$'\n'

	if ((${#bus_map[@]} == 0 && ${#level_map[@]} == 0)); then
		content+=":::$GAMMA"$'\n'
	else
		for output in "${!bus_map[@]}"; do
			_write_mon content "$output" "${bus_map[$output]}" \
				"${level_map[$output]}" "$GAMMA" "${mult_map[$output]}"
		done

		for output in "${!level_map[@]}"; do
			[[ -n "${bus_map[$output]+x}" ]] && continue
			_write_mon content "$output" "" "${level_map[$output]}" \
				"$GAMMA" "${mult_map[$output]}"
		done
	fi

	printf '%s' "$content" > "$STATE_FILE"
	log Info "State saved: $((${#bus_map[@]})) monitor(s), gamma=$GAMMA"
}

# Append one monitor line to $content.  Omits trailing colon when last
# field is empty so the file never accumulates ":<empty>" cruft.
_write_mon() {
	local -n _c="$1"
	local out="$2" i2c="$3" lvl="$4" gam="$5" mlt="$6"
	if [[ -n "$mlt" ]]; then
		_c+="$out:$i2c:$lvl:$gam:$mlt"$'\n'
	else
		_c+="$out:$i2c:$lvl:$gam"$'\n'
	fi
}

# Gamma dimming. 10-100 where 100 = normal, stored as a 4th colon-separated
# field on every monitor entry in the state file (output:i2c:level:gamma).
# Writing all lines keeps gamma in sync across monitors since it is a global
# GPU property applied via hyprsunset, not per-output.
GAMMA_MIN=10

# Update gamma in the global GAMMA and persist.  save_state writes every line
# with the new gamma, so a missing file is handled automatically - the first
# call to save_state creates it with the then-known monitors.
save_gamma() {
	GAMMA="$1"
	save_state
}

apply_gamma() {
	log Info "Apply gamma: $1"
	hyprctl -q hyprsunset gamma "$1"
}

# Internal representation: integer hundredths (MULT_HUNDREDTHS = 30 means 0.30).
# State file stores this as a 5th colon-separated field: output:i2c:level:gamma:mult_hundredths
MULT_HUNDREDTHS_MIN=10
MULT_HUNDREDTHS_MAX=50
MULT_HUNDREDTHS_DEFAULT=13

# Format hundredths as a float string for ddcutil --sleep-multiplier
# e.g. 30 -> "0.30", 5 -> "0.05".
_mult_float() {
	local -n _out=$1
	printf -v _out "0.%02d" "$2"
}

# Load multiplier hundredths for the active monitor from the global mult_map.
# Defaults to MULT_HUNDREDTHS_DEFAULT when missing or pre-calibration entry.
# Sets MULT_CACHED to true when a per-monitor entry was found.
load_mult() {
	local -n _out="$1"
	local cached="${mult_map[$ACTIVE_MONITOR]:-}"
	if [[ -n "$cached" ]]; then
		_out=$cached
		MULT_CACHED=true
	else
		_out=$MULT_HUNDREDTHS_DEFAULT
		MULT_CACHED=false
	fi
	log Info "Multiplier for $ACTIVE_MONITOR: $_out (hundredths, cached=$MULT_CACHED)"
}

# Update sleep-multiplier for the active monitor in the global mult_map and
# persist.  save_state writes every line, so the active monitor entry gets
# the new value while others are preserved as-is.
save_mult() {
	log Info "Save multiplier for $ACTIVE_MONITOR: $1 (hundredths)"
	mult_map[$ACTIVE_MONITOR]=$1
	save_state
}

# Test whether a given multiplier (in hundredths) renders ddcutil responsive.
# Runs a single getvcp 10 probe and checks for a valid brightness value.
# The probe treats a parseable numeric current value as success, regardless of
# ddcutil's exit status; the 0-100 check belongs to the later brightness read.
_probe_mult() {
	local candidate="$1" output mf
	_mult_float mf "$candidate"
	log Info "Probe multiplier $candidate ($mf) on bus $I2C_BUS"
	output=""
	IFS= read -r -d '' output < <(
		ddcutil --bus "$I2C_BUS" --sleep-multiplier "$mf" --noverify --skip-ddc-checks --maxtries 1,1,1 getvcp 10 2> /dev/null
	) || true
	[[ "$output" =~ current\ value\ =\ +([0-9]+) ]]
}

# Load sleep-multiplier for the current monitor.  Uses the cached value from
# the state file when available - skips the expensive ddcutil probe entirely.
# When FORCE is set or no cached entry exists, probes and calibrates from
# scratch, then persists the result for subsequent invocations.
calibrate_sleep_mult() {
	local mult try

	if [[ $FORCE == true ]]; then
		mult=$MULT_HUNDREDTHS_DEFAULT
		MULT_CACHED=false
	else
		load_mult mult
	fi

	# The upward scan stops at the first responsive candidate. If none responds,
	# the starting multiplier is retained and persisted; this is a bounded probe,
	# not a global optimization.
	if [[ $MULT_CACHED == false ]]; then
		# No cached value (or FORCE) - probe to discover a working multiplier
		if ! _probe_mult "$mult"; then
			# Current multiplier fails - probe upward to find a working floor
			try=$mult
			while ((try < MULT_HUNDREDTHS_MAX)); do
				try=$((try + 5))
				if ((try > MULT_HUNDREDTHS_MAX)); then
					try=$MULT_HUNDREDTHS_MAX
				fi
				if _probe_mult "$try"; then
					mult=$try
					break
				fi
			done

			save_mult "$mult"
		else
			# Persist the working multiplier so later invocations can use the cached
			# value and skip the probe.
			save_mult "$mult"
		fi

		if [[ $ACTION != "--calibrate" ]]; then
			notify-send -r 5 -a "Vibranium" -t 15000 "Brightness - Calibration" \
				"DDC timeouts calibrated for <span foreground='${P_GREEN_BRIGHT}'><b>${ACTIVE_MONITOR}</b></span>"
		fi
	fi

	_mult_float SLEEP_MULT_FLOAT "$mult"
	log Info "Calibrated multiplier for $ACTIVE_MONITOR: $mult ($SLEEP_MULT_FLOAT, cached=$MULT_CACHED)"
}

# Re-calibrate each detected DDC-capable monitor. Detection merges newly
# discovered buses with cached metadata, then the first responsive candidate
# is stored for each monitor.
calibrate_all() {
	local output bus saved_monitor bus_map_str

	if ! command -v ddcutil > /dev/null; then
		log Error "ddcutil not found - cannot calibrate"
		vb-cmd-dep-notify --name "Brightness Control" --deps ddcutil
		return 1
	fi

	log Info "Detecting DDC-capable monitors..."

	# Fresh detection, bypassing the bus cache
	FORCE=true get_i2c_bus

	if [[ -n "$MONITOR_ARG" ]]; then
		if [[ -z "${bus_map[$MONITOR_ARG]+x}" ]]; then
			log Error "Monitor '$MONITOR_ARG' has no DDC support or was not detected"
			return 1
		fi
		bus_map_str="$MONITOR_ARG"
	else
		bus_map_str="${!bus_map[*]}"
	fi

	if [[ -z "$bus_map_str" ]]; then
		log Warn "No DDC-capable monitors found"
		return 0
	fi

	log Info "Found monitors: $bus_map_str"
	saved_monitor="$ACTIVE_MONITOR"

	local count=0 summary=""
	for output in $bus_map_str; do
		bus="${bus_map[$output]}"

		if [[ -z "$bus" ]]; then
			log Warn "  Skipping $output (no I2C bus)"
			continue
		fi

		count=$((count + 1))
		log Info "[$count] Calibrating $output (I2C bus $bus)..."

		ACTIVE_MONITOR="$output"
		I2C_BUS="$bus"

		FORCE=true calibrate_sleep_mult

		log Info "  -> sleep-multiplier = $SLEEP_MULT_FLOAT"
		summary="${summary}${summary:+\\n}- <span foreground='${P_GREEN_BRIGHT}'><b>${output}</b></span>"
	done

	ACTIVE_MONITOR="$saved_monitor"

	log Info "Calibrated $count monitor(s)"
	notify-send -r 3 -a "Vibranium" -t 15000 "Brightness - Calibration" \
		"Calibrated $count monitor(s):\\n$summary"
}

# Detect monitors via DDC and merge their i2c buses into the unified state,
# preserving any cached brightness levels.
get_i2c_bus() {
	local new_info="" output bus name skip=0 line
	local -a _toks=()

	# Parse ddcutil detect output (expected format):
	#   DRM_connector: card1-eDP-1   -> skip (internal laptop panel)
	#   DRM_connector: card1-DP-3    -> name becomes "DP-3"
	#   I2C bus: /dev/i2c-6          -> bus becomes "6"
	#   VCP version: ...             -> emit "DP-3:6"
	# Pure-Bash state machine tracking skip across multi-line connector blocks.
	while IFS= read -r line; do
		if [[ "$line" == *"I2C bus:"* ]]; then
			read -ra _toks <<< "$line"
			bus="${_toks[-1]}"
			bus="${bus#/dev/i2c-}"
		elif [[ "$line" == *"DRM_connector:"* ]]; then
			skip=0
			read -ra _toks <<< "$line"
			name="${_toks[1]:-}"
			if [[ "$name" =~ ^card[0-9]+-eDP ]]; then
				skip=1
			fi
			if [[ "$name" =~ ^card[0-9]+-(.*)$ ]]; then
				name="${BASH_REMATCH[1]}"
			fi
		elif [[ "$line" == *"This is a laptop"* ]]; then
			skip=1
		elif [[ "$line" == *"VCP version"* && "$skip" -eq 0 ]]; then
			if [[ -n "${name:-}" && -n "${bus:-}" ]]; then
				new_info+="${name}:${bus}"$'\n'
			fi
		fi
	done < <(ddcutil detect 2> /dev/null)

	# Load existing cache so levels (and other buses) survive the rewrite
	load_state

	local _ddc_count=0
	while IFS= read -r _ddc_line; do
		if [[ -n "$_ddc_line" ]]; then
			((_ddc_count++))
		fi
	done <<< "$new_info"

	log Info "DDC detect: $_ddc_count monitor(s) found"

	# Merge newly detected buses (overrides cached bus entries only)
	while IFS=: read -r output bus; do
		if [[ -n "$output" && -n "$bus" ]]; then
			bus_map["$output"]="$bus"
		fi
	done <<< "$new_info"

	save_state
}

set_i2c_bus() {
	local -n _result="$1"

	if [[ $FORCE == false && -n "${bus_map[$ACTIVE_MONITOR]:-}" ]]; then
		_result="${bus_map[$ACTIVE_MONITOR]}"
		log Info "I2C cache hit: $ACTIVE_MONITOR -> bus $_result"
		return
	fi

	log Info "I2C cache miss for $ACTIVE_MONITOR, running detect"
	get_i2c_bus
	# Detection can still omit the requested output. In that case the nameref
	# receives an empty bus, leaving the selected backend responsible for handling
	# the missing hardware target.
	_result="${bus_map[$ACTIVE_MONITOR]}"
}

get_brightness_cache() {
	local -n _result="$1"

	if [[ $FORCE == true ]]; then
		return 0
	fi

	_result="${level_map[$ACTIVE_MONITOR]:-}"
	log Info "Brightness cache: $ACTIVE_MONITOR -> ${_result:-<empty>}"
}

update_brightness_cache() {
	local new_value="$1"
	log Info "Cache update: $ACTIVE_MONITOR -> $new_value"
	level_map["$ACTIVE_MONITOR"]="$new_value"
	save_state
}

# Populate the initial state snapshot. Detection can reload it, and writes
# replace the complete state through save_state.
load_state
log Info "State loaded: ${#bus_map[@]} monitor(s), gamma=$GAMMA"

if [[ $ACTION == "--calibrate" ]]; then
	log Info "Starting calibration for all monitors"
	calibrate_all
	log Info "Calibration complete"
	exit 0
fi

# Fetch monitors and active window in one hyprctl batch call, then extract
# the focused monitor name, total monitor count, and fullscreen state via jq.
# @tsv emits tab-separated values so the three fields can be read with IFS=$'\t'.
IFS=$'\t' read -r ACTIVE_MONITOR MONITOR_COUNT FULLSCREEN_STATE < <(
	hyprctl -j --batch 'monitors; activewindow' 2> /dev/null | jq -rs '[
    (.[0][] | select(.focused) | .name),
    (.[0] | length | tostring),
    (.[1].fullscreen | tostring)
  ] | @tsv'
)

if [[ -n "$MONITOR_ARG" ]]; then
	ACTIVE_MONITOR="$MONITOR_ARG"
fi

log Info "Active monitor: $ACTIVE_MONITOR (${MONITOR_COUNT:-?} total, fullscreen=$FULLSCREEN_STATE)"

if [[ -z "$ACTIVE_MONITOR" ]]; then
	notify-send -r 1 -a "Vibranium" -t 3000 -u critical "Vibranium - Brightness" "Cannot get the active monitor!"
	exit 1
fi

# Decide between DDC (external monitors) and raw sysfs (internal laptop panel).
# The heuristics:
#   1. No /sys/class/backlight/ device -> no built-in panel -> must use DDC.
#   2. /sys/class/backlight/ exists but the focused monitor name does not
#      start with eDP -> external monitor on a laptop with a closed lid -> DDC.
#   3. Otherwise -> raw sysfs access to the built-in backlight.
if ! compgen -G "/sys/class/backlight/*" > /dev/null; then
	if ! command -v ddcutil > /dev/null; then
		vb-cmd-dep-notify --name "Brightness Control" --deps ddcutil
		exit 1
	fi

	log Info "No backlight device found, using DDC"
	method="ddc"
	set_i2c_bus I2C_BUS
	log Info "Using DDC method, I2C bus: $I2C_BUS"
else
	if [[ -n "$ACTIVE_MONITOR" && ! "$ACTIVE_MONITOR" =~ ^eDP ]]; then
		log Info "External monitor ($ACTIVE_MONITOR) on laptop, using DDC"
		method="ddc"
		set_i2c_bus I2C_BUS
	else
		log Info "Built-in panel ($ACTIVE_MONITOR), using raw sysfs"
		method="raw"
	fi
fi

# Gamma dimming uses the physical-minimum path and skips calibration for
# non-set actions; --set still calibrates before its DDC operation.
# GAMMA is populated by load_state() at the start of the main path.

# GAMMA is global even when the state has per-monitor rows, so a transition
# from gamma dimming to physical brightness restores the DDC value only when
# the target reaches the upper bound.
if [[ "$method" == "ddc" ]]; then
	if ((GAMMA == 100)) || [[ "$ACTION" == "--set" ]]; then
		calibrate_sleep_mult
		ddcutil_flags=(
			--sleep-multiplier "$SLEEP_MULT_FLOAT"
			--noverify
			--skip-ddc-checks
			--maxtries "1,1,1"
		)
		log Info "Sleep multiplier: $SLEEP_MULT_FLOAT"
	else
		log Info "Gamma dimming active, using fallback sleep-multiplier 0.13"
		ddcutil_flags=(
			--sleep-multiplier 0.13
			--noverify
			--skip-ddc-checks
			--maxtries "1,1,1")
	fi
fi

step=$BRIGHTNESS_STEP
log Info "Action: $ACTION, method: $method, step: $step"

# Value flashes go through the shell's OSD, like volume: kind
# "brightness" takes -90..100, negative painting the gamma-dim bar, so
# the dim fill matches the old notify-send bar pixel for pixel.
# `qs ipc call` hands the argument through verbatim, so the payload goes
# bare and parses to the object on the first try. Empty-valued keys are
# omitted: the OSD defaults label and icon itself when they are absent.
_osd_brightness() {
	local payload
	printf -v payload '{"kind":"brightness","value":%d,"muted":false}' "$1"
	vb-shell osd flash "$payload"
}

case "$method" in
	"ddc")
		get_brightness_cache current
		if [[ ! $current =~ ^[0-9]+$ ]]; then
			# Aggressive sleep-multiplier values need a few tries before the monitor
			# responds on the I2C bus. Retry up to 10 times to work around transient
			# DDC NACKs; the loop exits early once a valid value (0-100) is obtained.
			for ((i = 0; i < 10; i++)); do
				line_output=""
				IFS= read -r -d '' line_output < <(
					ddcutil --bus "$I2C_BUS" "${ddcutil_flags[@]}" getvcp 10 2> /dev/null
				) || true
				# Match the current brightness value in ddcutil output format:
				#   VCP code 0x10 (...): current value =   25, max value =   100
				# The value follows "current value =" with variable whitespace.
				if [[ "$line_output" =~ current\ value\ =\ +([0-9]+) ]]; then
					current="${BASH_REMATCH[1]}"
				fi
				log Info "DDC getvcp attempt $((i + 1))/10: current=$current"
				if [[ $current =~ ^[0-9]+$ ]]; then
					if ((current >= 0 && current <= 100)); then
						break
					fi
				fi
			done
			[[ $FORCE == false ]] && log Warn "Cache miss, got DDC value: $current"
			# Do not persist current separately. The conditional writer below owns
			# the single state update; an unset or unchanged new value skips it.
		fi

		log Info "DDC current brightness: $current"
		case "$ACTION" in
			"--up")
				if ((GAMMA < 100)); then
					new_gamma=$((GAMMA + step))
					((new_gamma > 100)) && new_gamma=100
					apply_gamma "$new_gamma"
					save_gamma "$new_gamma"
					GAMMA=$new_gamma
					log Info "Gamma raised to $GAMMA (brightness unchanged at $current)"
					if ((GAMMA == 100)); then
						new=$current
					fi
				else
					((current == 100)) && exit 0
					new=$((current + step))
					((new > 100)) && new=100
				fi
				;;
			"--down")
				if ((current == 0 && GAMMA > GAMMA_MIN)); then
					new_gamma=$((GAMMA - step))
					((new_gamma < GAMMA_MIN)) && new_gamma=$GAMMA_MIN
					apply_gamma "$new_gamma"
					save_gamma "$new_gamma"
					GAMMA=$new_gamma
					log Info "Gamma lowered to $GAMMA (brightness at minimum)"
				else
					((current == 0)) && exit 0
					new=$((current - step))
					((new < 0)) && new=0
				fi
				;;
			"--set")
				if ((SET_VALUE >= 0)); then
					if ((GAMMA != 100)); then
						apply_gamma 100
						save_gamma 100
						GAMMA=100
					fi
					new=$SET_VALUE
				else
					new=0
					new_gamma=$((100 + SET_VALUE))
					((new_gamma < GAMMA_MIN)) && new_gamma=$GAMMA_MIN
					if ((GAMMA != new_gamma)); then
						apply_gamma "$new_gamma"
						save_gamma "$new_gamma"
						GAMMA=$new_gamma
					fi
				fi
				;;
		esac

		# `new` is optional: gamma-only transitions may leave it unset, and a
		# gamma-to-100 transition may set it equal to current. The guard suppresses
		# the DDC command and its single cache update in either case.
		if [[ -n "$new" && "$new" != "$current" ]]; then
			log Info "Setting brightness to $new (current: $current)"
			ddcutil --bus "$I2C_BUS" "${ddcutil_flags[@]}" setvcp 10 "$new" &> /dev/null &
			update_brightness_cache "$new" &
		fi

		# The notification check follows the hardware and cache launch decision.
		# An early exit suppresses feedback without waiting for background jobs.
		if [[ "$BRIGHTNESS_NOTIFY" == false ]]; then
			log Info "Notifications disabled, exiting"
			exit 0
		fi

		# The daemon lets the live OSD restack in place, so a brightness
		# drag reads as one moving bar rather than a pile of stale ones.
		if ((GAMMA < 100)); then
			log Info "Gamma dimming active (gamma=$GAMMA), showing dimming OSD"
			if [[ "$QUIET" == false ]]; then
				dim_bar=$(((GAMMA - GAMMA_MIN) * 100 / (100 - GAMMA_MIN)))
				_osd_brightness $((dim_bar - 100))
			fi
		elif [[ -n "$new" ]]; then
			if [[ "$QUIET" == false ]]; then
				_osd_brightness "$new"
			fi
		fi
		;;
	"raw")
		# Read current and max brightness from the kernel
		# Bash pathname expansion supplies the kernel backlight values as words;
		# the raw path assumes one active panel device, matching the branch above.
		read -r current_raw < /sys/class/backlight/*/brightness
		read -r max_raw < /sys/class/backlight/*/max_brightness
		current=$((current_raw * 100 / max_raw))
		log Info "Raw sysfs: current=$current_raw, max=$max_raw, pct=$current"

		case "$ACTION" in
			"--up")
				if ((GAMMA < 100)); then
					new_gamma=$((GAMMA + step))
					if ((new_gamma > 100)); then
						new_gamma=100
					fi

					apply_gamma "$new_gamma"
					save_gamma "$new_gamma"

					GAMMA=$new_gamma

					log Info "Gamma raised to $GAMMA (brightness unchanged at $current)"

					if ((GAMMA == 100)); then
						new_pct=$current
						new_raw=$(((new_pct * max_raw + 99) / 100))
					fi
				else
					new_pct=$((current + step))
					((new_pct > 100)) && new_pct=100
					new_raw=$(((new_pct * max_raw + 99) / 100))
				fi
				;;
			"--down")
				if ((current == 0 && GAMMA > GAMMA_MIN)); then
					# Hardware at minimum; transition to gamma dimming.
					new_gamma=$((GAMMA - step))
					if ((new_gamma < GAMMA_MIN)); then
						new_gamma=$GAMMA_MIN
					fi
					apply_gamma "$new_gamma"
					save_gamma "$new_gamma"

					GAMMA=$new_gamma

					log Info "Gamma lowered to $GAMMA (brightness at minimum)"
				else
					new_pct=$((current - step))
					((new_pct < 0)) && new_pct=0
					new_raw=$(((new_pct * max_raw + 99) / 100))
				fi
				;;
			"--set")
				if ((SET_VALUE >= 0)); then
					if ((GAMMA != 100)); then
						apply_gamma 100
						save_gamma 100
						GAMMA=100
					fi

					new_pct=$SET_VALUE
					new_raw=$(((new_pct * max_raw + 99) / 100))
				else
					new_pct=0
					new_raw=0
					new_gamma=$((100 + SET_VALUE))

					if ((new_gamma < GAMMA_MIN)); then
						new_gamma=$GAMMA_MIN
					fi

					if ((GAMMA != new_gamma)); then
						apply_gamma "$new_gamma"
						save_gamma "$new_gamma"
						GAMMA=$new_gamma
					fi
				fi
				;;
		esac

		# The parameter-existence test is the sentinel: if the action leaves
		# new_raw unset, no sysfs write is attempted.
		if [[ -n "${new_raw+x}" ]]; then
			# Clamp raw value
			((new_raw > max_raw)) && new_raw=$max_raw
			((new_raw < 0)) && new_raw=0

			new=$((new_raw * 100 / max_raw))

			log Info "Write raw brightness: $new_raw/$max_raw ($new%)"
			echo "$new_raw" > /sys/class/backlight/*/brightness
		fi

		if [[ "$BRIGHTNESS_NOTIFY" == "false" ]]; then
			log Info "Notifications disabled, exiting"
			exit 0
		fi

		if ((GAMMA < 100)); then
			log Info "Gamma dimming active (gamma=$GAMMA), raw OSD"
			if [[ "$QUIET" == false ]]; then
				dim_bar=$(((GAMMA - GAMMA_MIN) * 100 / (100 - GAMMA_MIN)))
				_osd_brightness $((dim_bar - 100))
			fi
		elif [[ -n "${new_raw+x}" ]]; then
			if [[ "$QUIET" == false ]]; then
				_osd_brightness "$new"
			fi
		fi
		;;
esac
