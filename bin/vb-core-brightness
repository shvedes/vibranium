#!/usr/bin/env bash

# Overcomplicated script that manages brightness control using raw sysfs values
# as well as the DDC protocol for external monitors. The script uses state files to cache
# active values for both methods to speed up subsequent script executions.
# This is ESPECIALLY useful for the DDC method, because ddcutil is known to be quite slow.
# Thanks to the state file, changing brightness with DDC takes milliseconds instead of 500-700-1000ms.
#
# The script can accept parameters such as up | down for relative brightness adjustment with dynamic steps using Vibranium settings,
# as well as absolute values such as 20, 50, 100, etc.
#
# TODO: allow setting brightness below 0% by adjusting gamma level below 100% via hyprsunset.

if [[ "$CHASSIS_TYPE" == vm ]]; then
  notify-send -r 4 "Vibranium - Brightness" -u critical -t 5000 \
    "Brightness control is not available inside of a Virtual Machine"
  exit 1
fi

source vb-core-lib

usage() {
  cat << EOF
Usage: ${0##*/} [--up|--down|--value N]

Adjust screen brightness.

Options:
    --up           Increase brightness by a step
    --down         Decrease brightness by a step
    --value N      Set brightness to absolute value (0-100)
    -h, --help     Show this help and exit
EOF
}

if [[ -z "$1" || ! $1 =~ ^--(up|down|value)$ ]]; then
  usage
  exit 1
fi

if [[ "$1" == "--value" && ! "$2" =~ ^[0-9]+$ ]]; then
  usage
  exit 1
fi

if pidof -q ddcutil; then
  log::error "Found another instance of ddcutil!"
  exit 1
fi

ensure_user_group() {
  if [[ ! "$(groups)" =~ video ]]; then
    log::error "The ${YELLOW}raw${RESET} method requires the user to be in the ${YELLOW}video${RESET} user group!"
    log::error "To add yourself to the ${YELLOW}video${RESET} group, run:"
    log::error "'${RED}sudo ${CYAN}usermod ${YELLOW}-aG ${GREEN}video ${PURPLE}$USER${RESET}' and reboot your PC"
    if term::is_headless; then
      msg="To add yourself to the <span foreground='${P_YELLOW}'>video</span> group, run:\n\n"
      msg+="<b><span foreground='${P_RED}'>sudo</span> <span foreground='${P_ACCENT}'>usermod</span> "
      msg+="<span foreground='${P_YELLOW}'>-aG</span> <span foreground='${P_GREEN}'>video</span> "
      msg+="<span foreground='${P_PURPLE}'>$USER</span></b>\n\n"
      msg+="and reboot your laptop"
      notify-send -r 100 -t 30000 -u critical "Vibranium - Brightness" "$msg"

      msg="The <span foreground='${P_YELLOW}'><b>raw</b></span> "
      msg+="method (laptop screen) requires you to be in the <span foreground='${P_YELLOW}'><b>video</b></span> user group!"
      notify-send -r 200 -t 10000 -u critical "Vibranium - Brightness" "$msg"
    fi
    return 1
  fi
}

get_i2c_bus() {
  local state_file new_info
  declare -A bus_map

  # Detect monitors and extract MONITOR:BUS pairs,
  # skipping internal laptop panels
  new_info="$(ddcutil detect 2> /dev/null | awk '
        /I2C bus:/ {
            bus=$NF
            sub("/dev/i2c-", "", bus)
        }
        /DRM_connector:/ {
            skip=0
            name=$2
            if (name ~ /^card[0-9]+-eDP/) skip=1
            sub(/^card[0-9]+-/, "", name)
        }
        /This is a laptop/ { skip=1 }
        /VCP version/ && !skip { print name ":" bus }
    ')"

  state_file="$VIBRANIUM_STATE/i2c-bus"

  # Load existing cache if present
  if [[ -f "$state_file" ]]; then
    while IFS=: read -r name bus; do
      [[ -n "$name" && -n "$bus" ]] && bus_map["$name"]="$bus"
    done < "$state_file"
  fi

  # Merge newly detected data (overrides cached entries)
  while IFS=: read -r name bus; do
    [[ -n "$name" && -n "$bus" ]] && bus_map["$name"]="$bus"
  done <<< "$new_info"

  {
    # Write merged cache back to disk
    for name in "${!bus_map[@]}"; do
      printf '%s:%s\n' "$name" "${bus_map[$name]}"
    done
  } > "$state_file"
}

ensure_i2c_cache() {
  local target
  target="$VIBRANIUM_STATE/i2c-bus"

  if [[ ! -f "$target" ]] || ! grep -qF "$ACTIVE_MONITOR" "$target"; then
    log::warn "I2C bus cache for the active monitor not found. Getting one..."
    log::warn "The script will run a bit longer than usual"
    get_i2c_bus
  fi
}

set_i2c_bus() {
  local final_bus

  ensure_i2c_cache

  while IFS=: read -r name bus; do
    [[ $name == "$ACTIVE_MONITOR" ]] || continue
    final_bus="$bus"
    break
  done < "$VIBRANIUM_STATE/i2c-bus"

  echo "$final_bus"
}

get_brightness_cache() {
  local state_file
  declare -A old_info

  state_file="$VIBRANIUM_STATE/brightness"

  if [[ -f "$state_file" ]]; then
    while IFS=: read -r name value; do
      [[ -n "$name" && -n "$value" ]] && old_info["$name"]="$value"
    done < "$state_file"
  fi

  # If no entry for the active monitor, return empty to trigger a fresh fetch
  echo "${old_info["$ACTIVE_MONITOR"]}"
}

update_brightness_cache() {
  local new_value="$1"
  local state_file tmp
  declare -A info

  state_file="$VIBRANIUM_STATE/brightness"
  tmp="$(mktemp)"

  # If the state file exists, read its contents
  if [[ -f "$state_file" ]]; then
    # Read lines in the format "Monitor:Brightness"
    while IFS=: read -r name value; do
      [[ -n "$name" && -n "$value" ]] && info["$name"]="$value"
    done < "$state_file"
  fi

  # Update the brightness for the active monitor
  info["$ACTIVE_MONITOR"]="$new_value"

  # Write all "Monitor:Brightness" pairs
  for name in "${!info[@]}"; do
    printf '%s:%s\n' "$name" "${info[$name]}"
  done > "$tmp"

  mv -f "$tmp" "$state_file"
}

osd() {
  local value="$1"
  local icon progress
  local service_status

  # Set specific icons depending on the current brightness level (icons are taken from the active icon pack)
  if ((value <= 30)); then
    icon="brightness-low-symbolic"
  elif ((value <= 70)); then
    icon="brightness-symbolic"
  else
    icon="brightness-high-symbolic"
  fi

  # Build a brightness value for SwayOSD
  progress=$(awk -v v="$value" 'BEGIN {p = 0.02 + v * (0.98/100); printf "%.2f", p}')

  # I can't imagine a situation where this service would be turned off, but let it be there just in case
  systemctl -q --user is-active swayosd || {
    log::warn "swayosd.service wasn't active!"
    systemctl --user enable --now swayosd
  }
  swayosd-client --custom-icon="$icon" --custom-progress="$progress" || true
}

if ! ACTIVE_MONITOR="$(hyprctl -j monitors | jq -r '.[] | select(.focused == true) | .name')"; then
  log::error "Cannot determine the active monitor!"
  if term::is_headless; then
    notify-send -r 1 -t 10000 -u critical "Vibranium - Brightness" \
      "The brightness script unable to get the active monitor!"
  fi
  exit 1
fi

if ! compgen -G "/sys/class/backlight/*" > /dev/null; then
  # If the driver for adjusting the brightness of the built-in screen is not found and DDC control is disabled globally
  helpers::check VIBRANIUM_BRIGHTNESS_USE_DDC_CONTROL
  use_ddc="$VIBRANIUM_BRIGHTNESS_USE_DDC_CONTROL"

  if [[ $use_ddc == false ]]; then
    log::error "This feature is disabled in Vibranium settings"
    exit 1
  else
    if ! vb-cmd-is-present ddcutil; then
      vb-cmd-dep-notify --name "Brightness Control" --deps ddcutil
      exit 1
    fi

    method="DDC"
    I2C_BUS="$(set_i2c_bus)"

    # TODO: As far as I know, optimal values for --sleep-multiplier can vary from a monitor to a monitor,
    # and while it works well on one monitor, it may not work at all on another.
    # In this case, we need to create a mini-algorithm that will calculate and record valid values for the monitor and use them.
    ddcutil_flags=(--sleep-multiplier 0.13 --noverify --skip-ddc-checks --maxtries 1,1,1)
  fi
else
  if [[ -n "$ACTIVE_MONITOR" && ! "$ACTIVE_MONITOR" =~ ^eDP* ]]; then
    method="DDC"
    I2C_BUS="$(set_i2c_bus)"
  else
    method="raw"
  fi
fi

helpers::check VIBRANIUM_GLOBAL_USE_OSD

use_swayosd="$VIBRANIUM_GLOBAL_USE_OSD"

[[ "$use_swayosd" == true ]] && {
  if ! vb-cmd-is-present swayosd:swayosd-client; then
    vb-cmd-dep-notify --name "Brightness Control" --deps swayosd
    exit 1
  fi
}

helpers::check VIBRANIUM_BRIGHTNESS_STEP
step=$VIBRANIUM_BRIGHTNESS_STEP

case "$method" in
  "DDC")
    log::info "Method: ${YELLOW}${method}${RESET} for ${YELLOW}$ACTIVE_MONITOR${RESET}"
    current="$(get_brightness_cache)"
    if [[ ! $current =~ ^[0-9]+$ ]]; then
      log::warn "Cached brightness value not found!"
      log::info "Trying to get brightness level via ${YELLOW}ddcutil${RESET}"

      for ((i = 0; i < 5; i++)); do
        # Same as above.
        # -----------------
        # As mentioned above, --sleep-multiplier can sometimes fail at very low values,
        # so we give the command three attempts to get the data from the monitor using the DDC protocol.
        current=$(ddcutil --bus "$I2C_BUS" "${ddcutil_flags[@]}" getvcp 10 2> /dev/null | awk '/current/ {print int($9)}')
        if [[ $current =~ ^[0-9]+$ ]] && ((current >= 0 && current <= 100)); then
          break
        fi
      done
      log::info "Got new brightness level via ${YELLOW}ddcutil${RESET}"
      log::info "Caching new brightness level ($current)"
      update_brightness_cache "$current" &
    else
      log::info "Found cached brightness level (${YELLOW}$current${RESET})"
    fi

    # The remaining code at the bottom is generally self-explanatory
    case "$1" in
      "--up")
        ((current == 100)) && exit 0
        new=$((current + step))
        ((new > 100)) && new=100
        ;;
      "--down")
        ((current == 0)) && exit 0
        new=$((current - step))
        ((new < 0)) && new=0
        ;;
      "--value")
        if [[ $2 =~ ^[0-9]+$ ]]; then
          if ((current == 0 && $2 == 0)); then
            exit 0
          elif ((current == 100 && $2 == 100)); then
            exit 0
          elif ((current == $2)); then
            log::warn "Brightness level is already on ${current}%. Aborting"
            exit 0
          fi

          if (($2 >= 0 && $2 <= 100)); then
            new=$2
          else
            log::error "Out of boundary!"
            exit 1
          fi
        fi
        ;;
    esac

    log::info "New brightness level: ${YELLOW}$new${RESET}"
    ddcutil --bus "$I2C_BUS" "${ddcutil_flags[@]}" setvcp 10 "$new" &> /dev/null &

    log::info "Updating caches"
    update_brightness_cache "$new" &

    if [[ $use_swayosd == true ]]; then
      if [[ ! $2 =~ ^[0-9]+$ ]]; then
        log::info "Showing OSD overlay"
        osd "$new" &
      fi
    else
      # Do not display the monitor name if it is only one.
      if [[ ! $(hyprctl -j monitors | jq 'length') == "1" ]]; then
        log::info "More than 1 monitor found. Displaying monitor name in the notification title"
        source="($ACTIVE_MONITOR) "
      else
        log::info "Only one monitor found. Not showing monitor name in the notification title"
      fi

      # Suppress the notification when the active window is fullscreen.
      # Dunst queues notifications during fullscreen and shows them only
      # after exiting fullscreen, which makes them stale and irrelevant.
      #
      # We don't apply this rule to OSD notifications because
      # it defeats the purpose of OSDs

      fullscreen_state="$(hyprctl -j activewindow | jq -r '.fullscreen')"

      if (("$fullscreen_state" == 2)); then
        exit
      fi

      if [[ ! $2 =~ ^[0-9]+$ ]]; then
        notify-send -r 2 -t 1000 "Brightness $source${new}%" -h int:value:"$new"
      fi
    fi
    ;;
  "raw")
    if ! ensure_user_group; then
      exit 1
    fi

    # Read current and max brightness from the kernel
    current_raw=$(< /sys/class/backlight/*/brightness)
    max_raw=$(< /sys/class/backlight/*/max_brightness)
    current=$((current_raw * 100 / max_raw))

    case "$1" in
      "--up")
        # Step is in percent, convert to raw delta
        delta=$((step * max_raw / 100))
        new_raw=$((current_raw + delta))
        ;;
      "--down")
        delta=$((step * max_raw / 100))
        new_raw=$((current_raw - delta))
        ;;
      "--value")
        if ((current == $2)); then
          log::warn "Brightness level is already on ${current}%. Aborting"
          exit 0
        elif (($2 >= 0 && $2 <= 100)); then
          new_raw=$(($2 * max_raw / 100))
        fi
        ;;
    esac

    # Clamp raw value
    ((new_raw > max_raw)) && new_raw=$max_raw
    ((new_raw < 0)) && new_raw=0

    # Convert back to percent for OSD
    new=$((new_raw * 100 / max_raw))

    # Apply new brightness
    log::info "New brightness level: ${YELLOW}$new${RESET}"
    echo "$new_raw" > /sys/class/backlight/*/brightness

    if [[ $use_swayosd == true ]]; then
      log::info "Showing OSD overlay"
      swayosd-client --brightness="$new"
    else
      notify-send -r 1 -t 1000 "Brightness ${new}%" -h int:value:"$new"
    fi
    ;;
esac
