#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Reload Vibranium configuration and restart relevant services.

Options:
  -v, --verbose  Enable verbose output
  -q, --quiet    Suppress informational output
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -q | --quiet)
      export VERBOSE=false
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      log Error "unknown option: $1"
      usage
      exit 1
      ;;
  esac
done

# Shared settings are loaded only after option validation, so help and invalid
# argument paths do not source the runtime settings projection.
source vb-lib-core

log Info "Reloading configuration"

# Restart the configured user units so they reload unit and configuration
# state; systemctl restart also starts an inactive unit. The target array is
# expanded as separate arguments for one user restart.
SYSTEMD_TARGETS=(vibranium-shell)

if ((${#SYSTEMD_TARGETS[@]} > 0)); then
  systemctl --user restart "${SYSTEMD_TARGETS[@]}"
fi

# The final Hyprland invocation determines the script status; the earlier
# service restart is not aggregated into a separate result.
hyprctl -q reload config-only
