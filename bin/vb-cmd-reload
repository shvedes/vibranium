#!/usr/bin/env bash

source vb-core-lib

SYSTEMD_TARGETS=("cliphist" "hypridle")

[[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]        && SYSTEMD_TARGETS+=("swayosd")
[[ "$VIBRANIUM_GLOBAL_SHOW_WALLPAPER" == true ]] && SYSTEMD_TARGETS+=("hyprpaper")
systemctl -q --user is-active waybar             && SYSTEMD_TARGETS+=("waybar")

systemctl --user restart "${SYSTEMD_TARGETS[@]}" &
vb-cmd-refresh-dunst

hyprctl -q reload config-only &

if [[ ! "$1" =~ ^(-q|--quiet)$ ]]; then
    notify-send -r 2 -t 1500 "Vibranium" "Configuration reloaded"
fi
