#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
	shcat << EOF
Usage: ${0##*/} [OPTION]

Reload Vibranium configuration and restart relevant services.

Options:
  -v, --verbose  Enable verbose output
  -q, --quiet    Suppress informational output
  -h, --help     Display this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		-v | --verbose)
			export VERBOSE=true
			shift
			;;
		-q | --quiet)
			export VERBOSE=false
			shift
			;;
		-h | --help)
			usage
			exit 0
			;;
		*)
			log Error "unknown option: $1"
			usage
			exit 1
			;;
	esac
done

source vb-lib-core

log Info "Reloading configuration"

hyprctl -q reload config-only

SYSTEMD_TARGETS=(vibranium-shell)

if ((${#SYSTEMD_TARGETS[@]} > 0)); then
	systemctl -q --user restart "${SYSTEMD_TARGETS[@]}"
fi
