#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vibranium-core-lib"

if pid_is_alive gpu-screen-recorder; then
    vibranium-core-recording
    exit 0
fi

OPTIONS=("Screen" "Window" "Region")
CHOSEN="$(printf "%s\n" "${OPTIONS[@]}" | rofi_cmd "Record" "ESC to exit")"

[ -z "$CHOSEN" ] && exit 0
printf "%s\n" "${OPTIONS[@]}" | grep -qxF "$CHOSEN" || exit 0
exec setsid vibranium-core-recording "${CHOSEN,,}"
