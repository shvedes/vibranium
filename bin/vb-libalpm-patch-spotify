#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}
MANUAL=false

log() {
  local level="$1"
  shift
  if [[ -t 0 ]]; then
    if $VERBOSE; then
      echo "[${0##*/}] $level: $*" >&2
    fi
  else
    case "$level" in
      Error)
        echo "==> ERROR: $*"
        ;;
      Warn)
        echo "==> WARN: $*"
        ;;
      *)
        echo "==> $*"
        ;;
    esac
  fi
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Check and re-apply Spicetify patches to Spotify.

Options:
  -m, --manual   Patch manually, bypass auto checks
  -v, --verbose  Enable verbose output
  -h, --help     Show this help and exit
EOF
}

while (($#)); do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -m | --manual)
      MANUAL=true
      shift
      ;;
    *)
      echo "${0##*/}: invalid option -- '$1'" >&2
      echo "Try '${0##*/} --help' for more information." >&2
      exit 2
      ;;
  esac
done

if $MANUAL; then
  export VERBOSE=true
fi

# If Spicetify is unavailable, there is nothing to restore or apply.
if ! command -v spicetify > /dev/null; then
  log Warn "Spicetify is not installed, skipping"
  exit 0
fi

if ! $MANUAL; then
  log Info "Checking if Spotify was previously patched"

  # Prefer ripgrep for speed; fall back to grep when rg is unavailable.
  # The batched search is a heuristic: a nonzero aggregate status enters the
  # unmanaged-state backup path rather than proving a per-file match.
  # The no-reference path records a fresh backup and leaves patch application
  # to the user.
  _spicetify_found=false
  while IFS= read -r -d '' _spotify_file; do
    while IFS= read -r _spotify_line; do
      if [[ $_spotify_line == *spicetify* ]]; then
        _spicetify_found=true
        break 2
      fi
    done < "$_spotify_file"
  done < <(find /opt/spotify/ -type f -print0 2>/dev/null)
  if ! $_spicetify_found; then
    if [[ -t 0 ]]; then
      echo "[${0##*/}] Info: Spotify wasn't patched; backing up current state" >&2
    else
      echo "==> Spotify wasn't patched; backing up current state"
    fi

    # Redirect stdout and stderr because --quiet can emit two blank lines in
    # hook output.
    if ! spicetify --no-restart --quiet backup &> /dev/null; then
      log Error "Couldn't backup Spotify state"
      exit 1
    fi
    log Info "Spotify state has been backed up"
    log Info "You can now apply patches"
    exit 0
  fi
fi

if ! spicetify --no-restart --quiet restore &> /dev/null; then
  log Info "Backing up Spotify state"
  spicetify --no-restart --quiet backup

  if (($?)); then
    log Error "Couldn't backup Spotify state"
    log Info "Patch Spotify manually"
    exit 0
  fi
fi

log Info "Restoring Spicetify state"
spicetify --no-restart --quiet restore

if (($?)); then
  log Error "Couldn't restore Spicetify state"
  log Info "Patch Spotify manually"
  exit 0
fi

log Info "Patching Spotify"
spicetify --no-restart --quiet apply

if (($?)); then
  log Error "Spicetify failed to patch Spotify"
  log Info "Make sure you have updated Spotify first"
  exit 0
fi

# Restore or apply failures in a post-transaction hook return success so a
# committed package update is not reported as failed; manual repair is requested.
log Info "Spotify has been patched"
