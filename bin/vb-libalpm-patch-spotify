#!/bin/bash

VERBOSE=false
MANUAL=false

log() {
  local level="$1"
  shift
  if [[ -t 0 ]]; then
    if $VERBOSE; then
      echo "[${0##*/}] $level: $*" >&2
    fi
  else
    case "$level" in
      Error)
        echo "==> ERROR: $*"
        ;;
      Warn)
        echo "==> WARN: $*"
        ;;
      *)
        echo "==> $*"
        ;;
    esac
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Check and re-apply Spicetify patches to Spotify.

Options:
  -m, --manual   Patch manually, bypass auto checks
  -v, --verbose  Enable verbose output
  -h, --help     Show this help and exit
EOF
}

while (($#)); do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -m | --manual)
      MANUAL=true
      shift
      ;;
    *)
      echo "${0##*/}: invalid option -- '$1'" >&2
      echo "Try '${0##*/} --help' for more information." >&2
      exit 2
      ;;
  esac
done

if $MANUAL; then
  VERBOSE=true
fi

# If Spicetify was never installed, there is nothing to restore or apply.
if ! command -v spicetify > /dev/null; then
  log Warn "Spicetify is not installed, skipping"
  exit 0
fi

if ! $MANUAL; then
  log Info "Checking if Spotify was previously patched"

  # Prefer ripgrep for speed when searching through the Spotify binary
  # directory; fall back to grep if rg is unavailable.
  if command -v rg > /dev/null; then
    grep_cmd=(rg -q -m1 spicetify)
  else
    grep_cmd=(grep -q -m1 spicetify)
  fi

  # Check whether any file under /opt/spotify/ contains a spicetify
  # reference.  If none do, the patch has already been reverted or was
  # never applied, so skip the restore+apply cycle.
  if ! find /opt/spotify/ -type f -exec "${grep_cmd[@]}" {} + > /dev/null; then
    if [[ -t 0 ]]; then
      echo "[${0##*/}] Info: Spotify wasn't patched; backing up current state" >&2
    else
      echo "==> Spotify wasn't patched; backing up current state"
    fi

    # For some reason, --quiet still prints two blank lines
    # in the pacman hook output. &>/dev/null fixes this.
    if ! spicetify --no-restart --quiet backup &> /dev/null; then
      log Error "Couldn't backup Spotify state"
      exit 1
    fi
    log Info "Spotify state has been backed up"
    log Info "You can now apply patches"
    exit 0
  fi
fi

if ! spicetify --no-restart --quiet restore &> /dev/null; then
  log Info "Backing up Spotify state"
  spicetify --no-restart --quiet backup

  if (($?)); then
    log Error "Couldn't backup Spotify state"
    log Info "Patch Spotify manually"
    exit 0
  fi
fi

log Info "Restoring Spicetify state"
spicetify --no-restart --quiet restore

if (($?)); then
  log Error "Couldn't restore Spicetify state"
  log Info "Patch Spotify manually"
  exit 0
fi

log Info "Patching Spotify"
spicetify --no-restart --quiet apply

if (($?)); then
  log Error "Spicetify failed to patch Spotify"
  log Info "Make sure you have updated Spotify first"
  exit 0
fi

log Info "Spotify has been patched"
