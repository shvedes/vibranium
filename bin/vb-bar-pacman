#!/usr/bin/env bash

source vb-core-lib

helpers::parse_defaults
helpers::check VIBRANIUM_BAR_PACMAN_MODULE_ENABLE
helpers::check VIBRANIUM_BAR_SHOW_SEPARATOR

if [[ "$VIBRANIUM_BAR_PACMAN_MODULE_ENABLE" == false ]]; then
    printf '{"text": ""}'
    exit 0
elif ! pidof -q waybar; then
    log::error "Waybar is not active!"
    exit 1
fi

if ! command -v checkupdates > /dev/null; then
    text=""

    if [[ "$VIBRANIUM_BAR_SHOW_SEPARATOR" ]]; then
        text+="<span foreground='DimGray'>|</span>   "
    fi

    text+="<span foreground='red2'>\uf071</span>"

    tooltip="Unable to fetch updates!\n"
    tooltip+="Missing dependencies: pacman-contrib"

    printf '{"text": "%s", "tooltip": "%s"}' "$text" "$tooltip"
    exit 0
fi

_spinner() {
    local tooltip="$1"
    local delay=0.1
    local spinstr=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

    format_text() {
        local text="$1"
        if [[ "$VIBRANIUM_BAR_SHOW_SEPARATOR" == true ]]; then
            text="<span foreground='DimGray'>|</span> "
            text+="$1"
        fi
        printf '%s' "$text"
    }

    for i in "${spinstr[@]}"; do
        frame="$(format_text "<span foreground='gray'>$i</span>")"

        jq -nc \
          --arg text "$frame" \
          --arg tooltip "$tooltip" \
          '{text:$text, tooltip:$tooltip}'

        sleep "$delay"
    done
}

wait_for_connection() {
    while ! ping 8.8.8.8 -c 1 &> /dev/null; do
        sleep 1
    done
}

make_tooltip() {
    local files=("$@")
    local any=false
    for f in "${files[@]}"; do
        [[ -s "$f" ]] && any=true && break
    done
    $any || { echo ""; return; }

    awk -f "$VIBRANIUM/awk/vb-bar-pacman.awk" "${files[@]}"
}

get_arch_updates() { checkupdates --nocolor; }
get_aur_updates() { yay -Qua 2> /dev/null; }

wait_for_connection

helpers::check VIBRANIUM_BAR_SHOW_ANIMATION true

if [[ $VIBRANIUM_BAR_SHOW_ANIMATION == false ]]; then
    show_spinner=false
else
    marker="$VIBRANIUM_RUNTIME/bar_updates.$(pidof waybar)"
    if [[ -f $marker ]]; then
        show_spinner=false
    else
        show_spinner=true
        rm -f "${marker%.*}".*
        touch "$marker"
    fi
fi

(get_arch_updates > $VIBRANIUM_RUNTIME/bar_updates.arch) &
arch_pid=$!

(get_aur_updates > $VIBRANIUM_RUNTIME/bar_updates.aur) &
aur_pid=$!

if [[ $show_spinner == true ]]; then
    while kill -0 $arch_pid 2> /dev/null || kill -0 $aur_pid 2> /dev/null; do
        _spinner "Fetching updates..."
    done
fi

wait $arch_pid $aur_pid

arch_count="$(wc -l < $VIBRANIUM_RUNTIME/bar_updates.arch)"
aur_count="$(wc -l < $VIBRANIUM_RUNTIME/bar_updates.aur)"

helpers::check VIBRANIUM_BAR_PACMAN_MODULE_SHOW_ZERO_UPDATES
if [[ $VIBRANIUM_BAR_PACMAN_MODULE_SHOW_ZERO_UPDATES == false ]] ; then
    total_count=$(( arch_count + aur_count ))
    if [[ $total_count -eq 0 ]]; then
        printf '{"text": ""}'
        exit 0
    fi
fi

arch_info="$VIBRANIUM_RUNTIME/bar_updates.arch"
aur_info="$VIBRANIUM_RUNTIME/bar_updates.aur"

tooltip="$(make_tooltip "$arch_info" "$aur_info")"

if [[ "$VIBRANIUM_BAR_SHOW_SEPARATOR" == true ]]; then
    text="<span foreground='DimGray'>|</span> "
fi

icon="<span rise='1pt' foreground='CornflowerBlue'>󰏔</span>"
text+="$icon $((arch_count + aur_count))"

jq -nc \
    --arg text "$text" \
    --arg tooltip "$tooltip" \
    '{text: $text, tooltip: $tooltip}'

