#!/usr/bin/env bash

source $VIBRANIUM_PATH/vb-core-defaults
source $XDG_CONFIG_HOME/vibranium/settings

if [[ "$VIBRANIUM_BAR_PACMAN_MODULE_ENABLE" == false ]]; then
    printf '{"text": ""}'
    exit 0
fi

if ! command -v checkupdates > /dev/null; then
    text="<span  foreground='red2'>\uf071</span>"
    tooltip="Unable to fetch updates!\n"
    tooltip="Missing dependencies: pacman-contrib"
    printf '{"text": "%s", "tooltip": "%s"}' "$text" "$tooltip"
    exit 0
fi

spinner() {
    local tooltip="$1"
    local delay=0.1
    local spinstr=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

    format_text() {
        local text="$1"
        if [[ "$VIBRANIUM_BAR_SHOW_SEPARATOR" == true ]]; then
            text="<span foreground='DimGray'>|</span> "
            text+="$1"
        fi
        printf '%s' "$text"
    }

    for i in "${spinstr[@]}"; do
        frame="$(format_text "<span foreground='gray'>$i</span>")"

        jq -nc \
          --arg text "$frame" \
          --arg tooltip "$tooltip" \
          '{text:$text, tooltip:$tooltip}'

        sleep "$delay"
    done
}

is_connected() {
    while ! ping 8.8.8.8 -c 1 &> /dev/null; do
        sleep 1
    done
}

make_tooltip() {
    local files=("$@")
    local any=false
    for f in "${files[@]}"; do
        [[ -s "$f" ]] && any=true && break
    done
    $any || { echo ""; return; }

    awk '
    function trim(s) { sub(/^[ \t\r\n]+/, "", s); sub(/[ \t\r\n]+$/, "", s); return s }
    {
        arrow = index($0, "->")
        if (arrow) {
            left = trim(substr($0, 1, arrow-1))
            right = trim(substr($0, arrow+2))
            split(left, a, /[ \t]+/)
            pkg = a[1]
            old = (length(a) >= 2 ? a[2] : "")
            new = right
        } else {
            pkg = $1
            old = $2
            new = $4
        }
        pkgs[NR]=pkg
        olds[NR]=old
        news[NR]=new
        if (length(pkg) > max_pkg) max_pkg = length(pkg)
        if (length(old) > max_old) max_old = length(old)
        n = NR
    }
    END {
        arrow_colored = "<span foreground=\"gray\">-></span>"
        for (i=1; i<=n; i++) {
            if (pkgs[i] == "") {
                if (olds[i] != "" || news[i] != "") {
                    printf "%s %s %s\n", olds[i], arrow_colored, news[i]
                }
            } else {
                pkg_fmt = sprintf("%-*s", max_pkg, pkgs[i])
                old_fmt = sprintf("%-*s", max_old, olds[i])
                gsub(/.*/, "<span foreground=\"CornflowerBlue\">&</span>", pkg_fmt)
                gsub(/.*/, "<span foreground=\"red2\">&</span>", old_fmt)
                new_colored = "<span foreground=\"green3\">" news[i] "</span>"
                printf "%s %s %s %s\n", pkg_fmt, old_fmt, arrow_colored, new_colored
            }
        }
    }
    ' "${files[@]}"
}

get_arch_updates() { checkupdates --nocolor; }
get_aur_updates() { yay -Qua 2> /dev/null; }

is_connected

marker="$VIBRANIUM_RUNTIME/bar_updates.$(pidof waybar)"
if [[ -f $marker ]]; then
    show_spinner=false
else
    show_spinner=true
    rm -f "${marker%.*}".*
    : > $marker
fi

(get_arch_updates > $VIBRANIUM_RUNTIME/bar_updates.arch) &
arch_pid=$!

(get_aur_updates > $VIBRANIUM_RUNTIME/bar_updates.aur) &
aur_pid=$!

if [[ $show_spinner == true ]]; then
    while kill -0 $arch_pid 2> /dev/null || kill -0 $aur_pid 2> /dev/null; do
        spinner "Fetching updates..."
    done
fi

wait $arch_pid $aur_pid

arch_count="$(wc -l < $VIBRANIUM_RUNTIME/bar_updates.arch)"
aur_count="$(wc -l < $VIBRANIUM_RUNTIME/bar_updates.aur)"

arch_info="$VIBRANIUM_RUNTIME/bar_updates.arch"
aur_info="$VIBRANIUM_RUNTIME/bar_updates.aur"

tooltip="$(make_tooltip "$arch_info" "$aur_info")"

if [[ "$VIBRANIUM_BAR_SHOW_SEPARATOR" == true ]]; then
    text="<span foreground='DimGray'>|</span> "
fi

icon="<span rise='1pt' foreground='CornflowerBlue'>󰏔</span>"
text+="$icon $((arch_count + aur_count))"

jq -nc \
    --arg text "$text" \
    --arg tooltip "$tooltip" \
    '{text: $text, tooltip: $tooltip}'

