#!/bin/bash

source vb-lib-cli

# Template rendering consumes the staged palette, expands placeholders through
# the external awk engine, and writes user or built-in outputs according to
# precedence and force rules.

# When invoked by vb-theme-set, rendering targets NEXT_THEME_DIR and leaves
# the committed theme untouched until the caller swaps directories. The awk
# status is not propagated here, so a failed or partial render can be committed.
TEMPLATES_DIR="$VIBRANIUM/default/themed"
USER_TEMPLATES_DIR="$XDG_CONFIG_HOME/vibranium/themed"
NEXT_THEME_DIR="$VIBRANIUM_CACHE/next-theme"
COLORS_FILE="$NEXT_THEME_DIR/colors.list"

# Scoped force entries use NEXT_THEME_NAME from vb-theme-set because the
# on-disk theme.name identifies the active tree; standalone invocation uses
# that file directly.
if [[ -n "${NEXT_THEME_NAME:-}" ]]; then
  :
else
  IFS= read -r NEXT_THEME_NAME < "$VIBRANIUM_STATE/theme.name" || [[ -n $NEXT_THEME_NAME ]]
fi

# Resolve LIGHT from theme.info in the supplied directory; absent metadata
# reads as dark. This supports standalone calls that lack VB_THEME_IS_LIGHT.
theme::resolve_is_light() {
  local -n _ril_out=$1
  local theme_dir="$2" light="" key val

  if [[ -f "$theme_dir/theme.info" ]]; then
    while IFS='=' read -r key val; do
      if [[ $key == LIGHT ]]; then
        light="$val"
      fi
    done < "$theme_dir/theme.info"
  fi

  if [[ "$light" == true ]]; then
    _ril_out=true
  else
    _ril_out=false
  fi
}

# Use the exported mode when available; standalone calls resolve LIGHT from
# the staged theme.info. The value is passed to awk as the is_light lookup.
if [[ -n "${VB_THEME_IS_LIGHT:-}" ]]; then
  is_light="$VB_THEME_IS_LIGHT"
else
  theme::resolve_is_light is_light "$NEXT_THEME_DIR"
  log Info "VB_THEME_IS_LIGHT not set (standalone invocation), resolved locally: is_light=$is_light"
fi

# force_template_files controls regeneration of existing outputs; user entries
# are merged from settings.advanced below.
force_template_files=()


_settings_adv="$XDG_CONFIG_HOME/vibranium/settings.advanced"
if [[ -f $_settings_adv ]]; then
  log Info "sourcing settings.advanced"
  source "$_settings_adv"
fi

unset _settings_adv


if [[ -v vb_force_template_files ]]; then
  force_template_files+=("${vb_force_template_files[@]}")
  log Info "${#force_template_files[@]} file(s) will be generated forefully"
fi

# Rendering requires a colors.list palette in the staged directory.
color_sources=()
if [[ -f $COLORS_FILE ]]; then
  color_sources+=("$COLORS_FILE")
  log Info "found palette: $COLORS_FILE"
fi

# A missing palette skips the render pass and leaves staged outputs unchanged.
if [[ ${#color_sources[@]} -gt 0 ]]; then
  # Flatten color files into key<SOH>value records for awk. SOH is expected to
  # be absent from keys and values; this delimiter choice is not independently
  # validated.
  subs_file="$VIBRANIUM_RUNTIME/${0##*/}.subs"

  for src in "${color_sources[@]}"; do
    while IFS='=' read -r key value; do
      # Strip quotes and spaces from the key side of "key = "value"".
      key="${key//[\"\' ]/}"

      # Blank lines produce an empty key; comment lines retain a leading # and
      # are rejected by the key check below.
      if [[ ! $key || $key == \#* ]]; then
        continue
      fi

      # Pull out whatever sits between the first pair of quotes on the
      # value side; this also quietly drops a trailing inline comment,
      # since anything after the closing quote is discarded.
      value="${value#*[\"\']}"
      value="${value%%[\"\']*}"

      printf '%s\x01%s\n' "$key" "$value"
    done < "$src"
  done > "$subs_file"

  # Add is_light as an ordinary substitution record; the awk engine's mode-
  # relative operations and block directives consume that key directly.
  printf 'is_light\x01%s\n' "$is_light" >> "$subs_file"

  shopt -s nullglob

  # Map each selected template to its output path; tpl_files is the render set.
  outmap_file="$VIBRANIUM_RUNTIME/${0##*/}.outmap"
  declare -A seen_outputs
  tpl_files=()

  # A block redirect keeps a single file descriptor open for all printf
  # writes rather than reopening the file on each iteration with >>. User
  # templates precede built-in templates, so user versions claim their output
  # filename first and built-in duplicates are dropped by the seen_outputs check.
  {
    for tpl_dir in "$USER_TEMPLATES_DIR" "$TEMPLATES_DIR"; do
      for tpl in "$tpl_dir"/*.tpl; do
        filename="${tpl##*/}"       # drop the directory part
        filename="${filename%.tpl}" # drop the .tpl extension

        output_path="$NEXT_THEME_DIR/$filename"

        # Render this template only if nothing higher-priority already
        # claimed the same output path this run, and either the output
        # does not already exist on disk, or it matches a pattern in
        # force_template_files (bash glob wildcards supported).
        if [[ -z ${seen_outputs[$output_path]+x} ]]; then
          should_write=false

          # Force entries are evaluated in order. A scoped positive entry
          # enables one theme/file pair, while a matching negated entry
          # vetoes the output and stops further force evaluation.
          if [[ ! -f $output_path ]]; then
            should_write=true
          else
            for _entry in "${force_template_files[@]}"; do
              _pat="$_entry"
              _negate=0
              [[ $_entry == '!'* ]] && {
                _negate=1
                _pat="${_entry#!}"
              }
              if [[ $_pat == */* ]]; then
                _theme_pat="${_pat%%/*}"
                _file_pat="${_pat#*/}"
                if [[ -n $NEXT_THEME_NAME ]]; then
                  # shellcheck disable=SC2053
                  if ! [[ $NEXT_THEME_NAME == $_theme_pat ]]; then
                    continue
                  fi
                  # shellcheck disable=SC2053
                  if [[ $filename != $_file_pat ]]; then
                    continue
                  fi
                  if ((_negate)); then
                    should_write=false
                    break
                  fi
                  should_write=true
                fi
              else
                # shellcheck disable=SC2053
                [[ $filename == $_pat ]] || continue
                if ((_negate)); then
                  should_write=false
                  break
                fi
                should_write=true
              fi
            done
          fi

          if $should_write; then
            printf '%s\x01%s\n' "$tpl" "$output_path"
            tpl_files+=("$tpl")
            seen_outputs["$output_path"]=1
          fi
        fi
      done
    done
  } > "$outmap_file"

  # Hand the color table, output map, and selected templates to one awk
  # process. The argument order preloads both maps; temporary maps are removed
  # after awk returns, while the caller owns the commit decision.
  if ((${#tpl_files[@]} > 0)); then
    log Info "rendering ${#tpl_files[@]} templates via awk"
    awk -f "$VIBRANIUM/awk/vb-theme-set-templates.awk" \
      "$subs_file" "$outmap_file" "${tpl_files[@]}"
  else
    log Info "no templates to render (all outputs already exist or forced)"
  fi

  rm -f "$outmap_file" "$subs_file"
  log Info "template processing complete"
fi
