#!/bin/bash

source vb-lib-cli

# VIBRANIUM THEME TEMPLATES
#
# If you ended up reading this file because you went looking for how your
# theme actually gets applied to your config files, you are in the right
# place. This script is the one that takes the colors from your current
# theme and writes them into every app's config file. The actual color
# math (lightening a color, rotating a hue, and so on) lives in a separate
# awk script that this file calls at the very end; you do not need to know
# awk to use any of what is described below.
#
# WHERE YOUR COLORS COME FROM
#
#   Every theme directory contains one palette file:
#
#     colors.list
#       The Vibranium palette: one shade of each named color (black, red,
#       pink, green, yellow, orange, blue, purple, cyan, white, gray,
#       accent), plus a seven-step background ramp (background_h,
#       background_0 through background_5) and a seven-step foreground
#       ramp (foreground_h, foreground_0 through foreground_5).
#       Having this many colors already defined means a template rarely
#       needs to compute a shade on the fly, it can usually just reference
#       the right step directly.
#
#   If a theme does not provide this file, there is nothing to render with
#   and no templates are processed at all.
#
# WHERE TEMPLATES LIVE
#
#   A template is just a normal config file for some app, with placeholders
#   dropped in where a color should go. Templates are picked up from two
#   places, checked in this order:
#
#     $XDG_CONFIG_HOME/vibranium/themed/   (your own templates)
#     $VIBRANIUM/default/themed/           (the ones Vibranium ships with)
#
#   If you drop a template into your own themed/ folder with the same name
#   as a built-in one, yours is used instead. This is the normal way to
#   customize how a particular app gets themed without editing anything
#   under $VIBRANIUM itself.
#
#   A template is named after the file it produces, with a .tpl suffix
#   marking it as a template:
#
#     foo.tpl      renders to a file simply named foo
#
# WRITING A PLACEHOLDER
#
#   Inside a template, a placeholder looks like {{ something }}, two curly
#   braces on each side with the key in between. The plain form just drops
#   the color value in as it is written in the TOML file:
#
#     {{ background }}            ->  #1e1e2e
#
#   A few suffixes change how the same color is written out:
#
#     {{ background_strip }}      ->  1e1e2e        (no leading #)
#     {{ background_upper }}      ->  #1E1E2E        (uppercased)
#     {{ background_lower }}      ->  #1e1e2e        (lowercased)
#     {{ background_0x }}         ->  0x1e1e2e       (0x instead of #)
#
#   If your color includes an alpha byte (an 8-character hex value like
#   #1e1e2ecc, the last two digits being transparency), the four forms
#   above all carry it through untouched.
#
#   For apps that want a color split into channels instead of one hex
#   string, these suffixes are available on any color key:
#
#     {{ color4_r }}   {{ color4_g }}   {{ color4_b }}     red/green/blue, 0-255 each
#     {{ color4_rgb }}                                     all three, comma separated
#     {{ color4_h }}   {{ color4_s }}   {{ color4_l }}     hue 0-359, saturation/lightness 0-100
#     {{ color4_hsl }}                                     all three, comma separated
#     {{ color4_w }}                                       HWB whiteness, 0-100
#     {{ color4_hwb }}                                     hue, whiteness, blackness, comma separated
#
#   Any non-color values in your TOML files (a font name, for example) only
#   support the plain, _upper, _lower, and _strip forms, since there is no
#   color to extract a channel from.
#
# RECOLORING ON THE FLY
#
#   Sometimes a template needs a shade that nobody defined anywhere. Rather
#   than asking the theme author to add it, you can compute it right inside
#   the placeholder by adding one or more "|operation=value" pieces after
#   the key:
#
#     {{ color4|lightness=0.8 }}
#
#   This takes color4, reinterprets it through lightness, and gives back a
#   normal hex value, lighter than the original. You can chain several
#   operations, each one separated by another |, and they are applied in
#   the order you write them:
#
#     {{ color4|lightness=0.8|alpha=0.5 }}
#
#   Which operations make sense depends on the shape of the placeholder:
#
#     On a plain or hex-variant key ({{ key }}, _strip, _upper, _lower, _0x):
#       alpha=0.0 to 1.0        makes the color partly transparent
#       lightness=N             see "setting versus shifting" below
#
#     On an _rgb key:
#       alpha=0.0 to 1.0        adds a transparency value as a fourth number
#       red=N, green=N, blue=N  nudges one channel up or down, clamped 0-255
#       lightness=N             same lightness behavior as above, then
#                                rebuilt back into red/green/blue
#
#     On an _hsl key:
#       lighten=N, darken=N     moves lightness up or down by N points
#       saturate=N, desaturate=N   moves saturation up or down by N points
#       hue=N                   rotates the hue by N degrees, wrapping
#                                around at 360
#
#     On an _hwb key:
#       whiten=N, blacken=N     moves whiteness or blackness by N points
#       hue=N                   same hue rotation as above
#
#     On a single-channel key (_r, _g, _b, _h, _s, _l, _w):
#       lightness=N             nudges or sets that one channel directly,
#                                see "setting versus shifting" below
#
#   Setting versus shifting: write lightness=0.75 (no sign) to set the
#   value to exactly that amount, or lightness=+0.15 / lightness=-0.10
#   (with a sign) to shift it up or down from whatever it already is. The
#   same plain-number-versus-signed-number rule is what the single-channel
#   lightness operation above follows too, even on channels that are not
#   lightness, like hue or whiteness.
#
#   alpha does not follow that rule. There is no "current alpha" for a
#   sign to shift relative to, so alpha is always an absolute value:
#   write alpha=0.5, not alpha=+0.5 or alpha=-0.5. A leading sign is
#   dropped and a warning is printed to stderr rather than being applied.
#
#   Numbers can be written as 0.20 or .20, both work the same way.
#
#   One thing worth knowing before you chain operations: red=/green=/blue=
#   and lightness= both end up changing the color's red/green/blue values,
#   but lightness gets there by rebuilding the color from scratch through
#   hue, saturation, and lightness. If you apply a channel nudge first and
#   then lightness, the nudge gets overwritten:
#
#     {{ color4_rgb|lightness=0.8|blue=-30 }}   the nudge survives
#     {{ color4_rgb|blue=-30|lightness=0.8 }}   the nudge is lost
#
#   Put lightness first if you need to combine the two.
#
# IF SOMETHING LOOKS WRONG
#
#   - A placeholder that does not match anything (a typo in the key name,
#     or an operation that refers to a color nobody defined) is left
#     exactly as written in the generated file, rather than being replaced
#     with something blank. If you ever see a literal {{ ... }} in a
#     config file Vibranium generated, that is the engine telling you it
#     could not find what you asked for.
#   - Hue rotation and saturation changes do nothing visible on a pure
#     grey, since a grey has no hue or saturation to begin with.
#   - Adding alpha to a hex color produces an 8-character value
#     (#rrggbbaa). Some apps only accept 6-character hex and will not
#     accept that, so use alpha sparingly on keys destined for those.
#   - By default, if a file already exists in your active theme folder
#     (because the theme author shipped it directly, not as a template),
#     Vibranium leaves it alone instead of overwriting it with the
#     template output. If you want a particular file to always be
#     regenerated from its template regardless, add it to
#     vb_force_template_files in your settings.advanced, either as a
#     plain filename to force it for every theme, or as
#     "theme-name/filename" to force it only for that one theme.

TEMPLATES_DIR="$VIBRANIUM/default/themed"
USER_TEMPLATES_DIR="$XDG_CONFIG_HOME/vibranium/themed"
NEXT_THEME_DIR="$XDG_CONFIG_HOME/vibranium/current/next-theme"
COLORS_FILE="$NEXT_THEME_DIR/colors.list"

# vb-theme-set writes the plain theme name here right before this script
# runs, so we can match "theme-name/file.ext" scoped entries below.
NEXT_THEME_NAME=$(< "$XDG_CONFIG_HOME/vibranium/current/theme.name")

# theme::resolve_is_light <theme_dir> <folder_name>
#
# Local light/dark resolver, mirroring the priority order vb-theme-set's
# own discovery map establishes:
#
#   1. theme.info's LIGHT= field, if theme.info exists and sets it.
#   2. folder_name matched against the (light|latte|dawn)$ regex, as a
#      last resort when there is no LIGHT= field.
#
# theme_dir is whatever directory theme.info would live in - here, the
# staged next-theme directory COLORS_FILE above already points
# at. folder_name is only used for the regex fallback; it does not have
# to match theme_dir's own basename (the staged next-theme directory is
# never named after the theme).
#
# Prints "true" or "false" on stdout:
#   is_light=$(theme::resolve_is_light "$NEXT_THEME_DIR" "$NEXT_THEME_NAME")
theme::resolve_is_light() {
  local theme_dir="$1" folder_name="$2" light="" key val

  if [[ -f "$theme_dir/theme.info" ]]; then
    while IFS='=' read -r key val; do
      if [[ $key == LIGHT ]]; then
        light="$val"
      fi
    done < "$theme_dir/theme.info"
  fi

  if [[ -z "$light" ]]; then
    if [[ "$folder_name" =~ (light|latte|dawn)$ ]]; then
      light="true"
    else
      light="false"
    fi
  fi

  printf '%s' "$light"
}

# Theme-mode detection, fed into the awk engine below as an ordinary
# "is_light" entry in the subs table (see the printf near the end of the
# color_sources block). vb-theme-set normally resolves this itself and
# exports VB_THEME_IS_LIGHT before calling this script, so the common case
# is just reading that back. But this script is documented above as being
# invocable on its own, so it cannot assume that export exists: if it's
# missing, fall back to resolving it locally via the exact same
# theme::resolve_is_light priority vb-theme-set uses, reading theme.info
# straight out of the staged next-theme directory that COLORS_FILE
# above already points at.
if [[ -n "${VB_THEME_IS_LIGHT:-}" ]]; then
  is_light="$VB_THEME_IS_LIGHT"
else
  is_light="$(theme::resolve_is_light "$NEXT_THEME_DIR" "$NEXT_THEME_NAME")"
  log Info "VB_THEME_IS_LIGHT not set (standalone invocation), resolved locally: is_light=$is_light"
fi

# Filenames in this list always get regenerated from their template, even
# when a file of that name already exists in the theme folder. Built-in
# entries go here; anything the user added in ~/.config/vibranium/settings.advanced
# is merged in further down.
force_template_files=()

# This script can be invoked on its own, without the rest of the settings
# environment already loaded, so settings.advanced is sourced explicitly
# here to pick up vb_force_template_files.
_settings_adv="$XDG_CONFIG_HOME/vibranium/settings.advanced"
if [[ -f $_settings_adv ]]; then
  log Info "sourcing settings.advanced"
  source "$_settings_adv"
fi

unset _settings_adv

# Append the user-defined forced template files, if any, from the advanced settings.
# (vb_force_template_files is sourced from ~/.config/vibranium/settings.advanced)
if [[ -v vb_force_template_files ]]; then
  force_template_files+=("${vb_force_template_files[@]}")
  log Info "${#vb_force_template_files[@]} file(s) will be generated forefully"
fi

# Gather the theme palette. A theme without colors.list has
# nothing to render with, so the whole run is skipped further down.
color_sources=()
if [[ -f $COLORS_FILE ]]; then
  color_sources+=("$COLORS_FILE")
  log Info "found palette: $COLORS_FILE"
fi

if [[ ${#color_sources[@]} -gt 0 ]]; then
  # Flatten every available color file into one "key<SOH>value" table for
  # awk to read. SOH (\x01) is used as the separator because it cannot
  # appear in either a placeholder name or a TOML value, so no escaping of
  # the values themselves is ever needed.
  subs_file="$VIBRANIUM_RUNTIME/${0##*/}.subs"

  for src in "${color_sources[@]}"; do
    while IFS='=' read -r key value; do
      # Strip quotes and spaces from the key side of "key = "value"".
      key="${key//[\"\' ]/}"

      # Blank lines and comment lines both produce an empty key here, so
      # one check filters both out.
      if [[ ! $key || $key == \#* ]]; then
        continue
      fi

      # Pull out whatever sits between the first pair of quotes on the
      # value side; this also quietly drops a trailing inline comment,
      # since anything after the closing quote is discarded.
      value="${value#*[\"\']}"
      value="${value%%[\"\']*}"

      printf '%s\x01%s\n' "$key" "$value"
    done < "$src"
  done > "$subs_file"

  # Theme-mode flag for the awk engine's dim=/pop=/light=/dark=/{{ #light }}
  # primitives (section 2 of the theme-variant-aware-templates spec). This
  # is deliberately an ordinary line in the same key\x01value shape as
  # every color above it, not a special case: {{ is_light }} resolves via
  # the completely ordinary token lookup in the awk engine, same as any
  # other key.
  printf 'is_light\x01%s\n' "$is_light" >> "$subs_file"

  shopt -s nullglob

  # outmap_file tells awk which output path each template renders to.
  # tpl_files is the actual list of templates that made the cut and will
  # be handed to awk for rendering.
  outmap_file="$VIBRANIUM_RUNTIME/${0##*/}.outmap"
  declare -A seen_outputs
  tpl_files=()

  # A block redirect keeps a single file descriptor open for all printf
  # writes rather than reopening the file on each iteration with >>. The
  # loop visits user templates before built-in ones, so user versions claim
  # their output filename first and built-in duplicates are dropped by the
  # seen_outputs check below.
  {
    for tpl_dir in "$USER_TEMPLATES_DIR" "$TEMPLATES_DIR"; do
      for tpl in "$tpl_dir"/*.tpl; do
        filename="${tpl##*/}"       # drop the directory part
        filename="${filename%.tpl}" # drop the .tpl extension

        output_path="$NEXT_THEME_DIR/$filename"

        # Render this template only if nothing higher-priority already
        # claimed the same output path this run, and either the output
        # does not already exist on disk, or it matches a pattern in
        # force_template_files (bash glob wildcards supported).
        if [[ -z ${seen_outputs[$output_path]+x} ]]; then
          should_write=false

          if [[ ! -f $output_path ]]; then
            should_write=true
          else
            for _entry in "${force_template_files[@]}"; do
              _pat="$_entry"
              _negate=0
              [[ $_entry == '!'* ]] && {
                _negate=1
                _pat="${_entry#!}"
              }
              if [[ $_pat == */* ]]; then
                _theme_pat="${_pat%%/*}"
                _file_pat="${_pat#*/}"
                if [[ -n $NEXT_THEME_NAME ]]; then
                  # shellcheck disable=SC2053
                  if ! [[ $NEXT_THEME_NAME == $_theme_pat ]]; then
                    continue
                  fi
                  # shellcheck disable=SC2053
                  if ! [[ $filename == $_file_pat ]]; then
                    continue
                  fi
                  if ((_negate)); then
                    should_write=false
                    break
                  fi
                  should_write=true
                fi
              else
                # shellcheck disable=SC2053
                [[ $filename == $_pat ]] || continue
                if ((_negate)); then
                  should_write=false
                  break
                fi
                should_write=true
              fi
            done
          fi

          if $should_write; then
            printf '%s\x01%s\n' "$tpl" "$output_path"
            tpl_files+=("$tpl")
            seen_outputs["$output_path"]=1
          fi
        fi
      done
    done
  } > "$outmap_file"

  # Hand everything off to the awk engine in one call: the color table,
  # the output map, then every template that needs rendering.
  if ((${#tpl_files[@]} > 0)); then
    log Info "rendering ${#tpl_files[@]} templates via awk"
    awk -f "$VIBRANIUM/awk/vb-theme-set-templates.awk" \
      "$subs_file" "$outmap_file" "${tpl_files[@]}"
  else
    log Info "no templates to render (all outputs already exist or forced)"
  fi

  rm -f "$outmap_file" "$subs_file"
  log Info "template processing complete"
fi
