#!/usr/bin/bash

if [[ "$CHASSIS_TYPE" == vm ]]; then
  echo "Not available in a VM" >&2
  exit 1
fi

source vb-lib-core

_operation_canceled() {
  printf "%s[VIBRANIUM]%s Operation canceled" "$RED" "$RESET"
  # shellcheck disable=SC2034
  read -n1 -r -s -p $'. Press any key to exit' dummy

  term::enable_input
}

_operation_complete() {
  printf "%s[VIBRANIUM]%s " "$GREEN" "$RESET"
  # shellcheck disable=SC2034
  read -n1 -r -p $'Setup complete. Press any key to exit ' dummy

  term::enable_input
}

trap '_operation_canceled; exit 1' INT TERM HUP
term::disable_input

if [[ -f "$VIBRANIUM_STATE/secure-boot-setup.complete" ]]; then
  term::show_header --color red
  echo -e "${RED}[VIBRANIUM]${RESET} Setup has been done. Pending reboot."
  _operation_canceled
  exit 1
fi

if [[ ! -f /sys/firmware/efi/fw_platform_size ]]; then
  term::show_header --color red
  echo -e "${RED}[VIBRANIUM]${RESET} Not in ${CYAN}UEFI${RESET} mode"
  _operation_canceled
  exit 1
fi

# Get the current boot entry via bootctl.
# If it has a .efi extension, systemd-boot is using a UKI.
# If it's a .conf file, it's a standard Boot Loader Specification (BLS) entry.
# This single check tells us both:
#   1) that systemd-boot is active,
#   2) which boot type is in use (UKI or BLS).
CURRENT_ENTRY=$(bootctl status 2>/dev/null | awk -F': ' '/Current Entry/ {print $2}')

if [[ ! "$CURRENT_ENTRY" == *.efi ]]; then
  term::show_header --color red
  echo -e "${RED}[VIBRANIUM]${RESET} Only ${CYAN}UKI${RESET} method is supported"
  echo -e "${RED}[VIBRANIUM]${RESET} A ${CYAN}Unified Kernel Image (UKI)${RESET} is a single ${CYAN}.efi${RESET} file bundling the kernel, initramfs,"
  echo -e "${RED}[VIBRANIUM]${RESET} and boot parameters — required for Secure Boot signing to work end-to-end."
  echo -e "${RED}[VIBRANIUM]${RESET} See: ${CYAN}https://wiki.archlinux.org/title/Unified_kernel_image${RESET}"
  _operation_canceled
  exit 1
fi

# Safely glob efivars — nullglob prevents literal pattern on no-match
shopt -s nullglob

SECUREBOOT_EFIVAR=(/sys/firmware/efi/efivars/SecureBoot-*)
SETUP_MODE_EFIVAR=(/sys/firmware/efi/efivars/SetupMode-*)

shopt -u nullglob

if [[ ${#SECUREBOOT_EFIVAR[@]} -eq 0 || ${#SETUP_MODE_EFIVAR[@]} -eq 0 ]]; then
  term::show_header --color red
  echo -e "${RED}[VIBRANIUM]${RESET} Could not locate Secure Boot EFI variables"
  echo -e "${RED}[VIBRANIUM]${RESET} Is the system booted in UEFI mode with efivars mounted?"
  _operation_canceled
  exit 1
fi

if [[ ${#SECUREBOOT_EFIVAR[@]} -gt 1 || ${#SETUP_MODE_EFIVAR[@]} -gt 1 ]]; then
  term::show_header --color red
  echo -e "${YELLOW}[VIBRANIUM]${RESET} Warning: multiple EFI variable files found for the same name"
  echo -e "${YELLOW}[VIBRANIUM]${RESET} SecureBoot matches: ${SECUREBOOT_EFIVAR[*]}"
  echo -e "${YELLOW}[VIBRANIUM]${RESET} SetupMode matches:  ${SETUP_MODE_EFIVAR[*]}"
  echo -e "${YELLOW}[VIBRANIUM]${RESET} Using first match — inspect your efivars if this looks wrong"
fi

# Read first data byte (skip 4-byte attribute header), strip whitespace
SECUREBOOT_RAW=$(od -An -t u1 -j4 -N1 "${SECUREBOOT_EFIVAR[0]}" | tr -d ' ')
SETUP_MODE_RAW=$(od -An -t u1 -j4 -N1 "${SETUP_MODE_EFIVAR[0]}" | tr -d ' ')

if ((SECUREBOOT_RAW == 1)); then
  term::show_header --color green
  echo -e "${GREEN}[VIBRANIUM]${RESET} ${CYAN}Secure Boot${RESET} is already active."
  echo -e "${GREEN}[Vibranium]${RESET} See ${GREEN}sbctl ${YELLOW}--help${RESET} for more info."
  _operation_complete
  exit 0
fi

if ((SETUP_MODE_RAW == 0)); then
  term::show_header --color red
  echo -e "${RED}[VIBRANIUM]${RESET} Secure Boot cannot be enabled: firmware is locked (Setup Mode is off)"
  echo -e "${RED}[VIBRANIUM]${RESET} Enter BIOS and enable Setup Mode first"
  _operation_canceled
  exit 1
fi

term::show_header

if term::ask_yes_no Y "You're about to setup Secure Boot. Continue?"; then
  echo -e "${YELLOW}[VIBRANIUM]${RESET} To work with efivars, Vibranium needs sudo"
  # Keep sudo credentials window open, just in case.
  # The subshell's pid is later killed.
  (while true; do
    sudo -v
    sleep 5
  done) &
  sudo_pid=$!
else
  _operation_canceled
  exit 1
fi

# Check NVRAM is actually writable before doing anything destructive
_efi_nvram_writable() {
  findmnt -n -o OPTIONS /sys/firmware/efi/efivars 2>/dev/null | grep -q '\brw\b' || return 1

  # Canary write — catches firmware that reports rw but silently drops writes
  local canary="/sys/firmware/efi/efivars/VibraniumProbe-00000000-0000-0000-0000-000000000000"
  printf '\x07\x00\x00\x00\x00' | sudo tee "$canary" &>/dev/null || return 1
  sudo chattr -i "$canary" 2>/dev/null
  sudo rm -f "$canary" 2>/dev/null
  return 0
}

if ! _efi_nvram_writable; then
  echo -e "${RED}[VIBRANIUM]${RESET} EFI NVRAM is not writable — key enrollment will fail"
  echo -e "${RED}[VIBRANIUM]${RESET} Try: ${RED}sudo ${GREEN}mount ${YELLOW}-o ${BLUE}remount,rw ${PURPLE}/sys/firmware/efi/efivars${RESET}"
  _operation_canceled
  exit 1
fi

# Use bootctl (already required) as the primary and most reliable ESP locator.
# Fall back to well-known mount points only when bootctl comes up empty.
ESP_MOUNT=$(bootctl --print-esp-path 2>/dev/null)

if [[ -z "$ESP_MOUNT" ]]; then
  if [[ -d /boot/efi ]]; then
    ESP_MOUNT=/boot/efi
  elif [[ -d /efi ]]; then
    ESP_MOUNT=/efi
  fi
fi

if [[ -z "$ESP_MOUNT" ]] || [[ ! -d "$ESP_MOUNT" ]]; then
  echo -e "${RED}[VIBRANIUM]${RESET} Could not locate a valid ESP mount point"
  _operation_canceled
  exit 1
fi

if ! command -v sbctl >/dev/null; then
  echo -e "${YELLOW}[VIBRANIUM]${RESET} ${CYAN}sbctl${RESET} not found"
  vb-pkg-install --embedded -- sbctl
fi

sudo sbctl --quiet create-keys &
if ! term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Creating Secure Boot keys" "- ${GREEN}Done${RESET}"; then
  echo -e "${RED}[VIBRANIUM]${RESET} Failed to create keys"
  _operation_canceled
  exit 1
fi

sudo sbctl --quiet enroll-keys --microsoft --firmware-builtin &
if ! term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Enrolling keys into firmware" "- ${GREEN}Done${RESET}"; then
  echo -e "${RED}[VIBRANIUM]${RESET} Key enrollment failed"
  _operation_canceled
  exit 1
fi

EFI_FILES=()

# Find all ESP files to sign
while IFS= read -r f; do
  EFI_FILES+=("$f")
done < <(sudo find "$ESP_MOUNT" -type f \( -iname '*.efi' \))

for file in "${EFI_FILES[@]}"; do
  echo -e "${YELLOW}[VIBRANIUM]${RESET} Signing ${CYAN}$file${RESET}"
  if ! sudo sbctl --quiet sign --save "$file"; then
    echo -e "${RED}[VIBRANIUM]${RESET} Failed to sign $file"
    echo -e "${YELLOW}[VIBRANIUM]${RESET} Rolling back: unenrolling keys from firmware"
    sudo sbctl --quiet reset
    _operation_canceled
    exit 1
  fi
done

sudo mkinitcpio -P &>/dev/null &
if ! term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Regenerating mkinitcpio" "- ${GREEN}Done${RESET}"; then
  echo -e "${RED}[VIBRANIUM]${RESET} Failed to regenerate initramfs"
  echo -e "${RED}[VIBRANIUM]${RESET} ${YELLOW}Warning${RESET}: your system may be unbootable without a valid initramfs."
  echo -e "${RED}[VIBRANIUM]${RESET} Before rebooting, open another terminal and run: ${RED}sudo ${GREEN}mkinitcpio ${YELLOW}-P${RESET}"
  _operation_canceled
  exit 1
fi

for file in "${EFI_FILES[@]}"; do
  if [[ "$file" == */Microsoft/* ]]; then
    echo -e "${GREEN}[VIBRANIUM]${RESET} Microsoft keys were enrolled alongside yours,"
    echo -e "${GREEN}[VIBRANIUM]${RESET} so your Windows installation will continue to boot as usual"
    break
  fi
done

QUIRK_URLS=$(sudo sbctl status 2>/dev/null | grep -oP 'https://\S+')

if [[ -n "$QUIRK_URLS" ]]; then
  echo -e "${YELLOW}[VIBRANIUM]${RESET} Your firmware has known quirks that may affect security:"
  while IFS= read -r url; do
    echo -e "             ${CYAN}$url${RESET}"
  done <<<"$QUIRK_URLS"
fi

kill $sudo_pid
touch "$VIBRANIUM_STATE/secure-boot-setup.complete"

echo -e "${GREEN}[VIBRANIUM]${RESET} Secure Boot setup complete"
if term::ask_yes_no Y "Restart is required. Reboot now?"; then
  for sec in {5..1}; do
    for step in {0..3}; do
      dots=$(printf "%.*s" "$step" "...")
      printf "\r\033[K%s[VIBRANIUM]%s Restarting in %d%s" \
        "$GREEN" "$RESET" "$sec" "$dots"
      sleep 0.25
    done
  done

  systemctl reboot
else
  _operation_complete
fi
