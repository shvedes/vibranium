#!/bin/bash

VERBOSE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Output disk usage for all mounted devices for Waybar.

Options:
  -v, --verbose     Enable verbose output
  -h, --help        Show this help and exit

EOF
}

while (($# > 0)); do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    log Error "Unknown option: $1"
    usage
    exit 1
    ;;
  esac
done

if ! source vb-lib-core; then
  log Error "Failed to source vb-lib-core"
  exit 1
fi

helpers::check VIBRANIUM_BAR_DISK_MODULE_ENABLE

if [[ "$VIBRANIUM_BAR_DISK_MODULE_ENABLE" != true ]]; then
  printf '{"text": ""}\n'
  exit 0
fi

lines=()
worst_perc=0
skip_header=true

while IFS= read -r line; do
  $skip_header && { skip_header=false; continue; }
  read -r _ size used _ use_perc mount <<<"$line"
  use_perc=${use_perc%\%}
  size_m=${size%M}
  used_m=${used%M}

  ((use_perc > worst_perc)) && worst_perc=$use_perc

  used_gib=$((used_m / 1024))
  size_gib=$((size_m / 1024))

  [[ "$mount" == "/" ]] && label="System" || label="$mount"
  if ((use_perc >= 95)); then pc="#ffb3ba"
  elif ((use_perc >= 90)); then pc="#ffd9b3"
  elif ((use_perc >= 80)); then pc="#ffffba"
  else pc="#baffc9"
  fi

  lines+=("$label|$use_perc|$pc|$used_gib|$size_gib")
done < <(df -BM -x tmpfs -x devtmpfs -x squashfs -x overlay -x efivarfs \
           -x proc -x sysfs -x cgroup2 -x devpts -x fusectl -x securityfs \
           2>/dev/null) || {
  printf '{"text": "\\uf233", "tooltip": "No mount data"}\n'
  exit 0
}

# Calculate max label width for alignment
max_w=0
for entry in "${lines[@]}"; do
  lbl="${entry%%|*}"
  w=${#lbl}
  ((w > max_w)) && max_w=$w
done
((max_w < 6)) && max_w=6

tooltip="<tt>"
for entry in "${lines[@]}"; do
  IFS='|' read -r label use_perc pc used_gib size_gib <<<"$entry"
  printf -v row "  <b>%-*s</b>  <span foreground='%s'>%3s%%</span>  %5s GiB / %5s GiB" \
    "$max_w" "$label" "$pc" "$use_perc" "$used_gib" "$size_gib"
  if [[ -n "$tooltip" && "$tooltip" != "<tt>" ]]; then
    tooltip+="\n"
  fi
  tooltip+="$row"
done
tooltip+="</tt>"

if ((worst_perc >= 97)); then
  icon="<span foreground='${P_RED}'>\uf233</span>"
elif ((worst_perc >= 93)); then
  icon="<span foreground='${P_ORANGE}'>\uf233</span>"
elif ((worst_perc >= 85)); then
  icon="<span foreground='${P_YELLOW}'>\uf233</span>"
else
  icon="\uf233"
fi

printf '{"text": "%s", "tooltip": "%s"}\n' "$icon" "$tooltip"
