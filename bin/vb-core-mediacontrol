#!/bin/bash

VERBOSE=false
SELF="${0##*/}"
STATE_FILE="$VIBRANIUM_RUNTIME/$SELF.state"
LOCK_FILE="$VIBRANIUM_RUNTIME/$SELF.lock"
SLEEP_TIME=0.005

STATE_PLAYER=""
STATE_VOLUME=""
STATE_ACTION=""

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

# The state file has two tiers: persistent fields (player, volume) written on
# every action, and an ephemeral action queue field written by the lock-fallback
# path. write_state omits action intentionally — the queue consumer reads the
# pending action before writing, preventing a concurrent queue write from being
# silently overwritten.
read_state() {
  [[ -f "$STATE_FILE" ]] || return 0
  while IFS='=' read -r key value; do
    case $key in
      player) STATE_PLAYER=$value ;;
      volume) STATE_VOLUME=$value ;;
      action) STATE_ACTION=$value ;;
    esac
  done < "$STATE_FILE"
}

write_state() {
  shcat > "$STATE_FILE" <<EOF
player=${STATE_PLAYER}
volume=${STATE_VOLUME}
EOF
}

usage() {
  shcat <<EOF
Usage: $SELF  [OPTION]

Media control script with smooth volume fade effects for playerctl and MPD.

Options:
  --toggle       Toggle play/pause
  --play         Start/resume playback
  --pause        Pause playback
  --next         Switch to next track
  --previous     Switch to previous track
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

set_opts() {
  source vb-lib-core

  helpers::check \
    VIBRANIUM_PLAYER_FADE_DURATION \
    VIBRANIUM_PLAYER_FADE_DURATION_ON_SWITCH

  # NUM_STEPS is a string "off" rather than 0 so that fade_out/fade_in can
  # distinguish "no fade requested" from "fade with 0 steps" via a string
  # equality check, which also avoids division-by-zero in the step loop.
  case "$VIBRANIUM_PLAYER_FADE_DURATION" in
    very_slow) NUM_STEPS=200 ;;
    slow) NUM_STEPS=100 ;;
    normal) NUM_STEPS=50 ;;
    fast) NUM_STEPS=30 ;;
    very_fast) NUM_STEPS=10 ;;
    off) NUM_STEPS="off" ;;
  esac

  case "$VIBRANIUM_PLAYER_FADE_DURATION_ON_SWITCH" in
    very_slow) NUM_STEPS_SWITCH=200 ;;
    slow) NUM_STEPS_SWITCH=100 ;;
    normal) NUM_STEPS_SWITCH=50 ;;
    fast) NUM_STEPS_SWITCH=30 ;;
    very_fast) NUM_STEPS_SWITCH=10 ;;
    off) NUM_STEPS_SWITCH="off" ;;
  esac
}

# Probe the given player backend and set the nameref result to "Playing" or
# "Paused". Returns 0 when a recognized status is found (caller handles both),
# 1 when the player is stopped, absent, or unreachable.
get_player_status() {
  local player=$1
  local -n result=$2

  case "$player" in
  playerctl)
    read -r result < <(playerctl status 2>/dev/null)
    case "$result" in
    Playing | Paused) return 0 ;;
    esac
    ;;
  mpd)
    # Check whether mpd is running by testing for its FIFO in the runtime
    # directory (created by mpd when the daemon is active). This avoids
    # spawning a systemctl subprocess on every probe.
    [[ -p "$XDG_RUNTIME_DIR/mpd.fifo" ]] || return 1
    # mpc status emits lines like "[playing] #1/1 0:42/3:30 (20%)".
    while read -r l; do
      case $l in
      *"[playing]"*) result="Playing"; return 0 ;;
      *"[paused]"*)  result="Paused";  return 0 ;;
      esac
    done < <(mpc status 2>/dev/null)
    ;;
  esac
  return 1
}

# Two-pass probe: first try the cached STATE_PLAYER from the state file, falling
# back to a full scan. Playing players are preferred over Paused ones so that
# the active sink is always selected (STATE_PLAYER is updated only when a
# Playing player is found). Defaults to playerctl when nothing is detected.
detect_active_player() {
  PLAYER=""
  STATUS=""

  if [[ -n "$STATE_PLAYER" ]]; then
    if get_player_status "$STATE_PLAYER" STATUS && [[ -n "$STATUS" ]]; then
      PLAYER="$STATE_PLAYER"
      [[ "$STATUS" == "Playing" ]] && STATE_PLAYER="$PLAYER"
      return 0
    fi
  fi

  local player_list
  if command -v mpc >/dev/null; then
    player_list=(playerctl mpd)
  else
    player_list=(playerctl)
  fi

  for p in "${player_list[@]}"; do
    if get_player_status "$p" STATUS && [[ "$STATUS" == "Playing" ]]; then
      PLAYER="$p"
      STATE_PLAYER="$p"
      return 0
    fi
  done

  for p in "${player_list[@]}"; do
    if get_player_status "$p" STATUS && [[ "$STATUS" == "Paused" ]]; then
      PLAYER="$p"
      return 0
    fi
  done

  PLAYER="playerctl"
  get_player_status "playerctl" STATUS || STATUS="Stopped"
}

get_volume() {
  local -n result=$1

  if [ "$PLAYER" = "playerctl" ]; then
    # playerctl volume emits a decimal in 0-1 range.
    read -r result < <(playerctl volume 2>/dev/null)
  elif [ "$PLAYER" = "mpd" ]; then
    # mpc volume output: "vol: 75" — extract the middle field, strip the
    # trailing "%" if present, then convert 0-100 integer -> 0-1 float via
    # scientific notation (75 -> 0.75).
    read -r _ vol _ < <(mpc volume 2>/dev/null) || return 1
    vol=${vol%\%}
    printf -v result '%0.2f' "$((vol))e-2"
  fi
}

set_volume() {
  local vol="$1"

  case "$PLAYER" in
  playerctl)
    playerctl volume "$vol" 2>/dev/null
    ;;
  mpd)
    # Reverse of get_volume: 0-1 float -> 0-100 integer via "${vol}e2"
    # scientific notation (e.g. "0.75e2" -> 75), rounded with %.0f.
    local int_vol
    printf -v int_vol '%.0f' "${vol}e2"
    mpc -q volume "$int_vol"
    ;;
  esac
}

play() {
  if [ "$PLAYER" = "playerctl" ]; then
    playerctl play 2>/dev/null
  elif [ "$PLAYER" = "mpd" ]; then
    mpc -q play
  fi
  STATE_PLAYER="$PLAYER"
}

pause() {
  if [ "$PLAYER" = "playerctl" ]; then
    playerctl pause 2>/dev/null
  elif [ "$PLAYER" = "mpd" ]; then
    mpc -q pause
  fi
  STATE_PLAYER="$PLAYER"
}

next_track() {
  if [ "$PLAYER" = "playerctl" ]; then
    playerctl next 2>/dev/null
  elif [ "$PLAYER" = "mpd" ]; then
    mpc -q next
  fi
}

previous_track() {
  if [ "$PLAYER" = "playerctl" ]; then
    playerctl previous 2>/dev/null
  elif [ "$PLAYER" = "mpd" ]; then
    mpc -q prev
  fi
}

# Smoothly fade volume from current to 0 over num_steps iterations.
# All arithmetic is on hundredths-of-volume integers to avoid cumulative
# floating-point rounding error across the N-step curve. The "0.75" float
# becomes 75 via "${current//./}" with explicit base-10 prefix to protect
# against leading-zero octal interpretation. Each step is computed as
#   step_int = current_int * (N - i) / N
# giving a linear ramp from current_int down to 0. The integer result is
# converted back to the 0-1 float range via scientific notation (75e-2).
fade_out() {
  local num_steps=$1
  if [[ $num_steps == off ]]; then
    return 0
  fi

  local current
  get_volume current
  printf -v current '%.2f' "$current"

  local current_int
  current_int=$((10#${current//./}))

  if ((current_int <= 0)); then
    return
  fi

  local i new_vol_int new_vol
  for ((i = 1; i <= num_steps; i++)); do
    new_vol_int=$((current_int * (num_steps - i) / num_steps))
    printf -v new_vol '%0.2f' "$((new_vol_int))e-2"
    set_volume "$new_vol"
    sleep "$SLEEP_TIME"
  done
  set_volume 0
}

# Smoothly fade volume from 0 to target over num_steps iterations.
# Same integer-based approach as fade_out: step_int = target_int * i / N
# gives a linear ramp from 0 to target_int.
fade_in() {
  local num_steps=$1 target=$2

  if [[ $num_steps == off ]]; then
    set_volume "$target"
    return
  fi

  printf -v target '%.2f' "$target"

  local target_int
  target_int=$((10#${target//./}))

  if ((target_int <= 0)); then
    return
  fi

  local i new_vol_int new_vol
  for ((i = 1; i <= num_steps; i++)); do
    new_vol_int=$((target_int * i / num_steps))
    printf -v new_vol '%0.2f' "$((new_vol_int))e-2"
    set_volume "$new_vol"
    sleep "$SLEEP_TIME"
  done

  set_volume "$target"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  --toggle | --play | --pause | --next | --previous)
    ACTION="$1"
    shift
    ;;
  *)
    echo "Unknown argument: $*" >&2
    echo "Try '$SELF --help' for more information" >&2
    exit 1
    ;;
  esac
done

if [[ -z "$ACTION" ]]; then
  usage
  exit 0
fi

set_opts

if [[ $NUM_STEPS == off && $NUM_STEPS_SWITCH == off ]]; then
  # Ramp-off fast path: the action is instantaneous (~7ms total), so no
  # lock or queue is needed. Read STATE_PLAYER from the state file for
  # the direct dispatch (defaults to playerctl when absent or empty).
  read_state
  case "$ACTION" in
  "--toggle")
    log Info "Toggling play/pause"
    if [[ $STATE_PLAYER == mpd ]]; then
      mpc toggle >/dev/null 2>&1
    else
      playerctl play-pause >/dev/null 2>&1
    fi
    ;;
  "--play")
    log Info "Playing"
    if [[ $STATE_PLAYER == mpd ]]; then
      mpc play >/dev/null 2>&1
    else
      playerctl play >/dev/null 2>&1
    fi
    ;;
  "--pause")
    log Info "Pausing"
    if [[ $STATE_PLAYER == mpd ]]; then
      mpc pause >/dev/null 2>&1
    else
      playerctl pause >/dev/null 2>&1
    fi
    ;;
  "--next" | "--previous")
    log Info "Track: ${ACTION#--}"
    if [[ $STATE_PLAYER == mpd ]]; then
      [[ $ACTION == --next ]] && mpc next >/dev/null 2>&1 || mpc prev >/dev/null 2>&1
    else
      [[ $ACTION == --next ]] && playerctl next >/dev/null 2>&1 || playerctl previous >/dev/null 2>&1
    fi
    ;;
  esac
  exit 0
fi

# Acquire an exclusive lock using O_EXCL via bash's noclobber option.
# Returns 0 on success (lock acquired), 1 on contention (lock held).
_acquire_lock() {
  ( set -o noclobber; : > "$LOCK_FILE" ) 2>/dev/null
}

_release_lock() {
  rm -f "$LOCK_FILE"
}

# When the lock is held by a running instance (fade in progress), the new
# action is appended to the state file. The running instance reads this
# entry in its queue consumer (see above). This avoids blocking on rapid
# key presses.
if _acquire_lock; then
  read_state
  while [[ -n "$ACTION" ]]; do
    case "$ACTION" in
    "--toggle")
      log Info "Toggling play/pause"
      detect_active_player
      if [[ $STATUS == Playing ]]; then
        get_volume CURRENT_VOLUME
        STATE_VOLUME="$CURRENT_VOLUME"
        fade_out "$NUM_STEPS"
        pause
        set_volume "$CURRENT_VOLUME"
      else
        if [[ -n "$STATE_VOLUME" ]]; then
          set_volume 0
          play
          fade_in "$NUM_STEPS" "$STATE_VOLUME"
          STATE_VOLUME=""
        else
          play
        fi
      fi
      ;;
    "--play")
      log Info "Playing"
      detect_active_player
      if [[ $STATUS != Playing ]]; then
        if [[ -n "$STATE_VOLUME" ]]; then
          set_volume 0
          play
          fade_in "$NUM_STEPS" "$STATE_VOLUME"
          STATE_VOLUME=""
        else
          play
        fi
      fi
      ;;
    "--pause")
      log Info "Pausing"
      detect_active_player
      if [[ $STATUS == Playing ]]; then
        get_volume CURRENT_VOLUME
        STATE_VOLUME="$CURRENT_VOLUME"
        fade_out "$NUM_STEPS"
        pause
        set_volume "$CURRENT_VOLUME"
      fi
      ;;
    "--next" | "--previous")
      log Info "Track: ${ACTION#--}"
      detect_active_player
      get_volume CURRENT_VOLUME

      if [[ $STATUS == Paused ]]; then
        fade_out "$NUM_STEPS"
        play
        fade_out "$NUM_STEPS"
      fi

      original_volume="$CURRENT_VOLUME"
      fade_out "$NUM_STEPS_SWITCH"
      [[ $ACTION == --next ]] && next_track || previous_track
      fade_in "$NUM_STEPS_SWITCH" "$original_volume"
      ;;
    esac

    # Queue consumer: read pending action before persisting state so that
    # a concurrent queuer write is captured before write_state overwrites
    # the file. Clear the action field on disk by writing without it.
    read_state
    if [[ -n "$STATE_ACTION" ]]; then
      ACTION="$STATE_ACTION"
    else
      ACTION=""
    fi
    write_state
  done
  _release_lock
else
  (
    if [[ -f "$STATE_FILE" ]]; then
      while IFS='=' read -r key value; do
        [[ $key == action ]] && continue
        echo "$key=$value"
      done < "$STATE_FILE"
    fi
    echo "action=$ACTION"
  ) > "$STATE_FILE"
fi
