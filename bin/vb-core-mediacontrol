#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}
SELF="${0##*/}"
STATE_FILE="$VIBRANIUM_RUNTIME/$SELF.state"
LOCK_FILE="$VIBRANIUM_RUNTIME/$SELF.lock"
SLEEP_TIME=0.005
FADE_CURVE="quadratic"

STATE_PLAYER=""
STATE_VOLUME=""
STATE_ACTION=""

log Info "$SELF initialized: state_file=$STATE_FILE lock_file=$LOCK_FILE"

# The state file has two tiers: persistent fields (player, volume) written on
# every action, and an ephemeral action queue field written by the lock-fallback
# path. write_state omits action intentionally - the queue consumer reads the
# pending action before writing, preventing a concurrent queue write from being
# silently overwritten.
read_state() {
  [[ -f "$STATE_FILE" ]] || {
    log Info "State file not found: $STATE_FILE"
    return 0
  }
  while IFS='=' read -r key value; do
    case $key in
      player)
        STATE_PLAYER=$value
        ;;
      volume)
        STATE_VOLUME=$value
        ;;
      action)
        STATE_ACTION=$value
        ;;
    esac
  done < "$STATE_FILE"
  log Info "State file read: player=$STATE_PLAYER volume=$STATE_VOLUME"
}

write_state() {
  shcat > "$STATE_FILE" << EOF
player=${STATE_PLAYER}
volume=${STATE_VOLUME}
EOF
  log Info "State file written: player=$STATE_PLAYER volume=$STATE_VOLUME"
}

usage() {
  shcat << EOF
Usage: $SELF  [OPTION]

Media control script with smooth volume fade effects for playerctl and MPD.

Options:
  --toggle       Toggle play/pause
  --play         Start/resume playback
  --pause        Pause playback
  --next         Switch to next track
  --previous     Switch to previous track
  -l, --linear   Use linear fade curve (default is quadratic)
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

set_opts() {
  log Info "set_opts: duration=$VIBRANIUM_PLAYER_FADE_DURATION"
  source vb-lib-core
  log Info "vb-lib-core sourced"

  helpers::check VIBRANIUM_PLAYER_FADE_DURATION

  case "$VIBRANIUM_PLAYER_FADE_DURATION" in
    very_slow) NUM_STEPS=200 ;;
    slow) NUM_STEPS=100 ;;
    normal) NUM_STEPS=50 ;;
    fast) NUM_STEPS=30 ;;
    very_fast) NUM_STEPS=10 ;;
    off) NUM_STEPS=off ;;
  esac
  log Info "NUM_STEPS resolved: $NUM_STEPS (fade: $VIBRANIUM_PLAYER_FADE_DURATION)"
}

# Probe the given player backend and set the nameref result to "Playing" or
# "Paused". Returns 0 when a recognized status is found (caller handles both),
# 1 when the player is stopped, absent, or unreachable.
get_player_status() {
  local player=$1
  local -n result=$2

  log Info "Probing player: $player"

  case "$player" in
    playerctl)
      read -r result < <(playerctl status 2> /dev/null)
      case "$result" in
        Playing | Paused)
          log Info "Player $player status: $result"
          return 0
          ;;
      esac
      ;;
    mpd)
      # Check whether mpd is running by testing for its FIFO in the runtime
      # directory (created by mpd when the daemon is active). This avoids
      # spawning a systemctl subprocess on every probe.
      [[ -p "$XDG_RUNTIME_DIR/mpd.fifo" ]] || {
        log Info "MPD FIFO not found, mpd unreachable"
        return 1
      }
      # mpc status emits lines like "[playing] #1/1 0:42/3:30 (20%)".
      while read -r l; do
        case $l in
          *"[playing]"*)
            result="Playing"
            log Info "Player mpd status: Playing"
            return 0
            ;;
          *"[paused]"*)
            result="Paused"
            log Info "Player mpd status: Paused"
            return 0
            ;;
        esac
      done < <(mpc status 2> /dev/null)
      ;;
  esac
  log Info "Player $player status: unreachable"
  return 1
}

# Three-pass probe: first try the cached STATE_PLAYER (only if Playing), then
# scan all players for a Playing one, then for a Paused one (preferring the
# cached STATE_PLAYER before falling back to the ordered list). This ensures
# that a player the user started after the state file was written (e.g. Spotify
# via playerctl while MPD is paused) is always picked up when it is Playing,
# but when resuming from Paused the last-used player wins over a stale
# playerctl process that happens to be paused too. Falls back to playerctl
# when nothing is detected.
detect_active_player() {
  PLAYER=""
  STATUS=""

  log Info "Detecting active player"

  if [[ -n "$STATE_PLAYER" ]]; then
    log Info "Trying cached player: $STATE_PLAYER"
    if get_player_status "$STATE_PLAYER" STATUS && [[ "$STATUS" == "Playing" ]]; then
      PLAYER="$STATE_PLAYER"
      log Info "Active player: $STATE_PLAYER (cached, Playing)"
      return 0
    fi
  fi

  local player_list
  if command -v mpc > /dev/null; then
    player_list=(playerctl mpd)
  else
    player_list=(playerctl)
  fi

  log Info "Scanning players: ${player_list[*]}"
  for p in "${player_list[@]}"; do
    if get_player_status "$p" STATUS && [[ "$STATUS" == "Playing" ]]; then
      PLAYER="$p"
      STATE_PLAYER="$p"
      log Info "Active player: $p (Playing)"
      return 0
    fi
  done

  if [[ -n "$STATE_PLAYER" ]]; then
    log Info "Trying cached player (Paused): $STATE_PLAYER"
    if get_player_status "$STATE_PLAYER" STATUS && [[ "$STATUS" == "Paused" ]]; then
      PLAYER="$STATE_PLAYER"
      log Info "Active player: $STATE_PLAYER (cached, Paused)"
      return 0
    fi
  fi

  for p in "${player_list[@]}"; do
    if get_player_status "$p" STATUS && [[ "$STATUS" == "Paused" ]]; then
      PLAYER="$p"
      STATE_PLAYER="$p"
      log Info "Active player: $p (Paused)"
      return 0
    fi
  done

  PLAYER="playerctl"
  get_player_status "playerctl" STATUS || STATUS="Stopped"
  log Info "Active player: $PLAYER (default), status: $STATUS"
}

get_volume() {
  local -n result=$1
  log Info "Getting volume from player=$PLAYER"
  result="0.00"

  if [[ "$PLAYER" == "playerctl" ]]; then
    # playerctl volume emits a decimal in 0-1 range.
    read -r result < <(playerctl volume 2> /dev/null)
  elif [[ "$PLAYER" == "mpd" ]]; then
    # mpc volume output: "vol: 75" - extract the middle field, strip the
    # trailing "%" if present, then convert 0-100 integer -> 0-1 float via
    # scientific notation (75 -> 0.75).
    read -r _ vol _ < <(mpc volume 2> /dev/null) || return 1
    vol=${vol%\%}
    printf -v result '%0.2f' "$((vol))e-2"
  fi
  log Info "Volume retrieved: $result (player=$PLAYER)"
}

set_volume() {
  local vol="$1"

  log Info "Setting volume to $vol (player=$PLAYER)"
  case "$PLAYER" in
    playerctl)
      playerctl volume "$vol" 2> /dev/null
      ;;
    mpd)
      # Reverse of get_volume: 0-1 float -> 0-100 integer via "${vol}e2"
      # scientific notation (e.g. "0.75e2" -> 75), rounded with %.0f.
      local int_vol
      printf -v int_vol '%.0f' "${vol}e2"
      mpc -q volume "$int_vol"
      ;;
  esac
}

play() {
  if [[ "$PLAYER" == "playerctl" ]]; then
    playerctl play 2> /dev/null
  elif [[ "$PLAYER" == "mpd" ]]; then
    mpc -q play
  fi
  STATE_PLAYER="$PLAYER"
  log Info "Play executed: player=$STATE_PLAYER"
}

pause() {
  if [[ "$PLAYER" == "playerctl" ]]; then
    playerctl pause 2> /dev/null
  elif [[ "$PLAYER" == "mpd" ]]; then
    mpc -q pause
  fi
  STATE_PLAYER="$PLAYER"
  log Info "Pause executed: player=$STATE_PLAYER"
}

next_track() {
  if [[ "$PLAYER" == "playerctl" ]]; then
    playerctl next 2> /dev/null
  elif [[ "$PLAYER" == "mpd" ]]; then
    mpc -q next
  fi
  log Info "Next track executed: player=$PLAYER"
}

previous_track() {
  if [[ "$PLAYER" == "playerctl" ]]; then
    playerctl previous 2> /dev/null
  elif [[ "$PLAYER" == "mpd" ]]; then
    mpc -q prev
  fi
  log Info "Previous track executed: player=$PLAYER"
}

# Smoothly fade volume from current to 0 over num_steps iterations.
# All arithmetic is on hundredths-of-volume integers to avoid cumulative
# floating-point rounding error across the N-step curve. The "0.75" float
# becomes 75 via "${current//./}" with explicit base-10 prefix to protect
# against leading-zero octal interpretation.
#   curve=linear:    step_int = current_int * (N - i) / N
#   curve=quadratic: step_int = current_int * (N - i)^2 / N^2
# The integer result is converted back to the 0-1 float range via
# scientific notation (75e-2).
fade_out() {
  local num_steps=$1
  log Info "Fade out: steps=$num_steps curve=$FADE_CURVE"
  if [[ $num_steps == off ]]; then
    log Info "Fade skipped (steps=off)"
    return 0
  fi

  local current
  get_volume current
  printf -v current '%.2f' "$current"
  log Info "fade_out: current_volume=$current"

  local current_int
  current_int=$((10#${current//./}))

  if ((current_int <= 0)); then
    log Info "Volume already zero"
    return
  fi

  local i new_vol_int new_vol
  if [[ $FADE_CURVE == linear ]]; then
    for ((i = 1; i <= num_steps; i++)); do
      new_vol_int=$((current_int * (num_steps - i) / num_steps))
      printf -v new_vol '%0.2f' "$((new_vol_int))e-2"
      set_volume "$new_vol"
      sleep "$SLEEP_TIME"
    done
  else
    local denom=$((num_steps * num_steps))
    for ((i = 1; i <= num_steps; i++)); do
      new_vol_int=$((current_int * (num_steps - i) * (num_steps - i) / denom))
      printf -v new_vol '%0.2f' "$((new_vol_int))e-2"
      set_volume "$new_vol"
      sleep "$SLEEP_TIME"
    done
  fi
  set_volume 0
  log Info "Fade out complete"
}

# Smoothly fade volume from 0 to target over num_steps iterations.
# Same integer-based approach as fade_out:
#   curve=linear:    step_int = target_int * i / N
#   curve=quadratic: step_int = target_int * i^2 / N^2
fade_in() {
  local num_steps=$1 target=$2

  log Info "Fade in: steps=$num_steps target=$target curve=$FADE_CURVE"
  if [[ $num_steps == off ]]; then
    log Info "Fade skipped (steps=off)"
    set_volume "$target"
    return
  fi

  printf -v target '%.2f' "$target"
  log Info "fade_in: normalized_target=$target"

  local target_int
  target_int=$((10#${target//./}))

  if ((target_int <= 0)); then
    log Info "Target volume zero"
    return
  fi

  local i new_vol_int new_vol
  if [[ $FADE_CURVE == linear ]]; then
    for ((i = 1; i <= num_steps; i++)); do
      new_vol_int=$((target_int * i / num_steps))
      printf -v new_vol '%0.2f' "$((new_vol_int))e-2"
      set_volume "$new_vol"
      sleep "$SLEEP_TIME"
    done
  else
    local denom=$((num_steps * num_steps))
    for ((i = 1; i <= num_steps; i++)); do
      new_vol_int=$((target_int * i * i / denom))
      printf -v new_vol '%0.2f' "$((new_vol_int))e-2"
      set_volume "$new_vol"
      sleep "$SLEEP_TIME"
    done
  fi

  set_volume "$target"
  log Info "Fade in complete"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -l | --linear)
      FADE_CURVE="linear"
      shift
      ;;
    --toggle | --play | --pause | --next | --previous)
      ACTION="$1"
      log Info "Action parsed: $ACTION"
      shift
      ;;
    *)
      log Error "Unknown argument: $*"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
  esac
done

if [[ -z "$ACTION" ]]; then
  log Info "No action provided, showing usage"
  usage
  exit 0
fi

set_opts
log Info "Config loaded: num_steps=$NUM_STEPS curve=$FADE_CURVE"

_is_spotify() {
  [[ "$PLAYER" == playerctl ]] || return 1
  log Info "Checking Spotify status (player=$PLAYER)"
  while IFS= read -r line; do
    [[ "$line" == *spotify* ]] && return 0
  done < <(playerctl -l 2> /dev/null)
  log Info "Spotify not active"
  return 1
}

log Info "Branch decision: num_steps=$NUM_STEPS"
if [[ $NUM_STEPS == off ]]; then
  # Ramp-off fast path: the action is instantaneous (~7ms total), so no
  # lock or queue is needed. detect_active_player uses the same three-pass
  # probe as the slow path (Playing > Paused > default), so the cached
  # STATE_PLAYER is always validated against what is actually running.
  log Info "Fast path (ramp off)"
  read_state
  detect_active_player
  write_state
  case "$ACTION" in
    "--toggle")
      log Info "Toggling play/pause"
      if [[ $STATE_PLAYER == mpd ]]; then
        mpc toggle > /dev/null 2>&1
      else
        playerctl play-pause > /dev/null 2>&1
      fi
      ;;
    "--play")
      log Info "Playing"
      if [[ $STATE_PLAYER == mpd ]]; then
        mpc play > /dev/null 2>&1
      else
        playerctl play > /dev/null 2>&1
      fi
      ;;
    "--pause")
      log Info "Pausing"
      if [[ $STATE_PLAYER == mpd ]]; then
        mpc pause > /dev/null 2>&1
      else
        playerctl pause > /dev/null 2>&1
      fi
      ;;
    "--next" | "--previous")
      log Info "Track: ${ACTION#--}"
      if [[ $STATE_PLAYER == mpd ]]; then
        if [[ $ACTION == --next ]]; then
          mpc next
        else
          mpc prev
        fi
      else
        if [[ $ACTION == --next ]]; then
          playerctl next
        else
          playerctl previous
        fi
      fi > /dev/null 2>&1
      ;;
  esac
  log Info "Fast path action complete, exiting"
  exit 0
fi

# Acquire an exclusive lock using O_EXCL via bash's noclobber option.
# Returns 0 on success (lock acquired), 1 on contention (lock held).
_acquire_lock() {
  set -o noclobber
  : > "$LOCK_FILE" 2> /dev/null
  local rc=$?
  set +o noclobber
  if ((rc == 0)); then
    log Info "Lock acquired"
  else
    log Info "Lock contended"
  fi
  return $rc
}

_release_lock() {
  rm -f "$LOCK_FILE"
  log Info "Lock released"
}

# When the lock is held by a running instance (fade in progress), the new
# action is appended to the state file. The running instance reads this
# entry in its queue consumer (see above). This avoids blocking on rapid
# key presses.
log Info "Slow path: attempting lock"
if _acquire_lock; then
  read_state
  while [[ -n "$ACTION" ]]; do
    case "$ACTION" in
      "--toggle")
        log Info "Toggling play/pause"
        detect_active_player
        if _is_spotify; then
          playerctl play-pause 2> /dev/null
        elif [[ $STATUS == Playing ]]; then
          get_volume CURRENT_VOLUME
          STATE_VOLUME="$CURRENT_VOLUME"
          fade_out "$NUM_STEPS"
          pause
          set_volume "$CURRENT_VOLUME"
        else
          if [[ -n "$STATE_VOLUME" ]]; then
            set_volume 0
            play
            fade_in "$NUM_STEPS" "$STATE_VOLUME"
            STATE_VOLUME=""
          else
            play
          fi
        fi
        ;;
      "--play")
        log Info "Playing"
        detect_active_player
        if _is_spotify; then
          playerctl play 2> /dev/null
        elif [[ $STATUS != Playing ]]; then
          if [[ -n "$STATE_VOLUME" ]]; then
            set_volume 0
            play
            fade_in "$NUM_STEPS" "$STATE_VOLUME"
            STATE_VOLUME=""
          else
            play
          fi
        fi
        ;;
      "--pause")
        log Info "Pausing"
        detect_active_player

        if _is_spotify; then
          playerctl pause 2> /dev/null
        elif [[ $STATUS == Playing ]]; then
          get_volume CURRENT_VOLUME
          STATE_VOLUME="$CURRENT_VOLUME"
          fade_out "$NUM_STEPS"
          pause
          set_volume "$CURRENT_VOLUME"
        fi
        ;;
      "--next" | "--previous")
        log Info "Track: ${ACTION#--}"
        detect_active_player
        if _is_spotify; then
          if [[ $ACTION == --next ]]; then
            playerctl next 2> /dev/null
          else
            playerctl previous 2> /dev/null
          fi
        else
          get_volume CURRENT_VOLUME

          if [[ $STATUS == Paused ]]; then
            fade_out "$NUM_STEPS"
            play
          fi

          original_volume="$CURRENT_VOLUME"
          fade_out "$NUM_STEPS"

          if [[ $ACTION == --next ]]; then
            next_track
          else
            previous_track
          fi

          fade_in "$NUM_STEPS" "$original_volume"
        fi
        ;;
    esac
    log Info "Action executed: $ACTION"

    # Queue consumer: read only the action field from the state file so that
    # a concurrent queuer write from a lock-contending instance is captured
    # before write_state persists the current STATE_PLAYER/STATE_VOLUME.
    # Calling read_state() here would overwrite those working values with
    # stale ones from the file, potentially losing the state we just wrote.
    STATE_ACTION=""
    if [[ -f "$STATE_FILE" ]]; then
      while IFS='=' read -r key value; do
        [[ $key == action ]] && STATE_ACTION=$value && break
      done < "$STATE_FILE"
    fi
    if [[ -n "$STATE_ACTION" ]]; then
      log Info "Queue consumer: dequeued action $STATE_ACTION"
      ACTION="$STATE_ACTION"
    else
      ACTION=""
    fi
    write_state
    log Info "Main loop: state synced, next_action=$STATE_ACTION"
  done
  _release_lock
  log Info "Lock released, slow path complete"
else
  log Info "Lock held, queuing action: $ACTION"

  lines=()
  if [[ -f "$STATE_FILE" ]]; then
    while IFS='=' read -r key value; do
      if ! [[ $key == action ]]; then
        lines+=("$key=$value")
      fi
    done < "$STATE_FILE"
  fi

  # Add/update the action line
  lines+=("action=$ACTION")

  # Write everything back atomically (the file is opened only for writing here)
  printf '%s\n' "${lines[@]}" > "$STATE_FILE"
  log Info "Action queued to state file: $ACTION"
fi
