#!/usr/bin/env bash

for f in /run/systemd/inhibit/*; do
    [[ -f $f ]] || continue
    if grep -q '=Vibranium' "$f"; then
        shown=true
        break
    fi
done

if [[ -n "$shown" ]]; then
    printf '{"text": "%s", "tooltip": "%s"}' "\uf023" "Sleep blocked"
else
    printf '{"text": ""}'
fi
