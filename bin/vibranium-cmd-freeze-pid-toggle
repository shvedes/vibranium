#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vibranium-core-lib"

read -r PID NAME <<< "$(hyprctl -j activewindow | jq -r '[.pid,.class]|@tsv')"

if [[ -z $PID ]]; then
    notify-send -r 3 -t 3000 -u critical "Vibranium" "There is no windows!"
    exit 1
fi

read _ _ state _ < /proc/$PID/stat
if [[ $state != T ]]; then
    kill -STOP "$PID"
    msg="suspended"
else
    kill -CONT "$PID"
    msg="restored"
fi

notify-send -r 1 "Vibranium" "<span foreground='${P_YELLOW}'>${NAME}</span> $msg"
