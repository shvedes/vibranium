#!/usr/bin/env bash

if ! systemctl -q --user is-active awww; then
  echo "awww isn't active!" >&2
  exit 1
fi

usage() {
  cat <<EOF
Usage: ${0##*/} [OPTION]

Print current wallpaper path.

Options:
  -b, --basename  Print only the file name
  -h, --help      Display this help and exit
EOF
}

current="$(awww query | awk '{print substr($0, index($0, $9))}')"

case "$1" in
-b | --basename)
  printf "${current##*/}"
  ;;
-h | --help)
  usage
  ;;
"")
  printf "%s" "$current"
  ;;
*)
  echo "${0##*/}: invalid option '$1'" >&2
  echo "Try '${0##*/} --help' for more information." >&2
  exit 1
  ;;
esac
