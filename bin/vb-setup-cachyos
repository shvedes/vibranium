#!/bin/bash

source vb-lib-core

export SUDO_PROMPT="$VIBRANIUM_SUDO_PROMPT"

CACHYOS_REPO_URL="https://mirror.cachyos.org/cachyos-repo.tar.xz"

_operation_canceled() {
  term::disable_input
  trap 'exit 1' SIGHUP SIGINT SIGTERM SIGQUIT
  printf "%s[VIBRANIUM]%s Operation canceled" "$R" "$RS"
  read -n1 -r -s -p $'. Press any key to exit' dummy
}

_operation_complete() {
  term::disable_input
  trap '' SIGHUP SIGINT SIGTERM SIGQUIT
  printf "%s[VIBRANIUM]%s Setup complete" "$G" "$RS"
  # shellcheck disable=2034
  read -n1 -r -p $'. Press any key to exit ' dummy
}

_cleanup() {
  if [[ -n $SUDO_KEEPALIVE_PID ]]; then
    kill "$SUDO_KEEPALIVE_PID" 2> /dev/null
  fi

  if [[ -n $INHIBITOR_PID ]]; then
    kill "$INHIBITOR_PID" 2> /dev/null
  fi

  if [[ -n $TMPDIR ]]; then
    rm -rf "$TMPDIR"
  fi
}

_cachyos_detected() {
  local conf="/etc/pacman.conf"
  # shellcheck disable=2016
  sed -n '/^\[cachyos/q0; $q1' "$conf"
}

_sudoloop() {
  if ! sudo -v; then
    term::disable_input
    _operation_canceled
    exit 1
  fi

  (
    while true; do
      sudo -v
      sleep 5
    done
  ) &

  SUDO_KEEPALIVE_PID=$!
}

_download_and_run() {
  TMPDIR=$(mktemp -d /tmp/cachyos-repo.XXXXXX)
  local tarball="$TMPDIR/cachyos-repo.tar.xz"

  if ! curl -fSL "$CACHYOS_REPO_URL" -o "$tarball"; then
    vb::print "$R" "Failed to download CachyOS repo archive"
    return 1
  fi

  if ! tar -xf "$tarball" -C "$TMPDIR"; then
    vb::print "$R" "Failed to extract CachyOS repo archive"
    return 1
  fi

  systemd-inhibit --what=sleep --who=Vibranium --why="CachyOS repo migration" -- sleep infinity &
  INHIBITOR_PID=$!

  # Bootstrap the migration script
  (
    cd "$TMPDIR/cachyos-repo" || return 1
    sudo ./cachyos-repo.sh "$@" # <-- pass optional '--remove' to it
  )

  local rc=$?

  # Release the inhibitor and clear stored PID.
  kill "$INHIBITOR_PID" 2> /dev/null
  INHIBITOR_PID=

  return $rc
}

# =============================================================

trap '_cleanup; exit 1' SIGHUP SIGINT SIGTERM SIGQUIT

if _cachyos_detected; then
  term::show_header --color green
  vb::print "$G" "CachyOS repositories are already configured"

  if term::ask_yes_no Y "Would you like to revert to official Arch Linux repositories?"; then
    _sudoloop

    vb::print "$Y" "This will remove CachyOS repos and restore your original ${B}pacman.conf${RS}"
    vb::print "$Y" "The CachyOS script will handle the rollback automatically"

    # '--remove' passed to 'cachyos-repo.sh'
    if ! _download_and_run --remove; then
      term::disable_input
      vb::print "$R" "Failed to remove CachyOS repositories"
      _operation_canceled
      exit 1
    fi

    _cleanup
    term::disable_input
    vb::print "$G" "CachyOS repositories removed. You are back to official Arch repos."
    _operation_complete
    exit 0
  fi

  _cleanup
  term::disable_input
  _operation_complete
  exit 0
fi

term::show_header

vb::print "$Y" "You're about to setup CachyOS repositories"
echo ""
vb::print "$R" "WARNING "
vb::print "$R" "CachyOS repositories are NOT official Arch Linux repositories."
vb::print "$R" "They are maintained by the CachyOS community and provide"
vb::print "$R" "CPU-optimized package builds (x86-64-v3/v4)."
echo ""
vb::print "$Y" "CachyOS ships its own fork of pacman with enhanced features."
vb::print "$Y" "This replaces your system's package manager."
echo ""
vb::print "$B" "The setup will:"
vb::print "$B" "  1. Download the CachyOS repo installer from"
vb::print "$B" "     ${P}https://mirror.cachyos.org/cachyos-repo.tar.xz${RS}"
vb::print "$B" "  2. Let CachyOS's own script handle the migration"
vb::print "$B" "  3. The script will forcefully update ALL packages - this"
vb::print "$B" "     downloads and reinstalls every package with optimized builds"
echo ""
vb::print "$R" "This operation can take a long time and will consume"
vb::print "$R" "significant bandwidth. The system will be held awake"
vb::print "$R" "during the process to prevent suspend."

if ! term::ask_yes_no Y "Proceed with CachyOS repository setup?"; then
  term::disable_input
  _operation_canceled
  exit 1
fi

_sudoloop

if ! _download_and_run; then
  vb::print "$R" "CachyOS setup failed"
  vb::print "$Y" "Check the output above for details"
  _operation_canceled
  exit 1
fi

_cleanup
echo ""
vb::print "$G" "CachyOS repositories have been configured"
vb::print "$B" "Your packages have been re-installed with CPU-specific optimizations"
vb::print "$B" "Refer to ${Y}\033[4mhttps://wiki.cachyos.org${RS} for further information"

_operation_complete
