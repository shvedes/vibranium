#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTIONS]

Checks that required dependencies are installed and shows a notification if something is missing.

Options:
  --name TITLE           Set the notification title (required)
  --deps DEP1 [DEP2...]  List required dependencies (at least one, required)
  -v, --verbose          Enable verbose output
  -h, --help             Show this help message and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  --name)
    if [[ $# -lt 2 ]]; then usage; exit 1; fi
    NAME=$2
    shift 2
    ;;
  --deps)
    shift
    if [[ $# -eq 0 || $1 == --* ]]; then
      log Error "expected at least one dependency after --deps"
      exit 1
    fi
    # Collect all arguments following --deps until the next flag (--*)
    # or end-of-args. This allows listing multiple deps in one invocation.
    while [[ $# -gt 0 && $1 != --* ]]; do
      DEPS+=("$1")
      shift
    done
    ;;
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help | "")
    usage
    exit 0
    ;;
  *)
    log Error "unknown argument: $1"
    usage
    exit 1
    ;;
  esac
done

if [[ -z $NAME ]]; then
  log Error "expected --name, got nothing"
  exit 1
fi

if [[ ${#DEPS[@]} -eq 0 ]]; then
  log Error "expected --deps, got nothing"
  exit 1
fi

# Source the theme library for P_YELLOW and other colour variables used
# in the notification markup.
source "$XDG_CONFIG_HOME/vibranium/current/theme/colors.bash"

msg="Missing required dependencies: <span foreground='${P_YELLOW}'><b>${DEPS[*]}</b></span>"
# Replace notification ID 4 so repeated dep-notify calls update the same
# notification bubble instead of stacking new ones.
notify-send -r 4 "$NAME" "$msg"
