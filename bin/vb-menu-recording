#!/usr/bin/env bash

if pidof -q rofi; then
  killall rofi
  exit 0
fi

if pidof -q gpu-screen-recorder; then
  # Trigger killswitch
  vb-core-recording
  exit 0
fi

read -r CHOSEN < <(rofi -dmenu -sync -p "Record" <<<$'Screen\nRegion\nPortal')

if [[ -z $CHOSEN ]] || [[ ! $CHOSEN =~ ^(Screen|Region|Portal)$ ]]; then
  exit 1
fi

app2unit vb-core-recording "--${CHOSEN,}"
