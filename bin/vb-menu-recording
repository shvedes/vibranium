#!/usr/bin/env bash

if [[ $CHASSIS_TYPE == vm ]]; then
  notify-send "Screen Recorder" "screen recording isn't available in a VM!"
  echo "Error: screen recording isn't available in a VM!" >&2
  exit 1
fi

if pidof -q rofi; then
  killall rofi
  exit 0
fi

if pidof -q gpu-screen-recorder; then
  # Trigger killswitch
  vb-core-recording
  exit 0
fi

read -r CHOSEN < <(rofi -dmenu -sync -p "Record" <<<$'Screen\nRegion\nPortal')

if [[ -z $CHOSEN ]] || [[ ! $CHOSEN =~ ^(Screen|Region|Portal)$ ]]; then
  exit 1
fi

app2unit vb-core-recording "--${CHOSEN,}"
