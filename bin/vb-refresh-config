#!/bin/bash

VERBOSE=false
SELF="${0##*/}"

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

copy_file() {
  local src="$1" dst="$2" bak="$3"
  if [[ -f $dst ]]; then
    cp -f "$dst" "$bak" 2> /dev/null || true
    cp -f "$src" "$dst" 2> /dev/null

    if cmp -s "$dst" "$bak"; then
      rm -f "$bak"
      log Info "$dst unchanged, no backup needed"
    else
      log Info "Replaced $dst, backup at $bak"
    fi
  else
    cp -f "$src" "$dst" 2> /dev/null
    log Info "Created $dst from Vibranium config"
  fi
}

copy_dir() {
  local src="$1" dst="$2" bak="$3"

  if [[ -d $dst ]]; then
    cp -rf "$dst" "$bak" 2> /dev/null || true
    log Info "Backed up $dst to $bak"
  fi

  if ! [[ -d "$dst" ]]; then
    mkdir -p "$dst"
  fi

  cp -rf "$src"/. "$dst" 2> /dev/null
  log Info "Synced $dst from Vibranium config"
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: $SELF CONFIG_PATH

Copy the named config from \$VIBRANIUM/config back to ~/.config,
backing up the current file with a timestamp.

Example:
  $SELF hypr/hyprlock.conf
  $SELF waybar/config.jsonc

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

while (($# > 0)); do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [[ -z ${1:-} ]]; then
  log Error "missing CONFIG_PATH"
  log Error "Try '$SELF --help' for more information"
  exit 1
fi

CONFIG_REL="$1"
USER_FILE="$XDG_CONFIG_HOME/$CONFIG_REL"
SRC_FILE="${VIBRANIUM}/config/$CONFIG_REL"
printf -v BAK_FILE '%s.bak.%(%s)T' "$USER_FILE" -1

if [[ -d $SRC_FILE ]]; then
  DIR=${USER_FILE%/*}
  if ! [[ -d $DIR ]]; then
    mkdir -p "$DIR"
  fi
  copy_dir "$SRC_FILE" "$USER_FILE" "$BAK_FILE"
elif [[ -f $SRC_FILE ]]; then
  DIR=${USER_FILE%/*}
  if ! [[ -d $DIR ]]; then
    mkdir -p "$DIR"
  fi
  copy_file "$SRC_FILE" "$USER_FILE" "$BAK_FILE"
else
  log Error "Vibranium config not found: $SRC_FILE"
  exit 1
fi
