#!/bin/bash

source vb-lib-cli
source vb-lib-core

VERBOSE=${VERBOSE:-false}
SELF="${0##*/}"
FORCE=false
NUKE=false

# File refreshes preserve the previous destination in a timestamped sibling
# unless --nuke is selected. A byte-identical replacement removes that backup
# immediately, keeping successful no-op refreshes from accumulating files.
copy_file() {
  local src="$1" dst="$2" bak="$3"
  if [[ -f $dst ]]; then
    if [[ $NUKE == true ]]; then
      rm -f "$dst"
      log Info "Removed $dst"
    else
      cp -f "$dst" "$bak" 2> /dev/null || true
    fi
    cp -f "$src" "$dst" 2> /dev/null

    if [[ $NUKE != true ]] && cmp -s "$dst" "$bak"; then
      rm -f "$bak"
      log Info "$dst unchanged, no backup needed"
    else
      log Info "Replaced $dst"
    fi
  else
    cp -f "$src" "$dst" 2> /dev/null
    log Info "Created $dst from Vibranium config"
  fi
}

copy_dir() {
  local src="$1" dst="$2" bak="$3"

  # Directory refreshes copy the complete existing tree and then overlay the
  # source. They do not delete source-absent entries unless --nuke first removes
  # the destination, so this is an additive sync by design.
  if [[ -d $dst ]]; then
    if [[ $NUKE == true ]]; then
      rm -rf "$dst"
      log Info "Removed $dst"
    else
      cp -rf "$dst" "$bak" 2> /dev/null || true
      log Info "Backed up $dst to $bak"
    fi
  fi

  if ! [[ -d "$dst" ]]; then
    mkdir -p "$dst"
  fi

  cp -rf "$src"/. "$dst" 2> /dev/null
  log Info "Synced $dst from Vibranium config"
}

usage() {
  shcat << EOF
Usage: $SELF CONFIG_PATH

Copy the named config from \$VIBRANIUM/config back to ~/.config. Keeps backups.

Options:
  -n, --nuke         Delete existing target instead of backing up
  -f, --force        With --nuke, skip the confirmation prompt
  -v, --verbose      Enable verbose output
  -h, --help         Display this help and exit
EOF
}

while (($# > 0)); do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -n | --nuke)
      NUKE=true
      shift
      ;;
    -f | --force)
      FORCE=true
      shift
      ;;
    *)
      break
      ;;
  esac
done

if [[ -z ${1:-} ]]; then
  log Error "missing CONFIG_PATH"
  log Error "Try '$SELF --help' for more information"
  exit 1
fi

CONFIG_REL="$1"
USER_FILE="$XDG_CONFIG_HOME/$CONFIG_REL"
SRC_FILE="${VIBRANIUM}/config/$CONFIG_REL"
printf -v BAK_FILE '%s.bak.%(%s)T' "$USER_FILE" -1

# Destructive mode requires an explicit confirmation unless --force is also
# supplied, so a routine refresh cannot remove an existing target by accident.
if [[ $NUKE == true && $FORCE != true ]]; then
  if ! term::ask_yes_no N "Delete $USER_FILE instead of backing up?"; then
    log Info "Nuke declined, nothing changed"
    exit 1
  fi
fi

if [[ -d $SRC_FILE ]]; then
  DIR=${USER_FILE%/*}
  if ! [[ -d $DIR ]]; then
    mkdir -p "$DIR"
  fi
  copy_dir "$SRC_FILE" "$USER_FILE" "$BAK_FILE"
elif [[ -f $SRC_FILE ]]; then
  DIR=${USER_FILE%/*}
  if ! [[ -d $DIR ]]; then
    mkdir -p "$DIR"
  fi
  copy_file "$SRC_FILE" "$USER_FILE" "$BAK_FILE"
else
  log Error "Vibranium config not found: $SRC_FILE"
  exit 1
fi
