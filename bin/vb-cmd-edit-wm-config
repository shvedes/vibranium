#!/usr/bin/env python3

"""
Config file parser and editor for Hyprland-style configuration files.
Supports nested sections, comments, and in-place editing.
"""

import sys
import re
import argparse
from typing import List, Tuple, Optional


def parse_path(path: str) -> Tuple[List[str], Optional[int]]:
    """
    Parse path like 'section:subsection:option:value@-2'
    Returns: (path_parts, index)
    """
    parts = path.split(':')
    index = None

    if parts and '@' in parts[-1]:
        last_part, index_str = parts[-1].rsplit('@', 1)
        try:
            index = int(index_str)
            parts[-1] = last_part
        except ValueError:
            pass  # Treat as part of the value if not integer

    return parts, index


def detect_indent_unit(lines: List[str]) -> str:
    """
    Detect the indentation unit used in the file.
    Returns the smallest non-empty leading-whitespace string found,
    which corresponds to one indent level (e.g. '\\t', '  ', '    ').
    Defaults to a tab if nothing is found.
    """
    min_indent: Optional[str] = None
    for line in lines:
        stripped = line.lstrip()
        if not stripped or stripped.startswith('#') or stripped == line:
            continue
        leading = line[:len(line) - len(stripped)]
        if leading and (min_indent is None or len(leading) < len(min_indent)):
            min_indent = leading
    return min_indent or '\t'


def get_indent(level: int, unit: str = '\t') -> str:
    """Get indentation string for a given nesting level."""
    return unit * level


def find_all_section_bounds(lines: List[str], path: List[str], start_line: int = 0) -> List[Tuple[int, int, int]]:
    """
    Find all bounds of matching sections in the file.
    Returns: list of (section_start_line, section_end_line, nesting_depth)
    where nesting_depth is 0 for top-level sections.
    """
    results = []
    current_path: List[str] = []

    i = start_line
    while i < len(lines):
        line = lines[i]
        stripped = line.lstrip()

        # Skip comments and empty lines
        if not stripped or stripped.startswith('#'):
            i += 1
            continue

        # Handle closing braces
        if stripped.startswith('}'):
            if current_path:
                current_path.pop()
            i += 1
            continue

        # Check for section opening
        section_match = re.match(r'^([\w-]+)\s*\{', stripped)
        if section_match:
            section_name = section_match.group(1)
            current_path.append(section_name)

            # Check if this matches our search path
            if current_path == path:
                depth = len(current_path) - 1
                # Find the closing brace, skipping comments
                brace_depth = 1
                j = i + 1
                while j < len(lines) and brace_depth > 0:
                    s = lines[j].lstrip()
                    if not s.startswith('#'):
                        brace_depth += s.count('{') - s.count('}')
                    j += 1
                results.append((i, j - 1, depth))
                # Pop the matched section and skip past it
                current_path.pop()
                i = j
                continue

            i += 1
            continue

        # Regular option line
        i += 1

    return results


def find_section_bounds(lines: List[str], path: List[str], start_line: int = 0, occurrence: int = 1) -> Optional[Tuple[int, int, int]]:
    """
    Find the bounds of a section in the file.
    Returns: (section_start_line, section_end_line, nesting_depth) or None
    occurrence: which occurrence to find (1-indexed positive, or negative for from end)
    """
    all_bounds = find_all_section_bounds(lines, path, start_line)
    if not all_bounds:
        return None

    if occurrence > 0:
        idx = occurrence - 1
    else:
        idx = occurrence  # negative index from end

    try:
        return all_bounds[idx]
    except IndexError:
        return None


def find_option_in_section(lines: List[str], section_start: int, section_end: int, option_name: str) -> Optional[int]:
    """
    Find an option within a section (direct children only, not inside nested subsections).
    Returns line number or None.
    """
    depth = 0
    for i in range(section_start + 1, section_end):
        line = lines[i]
        stripped = line.lstrip()

        # Skip comments and empty lines
        if not stripped or stripped.startswith('#'):
            continue

        # A line opening a subsection — increment depth and skip
        if '{' in stripped:
            depth += stripped.count('{')
            continue

        # A line closing a subsection — decrement depth and skip
        if '}' in stripped:
            depth -= stripped.count('}')
            continue

        # Skip anything nested inside a subsection
        if depth > 0:
            continue

        # Check if this is our option at the direct level
        option_match = re.match(r'^([\w-]+)\s*=', stripped)
        if option_match and option_match.group(1) == option_name:
            return i

    return None


def read_value(lines: List[str], path: List[str], occurrence: int = 1) -> str:
    """
    Read a value from the config file.
    """
    # Try to find as a section first
    section_bounds = find_section_bounds(lines, path, occurrence=occurrence)
    if section_bounds:
        section_start, section_end, _ = section_bounds
        result = []
        for i in range(section_start, section_end + 1):
            result.append(lines[i].rstrip())
        return '\n'.join(result)

    # Not a section, try as an option
    if len(path) < 1:
        sys.exit(1)

    section_path = path[:-1]
    option_name = path[-1]

    if not section_path:
        # Top-level option
        for line in lines:
            stripped = line.lstrip()
            if stripped.startswith('#') or not stripped:
                continue
            option_match = re.match(r'^([\w-]+)\s*=\s*(.+)', stripped)
            if option_match and option_match.group(1) == option_name:
                return option_match.group(2).strip()
        sys.exit(1)

    # Find the section
    section_bounds = find_section_bounds(lines, section_path, occurrence=occurrence)
    if not section_bounds:
        sys.exit(1)

    section_start, section_end, _ = section_bounds

    # Look for the option in this section
    option_line = find_option_in_section(lines, section_start, section_end, option_name)
    if option_line is not None:
        line = lines[option_line]
        match = re.match(r'^[^=]+=\s*(.+)', line.lstrip())
        if match:
            return match.group(1).strip()

    sys.exit(1)


def write_value(lines: List[str], path: List[str], value: str, file_path: str, occurrence: int = 1):
    """
    Write a value to the config file.
    """
    # Validate value is not empty
    if value == '""' or value == "''":
        sys.exit(1)

    # Remove quotes if present
    if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
        value = value[1:-1]

    if not value:
        sys.exit(1)

    unit = detect_indent_unit(lines)
    section_path = path[:-1]
    option_name = path[-1]

    # Handle top-level option
    if not section_path:
        for i, line in enumerate(lines):
            stripped = line.lstrip()
            if stripped.startswith('#') or not stripped:
                continue
            option_match = re.match(r'^([\w-]+)\s*=', stripped)
            if option_match and option_match.group(1) == option_name:
                lines[i] = f"{option_name} = {value}\n"
                with open(file_path, 'w') as f:
                    f.writelines(lines)
                return

        # Create new top-level option
        lines.insert(0, f"{option_name} = {value}\n")
        with open(file_path, 'w') as f:
            f.writelines(lines)
        return

    # Navigate through sections, creating as needed
    current_line = 0

    for depth, section_name in enumerate(section_path):
        section_bounds = find_section_bounds(lines, section_path[:depth+1], start_line=current_line, occurrence=1 if depth < len(section_path) - 1 else occurrence)

        if section_bounds:
            section_start, section_end, _ = section_bounds
            current_line = section_start
        else:
            # Need to create this section and all remaining nested sections
            if depth == 0:
                insert_pos = len(lines)
                base_depth = 0
            else:
                parent_bounds = find_section_bounds(lines, section_path[:depth], start_line=0)
                if parent_bounds:
                    _, parent_end, parent_depth = parent_bounds
                    insert_pos = parent_end
                    base_depth = parent_depth + 1
                else:
                    insert_pos = len(lines)
                    base_depth = depth

            to_insert = []

            # Add blank line if inserting after a closing brace
            if insert_pos > 0 and insert_pos <= len(lines):
                if lines[insert_pos - 1].strip() == '}':
                    to_insert.append('\n')

            for i in range(depth, len(section_path)):
                indent_str = get_indent(base_depth + (i - depth), unit)
                to_insert.append(f"{indent_str}{section_path[i]} {{\n")

            option_indent = get_indent(base_depth + (len(section_path) - depth), unit)
            to_insert.append(f"{option_indent}{option_name} = {value}\n")

            for i in range(len(section_path) - depth - 1, -1, -1):
                indent_str = get_indent(base_depth + i, unit)
                to_insert.append(f"{indent_str}}}\n")

            for line_to_insert in reversed(to_insert):
                lines.insert(insert_pos, line_to_insert)

            with open(file_path, 'w') as f:
                f.writelines(lines)
            return

    # All sections exist, now handle the option
    section_bounds = find_section_bounds(lines, section_path, occurrence=occurrence)
    if not section_bounds:
        sys.exit(1)

    section_start, section_end, base_depth = section_bounds
    option_indent = get_indent(base_depth + 1, unit)

    option_line = find_option_in_section(lines, section_start, section_end, option_name)

    if option_line is not None:
        lines[option_line] = f"{option_indent}{option_name} = {value}\n"
    else:
        lines.insert(section_end, f"{option_indent}{option_name} = {value}\n")

    with open(file_path, 'w') as f:
        f.writelines(lines)


def main():
    parser = argparse.ArgumentParser(description='Parse and edit configuration files')
    parser.add_argument('-r', '--read', action='store_true', help='Read mode')
    parser.add_argument('path', help='Path to option (section:subsection:option[:value][@occurrence])')
    parser.add_argument('file', help='Configuration file path')

    args = parser.parse_args()

    try:
        with open(args.file, 'r') as f:
            lines = f.readlines()
    except FileNotFoundError:
        if not args.read:
            lines = []
        else:
            sys.exit(1)

    path_and_value, index = parse_path(args.path)
    occurrence = index if index is not None else 1

    if args.read:
        result = read_value(lines, path_and_value, occurrence)
        print(result)
    else:
        if len(path_and_value) < 2:
            sys.exit(1)

        path = path_and_value[:-1]
        value = path_and_value[-1]

        write_value(lines, path, value, args.file, occurrence)


if __name__ == '__main__':
    main()
