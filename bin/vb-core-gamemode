#!/usr/bin/bash

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

_help() {
  shcat <<EOF
Usage: $SELF [OPTION]... -- COMMAND [ARG]...
Launch COMMAND under gamescope

Options:
      --ld-workaround            Try to use LD_PRELOAD workaround
      --gamescope-options=OPTS   Pass extra flags to gamescope
      --mangohud                 Wrap the game with mangohud
      -h, --help                 Display this help and exit

Notes:
  Use 'gamescope --help' to see all gamescope options.

  OPTS is a quoted, space-separated list of valid
  gamescope flags and their values. Unknown flags
  are ignored.

  LD_PRELOAD workaround: See #163 on ValveSoftware/gamescope
  for more information.

Power profile:
  If "performance" power profile is available,
  COMMAND is launched under that profile automatically.

Examples:
  $SELF            -- /usr/bin/some-game
  $SELF --mangohud -- /usr/bin/some-game
  $SELF            -- %command%
EOF
}

GAMESCOPE_FLAGS=(
  # General
  --help
  -W --output-width
  -H --output-height
  -w --nested-width
  -h --nested-height
  -r --nested-refresh
  -m --max-scale
  -S --scaler
  -F --filter
  --sharpness --fsr-sharpness
  --expose-wayland
  -s --mouse-sensitivity
  --backend
  --cursor
  -R --ready-fd
  --rt
  -T --stats-path
  -C --hide-cursor-delay
  -e --steam
  --xwayland-count
  --prefer-vk-device
  --force-orientation
  --force-windows-fullscreen
  --cursor-scale-height
  --virtual-connector-strategy
  --hdr-enabled
  --sdr-gamut-wideness
  --hdr-sdr-content-nits
  --hdr-itm-enabled
  --hdr-itm-sdr-nits
  --hdr-itm-target-nits
  --framerate-limit
  --mangoapp
  --adaptive-sync
  # Nested mode
  -o --nested-unfocused-refresh
  -b --borderless
  -f --fullscreen
  -g --grab
  --force-grab-cursor
  --display-index
  # Embedded mode
  -O --prefer-output
  --default-touch-mode
  --generate-drm-mode
  --immediate-flips
  # VR mode
  --vr-overlay-key
  --vr-app-overlay-key
  --vr-overlay-explicit-name
  --vr-overlay-default-name
  --vr-overlay-icon
  --vr-overlay-show-immediately
  --vr-overlay-enable-control-bar
  --vr-overlay-enable-control-bar-keyboard
  --vr-overlay-enable-control-bar-close
  --vr-overlay-enable-click-stabilization
  --vr-overlay-modal
  --vr-overlay-physical-width
  --vr-overlay-physical-curvature
  --vr-overlay-physical-pre-curve-pitch
  --vr-scrolls-speed
  # Debug
  --disable-layers
  --debug-layers
  --debug-focus
  --synchronous-x11
  --debug-hud
  --debug-events
  --force-composition
  --composite-debug
  --disable-color-management
  --disable-xres
  --hdr-debug-force-support
  --hdr-debug-force-output
  --hdr-debug-heatmap
  # Reshade
  --reshade-effect
  --reshade-technique-idx
  # Steam Deck
  --mura-map
  # Platform
  --allow-deferred-backend
  --keep-alive
)

die() {
  echo "$SELF: $*" >&2
  echo "Try '$SELF --help' for more information." >&2
  exit 1
}

is_known_gamescope_flag() {
  local flag="$1"
  local f
  for f in "${GAMESCOPE_FLAGS[@]}"; do
    [[ "$flag" == "$f" ]] && return 0
  done
  return 1
}

# Return 0 if FLAG was supplied via --gamescope-options, 1 otherwise.
has_extra_flag() {
  local flag="$1"
  local f
  for f in "${EXTRA_GAMESCOPE_OPTS[@]}"; do
    [[ "$f" == "$flag" ]] && return 0
  done
  return 1
}

# Parse and validate a quoted gamescope options string, appending valid tokens
# to EXTRA_GAMESCOPE_OPTS.
parse_gamescope_options() {
  local opts_str="$1"
  local -a tokens
  read -ra tokens <<<"$opts_str"

  local token
  for token in "${tokens[@]}"; do
    # Only validate tokens that look like flags; bare values (numbers, strings
    # following a flag) are passed through as-is.
    if [[ "$token" == -* ]]; then
      is_known_gamescope_flag "$token" ||
        die "unknown gamescope option: '$token'"
    fi
    EXTRA_GAMESCOPE_OPTS+=("$token")
  done
}

OVERRIDE_LDPRELOAD=false
USE_MANGOHUD=false
EXTRA_GAMESCOPE_OPTS=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h | --help)
    _help
    exit 0
    ;;
  --mangohud)
    USE_MANGOHUD=true
    shift
    ;;
  --ld-workaround)
    OVERRIDE_LDPRELOAD=true
    shift
    ;;
  --gamescope-options=*)
    parse_gamescope_options "${1#*=}"
    shift
    ;;
  --gamescope-options)
    [[ -n "${2-}" ]] || die "'--gamescope-options' requires an argument"
    parse_gamescope_options "$2"
    shift 2
    ;;
  --)
    shift
    break
    ;;
  -*)
    die "unrecognized option: '$1'"
    ;;
  *)
    # No '--' separator used — treat the rest as the game command.
    break
    ;;
  esac
done

[[ $# -gt 0 ]] || die "no command given"

# Mangohud availability check (done early so we can warn before any exec)
if $USE_MANGOHUD && ! command -v mangohud >/dev/null; then
  echo "$SELF: warning: --mangohud requested but 'mangohud' not found in PATH; ignoring" >&2
  USE_MANGOHUD=false
fi

# Gamescope not available — fall back gracefully
if ! command -v gamescope >/dev/null; then
  notify-send -r 1 -t 5000 "Vibranium" \
    "<b>gamescope</b> not found! Launching the game as is."

  if $USE_MANGOHUD; then
    exec mangohud "$@"
  else
    exec "$@"
  fi
fi

# https://wiki.archlinux.org/title/Gamescope#Launching_gamescope_from_Steam,_stuttering_after_~24_minutes_(Gamescope_Lag_Bomb)
# Always clear LD_PRELOAD for gamescope itself to prevent the ~24-minute lag
# bomb. When --override-ldpreload is set, the original value is saved and
# re-injected into the game command via `env` so Steam features are preserved
# for games that do not use a secondary launcher (Rockstar, EA, etc.).
SAVED_LD_PRELOAD="${LD_PRELOAD-}"
unset LD_PRELOAD
export LD_PRELOAD=""

if ! [[ -n "$SDL_VIDEODRIVER" ]]; then
  export SDL_VIDEODRIVER="wayland"
fi

MONITOR_DATA="$(hyprctl -j monitors | jq -r '.[] | select(.focused)')"
MONITOR_NAME="$(jq -r '.name' <<<"$MONITOR_DATA")"
MONITOR_REFRESH_RATE="$(jq -r '.refreshRate | floor' <<<"$MONITOR_DATA")"
MONITOR_H="$(jq -r '.height' <<<"$MONITOR_DATA")"
MONITOR_W="$(jq -r '.width' <<<"$MONITOR_DATA")"

# Build exec command line

EXEC_CMDLINE=()

# Power profile
mapfile -t POWERPROFILES < <(powerprofilesctl list | awk '/^\s*[* ]\s*[a-zA-Z0-9\-]+:$/ { gsub(/^[*[:space:]]+|:$/,""); print }')

if ((${#POWERPROFILES[@]} > 0)); then
  if [[ "${POWERPROFILES[*]}" =~ performance ]]; then
    EXEC_CMDLINE=(
      powerprofilesctl launch
      --profile performance
      --
    )
  fi
fi

# Mangohud — use separate binary instead of gamescope's --mangoapp (broken)
if $USE_MANGOHUD; then
  EXEC_CMDLINE+=(mangohud)
fi

# Build resolution/refresh/scaler defaults, skipping any flag the user
# already supplied via --gamescope-options so their value takes effect.
GAMESCOPE_DEFAULTS=()
has_extra_flag -r || has_extra_flag --nested-refresh || GAMESCOPE_DEFAULTS+=(--nested-refresh "$MONITOR_REFRESH_RATE")
has_extra_flag -W || has_extra_flag --output-width || GAMESCOPE_DEFAULTS+=(-W "$MONITOR_W")
has_extra_flag -H || has_extra_flag --output-height || GAMESCOPE_DEFAULTS+=(-H "$MONITOR_H")
has_extra_flag -w || has_extra_flag --nested-width || GAMESCOPE_DEFAULTS+=(-w "$MONITOR_W")
has_extra_flag -h || has_extra_flag --nested-height || GAMESCOPE_DEFAULTS+=(-h "$MONITOR_H")
has_extra_flag -h || has_extra_flag --adaptive-sync || GAMESCOPE_DEFAULTS+=(--adaptive-sync)
has_extra_flag -h || has_extra_flag --fullscreen || GAMESCOPE_DEFAULTS+=(--fullscreen)
has_extra_flag -S || has_extra_flag --scaler || GAMESCOPE_DEFAULTS+=(-S auto)

GAME_CMDLINE=()
if $OVERRIDE_LDPRELOAD; then
  GAME_CMDLINE=(env LD_PRELOAD="$SAVED_LD_PRELOAD")
fi

exec "${EXEC_CMDLINE[@]}" gamescope \
  "${EXTRA_GAMESCOPE_OPTS[@]}" \
  "${GAMESCOPE_DEFAULTS[@]}" \
  --force-grab-cursor \
  --immediate-flips \
  --backend wayland \
  --expose-wayland \
  --rt -- "${GAME_CMDLINE[@]}" "$@"
