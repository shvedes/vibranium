#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Apply the active Vibranium color theme to VSCode/VSCodium editors.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

THEME="$VIBRANIUM_STATE/theme/vscode.json"
log Info "vscode theme file: $THEME"

# Strip `//` comments from JSONC line-wise for jq; like the previous sed
# expression this is not string-aware and can also truncate `//` text in
# a string. Trailing whitespace before the comment is kept, which jq
# ignores, so the parsed result is identical.
_jsonc() {
  local _jc_line
  while IFS= read -r _jc_line || [[ -n $_jc_line ]]; do
    printf '%s\n' "${_jc_line%%//*}"
  done < "$1"
}

# The command check precedes settings-file creation, so an absent editor
# leaves no empty configuration directory behind. Each remaining editor is
# updated independently through its own settings path.
# Apply the theme to a single editor variant.  Each editor stores its
# settings in a different config directory (Code - OSS, Code, Insiders,
# Codium, Cursor) so this function is called once per installed editor.
set_theme() {
  local editor_cmd="$1"
  local settings_path="$2"

  command -v "$editor_cmd" > /dev/null || { log Info "$editor_cmd not found, skipping"; return 0; }

  if [[ -f $THEME ]]; then
    theme_name=$(_jsonc "$THEME" | jq -r '.name')
    extension=$(_jsonc "$THEME" | jq -r '.extension // empty')

    log Info "set_theme: $editor_cmd theme=$theme_name extension=$extension"

    # Install the required theme extension if it is not already present.
    # Extension discovery is per editor, and the install exit status is not
    # used to stop the settings update if installation fails.
    if [[ -n $extension ]]; then
      _ext_found=false
      while IFS= read -r _ext_line || [[ -n $_ext_line ]]; do
        if [[ $_ext_line == "$extension" ]]; then _ext_found=true; break; fi
      done < <("$editor_cmd" --list-extensions 2> /dev/null)
      if ! $_ext_found; then
        log Info "installing extension $extension for $editor_cmd"
        "$editor_cmd" --install-extension "$extension" > /dev/null 2>&1
        log Info "extension $extension installed"
      else
        log Info "extension $extension already installed for $editor_cmd"
      fi
    fi

    _settings_dir=${settings_path%/*}
    [[ $_settings_dir == "$settings_path" ]] && _settings_dir=.
    mkdir -p "$_settings_dir"
    [[ -f $settings_path ]] || printf '{\n}\n' > "$settings_path"

    # An empty settings object receives a placeholder key so the value
    # replacement below has a match target.
    # Replace the workbench.colorTheme value with the new theme name.
    # This is a textual edit rather than a JSON update; a custom theme name
    # containing quotes can produce invalid settings, as before.
    log Info "Applying theme $theme_name to $editor_cmd"
    _vs_out=""
    while IFS= read -r _vs_line || [[ -n $_vs_line ]]; do
      if [[ ${_vs_line//[[:space:]]/} == '{}' ]]; then
        _vs_line='{"workbench.colorTheme": ""}'
      fi
      if [[ $_vs_line == *'"workbench.colorTheme"'* ]]; then
        _vs_before=${_vs_line%%'"workbench.colorTheme"'*}
        _vs_after=${_vs_line#*'"workbench.colorTheme"'}
        _vs_pre_q=${_vs_after%%'"'*}
        if [[ $_vs_pre_q == *:* && $_vs_after == *'"'* ]]; then
          _vs_mid=${_vs_after#*'"'}
          if [[ $_vs_mid == *'"'* ]]; then
            _vs_tail=${_vs_mid#*'"'}
            _vs_line="$_vs_before\"workbench.colorTheme\"${_vs_after%%'"'*}\"$theme_name\"$_vs_tail"
          fi
        fi
      fi
      _vs_out+="$_vs_line"$'\n'
    done < "$settings_path"
    printf '%s' "$_vs_out" > "$settings_path"
  elif [[ -f $settings_path ]]; then
    # No theme file exists: remove any workbench.colorTheme entry that
    # may have been left behind by a previous theme application.
    # The narrow expression leaves unrelated editor settings in place.
    log Info "Clearing theme from $editor_cmd settings"
    _vs_out=""
    while IFS= read -r _vs_line || [[ -n $_vs_line ]]; do
      if [[ $_vs_line == *'"workbench.colorTheme"'* ]]; then
        _vs_before=${_vs_line%%'"workbench.colorTheme"'*}
        _vs_after=${_vs_line#*'"workbench.colorTheme"'}
        _vs_after=${_vs_after#"${_vs_after%%[![:space:]]*}"}
        if [[ $_vs_after == :* ]]; then
          _vs_after=${_vs_after#:}
          if [[ $_vs_after == *,* ]]; then
            _vs_pre_c=${_vs_after%%,*}
          else
            _vs_pre_c=$_vs_after
          fi
          if [[ $_vs_after == *'}'* ]]; then
            _vs_pre_b=${_vs_after%%\}*}
          else
            _vs_pre_b=$_vs_after
          fi
          if ((${#_vs_pre_c} <= ${#_vs_pre_b})); then
            if [[ $_vs_after == *,* ]]; then _vs_after=${_vs_after#*,}; else _vs_after=""; fi
          else
            _vs_after="}${_vs_after#*\}}"
          fi
          _vs_line="$_vs_before$_vs_after"
        fi
      fi
      _vs_out+="$_vs_line"$'\n'
    done < "$settings_path"
    printf '%s' "$_vs_out" > "$settings_path"
  fi
}

if [[ -f /usr/share/applications/code-oss.desktop ]]; then
  set_theme "code" "$XDG_CONFIG_HOME/Code - OSS/User/settings.json"
elif [[ -f /usr/share/applications/code.desktop ]]; then
  set_theme "code" "$XDG_CONFIG_HOME/Code/User/settings.json"
fi

set_theme "code-insiders" "$XDG_CONFIG_HOME/Code - Insiders/User/settings.json"
set_theme "codium" "$XDG_CONFIG_HOME/VSCodium/User/settings.json"
set_theme "vscodium-insiders" "$XDG_CONFIG_HOME/VSCodium - Insiders/User/settings.json"
set_theme "cursor" "$XDG_CONFIG_HOME/Cursor/User/settings.json"
