#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Check whether a battery is present and active in /sys/class/power_supply.

Exit status:
  0    Battery found and marked as present
  1    No active battery detected

Options:
  -h, --help    Show this help and exit

EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -h|--help)
    usage
    exit 0
    ;;
  -v|--verbose)
    VERBOSE=true
    shift
    ;;
  *)
    break
    ;;
  esac
done

# Scan /sys/class/power_supply/BAT* entries. A battery is considered
# "present" when three conditions hold: the directory exists, the
# 'present' sysfs file reads "1", and the 'type' file reads "Battery"
# (excluding AC adapters and wireless chargers that also appear here).
for bat in /sys/class/power_supply/BAT*; do
  if [[ -r $bat/present ]]; then
    if [[ $(<"$bat"/present) == "1" ]]; then
      if [[ $(<"$bat"/type) == "Battery" ]]; then
        exit 0
      fi
    fi
  fi
done

exit 1
