#!/usr/bin/env bash

source $VIBRANIUM_PATH/vb-core-defaults
source $XDG_CONFIG_HOME/vibranium/settings

if [[ $VIBRANIUM_BAR_WEATHER_MODULE_ENABLE == false ]]; then
    printf '{"text": ""}'
    exit 0
fi

if ! command -v wttrbar > /dev/null; then
    text="<span  foreground='red2'>\uf071</span>"
    tooltip="Unable to fetch weather!\n"
    tooltip+="Missing dependencies: wttrbar"
    printf '{"text": "%s", "tooltip": "%s"}' "$text" "$tooltip"
    exit 0
fi

spinner() {
    local pid="$1"
    local msg="$2"
    local tooltip="$3"

    local delay=0.1
    local spinstr=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

    format_text() {
        local text="$1"
        if [[ "$VIBRANIUM_BAR_SHOW_SEPARATOR" == true ]]; then
            text+="<span foreground='DimGray'> |</span>"
        fi
        printf '%s' "$text"
    }

    while kill -0 "$pid" 2>/dev/null; do
        for i in "${spinstr[@]}"; do
            frame="$(format_text "$msg <span foreground='gray'>$i</span>")"

            jq -nc \
              --arg text "$frame" \
              --arg tooltip "$tooltip" \
              '{text:$text, tooltip:$tooltip}'

            sleep "$delay"
        done
    done
}

tmp="$XDG_RUNTIME_DIR/waybar_weather_data"
wttrbar --location $VIBRANIUM_BAR_WEATHER_MODULE_CITY > "$tmp" &
pid=$!

spinner "$pid" " " "Fetching weather..."
wait "$pid"

weather_json="$(< "$tmp")"
rm -f "$tmp"

text="$(jq -r '.text' <<<"$weather_json")"
tooltip="$(jq -r '.tooltip' <<<"$weather_json")"

if [[ "$VIBRANIUM_BAR_SHOW_SEPARATOR" == true ]]; then
    text+="<span foreground='DimGray'> |</span>"
fi

jq -nc \
  --arg text "$text" \
  --arg tooltip "$tooltip" \
  '{text: $text, tooltip: $tooltip}'

