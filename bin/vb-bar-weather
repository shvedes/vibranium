#!/usr/bin/env bash

source vb-core-lib

if [[ $VIBRANIUM_BAR_WEATHER_MODULE_ENABLE == false ]]; then
    printf '{"text": ""}'
    exit 0
elif ! pidof -q waybar; then
    log::error "Waybar is not active!"
    exit 1
fi

if ! command -v wttrbar > /dev/null; then
    text="<span  foreground='red2'>\uf071</span>"
    tooltip="Unable to fetch weather!\n"
    tooltip+="Missing dependencies: wttrbar"
    printf '{"text": "%s", "tooltip": "%s"}' "$text" "$tooltip"
    exit 0
fi

_set_city() {
    local opt city

    opt="VIBRANIUM_BAR_WEATHER_MODULE_CITY"

    # Wait for the internet connection
    while ! curl -s --max-time 5 -I --fail https://clients3.google.com/generate_204 > /dev/null; do
        sleep 1
    done

    city="$(curl -s --max-time 5 http://ip-api.com/json | jq -r '.city')"

    helpers::configure::verify_option "$opt"
    sed -i "s|^${opt}=.*|${opt}=\"${city}\"|" "$XDG_CONFIG_HOME/vibranium/settings"
}

_spinner() {
    local pid="$1"
    local msg="$2"
    local tooltip="$3"

    local delay=0.1
    local spinstr=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')

    format_text() {
        local text="$1"
        if [[ "$VIBRANIUM_BAR_SHOW_SEPARATOR" == true ]]; then
            text+="<span foreground='DimGray'> |</span>"
        fi
        printf '%s' "$text"
    }

    while kill -0 "$pid" 2>/dev/null; do
        for i in "${spinstr[@]}"; do
            frame="$(format_text "$msg <span foreground='gray'>$i</span>")"

            jq -nc \
              --arg text "$frame" \
              --arg tooltip "$tooltip" \
              '{text:$text, tooltip:$tooltip}'

            sleep "$delay"
        done
    done
}

helpers::parse_defaults
helpers::check VIBRANIUM_BAR_SHOW_ANIMATION

if [[ $VIBRANIUM_BAR_SHOW_ANIMATION == false ]]; then
    show_spinner=false
else
    marker="$VIBRANIUM_RUNTIME/bar_weather.$(pidof waybar)"
    if [[ -f $marker ]]; then
        show_spinner=false
    else
        show_spinner=true
        rm -f "${marker%.*}".*
        touch "$marker"
    fi
fi

if [[ -z $VIBRANIUM_BAR_WEATHER_MODULE_CITY ]]; then
    _set_city &
    set_city_pid="$!"
    _spinner "$set_city_pid" " " "Getting location..."
    # Source user settings with weather location set
    source $VIBRANIUM_USER_SETTINGS
fi

temp_data="$VIBRANIUM_RUNTIME/waybar_weather.json"
wttrbar --location $VIBRANIUM_BAR_WEATHER_MODULE_CITY > "$temp_data" &
pid=$!

if [[ $show_spinner == true ]]; then
    _spinner "$pid" " " "Fetching weather..."
fi

wait "$pid"

weather_json="$(< "$temp_data")"

rm -f "$temp_data"

text="$(jq -r '.text' <<<"$weather_json")"
tooltip="$(jq -r '.tooltip' <<<"$weather_json")"

if [[ "$VIBRANIUM_BAR_SHOW_SEPARATOR" == true ]]; then
    text+="<span foreground='DimGray'> |</span>"
fi

jq -nc \
  --arg text "$text" \
  --arg tooltip "$tooltip" \
  '{text: $text, tooltip: $tooltip}'
