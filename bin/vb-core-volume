#!/usr/bin/env bash

source vb-core-lib

usage() {
  cat << EOF
Usage: ${0##*/} [OPTION]...

Control system volume and microphone.

Options:
      --volume-up          raise volume by one step
      --volume-down        lower volume by one step
      --volume-toggle      toggle mute on the default audio sink
      --microphone-up      raise microphone volume by one step
      --microphone-down    lower microphone volume by one step
      --microphone-toggle  toggle mute on the default audio source
      --volume INT         set volume to INT percent
      -q,--quiet           suppress desktop notifications (notify-send only)
      -h,--help            display this help and exit

EOF
}

show_volume_notification() {
  local device="$1"
  local type="$2"
  local vol_info muted vol display_vol bar_value max_vol

  # Suppress the notification when the active window is fullscreen.
  # Dunst queues notifications during fullscreen and shows them only
  # after exiting fullscreen, which makes them stale and irrelevant.
  #
  # We don't apply this rule to OSD notifications because
  # it defeats the purpose of OSDs

  local fullscreen_state
  fullscreen_state="$(hyprctl -j activewindow | jq -r '.fullscreen')"

  if ((fullscreen_state == 2)); then
    return
  fi

  vol_info=$(wpctl get-volume "$device")
  read -r _ vol muted <<< "$vol_info"

  if [[ "$VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED" == true ]]; then
    max_vol=1.5
  else
    max_vol=1.0
  fi

  # To display the progress bar, libnotify only accepts values from 0 to 100. If the user has enabled above 100%,
  # we need to convert the volume values to a 100% scale in order to display the progress bar correctly.
  display_vol=$(awk -v v="$vol" 'BEGIN {printf "%d", v*100}')
  bar_value=$(awk -v v="$vol" -v max="$max_vol" 'BEGIN {printf "%d", (v/max)*100}')

  if [[ "$muted" == "[MUTED]" ]]; then
    notify-send -r 3 -t 1000 "$type Muted"
  else
    if [[ "$type" != "Microphone" ]]; then
      notify-send -r 3 -t 1000 "$type ${display_vol}%" -h "int:value:$bar_value"
    fi
  fi
}

adjust_volume() {
  local direction="$1"
  local device_type="$2"
  local device osd_arg notification_type max_volume osd_max_flag current_volume new_volume

  if [[ "$VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED" == true ]]; then
    max_volume=1.5
    osd_max_flag="--max-volume=150"
  else
    max_volume=1.0
    osd_max_flag=""
  fi

  case "$device_type" in
    vol)
      device="@DEFAULT_AUDIO_SINK@"
      osd_arg="--output-volume"
      notification_type="Volume"
      ;;
    mic)
      device="@DEFAULT_AUDIO_SOURCE@"
      osd_arg="--input-volume"
      notification_type="Microphone"
      ;;
  esac

  # Parse volume and mute state from a single wpctl call
  local vol_info mute_state
  read -r _ current_volume mute_state <<< "$(wpctl get-volume "$device")"

  # Unmute before adjusting so the volume change isn't silently swallowed
  if [[ "$mute_state" == "[MUTED]" ]]; then
    wpctl set-mute "$device" 0
  fi

  # Stop if already at limits
  if [[ "$direction" == "+" ]] && awk "BEGIN {exit !($current_volume >= $max_volume)}"; then
    exit 0
  elif [[ "$direction" == "-" ]] && awk "BEGIN {exit !($current_volume <= 0.00)}"; then
    exit 0
  fi

  if [[ "$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK" == true ]]; then
    if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
      if [[ -n "$osd_max_flag" ]]; then
        swayosd-client "$osd_arg" "${direction}${VIBRANIUM_VOLUME_ADJUSTMENT_STEP}" "$osd_max_flag"
      else
        swayosd-client "$osd_arg" "${direction}${VIBRANIUM_VOLUME_ADJUSTMENT_STEP}"
      fi
    else
      if [[ "$direction" == "+" ]]; then
        new_volume=$(awk -v cv="$current_volume" -v step="$VIBRANIUM_VOLUME_ADJUSTMENT_STEP" -v max="$max_volume" \
          'BEGIN {new = cv + step/100; if (new > max) new = max; printf "%.2f", new}')
      else
        new_volume=$(awk -v cv="$current_volume" -v step="$VIBRANIUM_VOLUME_ADJUSTMENT_STEP" \
          'BEGIN {new = cv - step/100; if (new < 0.0) new = 0.0; printf "%.2f", new}')
      fi
      wpctl set-volume "$device" "$new_volume"
      [[ "$quiet" != true ]] && show_volume_notification "$device" "$notification_type"
    fi
  else
    if [[ "$direction" == "+" ]]; then
      new_volume=$(awk -v cv="$current_volume" -v step="$VIBRANIUM_VOLUME_ADJUSTMENT_STEP" -v max="$max_volume" \
        'BEGIN {new = cv + step/100; if (new > max) new = max; printf "%.2f", new}')
    else
      new_volume=$(awk -v cv="$current_volume" -v step="$VIBRANIUM_VOLUME_ADJUSTMENT_STEP" \
        'BEGIN {new = cv - step/100; if (new < 0.0) new = 0.0; printf "%.2f", new}')
    fi
    wpctl set-volume "$device" "$new_volume"
  fi
}

set_volume() {
  local int_val="${1%%%}" # Strip optional trailing '%'
  local device="@DEFAULT_AUDIO_SINK@"
  local max_volume

  if [[ "$VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED" == true ]]; then
    max_volume=150
  else
    max_volume=100
  fi

  if ! [[ "$int_val" =~ ^[0-9]+$ ]] || ((int_val < 0 || int_val > max_volume)); then
    echo "${0##*/}: invalid volume value '${1}' (expected integer 0-${max_volume})" >&2
    exit 1
  fi

  local float_val mute_state
  float_val=$(awk -v v="$int_val" 'BEGIN {printf "%.2f", v/100}')

  if ((int_val == 0)); then
    wpctl set-volume "$device" 0
    wpctl set-mute "$device" 1

    if [[ "$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK" == true && "$quiet" != true ]]; then
      if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
        swayosd-client \
          --custom-icon="audio-volume-muted-symbolic" \
          --custom-progress="0.0001"
      else
        show_volume_notification "$device" "Volume"
      fi
    fi
    return
  fi

  read -r _ _ mute_state <<< "$(wpctl get-volume "$device")"
  if [[ "$mute_state" == "[MUTED]" ]]; then
    wpctl set-mute "$device" 0
  fi

  wpctl set-volume "$device" "$float_val"

  if [[ "$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK" == true && "$quiet" != true ]]; then
    if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
      # swayosd-client has no absolute-set command, so we approximate with
      # --custom-progress (0.0-1.0 scale), a matching freedesktop icon, and
      # a label showing the real percentage.
      local osd_progress osd_icon
      osd_progress=$(awk -v v="$int_val" -v max="$max_volume" \
        'BEGIN {printf "%.4f", v/max}')
      if ((int_val <= 33)); then
        osd_icon="audio-volume-low-symbolic"
      elif ((int_val <= 66)); then
        osd_icon="audio-volume-medium-symbolic"
      else
        osd_icon="audio-volume-high-symbolic"
      fi
      swayosd-client \
        --custom-icon="$osd_icon" \
        --custom-progress="$osd_progress"
    else
      show_volume_notification "$device" "Volume"
    fi
  fi
}

toggle_mute() {
  local device_type="$1"
  local device osd_arg type

  case "$device_type" in
    vol)
      device="@DEFAULT_AUDIO_SINK@"
      osd_arg="--output-volume"
      type="Volume"
      ;;
    mic)
      device="@DEFAULT_AUDIO_SOURCE@"
      osd_arg="--input-volume"
      type="Microphone"
      ;;
  esac

  if [[ "$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK" == true ]]; then
    if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
      swayosd-client "$osd_arg" mute-toggle
    else
      wpctl set-mute "$device" toggle
      [[ "$quiet" != true ]] && show_volume_notification "$device" "$type"
    fi
  else
    wpctl set-mute "$device" toggle
  fi
}

# Process audio feedback if the user has enabled this option
feedback() {
  local variant dir

  helpers::check VIBRANIUM_VOLUME_USE_AUDIO_FEEDBACK
  if [[ "$VIBRANIUM_VOLUME_USE_AUDIO_FEEDBACK" == true ]]; then
    helpers::check VIBRANIUM_VOLUME_AUDIO_FEEDBACK_VARIANT
    variant="$VIBRANIUM_VOLUME_AUDIO_FEEDBACK_VARIANT"

    case "$variant" in
      "variant1" | "variant3")
        dir="/usr/share/sounds/freedesktop/stereo"
        ;;
      "variant2")
        dir="$XDG_DATA_HOME/sounds/Vibranium/stereo"
        ;;
    esac

    if [[ ! -d "$dir" ]]; then
      log::error "$dir does not exist! Using the default one!"
      dir="/usr/share/sounds/freedesktop/stereo"
      return 0
    fi

    if [[ "$variant" == "variant3" ]]; then
      paplay "${dir}/bell.oga" &
    else
      paplay "${dir}/audio-volume-change.oga" &
    fi
  fi
}

# --- Lockfile ---

# Prevent concurrent invocations (e.g. rapid key repeats or external triggers)
# from racing against each other. flock acquires an exclusive lock on the file
# descriptor; any second instance will exit immediately (-n) rather than queue.
exec 9> "$VIBRANIUM_RUNTIME/${0##*/}.lock"
flock -n 9 || exit 0

# --- Argument parsing ---

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

action=""
volume_value=""
quiet=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -q | --quiet)
      quiet=true
      ;;
    --volume-up)
      action="vol-up"
      ;;
    --volume-down)
      action="vol-down"
      ;;
    --volume-toggle)
      action="vol-toggle"
      ;;
    --microphone-up)
      action="mic-up"
      ;;
    --microphone-down)
      action="mic-down"
      ;;
    --microphone-toggle)
      action="mic-toggle"
      ;;
    --volume)
      if [[ -z "$2" || "$2" == --* ]]; then
        echo "${0##*/}: option '--volume' requires an argument" >&2
        echo "Try '${0##*/} --help' for more information." >&2
        exit 1
      fi
      action="vol-set"
      volume_value="$2"
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      echo "${0##*/}: unrecognized option '$1'" >&2
      echo "Try '${0##*/} --help' for more information." >&2
      exit 1
      ;;
    *)
      echo "${0##*/}: unexpected argument '$1'" >&2
      echo "Try '${0##*/} --help' for more information." >&2
      exit 1
      ;;
  esac
  shift
done

if [[ -z "$action" ]]; then
  echo "${0##*/}: no action specified" >&2
  echo "Try '${0##*/} --help' for more information." >&2
  exit 1
fi

helpers::check \
  VIBRANIUM_GLOBAL_USE_OSD \
  VIBRANIUM_VOLUME_ADJUSTMENT_STEP \
  VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK \
  VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED

case "$action" in
  vol-up)
    adjust_volume "+" "vol"
    feedback
    ;;
  vol-down)
    adjust_volume "-" "vol"
    feedback
    ;;
  vol-set)
    set_volume "$volume_value"
    feedback
    ;;
  vol-toggle)
    toggle_mute "vol"
    ;;
  mic-up)
    adjust_volume "+" "mic"
    ;;
  mic-down)
    adjust_volume "-" "mic"
    ;;
  mic-toggle)
    toggle_mute "mic"
    ;;
esac
