#!/bin/bash

source vb-lib-cli

SELF="${0##*/}"
VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: $SELF [OPTION]...

Control system and microphone volume.

Options:
      --volume-up          Raise volume by one step
      --volume-down        Lower volume by one step
      --volume-toggle      Toggle mute on the default audio sink
      --microphone-up      Raise microphone volume by one step
      --microphone-down    Lower microphone volume by one step
      --microphone-toggle  Toggle mute on the default audio source
      --volume INT         Set volume to INT percent
      -q,--quiet           Suppress desktop notifications (notify-send only)
      -v,--verbose         Enable verbose output
      -h,--help            Display this help and exit

EOF
}

# Convert a wpctl-style decimal volume string (e.g. "0.85", "1.50") to a
# fixed-point integer scaled by x100 for integer arithmetic in Bash.
# The x100 representation is also used for notify-send progress bars;
# when ALLOW_ABOVE_HUNDRED is true the bar is re-scaled later as
#   bar = vol100 * 100 / max100
_to_int100() {
  # nameref: _result becomes a reference to the caller's variable name passed as $1
  local -n _result="$1"

  local val="$2"
  local int_part frac_part

  # integer part: strip everything after last dot
  int_part="${val%.*}"

  if [[ "$val" == *"."* ]]; then
    # fractional part: everything after first dot
    frac_part="${val#*.}"

    # pad with zeros to guarantee at least 2 digits
    frac_part="${frac_part}00"
    # take only first 2 digits (truncate, no rounding)
    frac_part="${frac_part:0:2}"
  else
    frac_part="00" # no decimal part -> treat as ".00"
  fi

  # Build integer scaled by 100:
  # - int_part * 100 -> shift integer part
  # - 10#$frac_part  -> force base-10 (avoids octal issues like "08")
  _result=$((int_part * 100 + 10#$frac_part))
}

show_volume_notification() {
  local device="$1"
  local type="$2"
  # $3 display_vol  - pre-computed integer %; omit to query wpctl (toggle case)
  # $4 bar_value    - pre-computed 0-100 bar value
  # $5 muted        - "true" if muted, anything else / absent means unmuted
  local display_vol="$3"
  local bar_value="$4"
  local muted="$5"

  # Dunst queues notifications during fullscreen and delivers them all
  # at once on exit.  Skip notify-send while a fullscreen window is
  # focused to avoid stale volume bars.

  # Only query wpctl when the caller couldn't supply pre-computed values
  # (i.e. toggle_mute, where the new state is genuinely unknown).
  if [[ -z "$display_vol" ]]; then
    local vol_info vol muted_flag max_vol vol100 max100
    vol_info=$(wpctl get-volume "$device")
    read -r _ vol muted_flag <<< "$vol_info"

    if [[ "$VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED" == true ]]; then
      max_vol=2.0
    else
      max_vol=1.0
    fi

    _to_int100 vol100 "$vol"
    _to_int100 max100 "$max_vol"

    display_vol=$vol100
    bar_value=$((vol100 * 100 / max100))

    if [[ "$muted_flag" == "[MUTED]" ]]; then
      muted="true"
    fi
  fi

  # Fire-and-forget: avoid blocking on the D-Bus round-trip.
  # -r (replace) is a hint to the daemon and works fine asynchronously.
  # Query fresh fullscreen state right before notification.
  # hyprctl is called here (not cached from earlier) because the
  # active window may have changed between volume adjustment and now.
  local is_fullscreen=0 win_json
  win_json=$(hyprctl -j activewindow)
  [[ "$win_json" =~ \"fullscreen\":[[:space:]]*([0-9]) ]] && is_fullscreen="${BASH_REMATCH[1]}"

  if ((is_fullscreen == 0)); then
    if [[ "$muted" == "true" ]]; then
      log Info "Sending notification: $type Muted"
      notify-send -r 3 -t 1000 "$type Muted" &
    else
      log Info "Sending notification: $type ${display_vol}% bar=$bar_value"
      notify-send -r 3 -t 1000 "$type ${display_vol}%" -h "int:value:$bar_value" &
    fi
  else
    log Info "Skipping notification (fullscreen)"
  fi

}

adjust_volume() {
  local direction="$1"
  local device_type="$2"
  local device notification_type max_volume current_volume new_volume
  log Info "Adjusting $device_type $direction"

  if [[ "$VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED" == true ]]; then
    max_volume=2.0
  else
    max_volume=1.0
  fi

  case "$device_type" in
    vol)
      device="@DEFAULT_AUDIO_SINK@"
      notification_type="Volume"
      ;;
    mic)
      device="@DEFAULT_AUDIO_SOURCE@"
      notification_type="Microphone"
      ;;
  esac

  local vol_info mute_state
  vol_info=$(wpctl get-volume "$device")
  read -r _ current_volume mute_state <<< "$vol_info"
  log Info "Current volume: $current_volume (muted=${mute_state:-unknown})"

  if [[ "$mute_state" == "[MUTED]" ]]; then
    log Info "Unmuting before adjustment"
    wpctl set-mute "$device" 0
  fi

  local cv100 max100 new100

  _to_int100 cv100 "$current_volume"
  _to_int100 max100 "$max_volume"
  log Info "Volume int100: $cv100 / $max100"

  # Stop if already at limits
  if [[ "$direction" == "+" ]] && ((cv100 >= max100)); then
    log Info "Already at max volume ($max100), skipping"
    exit 0
  elif [[ "$direction" == "-" ]] && ((cv100 <= 0)); then
    log Info "Already at min volume (0), skipping"
    exit 0
  fi

  # new100 is intentionally outer-scoped so callers below can read it.
  _calc_new_volume() {
    if [[ "$direction" == "+" ]]; then
      new100=$((cv100 + VIBRANIUM_VOLUME_ADJUSTMENT_STEP))
      ((new100 > max100)) && new100=$max100
    else
      new100=$((cv100 - VIBRANIUM_VOLUME_ADJUSTMENT_STEP))
      ((new100 < 0)) && new100=0
    fi
    # Convert back from integer*100 -> string with 2 decimal places
    # - new100 / 100 -> integer part
    # - new100 % 100 -> fractional part (always 2 digits)
    printf -v new_volume "%d.%02d" $((new100 / 100)) $((new100 % 100))
  }

  if [[ "$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK" == true ]]; then
    _calc_new_volume
    log Info "Using wpctl: set-volume $device $new_volume"
    wpctl set-volume "$device" "$new_volume"
    if [[ "$quiet" == false ]]; then
      local bar=$((new100 * 100 / max100))
      log Info "Notification: $notification_type vol=$new100 bar=$bar"
      show_volume_notification "$device" "$notification_type" "$new100" "$bar"
    fi
  else
    _calc_new_volume
    log Info "No visual feedback, wpctl: set-volume $device $new_volume"
    wpctl set-volume "$device" "$new_volume"
  fi
}

set_volume() {
  local int_val="${1%%%}"
  local device="@DEFAULT_AUDIO_SINK@"
  local max_volume
  log Info "Setting volume to ${int_val}%"

  if [[ "$VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED" == true ]]; then
    max_volume=200
  else
    max_volume=100
  fi

  if ! [[ "$int_val" =~ ^[0-9]+$ ]] || ((int_val < 0 || int_val > max_volume)); then
    log Error "invalid volume value '${1}' (expected integer 0-${max_volume})"
    exit 1
  fi

  # Convert integer percent to wpctl's decimal format (e.g. 85 -> "0.85").
  # wpctl accepts 2-decimal-place strings representing a 0.0-2.0 range.
  local float_val
  printf -v float_val "%d.%02d" $((int_val / 100)) $((int_val % 100))

  if ((int_val == 0)); then
    wpctl set-volume "$device" 0
    wpctl set-mute "$device" 1

    if [[ "$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK" == true && "$quiet" != true ]]; then
      show_volume_notification "$device" "Volume" "0" "0" "true"
    fi
    return
  fi

  local mute_state vol_info

  vol_info=$(wpctl get-volume "$device")
  read -r _ _ mute_state <<< "$vol_info"
  if [[ "$mute_state" == "[MUTED]" ]]; then
    wpctl set-mute "$device" 0
  fi

  log Info "wpctl set-volume $device $float_val (absolute: ${int_val}%)"
  wpctl set-volume "$device" "$float_val"

  if [[ "$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK" == true && "$quiet" != true ]]; then
    # int_val is already the display percentage; bar scales it to 0-100 of max_volume.
    local bar=$((int_val * 100 / max_volume))
    show_volume_notification "$device" "Volume" "$int_val" "$bar"
  fi
}

toggle_mute() {
  local device_type="$1"
  local device type

  case "$device_type" in
    vol)
      device="@DEFAULT_AUDIO_SINK@"
      type="Volume"
      ;;
    mic)
      device="@DEFAULT_AUDIO_SOURCE@"
      type="Microphone"
      ;;
  esac
  log Info "Toggling mute for $device_type"

  if [[ "$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK" == true ]]; then
    log Info "wpctl: set-mute $device toggle"
    wpctl set-mute "$device" toggle
    if [[ "$quiet" == false ]]; then
      show_volume_notification "$device" "$type"
    fi
  else
    log Info "No visual feedback: wpctl set-mute $device toggle"
    wpctl set-mute "$device" toggle
  fi
}

# Process audio feedback if the user has enabled this option
feedback() {
  local variant dir

  if [[ "$VIBRANIUM_VOLUME_USE_AUDIO_FEEDBACK" == true ]]; then
    variant="$VIBRANIUM_VOLUME_AUDIO_FEEDBACK_VARIANT"
    log Info "Audio feedback: variant=$variant"

    case "$variant" in
      "variant1" | "variant3")
        dir="/usr/share/sounds/freedesktop/stereo"
        ;;
      "variant2")
        dir="$XDG_DATA_HOME/sounds/Vibranium/stereo"
        ;;
    esac

    if [[ ! -d "$dir" ]]; then
      log Error "${FUNCNAME[0]}: $dir does not exist! Using the default one!"
      dir="/usr/share/sounds/freedesktop/stereo"
    fi

    log Info "Playing: $dir/$([ "$variant" == "variant3" ] && echo 'bell.oga' || echo 'audio-volume-change.oga')"
    if [[ "$variant" == "variant3" ]]; then
      paplay "${dir}/bell.oga" &
    else
      paplay "${dir}/audio-volume-change.oga" &
    fi
  fi
}

if [[ $# -eq 0 ]]; then
  usage
  exit 0
fi

action=""
volume_value=""
quiet=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      export VERBOSE=true
      ;;
    -q | --quiet)
      quiet=true
      ;;
    --volume-up)
      action="vol-up"
      ;;
    --volume-down)
      action="vol-down"
      ;;
    --volume-toggle)
      action="vol-toggle"
      ;;
    --microphone-up)
      action="mic-up"
      ;;
    --microphone-down)
      action="mic-down"
      ;;
    --microphone-toggle)
      action="mic-toggle"
      ;;
    --volume)
      if [[ -z "$2" || "$2" == --* ]]; then
        log Error "option '--volume' requires an argument"
        log Error "Try '$SELF --help' for more information."
        exit 1
      fi
      action="vol-set"
      volume_value="$2"
      shift
      ;;
    --)
      shift
      break
      ;;
    -*)
      log Error "unrecognized option '$1'"
      log Error "Try '$SELF --help' for more information."
      exit 1
      ;;
    *)
      log Error "unexpected argument '$1'"
      log Error "Try '$SELF --help' for more information."
      exit 1
      ;;
  esac
  shift
done

if [[ -z "$action" ]]; then
  log Error "no action specified"
  log Error "Try '$SELF --help' for more information."
  exit 1
fi

log Info "${0##*/} started: action=$action quiet=$quiet"
source vb-lib-core

helpers::check \
  VIBRANIUM_VOLUME_ADJUSTMENT_STEP \
  VIBRANIUM_VOLUME_USE_AUDIO_FEEDBACK \
  VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK \
  VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED \
  VIBRANIUM_VOLUME_AUDIO_FEEDBACK_VARIANT

log Info "Config: step=$VIBRANIUM_VOLUME_ADJUSTMENT_STEP max_above_100=$VIBRANIUM_VOLUME_ALLOW_ABOVE_HUNDRED visual=$VIBRANIUM_VOLUME_USE_VISUAL_FEEDBACK audio=$VIBRANIUM_VOLUME_USE_AUDIO_FEEDBACK variant=$VIBRANIUM_VOLUME_AUDIO_FEEDBACK_VARIANT"

# Mic operations intentionally do not call feedback(): the audio
# feedback plays on the default (speaker) sink and would confuse the
# user when they are adjusting their microphone level.
case "$action" in
  vol-up)
    adjust_volume "+" "vol"
    feedback
    ;;
  vol-down)
    adjust_volume "-" "vol"
    feedback
    ;;
  vol-set)
    set_volume "$volume_value"
    feedback
    ;;
  vol-toggle)
    toggle_mute "vol"
    ;;
  mic-up)
    adjust_volume "+" "mic"
    ;;
  mic-down)
    adjust_volume "-" "mic"
    ;;
  mic-toggle)
    toggle_mute "mic"
    ;;
esac
