#!/usr/bin/bash

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Check and re-apply Spicetify patches to Spotify.

Options:
  -h, --help     Show this help and exit
EOF
}

while (($#)); do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "${0##*/}: invalid option -- '$1'" >&2
      echo "Try '${0##*/} --help' for more information." >&2
      exit 2
      ;;
  esac
done

if ! command -v spicetify >/dev/null; then
  echo "==> WARN: Skipping: Spicetify is not installed"
  exit 0
fi

# ripgrep is faster :)
if command -v rg >/dev/null; then
  grep_cmd=(rg -q -m1 spicetify)
else
  grep_cmd=(grep -q -m1 spicetify)
fi

echo "==> Checking if Spotify was previously patched"
if ! find /opt/spotify/ -type f -exec "${grep_cmd[@]}" {} + >/dev/null; then
  echo "==> Spotify wasn't patched; skipping re-patch"
  exit 0
fi

if ! spicetify --no-restart --quiet restore &>/dev/null; then
  echo "==> Backing up Spotify state"
  spicetify --no-restart --quiet backup

  if (($?)); then
    echo "==> ERROR: Couldn't backup Spotify state"
    echo "==> Patch Spotify manually"
    exit 0
  fi
fi

echo "==> Restoring Spicetify state"
spicetify --no-restart --quiet restore

if (($?)); then
  echo "==> ERROR: Couldn't restore Spicetify state"
  echo "==> Patch Spotify manually"
  exit 0
fi

echo "==> Patching Spotify"
spicetify --no-restart --quiet apply

if (($?)); then
  echo "==> ERROR: Spicetify failed to patch Spotify"
  echo "==> Make sure you have updated Spotify first"
  exit 0
fi
