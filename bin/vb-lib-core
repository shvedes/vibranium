#!/bin/bash

# When _VB_LIB_CORE_LOADED is set, sourcing returns from the current shell
# without defining the body again. BASH_ENV can make a child Bash evaluate
# its own unset marker; the library does not export the marker.
if [[ -n "${_VB_LIB_CORE_LOADED:-}" ]]; then
  return 0
fi

declare -gr _VB_LIB_CORE_LOADED=1

# settings.env is a schema-validated environment projection rendered by the
# Vibranium shell. When readable, it is sourced in the caller's scope. The
# shell validates every value before writing, so consumers read the projection
# directly and supply their own fallback for absent keys.
if [[ -r "$VIBRANIUM_RUNTIME/settings.env" ]]; then
  # shellcheck source=/dev/null
  source "$VIBRANIUM_RUNTIME/settings.env"
fi

# Theme colors are optional: both VIBRANIUM_STATE and colors.bash must be
# available before the file is sourced.
if [[ -n "$VIBRANIUM_STATE" ]]; then
  if [[ -f "$VIBRANIUM_STATE/theme/colors.bash" ]]; then
    # shellcheck source=/dev/null
    source "$VIBRANIUM_STATE/theme/colors.bash"
  fi
fi

# These globals are escape sequences rather than semantic color names; callers
# may compose them, and RS provides the shared reset boundary.
Y=$'\e[0;33m' # Yellow
P=$'\e[0;35m' # Purple
G=$'\e[0;32m' # Green
C=$'\e[0;36m' # Cyan
B=$'\e[0;34m' # Blue

# GY is consumed only by scripts outside the library, which source it here and
# read the exported name; shellcheck cannot see those consumers.
# shellcheck disable=SC2034
GY=$'\e[90m'  # Gray
R=$'\e[0;31m' # Red
RS=$'\e[0m'   # Reset

# Export the shared sudo prompt used by package and font helpers.
printf -v VIBRANIUM_SUDO_PROMPT '%s[*]%s Password for %s: ' "$R" "$RS" "$USER"
export SUDO_PROMPT=$VIBRANIUM_SUDO_PROMPT
# Appending the configure directory preserves existing PATH precedence while
# making helper commands available to later processes that inherit this
# library's environment.
export PATH="$PATH:$VIBRANIUM/configure"

# The keyboard is the terminal, not stdin. A caller may have redirected stdin
# - a pipe, /dev/null, a here-doc - while the terminal the user is looking at
# is still there, and a keypress read from stdin would then come from that
# redirection instead of from the keyboard.
#
# The device node is there whether or not a terminal is behind it, so opening
# it is the only test that means anything.
term::tty_available() {
  : 2> /dev/null <> /dev/tty
}

# Prompts and terminal status belong on the controlling terminal. Falling
# back to stderr keeps the text visible when stdout is redirected and no
# terminal is available.
term::tty_print() {
  if term::tty_available; then
    printf '%s' "$1" 2> /dev/null > /dev/tty || true
  else
    printf '%s' "$1" >&2 || true
  fi
}

term::cursor_hide() {
  if ! term::tty_available; then
    return 0
  fi

  printf '\e[?25l' 2> /dev/null > /dev/tty || true
}

term::cursor_show() {
  if ! term::tty_available; then
    return 0
  fi

  printf '\e[?25h' 2> /dev/null > /dev/tty || true
}

# `read -n 100` consumes up to 100 characters per successful call. The loop
# repeats until the short timeout or EOF ends input. The cap keeps a terminal
# that is streaming input from holding a prompt indefinitely.
term::discard_buffer() {
  local _discard _drain_count=0

  while ((_drain_count < 100)); do
    if ! IFS= read -r -n 100 -t 0.001 _discard 2> /dev/null < /dev/tty; then
      break
    fi
    ((++_drain_count))
  done
}

# Capture settings from the terminal, suppress echo, and hide the cursor.
# The exported snapshot makes the operation idempotent: a repeated disable
# keeps the first snapshot instead of capturing the echo-off state as the
# baseline. A snapshot inherited from a parent is already a valid disable.
term::disable_input() {
  if [[ -n "${term_original_settings:-}" ]]; then
    stty -echo 2> /dev/null < /dev/tty
    term::cursor_hide
    return 0
  fi

  # A terminal that is not there is not a failure: there is no cursor to hide
  # and no echo to suppress, and the caller carries on without a keyboard.
  #
  # stderr is redirected before the input redirect, so the shell's own
  # complaint about a missing terminal is swallowed with it.
  term_original_settings=""
  if ! IFS= read -r term_original_settings < <(stty -g 2> /dev/null < /dev/tty); then
    return 0
  fi

  export term_original_settings

  # Disable echoing: keystrokes are accepted but not shown.
  stty -echo 2> /dev/null < /dev/tty
  term::cursor_hide
}

# Restore the saved terminal settings, discard queued input, and show the
# cursor. Calling this without a snapshot is a no-op, so no terminal escape is
# written when nothing disabled input.
term::enable_input() {
  if [[ -z "${term_original_settings:-}" ]]; then
    return 0
  fi

  stty "$term_original_settings" 2> /dev/null < /dev/tty || true
  unset term_original_settings
  term::discard_buffer
  term::cursor_show
}

# Waits for a single keypress on the terminal and prints the placeholder
# there. The caller owns terminal state; this only reads one key.
#
# An earlier prompt leaves its replies queued on the terminal; drop those or
# they answer the keypress for the user. EOF returns failure so callers can
# distinguish a closed terminal from an actual keypress.
term::wait_key() {
  local placeholder="$1"
  local _wait_key_char

  if ! term::tty_available; then
    return 1
  fi

  term::discard_buffer
  term::tty_print "$placeholder"

  if ! IFS= read -r -s -n 1 _wait_key_char 2> /dev/null < /dev/tty; then
    return 1
  fi
}

# Readline treats bytes between \001 and \002 as non-printing. Prompt color
# sequences must be wrapped or redisplay miscalculates the cursor column once
# the input wraps or is edited.
term::readline_prompt() {
  local -n _rlp_out="$1"
  local text="$2"
  local _rlp_acc="" head params final

  while [[ $text == *$'\e['* ]]; do
    head=${text%%$'\e['*}
    _rlp_acc+=$head
    text=${text#*$'\e['}
    params=${text%%[!0-9;?]*}
    final=${text:${#params}:1}

    if [[ $final == [@-~] ]]; then
      _rlp_acc+=$'\001\e['"$params$final"$'\002'
      text=${text:${#params}+1}
    else
      _rlp_acc+=$'\e['
      break
    fi
  done

  _rlp_out="$_rlp_acc$text"
}

# Read one line from the controlling terminal with GNU Readline editing.
#
# Usage: term::prompt_line <variable> <prompt>
# Returns 0 on a line, 1 on EOF, and 2 when no controlling terminal exists.
# The caller is responsible for enabling echo before calling this.
term::prompt_line() {
  local _term_prompt_var="$1"
  local _term_prompt_text="$2"
  local _term_prompt_safe _term_prompt_value
  local _term_prompt_vi=false

  if ! term::tty_available; then
    return 2
  fi

  _term_prompt_safe=""
  term::readline_prompt _term_prompt_safe "$_term_prompt_text"

  # Scripts use one editing model regardless of the caller's shell options.
  # Readline has no sentence commands, so M-a is bound to beginning-of-line.
  # Skip in an interactive shell so a sourced library does not rewrite the
  # user's keymap or editing mode.
  if [[ $- != *i* ]]; then
    if [[ -o vi ]]; then
      _term_prompt_vi=true
    fi
    set -o emacs
    bind '"\ea": beginning-of-line' 2> /dev/null || true
  fi

  if ! IFS= read -e -r -p "$_term_prompt_safe" _term_prompt_value \
    2> /dev/tty < /dev/tty; then
    if $_term_prompt_vi; then
      set -o vi
    fi
    return 1
  fi

  if $_term_prompt_vi; then
    set -o vi
  fi

  printf -v "$_term_prompt_var" '%s' "$_term_prompt_value"
}

# The install marker changes only the prompt prefix; the normalized yes/no
# input and retry loop remain the same.
term::ask_yes_no() {
  local default="${1:-Y}"
  local message="$2"
  local input prompt hint

  default="${default^^}"

  case "$default" in
    Y)
      hint="(Y/n)"
      ;;
    N)
      hint="(y/N)"
      ;;
    *)
      hint="(Y/n)"
      default="Y"
      ;;
  esac

  term::enable_input

  while true; do
    if [[ -f /tmp/vb-install-ongoing ]]; then
      prompt=$'\e[0;36m[QSTN]\e[0m '"${message} ${hint}: "
    else
      prompt=$'\e[0;33m[*]\e[0m '"${message} ${hint}: "
    fi

    if ! term::prompt_line input "$prompt"; then
      return 2
    fi

    if [[ -z "$input" ]]; then
      input="$default"
    fi

    case "$input" in
      [Yy][Ee][Ss] | [Yy])
        return 0
        ;;
      [Nn][Oo] | [Nn])
        return 1
        ;;
    esac
  done
}

# Usage: long_running_command & term::spinner $! "Doing stuff..." "Done" "Failed"
# Polls the child with kill -0, then waits for its exit status and returns it.
# The active frame set is ASCII and the final line is cleared.
term::spinner() {
  # The PID of the process to watch
  local pid=$1

  # The message to show while spinning
  local msg="$2"

  # Final message on success (exit code 0)
  local success_msg="$3"

  # Final message on failure (non-zero exit code)
  local error_msg="$4"

  local delay=0.07
  local spinstr=('/' '-' $'\\' '|')
  local clear_line=$'\r\e[K'
  local interactive=false
  local exit_code
  local i
  local int_trap term_trap
  local trapped_int=false trapped_term=false

  _term_spinner_active=0

  # Animation is terminal presentation. A redirected stdout stays free of
  # carriage-return frames, and a terminal without color support keeps a
  # stable final line only.
  if [[ -t 1 ]] && term::tty_available && [[ -z "${NO_COLOR+x}" ]]; then
    interactive=true

    # Restore the terminal before exiting on a signal when the caller has not
    # installed its own handler. A caller-owned trap keeps ownership of
    # cleanup and exit status.
    int_trap=
    IFS= read -r int_trap < <(trap -p INT) || int_trap=
    term_trap=
    IFS= read -r term_trap < <(trap -p TERM) || term_trap=
    if [[ -z "$int_trap" ]]; then
      trap 'printf "\n"; term::enable_input; exit 130' INT
      trapped_int=true
    fi
    if [[ -z "$term_trap" ]]; then
      trap 'printf "\n"; term::enable_input; exit 143' TERM
      trapped_term=true
    fi

    term::disable_input
    _term_spinner_active=1
  fi

  if $interactive; then
    while kill -0 "$pid" 2> /dev/null; do
      for i in "${spinstr[@]}"; do
        printf '\r%s %s' "$msg" "${i} "
        sleep "$delay" || true
      done
    done
  fi

  # Keep the child status without letting errexit bypass terminal cleanup.
  if wait "$pid"; then
    exit_code=0
  else
    exit_code=$?
  fi

  if $interactive; then
    printf '%s' "$clear_line" || true
    term::enable_input
    _term_spinner_active=0
    if $trapped_int; then
      trap - INT
    fi
    if $trapped_term; then
      trap - TERM
    fi
  fi

  if ((exit_code == 0)); then
    if [[ -n "$success_msg" ]]; then
      printf "%s %s\n" "$msg" "$success_msg"
    else
      printf "%s\n" "$msg"
    fi
  else
    if [[ -n "$error_msg" ]]; then
      printf "%s %s\n" "$msg" "$error_msg"
    else
      printf "%s\n" "$msg"
    fi
  fi

  return "$exit_code"
}

term::show_header() {
  local color

  if [[ "${1-}" == "--color" ]]; then
    case "${2-}" in
      purple)
        color="$P"
        ;;
      green)
        color="$G"
        ;;
      blue)
        color="$B"
        ;;
      cyan)
        color="$C"
        ;;
      red)
        color="$R"
        ;;
      *)
        color="$Y"
        ;;
    esac
  fi

  _banner=
  while IFS= read -r _banner_line || [[ -n "${_banner_line:-}" ]]; do
    if [[ -z "$_banner" ]]; then
      _banner="$_banner_line"
    else
      _banner+=$'\n'"$_banner_line"
    fi
  done < "$VIBRANIUM/banner.txt"
  while [[ "$_banner" == *$'\n' ]]; do _banner="${_banner%$'\n'}"; done
  printf "\n%s%s%s\n\n" "${color:-$Y}" \
    "$_banner" "$RS"
}

# The terminal device, not stdout, decides whether interactive presentation is
# possible. A redirected stdout with a live terminal can still show prompts and
# wait for input; a process without a controlling terminal cannot.
term::is_headless() {
  if term::tty_available; then
    return 1
  else
    return 0
  fi
}

vb::print() {
  echo -e "${1}[*]${RS} ${*:2}"
}

log::error() {
  if [[ -t 2 ]]; then
    printf "%s[error]%s %s\n" \
      "$R" "$RS" "$*" >&2
  fi
}
