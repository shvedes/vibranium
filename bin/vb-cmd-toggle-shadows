#!/usr/bin/env bash

usage() {
    cat << EOF
Usage: ${0##*/} [OPTION]

Toggle Hyprland shadow on/off.

Options:
  -q, --quiet  Do not print 'enabled' or 'disabled'.
  -h, --help   Show this help and exit
EOF
}

QUIET=false
CONF="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.conf"

case "$1" in
    -q|--quiet)
        QUIET=true
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    -*|--*)
        echo "Unkown option: $1" >&2
        echo "Try '${0##*/} --help' for more information." >&2
        exit 1
esac

case "$(hyprctl -j getoption decoration:shadow:enabled | jq -r '.int')" in
    1)
        vb-cmd-edit-wm-config "decoration:shadow:enabled:false" "$CONF"
        [[ "$QUIET" = false ]] && echo "disabled"
        ;;
    0)
        vb-cmd-edit-wm-config "decoration:shadow:enabled:true" "$CONF"
        [[ "$QUIET" = false ]] && echo "enabled"
        ;;
esac

hyprctl -q reload config-only
