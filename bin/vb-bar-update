#!/usr/bin/env bash

source vb-core-lib

state="$VIBRANIUM_STATE/update.available"

if [ -f "$state" ]; then

    while ! ping 8.8.8.8 -c 1 &> /dev/null; do
        # No internet connection
        sleep 1
    done

    icon="<span foreground='green3'>\uf071</span>"
    tag="$(< "$state")"
    tooltip="<span foreground='CornflowerBlue'><b>Vibranium</b></span> "
    tooltip+="update available!\n"
    tooltip+="<span foreground='CornflowerBlue'><b>New version</b></span>: <b>${tag}</b>\n"
    tooltip+="<span foreground='yellow'><b>Click here to update</b></span>"
    printf '{"text": "%s", "tooltip": "%s" }' "$icon" "$tooltip"
    exit 0
fi

printf '{"text": ""}'
