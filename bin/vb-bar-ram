#!/bin/bash

VERBOSE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Output RAM usage for Waybar. Shows detailed memory info in tooltip.

Options:
  -v, --verbose     Enable verbose output
  -h, --help        Show this help and exit

EOF
}

while (($# > 0)); do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    log Error "Unknown option: $1"
    usage
    exit 1
    ;;
  esac
done

if ! source vb-lib-core; then
  log Error "Failed to source vb-lib-core"
  exit 1
fi

helpers::check VIBRANIUM_BAR_RAM_MODULE_ENABLE

if [[ "$VIBRANIUM_BAR_RAM_MODULE_ENABLE" != true ]]; then
  printf '{"text": ""}\n'
  exit 0
fi

# Parse /proc/meminfo
declare -A mem
while read -r key val _; do
  mem["${key%:}"]=$val
done </proc/meminfo

gi1() {
  local val=$1 int dec
  if [[ -z "$val" ]] || ((val == 0)); then
    printf "0"
    return
  fi
  int=$((val / 1048576))
  dec=$(((val % 1048576) * 10 / 1048576))
  printf '%d.%d' "$int" "$dec"
}

mem_total=${mem[MemTotal]:-0}
mem_avail=${mem[MemAvailable]:-0}
mem_used=$((mem_total - mem_avail))
used_perc=$((mem_used * 100 / mem_total))

# Icon color based on used %
if ((used_perc >= 97)); then
  icon="<span foreground='${P_RED}'><big>\\uefc5</big></span>"
elif ((used_perc >= 93)); then
  icon="<span foreground='${P_ORANGE}'><big>\\uefc5</big></span>"
elif ((used_perc >= 85)); then
  icon="<span foreground='${P_YELLOW}'><big>\\uefc5</big></span>"
else
  icon="<big>\\uefc5</big>"
fi

pc() {
  local p=$1
  if ((p >= 95)); then printf '#ffb3ba'
  elif ((p >= 85)); then printf '#ffd9b3'
  else printf '#baffc9'
  fi
}

tooltip="<tt><b>RAM</b>         <span foreground='$(pc "$used_perc")'>${used_perc}%</span>  $(gi1 "$mem_used") GiB / $(gi1 "$mem_total") GiB"

swap_total=${mem[SwapTotal]:-0}
if ((swap_total > 0)); then
  swap_free=${mem[SwapFree]:-0}
  swap_used=$((swap_total - swap_free))
  swap_perc=$((swap_used * 100 / swap_total))
  swap_used_g=$(gi1 "$swap_used")
  swap_total_g=$(gi1 "$swap_total")
  printf -v row "<span foreground='#ffd9b3'>Swap</span>        <span foreground='$(pc "$swap_perc")'>${swap_perc}%%</span>  (${swap_used_g} GiB / ${swap_total_g} GiB)"
  tooltip+="\n$row"
fi

mem_free=${mem[MemFree]:-0}
cache=${mem[Cached]:-0}
buffers=${mem[Buffers]:-0}
mem_avail=${mem[MemAvailable]:-0}
bc_gib=$(gi1 $((cache + buffers)))
free_gib=$(gi1 "$mem_free")
avail_gib=$(gi1 "$mem_avail")

tooltip+="\n\n<span foreground='#a8e6cf'>Free</span>        ${free_gib} GiB"
tooltip+="\n<span foreground='#baffc9'>Available</span>   ${avail_gib} GiB"
tooltip+="\n<span foreground='#b3d9ff'>Buff/cache</span>  ${bc_gib} GiB"

tooltip+="</tt>"

printf '{"text": "%s", "tooltip": "%s"}\n' "$icon" "$tooltip"
