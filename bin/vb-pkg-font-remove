#!/usr/bin/env bash

source vb-core-lib

FZF_ARGS=(
    --multi
    --preview 'pacman -Qii {1} 2>/dev/null'
    --preview-label='alt-p: toggle description, alt-j/k: scroll description, ctrl-j/k: next/prev item, tab: multi-select'
    --preview-label-pos='bottom'
    --preview-window 'right:75%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --color 'pointer:blue,marker:white'
)

_operation_canceled() {
    echo -e "${RED}[VIBRANIUM]${RESET} Operation canceled"
    read -n1 -r -p $'\e[0;33m[VIBRANIUM]\e[0m Press any key to exit' dummy
    printf '\e[?25h' # show cursor
}

_get_fonts() {
    local pkg
    for pkg in $(pacman -Qq); do
        case "$pkg" in
            ttf*|otf*|*-nerd|*-nerd-mono)
                printf '%s\n' "$pkg"
                ;;
        esac
    done
}

trap 'printf "\n"; _operation_canceled; exit 1' SIGINT

printf "\n%s%s%s\n\n" "$YELLOW" "$(< "$VIBRANIUM/logo.txt")" "$RESET"
printf '\e[?25l' # Hide cursor

mapfile -t LIST < <(_get_fonts)
mapfile -t CHOSEN < <(printf "%s\n" "${LIST[@]}" | fzf "${FZF_ARGS[@]}")

if [[ ${#CHOSEN[@]} -eq 0 ]]; then
    _operation_canceled
    exit 1
fi

if term::ask_yes_no Y "Proced with removal?"; then
    vb-pkg-uninstall --no-logo "${CHOSEN[@]}"
else
    _operation_canceled
    exit 1
fi

