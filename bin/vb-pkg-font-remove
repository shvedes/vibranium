#!/usr/bin/env bash

source vb-core-lib

FZF_ARGS=(
    --multi
    --ignore-case
    --highlight-line

    --info 'hidden'
    --border 'bold'

    --border-label ' alt-p: toggle description, alt-j/k: scroll description, ctrl-j/k: next/prev item, tab: multi-select '
    --border-label-pos 'bottom'

    --list-label 'Package list'
    --list-border 'bold'

    --input-label 'Filter packages'
    --input-border 'bold'

    --preview 'pacman -Qii {1}'
    --preview-border 'bold'
    --preview-window 'right:75%:wrap'
    --preview-label 'Package Information'

    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'

    --color 'pointer:white,marker:green'
)

_operation_canceled() {
    printf "%s[VIBRANIUM]%s Operation canceled" "$RED" "$RESET"
    read -n1 -r -s -p $'. Press any key to exit' dummy
    printf '\e[?25h' # show cursor
}

_get_fonts() {
    local pkg
    for pkg in $(pacman -Qq); do
        case "$pkg" in
            ttf*|otf*|*-nerd|*-nerd-mono)
                printf '%s\n' "$pkg"
                ;;
        esac
    done
}

trap 'printf "\n"; _operation_canceled; exit 1' SIGINT

printf "\n%s%s%s\n\n" "$YELLOW" "$(< "$VIBRANIUM/logo.txt")" "$RESET"
printf '\e[?25l' # Hide cursor

mapfile -t LIST < <(_get_fonts)
mapfile -t CHOSEN < <(printf "%s\n" "${LIST[@]}" | fzf "${FZF_ARGS[@]}")

# fzf restores cursor visibility,
# so we re-hide it again.
printf '\e[?25l'

if [[ ${#CHOSEN[@]} -eq 0 ]]; then
    _operation_canceled
    exit 1
fi

if term::ask_yes_no Y "Proced with removal?"; then
    vb-pkg-uninstall --no-logo "${CHOSEN[@]}"
else
    _operation_canceled
    exit 1
fi

