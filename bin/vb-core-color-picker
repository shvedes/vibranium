#!/bin/bash

HISTORY="$VIBRANIUM_CACHE/color-picker.history"
VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]

Simple color picker for Vibranium.

Options:
  -c, --clear   Clear history of recent colors
  -v, --verbose Enable verbose output
  -h, --help    Show this help and exit
EOF
}

check_deps() {
  if ! command -v hyprpicker >/dev/null; then
    echo "Error: missing required dependencies: hyprpicker" >&2
    vb-cmd-dep-notify --name "Color Picker" --deps "hyprpicker"
    return 1
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -c | --clear)
      CLEAR_MODE=true
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      echo "Error: unknown option: $1" >&2
      echo "Try '${0##*/} --help' for more information" >&2
      exit 1
      ;;
  esac
done

if [[ "$CLEAR_MODE" == true ]]; then
  : >"$HISTORY"
  log Info "Clearing history file"
  vb-refresh-waybar-module color-picker
  exit 0
fi

if ! check_deps; then
  exit 1
fi

# Reading mode applies a blue-light filter that shifts all colors on
# screen; picking a color under that filter would give a distorted value,
# so the picker is blocked while reading mode is active.
if [[ -f "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/reading-mode.conf" ]]; then
  log Info "Reading mode is active, aborting"
  notify-send -r 2 -t 3000 "Color Picker" \
    "<b>Color Picker</b> isn't available while <b>Reading Mode</b> is active!"
  exit 1
fi

# Only one hyprpicker instance may run at a time. Kill any existing
# process so the new picker starts with a clean slate.
if pid=$(pidof hyprpicker); then
  log Info "Killing existing hyprpicker process (PID: $pid)"
  kill "$pid"
  exit 1
fi

source vb-lib-core

helpers::check \
  VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR \
  VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW \
  VIBRANIUM_COLOR_PICKER_HISTORY_SIZE

SHOW_SELECTED="$VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR"
HEX_PREVIEW="$VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW"
HIST_SIZE="$VIBRANIUM_COLOR_PICKER_HISTORY_SIZE"

# hyprpicker flags:
#   -a  auto-copy selected color to clipboard
#   -b  enable mouse-grab crosshair overlay
#   -l  enable live preview under cursor
#   -r  render multiple frames (continuous mode)
#   -f hex  output format as hex (e.g. #aabbcc)
#   -d  disable live HEX preview window (set when HEX_PREVIEW is false)
OPT_ARGS=()
if [[ "$HEX_PREVIEW" == false ]]; then
  OPT_ARGS+=(-d)
fi

PICKER_CMD=(hyprpicker -a -b -l -r -f hex "${OPT_ARGS[@]}")
log Info "Running: ${PICKER_CMD[*]}"

# hyprpicker writes the picked color to stdout and logs any internal
# errors prefixed with "[ERR]" on stderr (merged here). Skip error
# lines so only the actual color value is captured.
while IFS= read -r line; do
  if [[ $line == "[ERR]"* ]]; then
    continue
  fi

  SELECTED_COLOR=$line
done < <("${PICKER_CMD[@]}")

if [[ -z "$SELECTED_COLOR" ]]; then
  log Info "No color selected, exiting"
  exit 0
fi

log Info "Selected color: $SELECTED_COLOR"

# History file is a simple list of hex colors, one per line (FIFO by
# insertion order). We maintain a maximum of HIST_SIZE entries.
FOUND=false
COUNT=0

if [[ -f "$HISTORY" ]]; then
  while IFS= read -r line; do
    ((COUNT++))

    if [[ "$line" == "$SELECTED_COLOR" ]]; then
      FOUND=true
    fi
  done <"$HISTORY"
fi

log Info "History size: $COUNT, max: $HIST_SIZE, duplicate: $FOUND"

# Append new color when it is not a duplicate. If the limit is hit,
# start fresh (oldest entries are discarded by truncation).
if [[ "$FOUND" == false ]]; then
  if ((COUNT >= HIST_SIZE)); then
    printf '%s\n' "$SELECTED_COLOR" >"$HISTORY"
  else
    printf '%s\n' "$SELECTED_COLOR" >>"$HISTORY"
  fi
fi

# Generate a 1×1 pixel PNG of the selected color for use as a
# notification icon. The file is created in the runtime directory and
# cleaned up immediately after notify-send displays it.
if [[ $SHOW_SELECTED == true ]]; then
  PREVIEW_IMG="$VIBRANIUM_RUNTIME/color-picker.png"
  if command -v magick >/dev/null; then
    magick -size 1x1 xc:"${SELECTED_COLOR}" "$PREVIEW_IMG"
  else
    log Warn "ImageMagick is not installed!"
  fi
fi

notify-send -r 3 -t 1500 -i "$PREVIEW_IMG" "Color Picker" "Color copied to clipboard"
vb-refresh-waybar-module color-picker
rm -f "$PREVIEW_IMG"
