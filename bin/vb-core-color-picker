#!/bin/bash

source vb-lib-cli

HISTORY="$VIBRANIUM_CACHE/color-picker.history"
VERBOSE=${VERBOSE:-false}

log Info "History file: $HISTORY"

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]

Simple color picker for Vibranium.

Options:
  -c, --clear   Clear history of recent colors
  -v, --verbose Enable verbose output
  -h, --help    Show this help and exit
EOF
}

check_deps() {
  log Info "Checking dep: hyprpicker"
  if ! command -v hyprpicker > /dev/null; then
    log Error "missing required dependencies: hyprpicker"
    vb-cmd-dep-notify --name "Color Picker" --deps "hyprpicker"
    return 1
  fi
  log Info "hyprpicker found"
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -c | --clear)
      CLEAR_MODE=true
      log Info "Clear mode"
      shift
      ;;
    --)
      shift
      break
      ;;
    *)
      log Error "unknown option: $1"
      log Error "Try '${0##*/} --help' for more information"
      exit 1
      ;;
  esac
done

if [[ "$CLEAR_MODE" == true ]]; then
  log Info "Truncating history: $HISTORY"
  : > "$HISTORY"
  log Info "History cleared"
  vb-refresh-waybar-module color-picker
  exit 0
fi

if ! check_deps; then
  exit 1
fi

if [[ -f "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/reading-mode.conf" ]]; then
  log Info "Reading mode active, aborting"
  notify-send -r 2 -t 3000 "Color Picker" \
    "<b>Color Picker</b> isn't available while <b>Reading Mode</b> is active!"
  log Info "Reading mode notification sent"
  exit 1
fi

if pid=$(pidof hyprpicker); then
  log Info "Killing existing hyprpicker (PID: $pid)"
  kill "$pid"
  log Info "Existing hyprpicker killed, exit code: $?"
  exit 1
fi

source vb-lib-core

helpers::check \
  VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR \
  VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW \
  VIBRANIUM_COLOR_PICKER_HISTORY_SIZE
SHOW_SELECTED="$VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR"
HEX_PREVIEW="$VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW"
HIST_SIZE="$VIBRANIUM_COLOR_PICKER_HISTORY_SIZE"
log Info "Config: show_selected=$SHOW_SELECTED hex_preview=$HEX_PREVIEW hist_size=$HIST_SIZE"

OPT_ARGS=()
if [[ "$HEX_PREVIEW" == false ]]; then
  log Info "HEX_PREVIEW disabled, adding -d flag"
  OPT_ARGS+=(-d)
fi

PICKER_CMD=(hyprpicker -a -b -l -r -f hex "${OPT_ARGS[@]}")
log Info "Picker cmd: ${PICKER_CMD[*]}"

log Info "Starting hyprpicker, waiting for color"
while IFS= read -r line; do
  if [[ $line == "[ERR]"* ]]; then
    continue
  fi

  SELECTED_COLOR=$line
done < <("${PICKER_CMD[@]}")
log Info "Hyprpicker output closed, selected: ${SELECTED_COLOR:-(none)}"

if [[ -z "$SELECTED_COLOR" ]]; then
  log Info "No color picked"
  exit 0
fi

log Info "Picked color: $SELECTED_COLOR"

FOUND=false
COUNT=0

log Info "Checking history for duplicates"
if [[ -f "$HISTORY" ]]; then
  while IFS= read -r line; do
    ((COUNT++))

    if [[ "$line" == "$SELECTED_COLOR" ]]; then
      FOUND=true
      log Info "Duplicate found at line $COUNT"
    fi
  done < "$HISTORY"
fi

log Info "History: $COUNT entries, max $HIST_SIZE, duplicate=$FOUND"

if [[ "$FOUND" == false ]]; then
  if ((COUNT >= HIST_SIZE)); then
    log Info "History full ($COUNT >= $HIST_SIZE), writing $SELECTED_COLOR from start"
    printf '%s\n' "$SELECTED_COLOR" > "$HISTORY"
  else
    log Info "Appending $SELECTED_COLOR to history"
    printf '%s\n' "$SELECTED_COLOR" >> "$HISTORY"
  fi
fi

if [[ $SHOW_SELECTED == true ]]; then
  PREVIEW_IMG="$VIBRANIUM_RUNTIME/color-picker.png"
  log Info "Generating preview: $PREVIEW_IMG"
  if command -v magick > /dev/null; then
    log Info "Running: magick -size 1x1 xc:$SELECTED_COLOR $PREVIEW_IMG"
    magick -size 1x1 xc:"${SELECTED_COLOR}" "$PREVIEW_IMG"
    log Info "Preview image created, exit: $?"
  else
    log Warn "ImageMagick not installed, skipping preview"
  fi
fi

log Info "Sending notification"
notify-send -r 3 -t 1500 -i "$PREVIEW_IMG" "Color Picker" "Color copied to clipboard"
log Info "Notification displayed"
log Info "Refreshing waybar module"
vb-refresh-waybar-module color-picker
log Info "Waybar module refreshed"
log Info "Cleaning up preview"
rm -f "$PREVIEW_IMG"
log Info "Preview image cleaned up"
