#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"

if pid=$(pidof hyprpicker); then
    kill $pid
    exit 1
fi

if ! missing="$(vb-cmd-is-present hyprpicker)"; then
    print_error "missing required dependencies: $missing"
    is_headless && vb-cmd-dep-notify --name "Clipboard Manager" --deps "$missing"
    exit 1
fi

HISTORY="$VIBRANIUM_CACHE/color-picker-history"

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTION]

Simple color picker for Vibranium.

Options:
  -c, --clear  Clear history of recent colors
  -h, --help   Show this help exit exit
EOF
}

clear_history() {
    : > "$HISTORY"
    vb-cmd-refresh-waybar-module color-picker
}

case "$1" in
    -h|--help)
        usage
        exit 0
        ;;
    -c|--clear)
        clear_history
        exit 0
        ;;
    "")
        :
        ;;
    *)
        echo -e "Unknown option: $@\n"
        usage
        exit 1
esac

if [[ -f "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/reading-mode.conf" ]]; then
    if is_headless; then
        msg="<b>Color Picker</b> isn't available while <b>Reading Mode</b> is active!"
        notify-send -r 3 -t 3000 "Color Picker" "$msg"
    fi
    print_error "Reading Mode is active. Aborting"
    exit 1
fi

check_bool VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW true
check_bool VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR true
check_int VIBRANIUM_COLOR_PICKER_HISTORY_SIZE int 10

hex_preview="$VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW"
show_selected="$VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR"
hist_size="$VIBRANIUM_COLOR_PICKER_HISTORY_SIZE"

opt_args=()
if [[ "$hex_preview" == false ]]; then
    opt_args+=(-d)
fi

selected_color=$(hyprpicker -a -n -l -r -f hex "${opt_args[@]}" | grep -v '^\[ERR\]')
[[ -z "$selected_color" ]] && {
    echo "selection canceled"
    exit 1
}

# Read the cache file and update it if the selected color is not
# a duplicate of one already existing in the cache file.
if ! grep -Fxq "$selected_color" "$HISTORY" 2> /dev/null; then
    # Wipe file if reached limit
    if [[ "$(wc -l < "$HISTORY" 2> /dev/null)" -ge $hist_size ]]; then
        echo "$selected_color" > "$HISTORY"
    else
        echo "$selected_color" >> "$HISTORY"
    fi
fi

# Generate a 1:1px image of the selected color to display in the notification
if [[ $show_selected == true ]]; then
    if command -v magick > /dev/null; then
        magick -size 1x1 xc:"${selected_color}" /tmp/latest_color.png
    else
        print_warn "ImageMagick is not installed!"
    fi
fi

notify-send -r 1 -t 1500 -i "$preview_img" "Color Picker" "Selected color copied to clipboard"
vb-cmd-refresh-waybar-module color-picker &
rm -f /tmp/latest_color.png
