#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vb-core-lib"

state="$XDG_RUNTIME_DIR/worker.active"

if [[ -f $state ]]; then
    if [[ "$(< "$state")" == "suspended" ]]; then
        tooltip="<span foreground='${WAYBAR_ACCENT}'>Background task suspended due to power profile</span>"
    else
        tooltip="<span foreground='${WAYBAR_ACCENT}'>Background task in progress</span>\n\n"
        tooltip+="<span foreground='${WAYBAR_YELLOW}'>$(< "$state")</span>"
    fi
    printf '{"text": "%s", "tooltip": "%s"}' "\uf013" "$tooltip"
else
    printf '{"text": ""}'
fi
