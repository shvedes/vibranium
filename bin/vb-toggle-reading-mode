#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} [OPTION]...

Toggle reading mode in Hyprland by toggling a screen shader.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

SHADER="$VIBRANIUM/default/hypr/shaders/grayscale.glsl"
CONFIG="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/reading-mode.lua"

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

# The file itself is the toggle state: removing it disables the generated
# config, while creating it enables the shader on the next Hyprland reload.
log Info "Toggling reading mode"
if [[ -f "$CONFIG" ]]; then
  rm -f "$CONFIG"
else
  # The heredoc expands SHADER at write time, so the config stores a concrete
  # shader path rather than a runtime expression.
  shcat << EOF > "$CONFIG"
hl.config({
  decoration = {
    screen_shader = "$SHADER"
  }
})
EOF
fi

# Reload runs detached, so the command returns without waiting for Hyprland
# to apply the change.
hyprctl -q reload config-only &
