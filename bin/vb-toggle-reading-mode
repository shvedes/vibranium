#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]...

Toggle reading mode in Hyprland by toggling a screen shader.

Options:
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

# Check whether a screen shader is currently active by inspecting
# Hyprland's decoration:screen_shader option.  hyprctl returns the
# literal string "[[EMPTY]]" when no shader is set, and jq strips
# surrounding quotes so the empty case is also matched by ^()$.
_grayscale_enabled() {
  local opt
  opt="$(hyprctl -j getoption decoration:screen_shader | jq -r '.str')"

  if [[ "$opt" == "[[EMPTY]]" || "$opt" =~ ^()$ ]]; then
    return 1
  else
    return 0
  fi
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    break
    ;;
  esac
done

SHADER="$VIBRANIUM/default/hypr/shaders/grayscale.glsl"
CONFIG="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/reading-mode.lua"

log Info "Toggling reading mode"
if _grayscale_enabled; then
  rm -f "$CONFIG"
else
  shcat <<EOF >"$CONFIG"
hl.config({
  decoration = {
    screen_shader = "$SHADER"
  }
})
EOF
fi

# Reload and refresh are backgrounded because hyprctl may take tens of
# ms over the socket and the waybar module refresh depends on the new
# state being visible to vb-hw-gpu first.
hyprctl -q reload config-only &
vb-refresh-waybar-module reading-mode &
