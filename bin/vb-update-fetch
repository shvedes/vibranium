#!/bin/bash

set -euo pipefail

# This script is triggered by a systemd timer and runs non-interactively.
# It is intentionally silent (no log/usage functions) because all output
# goes to the journal and the user is notified via Waybar or notify-send
# only when an update is actually found.

# Wait for network, bail out after 60 attempts (~1 minute)
attempts=0
while ! ping -c 1 -W 2 8.8.8.8 &> /dev/null; do
  attempts=$((attempts + 1))

  if ((attempts >= 60)); then
    exit 1
  fi

  sleep 1
done

git -C "$VIBRANIUM" fetch --all --tags --prune --prune-tags &> /dev/null || exit 1

branch="$(git -C "$VIBRANIUM" branch --show-current)"

if [[ -z "$branch" ]]; then
  remote_latest=$(git -C "$VIBRANIUM" for-each-ref --sort=-version:refname --format='%(refname:short)' --count=1 'refs/tags/*')
  if [[ -z "$remote_latest" ]]; then
    exit 0
  fi

  local_latest=$(git -C "$VIBRANIUM" describe --tags --exact-match --always --abbrev=7 2> /dev/null)

  if [[ "$remote_latest" != "$local_latest" ]]; then
    echo "$remote_latest" > "$VIBRANIUM_STATE/update.available"
    if systemctl -q --user is-active waybar; then
      # RTMIN+12 = pacman module, RTMIN+10 = update module
      pkill -RTMIN+12 waybar || true
      pkill -RTMIN+10 waybar || true
    else
      notify-send -r 1 -t 180000 \
        "New Version Available" \
        "To update, open Vibranium Menu"
    fi
  fi
else
  if [[ "$branch" != "master" ]]; then
    exit 0
  fi

  behind=$(git -C "$VIBRANIUM" rev-list HEAD..origin/master --count 2> /dev/null || echo 0)

  if ((behind > 0)); then
    echo "$behind" > "$VIBRANIUM_STATE/update.available"
    if systemctl -q --user is-active waybar; then
      # RTMIN+12 = pacman module, RTMIN+10 = update module
      pkill -RTMIN+12 waybar || true
      pkill -RTMIN+10 waybar || true
    else
      notify-send -r 1 -t 180000 \
        "New Version Available" \
        "To update, go to Vibranium Menu"
    fi
  fi
fi
