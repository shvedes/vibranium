#!/bin/bash

source vb-lib-cli

VERBOSE=false

SELF="${0##*/}"

usage() {
  shcat << EOF
Usage: $SELF [OPTION]

Toggle systemd idle inhibitor.

Options:
  -v, --verbose   Enable verbose output
  -h, --help      Show this help and exit
  -r, --retoggle  If an inhibitor is active, stop it and restart it under
                  the current type. Used after a type change in cfgr-idle.
                  No-op if no inhibitor is running. (hacky workaround)
EOF
}

opt_retoggle=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -r | --retoggle)
      opt_retoggle=1
      shift
      ;;
    -*)
      log Error "unknown option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

REFRESH_BAR=false
TYPE="$(vb-cmd-get-option VIBRANIUM_GLOBAL_INHIBIT_TYPE)"
UNIT="vibranium-inhibit@${TYPE}.service"

# Scan the two possible inhibitor unit types (idle and sleep) to find
# which one (if any) is currently active.  Only one can be active at a
# time since this script toggles between them.
_active_unit=""
for _type in idle sleep; do
  _candidate="vibranium-inhibit@${_type}.service"
  if systemctl -q --user is-active "$_candidate"; then
    _active_unit="$_candidate"
    break
  fi
done

# Retoggle: called after an inhibitor type change in cfgr-idle.  Stops
# the old type and starts the new one.  No-op when the current active
# unit already matches the configured type.
if ((opt_retoggle)); then
  log Info "Retoggle requested"
  if [[ -n "$_active_unit" && "$_active_unit" != "$UNIT" ]]; then
    log Info "Switching inhibitor from $_active_unit to $UNIT"
    systemctl -q --user stop "$_active_unit"
    systemctl -q --user start "$UNIT" &
    REFRESH_BAR=true
  fi
elif [[ -n "$_active_unit" ]]; then
  log Info "Stopping inhibitor: $_active_unit"
  systemctl -q --user stop "$_active_unit" &
  REFRESH_BAR=true
else
  log Info "Starting inhibitor: $UNIT"
  systemctl -q --user start "$UNIT" &
  REFRESH_BAR=true
fi

if $REFRESH_BAR; then
  vb-refresh-waybar-module inhibitor &
fi
