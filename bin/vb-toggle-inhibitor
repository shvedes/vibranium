#!/usr/bin/bash

# Toggle a persistent systemd-inhibit to prevent idle suspend.
# If an inhibitor is already running, stops it; otherwise starts a new one.
# Refreshes the Vibranium Waybar inhibitor module after action.

VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

SELF="${0##*/}"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

_usage() {
  shcat <<EOF
Usage: $SELF [OPTION]

Toggle systemd idle inhibitor.

Options:
  -v, --verbose   Enable verbose output
  -h, --help      Show this help and exit
  -r, --retoggle  If an inhibitor is active, stop it and restart it under
                  the current type. Used after a type change in cfgr-idle.
                  No-op if no inhibitor is running. (hacky workaround)
EOF
}

opt_retoggle=0

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    _usage
    exit 0
    ;;
  -r | --retoggle)
    opt_retoggle=1
    shift
    ;;
  -*)
    echo "Error: unknown option: $1" >&2
    echo "Try '$SELF --help' for more information" >&2
    exit 1
    ;;
  *)
    break
    ;;
  esac
done

REFRESH_BAR=false
TYPE="$(vb-cmd-get-option VIBRANIUM_GLOBAL_INHIBIT_TYPE)"
UNIT="vibranium-inhibit@${TYPE}.service"

_active_unit=""
for _type in idle sleep; do
  _candidate="vibranium-inhibit@${_type}.service"
  if systemctl -q --user is-active "$_candidate"; then
    _active_unit="$_candidate"
    break
  fi
done

if ((opt_retoggle)); then
  log Info "Retoggle requested"
  if [[ -n "$_active_unit" && "$_active_unit" != "$UNIT" ]]; then
    log Info "Switching inhibitor from $_active_unit to $UNIT"
    systemctl -q --user stop "$_active_unit"
    systemctl -q --user start "$UNIT" &
    REFRESH_BAR=true
  fi
elif [[ -n "$_active_unit" ]]; then
  log Info "Stopping inhibitor: $_active_unit"
  systemctl -q --user stop "$_active_unit" &
  REFRESH_BAR=true
else
  log Info "Starting inhibitor: $UNIT"
  systemctl -q --user start "$UNIT" &
  REFRESH_BAR=true
fi

if $REFRESH_BAR; then
  vb-refresh-waybar-module inhibitor &
fi
