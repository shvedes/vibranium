#!/usr/bin/env bash

# Refresh a Waybar custom module by sending its configured signal.
# Usage: vb-cmd-refresh-bar-module <module-name>

usage() {
    cat << EOF
Usage: $(basename "$0") MODULE_NAME

Send a refresh signal to the Waybar module MODULE_NAME.

Options:
  -h, --help   Show this help and exit
EOF
}

# CLI parsing
case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
esac

[[ -z "${1:-}" ]] && { usage; exit 1; }

module_name="$1"

declare -A signals
while IFS=":" read -r file rest; do
    name="$(basename "$file" .jsonc)"
    sig="$(grep -o '[0-9]\+' <<< "$rest")"
    signals["$name"]="$sig"
done < <(grep '"signal":' "$VIBRANIUM"/default/waybar/*)

module_signal="${signals[$module_name]}"

if [ -n "$module_signal" ]; then
    pkill -RTMIN+"$module_signal" waybar &
    pkill -RTMIN+"${signals[dynamic-separator]}" waybar &
else
    echo "Unknown module: $module_name" >&2
    exit 1
fi
