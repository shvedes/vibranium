#!/usr/bin/env bash

# shellcheck disable=SC2034

source "$VIBRANIUM_PATH/vibranium-core-lib"

export SUDO_PROMPT
SUDO_PROMPT="$(printf '%s[VIBRANIUM]%s Password for %s: ' "$RED" "$RESET" "$USER")"

_operation_canceled() {
    echo -e "${RED}[VIBRANIUM]${RESET} Operation canceled"
    read -n1 -r -p $'\e[0;33m[VIBRANIUM]\e[0m Press any key to close this window' dummy
    printf '\e[?25h' # show cursor

    # Here we use code 0 because system update
    # already has been performed successfuly,
    # we just canceling system reboot
    exit 0
}

if ! tty -s; then
    exec setsid vibranium-cmd-terminal "$0" "$@"
    exit 0
fi

printf "\n\e[33m%s\e[0m\n\n" "$(cat "$VIBRANIUM/logo.txt")"

if ! sudo -v; then
    echo -e "${RED}[VIBRANIUM]${RESET} Operation aborted"
    exit 1
fi

# Hide cursor
printf '\e[?25l'

yay -Sy &> /dev/null &
spinner "$!" "${YELLOW}[VIBRANIUM]${RESET} Refreshing repositories" ""

mapfile -t pkg_list < <(yay -Qqu)

if [[ -z "${pkg_list[*]}" ]]; then
    echo -e "${GREEN}[VIBRANIUM]${RESET} You are up to date"
    read -n1 -r -p $'\e[0;33m[VIBRANIUM]\e[0m Press any key to close this window' dummy
    exit 0
fi

echo -e "${YELLOW}[VIBRANIUM]${RESET} ${#pkg_list[@]} packages are awaiting updates"
echo -e "${YELLOW}[VIBRANIUM]${RESET} Starting system update..."

if ! yay --noconfirm --sudoloop; then
    echo -e "${RED}[VIBRANIUM]${RESET} Something went wrong"
    read -n1 -r -p $'\e[0;31m[VIBRANIUM]\e[0m Press any key to close this window' dummy
    exit 1
fi

vibranium-cmd-refresh-waybar-module pacman

important_regex='^(systemd|linux(-.*)?|networkmanager|iwd|mesa|nvidia)$'
restart_required=false
for pkg in "${pkg_list[@]}"; do
    if [[ $pkg =~ $important_regex ]]; then
        echo -e "${YELLOW}[VIBRANIUM]${RESET} Important system components have been updated"
        prompt=$'\e[0;33m[VIBRANIUM]\e[0m System restart is recommended. Restart now? (Y/n): '

        while true; do
            printf "%s\e[?25h" "$prompt"
            read -r answer
            printf '\e[?25l'
            case "$answer" in
                [Yy][Ee][Ss] | [Yy] | "")
                    printf '\e[?25l'

                    # Cancel countdown & system reboot on CTRL C
                    trap '_operation_canceled' INT

                    for i in {3..1}; do
                        for dots in "" "." ".." "..."; do
                            printf "\r\033[K%s[VIBRANIUM]%s Restarting in %d%s" "$YELLOW" "$RESET" "$i" "$dots"
                            sleep 0.25
                        done
                    done
                    systemctl reboot
                    exit 0
                    ;;
                [Nn][Oo] | [Nn])
                    restart_required=true
                    break
                    ;;
                *)
                    printf '\r\e[K'
                    ;;
            esac
        done

        break
    fi
done

if [[ "$restart_required" == true ]]; then
    final_msg="System update complete. Restart required"
else
    final_msg="System update complete. No restart required"
fi

printf "\r\033[K%s[VIBRANIUM]%s %s\n" "$GREEN" "$RESET" "$final_msg"
read -n1 -r -p $'\e[0;33m[VIBRANIUM]\e[0m Press any key to close this window' dummy
