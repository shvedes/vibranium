#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} MODULE_NAME

Send a refresh signal to the Waybar module MODULE_NAME.

Options:
  -h, --help   Show this help and exit
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    break
    ;;
  esac
done

waybar_pid=$(systemctl --user show waybar -p MainPID --value 2>/dev/null)

declare -A signals

for file in "$XDG_CONFIG_HOME"/waybar/modules/custom-*.jsonc; do
  while IFS= read -r line; do
    [[ $line == *'"signal"'* ]] || continue

    name="${file##*/}"     # remove path
    name="${name%.jsonc}"  # remove file extension
    name="${name#custom-}" # remove prefix
    [[ $line =~ \"signal\":[[:space:]]*([0-9]+) ]] && sig="${BASH_REMATCH[1]}" || sig=""

    signals["$name"]="$sig"
  done <"$file"
done

module_name="${1/custom-/}"
module_signal="${signals[$module_name]}"

_send_signal() {
  local sig=$1
  if ((waybar_pid > 0)); then
    kill -RTMIN+"$sig" "$waybar_pid" 2>/dev/null
  else
    pkill -RTMIN+"$sig" waybar 2>/dev/null
  fi
}

if [[ -n "$module_signal" ]]; then
  _send_signal "$module_signal"
else
  log Error "No signal defined for module: $module_name"
  exit 1
fi

# Always refresh separators
[[ -n "${signals[dynamic-separator]}" ]] && _send_signal "${signals[dynamic-separator]}"
[[ -n "${signals[mod-separator]}" ]] && _send_signal "${signals[mod-separator]}"
