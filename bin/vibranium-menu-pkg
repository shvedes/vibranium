#!/usr/bin/env bash

source "$VIBRANIUM_PATH/vibranium-core-lib"

ACTIONS=("System update" "Install a package" "Uninstall a package")

while true; do
    CHOSEN="$(printf "%s\n" "${ACTIONS[@]}" | rofi_cmd "Packages" "ESC to go back")"
    [[ -z $CHOSEN ]] && break

    case "$CHOSEN" in
        "System update")
            vibranium-cmd-terminal vibranium-pkg-sysupdate
            vibranium-cmd-kill-rofi
            exit 0
            ;;
        "Install a package")
            vibranium-cmd-terminal vibranium-pkg-install
            vibranium-cmd-kill-rofi
            exit 0
            ;;
        "Uninstall a package")
            vibranium-cmd-terminal vibranium-pkg-uninstall
            vibranium-cmd-kill-rofi
            exit 0
            ;;
        *)
            continue
            ;;
    esac
done
