#!/bin/bash

source vb-lib-cli
source vb-lib-core

VERBOSE=${VERBOSE:-false}

usage() {
	shcat << EOF
Usage: ${0##*/} [OPTION]... [PACKAGE]...

Install packages (official repos by default, AUR with --aur)

Options:
  --no-ask          Do not ask for confirmation
  --no-logo         Do not display the Vibranium logo
  --no-dummy        Do not wait for a key press after completion or cancellation
  --no-verify       Skip verification of package existence in repositories
  --no-systemd      Skip systemd post-install hook
  --conservative    Do not print any success / fail messages

  --force-install   Forefully install already installed packages
  --skip-overview   Skip the pre-installation overview
  --keep-cache      Do not remove cached packages after install
  --embedded        Run in embedded mode. Usually called from inside another script
  --aur             Install from AUR instead of official repositories
  -v, --verbose     Enable verbose output
  -h, --help        Show this help and exit
  --                End of options. Everything after is PACKAGE

If no PACKAGE is provided, refresh repositories and use fzf for interactive package selection.
Packages are filtered to install only those not already present.
Systemd units (services/sockets) from installed packages are detected and enabled with user prompts.
EOF
}

_ask_for_sudo() {
	log Info "_ask_for_sudo: checking sudo"
	sudo -n true 2> /dev/null && return

	term::enable_input
	sudo -v
	term::disable_input
}

# This loop has no natural exit condition: the parent kills the background
# job after the package command completes, then waits for it, preventing the
# next package from starting until the child is reaped. This stops a stale
# spinner from overwriting subsequent output.
_spinner() {
	local spinner_frames=(
		'[=     ]'
		'[==    ]'
		'[ ==   ]'
		'[  ==  ]'
		'[   == ]'
		'[    ==]'
		'[     =]'
	)

	local i
	read -r i < "$5" || i=0

	while true; do
		if [[ "$3" == "1" ]]; then
			printf "\r\033[K%s[*]%s %s Installing %s%s" \
				"$Y" "$RS" \
				"${GY}${spinner_frames[$i]}${RS}" \
				"${Y}${1}${RS}" "${4}"
		else
			printf "\r\033[K%s[*]%s %s Installing %s%s [%d/%d]" \
				"$Y" "$RS" \
				"${GY}${spinner_frames[$i]}${RS}" \
				"${Y}${1}${RS}" "${4}" "$2" "$3"
		fi
		echo "$i" > "$5"

		i=$(((i + 1) % ${#spinner_frames[@]}))
		sleep 0.15
	done
}

# Discovers systemd units exposed by FILTERED packages. The pure-bash parser
# below categorizes .service/.socket files from pacman -Ql output; aligned
# arrays retain package, type, scope, and unit basename in priority order:
# user socket, user service, system socket, system service.
_handle_systemd() {
	log Info "Checking systemd units for ${#FILTERED[@]} packages"
	local pkg
	local _pq_p _pq_path _pq_rest _pq_rel _pq_u
	local -a _pq_user_sockets=() _pq_user_services=()
	local -a _pq_sys_sockets=() _pq_sys_services=()

	prov_sysd_svc=()
	unit_types=()
	unit_scope=()
	unit_names=()

	for pkg in "${FILTERED[@]}"; do
		_pq_user_sockets=()
		_pq_user_services=()
		_pq_sys_sockets=()
		_pq_sys_services=()
		while read -r _pq_p _pq_path _pq_rest; do
			[[ -n "${_pq_path:-}" ]] || continue
			case "$_pq_path" in
				*@*) continue ;;
			esac
			case "$_pq_path" in
				*/systemd/user/*)
					_pq_rel="${_pq_path##*/systemd/user/}"
					if [[ "$_pq_rel" != */* ]]; then
						case "$_pq_rel" in
							?*.socket) _pq_user_sockets+=("$_pq_path") ;;
							?*.service) _pq_user_services+=("$_pq_path") ;;
						esac
					fi
					;;
				*/systemd/system/*)
					_pq_rel="${_pq_path##*/systemd/system/}"
					if [[ "$_pq_rel" != */* ]]; then
						case "$_pq_rel" in
							?*.socket) _pq_sys_sockets+=("$_pq_path") ;;
							?*.service) _pq_sys_services+=("$_pq_path") ;;
						esac
					fi
					;;
			esac
		done < <(pacman -Ql "$pkg" 2> /dev/null)
		for _pq_u in "${_pq_user_sockets[@]}"; do
			prov_sysd_svc+=("$pkg")
			unit_types+=("socket")
			unit_scope+=("user")
			unit_names+=("${_pq_u##*/}")
		done
		for _pq_u in "${_pq_user_services[@]}"; do
			prov_sysd_svc+=("$pkg")
			unit_types+=("service")
			unit_scope+=("user")
			unit_names+=("${_pq_u##*/}")
		done
		for _pq_u in "${_pq_sys_sockets[@]}"; do
			prov_sysd_svc+=("$pkg")
			unit_types+=("socket")
			unit_scope+=("system")
			unit_names+=("${_pq_u##*/}")
		done
		for _pq_u in "${_pq_sys_services[@]}"; do
			prov_sysd_svc+=("$pkg")
			unit_types+=("service")
			unit_scope+=("system")
			unit_names+=("${_pq_u##*/}")
		done
	done
}

# Walks each package's ordered unit list. Active and static units are left
# unchanged; the first unit accepted for enabling stops lower-priority checks.
_enable_systemd_units() {
	if ((${#prov_sysd_svc[@]} == 0)); then
		log Info "No systemd units to enable"
		return
	fi

	log Info "Processing ${#prov_sysd_svc[@]} unit(s)"
	local -a unique_pkgs
	mapfile -t unique_pkgs < <(printf '%s\n' "${prov_sysd_svc[@]}" | sort -u)

	local pkg unit_type scope unit_name enabled active
	local -a pids=()

	for pkg in "${unique_pkgs[@]}"; do
		for i in "${!prov_sysd_svc[@]}"; do
			if [[ "${prov_sysd_svc[$i]}" != "$pkg" ]]; then
				continue
			fi

			unit_type="${unit_types[$i]}"
			scope="${unit_scope[$i]}"
			unit_name="${unit_names[$i]}"

			if [[ "$scope" == "user" ]]; then
				enabled=""
				IFS= read -r enabled < <(systemctl --user is-enabled "$unit_name" 2> /dev/null) || true
				active=""
				IFS= read -r active < <(systemctl --user is-active "$unit_name" 2> /dev/null) || true
			else
				enabled=""
				IFS= read -r enabled < <(systemctl is-enabled "$unit_name" 2> /dev/null) || true
				active=""
				IFS= read -r active < <(systemctl is-active "$unit_name" 2> /dev/null) || true
			fi

			if [[ "$active" == "active" ]]; then
				vb::print "$B" "${G}${unit_name}${RS} is already active ($scope scope)"
				break
			fi

			if [[ "$enabled" == "static" ]]; then
				vb::print "$B" "${G}${unit_name}${RS} is static ($scope scope) — skipping"
				continue
			fi

			if [[ "$enabled" != "enabled" ]]; then
				if ! term::ask_yes_no Y "Enable $unit_type '${B}${unit_name}${RS}' from package '${Y}${pkg}${RS}' ($scope scope)?"; then
					continue
				fi
			else
				vb::print "$B" "Enabling ${G}${unit_name}${RS} ($scope scope)"
			fi

			term::disable_input
			if [[ "$scope" == "user" ]]; then
				systemctl -q --user --now enable "$unit_name" &
			else
				sudo systemctl -q --now enable "$unit_name" &
			fi
			pids+=($!)
			break
		done
	done

	if ((${#pids[@]} > 0)); then
		vb::print "$B" "Waiting for systemd units to be enabled..."
		wait "${pids[@]}"
	fi
}

# Verifies that each requested package exists in the selected source.
# Missing names are reported together; the return status is 1 when any are absent.
_ensure_if_exist() {
	log Info "Verifying ${#PACKAGES[@]} package(s) exist"
	local total="${#PACKAGES[@]}"
	local -a missing=()
	local index=1

	for pkg in "${PACKAGES[@]}"; do
		printf "\r\033[K%s[*]%s Verifying packages [%s/%s]" "$B" "$RS" "$index" "$total"

		if [[ "$AUR_MODE" == true ]]; then
			if ! yay -Si "$pkg" &> /dev/null; then
				missing+=("$pkg")
			fi
		else
			if ! pacman -Si "$pkg" &> /dev/null; then
				missing+=("$pkg")
			fi
		fi

		((index++))
	done

	printf "\n"

	if ((${#missing[@]} > 0)); then
		vb::print "$R" "Could not find the following packages:"
		for pkg in "${missing[@]}"; do
			echo -e "\t   - ${R}${pkg}${RS}"
		done
		return 1
	fi
}

pkg_prepare_result() {
	if [[ -z "${term_original_settings:-}" ]]; then
		term::disable_input
	fi
}

# Result helpers normalize terminal state for normal and embedded callers.
# Conservative mode still restores input when a terminal has disabled input,
# but bypasses the user-facing operation result and its wait behavior.
pkg_result() {
	local outcome="$1"
	shift

	if [[ "$CONSERV" == true ]]; then
		if [[ -n "${term_original_settings:-}" ]]; then
			term::enable_input > /dev/null 2>&1 || true
		fi
		return 0
	fi

	pkg_prepare_result
	if [[ "$NO_DUMMY" == true ]]; then
		operation::result "$outcome" --no-wait "$@"
	else
		operation::result "$outcome" "$@"
	fi
}

pkg_signal_canceled() {
	trap - SIGHUP SIGINT SIGTERM SIGQUIT

	if [[ "$CONSERV" == true ]]; then
		if [[ -n "${term_original_settings:-}" ]]; then
			term::enable_input > /dev/null 2>&1 || true
		fi
	else
		pkg_prepare_result
		if [[ "$NO_DUMMY" == true ]]; then
			operation::result canceled --no-wait
		else
			operation::result canceled
		fi
	fi

	exit 1
}

# Filters out already-installed packages from PACKAGES and populates FILTERED.
# Candidate preparation uses pacman -Qq so already-installed names can leave
# the candidate set. FORCE_INST bypasses this filter, and the package-manager
# --needed flag independently protects the non-forced path.
_filter_packages() {
	log Info "Filtering ${#PACKAGES[@]} package(s), force=$FORCE_INST"
	if [[ "$FORCE_INST" == true ]]; then
		FILTERED=("${PACKAGES[@]}")
		return
	fi

	for pkg in "${PACKAGES[@]}"; do
		if ! pacman -Qq "$pkg" &> /dev/null; then
			FILTERED+=("$pkg")
		fi
	done

	if ((${#FILTERED[@]} == 0)); then
		if ((${#PACKAGES[@]} == 1)); then
			vb::print "$G" "${Y}$PACKAGES${RS} is already installed"

			if [[ "$NO_ASK" == false ]]; then
				if term::ask_yes_no Y "Install it anyway?"; then
					NO_ASK=true
					SKIP_OVW=true
					FORCE_INST=true
					FILTERED=("${PACKAGES[@]}")
					return
				fi
			fi
		else
			vb::print "$G" "Selected packages are already installed"
		fi

		if [[ $EMBEDDED == false ]]; then
			pkg_result noop
		fi
		exit 0
	elif ((${#PACKAGES[@]} != ${#FILTERED[@]})); then
		local diff=$((${#PACKAGES[@]} - ${#FILTERED[@]}))
		if ((diff == 1)); then
			vb::print "$B" "$diff package is already installed"
		else
			vb::print "$B" "$diff packages are already installed"
		fi
	fi
}

# Selections of up to five packages stay inline; longer selections are
# rendered one per line. No terminal-height calculation is performed.
_show_overview() {
	if [[ "$SKIP_OVW" == true ]]; then
		return
	fi

	local packages=("${FILTERED[@]}")

	if ((${#packages[@]} == 0)); then
		return
	fi

	if ((${#packages[@]} <= 5)); then
		vb::print "$Y" "You're about to install the following packages: ${Y}${packages[*]}${RS}"
		return
	fi

	vb::print "$B" "You're about to install the following packages:"
	for pkg in "${packages[@]}"; do
		echo -e "   * ${Y}${pkg}${RS}"
	done
}

# FILTERED expands into separate argv entries, so package names remain data
# rather than shell-parsed text. --needed skips each target that is already
# current; force branches omit it to request reinstalls.
_install_packages() {
	log Info "Installing ${#FILTERED[@]} package(s) (aur=$AUR_MODE, force=$FORCE_INST)"
	if [[ "$AUR_MODE" == true ]]; then
		if [[ "$FORCE_INST" == true ]]; then
			yes | yay -S "${YAY_FLAGS[@]}" "${FILTERED[@]}"
		else
			yes | yay --needed -S "${YAY_FLAGS[@]}" "${FILTERED[@]}"
		fi
	else
		if [[ "$FORCE_INST" == true ]]; then
			sudo pacman -S --noconfirm "${FILTERED[@]}"
		else
			sudo pacman -S --noconfirm --needed "${FILTERED[@]}"
		fi
	fi
}

# Embedded mode invokes the package manager separately for each item so the
# spinner can be stopped between items. The normal path kills and reaps each
# spinner, then removes the shared frame file; a signal can interrupt that
# lifecycle.
_embed_install() {
	log Info "Embedded install of ${#FILTERED[@]} package(s)"
	local total=${#FILTERED[@]}
	local current=0
	local pkg
	local spinner_pid
	local frame_file
	frame_file=$(mktemp)
	echo 0 > "$frame_file"

	if [[ "$AUR_MODE" == true ]]; then
		local yay_opts="--needed"
		if [[ "$FORCE_INST" == true ]]; then
			yay_opts=""
		fi

		for pkg in "${FILTERED[@]}"; do
			((current++))

			_spinner "$pkg" "$current" "$total" "" "$frame_file" &
			spinner_pid=$!

			yay --noconfirm $yay_opts -Sy "$pkg" &> /dev/null

			kill "$spinner_pid" 2> /dev/null
			wait "$spinner_pid" 2> /dev/null
		done
	else
		local pacman_opts="--needed"
		if [[ "$FORCE_INST" == true ]]; then
			pacman_opts=""
		fi

		for pkg in "${FILTERED[@]}"; do
			((current++))

			_spinner "$pkg" "$current" "$total" "" "$frame_file" &
			spinner_pid=$!

			sudo pacman --noconfirm $pacman_opts -S "$pkg" &> /dev/null

			kill "$spinner_pid" 2> /dev/null
			wait "$spinner_pid" 2> /dev/null
		done
	fi

	rm -f "$frame_file"

	if ((total == 1)); then
		printf "\r\033[K%s[*]%s %s installed\n" \
			"$G" "$RS" "${Y}${FILTERED[0]}${RS}"
	else
		printf "\r\033[K%s[*]%s Installed %d packages\n" \
			"$G" "$RS" "$total"
	fi
}

# Fetches list of available packages. Arch repos or AUR depending on --aur flag. Populates PACKAGES.
# The producer writes a temporary list; term::spinner reaps it, then mapfile
# reads the file. A producer failure can still leave a partial file that
# mapfile consumes.
_get_packages() {
	log Info "Fetching package list (aur=$AUR_MODE)"
	if [[ "$AUR_MODE" == true ]]; then
		local aur_temp
		aur_temp=$(mktemp)

		(yay -Slqa > "$aur_temp" 2> /dev/null) &
		term::spinner $! "${Y}[*]${RS} Fetching ${B}AUR${RS} packages" \
			"- ${G}Done!${RS}"

		mapfile -t PACKAGES < "$aur_temp"
		rm -f "$aur_temp"
	else
		local arch_temp
		arch_temp=$(mktemp)

		(pacman -Slq > "$arch_temp") &
		term::spinner $! "${Y}[*]${RS} Fetching ${B}official${RS} packages" \
			"- ${G}Done!${RS}"

		mapfile -t PACKAGES < "$arch_temp"
		rm -f "$arch_temp"
	fi
}

# Allows the user to select packages using fzf with preview.
# Populates PACKAGES with selected items. Returns 1 if none selected.
_choose_packages() {
	log Info "Opening fzf for package selection"
	local -a chosen

	term::enable_input
	mapfile -t chosen < <(printf '%s\n' "${PACKAGES[@]}" | sort -u | fzf "${FZF_FLAGS[@]}")
	term::disable_input

	((${#chosen[@]} == 0)) && return 1
	PACKAGES=("${chosen[@]}")
}

_cleanup() {
	log Info "Running cleanup (aur=$AUR_MODE, keep_cache=$KEEP_CACHE)"

	local state_file="$VIBRANIUM_STATE/${0##*/}"

	# The state file records only a cache decision. Only true selects cleanup
	# immediately; false skips it; unset or any other value enters the prompt.
	# Inputs other than y and n leave the local cleanup decision false.
	if [[ -f "$state_file" ]]; then
		source "$state_file"
		export remove_cache
	fi

	if [[ "$AUR_MODE" == true ]]; then
		vb::print "$B" "Removing orphan packages"
		yay -Ycc --noconfirm &> /dev/null

		if [[ "$KEEP_CACHE" == false ]]; then
			local do_clean=false

			if [[ "$remove_cache" == true ]]; then
				do_clean=true
			elif [[ "$remove_cache" != false ]]; then
				term::enable_input
				local _cache_input
				term::prompt_line _cache_input $'\e[0;33m[*]\e[0m Remove package cache? [y/N/a (ask next time)]: ' || _cache_input=""
				term::disable_input
				case "${_cache_input,,}" in
					y)
						do_clean=true
						if term::ask_yes_no Y "Remember this option?"; then
							mkdir -p "$VIBRANIUM_STATE"
							echo 'remove_cache=true' > "$state_file"
						fi
						;;
					n)
						if term::ask_yes_no Y "Remember this option?"; then
							mkdir -p "$VIBRANIUM_STATE"
							echo 'remove_cache=false' > "$state_file"
						fi
						;;
				esac
			fi

			if [[ "$do_clean" == true ]]; then
				yay -Scc --noconfirm &> /dev/null &
				term::spinner $! "${B}[*]${RS} Removing package cache" "" ""
			fi
		fi
	else
		local orphans
		mapfile -t orphans < <(pacman -Qdtq 2> /dev/null)
		if ((${#orphans[@]})); then
			vb::print "$B" "Removing orphan packages"
			sudo pacman -Rns --noconfirm "${orphans[@]}" &> /dev/null
		fi

		if [[ "$KEEP_CACHE" == false ]]; then
			local do_clean=false

			if [[ "$remove_cache" == true ]]; then
				do_clean=true
			elif [[ "$remove_cache" != false ]]; then
				term::enable_input
				local _cache_input
				term::prompt_line _cache_input $'\e[0;33m[*]\e[0m Remove package cache? [y/N/a (ask next time)]: ' || _cache_input=""
				term::disable_input
				case "${_cache_input,,}" in
					y)
						do_clean=true
						if term::ask_yes_no Y "Remember this option?"; then
							mkdir -p "$VIBRANIUM_STATE"
							echo 'remove_cache=true' > "$state_file"
						fi
						;;
					n)
						if term::ask_yes_no Y "Remember this option?"; then
							mkdir -p "$VIBRANIUM_STATE"
							echo 'remove_cache=false' > "$state_file"
						fi
						;;
				esac
			fi

			if [[ "$do_clean" == true ]]; then
				sudo pacman -Scc --noconfirm &> /dev/null &
				term::spinner $! "${B}[*]${RS} Removing package cache" "" ""
			fi
		fi
	fi
}

# The pre-scan keeps an embedded invocation out of the terminal relaunch
# branch, so a process launch does not create a second terminal.
_emb_early=false
for _arg in "$@"; do
	if [[ "$_arg" == "--embedded" ]]; then
		_emb_early=true
		break
	fi
done

if [[ $_emb_early == false ]] && term::is_headless; then
	vb-launch-terminal --app-id=org.vb.term.float --title="${0##*/}" -- "$0" "$@"
	exit
fi

NO_ASK=false
NO_LOGO=false
NO_DUMMY=false
NO_VERIFY=false
NO_SYSTEMD=false
KEEP_CACHE=false
CONSERV=false
FORCE_INST=false
SKIP_OVW=false
EMBEDDED=false
AUR_MODE=false
PACKAGES=()
FILTERED=()

trap 'pkg_signal_canceled' SIGHUP SIGINT SIGTERM SIGQUIT

while [[ $# -gt 0 ]]; do
	case "$1" in
		--help | -h)
			usage
			exit 0
			;;
		-v | --verbose)
			export VERBOSE=true
			shift
			;;
		--embedded)
			EMBEDDED=true
			shift
			;;
		--no-ask)
			NO_ASK=true
			shift
			;;
		--no-logo)
			NO_LOGO=true
			shift
			;;
		--no-dummy)
			NO_DUMMY=true
			shift
			;;
		--no-verify)
			NO_VERIFY=true
			shift
			;;
		--no-systemd)
			NO_SYSTEMD=true
			shift
			;;
		--keep-cache)
			KEEP_CACHE=true
			shift
			;;
		--conservative)
			CONSERV=true
			shift
			;;
		--force-install)
			FORCE_INST=true
			shift
			;;
		--skip-overview)
			SKIP_OVW=true
			shift
			;;
		--aur)
			AUR_MODE=true
			shift
			;;
		--)
			shift
			if [[ $# -eq 0 ]]; then
				usage
				exit 1
			fi
			break
			;;
		--* | -*)
			log Error "Unknown option: $1"
			exit 1
			;;
		*)
			log Error "Unexpected argument: $1. Use '--' to separate options from packages"
			exit 1
			;;
	esac
done

if [[ -f "$VIBRANIUM_STATE/theme/fzf" ]]; then
	source "$VIBRANIUM_STATE/theme/fzf"
fi

if [[ "$AUR_MODE" == true ]]; then
	YAY_FLAGS=(
		"--answerclean" "Y"
		"--answerdiff" "N"
		"--answeredit" "N"
		"--removemake"
		"--cleanafter"
		"--noconfirm"
		"--sudoloop"
	)
fi

# Single preview entry point for the fzf package list: repository metadata
# when the package exists in the official repos, AUR metadata otherwise.
# Keeps FZF_FLAGS below static while preserving per-mode behavior (official
# info in repo mode, AUR info in AUR mode). Exported so fzf's preview
# subshell (bash -c) can call it.
_pkg_info() {
	local pkg=$1
	if pacman -Si "$pkg" 2> /dev/null; then
		return 0
	fi
	if command -v yay > /dev/null 2>&1; then
		yay -Sii "$pkg" 2> /dev/null
	fi
}
export -f _pkg_info

FZF_FLAGS=(
	--multi
	--ignore-case
	--highlight-line

	--info 'hidden'
	--border 'bold'

	--border-label ' alt-p: toggle description, alt-j/k: scroll description, alt-b/B: PKGBUILD, alt-i: info, ctrl-j/k: next/prev item, tab: multi-select '
	--border-label-pos 'bottom'

	--list-label 'Package list'
	--list-border 'bold'

	--input-label 'Filter packages'
	--input-border 'bold'

	--preview '_pkg_info {1}'
	--preview-border 'bold'
	--preview-window 'up:55%:wrap'
	--preview-label 'Package Information'

	--bind 'alt-p:toggle-preview'
	--bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
	--bind 'alt-k:preview-up,alt-j:preview-down'
	--bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
	--bind 'alt-B:change-preview:yay -Siia {1}'
	--bind 'alt-i:change-preview:_pkg_info {1}'

	--color "${FZF_COLORS:-pointer:white,marker:green}"
)

if [[ $EMBEDDED == true ]]; then
	if [[ $# -eq 0 ]]; then
		exit 1
	fi

	PACKAGES=("$@")
	term::disable_input

	_filter_packages
	if ! _ask_for_sudo; then
		term::enable_input
		exit 1
	fi
	_embed_install
	exit 0
fi

if [[ $NO_LOGO == false ]]; then
	term::show_header
fi

term::disable_input

if [[ $# -gt 0 ]]; then
	PACKAGES=("$@")

	if [[ $NO_VERIFY == false ]]; then
		if ! _ensure_if_exist; then
			pkg_result error
			exit 1
		fi
	fi

	_filter_packages
	_show_overview
else
	if ! command -v fzf > /dev/null; then
		log::error "fzf not found!"
		term::enable_input
		exit 1
	fi

	_get_packages

	if _choose_packages; then
		_filter_packages
	else
		pkg_result noop
		exit 0
	fi

	_show_overview
fi

if [[ "$NO_ASK" == false ]]; then
	if ! term::ask_yes_no Y "Proceed with installation?"; then
		pkg_result canceled
		exit 1
	fi
fi

if ! _ask_for_sudo; then
	pkg_result error
	exit 1
fi

# The install transaction follows this separate repository metadata refresh.
# The package manager invocation below resolves the exact filtered names
# against the refreshed databases.
sudo pacman -Sy

# Any unit discovery and the cleanup phase run only after the package
# manager returns success, keeping their inputs tied to the installed
# file set.
if _install_packages; then
	if [[ "$NO_SYSTEMD" == false ]]; then
		_handle_systemd
		_enable_systemd_units
	fi

	_cleanup
	term::disable_input # pacman usually restores cursor, so we hide it again
	pkg_result success -- "Installation complete"
else
	pkg_result error
	exit 1
fi
