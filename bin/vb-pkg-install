#!/usr/bin/env bash

source vb-core-lib

_usage() {
    cat <<EOF
Usage: "${0##*/}" [OPTION]... [PACKAGE]...

Install packages in Vibranium

Options:
  --no-logo         Do not display the Vibranium logo at startup
  --no-dummy        Do not request a key press after completion or cancellation
  --no-verify       Skip verification of package existence in repositories

If no PACKAGE is provided, refresh repositories and use fzf for interactive package selection.
Packages are filtered to install only those not already present.
Systemd units (services/sockets) from installed packages are detected and enabled with user prompts.
EOF
}

# Detects systemd units (services and sockets) provided by a list of packages.
# Populates global arrays:
#   - provides_systemd_service: Packages that provide a systemd unit (indexes match with unit_types and unit_scope).
#   - unit_types: Type of unit for each entry ("service" or "socket").
#   - unit_scope: Scope of unit for each entry ("user" or "system").
#   - user_units: List of user unit basenames (for enabling with --user).
#   - services: List of system unit basenames (for enabling as root).
# This function prioritizes sockets over services and user scope over system scope for each package.
# It uses 'pacman -Ql' to list files and filters for .service or .socket files in systemd directories.
_handle_systemd() {
    local pkg units unit
    local -a pkg_user_sockets pkg_user_services pkg_sys_sockets pkg_sys_services

    provides_systemd_service=()
    unit_types=()
    unit_scope=()
    user_units=()
    services=()

    for pkg in "${FILTERED[@]}"; do
        # Get list of .service or .socket files from the package, excluding templated units (@)
        units=$(pacman -Ql "$pkg" 2>/dev/null | awk '/\/systemd\/.*\.(service|socket)$/ && $2 !~ /@/ {print $2}')

        [[ -z $units ]] && continue

        # Reset per-package arrays
        pkg_user_sockets=()
        pkg_user_services=()
        pkg_sys_sockets=()
        pkg_sys_services=()

        # associative array to record socket basenames for this package
        declare -A pkg_socket_basenames=()

        # Classify each unit path into per-package arrays
        while IFS= read -r unit; do
            case "$unit" in
                */systemd/user/*.socket)
                    pkg_user_sockets+=("$unit")
                    # record basename without suffix for socket/service matching
                    pkg_socket_basenames["$(basename "$unit" .socket)"]=1
                    ;;
                */systemd/user/*.service)
                    pkg_user_services+=("$unit")
                    ;;
                */systemd/system/*.socket|/lib/systemd/system/*.socket)
                    pkg_sys_sockets+=("$unit")
                    pkg_socket_basenames["$(basename "$unit" .socket)"]=1
                    ;;
                */systemd/system/*.service|/lib/systemd/system/*.service)
                    pkg_sys_services+=("$unit")
                    ;;
            esac
        done <<< "$units"

        # Append entries in priority order: user sockets, user services, system sockets, system services
        if [[ ${#pkg_user_sockets[@]} -gt 0 ]]; then
            for unit in "${pkg_user_sockets[@]}"; do
                provides_systemd_service+=("$pkg")
                unit_types+=("socket")
                unit_scope+=("user")
                user_units+=("$(basename "$unit")")
            done
        fi

        if [[ ${#pkg_user_services[@]} -gt 0 ]]; then
            for unit in "${pkg_user_services[@]}"; do
                # skip service if there is a socket with the same basename
                local base
                base="$(basename "$unit" .service)"
                if [[ -n "${pkg_socket_basenames[$base]:-}" ]]; then
                    # socket exists, skip proposing the service
                    continue
                fi

                provides_systemd_service+=("$pkg")
                unit_types+=("service")
                unit_scope+=("user")
                user_units+=("$(basename "$unit")")
            done
        fi

        if [[ ${#pkg_sys_sockets[@]} -gt 0 ]]; then
            for unit in "${pkg_sys_sockets[@]}"; do
                provides_systemd_service+=("$pkg")
                unit_types+=("socket")
                unit_scope+=("system")
                services+=("$(basename "$unit")")
            done
        fi

        if [[ ${#pkg_sys_services[@]} -gt 0 ]]; then
            for unit in "${pkg_sys_services[@]}"; do
                # skip service if there is a socket with the same basename
                local base
                base="$(basename "$unit" .service)"
                if [[ -n "${pkg_socket_basenames[$base]:-}" ]]; then
                    continue
                fi

                provides_systemd_service+=("$pkg")
                unit_types+=("service")
                unit_scope+=("system")
                services+=("$(basename "$unit")")
            done
        fi
    done
}

# Enables detected systemd units (services or sockets) for each package individually.
_enable_systemd_units() {
    local index=0
    local pkg unit_name type scope

    # Iterate over packages that provide systemd units
    for pkg in "${provides_systemd_service[@]}"; do
        type="${unit_types[$index]}"
        scope="${unit_scope[$index]}"
        unit_name="${user_units[$index]:-${services[$index]}}"

        if _ask_yes_no Y "Enable $type '${BLUE}${unit_name}${RESET}' from package '${YELLOW}${pkg}${RESET}' ($scope scope)?"; then
            if [[ "$scope" == "user" ]]; then
                systemctl -q --user --now enable "$unit_name" &
            else
                sudo systemctl -q --now enable "$unit_name" &
            fi
        fi

        ((index++))
    done
}

_refresh_repos() {
    yay -Sy &> /dev/null &
    local pid="$!"
    term::spinner "$pid" "${YELLOW}[VIBRANIUM]${RESET} Refreshing repos" ""
}

# Verifies if the given packages exist in the repositories
# Collects missing packages and reports them. Returns 1 if any are missing.
_ensure_if_exist() {
    local total="${#PACKAGES[@]}"
    local missing=()
    local index=1

    # Check each package
    for pkg in "${PACKAGES[@]}"; do
        printf "\r\033[K%s[VIBRANIUM]%s Verifying package [%s/%s]" "$BLUE" "$RESET" "$index" "$total"

        if ! yay -Si "$pkg" &> /dev/null; then
            missing+=("$pkg")
        fi

        ((index++))
    done

    printf "\n"

    # Report missing packages
    if [[ "${#missing[@]}" -gt 0 ]]; then
        echo -e "${RED}[VIBRANIUM]${RESET} Could not find the following packages:"
        for pkg in "${missing[@]}"; do
            echo -e "\t   - ${RED}${pkg}${RESET}"
        done
        return 1
    fi
}

_operation_canceled() {
    local color="$RED"
    local exit_after=false

    case "$1" in
        --positive)
            color="$GREEN"
            ;;
        --exit)
            exit_after=true
            ;;
    esac

    printf "%s[VIBRANIUM]%s Operation canceled" "$color" "$RESET"

    if [[ $NO_DUMMY == false ]]; then
        read -n1 -r -s -p $'. Press any key to exit' dummy
        printf '\e[?25h' # Show cursor
    fi

    if [[ $exit_after == true ]]; then
        exit 1
    fi
}

_installation_complete() {
    printf "%s[VIBRANIUM]%s Installation complete" "$GREEN" "$RESET"

    if [[ $NO_DUMMY == false ]]; then
        read -n1 -r -p $'. Press any key to exit ' dummy
        printf '\e[?25h' # Show cursor
    fi
}

_ask_yes_no() {
    local default="${1:-Y}"
    local message="$2"
    local input prompt hint

    default="${default^^}"

    # Set hint based on default
    case "$default" in
        Y) hint="(Y/n)" ;;
        N) hint="(y/N)" ;;
        *) hint="(Y/n)"; default="Y" ;;
    esac

    while true; do
        # Show cursor
        printf '\e[?25h'

        prompt=$'\e[0;33m[VIBRANIUM]\e[0m '"${message} ${hint}: "

        printf "%s" "$prompt"
        read -r input

        # Use default if empty
        [[ -z "$input" ]] && input="$default"

        case "$input" in
            [Yy][Ee][Ss]|[Yy])
                # Hide cursor before returning
                printf '\e[?25l'
                return 0
                ;;
            [Nn][Oo]|[Nn])
                # Hide cursor before returning
                printf '\e[?25l'
                return 1
                ;;
            *)
                # Clear line and retry
                printf "\r\e[K"
                ;;
        esac
    done
}

# Filters out already installed packages from PACKAGES and populates $FILTERED
_filter_packages() {
    for pkg in "${PACKAGES[@]}"; do
        # Check if package is not installed
        if ! pacman -Qq "$pkg" &> /dev/null; then
            FILTERED+=("$pkg")
        fi
    done

    # Handle cases where all or some are already installed
    if [[ "${#FILTERED[@]}" -eq 0 ]]; then
        echo -e "${GREEN}[VIBRANIUM]${RESET} Selected package(s) are already installed"
        _operation_canceled --positive
        exit 0
    elif [[ ! ${#PACKAGES[@]} -eq ${#FILTERED[@]} ]]; then
        local pkgs_num="${#PACKAGES[@]}"
        local filtered_num="${#FILTERED[@]}"
        local diff=$((pkgs_num - filtered_num))
        echo -e "${BLUE}[VIBRANIUM]${RESET} $diff package(s) are already installed"
    fi
}

# Displays an overview of packages about to be installed.
# Formats differently based on the number of packages for readability.
_show_overview() {
    local packages=("${FILTERED[@]}")

    if [[ "${#packages[@]}" -gt 0 ]]; then
        if [[ "${#packages[@]}" -le 3 ]]; then
            echo -e "${YELLOW}[VIBRANIUM]${RESET} You're about to install the following packages: ${YELLOW}${packages[@]}${RESET}"
        else
            echo -e "${BLUE}[VIBRANIUM]${RESET} You're about to install the following packages:"
            for pkg in "${packages[@]}"; do
                echo -e "\t   - ${YELLOW}${pkg}${RESET}"
            done
        fi
    fi
}

_install_packages() {
    if ! sudo -v; then
        _operation_canceled
        exit 1
    fi

    # Pipe 'yes' to confirm all prompts
    if yes | yay -S "${YAY_FLAGS[@]}" "${FILTERED[@]}"; then
        return 0
    else
        return 1
    fi
}

# Fetches lists of all available packages from Arch repos and AUR. Populates PACKAGES array
_get_packages() {
    local aur_temp=$(mktemp)
    local arch_temp=$(mktemp)
    local pkgs_list=()

    (pacman -Slq > "$arch_temp") &
    term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Fetching packages" ""

    (yay -Slqa > "$aur_temp") &> /dev/null &
    term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Fetching packages (AUR)" ""

    mapfile -t arch_packages < "$arch_temp"
    pkgs_list+=("${arch_packages[@]}")

    mapfile -t aur_packages < "$aur_temp"
    pkgs_list+=("${aur_packages[@]}")

    PACKAGES+=("${pkgs_list[@]}")
}

# Allows user to select packages using fzf with preview.
# Populates PACKAGES with selected items. Returns 1 if none selected.
_choose_packages() {
    local chosen=()

    # Use fzf for multi-select with preview
    mapfile -t chosen < <(printf "%s\n" "${PACKAGES[@]}" | sort | fzf "${FZF_ARGS[@]}")

    [[ "${#chosen[@]}" -eq 0 ]] && return 1
    PACKAGES=("${chosen[@]}")
}

SUDO_PROMPT="$(printf '%s[VIBRANIUM]%s Password for %s: ' "$RED" "$RESET" "$USER")"
export SUDO_PROMPT

NO_LOGO=false
NO_DUMMY=false
NO_VERIFY=false
PACKAGES=()
FILTERED=()

YAY_FLAGS=(
    "--answerclean" "Y"
    "--answerdiff" "N"
    "--answeredit" "N"
    "--removemake"
    "--cleanafter"
    "--noconfirm"
    "--sudoloop"
)

FZF_ARGS=(
    --multi
    --preview 'yay -Si {1} 2>/dev/null || yay -Si {1}'
    --preview-label='alt-p: toggle description, alt-j/k: scroll description, ctrl-j/k: next/prev item, tab: multi-select'
    --preview-label-pos='bottom'
    --preview-window 'right:75%:wrap'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'
    --color 'pointer:blue,marker:white'
)

trap 'printf "\n"; _operation_canceled --exit' SIGHUP SIGINT

while [[ $# -gt 0 ]]; do
    case "$1" in
        --help|-h)
            _usage
            exit 0
            ;;
        --no-logo)
            NO_LOGO=true
            shift
            ;;
        --no-dummy)
            NO_DUMMY=true
            shift
            ;;
        --no-verify)
            NO_VERIFY=true
            shift
            ;;
        --)
            shift
            break
            ;;
        --*)
            echo "Unknown option: $1" >&2
            exit 1
            ;;
        *)
            break
            ;;
    esac
done

if [[ $NO_LOGO == false ]]; then
    printf "\n%s%s%s\n\n" "$YELLOW" "$(< "$VIBRANIUM/logo.txt")" "$RESET"
fi

# Validate sudo access early
echo -e "${YELLOW}[VIBRANIUM]${RESET} Pacman needs sudo acces in order to update repos info"
sudo -v

# Hide cursor
printf '\e[?25l'

if [[ $# -gt 0 ]]; then
    PACKAGES=("$@")

    if [[ $NO_VERIFY == false ]]; then
        if ! _ensure_if_exist; then
            _operation_canceled
            exit 1
        fi
    fi

    _refresh_repos
    _filter_packages
else
    if ! command -v fzf > /dev/null; then
        if term::is_headless; then
            notify-send -r 4 "Vibranium" "<b><i>fzf</i></b> not found!"
        fi

        log::error "fzf not found!"
        exit 1
    fi

    _refresh_repos
    _get_packages

    if _choose_packages; then
        _filter_packages
    else
        _operation_canceled
        exit 0
    fi
fi

_show_overview

# Proceed with installation after confirmation
if _ask_yes_no Y "Proceed with installation?"; then
    if _install_packages; then
        _handle_systemd
        _enable_systemd_units
        _installation_complete
    else
        echo -e "${RED}[VIBRANIUM]${RESET} Something went wrong"
        _operation_canceled
        exit 1
    fi
else
    _operation_canceled
fi
