#!/bin/bash

source vb-lib-core
VERBOSE=false

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} [OPTION]... [PACKAGE]...

Install packages (official repos by default, AUR with --aur)

Options:
  --no-ask          Do not ask for confirmation
  --no-logo         Do not display the Vibranium logo
  --no-dummy        Do not wait for a key press after completion or cancellation
  --no-verify       Skip verification of package existence in repositories
  --no-systemd      Skip systemd post-install hook
  --conservative    Do not print any success / fail messages

  --force-install   Forefully install already installed packages
  --skip-overview   Skip the pre-installation overview
  --keep-cache      Do not remove cached packages after install
  --embedded        Run in embedded mode. Usually called from inside another script
  --aur             Install from AUR instead of official repositories
  -v, --verbose     Enable verbose output
  -h, --help        Show this help and exit
  --                End of options. Everything after is PACKAGE

If no PACKAGE is provided, refresh repositories and use fzf for interactive package selection.
Packages are filtered to install only those not already present.
Systemd units (services/sockets) from installed packages are detected and enabled with user prompts.
EOF
}

log() {
  local level="$1"; shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

_ask_for_sudo() {
  log Info "_ask_for_sudo: checking sudo"
  sudo -n true 2>/dev/null && return

  term::enable_input
  sudo -v
  term::disable_input
}

_spinner() {
  local spinner_frames=(
    '[=     ]'
    '[==    ]'
    '[ ==   ]'
    '[  ==  ]'
    '[   == ]'
    '[    ==]'
    '[     =]'
  )

  local i
  i=$(cat "$5")

  while true; do
    if [[ "$3" == "1" ]]; then
      printf "\r\033[K%s[VIBRANIUM]%s %s Installing %s%s" \
        "$YELLOW" "$RESET" \
        "${GRAY}${spinner_frames[$i]}${RESET}" \
        "${YELLOW}${1}${RESET}" "${4}"
    else
      printf "\r\033[K%s[VIBRANIUM]%s %s Installing %s%s [%d/%d]" \
        "$YELLOW" "$RESET" \
        "${GRAY}${spinner_frames[$i]}${RESET}" \
        "${YELLOW}${1}${RESET}" "${4}" "$2" "$3"
    fi
    echo "$i" >"$5"

    i=$(((i + 1) % ${#spinner_frames[@]}))
    sleep 0.15
  done
}

# Detects systemd units (services and sockets) provided by a list of packages.
# Delegates all categorization and ordering to the external awk script:
#   "${VIBRANIUM}/systemd-units.awk"
# Populates global arrays (indexes are aligned across all four):
#   - provides_systemd_service: Package that owns the unit.
#   - unit_types:  "service" or "socket".
#   - unit_scope:  "user" or "system".
#   - unit_names:  Basename of the unit file.
_handle_systemd() {
  log Info "Checking systemd units for ${#FILTERED[@]} packages"
  local pkg unit_type scope unit_path

  provides_systemd_service=()
  unit_types=()
  unit_scope=()
  unit_names=()

  for pkg in "${FILTERED[@]}"; do
    # Process substitution: awk reads pacman output, emits prioritized "type scope path" lines.
    # The while loop simply won't execute if awk produces no output (pkg has no units).
    while read -r unit_type scope unit_path; do
      provides_systemd_service+=("$pkg")
      unit_types+=("$unit_type")
      unit_scope+=("$scope")
      unit_names+=("${unit_path##*/}")
    done < <(pacman -Ql "$pkg" 2>/dev/null | awk -f "$VIBRANIUM/awk/vb-pkg-parse-systemd.awk")
  done
}

# Enables detected systemd units (services or sockets) for each package individually.
# For each package, asks in priority order (user socket > user service > sys socket > sys service).
# If the user agrees to enable a unit, it enables it and skips lower-priority units for that package.
_enable_systemd_units() {
  if ((${#provides_systemd_service[@]} == 0)); then
    log Info "No systemd units to enable"
    return
  fi

  log Info "Processing ${#provides_systemd_service[@]} unit(s) for enablement"
  local -a unique_pkgs
  mapfile -t unique_pkgs < <(printf '%s\n' "${provides_systemd_service[@]}" | sort -u)

  local pkg unit_type scope unit_name
  local -a pids=()

  for pkg in "${unique_pkgs[@]}"; do
    for i in "${!provides_systemd_service[@]}"; do
      if [[ "${provides_systemd_service[$i]}" != "$pkg" ]]; then
        continue
      fi

      unit_type="${unit_types[$i]}"
      scope="${unit_scope[$i]}"
      unit_name="${unit_names[$i]}"

      if term::ask_yes_no Y "Enable $unit_type '${BLUE}${unit_name}${RESET}' from package '${YELLOW}${pkg}${RESET}' ($scope scope)?"; then
        if [[ "$scope" == "user" ]]; then
          systemctl -q --user --now enable "$unit_name" &
        else
          sudo systemctl -q --now enable "$unit_name" &
        fi
        pids+=($!)
        break # Skip lower-priority units for this package
      fi
    done
  done

  if ((${#pids[@]} > 0)); then
    echo -e "${BLUE}[VIBRANIUM]${RESET} Waiting for systemd units to be enabled..."
    wait "${pids[@]}"
  fi
}

_refresh_repos() {
  log Info "Refreshing repositories (aur=$AUR_MODE)"
  local cmd
  if [[ "$AUR_MODE" == true ]]; then
    cmd="yay -Sy"
  else
    cmd="sudo pacman -Sy"
  fi
  $cmd &>/dev/null &
  local pid="$!"
  term::spinner "$pid" "${YELLOW}[VIBRANIUM]${RESET} Refreshing repositories" "- ${GREEN}Done!${RESET}"
}

# Verifies if the given packages exist in the repositories.
# Collects missing packages and reports them. Returns 1 if any are missing.
_ensure_if_exist() {
  log Info "Verifying ${#PACKAGES[@]} package(s) exist"
  local total="${#PACKAGES[@]}"
  local -a missing=()
  local index=1

  for pkg in "${PACKAGES[@]}"; do
    printf "\r\033[K%s[VIBRANIUM]%s Verifying packages [%s/%s]" "$BLUE" "$RESET" "$index" "$total"

    if [[ "$AUR_MODE" == true ]]; then
      if ! yay -Si "$pkg" &>/dev/null; then
        missing+=("$pkg")
      fi
    else
      if ! pacman -Si "$pkg" &>/dev/null; then
        missing+=("$pkg")
      fi
    fi

    ((index++))
  done

  printf "\n"

  if ((${#missing[@]} > 0)); then
    echo -e "${RED}[VIBRANIUM]${RESET} Could not find the following packages:"
    for pkg in "${missing[@]}"; do
      echo -e "\t   - ${RED}${pkg}${RESET}"
    done
    return 1
  fi
}

# Prints a cancellation (or positive-outcome) message, optionally waits for a keypress,
# and optionally exits. Always re-enables terminal input before returning or exiting.
#
# Flags (at most one):
#   --positive  Use green color instead of red (e.g. "already installed" is not an error).
#   --exit      Exit with status 1 after the message.
_operation_canceled() {
  # Launched with --conservative.
  # Don't show anything.
  if [[ "$CONSERVATIVE" == true ]]; then
    return
  fi

  term::disable_input

  local color="$RED"
  local exit_after=false

  case "$1" in
  --positive)
    color="$GREEN"
    ;;
  --exit)
    exit_after=true
    ;;
  esac

  printf "%s[VIBRANIUM]%s Operation canceled" "$color" "$RESET"

  if [[ $NO_DUMMY == false && -t 0 ]]; then
    trap 'exit 1' SIGHUP SIGINT SIGTERM SIGQUIT
    read -n1 -r -s -p $'. Press any key to exit' dummy
  fi

  if [[ $exit_after == true ]]; then
    exit 1
  fi
}

_installation_complete() {
  # Launched with --conservative.
  # Don't show anything.
  if [[ "$CONSERVATIVE" == true ]]; then
    return
  fi

  trap '' SIGHUP SIGINT SIGTERM SIGQUIT
  term::disable_input

  printf "%s[VIBRANIUM]%s Installation complete" "$GREEN" "$RESET"

  if [[ $NO_DUMMY == false && -t 0 ]]; then
    # shellcheck disable=SC2034
    read -n1 -r -s -p $'. Press any key to exit' dummy
  fi
}

# Filters out already-installed packages from PACKAGES and populates FILTERED.
_filter_packages() {
  log Info "Filtering ${#PACKAGES[@]} package(s), force=$FORCE_INSTALL"
  if [[ "$FORCE_INSTALL" == true ]]; then
    FILTERED=("${PACKAGES[@]}")
    return
  fi

  for pkg in "${PACKAGES[@]}"; do
    if ! pacman -Qq "$pkg" &>/dev/null; then
      FILTERED+=("$pkg")
    fi
  done

  if ((${#FILTERED[@]} == 0)); then
    if ((${#PACKAGES[@]} == 1)); then
      # Since ${PACKAGES[@]} is a single package, we can refer it as a regular variable.
      echo -e "${GREEN}[VIBRANIUM]${RESET} ${YELLOW}$PACKAGES${RESET} is already installed"

      if [[ "$NO_ASK" == false ]]; then
        # Only single package branch
        if term::ask_yes_no Y "Install it anyway?"; then
          NO_ASK=true
          SKIP_OVERVIEW=true
          FORCE_INSTALL=true
          FILTERED=("${PACKAGES[@]}")
          return
        fi
      fi
    else
      echo -e "${GREEN}[VIBRANIUM]${RESET} Selected packages are already installed"
    fi

    if [[ $EMBEDDED == false ]]; then
      _operation_canceled --positive
    fi
    exit 0
  elif ((${#PACKAGES[@]} != ${#FILTERED[@]})); then
    local diff=$((${#PACKAGES[@]} - ${#FILTERED[@]}))
    if ((diff == 1)); then
      echo -e "${BLUE}[VIBRANIUM]${RESET} $diff package is already installed"
    else
      echo -e "${BLUE}[VIBRANIUM]${RESET} $diff packages are already installed"
    fi
  fi
}

# Displays an overview of packages about to be installed.
# Formats differently based on the number of packages for readability.
# For long lists, calculates whether the output exceeds the terminal height
# (accounting for the header and the overview title line) and shows a
# terminal-specific scrolling hint if it does.
_show_overview() {
  if [[ "$SKIP_OVERVIEW" == true ]]; then
    return
  fi

  local packages=("${FILTERED[@]}")

  if ((${#packages[@]} == 0)); then
    return
  fi

  if ((${#packages[@]} <= 5)); then
    echo -e "${YELLOW}[VIBRANIUM]${RESET} You're about to install the following packages: ${YELLOW}${packages[*]}${RESET}"
    return
  fi

  echo -e "${BLUE}[VIBRANIUM]${RESET} You're about to install the following packages:"
  for pkg in "${packages[@]}"; do
    echo -e "\t   - ${YELLOW}${pkg}${RESET}"
  done
}

_install_packages() {
  log Info "Installing ${#FILTERED[@]} package(s) (aur=$AUR_MODE, force=$FORCE_INSTALL)"
  if [[ "$AUR_MODE" == true ]]; then
    if [[ "$FORCE_INSTALL" == true ]]; then
      yes | yay -S "${YAY_FLAGS[@]}" "${FILTERED[@]}"
    else
      yes | yay --needed -S "${YAY_FLAGS[@]}" "${FILTERED[@]}"
    fi
  else
    if [[ "$FORCE_INSTALL" == true ]]; then
      sudo pacman -S --noconfirm "${FILTERED[@]}"
    else
      sudo pacman -S --noconfirm --needed "${FILTERED[@]}"
    fi
  fi
}

_embed_install() {
  log Info "Embedded install of ${#FILTERED[@]} package(s)"
  local total=${#FILTERED[@]}
  local current=0
  local pkg
  local spinner_pid
  local frame_file
  frame_file=$(mktemp)
  echo 0 >"$frame_file"

  if [[ "$AUR_MODE" == true ]]; then
    local yay_opts="--needed"
    if [[ "$FORCE_INSTALL" == true ]]; then
      yay_opts=""
    fi

    for pkg in "${FILTERED[@]}"; do
      ((current++))

      _spinner "$pkg" "$current" "$total" "" "$frame_file" &
      spinner_pid=$!

      yay --noconfirm $yay_opts -Sy "$pkg" &>/dev/null

      kill "$spinner_pid" 2>/dev/null
      wait "$spinner_pid" 2>/dev/null
    done
  else
    local pacman_opts="--needed"
    if [[ "$FORCE_INSTALL" == true ]]; then
      pacman_opts=""
    fi

    for pkg in "${FILTERED[@]}"; do
      ((current++))

      _spinner "$pkg" "$current" "$total" "" "$frame_file" &
      spinner_pid=$!

      sudo pacman --noconfirm $pacman_opts -S "$pkg" &>/dev/null

      kill "$spinner_pid" 2>/dev/null
      wait "$spinner_pid" 2>/dev/null
    done
  fi

  rm -f "$frame_file"

  if ((total == 1)); then
    printf "\r\033[K%s[VIBRANIUM]%s %s installed\n" \
      "$GREEN" "$RESET" "${YELLOW}${FILTERED[0]}${RESET}"
  else
    printf "\r\033[K%s[VIBRANIUM]%s Installed %d packages\n" \
      "$GREEN" "$RESET" "$total"
  fi
}

# Fetches list of available packages. Arch repos or AUR depending on --aur flag. Populates PACKAGES.
_get_packages() {
  log Info "Fetching package list (aur=$AUR_MODE)"
  if [[ "$AUR_MODE" == true ]]; then
    local aur_temp
    aur_temp=$(mktemp)

    (yay -Slqa >"$aur_temp" 2>/dev/null) &
    term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Fetching ${BLUE}AUR${RESET} packages" \
      "- ${GREEN}Done!${RESET}"

    mapfile -t PACKAGES <"$aur_temp"
    rm -f "$aur_temp"
  else
    local arch_temp
    arch_temp=$(mktemp)

    (pacman -Slq >"$arch_temp") &
    term::spinner $! "${YELLOW}[VIBRANIUM]${RESET} Fetching ${BLUE}official${RESET} packages" \
      "- ${GREEN}Done!${RESET}"

    mapfile -t PACKAGES <"$arch_temp"
    rm -f "$arch_temp"
  fi
}

# Allows the user to select packages using fzf with preview.
# Populates PACKAGES with selected items. Returns 1 if none selected.
_choose_packages() {
  log Info "Opening fzf for package selection"
  local -a chosen

  term::enable_input
  mapfile -t chosen < <(printf "%s\n" "${PACKAGES[@]}" | sort | fzf "${FZF_ARGS[@]}")
  term::disable_input

  ((${#chosen[@]} == 0)) && return 1
  PACKAGES=("${chosen[@]}")
}

_cleanup() {
  log Info "Running cleanup (aur=$AUR_MODE, keep_cache=$KEEP_CACHE)"

  local state_file="$VIBRANIUM_STATE/${0##*/}"
  local remove_cache=false

  if [[ -f "$state_file" ]]; then
    source "$state_file"
  fi

  if [[ "$AUR_MODE" == true ]]; then
    echo -e "${BLUE}[VIBRANIUM]${RESET} Removing orphan packages"
    yay -Ycc --noconfirm &>/dev/null

    if [[ "$KEEP_CACHE" == false ]]; then
      local do_clean=false

      if [[ "$remove_cache" == true ]]; then
        do_clean=true
      elif term::ask_yes_no Y "Remove package cache?"; then
        do_clean=true
        if term::ask_yes_no Y "Remember this option?"; then
          if ! [[ -d "$VIBRANIUM_STATE" ]]; then
            mkdir -p "$VIBRANIUM_STATE"
          fi
          echo 'remove_cache=true' >"$state_file"
        fi
      fi

      if [[ "$do_clean" == true ]]; then
        yay -Scc --noconfirm &>/dev/null &
        term::spinner $! "${BLUE}[VIBRANIUM]${RESET} Removing package cache" "" ""
      fi
    fi
  else
    local orphans
    orphans=$(pacman -Qdtq 2>/dev/null)
    if [[ -n "$orphans" ]]; then
      echo -e "${BLUE}[VIBRANIUM]${RESET} Removing orphan packages"
      sudo pacman -Rns --noconfirm $orphans &>/dev/null
    fi

    if [[ "$KEEP_CACHE" == false ]]; then
      local do_clean=false

      if [[ "$remove_cache" == true ]]; then
        do_clean=true
      elif term::ask_yes_no Y "Remove package cache?"; then
        do_clean=true
        if term::ask_yes_no Y "Remember this option?"; then
          mkdir -p "$VIBRANIUM_STATE"
          echo 'remove_cache=true' >"$state_file"
        fi
      fi

      if [[ "$do_clean" == true ]]; then
        sudo pacman -Scc --noconfirm &>/dev/null &
        term::spinner $! "${BLUE}[VIBRANIUM]${RESET} Removing package cache" "" ""
      fi
    fi
  fi
}

_embedded_early=false
for _arg in "$@"; do
  if [[ "$_arg" == "--embedded" ]]; then
    _embedded_early=true
    break
  fi
done

if [[ $_embedded_early == false ]] && term::is_headless; then
  xdg-terminal-exec --app-id=org.vb.term.float --title="${0##*/}" -- "$0" "$@"
  exit
fi

export SUDO_PROMPT="$VIBRANIUM_SUDO_PROMPT"

NO_ASK=false
NO_LOGO=false
NO_DUMMY=false
NO_VERIFY=false
NO_SYSTEMD=false
KEEP_CACHE=false
CONSERVATIVE=false
FORCE_INSTALL=false
SKIP_OVERVIEW=false
EMBEDDED=false
AUR_MODE=false
PACKAGES=()
FILTERED=()

trap 'trap "exit 1" SIGHUP SIGINT SIGTERM SIGQUIT; printf "\n"; _operation_canceled --exit' SIGHUP SIGINT SIGTERM SIGQUIT

while [[ $# -gt 0 ]]; do
  case "$1" in
  --help | -h)
    usage
    exit 0
    ;;
  -v | --verbose)
    VERBOSE=true
    shift
    ;;
  --embedded)
    EMBEDDED=true
    shift
    ;;
  --no-ask)
    NO_ASK=true
    shift
    ;;
  --no-logo)
    NO_LOGO=true
    shift
    ;;
  --no-dummy)
    NO_DUMMY=true
    shift
    ;;
  --no-verify)
    NO_VERIFY=true
    shift
    ;;
  --no-systemd)
    NO_SYSTEMD=true
    shift
    ;;
  --keep-cache)
    KEEP_CACHE=true
    shift
    ;;
  --conservative)
    CONSERVATIVE=true
    shift
    ;;
  --force-install)
    FORCE_INSTALL=true
    shift
    ;;
  --skip-overview)
    SKIP_OVERVIEW=true
    shift
    ;;
  --aur)
    AUR_MODE=true
    shift
    ;;
  --)
    shift
    if [[ $# -eq 0 ]]; then
      usage
      exit 1
    fi
    break
    ;;
  --* | -*)
    log Error "Unknown option: $1"
    exit 1
    ;;
  *)
    log Error "Unexpected argument: $1. Use '--' to separate options from packages"
    exit 1
    ;;
  esac
done

if [[ "$AUR_MODE" == true ]]; then
  YAY_FLAGS=(
    "--answerclean" "Y"
    "--answerdiff" "N"
    "--answeredit" "N"
    "--removemake"
    "--cleanafter"
    "--noconfirm"
    "--sudoloop"
  )

  FZF_ARGS=(
    --multi
    --ignore-case
    --highlight-line

    --info 'hidden'
    --border 'bold'

    --border-label ' alt-p: toggle description, alt-j/k: scroll description, alt-b/B: toggle PKGBUILD, ctrl-j/k: next/prev item, tab: multi-select '
    --border-label-pos 'bottom'

    --list-label 'AUR package list'
    --list-border 'bold'

    --input-label 'Filter packages'
    --input-border 'bold'

    --preview 'yay -Sii {1}'
    --preview-border 'bold'
    --preview-window 'right:75%:wrap'
    --preview-label 'Package Information'

    --bind 'alt-b:change-preview:yay -Gpa {1} | tail -n +5'
    --bind 'alt-B:change-preview:yay -Siia {1}'
    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'

    --color 'pointer:white,marker:green'
  )
else
  FZF_ARGS=(
    --multi
    --ignore-case
    --highlight-line

    --info 'hidden'
    --border 'bold'

    --border-label ' alt-p: toggle description, alt-j/k: scroll description, ctrl-j/k: next/prev item, tab: multi-select '
    --border-label-pos 'bottom'

    --list-label 'Package list'
    --list-border 'bold'

    --input-label 'Filter packages'
    --input-border 'bold'

    --preview 'pacman -Si {1}'
    --preview-border 'bold'
    --preview-window 'right:75%:wrap'
    --preview-label 'Package Information'

    --bind 'alt-p:toggle-preview'
    --bind 'alt-d:preview-half-page-down,alt-u:preview-half-page-up'
    --bind 'alt-k:preview-up,alt-j:preview-down'

    --color 'pointer:white,marker:green'
  )
fi

if [[ $EMBEDDED == true ]]; then
  trap 'exit 1' SIGHUP SIGINT SIGTERM SIGQUIT

  if [[ $# -eq 0 ]]; then
    exit 1
  fi

  PACKAGES=("$@")
  term::disable_input

  _filter_packages
  _ask_for_sudo || exit 1
  _embed_install
  exit 0
fi

if [[ $NO_LOGO == false ]]; then
  term::show_header
fi

term::disable_input

if [[ $# -gt 0 ]]; then
  PACKAGES=("$@")

  if [[ $NO_VERIFY == false ]]; then
    if ! _ensure_if_exist; then
      _operation_canceled
      exit 1
    fi
  fi

  _filter_packages
  _show_overview
else
  if ! command -v fzf >/dev/null; then
    log::error "fzf not found!"
    exit 1
  fi

  _get_packages

  if _choose_packages; then
    _filter_packages
  else
    _operation_canceled
    exit 0
  fi

  _show_overview
fi

if [[ "$NO_ASK" == false ]]; then
  if ! term::ask_yes_no Y "Proceed with installation?"; then
    _operation_canceled
    exit 1
  fi
fi

if ! _ask_for_sudo; then
  _operation_canceled
  exit 1
fi

_refresh_repos

if _install_packages; then
  trap '' SIGHUP SIGINT SIGTERM SIGQUIT

  if [[ "$NO_SYSTEMD" == false ]]; then
    _handle_systemd
    _enable_systemd_units
  fi

  _cleanup
  _installation_complete
else
  _operation_canceled
  exit 1
fi
