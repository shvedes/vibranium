#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

source vb-lib-core

DESKTOP_DIR="$XDG_DATA_HOME/applications"
ICON_DIR="$DESKTOP_DIR/icons"

if [[ -f "$VIBRANIUM_STATE/theme/fzf" ]]; then
  source "$VIBRANIUM_STATE/theme/fzf"
fi

FZF_ARGS=(
  --multi
  --ignore-case
  --highlight-line

  --delimiter $'\t'
  --with-nth 1

  --info 'hidden'
  --border 'bold'

  --border-label ' alt-p: toggle preview, ctrl-j/k: next/prev item, tab: multi-select'
  --border-label-pos 'bottom'

  --list-label 'TUI App List'
  --list-border 'bold'

  --input-label 'Filter TUI Apps'
  --input-border 'bold'

  --preview 'cat {2}'
  --preview-border 'bold'
  --preview-window 'right:50%:wrap'
  --preview-label 'Desktop File'

  --bind 'alt-p:toggle-preview'

  --color "${FZF_COLORS:-pointer:white,marker:green}"
)

tui_remove_prepare_result() {
  if [[ -z "${term_original_settings+x}" ]]; then
    term::disable_input
  fi
}

tui_remove_canceled() {
  tui_remove_prepare_result
  operation::result canceled
}

tui_remove_error() {
  tui_remove_prepare_result
  operation::result error
}

tui_remove_complete() {
  tui_remove_prepare_result
  operation::result success -- "Removal complete"
}

usage() {
  shcat << 'EOF'
Usage: vb-tuiapp-remove [OPTION]...

Remove TUI application shortcuts as .desktop launcher entries.
If no options are provided, the script runs in interactive mode.

Options:
  --file FILE...      .desktop file(s) to remove (basename or full path)
  -h, --help          Show this help and exit
EOF
}

_desktop_name() {
  local -n _dn_out=$1
  local _dn_file="$2" _dn_line _dn_val=""
  while IFS= read -r _dn_line || [[ -n $_dn_line ]]; do
    if [[ $_dn_line == Name=* ]]; then _dn_val=$_dn_line; break; fi
  done < "$_dn_file"
  _dn_val=${_dn_val#Name=}
  _dn_out=${_dn_val#TUI - }
}

_remove_tuiapp() {
  local name="$1" desktop_path="$2" removed=false

  [[ -f "$desktop_path" ]] && {
    rm -f -- "$desktop_path"
    removed=true
  }

  # Icon cleanup reconstructs a path from the desktop display name rather than
  # reading Icon=. Same-name entries can share the file and remove each other's
  # icon; arbitrary Icon= references remain untouched.
  for ext in png jpg jpeg ico svg; do
    [[ -f "$ICON_DIR/TUI - $name.$ext" ]] && {
      rm -f -- "$ICON_DIR/TUI - $name.$ext"
      removed=true
    }
  done

  if [[ "$removed" == true ]]; then
    vb::print "$G" "Removed ${B}${name}${RS}"
  else
    log Error "No such TUI app: $name"
  fi
}

DESKTOP_FILES=()
INTERACTIVE=true

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;

    --file)
      INTERACTIVE=false
      shift
      if [[ $# -eq 0 ]]; then
        log Error "--file requires at least one .desktop file argument"
        log Error "Try --help for more information"
        exit 1
      fi
      while [[ $# -gt 0 && "$1" != -* ]]; do
        if [[ "$1" != *.desktop ]]; then
          log Error "Not a .desktop file: $1"
          log Error "Try --help for more information"
          exit 1
        fi
        DESKTOP_FILES+=("$1")
        shift
      done
      ;;

    *)
      log Error "Unknown option: $1"
      log Error "Try --help for more information"
      exit 1
      ;;
  esac
done

# Resolve interactive or CLI targets into parallel name and path arrays.

TARGET_NAMES=()
TARGET_PATHS=()

if [[ $INTERACTIVE == true ]]; then
  # Build a name-to-path map from all TUI - *.desktop files, including
  # entries created with --custom-exec.
  # One map entry is exposed per display name; duplicate Name= values resolve
  # to whichever matching file is enumerated last.
  declare -A TUI_MAP
  _tui_dn=""
  while IFS= read -r -d '' file; do
    _desktop_name _tui_dn "$file"
    TUI_MAP["$_tui_dn"]="$file"
  done < <(find "$DESKTOP_DIR" -name 'TUI - *.desktop' -print0)

  if ((${#TUI_MAP[@]} == 0)); then
    term::show_header --color red
    vb::print "$R" "No TUI apps found"
    tui_remove_error
    exit 1
  fi

  # The hidden tab-delimited field carries paths through fzf, so spaces remain
  # inside each field. Literal tabs in either the display name or path break the
  # two-field encoding and subsequent extraction.
  _tui_rows=()
  for name in "${!TUI_MAP[@]}"; do
    _tui_rows+=("$name"$'\t'"${TUI_MAP[$name]}")
  done
  for ((_tui_i = 1; _tui_i < ${#_tui_rows[@]}; _tui_i++)); do
    _tui_key=${_tui_rows[_tui_i]}
    _tui_j=$((_tui_i - 1))
    while ((_tui_j >= 0)) && [[ ${_tui_rows[_tui_j]} > $_tui_key ]]; do
      _tui_rows[_tui_j + 1]=${_tui_rows[_tui_j]}
      _tui_j=$((_tui_j - 1))
    done
    _tui_rows[_tui_j + 1]=$_tui_key
  done
  mapfile -t SELECTED < <(printf '%s\n' "${_tui_rows[@]}" | fzf "${FZF_ARGS[@]}")

  term::show_header

  if ((${#SELECTED[@]} == 0)); then
    tui_remove_canceled
    exit 1
  fi

  ((${#SELECTED[@]} == 1)) && suffix="" || suffix="s"

  if ! term::ask_yes_no Y "You're about to remove ${#SELECTED[@]} TUI app${suffix}. Continue?"; then
    tui_remove_canceled
    exit 1
  fi

  for entry in "${SELECTED[@]}"; do
    TARGET_NAMES+=("${entry%%$'\t'*}")
    TARGET_PATHS+=("${entry##*$'\t'}")
  done

else
  # Non-interactive mode: accept paths or basenames on the CLI.
  # Basenames are resolved against the standard desktop directory.
  # Missing or foreign-name targets are skipped individually, and no
  # aggregate error is retained for the final exit status.
  for file_arg in "${DESKTOP_FILES[@]}"; do
    # A value containing a slash is accepted verbatim; filename shape is the
    # ownership check, not confinement to DESKTOP_DIR.
    [[ "$file_arg" == */* ]] && desktop_path="$file_arg" || desktop_path="$DESKTOP_DIR/$file_arg"

    if [[ ! -f "$desktop_path" ]]; then
      log Error "No such file: $file_arg"
      continue
    fi

    filename="${desktop_path##*/}"
    if [[ "$filename" != TUI\ -\ *.desktop ]]; then
      log Warn "not a TUI app file: $filename"
      continue
    fi

    _tui_dn=""
    _desktop_name _tui_dn "$desktop_path"
    TARGET_NAMES+=("$_tui_dn")
    TARGET_PATHS+=("$desktop_path")
  done
fi

# Removal is sequential and non-transactional across a multi-selection; an
# interruption can leave only the prefix that completed.
for i in "${!TARGET_NAMES[@]}"; do
  _remove_tuiapp "${TARGET_NAMES[$i]}" "${TARGET_PATHS[$i]}"
done

if [[ $INTERACTIVE == true ]]; then
  tui_remove_complete
  exit 0
fi
