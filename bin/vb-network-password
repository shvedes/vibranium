#!/bin/bash

source vb-lib-cli
source vb-lib-network

VERBOSE=${VERBOSE:-false}
SELF="${0##*/}"

usage() {
  shcat << EOF
Usage: $SELF [OPTIONS] <interface>
       $SELF [OPTIONS] --ssid SSID

Print a Wi-Fi connection's password.

Options:
  --ssid SSID    Look up a saved network by SSID instead of an interface
  -v, --verbose  Enable verbose output
  -h, --help     Display this help and exit
EOF
}

set -euo pipefail

want_ssid=""

while (($# > 0)); do
  case "$1" in
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    --ssid)
      want_ssid="${2:?Option --ssid needs an SSID}"
      shift 2
      ;;
    --)
      shift
      break
      ;;
    -*)
      log Error "unknown option: $1"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
    *)
      break
      ;;
  esac
done

uuid=""

if [[ -n "$want_ssid" ]]; then
  uuid=
  if ! network::uuid_for_ssid uuid "$want_ssid"; then
    echo "No saved connection for '$want_ssid'" >&2
    exit 1
  fi
else
  interface="${1:?Usage: $SELF <interface>}"
  if ! network::active_uuid uuid "$interface"; then
    echo "No active Wi-Fi connection" >&2
    exit 1
  fi
fi

# Request all fields in one call so array positions remain stable even when an
# optional NetworkManager property is empty.
mapfile -t fields < <(nmcli --show-secrets --escape no --get-values \
  802-11-wireless-security.key-mgmt,802-11-wireless-security.psk,802-11-wireless-security.wep-key0 \
  connection show uuid "$uuid")

key_management=${fields[0]:-}
password=${fields[1]:-}
wep_key=${fields[2]:-}

# Enterprise key-management values contain eap or ieee8021x even when the
# profile also has other selectors, so substring matching is intentional.
if [[ "$key_management" == *eap* || "$key_management" == *ieee8021x* ]]; then
  echo "Enterprise Wi-Fi has no shareable password" >&2
  exit 1
fi

if [[ -z "$key_management" || "$key_management" == "none" ]]; then
  # NetworkManager models WEP as key-mgmt "none" plus a wep-key.
  password="$wep_key"
  if [[ -z "$password" ]]; then
    echo "This network has no password" >&2
    exit 1
  fi
fi

if [[ -z "$password" ]]; then
  echo "Could not read the Wi-Fi password" >&2
  exit 1
fi

# The secret is kept out of process arguments; the caller controls where
# stdout is redirected, so a private destination is not guaranteed.
printf '%s\n' "$password"
