#!/usr/bin/env bash

# Power profile switcher. The code is pretty simple and clean, so I don't think it needs any explanation.

source "$VIBRANIUM_PATH/vibranium-core-lib"

if ! missing_str="$(vibranium-utils-is-installed power-profiles-daemon:powerprofilesctl)"; then
    read -r -a missing <<< "$missing_str"
    notify-send -r 4 -t 5000 -u critical "$(basename "$0")" "Missing cli utilities: ${missing[*]}"
    exit 1
fi

QUIET=false

USER_ARGS=()
for a in "$@"; do
    case "${a,,}" in
        -q | --quiet) QUIET=true ;;
        *) USER_ARGS+=("$a")     ;;
    esac
done

profiles=("power-saver" "balanced" "performance")
current="$(vibranium-cmd-get-power)"

log "Current profile: ${YELLOW}$current${RESET}"

notify() {
    local feedback_enabled gl_use_osd pp_use_osd

    check_bool VIBRANIUM_GLOBAL_POWER_PROFILE_USE_FEEDBACK true

    feedback_enabled="$VIBRANIUM_GLOBAL_POWER_PROFILE_USE_FEEDBACK"

    if [[ $QUIET = true ]]; then
        return 0
    elif [[ $feedback_enabled  == false ]]; then
        return 0
    fi

    local profile="$1"
    local icon=""
    local label=""

    case "$profile" in
        "performance")
            icon="power-profile-performance-symbolic"
            label="Performance"
            ;;
        "balanced")
            icon="power-profile-balanced-symbolic"
            label="Balanced"
            ;;
        "power-saver")
            icon="power-profile-power-saver-symbolic"
            label="Powersave"
            ;;
    esac

    log "Setting power profile to ${YELLOW}${profile}${RESET}"

    check_bool VIBRANIUM_GLOBAL_POWER_PROFILE_USE_OSD true

    pp_use_osd="$VIBRANIUM_GLOBAL_POWER_PROFILE_USE_OSD"
    gl_use_osd="$VIBRANIUM_GLOBAL_USE_OSD"

    if [[ $gl_use_osd = true ]] && [[ $pp_use_osd = true ]]; then
        swayosd-client --custom-message "$label" --custom-icon "$icon"
    else
        notify-send -r 2 -t 1500 "Vibranium" \
            "Power profile set to <span foreground='${P_ACCENT}'><b>${label,,}</b></span>"
    fi
}

raw_input="${USER_ARGS[0]:-}"

if [[ ${#USER_ARGS[@]} -gt 0 ]]; then
    arg="${raw_input,,}"
else
    arg=""
fi

if [[ " ${profiles[*]} " == *" $arg "* ]]; then
    target_profile="$arg"
else
    current_index=0
    for i in "${!profiles[@]}"; do
        if [[ "${profiles[$i]}" == "$current" ]]; then
            current_index=$i
            break
        fi
    done

    case "$arg" in
        "up" | "+" | "")
            next_index=$(((current_index + 1) % ${#profiles[@]}))
            ;;
        # No UX planned for this
        "down" | "-")
            next_index=$(((current_index - 1 + ${#profiles[@]}) % ${#profiles[@]}))
            ;;
        *)
            error "Invalid input: '$raw_input'"
            exit 1
            ;;
    esac

    target_profile="${profiles[$next_index]}"
fi

powerprofilesctl set "$target_profile" &
echo "$target_profile" > "${VIBRANIUM_STATE}/power-profile"
notify "$target_profile"

check_bool VIBRANIUM_BAR_POWER_PROFILE_MODULE_ENABLE false
bar_module_enabled="$VIBRANIUM_BAR_POWER_PROFILE_MODULE_ENABLE"

if [[ $bar_module_enabled == true ]]; then
    log "Updating waybar module"
    vibranium-cmd-refresh-waybar-module power-profile &
fi

blur_enabled="$(hyprctl -j getoption decoration:blur:enabled | jq -r '.int')"

check_bool VIBRANIUM_GLOBAL_RESPECT_POWER_PROFILE true
respect_pp="$VIBRANIUM_GLOBAL_RESPECT_POWER_PROFILE"

if [[ "$target_profile" = "power-saver" ]]; then
    if [[ $respect_pp == true ]]; then
        if [[ "$blur_enabled" == 1 ]]; then
            log "Saving current blur state"
            touch "$VIBRANIUM_STATE/blur.restore"
            vibranium-cmd-toggle-blur --quiet
        fi
    fi
else
    if [[ $blur_enabled == 0 && -f $VIBRANIUM_STATE/blur.restore ]]; then
        log "Restoring previuous blur state"
        vibranium-cmd-toggle-blur --quiet
        rm "$VIBRANIUM_STATE/blur.restore"
    fi
fi
