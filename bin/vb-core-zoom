#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

SELF="${0##*/}"
STEP_DEFAULT="0.30"
ACTION=""
STEP="$STEP_DEFAULT"
ZOOM_VALUE=""

STATE_FILE="$VIBRANIUM_RUNTIME/$SELF"

usage() {
  shcat << EOF
Usage: $SELF [OPTION]

Zoom in and out your entire screen.

Options:
  -i, --increase         Increase zoom by step
  -d, --decrease         Decrease zoom by step (floor 1.00)
  -V, --zoom-value <n>   Set zoom value directly
  -r, --reset            Reset zoom to 1.00
  -s, --step <value>     Set step (default: ${STEP_DEFAULT})
  -v, --verbose          Enable verbose output
  -h, --help             Display this help and exit

Short forms: you may also pass a single argument "+" or "-" for increase/decrease.
EOF
}

# Convert a decimal string (e.g. "1.50", "0.20") to a fixed-point
# integer scaled by x100 for integer arithmetic in Bash.
# E.g. "1.50" -> 150, "0.20" -> 20.
_to_int100() {
  local -n _result="$1"
  local val="$2"
  local int_part frac_part

  # The fractional field is padded or truncated to two digits and parsed
  # with 10#; the integer part is not separately normalized, and malformed
  # input is left to the arithmetic that follows.
  int_part="${val%.*}"
  if [[ "$val" == *.* ]]; then
    frac_part="${val#*.}"
    frac_part="${frac_part}00"
    frac_part="${frac_part:0:2}"
  else
    frac_part="00"
  fi

  _result=$((int_part * 100 + 10#$frac_part))
}

# Reverse of _to_int100: convert a x100 integer back to a decimal string
# with two fractional digits (e.g. 150 -> "1.50").
# Division and remainder are signed integer operations; this formatter does
# not clamp values below 100, although the action paths normally produce 100
# or greater after their own checks.
_from_int100() {
  local -n _result="$1"
  local val100="$2"
  printf -v _result "%d.%02d" $((val100 / 100)) $((val100 % 100))
}

# Read one integer from the zoom state file, defaulting to 100 when the path
# is absent, the first line cannot be read, or its value is nonnumeric.
read_state100() {
  local -n ref=$1
  local v=100

  if [[ -r "$STATE_FILE" ]]; then
    IFS= read -r v < "$STATE_FILE" || v=100

    if [[ ! "$v" =~ ^[0-9]+$ ]]; then
      v=100
    fi
  fi

  # nameref target, used by caller
  # shellcheck disable=SC2034
  ref=$v
}

# Store a non-default zoom as an x100 integer. At 1.00, remove an existing
# state file; if no file exists, the normal write records the default.
write_state100() {
  local new100="$1"

  if ((new100 == 100)); then
    if [[ -f "$STATE_FILE" ]]; then
      rm -f "$STATE_FILE"
      return 0
    fi
  fi

  printf '%s\n' "$new100" > "$STATE_FILE"
}

# Apply zoom_factor through hl.config; cursor.no_warps is left at the user's
# global setting. The generated decimal contains only digits and one dot, so
# interpolation cannot inherit caller formatting from STEP.
apply_zoom100() {
  local new100="$1"
  local new_float

  _from_int100 new_float "$new100"

  hyprctl -q eval "hl.config({cursor = {zoom_factor = ${new_float}}})"
}

# The parser allows repeated action flags; the last action encountered wins.
while (($#)); do
  case "$1" in
    -i | --increase)
      ACTION="increase"
      shift
      ;;
    -d | --decrease)
      ACTION="decrease"
      shift
      ;;
    -V | --zoom-value)
      [[ -n "$2" ]] || {
        log Error "--zoom-value requires a value"
        exit 1
      }

      ACTION="set"
      ZOOM_VALUE="$2"
      shift 2
      ;;
    -r | --reset)
      ACTION="reset"
      shift
      ;;
    -s | --step)
      [[ -n "$2" ]] || {
        log Error "--step requires a value"
        exit 1
      }

      STEP="$2"
      shift 2
      ;;
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    "+")
      ACTION="increase"
      shift
      ;;
    "-")
      ACTION="decrease"
      shift
      ;;
    *)
      log Error "unknown option -- $1"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
  esac
done

if [[ -z "$ACTION" ]]; then
  usage
  exit 1
fi

log Info "Action: $ACTION, step: $STEP"

# Used via nameref
current_float=
current100=
step100=
zoom100=

# Step and zoom strings have no separate lexical validator; conversion and
# the arithmetic checks below determine whether they are usable.
_to_int100 step100 "$STEP"

if ((step100 <= 0)); then
  log Error "Invalid step value: $STEP (must be > 0)"
  exit 2
fi

if [[ "$ACTION" == "set" ]]; then
  _to_int100 zoom100 "$ZOOM_VALUE"

  if ((zoom100 < 100)); then
    log Error "Invalid zoom value: $ZOOM_VALUE (must be >= 1.00)"
    exit 2
  fi
fi

# State is loaded after argument validation, while the persisted value can
# still be arbitrary text; the reader supplies the safe arithmetic default.
read_state100 current100

case "$ACTION" in
  increase)
    new100=$((current100 + step100))
    ;;
  # Decrease is a saturating operation at 1.00; it does not encode a requested
  # lower zoom or leave a negative value in the state file.
  decrease)
    new100=$((current100 - step100))
    ((new100 < 100)) && new100=100
    ;;
  set)
    new100="$zoom100"
    ;;
  reset)
    new100=100
    ;;
  *)
    usage
    exit 1
    ;;
esac

_from_int100 current_float "$current100"
_from_int100 new_float "$new100"
log Info "Zoom: $current_float -> $new_float"

# Persistence is conditional on hyprctl success, so a failed compositor
# update cannot make the next invocation believe the new level is active.
if apply_zoom100 "$new100"; then
  write_state100 "$new100"
fi
