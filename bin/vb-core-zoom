#!/bin/bash

VERBOSE=false

log() {
  local level="$1"
  shift
  if [[ "$level" == "Error" ]] || { $VERBOSE && [[ -t 0 ]]; }; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

SELF="${0##*/}"
STEP_DEFAULT="0.20"
ACTION=""
STEP="$STEP_DEFAULT"
ZOOM_VALUE=""

STATE_FILE="$VIBRANIUM_RUNTIME/$SELF"

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat << EOF
Usage: $SELF [OPTION]

Zoom in and out your entire screen.

Options:
  -i, --increase         Increase zoom by step
  -d, --decrease         Decrease zoom by step (floor 1.00)
  -V, --zoom-value <n>   Set zoom value directly
  -r, --reset            Reset zoom to 1.00
  -s, --step <value>     Set step (default: ${STEP_DEFAULT})
  -v, --verbose          Enable verbose output
  -h, --help             Display this help and exit

Short forms: you may also pass a single argument "+" or "-" for increase/decrease.
EOF
}

# Convert a decimal string (e.g. "1.50", "0.20") to a fixed-point
# integer scaled by x100 for integer arithmetic in Bash.
# E.g. "1.50" -> 150, "0.20" -> 20.
_to_int100() {
  local -n _result="$1"
  local val="$2"
  local int_part frac_part

  int_part="${val%.*}"
  if [[ "$val" == *.* ]]; then
    frac_part="${val#*.}"
    frac_part="${frac_part}00"
    frac_part="${frac_part:0:2}"
  else
    frac_part="00"
  fi

  _result=$((int_part * 100 + 10#$frac_part))
}

# Reverse of _to_int100: convert a x100 integer back to a decimal string
# with two fractional digits (e.g. 150 -> "1.50").
_from_int100() {
  local -n _result="$1"
  local val100="$2"
  printf -v _result "%d.%02d" $((val100 / 100)) $((val100 % 100))
}

# Read the zoom state file (x100 integer, defaults to 100 = 1.00).
# The file may contain arbitrary content from an interrupted write; guard
# against non-numeric values by falling back to 100.
read_state100() {
  local -n ref=$1
  local v=100

  if [[ -r "$STATE_FILE" ]]; then
    IFS= read -r v < "$STATE_FILE" || v=100

    if [[ ! "$v" =~ ^[0-9]+$ ]]; then
      v=100
    fi
  fi

  # nameref target, used by caller
  # shellcheck disable=SC2034
  ref=$v
}

# Persist the zoom level as a x100 integer. When zoom is reset to 1.00
# (the default) remove the state file so read_state100 returns the
# default without any I/O.
write_state100() {
  local new100="$1"

  if ((new100 == 100)); then
    if [[ -f "$STATE_FILE" ]]; then
      rm -f "$STATE_FILE"
      return 0
    fi
  fi

  printf '%s\n' "$new100" > "$STATE_FILE"
}

# Apply the zoom factor to Hyprland using its Lua-style config eval API.
# Hyprland's cursor.zoom_factor controls the display magnification.
# cursor.no_warps is intentionally not set here: the old --batch path
# (commented out below) used both, but the current hl.config approach
# only sets zoom_factor; no_warps remains at the user's global default.
apply_zoom100() {
  local new100="$1"
  local new_float

  _from_int100 new_float "$new100"

  hyprctl -q eval "hl.config({cursor = {zoom_factor = ${new_float}}})"
}

while (($#)); do
  case "$1" in
    -i | --increase)
      ACTION="increase"
      shift
      ;;
    -d | --decrease)
      ACTION="decrease"
      shift
      ;;
    -V | --zoom-value)
      [[ -n "$2" ]] || {
        log Error "--zoom-value requires a value"
        exit 1
      }

      ACTION="set"
      ZOOM_VALUE="$2"
      shift 2
      ;;
    -r | --reset)
      ACTION="reset"
      shift
      ;;
    -s | --step)
      [[ -n "$2" ]] || {
        log Error "--step requires a value"
        exit 1
      }

      STEP="$2"
      shift 2
      ;;
    -v | --verbose)
      VERBOSE=true
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    "+")
      ACTION="increase"
      shift
      ;;
    "-")
      ACTION="decrease"
      shift
      ;;
    *)
      log Error "unknown option -- $1"
      log Error "Try '$SELF --help' for more information"
      exit 1
      ;;
  esac
done

if [[ -z "$ACTION" ]]; then
  usage
  exit 1
fi

log Info "Action: $ACTION, step: $STEP"

# Used via nameref
current_float=
current100=
step100=
zoom100=

_to_int100 step100 "$STEP"

if ((step100 <= 0)); then
  log Error "Invalid step value: $STEP (must be > 0)"
  exit 2
fi

if [[ "$ACTION" == "set" ]]; then
  _to_int100 zoom100 "$ZOOM_VALUE"

  if ((zoom100 < 100)); then
    log Error "Invalid zoom value: $ZOOM_VALUE (must be >= 1.00)"
    exit 2
  fi
fi

read_state100 current100

case "$ACTION" in
  increase)
    new100=$((current100 + step100))
    ;;
  decrease)
    new100=$((current100 - step100))
    ((new100 < 100)) && new100=100
    ;;
  set)
    new100="$zoom100"
    ;;
  reset)
    new100=100
    ;;
  *)
    usage
    exit 1
    ;;
esac

_from_int100 current_float "$current100"
_from_int100 new_float "$new100"
log Info "Zoom: $current_float -> $new_float"

if apply_zoom100 "$new100"; then
  write_state100 "$new100"
fi
