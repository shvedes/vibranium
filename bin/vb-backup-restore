#!/bin/bash

source vb-lib-cli

VERBOSE=${VERBOSE:-false}

usage() {
  shcat << EOF
Usage: ${0##*/} COMMAND [OPTION]...

Manage your backups Vibranium created during installation.

Commands:
  -l,--list          List available backups
  -r,--restore PATH  Restore backup from PATH

Options:
  -v, --verbose     Enable verbose output
  -h, --help        Display this help and exit

EOF
}

# Format helpers::backup_list output as aligned columns.
# Output is tab-separated: date, original, backup-path, kind.
_list_aligned() {
  # First pass: slurp lines and measure each column's max width.
  local dates=() origs=() bks=() kinds=()
  local max_date=0 max_orig=0 max_bk=0
  local date orig bk kind

  while IFS=$'\t' read -r date orig bk kind; do
    dates+=("$date")
    origs+=("$orig")
    bks+=("$bk")
    kinds+=("$kind")

    # Track widest value per column for printf padding.
    ((${#date} > max_date)) && max_date=${#date}
    ((${#orig} > max_orig)) && max_orig=${#orig}
    ((${#bk} > max_bk)) && max_bk=${#bk}
  done < <(helpers::backup_list)

  # Second pass: print each row with fixed-width columns.
  local i
  for ((i = 0; i < ${#dates[@]}; i++)); do
    printf "%-*s  %-*s  %-*s  %s\n" \
      "$max_date" "${dates[i]}" \
      "$max_orig" "${origs[i]}" \
      "$max_bk" "${bks[i]}" \
      "${kinds[i]}"
  done
}

source "$VIBRANIUM/install/helpers/05-backup.sh"

# helpers::backup_restore uses helpers::log::* from 00-logs.sh (installer
# format with [INFO]/[ERROR] headers).  When run interactively, override
# those functions to use the conventional [basename] format instead.
if [[ -t 0 ]]; then
  helpers::log::info() { echo "[${0##*/}] Info: $*"; }
  helpers::log::warn() { echo "[${0##*/}] Warn: $*"; }
  helpers::log::success() { echo "[${0##*/}] Success: $*"; }
  helpers::log::error() { echo "[${0##*/}] Error: $*" >&2; }
else
  source "$VIBRANIUM/install/helpers/00-logs.sh"
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --list | -l)
      if [[ -t 1 ]]; then
        _list_aligned
      else
        helpers::backup_list
      fi
      shift
      ;;
    --restore | -r)
      if [[ -z "${2:-}" ]]; then
        log Error "missing path to restore"
        log Error "Try '${0##*/} --help' for more information."
        exit 1
      fi
      log Info "Restoring backup from $2"
      helpers::backup_restore "$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    -v | --verbose)
      export VERBOSE=true
      shift
      ;;
    *)
      log Error "invalid command '$1'"
      log Error "Try '${0##*/} --help' for more information."
      exit 1
      ;;
  esac
done
