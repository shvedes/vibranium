#!/bin/bash

VERBOSE=false

log() {
  local level="$1"; shift
  if $VERBOSE && [[ -t 0 ]]; then
    echo "[${0##*/}] $level: $*" >&2
  fi
}

shcat() {
  while IFS= read -r line; do
    printf '%s\n' "$line"
  done
}

usage() {
  shcat <<EOF
Usage: ${0##*/} COMMAND [OPTION]...

Manage Vibranium backups.

Commands:
  list              List available backups
  restore PATH      Restore backup from PATH

Options:
  -h, --help        Display this help and exit

EOF
}

source "$VIBRANIUM/install/helpers/05-backup.sh"

while [[ $# -gt 0 ]]; do
  case "$1" in
  list)
    vb::backup_list
    shift
    ;;
  restore)
    if [[ -z "${2:-}" ]]; then
      echo "${0##*/}: missing path to restore" >&2
      echo "Try '${0##*/} --help' for more information." >&2
      exit 1
    fi
    vb::backup_restore "$2"
    shift 2
    ;;
  -h|--help)
    usage
    exit 0
    ;;
  -v|--verbose)
    VERBOSE=true
    shift
    ;;
  *)
    echo "${0##*/}: invalid command '$1'" >&2
    echo "Try '${0##*/} --help' for more information." >&2
    exit 1
    ;;
  esac
done
