{
	"pulseaudio#volume": {
		"on-click": "vb-core-volume vol mute",
		"on-scroll-up": "vb-core-volume vol up",
		"on-scroll-down": "vb-core-volume vol down",
		"on-click-right": "vb-core-term wiremix --tab output",
        "on-click-middle": "vb-cmd-output-switch",

		"format": "{icon}",
		"format-muted": "\udb81\udf5f",
		"format-icons": {
            "headset": "\udb80\udecb",
            "portable": "\udb82\udda2",
            "default": [
                "\udb81\udd7f",
                "\udb81\udd80",
                "\udb81\udd7e"
            ]
        },
		"tooltip-format": "Volume: {volume}%\nDevice: {desc}",
        "ignored-sinks": [ "Easy Effects Sink" ]
	}
}
