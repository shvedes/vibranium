{
	"bluetooth": {
		"format": "\udb80\udcaf",
        "format-off": "\udb80\udcb2",
        "format-disabled": "\udb80\udcb2",
		"format-connected": "\udb80\udcb1",
        "format-no-controller": "",
		"on-click": "vibranium-cmd-launch-terminal bluetui",

		"tooltip-format": "Status: {status}",
        "tooltip-format-disabled": "Bluetooth is disabled",
		"tooltip-format-connected": "{device_enumerate}",
		"tooltip-format-enumerate-connected": "{device_alias}",
		"tooltip-format-enumerate-connected-battery": "{device_alias} (battery: {device_battery_percentage}%)"
	}
}
