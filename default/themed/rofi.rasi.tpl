* {
  background-h:    {{ background_h }};
  background-0:    {{ background_0 }};
  background-1:    {{ background_1 }};
  background-2:    {{ background_2 }};
  background-3:    {{ background_3 }};
  background-4:    {{ background_4 }};
  background-5:    {{ background_5 }};

  foreground-h:    {{ foreground_h }};
  foreground-0:    {{ foreground_0 }};
  foreground-1:    {{ foreground_1 }};
  foreground-2:    {{ foreground_2 }};
  foreground-3:    {{ foreground_3 }};
  foreground-4:    {{ foreground_4 }};

  black-dim:       {{ black|dim=0.10 }};
  black:           {{ black }};
  black-bright:    {{ black|pop=0.10 }};

  red-dim:         {{ red|dim=0.10 }};
  red:             {{ red }};
  red-bright:      {{ red|pop=0.10 }};

  pink-dim:        {{ pink|dim=0.10 }};
  pink:            {{ pink }};
  pink-bright:     {{ pink|pop=0.10 }};

  green-dim:       {{ green|dim=0.10 }};
  green:           {{ green }};
  green-bright:    {{ green|pop=0.10 }};

  yellow-dim:      {{ yellow|dim=0.10 }};
  yellow:          {{ yellow }};
  yellow-bright:   {{ yellow|pop=0.10 }};

  orange-dim:      {{ orange|dim=0.10 }};
  orange:          {{ orange }};
  orange-bright:   {{ orange|pop=0.10 }};

  blue-dim:        {{ blue|dim=0.10 }};
  blue:            {{ blue }};
  blue-bright:     {{ blue|pop=0.10 }};

  purple-dim:      {{ purple|dim=0.10 }};
  purple:          {{ purple }};
  purple-bright:   {{ purple|pop=0.10 }};

  cyan-dim:        {{ cyan|dim=0.10 }};
  cyan:            {{ cyan }};
  cyan-bright:     {{ cyan|pop=0.10 }};

  white-dim:       {{ white|dim=0.10 }};
  white:           {{ white }};
  white-bright:    {{ white|pop=0.10 }};

  gray-dim:        {{ gray|dim=0.10 }};
  gray:            {{ gray }};
  gray-bright:     {{ gray|pop=0.10 }};

  accent-dim:      {{ accent|dim=0.10 }};
  accent:          {{ accent }};
  accent-bright:   {{ accent|pop=0.10 }};
}

/* vim: set ft=rasi: */
