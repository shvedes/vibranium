* {
  background-h:    {{ background_h }};
  background-0:    {{ background_0 }};
  background-1:    {{ background_1 }};
  background-2:    {{ background_2 }};
  background-3:    {{ background_3 }};
  background-4:    {{ background_4 }};
  background-5:    {{ background_5 }};

  foreground-h:    {{ foreground_h }};
  foreground-0:    {{ foreground_0 }};
  foreground-1:    {{ foreground_1 }};
  foreground-2:    {{ foreground_2 }};
  foreground-3:    {{ foreground_3 }};
  foreground-4:    {{ foreground_4 }};

  black-dim:       {{ black_dim }};
  black:           {{ black }};
  black-bright:    {{ black_bright }};

  red-dim:         {{ red_dim }};
  red:             {{ red }};
  red-bright:      {{ red_bright }};

  pink-dim:        {{ pink_dim }};
  pink:            {{ pink }};
  pink-bright:     {{ pink_bright }};

  green-dim:       {{ green_dim }};
  green:           {{ green }};
  green-bright:    {{ green_bright }};

  yellow-dim:      {{ yellow_dim }};
  yellow:          {{ yellow }};
  yellow-bright:   {{ yellow_bright }};

  orange-dim:      {{ orange_dim }};
  orange:          {{ orange }};
  orange-bright:   {{ orange_bright }};

  blue-dim:        {{ blue_dim }};
  blue:            {{ blue }};
  blue-bright:     {{ blue_bright }};

  purple-dim:      {{ purple_dim }};
  purple:          {{ purple }};
  purple-bright:   {{ purple_bright }};

  cyan-dim:        {{ cyan_dim }};
  cyan:            {{ cyan }};
  cyan-bright:     {{ cyan_bright }};

  white-dim:       {{ white_dim }};
  white:           {{ white }};
  white-bright:    {{ white_bright }};

  gray-dim:        {{ gray_dim }};
  gray:            {{ gray }};
  gray-bright:     {{ gray_bright }};

  accent-dim:      {{ accent_dim }};
  accent:          {{ accent }};
  accent-bright:   {{ accent_bright }};
}

/* vim: set ft=rasi: */
