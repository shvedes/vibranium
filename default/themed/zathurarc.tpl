set default-fg "{{ foreground }}"
set default-bg "{{ background }}"

set completion-bg "{{ selection_background }}"
set completion-fg "{{ foreground }}"
set completion-highlight-bg "{{ selection_background }}"
set completion-highlight-fg "{{ foreground }}"
set completion-group-bg "{{ selection_background }}"
set completion-group-fg "{{ foreground }}"

set statusbar-fg "{{ color15 }}"
set statusbar-bg "{{ color8 }}"

set notification-bg "{{ selection_background }}"
set notification-fg "{{ color15 }}"
set notification-error-bg "{{ selection_background }}"
set notification-error-fg "{{ color15 }}"
set notification-warning-bg "{{ selection_background }}"
set notification-warning-fg "{{ color9 }}"

set inputbar-fg "{{ color15 }}"
set inputbar-bg "{{ selection_background }}"

set recolor "true"
set recolor-lightcolor "{{ background }}"
set recolor-darkcolor "{{ color15 }}"

set index-fg "{{ color15 }}"
set index-bg "{{ color8 }}"
set index-active-fg "{{ foreground }}"
set index-active-bg "{{ selection_background }}"

set render-loading-bg "{{ selection_background }}"
set render-loading-fg "{{ accent }}"

set highlight-color "rgba({{ color8_rgb }},0.5)"
set highlight-fg "{{ color15 }}"
set highlight-active-color "{{ color15 }}"
