# This file linked to $VIBRANIUM. DO NOT EDIT!!!

# If you want to edit / add / remove environment variables,
# consider using "$XDG_CONFIG_HOME/vibranium/environment",
# which will take priority over this file.

# shellcheck source=/dev/null

# https://specifications.freedesktop.org/basedir-spec/latest
export XDG_DATA_DIRS="/usr/local/share:/usr/share"
export XDG_STATE_HOME="$HOME/.local/state"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_DIRS="/etc/xdg"

export VIBRANIUM_RUNTIME="$XDG_RUNTIME_DIR/vibranium"
export VIBRANIUM_PATH="$XDG_DATA_HOME/vibranium/bin"
export VIBRANIUM_STATE="$XDG_STATE_HOME/vibranium"
export VIBRANIUM_CACHE="$XDG_CACHE_HOME/vibranium"
export VIBRANIUM="$XDG_DATA_HOME/vibranium"
export PATH="$HOME/.local/bin:$VIBRANIUM_PATH:$PATH"

export QT_QPA_PLATFORMTHEME="qt6ct"

# Use Wayland when possible. Fallback to XWayland otherwise
export ELECTRON_OZONE_PLATFORM_HINT="auto"
export QT_QPA_PLATFORM="wayland;xcb"
# Keep in mind!
# https://github.com/basecamp/omarchy/issues/2564#issuecomment-3450877034
export SDL_VIDEODRIVER="wayland"
export GDK_BACKEND="wayland,x11"
export CLUTTER_BACKEND="wayland"

export CHASSIS_TYPE="$(hostnamectl chassis)"

if [[ -f "$HOME/.config/user-dirs.dirs" ]]; then
	while IFS='=' read -r var val; do
		[[ -z "$var" || "$var" == \#* ]] && continue

		val="${val//\"/}"
		[[ "$val" == ~* ]] && {
			val="$HOME${val:1}"
		}

		export "$var"="$val"
	done < "$HOME/.config/user-dirs.dirs"
fi

# Export user-defined environment
source "$XDG_CONFIG_HOME/vibranium/environment"

# vim:ft=bash
