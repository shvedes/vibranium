@import "../vibranium/current/theme/rofi.rasi"
@import "~/.local/share/vibranium/default/rofi/configuration.rasi"

* {
	background-color: transparent;
}

element normal.normal {
    background-color: @background;
    text-color:       @foreground-muted;
}

element selected.normal {
    background-color: @background;
    text-color:       @highlight;
}

element alternate.normal {
    background-color: @background;
    text-color:       @foreground-muted;
}

element-text {
    background-color: transparent;
    cursor:           inherit;
    highlight:        inherit;
    text-color:       inherit;
}

window {
	width:            300px;
    padding:          12;
    background-color: @background;
    border:           2px;
	border-color:     @border;
}

mainbox {
    padding: 8px;
	border:  2px;
	border-color: @border;
}

message {
    border: 0.15em dash;
    margin: 2px 2px 0px 2px;
    padding: 8px 8px 8px 8px;
    border-color: @border;
}

textbox {
    text-color: @foreground;
}

listview {
    padding:      12px 4px 0px ;
    scrollbar:    true;
    border-color: @border;
    spacing:      2px ;
    fixed-height: 0;
    border:       2px dash 0px 0px ;
}

scrollbar {
    width:        2px ;
    handle-width: 2px ;
    handle-color: @border;
}

num-filtered-rows {
    expand:     false;
    text-color: @highlight;
}

num-rows {
    expand:     false;
    text-color: @foreground-muted;
}

textbox-num-sep {
    expand:     false;
    str:        "/";
    text-color: @foreground-muted;
}

inputbar {
    padding:    6px 6px 6px 6px;
    text-color: @foreground;
    children:   [ "prompt","textbox-prompt-colon","entry","overlay","num-filtered-rows","textbox-num-sep","num-rows"];
}

prompt {
	text-color: inherit;
}

entry {
    text-color:        @foreground;
    placeholder-color: @foreground-muted;
    placeholder:       "";
}

element-icon {
	size: 14px;
	padding: 2px;
}

textbox-prompt-colon {
    margin:     0px 2px 0px 0px;
    expand:     false;
    str:        ":";
    text-color: @foreground-muted;
}
