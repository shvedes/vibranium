// hypr.* pages for HyprlandSettings.
// Directory decides namespace: every option here must be hypr.
{
  "pages": [
    {
      "id": "hyprland-advanced-dwindle",
      "label": "Dwindle",
      "icon": "layout",
      "options": [
        {
          "key": "hypr.dwindle.force_split",
          "type": "int",
          "default": 2,
          "label": "Split method",
          "values": [
            0,
            1,
            2
          ],
          "valueLabels": {
            "0": "Follow mouse",
            "1": "Left",
            "2": "Right"
          },
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.force_split"
          }
        },
        {
          "key": "hypr.dwindle.preserve_split",
          "type": "bool",
          "default": true,
          "label": "Preserve split",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.preserve_split"
          }
        },
        {
          "key": "hypr.dwindle.smart_split",
          "type": "bool",
          "default": false,
          "label": "Smart split",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.smart_split"
          }
        },
        {
          "key": "hypr.dwindle.smart_resizing",
          "type": "bool",
          "default": false,
          "label": "Smart resizing",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.smart_resizing"
          }
        },
        {
          "key": "hypr.dwindle.permanent_direction_override",
          "type": "bool",
          "default": false,
          "label": "Direction override",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.permanent_direction_override"
          }
        },
        {
          "key": "hypr.dwindle.special_scale_factor",
          "type": "float",
          "default": 0.98,
          "label": "Special workspace scale",
          "range": {
            "min": 0,
            "max": 1
          },
          "step": 0.01,
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.special_scale_factor"
          }
        },
        {
          "key": "hypr.dwindle.split_width_multiplier",
          "type": "float",
          "default": 1,
          "label": "Width multiplier",
          "range": {
            "min": 0,
            "max": 10
          },
          "step": 0.1,
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.split_width_multiplier"
          }
        },
        {
          "key": "hypr.dwindle.use_active_for_splits",
          "type": "bool",
          "default": false,
          "label": "Use active for splits",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.use_active_for_splits"
          }
        },
        {
          "key": "hypr.dwindle.default_split_ratio",
          "type": "float",
          "default": 1,
          "label": "Split ratio",
          "range": {
            "min": 0.1,
            "max": 1.9
          },
          "step": 0.05,
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.default_split_ratio"
          }
        },
        {
          "key": "hypr.dwindle.split_bias",
          "type": "int",
          "default": 0,
          "label": "Split bias",
          "values": [
            0,
            1
          ],
          "valueLabels": {
            "0": "Directional",
            "1": "Current window"
          },
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.split_bias"
          }
        },
        {
          "key": "hypr.dwindle.precise_mouse_move",
          "type": "bool",
          "default": false,
          "label": "Precise mouse move",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "dwindle.precise_mouse_move"
          }
        }
      ]
    }
  ]
}
