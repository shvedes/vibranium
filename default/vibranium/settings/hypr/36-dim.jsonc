// hypr.* pages for HyprlandSettings.
// Directory decides namespace: every option here must be hypr.
{
  "pages": [
    {
      "id": "hyprland-appearance-dim",
      "label": "Window dimming",
      "icon": "hypr-dim",
      "options": [
        {
          "key": "hypr.decoration.dim_inactive",
          "type": "bool",
          "default": true,
          "label": "Dim inactive",
          "desc": "Whether to dim inactive windows.",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.dim_inactive"
          }
        },
        {
          "key": "hypr.decoration.dim_strength",
          "type": "float",
          "default": 0.1,
          "label": "Dim strength",
          "desc": "Dim strength of inactive windows.",
          "range": {
            "min": 0,
            "max": 1
          },
          "step": 0.05,
          "showIf": [
            {
              "key": "hypr.decoration.dim_inactive",
              "eq": true
            }
          ],
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.dim_strength"
          }
        },
        {
          "key": "hypr.decoration.dim_modal",
          "type": "bool",
          "default": true,
          "label": "Dim modal",
          "desc": "Whether to dim modal windows (pop ups).",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.dim_modal"
          }
        },
        {
          "key": "hypr.decoration.dim_special",
          "type": "float",
          "default": 0.4,
          "label": "Dim special",
          "desc": "Scratchpad's dim level.",
          "range": {
            "min": 0,
            "max": 1
          },
          "step": 0.05,
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.dim_special"
          }
        }
      ]
    }
  ]
}
