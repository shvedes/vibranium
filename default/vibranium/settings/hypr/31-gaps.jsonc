// hypr.* pages for HyprlandSettings.
// Directory decides namespace: every option here must be hypr.
{
  "pages": [
    {
      "id": "hyprland-appearance",
      "label": "Appearance",
      "desc": "Window decoration and visual effects.",
      "icon": "theme",
      "showItemCount": true,
      "items": [
        {
          "type": "submenu",
          "label": "Gaps",
          "sub": "Window spacing",
          "desc": "Spacing between windows.",
          "icon": "hypr-gaps",
          "page": "hyprland-appearance-gaps"
        },
        {
          "type": "submenu",
          "label": "Blur",
          "sub": "Blur options",
          "desc": "Configure blur under windows.",
          "icon": "hypr-blur",
          "page": "hyprland-appearance-blur"
        },
        {
          "type": "submenu",
          "label": "Glow",
          "sub": "Window glow",
          "desc": "Configure glow effects.",
          "icon": "hypr-glow",
          "page": "hyprland-appearance-glow"
        },
        {
          "type": "submenu",
          "label": "Shadows",
          "sub": "Window shadows",
          "desc": "Configure window shadows.",
          "icon": "hypr-shadow",
          "page": "hyprland-appearance-shadow"
        },
        {
          "type": "submenu",
          "label": "Decoration",
          "sub": "General look-n-feel",
          "desc": "Visuals of the WM.",
          "icon": "hypr-decoration",
          "page": "hyprland-appearance-decoration"
        },
        {
          "type": "submenu",
          "label": "Dimming",
          "sub": "Window dimming",
          "desc": "Window dimming options.",
          "icon": "hypr-dim",
          "page": "hyprland-appearance-dim"
        },
        {
          "type": "submenu",
          "label": "Animations",
          "sub": "Animation presets",
          "desc": "Animations and their curves.",
          "icon": "hypr-animations",
          "page": "hyprland-appearance-animations"
        }
      ],
      "options": []
    },
    {
      "id": "hyprland-appearance-gaps",
      "label": "Gaps",
      "icon": "view-grid",
      "options": [
        {
          "key": "hypr.general.gaps_in",
          "type": "int",
          "default": 5,
          "label": "Gaps in",
          "sub": "Inner gaps",
          "range": {
            "min": 0,
            "max": 50
          },
          "step": 1,
          "unit": "px",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "general.gaps_in"
          }
        },
        {
          "key": "hypr.general.gaps_out",
          "type": "int",
          "default": 5,
          "label": "Gaps out",
          "sub": "Outer gaps",
          "range": {
            "min": 0,
            "max": 50
          },
          "step": 1,
          "unit": "px",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "general.gaps_out"
          }
        },
        {
          "key": "hypr.general.smart_gaps",
          "type": "bool",
          "default": false,
          "label": "Smart gaps",
          "sub": "No gaps when single window",
          "desc": "Removes gaps and borders when only one tiled window is visible.",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/smart-gaps.lua",
            "kind": "smartGaps"
          }
        }
      ]
    }
  ]
}
