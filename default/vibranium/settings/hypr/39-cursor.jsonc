// hypr.* pages for HyprlandSettings.
// Directory decides namespace: every option here must be hypr.
{
  "pages": [
    {
      "id": "hyprland-advanced-cursor",
      "label": "Cursor",
      "icon": "cursor",
      "options": [
        {
          "key": "hypr.cursor.enable_hyprcursor",
          "type": "bool",
          "default": true,
          "label": "Enable hyprcursor",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.enable_hyprcursor"
          }
        },
        {
          "key": "hypr.cursor.sync_gsettings_theme",
          "type": "bool",
          "default": true,
          "label": "Sync gsettings theme",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.sync_gsettings_theme"
          }
        },
        {
          "key": "hypr.cursor.no_hardware_cursors",
          "type": "int",
          "default": 0,
          "label": "Hardware cursors",
          "values": [
            0,
            1,
            2
          ],
          "valueLabels": {
            "0": "Auto",
            "1": "Always software",
            "2": "Force software"
          },
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.no_hardware_cursors"
          }
        },
        {
          "key": "hypr.cursor.use_cpu_buffer",
          "type": "int",
          "default": 0,
          "label": "CPU buffer",
          "values": [
            0,
            1,
            2
          ],
          "valueLabels": {
            "0": "Auto",
            "1": "Always",
            "2": "Force"
          },
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.use_cpu_buffer"
          }
        },
        {
          "key": "hypr.cursor.invisible",
          "type": "bool",
          "default": false,
          "label": "Hide cursor",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.invisible"
          }
        },
        {
          "key": "hypr.cursor.inactive_timeout",
          "type": "float",
          "default": 0,
          "label": "Hide after",
          "range": {
            "min": 0,
            "max": 60
          },
          "step": 0.5,
          "unit": "s",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.inactive_timeout"
          }
        },
        {
          "key": "hypr.cursor.hotspot_padding",
          "type": "int",
          "default": 0,
          "label": "Hotspot padding",
          "range": {
            "min": 0,
            "max": 32
          },
          "step": 1,
          "unit": "px",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.hotspot_padding"
          }
        },
        {
          "key": "hypr.cursor.min_refresh_rate",
          "type": "int",
          "default": 60,
          "label": "Min refresh rate",
          "range": {
            "min": 60,
            "max": 360
          },
          "step": 1,
          "unit": "Hz",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.min_refresh_rate"
          }
        },
        {
          "key": "hypr.cursor.hide_on_key_press",
          "type": "bool",
          "default": false,
          "label": "Hide on key press",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.hide_on_key_press"
          }
        },
        {
          "key": "hypr.cursor.hide_on_touch",
          "type": "bool",
          "default": false,
          "label": "Hide on touch",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.hide_on_touch"
          }
        },
        {
          "key": "hypr.cursor.hide_on_tablet",
          "type": "bool",
          "default": false,
          "label": "Hide on tablet",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.hide_on_tablet"
          }
        },
        {
          "key": "hypr.cursor.no_warps",
          "type": "bool",
          "default": false,
          "label": "No warps",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.no_warps"
          }
        },
        {
          "key": "hypr.cursor.persistent_warps",
          "type": "bool",
          "default": false,
          "label": "Persistent warps",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.persistent_warps"
          }
        },
        {
          "key": "hypr.cursor.warp_back_after_non_mouse_input",
          "type": "bool",
          "default": false,
          "label": "Warp back after non-mouse input",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.warp_back_after_non_mouse_input"
          }
        },
        {
          "key": "hypr.cursor.warp_on_change_workspace",
          "type": "int",
          "default": 0,
          "label": "Warp on workspace change",
          "values": [
            0,
            1,
            2
          ],
          "valueLabels": {
            "0": "Disabled",
            "1": "Enabled",
            "2": "Force center"
          },
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.warp_on_change_workspace"
          }
        },
        {
          "key": "hypr.cursor.warp_on_toggle_special",
          "type": "int",
          "default": 0,
          "label": "Warp on special toggle",
          "values": [
            0,
            1,
            2
          ],
          "valueLabels": {
            "0": "Disabled",
            "1": "Enabled",
            "2": "Force center"
          },
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.warp_on_toggle_special"
          }
        },
        {
          "key": "hypr.cursor.no_break_fs_vrr",
          "type": "int",
          "default": 0,
          "label": "No break fullscreen VRR",
          "values": [
            0,
            1,
            2
          ],
          "valueLabels": {
            "0": "Disabled",
            "1": "Enabled",
            "2": "Force"
          },
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.no_break_fs_vrr"
          }
        },
        {
          "key": "hypr.cursor.zoom_rigid",
          "type": "bool",
          "default": false,
          "label": "Zoom rigid",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.zoom_rigid"
          }
        },
        {
          "key": "hypr.cursor.zoom_detached_camera",
          "type": "bool",
          "default": false,
          "label": "Zoom detached camera",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.zoom_detached_camera"
          }
        },
        {
          "key": "hypr.cursor.zoom_disable_aa",
          "type": "bool",
          "default": false,
          "label": "Zoom disable anti-aliasing",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
            "ctl": "cursor.zoom_disable_aa"
          }
        }
      ]
    }
  ]
}
