// hypr.* pages for HyprlandSettings.
// Directory decides namespace: every option here must be hypr.
{
  "pages": [
    {
      "id": "hyprland-appearance-glow",
      "label": "Glow",
      "icon": "glow",
      "options": [
        {
          "key": "hypr.decoration.glow.enabled",
          "type": "bool",
          "default": false,
          "label": "Enabled",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.glow.enabled"
          }
        },
        {
          "key": "hypr.decoration.glow.range",
          "type": "int",
          "default": 20,
          "label": "Range",
          "range": {
            "min": 1,
            "max": 100
          },
          "step": 1,
          "unit": "px",
          "showIf": [
            {
              "key": "hypr.decoration.glow.enabled",
              "eq": true
            }
          ],
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.glow.range"
          }
        },
        {
          "key": "hypr.decoration.glow.render_power",
          "type": "int",
          "default": 2,
          "label": "Power",
          "range": {
            "min": 1,
            "max": 4
          },
          "step": 1,
          "showIf": [
            {
              "key": "hypr.decoration.glow.enabled",
              "eq": true
            }
          ],
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.glow.render_power"
          }
        }
      ]
    }
  ]
}
