// hypr.* pages for HyprlandSettings.
// Directory decides namespace: every option here must be hypr.
{
  "pages": [
    {
      "id": "hyprland-appearance-shadow",
      "label": "Shadows",
      "icon": "shadow",
      "options": [
        {
          "key": "hypr.decoration.shadow.enabled",
          "type": "bool",
          "default": true,
          "label": "Enabled",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.shadow.enabled"
          }
        },
        {
          "key": "hypr.decoration.shadow.sharp",
          "type": "bool",
          "default": false,
          "label": "Sharp",
          "showIf": [
            {
              "key": "hypr.decoration.shadow.enabled",
              "eq": true
            }
          ],
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.shadow.sharp"
          }
        },
        {
          "key": "hypr.decoration.shadow.range",
          "type": "int",
          "default": 4,
          "label": "Range",
          "range": {
            "min": 1,
            "max": 128
          },
          "step": 1,
          "showIf": [
            {
              "key": "hypr.decoration.shadow.enabled",
              "eq": true
            }
          ],
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.shadow.range"
          }
        },
        {
          "key": "hypr.decoration.shadow.render_power",
          "type": "int",
          "default": 3,
          "label": "Power",
          "range": {
            "min": 1,
            "max": 4
          },
          "step": 1,
          "showIf": [
            {
              "key": "hypr.decoration.shadow.enabled",
              "eq": true
            }
          ],
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "decoration.shadow.render_power"
          }
        }
      ]
    }
  ]
}
