// hypr.* pages for HyprlandSettings.
// Directory decides namespace: every option here must be hypr.
{
  "pages": [
    {
      "id": "hyprland-appearance-animations",
      "label": "Animations",
      "icon": "animation",
      "options": [
        {
          "key": "hypr.animations.enabled",
          "type": "bool",
          "default": true,
          "label": "Enabled",
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/look-and-feel.lua",
            "ctl": "animations.enabled"
          }
        },
        {
          "key": "hypr.animations.preset",
          "type": "string",
          "default": "default",
          "label": "Preset",
          "sub": "Set animation curve",
          "values": [
            "akaito",
            "bounce",
            "default",
            "expressive",
            "fast",
            "omarchy",
            "slide"
          ],
          "valueLabels": {
            "akaito": "Akaito",
            "bounce": "Bounce",
            "default": "Default",
            "expressive": "Expressive",
            "fast": "Fast",
            "omarchy": "Omarchy",
            "slide": "Slide"
          },
          "showIf": [
            {
              "key": "hypr.animations.enabled",
              "eq": true
            }
          ],
          "hypr": {
            "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/animations.lua",
            "kind": "animPreset"
          }
        }
      ]
    }
  ]
}
