// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell.
{
  "pages": [
    {
      "id": "idle",
      "label": "Idle",
      "icon": "timer",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.idle.enabled",
          "type": "bool",
          "default": true,
          "label": "Idle daemon",
          "sub": "Lock and suspend automatically",
          "desc": "Automatically locks the session and suspends the system\nafter configured periods of inactivity."
        },
        {
          "key": "shell.idle.timers",
          "type": "timers",
          "default": [
            {
              "minutes": 10,
              "action": "command",
              "command": "vb-shell session lock"
            },
            {
              "minutes": 15,
              "action": "command",
              "command": "vb-shell session suspend"
            }
          ],
          "label": "Idle timers",
          "desc": "Ordered idle timers, strictly increasing by minute.\nManaged by the idle service through its IPC verbs.",
          "visibility": "internal"
        }
      ],
      "items": []
    }
  ]
}
