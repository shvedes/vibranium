// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell.
{
  "pages": [
    {
      "label": "OSD",
      "icon": "monitor",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.osd.offset",
          "type": "int",
          "default": 80,
          "label": "Offset",
          "sub": "OSD offset level",
          "range": {
            "min": 0,
            "max": 400
          },
          "step": 4,
          "unit": " px"
        }
      ]
    }
  ]
}
