// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell.
{
  "pages": [
    {
      "label": "Lock screen",
      "icon": "lock",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.lockscreen.backgroundMode",
          "type": "string",
          "default": "background",
          "label": "Background",
          "sub": "Lock screen backdrop source",
          "desc": "Select lockscreen background type.",
          "values": [
            "screen",
            "background"
          ],
          "valueLabels": {
            "screen": "Screen contents",
            "background": "Wallpaper"
          }
        },
        {
          "key": "shell.lockscreen.vignette",
          "type": "string",
          "default": "off",
          "label": "Vignette",
          "sub": "Darken the backdrop edges",
          "values": [
            "off",
            "small",
            "medium",
            "large",
            "gigantic"
          ],
          "valueLabels": {
            "off": "Off",
            "small": "Small",
            "medium": "Medium",
            "large": "Large",
            "gigantic": "Gigantic"
          }
        },
        {
          "key": "shell.lockscreen.blurBackground",
          "type": "bool",
          "default": true,
          "label": "Blurred backdrop",
          "sub": "Blur lockscreen background",
          "desc": "Whether to use blurred background."
        },
        {
          "key": "shell.lockscreen.blurPower",
          "type": "string",
          "default": "medium",
          "label": "Blur strength",
          "sub": "Adjust blur strenght",
          "desc": "Background blur level.",
          "values": [
            "low",
            "medium",
            "high"
          ],
          "valueLabels": {
            "low": "Low",
            "medium": "Medium",
            "high": "High"
          },
          "showIf": [
            {
              "key": "shell.lockscreen.blurBackground",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.lockscreen.dim",
          "type": "int",
          "default": 70,
          "label": "Dim strength",
          "sub": "Backdrop dim level",
          "desc": "How strongly to dim the background when blur is disabled.",
          "range": {
            "min": 0,
            "max": 100
          },
          "step": 5,
          "unit": "%",
          "showIf": [
            {
              "key": "shell.lockscreen.blurBackground",
              "eq": false
            }
          ]
        },
        {
          "key": "shell.lockscreen.dimBlurred",
          "type": "int",
          "default": 40,
          "label": "Dim strength",
          "sub": "Backdrop dim level",
          "desc": "How strongly to dim the background when blur is enabled.",
          "range": {
            "min": 0,
            "max": 100
          },
          "step": 5,
          "unit": "%",
          "showIf": [
            {
              "key": "shell.lockscreen.blurBackground",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.lockscreen.nowPlaying",
          "type": "bool",
          "default": true,
          "label": "Now playing box",
          "sub": "Current media box"
        },
        {
          "key": "shell.lockscreen.pauseMusic",
          "type": "bool",
          "default": true,
          "label": "Pause music on lock",
          "sub": "(un)pause media automatically",
          "desc": "Automatically (un)pause music when (un)locking."
        }
      ]
    }
  ]
}
