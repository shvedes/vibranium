// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell,
// except PLAYER_FADE_DURATION riding along (see SHELL_CROSS_OK).
{
  "pages": [
    {
      "id": "media-controls",
      "label": "Media Controls",
      "icon": "music",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.osd.nowPlaying",
          "type": "bool",
          "default": false,
          "label": "Track change OSD",
          "sub": "Show track skips and play/pause changes"
        },
        {
          "key": "shell.osd.nowPlayingArt",
          "type": "bool",
          "default": false,
          "label": "Show cover art",
          "sub": "Show cover in track OSD",
          "desc": "Show track's cover art instead in OSD.",
          "showIf": [
            {
              "key": "shell.osd.nowPlaying",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.osd.nowPlayingPosition",
          "type": "string",
          "default": "bottom",
          "label": "Track OSD position",
          "sub": "Top or bottom edge",
          "values": [
            "top",
            "bottom"
          ],
          "valueLabels": {
            "top": "Top",
            "bottom": "Bottom"
          },
          "showIf": [
            {
              "key": "shell.osd.nowPlaying",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.osd.nowPlayingOffset",
          "type": "int",
          "default": 80,
          "label": "Track OSD offset",
          "sub": "Pixels from the edge",
          "desc": "How far the track OSD sits from its edge.",
          "range": {
            "min": 0,
            "max": 400
          },
          "step": 5,
          "unit": " px",
          "showIf": [
            {
              "key": "shell.osd.nowPlaying",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.osd.blockBrowsers",
          "type": "bool",
          "default": true,
          "label": "Block browser media",
          "sub": "Hide browsers from media controls and OSD",
          "desc": "Ignore browser MPRIS clients in resident media controls and OSD events."
        },
        {
          "key": "PLAYER_FADE_DURATION",
          "type": "string",
          "default": "off",
          "label": "Volume fade speed",
          "sub": "Volume fade duration",
          "desc": "How fast the fade effect should be when (un)pausing media.",
          "values": [
            "very_slow",
            "slow",
            "normal",
            "fast",
            "very_fast",
            "off"
          ],
          "valueLabels": {
            "very_slow": "Very slow",
            "slow": "Slow",
            "normal": "Normal",
            "fast": "Fast",
            "very_fast": "Very fast",
            "off": "Off"
          }
        }
      ]
    }
  ]
}
