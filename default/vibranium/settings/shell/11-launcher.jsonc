// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell.
{
  "pages": [
    {
      "label": "App launcher",
      "icon": "grid",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.launcher.searchEngine",
          "type": "string",
          "default": "duckduckgo",
          "label": "Search engine",
          "sub": "Where to search your queries",
          "desc": "What search engine to use for the search shortcut.",
          "values": [
            "google",
            "duckduckgo",
            "bing",
            "brave"
          ],
          "valueLabels": {
            "google": "Google",
            "duckduckgo": "DuckDuckGo",
            "bing": "Bing",
            "brave": "Brave"
          }
        },
        {
          "key": "shell.launcher.showIcons",
          "type": "bool",
          "default": true,
          "label": "Show icons",
          "sub": "Show/hide app icons"
        },
        {
          "key": "shell.launcher.showBadges",
          "type": "bool",
          "default": true,
          "label": "Show PWA/TUI badges",
          "sub": "Show/hide PWA & TUI badges"
        },
        {
          "key": "shell.launcher.showDescriptions",
          "type": "bool",
          "default": true,
          "label": "Show descriptions",
          "sub": "Show/hide app description"
        },
        {
          "key": "shell.launcher.sortMethod",
          "type": "string",
          "default": "alphabetical",
          "label": "Sort order (idle)",
          "sub": "Sorting method",
          "desc": "How to sort apps. Search results are always <u>by relevance</u>.",
          "values": [
            "alphabetical",
            "frequency"
          ],
          "valueLabels": {
            "alphabetical": "Alphabetical",
            "frequency": "Most used"
          }
        },
        {
          "key": "shell.launcher.autoSelect",
          "type": "bool",
          "default": false,
          "label": "Auto-select",
          "sub": "Auto-select remaining entry"
        },
        {
          "key": "shell.launcher.showClipboardSuggestion",
          "type": "bool",
          "default": true,
          "label": "Clipboard suggestion",
          "sub": "Suggest clipboard contents",
          "desc": "Suggest opening the newest copied file/path/link."
        },
        {
          "key": "APP_LAUNCHER_ALWAYS_FOCUS",
          "type": "bool",
          "default": false,
          "label": "Focus first",
          "sub": "Focus existing windows instead",
          "desc": "Focus existing windows instad of opening new instances.",
          "warning": "Sometimes it can misbehave!"
        }
      ],
      "items": [
        {
          "type": "submenu",
          "label": "Enabled plugins",
          "sub": "Toggle AppLauncher plugins",
          "icon": "list",
          "page": "launcher-enabled"
        },
        {
          "id": "clearUsageHistory",
          "type": "action",
          "icon": "remove",
          "label": "Clear usage history",
          "sub": "Erase the most-used cache",
          "after": "shell.launcher.sortMethod",
          "showIf": [
            {
              "key": "shell.launcher.sortMethod",
              "eq": "frequency"
            }
          ]
        }
      ]
    },
    {
      "id": "launcher-enabled",
      "label": "Enabled plugins",
      "icon": "list",
      "showItemCount": true,
      "options": [],
      "items": [
        {
          "id": "launcher-calc",
          "type": "toggle",
          "label": "Calculator"
        },
        {
          "id": "launcher-unit",
          "type": "toggle",
          "label": "Unit converter"
        },
        {
          "id": "launcher-fx",
          "type": "toggle",
          "label": "Currency"
        },
        {
          "id": "launcher-time",
          "type": "toggle",
          "label": "Time in city"
        },
        {
          "id": "launcher-color",
          "type": "toggle",
          "label": "Color"
        },
        {
          "id": "launcher-websearch",
          "type": "toggle",
          "label": "Web search"
        }
      ]
    }
  ]
}
