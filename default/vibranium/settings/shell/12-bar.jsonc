// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell.
{
  "pages": [
    {
      "id": "bar",
      "label": "Statusbar",
      "icon": "monitor",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.statusbar.enabled",
          "type": "bool",
          "default": true,
          "label": "Show statusbar",
          "sub": "Display the top/bottom bar",
          "desc": "Master switch for the bar itself."
        },
        {
          "key": "shell.statusbar.showBorder",
          "type": "bool",
          "default": false,
          "label": "Show border",
          "sub": "Add a 1px line to the bar",
          "desc": "Adds a 1px border on the edge facing the screen.",
          "showIf": [
            {
              "key": "shell.statusbar.enabled",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.statusbar.showShadow",
          "type": "bool",
          "default": true,
          "label": "Show shadow",
          "sub": "Add a soft shadow to the bar",
          "desc": "Adds a subtle shadow along the edge facing the screen.",
          "showIf": [
            {
              "key": "shell.statusbar.enabled",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.statusbar.blurred",
          "type": "bool",
          "default": false,
          "label": "Transparent",
          "sub": "Make the bar background translucent",
          "desc": "Makes the bar background translucent for compositor blur.",
          "showIf": [
            {
              "key": "shell.statusbar.enabled",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.statusbar.position",
          "type": "string",
          "default": "top",
          "label": "Position",
          "sub": "Which screen edge the bar sits on",
          "values": [
            "top",
            "bottom"
          ],
          "valueLabels": {
            "top": "Top",
            "bottom": "Bottom"
          },
          "showIf": [
            {
              "key": "shell.statusbar.enabled",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.statusbar.layout",
          "type": "layout",
          "label": "Zone layout",
          "default": {
            "left": [
              "workspaces"
            ],
            "center": [
              "clock"
            ],
            "right": [
              "keyboardLayout",
              "caffeine",
              "timer",
              "update",
              "readingMode",
              "recording",
              "weather",
              "nowPlaying",
              "colorPicker",
              "powerProfile",
              "privacy",
              "printers",
              "archUpdates",
              "nightLight",
              "bluetooth",
              "network",
              "volume",
              "battery",
              "session"
            ],
            "disabled": [
              "archUpdates",
              "colorPicker",
              "nightLight",
              "keyboardLayout",
              "weather",
              "printers",
              "privacy",
              "nowPlaying"
            ]
          },
          "visibility": "internal"
        },
        {
          "key": "shell.statusbar.networkRightClick",
          "type": "string",
          "default": "vb-launch-networkmanager",
          "label": "Right-click action",
          "allowEmpty": true,
          "visibility": "hidden"
        },
        {
          "key": "shell.statusbar.bluetoothRightClick",
          "type": "string",
          "default": "",
          "label": "Right-click action",
          "allowEmpty": true,
          "visibility": "hidden"
        },
        {
          "key": "shell.statusbar.workspacesRightClick",
          "type": "string",
          "default": "",
          "label": "Right-click action",
          "allowEmpty": true,
          "visibility": "hidden"
        },
        {
          "key": "shell.statusbar.trayRightClick",
          "type": "string",
          "default": "",
          "label": "Right-click action",
          "allowEmpty": true,
          "visibility": "hidden"
        },
        {
          "key": "shell.statusbar.logoutRightClick",
          "type": "string",
          "default": "",
          "label": "Right-click action",
          "allowEmpty": true,
          "visibility": "hidden"
        }
      ],
      "items": [
        {
          "type": "submenu",
          "label": "Enabled modules",
          "icon": "list",
          "page": "bar-enabled",
          "showIf": [
            {
              "key": "shell.statusbar.enabled",
              "eq": true
            }
          ]
        },
        {
          "type": "submenu",
          "label": "Module options",
          "icon": "settings",
          "page": "bar-modules",
          "showIf": [
            {
              "key": "shell.statusbar.enabled",
              "eq": true
            }
          ]
        }
      ]
    },
    {
      "id": "bar-enabled",
      "label": "Enabled modules",
      "desc": "Which static modules are shown in the bar.",
      "icon": "apps",
      "showItemCount": true,
      "options": [],
      "items": [
        {
          "id": "bar-privacy",
          "type": "toggle",
          "label": "Privacy"
        },
        {
          "id": "bar-clock",
          "type": "toggle",
          "label": "Clock"
        },
        {
          "id": "bar-keyboardLayout",
          "type": "toggle",
          "label": "Keyboard layout"
        },
        {
          "id": "bar-bluetooth",
          "type": "toggle",
          "label": "Bluetooth"
        },
        {
          "id": "bar-network",
          "type": "toggle",
          "label": "Network"
        },
        {
          "id": "bar-battery",
          "type": "toggle",
          "label": "Battery"
        },
        {
          "id": "bar-volume",
          "type": "toggle",
          "label": "Volume"
        },
        {
          "id": "bar-powerProfile",
          "type": "toggle",
          "label": "Power profile"
        },
        {
          "id": "bar-session",
          "type": "toggle",
          "label": "Power & Tray"
        },
        {
          "id": "bar-archUpdates",
          "type": "toggle",
          "label": "Arch updates"
        },
        {
          "id": "bar-colorPicker",
          "type": "toggle",
          "label": "Color picker"
        },
        {
          "id": "bar-nightLight",
          "type": "toggle",
          "label": "Night Light",
          "when": "[[ \"$CHASSIS_TYPE\" != vm ]]"
        },
        {
          "id": "bar-weather",
          "type": "toggle",
          "label": "Weather"
        },
        {
          "id": "bar-printers",
          "type": "toggle",
          "label": "Printers"
        },
        {
          "id": "bar-nowPlaying",
          "type": "toggle",
          "label": "Now Playing"
        }
      ]
    },
    {
      "id": "bar-modules",
      "label": "Module options",
      "desc": "Options of each bar module.",
      "icon": "settings",
      "showItemCount": true,
      "items": [
        {
          "type": "submenu",
          "label": "Clock",
          "page": "bar-module-clock"
        },
        {
          "type": "submenu",
          "label": "Volume",
          "page": "bar-module-volume"
        },
        {
          "type": "submenu",
          "label": "Weather",
          "page": "bar-module-weather"
        },
        {
          "type": "submenu",
          "label": "Arch updates",
          "page": "bar-module-archupdates"
        },
        {
          "type": "submenu",
          "label": "Now Playing",
          "page": "bar-module-nowplaying"
        },
        {
          "type": "submenu",
          "label": "Recording",
          "page": "bar-module-recording"
        },
        {
          "type": "submenu",
          "label": "Color Picker",
          "page": "bar-module-colorpicker"
        }
      ],
      "options": []
    }
  ]
}
