// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell.
{
  "pages": [
    {
      "id": "bar-module-nowplaying",
      "label": "Now Playing",
      "desc": "Options of the bar now playing module.",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.statusbar.nowPlayingTitle",
          "type": "bool",
          "default": false,
          "label": "Show track name",
          "sub": "Title next to the icon",
          "desc": "Show the track name next to the icon."
        },
        {
          "key": "shell.statusbar.nowPlayingFlash",
          "type": "bool",
          "default": true,
          "label": "Flash track name",
          "sub": "Reveal the name on track changes",
          "desc": "When enabled, the track name is briefly revealed on each track change."
        }
      ]
    },
    {
      "id": "bar-module-recording",
      "label": "Recording",
      "desc": "Options of the bar recording module.",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.statusbar.recordingElapsed",
          "type": "bool",
          "default": false,
          "label": "Elapsed time pill",
          "sub": "Dot plus duration",
          "desc": "Show a pill with elapsed recording time."
        }
      ]
    },
    {
      "id": "bar-module-volume",
      "label": "Volume",
      "desc": "Options of the bar volume module.",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.statusbar.volumeShowMic",
          "type": "bool",
          "default": false,
          "label": "Show microphone",
          "sub": "Always show mic pill"
        },
        {
          "key": "shell.statusbar.volumeRightClick",
          "type": "string",
          "default": "vb-shell app audioMixer",
          "label": "Right-click action",
          "sub": "Command on right-click",
          "allowEmpty": true,
          "visibility": "hidden"
        },
        {
          "key": "shell.statusbar.volumeMiddleClick",
          "type": "string",
          "default": "",
          "label": "Middle-click action",
          "sub": "Command on middle-click",
          "allowEmpty": true,
          "visibility": "hidden"
        }
      ]
    },
    {
      "id": "bar-module-clock",
      "label": "Clock",
      "desc": "Options of the bar clock module.",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.statusbar.clockSeconds",
          "type": "bool",
          "default": false,
          "label": "Show seconds",
          "sub": "Display seconds",
          "desc": "Show seconds in the bar clock.",
          "warning": "Heavily affects CPU usage!"
        },
        {
          "key": "shell.statusbar.clockSecondsTooltip",
          "type": "bool",
          "default": false,
          "label": "Show in tooltip",
          "sub": "Display seconds on hover",
          "desc": "Show seconds only in the clock tooltip.",
          "showIf": [
            {
              "key": "shell.statusbar.clockSeconds",
              "eq": true
            }
          ]
        },
        {
          "key": "shell.statusbar.clockFormat",
          "type": "string",
          "default": "24",
          "label": "Time format",
          "sub": "12- or 24-hour clock",
          "desc": "How the bar clock displays the time.\n24-hour shows 21:30, 12-hour shows 09:30 PM.",
          "values": [
            "12",
            "24"
          ],
          "valueLabels": {
            "12": "12-hour (AM/PM)",
            "24": "24-hour"
          }
        },
        {
          "key": "shell.statusbar.clockFullDate",
          "type": "bool",
          "default": false,
          "label": "Show full date",
          "sub": "Date before time",
          "desc": "Show full date before time.\nMon, Sep 21 21:30."
        },
        {
          "key": "shell.statusbar.clockRightClick",
          "type": "string",
          "default": "",
          "label": "Right-click action",
          "sub": "Command on right-click",
          "allowEmpty": true,
          "visibility": "hidden"
        }
      ]
    },
    {
      "id": "bar-module-weather",
      "label": "Weather",
      "desc": "Options of the bar weather module.",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.statusbar.weatherShowTemp",
          "type": "bool",
          "default": false,
          "label": "Show temperature",
          "sub": "Temperature next to the icon",
          "desc": "Show temperature next to the icon."
        },
        {
          "key": "shell.statusbar.weatherFlash",
          "type": "bool",
          "default": true,
          "label": "Flash temperature",
          "sub": "Reveal temperature on updates",
          "desc": "When enabled, the temperature is briefly revealed on each data update.",
          "showIf": [
            {
              "key": "shell.statusbar.weatherShowTemp",
              "eq": false
            }
          ]
        },
        {
          "key": "shell.statusbar.weatherUnit",
          "type": "string",
          "default": "auto",
          "label": "Units",
          "sub": "Temperature units",
          "values": [
            "auto",
            "metric",
            "imperial"
          ],
          "valueLabels": {
            "auto": "Auto",
            "metric": "Metric (\u00b0C, km/h)",
            "imperial": "Imperial (\u00b0F, mph)"
          }
        },
        {
          "key": "shell.statusbar.weatherRefreshMinutes",
          "type": "int",
          "default": 15,
          "label": "Refresh interval",
          "sub": "Minutes between forecasts",
          "range": {
            "min": 5,
            "max": 120
          },
          "step": 5,
          "unit": " min"
        },
        {
          "key": "shell.statusbar.weatherVerbose",
          "type": "bool",
          "default": false,
          "label": "Verbose forecast",
          "sub": "Per-day details"
        }
      ]
    },
    {
      "id": "bar-module-archupdates",
      "label": "Arch updates",
      "desc": "Options of the bar updates module.",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.statusbar.archUpdatesHeavyWarning",
          "type": "bool",
          "default": true,
          "label": "Heavy backlog warning",
          "sub": "See description below",
          "desc": "Show the warning message when accumulating many package updates."
        }
      ]
    },
    {
      "id": "bar-module-colorpicker",
      "label": "Color Picker",
      "desc": "Options of the bar color picker module.",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.colorPicker.showLastColor",
          "type": "bool",
          "default": true,
          "label": "Fill last color",
          "sub": "Fill the bar icon with last copied color"
        }
      ]
    }
  ]
}
