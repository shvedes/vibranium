// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell.
{
  "pages": [
    {
      "label": "Screenshots",
      "icon": "screenshot",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.screenshots.fileType",
          "type": "string",
          "default": "jpeg",
          "label": "File type",
          "sub": "Default filetype",
          "desc": "Default filetype.",
          "values": [
            "png",
            "jpeg"
          ],
          "valueLabels": {
            "png": "PNG",
            "jpeg": "JPEG"
          }
        },
        {
          "key": "shell.screenshots.showNotification",
          "type": "bool",
          "default": true,
          "label": "Notification",
          "sub": "Notify when taking screenshots",
          "desc": "Notify when taking screenshots."
        },
        {
          "key": "shell.screenshots.autoAnnotate",
          "type": "bool",
          "default": false,
          "label": "Auto-annotate",
          "sub": "Auto-annotate screenshots",
          "desc": "Open the annotation overlay after every capture."
        },
        {
          "key": "shell.screenshots.saveToDisk",
          "type": "bool",
          "default": true,
          "label": "Save to disk",
          "sub": "Save screenshots on disk",
          "desc": "Whether to save screenshots on disk. Off = clipboard only.",
          "showIf": [
            {
              "key": "shell.screenshots.autoAnnotate",
              "eq": false
            }
          ]
        },
        {
          "key": "shell.screenshots.captureCursor",
          "type": "bool",
          "default": false,
          "label": "Capture cursor",
          "sub": "Capture mouse cursor",
          "desc": "Whether to capture mouse cursor."
        },
        {
          "key": "shell.screenshots.uiSize",
          "type": "string",
          "default": "small",
          "label": "Annotator UI size",
          "sub": "Toolbar scale",
          "desc": "Toolbar scale in the annotation overlay.",
          "values": [
            "small",
            "medium",
            "large"
          ],
          "valueLabels": {
            "small": "Small",
            "medium": "Medium",
            "large": "Large"
          }
        }
      ]
    }
  ]
}
