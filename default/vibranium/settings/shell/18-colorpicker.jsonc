// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell.
{
  "pages": [
    {
      "label": "Color picker",
      "icon": "pipette",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.colorPicker.notifyOnPick",
          "type": "bool",
          "default": true,
          "label": "Notifications",
          "sub": "Notify after each pick"
        },
        {
          "key": "shell.colorPicker.historySize",
          "type": "int",
          "default": 10,
          "label": "Color history size",
          "sub": "Color history size",
          "range": {
            "min": 1,
            "max": 50
          },
          "step": 1
        }
      ]
    }
  ]
}
