// Shell-owned pages (shell.*) for the Settings store.
// Directory decides namespace: every option here must be shell.
{
  "pages": [
    {
      "label": "Night Light",
      "icon": "night-light",
      "showItemCount": true,
      "options": [
        {
          "key": "shell.nightLight.enabled",
          "type": "bool",
          "default": false,
          "label": "Night light",
          "sub": "Enable blue light filter",
          "requires": {
            "chassis": "!vm"
          }
        },
        {
          "key": "shell.statusbar.nightLightTemperature",
          "type": "int",
          "default": 6000,
          "range": {
            "min": 2000,
            "max": 20000
          },
          "step": 100,
          "unit": " K",
          "label": "Temperature",
          "sub": "Night light temperature in Kelvin",
          "showIf": [
            {
              "key": "shell.nightLight.enabled",
              "eq": true
            }
          ],
          "requires": {
            "chassis": "!vm"
          }
        }
      ]
    }
  ]
}
