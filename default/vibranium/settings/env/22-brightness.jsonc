// Bare UPPER_SNAKE env pages for the Settings store.
// Directory decides namespace: every option here must be env.
{
  "pages": [
    {
      "label": "Brightness",
      "icon": "brightness",
      "showItemCount": true,
      "items": [
        {
          "type": "separator"
        },
        {
          "type": "action",
          "label": "Calibrate DDC timeouts",
          "sub": "External monitors only",
          "icon": "monitor",
          "command": "vb-core-brightness --calibrate -q",
          "when": "[[ $CHASSIS_TYPE != vm ]]"
        }
      ],
      "options": [
        {
          "key": "BRIGHTNESS_STEP",
          "type": "int",
          "default": 5,
          "label": "Brightness step",
          "sub": "Brightness adjustment step",
          "range": {
            "min": 1,
            "max": 25
          },
          "step": 1,
          "unit": "%"
        },
        {
          "key": "BRIGHTNESS_NOTIFY",
          "type": "bool",
          "default": true,
          "label": "Brightness notifications",
          "sub": "Notify brightness changes"
        }
      ]
    }
  ]
}
