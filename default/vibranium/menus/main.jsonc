[
  {
    "id": "main",
    "label": "Vibranium",
    "items": [
      {
        "id": "settings",
        "type": "submenu",
        "label": "Settings",
        "icon": "settings",
        "page": "settings"
      },
      {
        "id": "install",
        "desc": "Packages, themes and fonts.",
        "type": "submenu",
        "label": "Install",
        "icon": "install",
        "page": "install"
      },
      {
        "id": "remove",
        "desc": "Uninstall packages, themes and fonts.",
        "type": "submenu",
        "label": "Remove",
        "icon": "remove",
        "page": "remove"
      },
      {
        "id": "update",
        "desc": "OS packages, AUR, themes and Vibranium itself.",
        "type": "submenu",
        "label": "Update",
        "icon": "update",
        "page": "update"
      },
      {
        "id": "setup",
        "desc": "Hardware and service provisioning presets.",
        "type": "submenu",
        "label": "Setup",
        "icon": "setup",
        "page": "setup",
        "when": "[[ $CHASSIS_TYPE != vm ]]"
      },
      {
        "id": "help",
        "desc": "Documentation and keybinding cheatsheet.",
        "type": "submenu",
        "label": "Help",
        "icon": "help",
        "page": "help"
      }
    ]
  },
  {
    "id": "setup",
    "label": "Setup",
    "items": [
      {
        "type": "action",
        "label": "Secure Boot",
        "sub": "Configure Secure Boot easily",
        "icon": "cpu",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-sboot"
      },
      {
        "type": "action",
        "label": "Firewall",
        "sub": "Basic firewall setup",
        "icon": "firewall",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-ufw"
      },
      {
        "type": "action",
        "label": "Docker",
        "sub": "Install & confiure Docker",
        "icon": "docker",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-docker"
      },
      {
        "type": "action",
        "label": "QEMU",
        "sub": "Install and configure VMs",
        "icon": "qemu",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-qemu"
      },
      {
        "type": "action",
        "label": "CUPS",
        "sub": "Install & configure printing",
        "icon": "printer",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-cups"
      }
    ]
  },
  {
    "id": "install",
    "label": "Install",
    "items": [
      {
        "type": "action",
        "label": "Arch Package",
        "sub": "Install official packages",
        "icon": "archlinux",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-install -- vb-pkg-install"
      },
      {
        "type": "action",
        "label": "AUR Package",
        "sub": "Install AUR packages",
        "icon": "package-aur",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-install-aur -- vb-pkg-install --aur"
      },
      {
        "type": "separator"
      },
      {
        "type": "action",
        "label": "Theme",
        "sub": "Install Vibranium themes",
        "icon": "theme",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-theme-install -- vb-theme-install"
      },
      {
        "type": "action",
        "label": "Font",
        "sub": "Install font packages",
        "icon": "font",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-font-install -- vb-pkg-font-install"
      },
      {
        "type": "action",
        "label": "Font (AUR)",
        "sub": "Install font packages",
        "icon": "font",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-font-install-aur -- vb-pkg-font-install --aur"
      },
      {
        "type": "separator"
      },
      {
        "type": "action",
        "label": "PWA",
        "sub": "Install web apps",
        "icon": "webapp",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-webapp-install -- vb-webapp-install"
      },
      {
        "type": "action",
        "label": "TUI",
        "sub": "Install terminal apps",
        "icon": "tui",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-tui-install -- vb-tui-install"
      }
    ]
  },
  {
    "id": "remove",
    "label": "Remove",
    "items": [
      {
        "type": "action",
        "label": "Package",
        "sub": "Uninstall packages",
        "icon": "package",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-remove -- vb-pkg-remove"
      },
      {
        "type": "separator"
      },
      {
        "type": "action",
        "label": "Theme",
        "sub": "Uninstall community themes",
        "icon": "theme",
        "call": "themeRemover summon",
        "keepOpen": true
      },
      {
        "type": "action",
        "label": "Font",
        "sub": "Uninstall font packages",
        "icon": "font",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-font-remove -- vb-pkg-font-remove"
      },
      {
        "type": "separator"
      },
      {
        "type": "action",
        "label": "PWA",
        "sub": "Uninstall web apps",
        "icon": "webapp-remove",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-webapp-remove -- vb-webapp-remove"
      },
      {
        "type": "action",
        "label": "TUI",
        "sub": "Uninstall terminal apps",
        "icon": "tui-remove",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-tui-remove -- vb-tui-remove"
      }
    ]
  },
  {
    "id": "update",
    "label": "Update",
    "items": [
      {
        "type": "action",
        "label": "OS",
        "sub": "Update system packages",
        "icon": "archlinux",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-update -- vb-pkg-update"
      },
      {
        "type": "action",
        "label": "AUR",
        "sub": "Update AUR packages",
        "icon": "package-aur",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-update-aur -- vb-pkg-update --aur"
      },
      {
        "type": "separator"
      },
      {
        "type": "action",
        "label": "Themes",
        "sub": "Update community themes",
        "icon": "theme",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-theme-update -- vb-theme-update"
      },
      {
        "type": "action",
        "label": "Vibranium",
        "sub": "Update Vibranium",
        "icon": "github",
        "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-update -- vb-update"
      }
    ]
  },
  {
    "id": "help",
    "label": "Help",
    "items": [
      {
        "type": "action",
        "label": "Hyprland",
        "sub": "Get help with the <b>Hyprland</b> window manager",
        "icon": "hyprland",
        "command": "vb-launch-webapp -- https://wiki.hypr.land"
      },
      {
        "type": "action",
        "label": "Vibranium",
        "sub": "Get help with the <b>Vibranium</b> project",
        "icon": "github",
        "command": "vb-launch-webapp -- https://shvedes.github.io/vibranium"
      },
      {
        "type": "action",
        "label": "Arch Linux",
        "sub": "Get help with the <b>Arch Linux</b> OS",
        "icon": "archlinux",
        "command": "vb-launch-webapp -- https://wiki.archlinux.org"
      },
      {
        "type": "separator"
      },
      {
        "type": "action",
        "label": "Keybindings",
        "sub": "Get help with the current keybindings",
        "icon": "keyboard",
        "call": "keybindings open"
      }
    ]
  }
]
