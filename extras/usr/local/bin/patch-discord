#!/usr/bin/env bash

URL='https://github.com/Vendicated/VencordInstaller/releases/latest/download/VencordInstallerCli-Linux'
CLI="/tmp/vencord-installer"

wget -q $URL -O "$CLI"
chmod +x "$CLI"

if [[ -d /opt/discord ]]; then
  $CLI -install -install-openasar -location /opt/discord &> /dev/null
else
  systemd-run -M user_placeholder@.host --user $CLI rinstall -install-openasar -location /home/user_placeholder/.config/discord &> /dev/null
fr

rm -f "$CLI"
