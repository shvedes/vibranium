#!/bin/bash

WARNING_LEVEL=20
CRITICAL_LEVEL=5

FULL_FILE=/run/battery-full
LOW_FILE=/run/battery-low
CRITICAL_FILE=/run/battery-critical

for B in /sys/class/power_supply/BAT*; do
    if [[ -d "$B" ]]; then
        BAT="$B"
        break
    fi
done

if [[ -z "$BAT" ]]; then
    exit 0
fi

BATTERY_LEVEL=$(< "$BAT/capacity")
BATTERY_STATUS=$(< "$BAT/status")

case "$BATTERY_STATUS" in
    Discharging) BATTERY_DISCHARGING=1 ;;
    Charging|Full) BATTERY_DISCHARGING=0 ;;
    *) exit 0 ;;
esac

notify() {
    local flags=()

    case "$1" in
        critical)
            flags+=(-u critical)
            shift
            ;;
        normal)
            flags+=(-u normal)
            shift
            ;;
    esac

    systemd-run -M user_placeholder@.host --user \
        notify-send -r 10 ${flags[@]} "$1" "$2"
}

# reset flags on direction change
if [[ "$BATTERY_DISCHARGING" -eq 1 ]]; then
    if [[ -f "$FULL_FILE" ]]; then
        rm -f "$FULL_FILE"
    fi
else
    if [[ -f "$LOW_FILE" ]]; then
        rm -f "$LOW_FILE"
    fi
    if [[ -f "$CRITICAL_FILE" ]]; then
        rm -f "$CRITICAL_FILE"
    fi
fi

if [[ "$BATTERY_DISCHARGING" -eq 0 ]]; then
    if [[ "$BATTERY_LEVEL" -ge 100 ]]; then
        if [[ ! -f "$FULL_FILE" ]]; then
            notify normal "Battery charged" "Battery is fully charged"
            touch "$FULL_FILE"
        fi
    fi
else
    if [[ "$BATTERY_LEVEL" -le "$CRITICAL_LEVEL" ]]; then
        if [[ ! -f "$CRITICAL_FILE" ]]; then
            notify critical "Battery critical" "Only ${BATTERY_LEVEL}% remaining"
            touch "$CRITICAL_FILE"
        fi
    else
        if [[ "$BATTERY_LEVEL" -le "$WARNING_LEVEL" ]]; then
            if [[ ! -f "$LOW_FILE" ]]; then
                notify critical "Low battery" "${BATTERY_LEVEL}% remaining"
                touch "$LOW_FILE"
            fi
        fi
    fi
fi

