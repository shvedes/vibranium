#!/usr/bin/env bash

USER="$(loginctl list-sessions --no-legend | awk '$4=="seat0" && $6=="user"{print $3}')"
USER_ID="$(loginctl list-sessions --no-legend | awk '$4=="seat0" && $6=="user"{print $2}')"

export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$USER_ID/bus"

if [[ "$ACTION" == "add" ]]; then
	runuser -l "$USER" -c "notify-send -r 1 \"Vibranium\" \"A bluetooth device has been connected\""
else
	runuser -l "$USER" -c "notify-send -r 1 \"Vibranium\" \"A bluetooth device has been disconnected\""
fi
