#!/usr/bin/env bash

source vb-lib-core
source vb-lib-cfgr

_build() {
  cfgr::item::bool VIBRANIUM_GLOBAL_RESPECT_POWER_PROFILE "Respect power profiles"
  cfgr::item::bool VIBRANIUM_GLOBAL_POWER_PROFILE_USE_FEEDBACK "Notify on change"
}

cfgr::run "Power Profiles" "_build" \
  VIBRANIUM_GLOBAL_RESPECT_POWER_PROFILE \
  VIBRANIUM_GLOBAL_POWER_PROFILE_USE_FEEDBACK
