#!/bin/bash

_on_ac() {
  local supply
  for supply in /sys/class/power_supply/*; do
    [[ "$(< "$supply/type")" == "Mains" ]] || continue
    [[ "$(< "$supply/online")" == "1" ]] && return 0
    return 1
  done
  return 0
}

_set_ac_profile() {
  local profiles=() profile
  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    profiles+=("${profile^}:$profile")
  done < <(vb-core-power --list 2>/dev/null)

  if [[ ${#profiles[@]} -eq 0 ]]; then
    notify-send -r 4 -t 3000 -u critical "Power Profiles" "No profiles available"
    return
  fi

  cfgr::set_string \
    --title "AC Profile" \
    --option "${profiles[@]}" \
    --var VIBRANIUM_GLOBAL_POWER_PROFILE_AC || return

  source "$VIBRANIUM_USER_SETTINGS"

  if _on_ac; then
    local state="$VIBRANIUM_STATE/power-profile" current
    [[ -f "$state" ]] || return
    IFS=: read -r _ current <"$state"

    if [[ "$current" != "$VIBRANIUM_GLOBAL_POWER_PROFILE_AC" ]]; then
      vb-core-power --quiet "$VIBRANIUM_GLOBAL_POWER_PROFILE_AC"
    fi
  fi
}

_set_battery_profile() {
  local profiles=() profile
  while IFS= read -r profile; do
    [[ -n "$profile" ]] || continue
    profiles+=("${profile^}:$profile")
  done < <(vb-core-power --list 2>/dev/null)

  if [[ ${#profiles[@]} -eq 0 ]]; then
    notify-send -r 4 -t 3000 -u critical "Power Profiles" "No profiles available"
    return
  fi

  profiles+=("Last Used:last")

  cfgr::set_string \
    --title "Battery Profile" \
    --option "${profiles[@]}" \
    --var VIBRANIUM_GLOBAL_POWER_PROFILE_BATTERY || return

  source "$VIBRANIUM_USER_SETTINGS"
  if ! _on_ac && [[ "$VIBRANIUM_GLOBAL_POWER_PROFILE_BATTERY" != "last" ]]; then
    local state="$VIBRANIUM_STATE/power-profile" current
    [[ -f "$state" ]] || return
    IFS=: read -r _ current <"$state"

    if [[ "$current" != "$VIBRANIUM_GLOBAL_POWER_PROFILE_BATTERY" ]]; then
      vb-core-power --quiet "$VIBRANIUM_GLOBAL_POWER_PROFILE_BATTERY"
    fi
  fi
}

_build() {
  cfgr::item::raw \
    "On AC power : $VIBRANIUM_GLOBAL_POWER_PROFILE_AC" \
    "action:_set_ac_profile"

  cfgr::item::raw \
    "On battery : $VIBRANIUM_GLOBAL_POWER_PROFILE_BATTERY" \
    "action:_set_battery_profile"
}

cfgr::run "Power Profiles" "_build" \
  VIBRANIUM_GLOBAL_POWER_PROFILE_AC \
  VIBRANIUM_GLOBAL_POWER_PROFILE_BATTERY
