#!/usr/bin/env bash

source vb-lib-core
source vb-lib-cfgr

_build() {
  cfgr::item::bool VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW "Show HEX preview"
  cfgr::item::bool VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR "Prevew in notification"
}

cfgr::run "Color Picker" "_build" \
  VIBRANIUM_COLOR_PICKER_SHOW_SELECTED_COLOR \
  VIBRANIUM_COLOR_PICKER_SHOW_HEX_PREVIEW
