#!/usr/bin/env bash

source vb-lib-core
source vb-lib-cfgr

export PATH="$PATH:$VIBRANIUM/configure"

_edit_cfgs_menu() {
  _open() {
    xdg-terminal-exec -- ${EDITOR:-nvim} "$1"
    helpers::ui::close_menus
  }

  _b() {
    local monitors="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/monitors.conf"
    local rules="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/window-rules.conf"
    local binds="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/binds.conf"
    local input="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/input.conf"

    cfgr::item::action --label "Window Rules" --func "_open $rules"
    cfgr::item::action --label "Keybindings" --func "_open $binds"
    cfgr::item::action --label "Monitors" --func "_open $monitors"
    cfgr::item::action --label "Input" --func "_open $input"
  }
  cfgr::run "Edit Configs" "_b"
}

_build() {
  cfgr::item::action --label "Input" --func "cfgr-wm-input"
  cfgr::item::action --label "Advanced" --func "cfgr-wm-advanced"
  cfgr::item::action --label "Appearance" --func "cfgr-wm-appearance"
  cfgr::item::action --label "Edit Configs" --func "_edit_cfgs_menu"
}

cfgr::run "Hyprland" "_build"
