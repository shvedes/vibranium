#!/bin/bash

source vb-lib-hypr

WAYBAR_CFG="$XDG_CONFIG_HOME/waybar/config.jsonc"

INPUT_SPEC=(
  "input.sensitivity|float"
  "input.accel_profile|str"
  "input.repeat_rate|int"
  "input.repeat_delay|int"
  "input.scroll_factor|float"
  "input.natural_scroll|bool"
  "cursor.inactive_timeout|float"
  "cursor.hide_on_key_press|bool"
  "input.kb_layout|str"
)

TOUCHPAD_SPEC=(
  "input.touchpad.scroll_factor|float"
  "input.touchpad.tap_to_click|bool"
  "input.touchpad.natural_scroll|bool"
  "input.touchpad.disable_while_typing|bool"
)

declare -A KB_GROUPS=(
  [grp:caps_toggle]="Caps Lock"
  [grp:ctrl_alt_toggle]="Ctrl + Alt"
  [grp:win_space_toggle]="Win + Space"
  [grp:alt_space_toggle]="Alt + Space"
  [grp:rshift_toggle]="Right Shift"
  [grp:ctrl_shift_toggle]="Ctrl + Shift"
  [grp:alt_shift_toggle]="Alt + Shift"
  [grp:rctrl_rshift_toggle]="Right Ctrl + Right Shift"
)

_get_layouts() {
  for file in /usr/share/X11/xkb/symbols/??; do
    if [[ "${file##*/}" =~ ^[a-z]{2}$ ]]; then
      echo "${file##*/}"
    fi
  done
}

_set_layout_shortcut() {
  local chosen
  chosen="$(cfgr::set_string --title "Choose Shortcut" --option "${KB_GROUPS[@]}")" || return

  for key in "${!KB_GROUPS[@]}"; do
    if [[ "${KB_GROUPS[$key]}" == "$chosen" ]]; then
      local selected_key="$key"
      break
    fi
  done

  local placeholder="__COLON__"
  hypr::set "input:kb_options" "grp${placeholder}${selected_key#grp:}" "$HYPR_CONF_INPUT"
  sed -i "s/${placeholder}/:/" "$HYPR_CONF_INPUT"
}

_remove_layout() {
  local layouts chosen
  local -a final_layouts=()

  IFS=',' read -r -a layouts < <(hypr::str "input.kb_layout")
  chosen="$(cfgr::set_string --title "Remove Layout" --option "${layouts[@]}")" || return

  for layout in "${layouts[@]}"; do
    if [[ "$layout" != "$chosen" ]]; then
      final_layouts+=("$layout")
    fi
  done

  hypr::set "input:kb_layout" "$(IFS=,; echo "${final_layouts[*]}")" "$HYPR_CONF_INPUT"
  notify-send -r 1 "Vibranium" "Removed keyboard layout: <b>$chosen</b>"

  # If only one layout remains, the bar language indicator is now useless.
  # Check whether the module is present in the config AND currently uncommented;
  # if so, comment it out and reload the bar.
  if (( ${#final_layouts[@]} == 1 )); then
    local cfg_content
    cfg_content=$(<"$WAYBAR_CFG")

    # The module must exist in the file at all (guards against manual removal).
    if [[ "$cfg_content" == *'"hyprland/language"'* ]]; then
      # A line is commented out when it matches: optional whitespace, //, anything,
      # then the module string. If this pattern does NOT match, the module is active.
      if ! [[ $'\n'"$cfg_content" =~ $'\n'[[:space:]]*//[^$'\n']*'"hyprland/language"' ]]; then
        sed -i 's|^\(\s*\)\(.*"hyprland/language".*\)|\1// \2|' "$WAYBAR_CFG"
        systemctl -q --user restart waybar &
      fi
    fi
  fi
}

_add_layout() {
  local layouts chosen
  mapfile -t layouts < <(_get_layouts)

  chosen="$(cfgr::set_string --title "Layouts" --option "${layouts[@]}")" || return

  local active_layouts
  active_layouts="$(hypr::str "input.kb_layout")"

  # Guard against duplicate layout
  local -a current_layouts
  IFS=',' read -r -a current_layouts <<< "$active_layouts"
  for layout in "${current_layouts[@]}"; do
    if [[ "$layout" == "$chosen" ]]; then
      notify-send -r 1 "Vibranium" "Layout <b>${chosen^^}</b> is already active"
      return
    fi
  done

  hypr::set "input:kb_layout" "${active_layouts},${chosen}" "$HYPR_CONF_INPUT"
  notify-send -r 1 "Vibranium" "Added new keyboard layout: <b>${chosen^^}</b>"

  # Count the layouts we now have by splitting the combined string on commas.
  local -a all_layouts
  IFS=',' read -r -a all_layouts <<< "${active_layouts},${chosen}"

  # If there are now multiple layouts and the bar module is still commented out,
  # uncomment it and reload the bar so the language indicator becomes visible.
  if (( ${#all_layouts[@]} > 1 )); then
    local cfg_content
    cfg_content=$(<"$WAYBAR_CFG")

    # Pattern mirrors _check_module from waybar-toggle-modules: a line is
    # considered commented out when it starts with optional whitespace, then //,
    # then contains the module string somewhere on the same line.
    if [[ $'\n'"$cfg_content" =~ $'\n'[[:space:]]*//[^$'\n']*'"hyprland/language"' ]]; then
      sed -i 's|^\(\s*\)//\s*\(.*"hyprland/language".*\)|\1\2|' "$WAYBAR_CFG"
      systemctl -q --user restart waybar &
    fi
  fi
}

_touchpad_menu() {
  _b() {
    hypr::reload
    hypr::fetch "${TOUCHPAD_SPEC[@]}"

    cfgr::item::action \
      --label "Disable while typing : ${HYPR[input.touchpad.disable_while_typing]}" \
      --func "_toggle 'input:touchpad:disable_while_typing'"

    cfgr::item::action \
      --label "Natural scrolling : ${HYPR[input.touchpad.natural_scroll]}" \
      --func "_toggle 'input:touchpad:natural_scroll'"

    cfgr::item::action \
      --label "Scrolling factor : ${HYPR[input.touchpad.scroll_factor]}" \
      --func "_set_int 'Scrolling Factor' 'Factor (float)' float 0.1 30 'input.touchpad.scroll_factor'"

    cfgr::item::action \
      --label "Tap to click : ${HYPR[input.touchpad.tap_to_click]}" \
      --func "_toggle 'input:touchpad:tap_to_click'"
  }
  cfgr::run "Touchpad" "_b"
}

_layouts_menu() {
  _b() {
    hypr::reload

    local str
    str="$(hypr::str "input.kb_options")"
    local shortcut="${KB_GROUPS[$str]:-<i>Unset</i>}"

    cfgr::item::action --label "Add new"                         --func "_add_layout"
    cfgr::item::action --label "Remove existing"                 --func "_remove_layout"
    cfgr::item::action --label "Switch layout with  : $shortcut" --func "_set_layout_shortcut"
  }

  cfgr::run "Keyboard Layouts" "_b"
}

_set_int() {
  local prompt="$1"
  local hint="$2"
  local _type="$3"
  local min="$4"
  local max="$5"
  local path="$6"

  local input
  input="$(cfgr::set_digit \
    --title "$prompt" \
    --hint "$hint" \
    --type "$_type" \
    --min "$min" \
    --max "$max"
  )" || return

  hypr::set "$path" "$input" "$HYPR_CONF_INPUT"
}

_toggle() {
  local path="$1"
  hypr::toggle "$path" "$HYPR_CONF_INPUT"
}

_toggle_accel() {
  if [[ "$ACCEL" == true ]]; then
    hypr::set "input:accel_profile" flat "$HYPR_CONF_INPUT"
  else
    hypr::set "input:accel_profile" adaptive "$HYPR_CONF_INPUT"
  fi
}

_build() {
  hypr::reload
  hypr::fetch "${INPUT_SPEC[@]}"

  # Two options need a derived display value; everything else is used directly
  ACCEL="${HYPR[input.accel_profile]}"
  if [[ "$ACCEL" == "adaptive" ]]; then
    ACCEL=true
  else
    ACCEL=false
  fi

  local cursor_hide="${HYPR[cursor.inactive_timeout]}"

  if [[ "$cursor_hide" == 0* ]]; then
    cursor_hide="never"
  else
    cursor_hide+="s"
  fi

  cfgr::item::action \
    --label "Keyboard repeat delay : ${HYPR[input.repeat_delay]}ms" \
    --func "_set_int 'Repeat Delay' 'Delay (ms)' int 200 1000 'input:repeat_delay'"

  cfgr::item::action \
    --label "Keyboard repeat rate : ${HYPR[input.repeat_rate]}" \
    --func "_set_int 'Repeat rate' 'Rate (int)' int 10 50 'input:repeat_rate'"

  cfgr::item::action \
    --label "Mouse acceleration : $ACCEL" \
    --func "_toggle_accel"

  cfgr::item::action \
    --label "Hide cursor after : ${cursor_hide/.0/}" \
    --func "_set_int 'Hide After' 'Seconds (zero - never)' int 0 86400 'cursor:inactive_timeout'"

  cfgr::item::action \
    --label "Natural scrolling : ${HYPR[input.natural_scroll]}" \
    --func "_toggle 'input:natural_scroll'"

  cfgr::item::action \
    --label "Mouse sensitivity : ${HYPR[input.sensitivity]}" \
    --func "_set_int 'Sensitivity' 'Sensitivity (float)' float -1.0 1.0 'input:sensitivity'"

  cfgr::item::action \
    --label "Hide on key press : ${HYPR[cursor.hide_on_key_press]}" \
    --func "_toggle 'cursor:hide_on_key_press'"

  cfgr::item::action \
    --label "Scrolling factor : ${HYPR[input.scroll_factor]}" \
    --func "_set_int 'Scrolling Factor' 'Factor (float)' float 0.1 10.0 'input:scroll_factor'"

  cfgr::item::action \
    --label "Keyboard layouts : ${HYPR[input.kb_layout]}" \
    --func "_layouts_menu"

  if [[ "$(hyprctl devices)" =~ [Tt]ouchpad ]]; then
    cfgr::item::action \
    --label "Touchpad options" \
    --func "_touchpad_menu"
  fi
}

cfgr::run "Input" "_build"
