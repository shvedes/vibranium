_menu::cursor() {
  _b() {
    hypr::reload
    hypr::fetch "${CURSOR_SPEC[@]}"

    local hw_cursor_display= cpu_buf_display= warp_ws_display= warp_sp_display= no_break_vrr_display=

    case "${HYPR[cursor.no_hardware_cursors]}" in
      0) hw_cursor_display="auto" ;;
      1) hw_cursor_display="always software" ;;
      2) hw_cursor_display="force software" ;;
    esac

    case "${HYPR[cursor.use_cpu_buffer]}" in
      0) cpu_buf_display="auto" ;;
      1) cpu_buf_display="always" ;;
      2) cpu_buf_display="force" ;;
    esac

    case "${HYPR[cursor.warp_on_change_workspace]}" in
      0) warp_ws_display="disabled" ;;
      1) warp_ws_display="enabled" ;;
      2) warp_ws_display="force center" ;;
    esac

    case "${HYPR[cursor.warp_on_toggle_special]}" in
      0) warp_sp_display="disabled" ;;
      1) warp_sp_display="enabled" ;;
      2) warp_sp_display="force center" ;;
    esac

    case "${HYPR[cursor.no_break_fs_vrr]}" in
      0) no_break_vrr_display="disabled" ;;
      1) no_break_vrr_display="enabled" ;;
      2) no_break_vrr_display="force" ;;
    esac

    cfgr::item::action \
      --label "Enable hyprcursor : ${HYPR[cursor.enable_hyprcursor]}" \
      --func "hypr::toggle 'cursor:enable_hyprcursor' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "Sync gsettings theme : ${HYPR[cursor.sync_gsettings_theme]}" \
      --func "hypr::toggle 'cursor:sync_gsettings_theme' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "Hardware cursors : $hw_cursor_display" \
      --func "_set::cursor::no_hardware_cursors"

    cfgr::item::action \
      --label "CPU buffer : $cpu_buf_display" \
      --func "_set::cursor::use_cpu_buffer"

    cfgr::item::action \
      --label "Invisible : ${HYPR[cursor.invisible]}" \
      --func "hypr::toggle 'cursor:invisible' \"$HYPR_CONF_ADVANCED\""

    local timeout="${HYPR[cursor.inactive_timeout]}"
    if [[ "${timeout%.*}" == 0 ]]; then
      timeout="never"
    else
      timeout="${timeout%.*}s"
    fi

    cfgr::item::action \
      --label "Hide after : $timeout" \
      --func "_set::cursor::inactive_timeout"

    cfgr::item::action \
      --label "Hotspot padding : ${HYPR[cursor.hotspot_padding]}px" \
      --func "_set::cursor::hotspot_padding"

    cfgr::item::action \
      --label "Min refresh rate : ${HYPR[cursor.min_refresh_rate]}Hz" \
      --func "_set::cursor::min_refresh_rate"

    cfgr::item::action \
      --label "Hide on key press : ${HYPR[cursor.hide_on_key_press]}" \
      --func "hypr::toggle 'cursor:hide_on_key_press' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "Hide on touch : ${HYPR[cursor.hide_on_touch]}" \
      --func "hypr::toggle 'cursor:hide_on_touch' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "Hide on tablet : ${HYPR[cursor.hide_on_tablet]}" \
      --func "hypr::toggle 'cursor:hide_on_tablet' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "No warps : ${HYPR[cursor.no_warps]}" \
      --func "hypr::toggle 'cursor:no_warps' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "Persistent warps : ${HYPR[cursor.persistent_warps]}" \
      --func "hypr::toggle 'cursor:persistent_warps' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "Warp back after non-mouse input : ${HYPR[cursor.warp_back_after_non_mouse_input]}" \
      --func "hypr::toggle 'cursor:warp_back_after_non_mouse_input' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "Warp on workspace change : $warp_ws_display" \
      --func "_set::cursor::warp_on_change_workspace"

    cfgr::item::action \
      --label "Warp on special toggle : $warp_sp_display" \
      --func "_set::cursor::warp_on_toggle_special"

    cfgr::item::action \
      --label "No break fullscreen VRR : $no_break_vrr_display" \
      --func "_set::cursor::no_break_fs_vrr"

    cfgr::item::action \
      --label "Zoom rigid : ${HYPR[cursor.zoom_rigid]}" \
      --func "hypr::toggle 'cursor:zoom_rigid' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "Zoom detached camera : ${HYPR[cursor.zoom_detached_camera]}" \
      --func "hypr::toggle 'cursor:zoom_detached_camera' \"$HYPR_CONF_ADVANCED\""

    cfgr::item::action \
      --label "Zoom disable anti-aliasing : ${HYPR[cursor.zoom_disable_aa]}" \
      --func "hypr::toggle 'cursor:zoom_disable_aa' \"$HYPR_CONF_ADVANCED\""
  }

  cfgr::run "Cursor" "_b"
}

