#!/usr/bin/env bash

source vb-core-lib
CONFIG="$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.conf"

_layout_submenu() {
  local opts chosen
  opts=("Dwindle" "Master" "Scrolling" "Monocle")

  while true; do
    mapfile -t opts < <(helpers::configure::build_menu "${opts[@]}")
    helpers::ui::menu chosen "Layout" "ESC to go back" -- "${opts[@]}"
    [[ -z "$chosen" ]] && break

    case "$chosen" in
      "Dwindle") vb-cmd-edit-wm-config "general:layout:dwindle" "$CONFIG" ;;
      "Master") vb-cmd-edit-wm-config "general:layout:master" "$CONFIG" ;;
      "Scrolling") vb-cmd-edit-wm-config "general:layout:scrolling" "$CONFIG" ;;
      "Monocle") vb-cmd-edit-wm-config "general:layout:monocle" "$CONFIG" ;;
      *) continue ;;
    esac
    break
  done
}

INDEX=0

while true; do
  hyprctl -q reload config-only

  mapfile -t LINES < <(
    hyprctl --batch -j \
      "getoption misc:vrr; \
         getoption misc:vfr; \
         getoption misc:middle_click_paste; \
         getoption render:direct_scanout; \
         getoption misc:disable_autoreload;
         getoption general:layout; \
         getoption cursor:zoom_detached_camera" |
      jq -s -r '.[] |
        if .option == "misc:vrr" then
            if .int == 0 then "false"
            elif .int == 1 then "true"
            else "fullscreen"
            end
        elif .option == "general:layout" then
            .str
        elif .option == "cursor:zoom_detached_camera" then
            if .int == 1 then false else true end
        else
            if .int == 1 then "true" else "false" end
        end'
  )

  current_vrr="${LINES[0]}"
  current_vfr="${LINES[1]}"
  current_middle_click="${LINES[2]}"
  current_direct_scanout="${LINES[3]}"
  current_autoreload="${LINES[4]}"
  current_layout="${LINES[5]^}"
  current_zoom="${LINES[6]}"

  OPTIONS=(
    "Variable refresh rate : $current_vrr"
    "Zoom follows cursor : $current_zoom"
    "Variable frame rate : $current_vfr"
    "Disable auto reload : $current_autoreload"
    "Middle click paste : $current_middle_click"
    "Direct scanout : $current_direct_scanout"
    "Layout : $current_layout"
  )

  mapfile -t OPTIONS < <(helpers::configure::build_menu "${OPTIONS[@]}")
  helpers::ui::menu CHOSEN "Advanced" "ESC to go back" -selected-row "$INDEX" -- "${OPTIONS[@]}"
  [[ -z "$CHOSEN" ]] && break

  for i in "${!OPTIONS[@]}"; do
    if [ "${OPTIONS[$i]}" = "$CHOSEN" ]; then
      INDEX="$i"
      break
    fi
  done

  case "$CHOSEN" in
    "Layout"*)
      _layout_submenu
      ;;
    "Zoom follows cursor"*)
      case "$current_zoom" in
        "true") vb-cmd-edit-wm-config "cursor:zoom_detached_camera:true" "$CONFIG" ;;
        "false") vb-cmd-edit-wm-config "cursor:zoom_detached_camera:false" "$CONFIG" ;;
      esac
      ;;
    "Disable auto reload"*)
      case "$current_autoreload" in
        "true") vb-cmd-edit-wm-config "misc:disable_autoreload:false" "$CONFIG" ;;
        "false") vb-cmd-edit-wm-config "misc:disable_autoreload:true" "$CONFIG" ;;
      esac
      ;;
    "Middle click paste"*)
      case "$current_middle_click" in
        "true") vb-cmd-edit-wm-config "misc:middle_click_paste:false" "$CONFIG" ;;
        "false") vb-cmd-edit-wm-config "misc:middle_click_paste:true" "$CONFIG" ;;
      esac
      ;;
    "Variable frame rate"*)
      case "$current_vfr" in
        "true") vb-cmd-edit-wm-config "misc:vfr:false" "$CONFIG" ;;
        "false") vb-cmd-edit-wm-config "misc:vfr:true" "$CONFIG" ;;
      esac
      ;;
    "Direct scanout"*)
      case "$current_direct_scanout" in
        "true") vb-cmd-edit-wm-config "render:direct_scanout:false" "$CONFIG" ;;
        "false") vb-cmd-edit-wm-config "render:direct_scanout:true" "$CONFIG" ;;
      esac
      ;;
    "Variable refresh rate"*)
      while true; do
        vrr_opts=("Enable" "Disable" "Fullscreen only" "<b>Help</b>")
        helpers::ui::menu vrr_chosen "VRR" "ESC to go back" -- "${vrr_opts[@]}"
        [[ -z "$vrr_chosen" ]] && break

        case "$vrr_chosen" in
          "Enable") vb-cmd-edit-wm-config "misc:vrr:1" "$CONFIG" ;;
          "Disable") vb-cmd-edit-wm-config "misc:vrr:0" "$CONFIG" ;;
          "Fullscreen only") vb-cmd-edit-wm-config "misc:vrr:2" "$CONFIG" ;;
          *"Help"*)
            vb-cmd-show-help hyprland-vrr
            continue
            ;;
        esac
        break
      done
      ;;
  esac
done
