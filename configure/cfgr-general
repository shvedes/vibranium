#!/usr/bin/env bash

source vb-core-lib

_confirm_kill_submenu() {
    local options confirm_to_kill_chosen
    while true; do
        options=("Confirm to kill : $VIBRANIUM_GLOBAL_CONFIRM_TO_KILL" "<b>Help</b>")
        helpers::ui::menu confirm_to_kill_chosen "Kill Confirm" "ESC to go back" -- "${options[@]}"
        [[ -z "$confirm_to_kill_chosen" ]] && break

        case "$confirm_to_kill_chosen" in
            "Confirm"*)
                helpers::configure::toggle_bool "VIBRANIUM_GLOBAL_CONFIRM_TO_KILL"
                break
                ;;
            *"Help"*)
                vb-cmd-show-help confirm-kill
                ;;
        esac
    done
}

INDEX=0

while true; do
    source "$VIBRANIUM_USER_SETTINGS"

    OPTIONS=(
        "Confirm to kill : $VIBRANIUM_GLOBAL_CONFIRM_TO_KILL"
        "Update channel : $(< "$VIBRANIUM_STATE/update.channel")"
        "OSD enabled : $VIBRANIUM_GLOBAL_USE_OSD"
        "<b>App launcher</b>"
        "<b>Player options</b>"
        # "<b>Power profiles</b>"
    )

    mapfile -t OPTIONS < <(helpers::configure::build_menu "${OPTIONS[@]}")
    helpers::ui::menu CHOSEN "General" "ESC to go back" -selected-row "$INDEX" -- "${OPTIONS[@]}"
    [ -z "$CHOSEN" ] && break

    for i in "${!OPTIONS[@]}"; do
        if [[ "${OPTIONS[$i]}" == "$CHOSEN" ]]; then
            INDEX="$i"
            break
        fi
    done

    case "$CHOSEN" in
        "Update channel"*)
            vb-dev-switch-channel
            ;;
        *"App launcher"*)
            cfgr-launcher
            ;;
        *"Player options"*)
            cfgr-player
            ;;
        *"Power profiles"*)
            cfgr-power-profile
            ;;
        "OSD enabled"*)
            if [[ "$(helpers::configure::toggle_bool -v "VIBRANIUM_GLOBAL_USE_OSD")" == "false" ]]; then
                systemctl --user disable --now swayosd &
            else
                systemctl --user enable --now swayosd &
            fi
            ;;
        "Confirm"*)
            _confirm_kill_submenu
            ;;
    esac
done
