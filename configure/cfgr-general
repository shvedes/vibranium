#!/usr/bin/env bash

source vb-lib-core
source vb-lib-cfgr

# ================================================================================ #

_set_update_channel() {
  local chosen="$(cfgr::set_string "Update Channel" "Release:release" "Upstream:upstream" "Dev:dev")"
  vb-dev-switch-channel "$chosen"
}

_get_update_channel() {
  local state channel
  state="$VIBRANIUM_STATE/update.channel"

  if [[ -f "$state" ]]; then
    channel="$(< "$state")"
    printf "%s" "$channel"
  else
    local branch="$(git -C "$VIBRANIUM" branch --show-current)"
    # Show in menu and update state file
    printf "%s" "$branch" | tee "$state"
  fi
}

_confirm_kill_menu() {
  _build_ckm() {
    cfgr::item::bool VIBRANIUM_GLOBAL_CONFIRM_TO_KILL "Confirm kill"
    cfgr::item::action "vb-cmd-show-help confirm-kill" "Help"
  }

  cfgr::run "Confirm Window Kill" "_build_ckm" VIBRANIUM_GLOBAL_CONFIRM_TO_KILL
}

# ================================================================================ #

_build() {
  local ck="$VIBRANIUM_GLOBAL_CONFIRM_TO_KILL"

  cfgr::item::bool VIBRANIUM_GLOBAL_USE_OSD "OSD enabled"
  cfgr::item::raw "Confirm kill : $ck" "action:_confirm_kill_menu"
  cfgr::item::raw "Update channel : $(_get_update_channel)" "action:_set_update_channel"

  cfgr::item::action "cfgr-launcher" "App launcher"
  cfgr::item::action "cfgr-player" "Mediacontrols"
}

cfgr::run "General" "_build" \
  VIBRANIUM_GLOBAL_CONFIRM_TO_KILL \
  VIBRANIUM_GLOBAL_USE_OSD
