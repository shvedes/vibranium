#!/usr/bin/env bash


# ================================================================================ #

_toggle_osd_service() {
  # Since we're working with outdated value, flip the logic
  if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
    systemctl -q --user disable --now swayosd &
  else
    systemctl -q --user enable --now swayosd &
  fi
}

_set_update_channel() {
  local chosen
  chosen="$(cfgr::set_string \
    --title "Update Channel" \
    --option "Release:release" "Upstream:upstream" "Dev:dev")"
  vb-dev-switch-channel "$chosen"
}

_get_update_channel() {
  local state channel
  state="$VIBRANIUM_STATE/update.channel"

  if [[ -f "$state" ]]; then
    channel="$(<"$state")"
    printf "%s" "${channel^}"
  else
    local branch
    branch="$(git -C "$VIBRANIUM" branch --show-current)"
    printf "%s" "$branch" | tee "$state"
  fi
}

_confirm_kill_menu() {
  _build_ckm() {
    cfgr::item::bool \
      --var VIBRANIUM_GLOBAL_CONFIRM_TO_KILL \
      --label "Confirm kill"

    cfgr::item::action \
      --func "vb-cmd-show-help confirm-kill" \
      --label "Help"
  }

  cfgr::run "Confirm Window Kill" "_build_ckm" VIBRANIUM_GLOBAL_CONFIRM_TO_KILL
}

# ================================================================================ #

_build() {
  local ck="$VIBRANIUM_GLOBAL_CONFIRM_TO_KILL"

  cfgr::item::bool \
    --var VIBRANIUM_GLOBAL_USE_OSD \
    --label "OSD enabled" \
    --hook "_toggle_osd_service"

  cfgr::item::raw "Confirm kill : $ck" "action:_confirm_kill_menu"
  cfgr::item::raw "Update channel : $(_get_update_channel)" "action:_set_update_channel"

  cfgr::item::action \
    --func "cfgr-launcher" \
    --label "App launcher"

  cfgr::item::action \
    --func "cfgr-player" \
    --label "Mediacontrols"
}

cfgr::run "General" "_build" \
  VIBRANIUM_GLOBAL_CONFIRM_TO_KILL \
  VIBRANIUM_GLOBAL_USE_OSD
