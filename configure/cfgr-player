#!/usr/bin/env bash

source vb-lib-core
source vb-lib-cfgr

_build() {
  cfgr::item::string VIBRANIUM_PLAYER_FADE_DURATION_ON_SWITCH "Fade in / out on Next / Previous" \
    "Fade duration" "Very Slow:very_slow" "Slow:slow" "Normal:normal" "Fast:fast" "Very Fast:very_fast" "OFF:off"
  cfgr::item::string VIBRANIUM_PLAYER_FADE_DURATION "Fade in / out on Play / Pause" \
    "Fade duration" "Very Slow:very_slow" "Slow:slow" "Normal:normal" "Fast:fast" "Very Fast:very_fast" "OFF:off"

  cfgr::item::action "vb-cmd-show-help player-fade" "Help"
}

cfgr::run "Media Controls" "_build" \
  VIBRANIUM_PLAYER_FADE_DURATION \
  VIBRANIUM_PLAYER_FADE_DURATION_ON_SWITCH
