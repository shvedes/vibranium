#!/usr/bin/env bash

source vb-lib-core
export PATH="$PATH:$VIBRANIUM/configure"

INDEX=0

while true; do
  OPTIONS=(
    "Idle"
    "Audio"
    "Waybar"
    "General"
    "Set font"
    "Hyprland"
    "Recording"
  )

  if [[ "$CHASSIS_TYPE" != vm ]]; then
    OPTIONS+=(
      "Brightness"
      "Night Light"
    )
  fi

  OPTIONS+=(
    "Screenshots"
    "Color Picker"
    "Miscellaneous"
  )

  helpers::ui::menu CHOSEN "Settings" "ESC to go back" -selected-row "$INDEX" -- "${OPTIONS[@]}"
  helpers::configure::track_index OPTIONS "$CHOSEN" INDEX

  case "$CHOSEN" in
    "") break ;;
    "Waybar") cfgr-waybar-menu ;;
    "Set font") vb-font-set ;;
    "Idle") cfgr-idle ;;
    "Audio") cfgr-audio ;;
    "Screenshots") cfgr-screenshots ;;
    "Brightness") cfgr-brightness ;;
    "Recording") cfgr-recording ;;
    "Night Light") cfgr-nightshift ;;
    "Color Picker") cfgr-color-picker ;;
    "General") cfgr-general ;;
    "Hyprland") cfgr-wm-menu ;;
    "Miscellaneous") cfgr-misc ;;
  esac
done
