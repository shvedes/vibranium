_anim_submenu() {
  _b() {
    hypr::reload

    local chosen active_preset enabled

    enabled="$(hypr::bool "animations.enabled")"

    cfgr::item::action --label "Enabled : $enabled" --func "_toggle 'animations:enabled'"

    if [[ "$enabled" == true ]]; then
      local active_preset
      if [[ -L "$HYPR_CONF_ANIMATIONS" ]]; then
        active_preset="$(readlink "$HYPR_CONF_ANIMATIONS")"

        if [[ $active_preset =~ (vibranium|\.config/hypr/animations) ]]; then
          active_preset="${active_preset##*/}"  # Strip path
          active_preset="${active_preset%.lua}" # Strip extension
          active_preset="${active_preset^}"     # Make the first letter uppercase
        fi
      elif [[ -f "$HYPR_CONF_ANIMATIONS" ]]; then
        active_preset="<span alpha='70%'><i>[user defined]</i></span>"
      elif [[ ! -f "$HYPR_CONF_ANIMATIONS" || ! -L "$HYPR_CONF_ANIMATIONS" ]]; then
        active_preset="<span alpha='70%'><i>[hyprland's default]</i></span>"
      fi

      # If not, then most likely the file is deleted (default hyprland animations),
      # it is not symlinked or the user wrote its own animations curve. Therefore
      # we don't know what's the curve, so show [user defined] value.
      cfgr::item::action --label "Preset : $active_preset" --func "_set_anim_preset"
    fi
  }
  cfgr::run "Animations" "_b"
}

_edit_roundness() {
  local input
  input="$(cfgr::set_digit --title \
    "Border Roundness" --hint "Roundness (int)" \
    --type int --min 0 --max 32
  )" || return

  hypr::set "decoration:rounding" "$input" "$HYPR_CONF_LAF"

  local dunstrc="$XDG_CONFIG_HOME/dunst/dunstrc"
  local lines=() found=0
  local i

  if [[ -f "$dunstrc" ]]; then
    mapfile -t lines < "$dunstrc"

    for i in "${!lines[@]}"; do
      if [[ ${lines[i]} =~ ^corner_radius ]]; then
        lines[i]="corner_radius = $input"
        found=1
      fi

      if [[ ${lines[i]} =~ ^progress_bar_corner_radius ]]; then
        lines[i]="progress_bar_corner_radius = $input"
        found=1
      fi
    done
  fi

  if (( found )); then
    printf '%s\n' "${lines[@]}" > "$dunstrc"
  else
    printf '\n[global]\ncorner_radius = %s\n' "$input" >> "$dunstrc"
  fi

  local rofi_conf="$XDG_CONFIG_HOME/rofi/config.rasi"
  lines=()
  local found=0

  mapfile -t lines < "$rofi_conf"
  for i in "${!lines[@]}"; do
    if [[ ${lines[i]} == *border-radius* ]]; then
      lines[i]=$'\t'"border-radius: ${input}px;"
      found=1
    fi
  done
  if (( found )); then
    printf '%s\n' "${lines[@]}" > "$rofi_conf"
  else
    printf '\nwindow {\n\tborder-radius: %spx;\n}' "$input" >> "$rofi_conf"
  fi

  local swayosd_css="$XDG_CONFIG_HOME/swayosd/style.css"
  lines=()
  found=0
  if [[ -f "$swayosd_css" ]]; then
    mapfile -t lines < "$swayosd_css"
    for i in "${!lines[@]}"; do
      if [[ ${lines[i]} == *border-radius* ]]; then
        lines[i]=$'\t'"border-radius: ${input}px;"
        found=1
      fi
    done
  fi
  if (( found )); then
    printf '%s\n' "${lines[@]}" > "$swayosd_css"
  else
    printf '\nwindow {\n\tborder-radius: %spx;\n}' "$input" >> "$swayosd_css"
  fi

  vb-refresh-dunst &
  helpers::check VIBRANIUM_GLOBAL_USE_OSD
  if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
    systemctl --user restart swayosd &
  fi
}

_set_anim_preset() {
  local folder_defaults="$VIBRANIUM/default/hypr/animations"
  # source() in "$VIBRANIUM/default/hypr/init.lua" recursively sources all
  # .lua files found in the hypr.cond.d. Keeping that folder in there will cause animations override.
  local folder_custom="$XDG_CONFIG_HOME/hypr/animations"
  local chosen f

  # Collect default preset names
  local -a defaults=()
  for f in "$folder_defaults"/*.lua; do
    if [[ ! -f "$f" ]]; then
      continue
    fi

    f="${f##*/}"; defaults+=("${f%.lua}")
  done

  # Collect custom preset names, filtering out any that collide with defaults.
  # Default presets always take priority - shadowed customs are excluded and the user is notified.
  local -a customs=() shadowed=()
  if [[ -d "$folder_custom" ]]; then
    local name def is_shadowed
    for f in "$folder_custom"/*.lua; do
      if [[ ! -f "$f" ]]; then
        continue
      fi

      f="${f##*/}"; name="${f%.lua}"
      is_shadowed=0

      for def in "${defaults[@]}"; do
        if [[ "$name" == "$def" ]]; then
          is_shadowed=1
          break
        fi
      done

      (( is_shadowed )) && shadowed+=("$name") || customs+=("$name")
    done
  fi

  # Notify about shadowed custom presets, if any
  if (( ${#shadowed[@]} )); then
    local shadow_msg="The following custom presets share names with built-in ones and will be ignored:\n"
    for name in "${shadowed[@]}"; do
      shadow_msg+="  • <span foreground='${P_YELLOW}'><b>${name^}</b></span>\n"
    done
    notify-send -r 4 -t 10000 "Animation Preset Conflict" "$shadow_msg"
  fi

  # Build display list: defaults first, then non-colliding customs.
  local -a presets=("${defaults[@]}" "${customs[@]}")
  # First letter capitalized
  local -a display=("${presets[@]^}")

  chosen="$(cfgr::set_string --title "Preset" --option "${display[@]}")" || return

  # Map display name back to filename stem and determine source folder.
  # Defaults always take priority, so check there first.
  local chosen_lower="${chosen,}"
  local source_folder

  if [[ -f "$folder_defaults/${chosen_lower}.lua" ]]; then
    source_folder="$folder_defaults"
  else
    source_folder="$folder_custom"
  fi

  # First, check whether the target file is a symlink (one of the defaults)
  # or a standalone file. If the latter, then backup it first so the user doesn't lose their custom curve.
  #
  # Pay attention to the -f test, not the -L.
  if [[ ! -L "$HYPR_CONF_ANIMATIONS" ]]; then
    # Just in case. Sometimes it's better to be paranoid.
    # Instead of overwriting backup file, create another one with
    # UNIX epoch time prepended to it. $EPOCHSECONDS is a bash's builtin special variable.
    if [[ -f "${HYPR_CONF_ANIMATIONS}.bak" ]]; then
      mv "$HYPR_CONF_ANIMATIONS" "${HYPR_CONF_ANIMATIONS}.bak.$EPOCHSECONDS"
      local backed_up="${HYPR_CONF_ANIMATIONS}.bak.$EPOCHSECONDS"
    else
      mv "$HYPR_CONF_ANIMATIONS" "${HYPR_CONF_ANIMATIONS}.bak"
      local backed_up="${HYPR_CONF_ANIMATIONS}.bak"
    fi

    local msg="Your custom preset "
    msg+="<span foreground='${P_ACCENT}'><b>${HYPR_CONF_ANIMATIONS##*/}</b></span> "
    msg+="has been backed up as:\n"
    msg+="<span foreground='${P_GREEN}'><b>$backed_up</b></span>"

    notify-send -r 3 -t 12000 "Your Animations Preset Has Been Saved" "$msg"
  fi

  ln -sf "$source_folder/${chosen_lower}.lua" "$HYPR_CONF_ANIMATIONS"
}

_set_int() {
  local prompt="$1"
  local hint="$2"
  local _type="$3"
  local min="$4"
  local max="$5"
  local path="$6"

  local input
  input="$(cfgr::set_digit \
    --title "$prompt" \
    --hint "$hint" \
    --type "$_type" \
    --min "$min" \
    --max "$max"
  )" || return

  hypr::set "$path" "$input" "$HYPR_CONF_LAF"
}

_set() {
  local path="$1"
  local value="$2"
  hypr::set "$path" "$value" "$HYPR_CONF_LAF"
}

_toggle() {
  local path="$1"
  hypr::toggle "$path" "$HYPR_CONF_LAF"
}

_build() {
  cfgr::item::action --label "Gaps" --func "_gaps_menu"
  cfgr::item::action --label "Blur" --func "_blur_menu"
  cfgr::item::action --label "Shadows" --func "_shadow_menu"
  cfgr::item::action --label "Decoration" --func "_decoration_menu"
  cfgr::item::action --label "Animations" --func "_anim_submenu"
}

cfgr::run "Appearance" "_build"
