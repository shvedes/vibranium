#!/usr/bin/env bash

source vb-lib-core
source vb-lib-hypr

BLUR_SPEC=(
  "decoration:blur:enabled|bool"
  "decoration:blur:size|int"
  "decoration:blur:passes|int"
  "decoration:blur:contrast|float"
  "decoration:blur:brightness|float"
  "decoration:blur:vibrancy|float"
  "decoration:blur:noise|float"
)

SHADOW_SPEC=(
  "decoration:shadow:enabled|bool"
  "decoration:shadow:render_power|int"
  "decoration:shadow:range|int"
  "decoration:shadow:sharp|bool"
  "decoration:shadow:ignore_window|bool_inv"
)

DECORATION_SPEC=(
  "general:border_size|int"
  "decoration:rounding|int"
  "decoration:rounding_power|float2"
  "decoration:active_opacity|float2"
  "decoration:inactive_opacity|float2"
  "decoration:fullscreen_opacity|float2"
  "decoration:dim_inactive|bool"
  "decoration:dim_strength|float2"
  "decoration:dim_modal|bool"
  "decoration:dim_special|float2"
  "decoration:border_part_of_window|bool"
)

_edit_roundness() {
  local input
  input=$(helpers::configure::set_digit --verify "Border roundness" "Border roundness" "int" 0 16)
  if [[ -z "$input" ]]; then
    return
  fi

  hypr::set "decoration:rounding" "$input" "$HYPR_CONF_LAF"
  sed -i "/corner_radius/s/=.*/= $input/"        "$XDG_CONFIG_HOME/dunst/dunstrc"
  sed -i "/border-radius/s/: .*/: ${input}px;/"  "$XDG_CONFIG_HOME/rofi/config.rasi"
  sed -i "/border-radius/s/: .*/: ${input}px;/"  "$XDG_CONFIG_HOME/swayosd/style.css"
  vb-cmd-refresh-dunst &

  helpers::check VIBRANIUM_GLOBAL_USE_OSD
  if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
    systemctl --user restart swayosd &
  fi
}

_set_animations_preset() {
  local folder="$VIBRANIUM/default/hypr/animations" chosen
  local anim_opts=("$folder"/*.conf)
  anim_opts=("${anim_opts[@]##*/}")
  anim_opts=("${anim_opts[@]%.conf}")
  anim_opts=("${anim_opts[@]^}")

  while true; do
    helpers::ui::menu chosen "Animations" "ESC to go back" -- "${anim_opts[@]}"
    if [[ -z "$chosen" ]]; then
      break
    fi
    ln -sf "$folder/${chosen,}.conf" "$HYPR_CONF_ANIMATIONS"
    hypr::reload
    break
  done
}

_blur_submenu() {
  local index labels chosen input

  while true; do
    hypr::fetch "${BLUR_SPEC[@]}"

    labels=("Enabled : ${HYPR[decoration:blur:enabled]}")
    [[ "${HYPR[decoration:blur:enabled]}" == true ]] && labels+=(
      "Size : ${HYPR[decoration:blur:size]}"
      "Noise : ${HYPR[decoration:blur:noise]}"
      "Passes : ${HYPR[decoration:blur:passes]}"
      "Vibrancy : ${HYPR[decoration:blur:vibrancy]}"
      "Contrast : ${HYPR[decoration:blur:contrast]}"
      "Brightness : ${HYPR[decoration:blur:brightness]}"
    )

    mapfile -t labels < <(helpers::configure::build_menu "${labels[@]}")
    helpers::ui::menu chosen "Blur" "ESC to go back" -selected-row "$index" -- "${labels[@]}"
    helpers::configure::track_index labels "$chosen" index

    case "$chosen" in
      "Enabled"*)
        hypr::toggle "decoration:blur:enabled" "$HYPR_CONF_LAF"
        if [[ "${HYPR[decoration:blur:enabled]}" == true ]]; then
          sed -i '/blur_size/s/ =.*/ = 1/;/blur_passes/s/ =.*/ = 1/' "$HYPRLOCK_CONFIG"
        else
          sed -i '/blur_size/s/ =.*/ = 5/;/blur_passes/s/ =.*/ = 3/' "$HYPRLOCK_CONFIG"
        fi
        ;;
      "Noise"*)      input=$(helpers::configure::set_digit --verify "Blur noise"      "Blur noise"      float 0.0 1.0) && hypr::set "decoration:blur:noise"      "$input" "$HYPR_CONF_LAF" ;;
      "Vibrancy"*)   input=$(helpers::configure::set_digit --verify "Blur vibrancy"   "Blur vibrancy"   float 0.0 1.0) && hypr::set "decoration:blur:vibrancy"   "$input" "$HYPR_CONF_LAF" ;;
      "Brightness"*) input=$(helpers::configure::set_digit --verify "Blur brightness" "Blur brightness" float 0.0 2.0) && hypr::set "decoration:blur:brightness" "$input" "$HYPR_CONF_LAF" ;;
      "Contrast"*)   input=$(helpers::configure::set_digit --verify "Blur contrast"   "Blur contrast"   float 0.0 2.0) && hypr::set "decoration:blur:contrast"   "$input" "$HYPR_CONF_LAF" ;;
      "Size"*)       input=$(helpers::configure::set_digit --verify "Blur size"       "Blur size"       int   1   512) && hypr::set "decoration:blur:size"       "$input" "$HYPR_CONF_LAF" ;;
      "Passes"*)     input=$(helpers::configure::set_digit --verify "Blur passes"     "Blur passes"     int   1    20) && hypr::set "decoration:blur:passes"     "$input" "$HYPR_CONF_LAF" ;;
      "") break ;;
    esac
    hypr::reload
  done
}

_shadow_submenu() {
  local index labels chosen input

  while true; do
    hypr::fetch "${SHADOW_SPEC[@]}"

    labels=("Enabled : ${HYPR[decoration:shadow:enabled]}")
    [[ "${HYPR[decoration:shadow:enabled]}" == true ]] && labels+=(
      "Power : ${HYPR[decoration:shadow:render_power]}"
      "Range : ${HYPR[decoration:shadow:range]}px"
      "Sharp : ${HYPR[decoration:shadow:sharp]}"
      "Behind the window : ${HYPR[decoration:shadow:ignore_window]}"
    )

    mapfile -t labels < <(helpers::configure::build_menu "${labels[@]}")
    helpers::ui::menu chosen "Shadows" "ESC to go back" -selected-row "$index" -- "${labels[@]}"
    helpers::configure::track_index labels "$chosen" index

    case "$chosen" in
      "") break ;;
      "Enabled"*) hypr::toggle     "decoration:shadow:enabled"       "$HYPR_CONF_LAF" ;;
      "Sharp"*)   hypr::toggle     "decoration:shadow:sharp"         "$HYPR_CONF_LAF" ;;
      "Behind"*)  hypr::toggle_inv "decoration:shadow:ignore_window" "$HYPR_CONF_LAF" ;;
      "Power"*)   input=$(helpers::configure::set_digit --verify "Render power" "Render power" int 1 4)   && hypr::set "decoration:shadow:render_power" "$input" "$HYPR_CONF_LAF" ;;
      "Range"*)
        local min=4; [[ "${HYPR[decoration:shadow:sharp]}" == true ]] && min=1
        input=$(helpers::configure::set_digit --verify "Shadow range" "Shadow range" int "$min" 128)
        [[ -n "$input" ]] && hypr::set "decoration:shadow:range" "$input" "$HYPR_CONF_LAF"
        ;;
    esac

    hypr::reload
  done
}

_decoration_submenu() {
  local index labels chosen input

  while true; do
    hypr::fetch "${DECORATION_SPEC[@]}"

    labels=(
      "Border size : ${HYPR[general:border_size]}"
      "Border roundness : ${HYPR[decoration:rounding]}"
      "Rounding power : ${HYPR[decoration:rounding_power]}"
      "Active window opacity : ${HYPR[decoration:active_opacity]}"
      "Inactive window opacity : ${HYPR[decoration:inactive_opacity]}"
      "Fullscreen window opacity : ${HYPR[decoration:fullscreen_opacity]}"
      "Dim inactive window : ${HYPR[decoration:dim_inactive]}"
    )

    if [[ "${HYPR[decoration:dim_inactive]}" == true ]]; then
      if [[ "${HYPR[decoration:dim_modal]}" == true ]]; then
        labels+=("Dim strength : ${HYPR[decoration:dim_strength]}")
      fi
    fi

    labels+=(
      "Dim modal windows : ${HYPR[decoration:dim_modal]}"
      "Dim special workspace : ${HYPR[decoration:dim_special]}"
      "Border part of window : ${HYPR[decoration:border_part_of_window]}"
    )

    mapfile -t labels < <(helpers::configure::build_menu "${labels[@]}")
    helpers::ui::menu chosen "Decoration" "ESC to go back" -selected-row "$index" -- "${labels[@]}"
    helpers::configure::track_index labels "$chosen" index

    case "$chosen" in
      "") break ;;
      "Border size"*)               input=$(helpers::configure::set_digit --verify "Border size"         "Border size"         int   0   24) && hypr::set "general:border_size"             "$input" "$HYPR_CONF_LAF" ;;
      "Border roundness"*)          _edit_roundness ;;
      "Rounding power"*)            input=$(helpers::configure::set_digit --verify "Rounding power"      "Rounding power"      float 1.0 10.0) && hypr::set "decoration:rounding_power"     "$input" "$HYPR_CONF_LAF" ;;
      "Active window opacity"*)     input=$(helpers::configure::set_digit --verify "Active opacity"      "Active opacity"      float 0.0  1.0) && hypr::set "decoration:active_opacity"     "$input" "$HYPR_CONF_LAF" ;;
      "Inactive window opacity"*)   input=$(helpers::configure::set_digit --verify "Inactive opacity"    "Inactive opacity"    float 0.0  1.0) && hypr::set "decoration:inactive_opacity"   "$input" "$HYPR_CONF_LAF" ;;
      "Fullscreen window opacity"*) input=$(helpers::configure::set_digit --verify "Fullscreen opacity"  "Fullscreen opacity"  float 0.0  1.0) && hypr::set "decoration:fullscreen_opacity" "$input" "$HYPR_CONF_LAF" ;;
      "Dim inactive window"*)       hypr::toggle "decoration:dim_inactive"          "$HYPR_CONF_LAF" ;;
      "Dim modal windows"*)         hypr::toggle "decoration:dim_modal"             "$HYPR_CONF_LAF" ;;
      "Dim special workspace"*)     input=$(helpers::configure::set_digit --verify "Dim special"         "Dim special"         float 0.0  1.0) && hypr::set "decoration:dim_special"        "$input" "$HYPR_CONF_LAF" ;;
      "Dim strength"*)              input=$(helpers::configure::set_digit --verify "Dim strength"        "Dim strength"        float 0.0  1.0) && hypr::set "decoration:dim_strength"       "$input" "$HYPR_CONF_LAF" ;;
      "Border part of window"*)     hypr::toggle "decoration:border_part_of_window" "$HYPR_CONF_LAF" ;;
    esac
    hypr::reload
  done
}

_animations_submenu() {
  local opts chosen enabled anim_preset

  while true; do
    hypr::reload
    # animations:enabled is a single option — fine to read directly
    enabled=$(hypr::int "animations:enabled")
    [[ "$enabled" == 1 ]] && enabled=true || enabled=false

    anim_preset=$(readlink "$HYPR_CONF_ANIMATIONS")
    anim_preset="${anim_preset##*/}"; anim_preset="${anim_preset%.conf}"

    opts=("Enabled : $enabled")
    [[ "$enabled" == true ]] && opts+=("Preset : ${anim_preset^}")

    mapfile -t opts < <(helpers::configure::build_menu "${opts[@]}")
    helpers::ui::menu chosen "Animations" "ESC to go back" -- "${opts[@]}"

    case "$chosen" in
      "Enabled"*) vb-cmd-toggle-animations --quiet ;;
      "Preset"*)  _set_animations_preset ;;
      "") break ;;
    esac
  done
}

GAPS_SPEC=(
  "general:gaps_in|int"
  "general:gaps_out|int"
)

_gaps_submenu() {
  local index opts chosen input smartgaps_enabled

  while true; do
    [[ -f "$HYPR_CONF_SMARTGAPS" ]] && smartgaps_enabled=true || smartgaps_enabled=false

    # gaps return their value via .custom, not .int — read directly
    mapfile -t _v < <(
      hyprctl --batch -j "getoption general:gaps_in; getoption general:gaps_out" |
      jq -r '.custom | split(" ")[0]'
    )
    local gaps_in="${_v[0]}" gaps_out="${_v[1]}"

    opts=(
      "Inner gaps : $gaps_in"
      "Outer gaps : $gaps_out"
    )
    (( gaps_in != 0 && gaps_out != 0 )) && opts+=("Smart gaps : $smartgaps_enabled")

    mapfile -t opts < <(helpers::configure::build_menu "${opts[@]}")
    helpers::ui::menu chosen "Gaps" "ESC to go back" -selected-row "$index" -- "${opts[@]}"
    helpers::configure::track_index opts "$chosen" index

    case "$chosen" in
      "Inner gaps"*) input=$(helpers::configure::set_digit --verify "Inner gaps" "Inner gaps" int 0 50) && hypr::set "general:gaps_in"  "$input" "$HYPR_CONF_LAF" ;;
      "Outer gaps"*) input=$(helpers::configure::set_digit --verify "Outer gaps" "Outer gaps" int 0 50) && hypr::set "general:gaps_out" "$input" "$HYPR_CONF_LAF" ;;
      "Smart gaps"*) vb-cmd-toggle-smart-gaps ;;
      "") break ;;
    esac
    hypr::reload
  done
}

INDEX=0

while true; do
  OPTIONS=("<b>Blur</b>" "<b>Gaps</b>" "<b>Shadows</b>" "<b>Decoration</b>" "<b>Animations</b>")

  mapfile -t OPTIONS < <(helpers::configure::build_menu "${OPTIONS[@]}")
  helpers::ui::menu CHOSEN "Look & Feel" "ESC to go back" -selected-row "$INDEX" -- "${OPTIONS[@]}"
  helpers::configure::track_index OPTIONS "$CHOSEN" INDEX

  case "$CHOSEN" in
    *"Blur"*)       _blur_submenu ;;
    *"Shadows"*)    _shadow_submenu ;;
    *"Decoration"*) _decoration_submenu ;;
    *"Animations"*) _animations_submenu ;;
    *"Gaps"*)       _gaps_submenu ;;
    "") break ;;
  esac
done
