    hypr::reload

    cfgr::item::action \
      --label "Enabled : ${HYPR[decoration.glow.enabled]}" \
      --func "_toggle" "decoration:glow:enabled"

    cfgr::item::action \
      --label "Range : ${HYPR[decoration.glow.range]}px" \
      --func "_set_int 'Glow Range' 'Glow Range (int)' int 1 50 'decoration:glow:range'"

    cfgr::item::action \
      --label "Render Power : ${HYPR[decoration.glow.render_power]}px" \
      --func "_set_int 'Render Power' 'Render Power (int)' int 1 50 'decoration:glow:render_power'"
