  cfgr::run "Glow" "_b"
}

# ================================================================================ #

_edit_roundness() {
  local input
  input="$(cfgr::set_digit --title \
    "Border Roundness" --hint "Roundness (int)" \
    --type int --min 0 --max 32
  )" || return

  hypr::set "decoration:rounding" "$input" "$HYPR_CONF_LAF"

  # Ignore error outputs in case if the user changed these configs

  sed -i "/corner_radius/s/=.*/= $input/"        "$XDG_CONFIG_HOME/dunst/dunstrc" 2>/dev/null
  sed -i "/border-radius/s/: .*/: ${input}px;/"  "$XDG_CONFIG_HOME/rofi/config.rasi" 2>/dev/null
  sed -i "/border-radius/s/: .*/: ${input}px;/"  "$XDG_CONFIG_HOME/swayosd/style.css" 2>/dev/null

  if ! grep -Pqzo '\*\s*\{[^}]*border-radius\s*:' "$XDG_CONFIG_HOME/gtk-3.0/gtk.css"; then
    printf '* {\n\tborder-radius: %s;\n}\n' "$input" >> "$XDG_CONFIG_HOME/gtk-3.0/gtk.css"
  else
    sed -i '/\*\s*{/,/}/ s/border-radius\s*:\s*[^;]*/border-radius: '"$input"'/' \
      "$XDG_CONFIG_HOME/gtk-3.0/gtk.css"
  fi

  vb-refresh-dunst &

  helpers::check VIBRANIUM_GLOBAL_USE_OSD
  if [[ "$VIBRANIUM_GLOBAL_USE_OSD" == true ]]; then
    systemctl --user restart swayosd &
  fi
}

_set_anim_preset() {
  local folder="$VIBRANIUM/default/hypr/animations" chosen
  local presets=("$folder"/*.lua)

  presets=("${presets[@]##*/}")
  presets=("${presets[@]%.lua}")
  presets=("${presets[@]^}")

  local chosen
  chosen="$(cfgr::set_string --title "Preset" --option "${presets[@]}")" || return

  ln -sf "$folder/${chosen,}.lua" "$HYPR_CONF_ANIMATIONS"
}

# ================================================================================ #

_set_int() {
  local prompt="$1"
  local hint="$2"
  local _type="$3"
  local min="$4"
  local max="$5"
  local path="$6"

  local input
  input="$(cfgr::set_digit \
    --title "$prompt" \
    --hint "$hint" \
    --type "$_type" \
    --min "$min" \
    --max "$max"
  )" || return

  hypr::set "$path" "$input" "$HYPR_CONF_LAF"
}

_set() {
  local path="$1"
  local value="$2"
  hypr::set "$path" "$value" "$HYPR_CONF_LAF"
}

_toggle() {
  local path="$1"
  hypr::toggle "$path" "$HYPR_CONF_LAF"
}

# ================================================================================ #

_build() {
  cfgr::item::action --label "Gaps" --func "_gaps_menu"
  cfgr::item::action --label "Blur" --func "_blur_menu"
  cfgr::item::action --label "Glow" --func "_glow_submenu"
  cfgr::item::action --label "Shadows" --func "_shadow_menu"
  cfgr::item::action --label "Decoration" --func "_decoration_menu"
  cfgr::item::action --label "Animations" --func "_anim_submenu"
}

cfgr::run "Appearance" "_build"
