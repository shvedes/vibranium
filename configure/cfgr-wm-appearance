#!/usr/bin/env bash

source vb-lib-core
source vb-lib-cfgr
source vb-lib-hypr

GLOW_SPEC=(
  "decoration.glow.enabeld|bool"
  "decoration.glow.range|int"
  "decoration.glow.render_power|int"
  # Soon
  # "decoration.glow.color|color"
  # "decoration.glow.color_inactive|color"
)

BLUR_SPEC=(
  "decoration.blur.enabled|bool"
  "decoration.blur.size|int"
  "decoration.blur.passes|int"
  "decoration.blur.contrast|float"
  "decoration.blur.brightness|float"
  "decoration.blur.vibrancy|float"
  "decoration.blur.noise|float"
)

SHADOW_SPEC=(
  "decoration.shadow.enabled|bool"
  "decoration.shadow.render_power|int"
  "decoration.shadow.range|int"
  "decoration.shadow.sharp|bool"
)

DECORATION_SPEC=(
  "general.border_size|int"
  "decoration.rounding|int"
  "decoration.rounding_power|float"
  "decoration.active_opacity|float"
  "decoration.inactive_opacity|float"
  "decoration.fullscreen_opacity|float"
  "decoration.dim_inactive|bool"
  "decoration.dim_strength|float"
  "decoration.dim_modal|bool"
  "decoration.dim_special|float"
  "decoration.border_part_of_window|bool"
