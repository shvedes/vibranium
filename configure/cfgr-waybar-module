_updates_weather_menu() {
  _update() {
    vb-cmd-refresh-bar-module pacman &
    vb-cmd-refresh-bar-module weather &
  }

  _u_w_build() {
    cfgr::item::bool VIBRANIUM_BAR_SHOW_ANIMATION "Animate first launch"
    cfgr::item::bool VIBRANIUM_BAR_SHOW_SEPARATOR "Show separators" "_update"
  }

  cfgr::run "Updates & Weather" "_u_w_build" \
    VIBRANIUM_BAR_SHOW_ANIMATION \
    VIBRANIUM_BAR_SHOW_SEPARATOR
}

_updates_menu() {
  _u_build() {
    cfgr::item::bool VIBRANIUM_BAR_PACMAN_MODULE_SHOW_ZERO_UPDATES \
      "Display when up to date" "vb-cmd-refresh-bar-module pacman &"
  }
  cfgr::run "Updates" "_u_build" VIBRANIUM_BAR_PACMAN_MODULE_SHOW_ZERO_UPDATES
}

_build() {
  cfgr::item::action "_updates_weather_menu" "Updates / Weather specific"
  cfgr::item::action "_updates_menu" "Updates"
}

cfgr::run "Modules" "_build"
