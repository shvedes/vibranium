#!/usr/bin/env bash

source vb-core-lib

INDEX=0

_update_timeout() {
    local index="$1"   # 1 = lock, 2 = sleep
    local seconds="$2"
    local config="$XDG_CONFIG_HOME/hypr/hypridle.conf"

    local timeouts
    timeouts=($(_get_timeouts))

    timeouts[$((index-1))]="$seconds"

    awk -v lock="${timeouts[0]}" -v sleep="${timeouts[1]}" '
        /^\s*listener\s*{/{f=1; print; next}
        /^\s*}/{f=0; print; next}
        f && /^\s*timeout\s*=/ {
            if (c==0) {print "    timeout = " lock; c++}
            else {print "    timeout = " sleep}
            next
        }
        {print}
    ' "$config" > "$config.tmp" && mv "$config.tmp" "$config"
}

_set_timeouts() {
    local title="$1"          # "Lock" / "Sleep"
    local prompt="$2"         # prompt text
    local timer_index="$3"    # 1 = lock, 2 = sleep
    local min_value="$4"      # empty or lock_timeout

    while true; do
        input="$(printf "%s\n" "$prompt" | helpers::ui::menu "$title timeout" "in minutes")"
        [ -z "$input" ] && break
        [ "$input" = "$prompt" ] && continue

        [[ ! "$input" =~ ^[0-9]+$ ]] && {
            notify-send -r 6 -u critical -t 1500 "Vibranium" "Only integers allowed!"
            continue
        }

        if [[ -n "$min_value" ]] && (( input <= min_value )); then
            notify-send -r 6 -u critical -t 3000 "Vibranium" \
                "$title timeout must be greater than $min_value!"
            continue
        fi

        _update_timeout "$timer_index" $((input * 60))
        systemctl --user restart hypridle &
        break
    done
}

_get_timeouts() {
    local config
    config="$XDG_CONFIG_HOME/hypr/hypridle.conf"

    awk '
        /^\s*listener\s*{/{f=1; next}
        /^\s*}/{f=0; next}
        f && /^\s*timeout\s*=/ {
            match($0, /timeout\s*=\s*([0-9]+)/, a)
            print a[1]
        }
    ' "$config"
}

while true; do
    source "$VIBRANIUM_USER_SETTINGS"

    mapfile -t TIMEOUTS < <(_get_timeouts)

    LOCK_TIMEOUT="${TIMEOUTS[0]}"
    SLEEP_TIMEOUT="${TIMEOUTS[1]}"

    LOCK_TIMEOUT=$((LOCK_TIMEOUT / 60))
    SLEEP_TIMEOUT=$((SLEEP_TIMEOUT / 60))

    helpers::check::strings VIBRANIUM_GLOBAL_INHIBIT_TYPE idle "sleep" "idle"
    INHIBIT_TYPE="$VIBRANIUM_GLOBAL_INHIBIT_TYPE"

    OPTIONS=(
        "Lock  after : $LOCK_TIMEOUT min"
        "Sleep after : $SLEEP_TIMEOUT min"
        "Inhibit type : $INHIBIT_TYPE"
        "What is this?"
    )

    mapfile -t OPTIONS < <(helpers::configure::build_menu "${OPTIONS[@]}")
    CHOSEN="$(printf "%s\n" "${OPTIONS[@]}" | helpers::ui::menu "Idle" "ESC to go back" -selected-row "$INDEX")"
    [ -z "$CHOSEN" ] && break

    for i in "${!OPTIONS[@]}"; do
        if [ "${OPTIONS[$i]}" = "$CHOSEN" ]; then
            INDEX="$i"
            break
        fi
    done

    case "$CHOSEN" in
        *"Inhibit"*)
            helpers::configure::set_string VIBRANIUM_GLOBAL_INHIBIT_TYPE "Sleep type" idle sleep
            ;;
        "Lock"*)
            _set_timeouts "Lock" "Lock timeout (int)" 1
            ;;
        "Sleep"*)
            _set_timeouts "Sleep" "Sleep timeout (int)" 2 "$LOCK_TIMEOUT"
            ;;
        "What"*)
            msg="<span foreground='${P_ACCENT}'><b>•</b></span> "
            msg+="<b>Time of inactivity until screen lock</b>\n"
            msg+="<span foreground='${P_ACCENT}'><b>•</b></span> "
            msg+="<b>Time of inactivity before the system sleeps</b>\n\n"

            msg+="<b>Inhibit types:</b>\n"

            msg+="<span foreground='${P_ACCENT}'><b>sleep</b></span> — "
            msg+="The session may lock normally, but the PC is prevented from going to sleep\n"

            msg+="<span foreground='${P_ACCENT}'><b>idle</b></span> — "
            msg+="The system thinks you are active, so automatic locking does not trigger"

            notify-send -r 6 -t 15000 "What is this?" "$msg"
            ;;
    esac
done

