[global]
format      = "<span foreground='#75b9a4' size='10000'><b>%s</b></span>\n%b"
background  = "#111c18"
foreground  = "#d3d5b4"
frame_color = "#75b9a4"
highlight   = "#75b9a4"

[urgency_low]
background  = "#111c18"
foreground  = "#d3d5b4"
frame_color = "#75b9a4"
highlight   = "#75b9a4"

[urgency_critical]
background  = "#111c18"
foreground  = "#d3d5b4"
frame_color = "#970808"
highlight   = "#75b9a4"
# Disable timeout for urgent notifications
timeout     = 0

