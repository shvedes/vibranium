[global]
format      = "<span foreground='#75b9a4' size='10000'><b>%s</b></span>\n%b"
background  = "#111c18"
foreground  = "#e4e5d1"
frame_color = "#75b9a4"
highlight   = "#75b9a4"

[urgency_low]
background  = "#111c18"
foreground  = "#e4e5d1"
frame_color = "#75b9a4"
highlight   = "#75b9a4"

[urgency_critical]
background  = "#111c18"
foreground  = "#e4e5d1"
frame_color = "#b04531"
highlight   = "#75b9a4"
# Disable timeout for urgent notifications
timeout     = 0

