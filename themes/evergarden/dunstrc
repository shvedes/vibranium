[global]
format      = "<span foreground='#b3d491' size='10000'><b>%s</b></span>\n%b"
background  = "#1c2225"
foreground  = "#f3f4ec"
frame_color = "#8ba0a7"
highlight   = "#8ba0a7"

[urgency_low]
background  = "#1c2225"
foreground  = "#f3f4ec"
frame_color = "#8ba0a7"
highlight   = "#8ba0a7"

[urgency_critical]
background  = "#1c2225"
foreground  = "#f3f4ec"
frame_color = "#f57f82"
highlight   = "#8ba0a7"
# Disable timeout for urgent notifications
timeout     = 0

# vim:ft=cfg
