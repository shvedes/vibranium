[global]
format      = "<span foreground='#d08b01' size='10000'><b>%s</b></span>\n%b"
background  = "#0f0f0f"
foreground  = "#ded4c4"
frame_color = "#d08b01cc"
highlight   = "#d08b01"

[urgency_low]
background  = "#0f0f0f"
foreground  = "#ded4c4"
frame_color = "#d08b01cc"
highlight   = "#d08b01"

[urgency_critical]
background  = "#0f0f0f"
foreground  = "#ded4c4"
frame_color = "#7e0100"
highlight   = "#d08b01"
# Disable timeout for urgent notifications
timeout     = 0

