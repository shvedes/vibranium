[global]
format      = "<span foreground='#9eb7ed' size='10000'><b>%s</b></span>\n%b"
background  = "#303446"
foreground  = "#c6d0f5"
frame_color = "#737994"
highlight   = "#9eb7ed"

[urgency_low]
background  = "#303446"
foreground  = "#c6d0f5"
frame_color = "#737994"
highlight   = "#9eb7ed"

[urgency_critical]
background  = "#303446"
foreground  = "#c6d0f5"
frame_color = "#f38ba8"
highlight   = "#9eb7ed"
# Disable timeout for urgent notifications
timeout     = 0

