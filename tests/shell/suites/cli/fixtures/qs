#!/usr/bin/env python3
"""Fake `qs` for the vb-shell CLI suite.

It records every argv word exactly (as JSON) and answers the two transport
verbs with canned `v1:` frames. The mode comes from FAKE_QS_MODE, so a test
can exercise a failure without changing the client under test.
"""
import json
import os
import sys
import time

args = sys.argv[1:]
log = os.environ.get("FAKE_QS_LOG", "")
if log:
    with open(log, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({
            "argv": args,
            "badenv": [k for k in ("QS_CONFIG_PATH", "QS_CONFIG_NAME", "QS_MANIFEST") if k in os.environ],
        }, ensure_ascii=True, separators=(",", ":")) + "\n")

mode = os.environ.get("FAKE_QS_MODE", "ok")
try:
    _early = json.loads(args[6][3:]) if len(args) > 6 and args[6].startswith("v1:") else {}
except ValueError:
    _early = {}
argv = _early.get("argv", [])


def emit(frame):
    sys.stdout.write("v1:" + json.dumps(frame, ensure_ascii=True, separators=(",", ":")) + "\n")
    return 0


def err(code, message=None):
    return emit({"v": 1, "ok": False, "error": {"code": code, "message": message or code}})


def data(value, fmt=None):
    return emit({"v": 1, "ok": True, "data": value, "format": fmt or {"kind": "text"}})


def page(items, meta=None, cursor=None):
    payload = {"items": items}
    if meta is not None:
        payload["meta"] = meta
    frame = {"v": 1, "ok": True, "data": payload}
    if cursor:
        frame["next"] = {"cursor": cursor}
    return emit(frame)


if mode == "timeout":
    time.sleep(5)
    return_code = 0
    sys.exit(return_code)

