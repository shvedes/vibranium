        sys.stdout.write("garbage\n")
    elif verb == "help":
        sys.stdout.write("vibranium log\n\na scope is derived from the file the call was written in.\n")
    else:
        sys.stdout.write('{"level":"info","scopes":[]}\n')
    sys.exit(0)

