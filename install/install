#!/usr/bin/env bash

if [[ "$(id -u)" == 0 ]]; then
  echo "Do not run this script as root!" >&2
  exit 1
fi

# ========================================================================================== #

EXPECTED_PATH="$HOME/.local/share/vibranium/install"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &> /dev/null && pwd)

if [[ "$SCRIPT_DIR" != "$EXPECTED_PATH" ]]; then
  echo "ERROR: This script must be run from $EXPECTED_PATH" >&2
  echo "Current location: $SCRIPT_DIR" >&2
  echo "Please move the vibranium folder to ~/.local/share/vibranium and try again" >&2
  exit 1
fi

export CHASSIS_TYPE="$(hostnamectl chassis)"
export VIBRANIUM="$HOME/.local/share/vibranium"
export PATH="$PATH:$VIBRANIUM/bin"

# ========================================== #

source vb-core-lib &> /dev/null

export -f term::discard_buffer
export -f term::disable_input
export -f term::enable_input
export -f term::show_header
export -f term::ask_yes_no

export PURPLE GREEN CYAN
export RED YELLOW BLUE
export GRAY RESET

SUDO_PROMPT="$(printf '%s[SUDO]%s Password for %s: ' "$RED" "$RESET" "$USER")"
export SUDO_PROMPT

# Source helpers
for helper in "$SCRIPT_DIR/helpers"/*.sh; do
  source "$helper"
done

# ========================================== #

touch /tmp/vb-install-ongoing

exec < /dev/tty

# Clear TTY and move prompt
# to the bottom
clear
tput cup 9999 0

term::disable_input
term::show_header

_log_info "Welcome to ${CYAN}Vibranium${RESET}, an ${GREEN}Omarchy${RESET}-like ${CYAN}Arch Linux${RESET} configuration."
_log_info "It is designed to be simple, extremely fast, and highly customizable."
_log_info ""
_log_info "This installer will directly modify system files, install packages,"
_log_info "change configuration across the system, and tune everything"
_log_info "specifically for your hardware."
_log_info ""
_log_info "In addition to performing automatic tasks, the installer will also ask you"
_log_info "a number of yes/no questions to tailor your installation to your needs."
_log_info ""
_log_info "${YELLOW}WARNING${RESET}: This installer creates ${RED}NO${RESET} backups."
_log_info "Existing configuration files may be overwritten without notice."
_log_info ""
_log_info "Vibranium is ${RED}NOT${RESET} intended to be installed on an existing system."
_log_info "Running it on a system that already contains data, custom configs,"
_log_info "or another setup may break your environment or cause data loss."
_log_info ""
_log_info "Only proceed if this is a fresh Arch Linux installation created"
_log_info "manually or with archinstall."
_log_info ""
_log_info "If you are unsure, ${RED}STOP${RESET} now and create a clean installation first."

if term::ask_yes_no Y "Proceed with Installation?"; then
  if ! term::ask_yes_no Y "Proceed with Installation? (double check)"; then
    _log_error "Installation aborted"
    exit 1
  fi
else
  _log_error "Installation aborted"
  exit 1
fi

# ========================================== #

if ! sudo -v; then
  _log_error "Installation aborted"
  exit 1
fi

(
  while true; do
    sudo -v
    sleep 5
  done
) &

if ! pacman -Qq "yay" &> /dev/null; then
  _log_info "Installing AUR helper"

  if ! InstallYay; then
    _log_error "Failed to install AUR helper"
    _log_error "Aborting installation"
    exit 1
  fi
fi

echo -e "${YELLOW}[INFO]${RESET} Setting up system and configs"
for script in "$SCRIPT_DIR/config"/*.sh; do
  bash "$script"
done

echo -e "${YELLOW}[INFO]${RESET} Initializing package installation"
for script in "$SCRIPT_DIR/packaging"/*.sh; do
  yay --noconfirm -Sy &> /dev/null
  bash "$script"
done

echo -e "${YELLOW}[INFO]${RESET} Setting up hardware"
for script in "$SCRIPT_DIR/config/hardware"/*.sh; do
  bash "$script"
done

echo -e "${YELLOW}[INFO]${RESET} Basic installation complete"
echo -e "${YELLOW}[INFO]${RESET} Executing post-install hooks..."
for script in "$SCRIPT_DIR/post-install"/*.sh; do
  bash "$script"
done

# Clear TTY and move prompt
# to the bottom
clear
tput cup 9999 0

term::show_header --color green

_log_success "Installation complete. System restart required"
_log_success "You have to pick Hyprland (uwsm-managed) in the login manager"
_log_success "Otherwise Vibranium will NOT WORK"

if term::ask_yes_no Y "Reboot now?"; then
  rm -f /tmp/vb-install-ongoing
  for sec in {5..1}; do
    for step in {0..3}; do
      dots=$(printf "%.*s" "$step" "...")
      printf "\r\033[K%s[VIBRANIUM]%s Restarting in %d%s" \
        "$GREEN" "$RESET" "$sec" "$dots"
      sleep 0.25
    done
  done

  systemctl reboot
fi

rm -f /tmp/vb-install-ongoing
term::enable_input
