#!/usr/bin/env bash

if [[ "$(id -u)" == 0 ]]; then
  echo "Do not run this script as root!" >&2
  exit 1
fi

# ========================================================================================== #

EXPECTED_PATH="$HOME/.local/share/vibranium/install"
SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" &>/dev/null && pwd)

if [[ "$SCRIPT_DIR" != "$EXPECTED_PATH" ]]; then
  echo "ERROR: This script must be run from $EXPECTED_PATH" >&2
  echo "Current location: $SCRIPT_DIR" >&2
  echo "Please move the vibranium folder to ~/.local/share/vibranium and try again" >&2
  exit 1
fi

export CHASSIS_TYPE="$(hostnamectl chassis)"
export VIBRANIUM="$HOME/.local/share/vibranium"
export VIBRANIUM_PATH="$VIBRANIUM/bin"
export PATH="$PATH:$VIBRANIUM_PATH"

# ========================================== #

# Set log file before sourcing helpers so exported functions can reference it.
export _LOG_FILE="$HOME/vibranium-install.log"

{
  printf '=== Vibranium Installation Log ===\n'
  printf 'Date    : %s\n' "$(date)"
  printf 'User    : %s\n' "$USER"
  printf 'Host    : %s\n' "$(hostname)"
  printf 'Chassis : %s\n' "$CHASSIS_TYPE"
  printf '==================================\n\n'
} > "$_LOG_FILE"

# ========================================== #

source vb-lib-core &>/dev/null

export -f term::discard_buffer
export -f term::disable_input
export -f term::enable_input
export -f term::show_header
export -f term::ask_yes_no

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CONFIG_HOME="$HOME/.config"
export XDG_CACHE_HOME="$HOME/.cache"

export PURPLE GREEN CYAN
export RED YELLOW BLUE
export GRAY RESET

SUDO_PROMPT="$(printf '%s[SUDO]%s Password for %s: ' "$RED" "$RESET" "$USER")"
export SUDO_PROMPT

# Source helpers
for helper in "$SCRIPT_DIR/helpers"/*.sh; do
  source "$helper"
done

# And their functions
export -f helpers::log::info
export -f helpers::log::warn
export -f helpers::log::error
export -f helpers::log::phase
export -f helpers::log::success

export -f helpers::_needs_sudo
export -f helpers::_sudo_for
export -f helpers::_resolve_backup_path
export -f helpers::backup_path
export -f helpers::write_file
export -f helpers::copy
export -f helpers::symlink
export -f helpers::sed
export -f helpers::append_once
export -f helpers::remove
export -f helpers::backup_list
export -f helpers::backup_restore

export -f helpers::is_vm
export -f helpers::has_wifi_adapter

export -f helpers::install_yay
export -f helpers::install_pkg

export -f helpers::abort_install
export -f helpers::prompt_err_action
export -f helpers::run_step
export -f helpers::run_phase
export -f _shcat

# ========================================== #

# Installation lifecycle state. The EXIT trap reads this to decide what to print.
# Values: "" (in progress), "aborted" (user-initiated abort), "true" (complete).
_INSTALL_COMPLETE=""
export _INSTALL_COMPLETE

# Set to true by the INT/TERM traps so the EXIT message is more specific.
_INTERRUPT=false

# PID of the sudo keepalive loop; killed on any exit. Initialized empty so
# the kill in the EXIT trap is a harmless no-op before the loop starts.
SUDO_KEEPALIVE_PID=""

_cleanup_on_exit() {
  kill "$SUDO_KEEPALIVE_PID" 2>/dev/null
  wait "$SUDO_KEEPALIVE_PID" 2>/dev/null
  rm -f /tmp/vb-install-ongoing
  term::enable_input

  case "$_INSTALL_COMPLETE" in
    true) ;;
    aborted)
      printf '[%(%H:%M:%S)T] aborted\n' -1 >> "$_LOG_FILE" 2>/dev/null
      helpers::log::error "Installation aborted"
      helpers::log::error "Log: ${_LOG_FILE}"
      ;;
    *)
      if [[ "$_INTERRUPT" == true ]]; then
        printf '[%(%H:%M:%S)T] interrupted\n' -1 >> "$_LOG_FILE" 2>/dev/null
        helpers::log::error "Installation interrupted"
      else
        printf '[%(%H:%M:%S)T] unexpected exit\n' -1 >> "$_LOG_FILE" 2>/dev/null
        helpers::log::error "Installation terminated unexpectedly"
      fi
      helpers::log::error "Log: ${_LOG_FILE}"
      ;;
  esac
}

trap '_cleanup_on_exit' EXIT
trap '_INTERRUPT=true; exit 130' INT
trap '_INTERRUPT=true; exit 143' TERM

# ========================================== #

touch /tmp/vb-install-ongoing

exec </dev/tty

# Clear TTY and move prompt to the bottom
clear
tput cup 9999 0

term::disable_input
term::show_header

helpers::log::info "Welcome to ${CYAN}Vibranium${RESET}, an ${GREEN}Omarchy${RESET}-like ${CYAN}Arch Linux${RESET} configuration."
helpers::log::info "It is designed to be simple, extremely fast, and highly customizable."
helpers::log::info ""
helpers::log::info "This installer will directly modify system files, install packages,"
helpers::log::info "change configuration across the system, and tune everything"
helpers::log::info "specifically for your hardware."
helpers::log::info ""
helpers::log::info "In addition to performing automatic tasks, the installer will also ask you"
helpers::log::info "a number of yes/no questions to tailor your installation to your needs."
helpers::log::info ""
helpers::log::info "Before changing or replacing a file that already exists, the installer"
helpers::log::info "backs it up first. Your backup files are kept under"
helpers::log::info "${CYAN}~/.local/state/vibranium/backup${RESET}."
helpers::log::info ""

if ! term::ask_yes_no Y "Proceed with Installation?"; then
  _INSTALL_COMPLETE=aborted
  exit 1
fi

# ========================================== #

if ! sudo -v; then
  _INSTALL_COMPLETE=aborted
  exit 1
fi

# Keep sudo credentials alive
# for the duration of the installation.
(
  while true; do
    sudo -v
    sleep 5
  done
) &

SUDO_KEEPALIVE_PID=$!

if ! command -v yay &>/dev/null; then
  helpers::log::info "Installing AUR helper"

  if ! helpers::install_yay; then
    helpers::log::error "Failed to install AUR helper"
    helpers::log::error "Aborting installation"
    exit 1
  fi
fi

# ========================================== #

helpers::run_phase "System configuration"  "$SCRIPT_DIR/config"
helpers::run_phase "Package installation"  "$SCRIPT_DIR/packaging"
helpers::run_phase "Hardware setup"        "$SCRIPT_DIR/config/hardware"
helpers::run_phase "Post-install"          "$SCRIPT_DIR/post-install"

# ========================================== #

_INSTALL_COMPLETE=true

helpers::log::success "Installation complete. System restart required"
helpers::log::success "You have to pick 'Hyprland (uwsm-managed)' in the login manager"
helpers::log::success "Otherwise Vibranium will NOT WORK"

while ! term::ask_yes_no N "Did you read the message above?"; do
  :
done

if term::ask_yes_no Y "Reboot now?"; then
  rm -f /tmp/vb-install-ongoing
  for sec in {5..1}; do
    for step in {0..3}; do
      dots=$(printf "%.*s" "$step" "...")
      printf "\r\033[K%s[VIBRANIUM]%s Restarting in %d%s" \
        "$GREEN" "$RESET" "$sec" "$dots"
      sleep 0.25
    done
  done

  systemctl reboot
fi
