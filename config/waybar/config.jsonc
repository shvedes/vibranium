[
	{
    // These three entries are being read by settings scripts.
    // It's not recommended to remove them. You can modify them
    // manually, but prefer Vibranium Menu > Settings > Waybar.
    //
    // When removed, corresponding options in Vibranium Settings
    // will not be shown at all.
		"position": "top",
    "spacing": 0,
		"height": 30,

    // These are custom Waybar modules tuned to Vibranium looks.
    // Do not edit files inside of $XDG_DATA_HOME/vibranium/default/waybar!
    // Instead, if you want to make changes to specific module, copy
    // one from desired file and put them after the modules array below.
    // Modules that declared here take priority over modules in the
    // default folder.
		"include": [
			"$XDG_DATA_HOME/vibranium/default/waybar/battery.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/bluetooth.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/clock.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/confirm-kill.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/color-picker.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/dynamic-separator.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/nightshift.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/inhibitor.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/language.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/logout.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/microphone.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/network.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/pacman.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/power-profile.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/reading-mode.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/recording-indicator.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/separator.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/timer.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/tray.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/group-tray.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/volume.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/weather.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/worker.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/workspaces.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/password-manager.jsonc",
			"$XDG_DATA_HOME/vibranium/default/waybar/vibranium-update.jsonc"
		],

    // Here you declare what modules Waybar will enable and show.
    // Module order does matter. Don't edit this array manually
    // unless you really need to. If you want enable or disable
    // specific modules, use Vibranium Settings.
		"modules-left": ["hyprland/workspaces"],
		"modules-center": ["custom/weather","clock","custom/pacman"],
		"modules-right": [
			"custom/vibranium-update",
      "custom/timer",
			"custom/confirm-kill",
			"custom/worker",
			"custom/reading-mode",
			"custom/inhibitor",
      "custom/password-manager",
			"custom/dynamic-separator",
			// "hyprland/language",
			"custom/recording-indicator",
			"custom/color-picker",
			"custom/power-profile",
			"custom/nightshift",
			"pulseaudio#volume",
			"pulseaudio#microphone",
			"bluetooth",
			"network",
			"battery",
			"custom/separator",
			"group/traygroup"
		]
	}
]

// vim:ft=jsonc
