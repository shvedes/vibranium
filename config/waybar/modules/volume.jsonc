{
	"pulseaudio#volume": {
		"on-click": "vb-core-volume --volume-toggle",
		"on-scroll-up": "vb-core-volume --volume-up",
		"on-scroll-down": "vb-core-volume --volume-down",
		"on-click-right": "vb-launch-tui --app-id=org.vb.term.float --title=wiremix -- wiremix --tab output",
    "on-click-middle": "vb-cmd-toggle-output",

		"format": "{icon}",
		"format-muted": "\udb81\udf5f",
		"format-icons": {
            "headset": "\udb80\udecb",
            "portable": "\udb82\udda2",
            "default": [
                "\udb81\udd7f",
                "\udb81\udd80",
                "\udb81\udd7e"
            ]
        },
		"tooltip-format": "Volume: {volume}%\nDevice: {desc}",
        "ignored-sinks": [ "Easy Effects Sink" ]
	}
}
