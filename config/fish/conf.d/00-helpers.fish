# Colors
set -g BLK \e'[30m' # black
set -g RED \e'[31m' # red
set -g GRN \e'[32m' # green
set -g YEL \e'[33m' # yellow
set -g BLU \e'[34m' # blue
set -g MAG \e'[35m' # magenta
set -g CYN \e'[36m' # cyan
set -g WHT \e'[37m' # white

# Bright colors
set -g GRY \e'[90m' # bright black (grey)
set -g BRD \e'[91m' # bright red
set -g BGR \e'[92m' # bright green
set -g BYL \e'[93m' # bright yellow
set -g BBL \e'[94m' # bright blue
set -g BMG \e'[95m' # bright magenta
set -g BCY \e'[96m' # bright cyan
set -g BWH \e'[97m' # bright white

# Styles
set -g BLD \e'[1m' # bold
set -g DIM \e'[2m' # dim
set -g ITL \e'[3m' # italic
set -g UND \e'[4m' # underline
set -g BLN \e'[5m' # blink
set -g REV \e'[7m' # reverse
set -g HID \e'[8m' # hidden
set -g STR \e'[9m' # strikethrough

# Resets
set -g RST  \e'[0m'  # all
set -g RBLD \e'[22m' # bold/dim off
set -g RITL \e'[23m' # italic off
set -g RUND \e'[24m' # underline off
set -g RBLN \e'[25m' # blink off
set -g RREV \e'[27m' # reverse off
set -g RHID \e'[28m' # hidden off
set -g RSTR \e'[29m' # strikethrough off
