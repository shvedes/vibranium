{
	"$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"display": {
		"separator": " "
	},
	"logo": {
		"source": "BLAG"
	},
	"modules": [
		"title",
		"separator",
		"break",
		{
			"type": "os",
			"key": "*",
			"format": "{2}",
			"keyColor": "yellow"
		},
		{
			"type": "command",
			"key": "*",
			"text": "uname -r | { IFS=- read ver _; echo $ver; }",
			"format": "Linux {}",
			"keyColor": "yellow"
		},
		{
			"type": "command",
			"text": "git -C $VIBRANIUM describe --tags --abbrev=0 2>/dev/null",
			"key": "*",
			"format": "Vibranium {}",
			"keyColor": "yellow"
		},
		{
			"type": "command",
			"text": "birth_install=$(stat -c %W /); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference",
			"key": "*",
			"format": "OS age {} days",
			"keyColor": "yellow"
		},
		{
			"type": "command",
			"text": "birth_install=$(stat -c %W $VIBRANIUM); current=$(date +%s); days_difference=$(( (current - birth_install) / 86400 )); echo $days_difference",
			"key": "*",
			"format": "Vibranium age {} days",
			"keyColor": "yellow"
		},
		{
			"type": "packages",
			"key": "*",
			"keyColor": "yellow"
		},
		"break",
		{
			"type": "cpu",
			"key": "*",
			"format": "{1}",
			"keyColor": "green"
		},
		{
			"type": "gpu",
			"key": "*",
			"format": "{2}",
			"keyColor": "green"
		},
		"break",
		{
			"type": "disk",
			"folders": "/",
			"key": "*",
			"format": "Disk {1} / {2}",
			"keyColor": "blue"
		},
		{
			"type": "memory",
			"key": "*",
			"format": "RAM {1} / {2}",
			"keyColor": "blue"
		},
		{
			"type": "swap",
			"key": "*",
			"format": "Swap {1} / {2}",
			"keyColor": "blue"
		},
		"break",
		{
			"type": "uptime",
			"key": "*",
			"keyColor": "red"
		},
		"break"
	]
}
