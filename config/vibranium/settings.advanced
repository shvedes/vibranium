# vim:ft=bash
# shellcheck disable=all
#
# This is the advanced settings file, intended to be edited manually.
# If you're changing values here, you likely know what you're doing.
# All changes are applied instantly. If you're unfamiliar with these
# options, refer to the wiki for guidance.

# Extra files to always regenerate from templates, even when the active theme
# ships its own version of the file.  Normally a theme-provided file blocks
# template output; entries here override that and let the template win instead.
#
# Entry formats:
#
#   "file.ext"                   -- global: template always wins, for every theme
#   "theme-name/file.ext"        -- scoped: template wins only for that one theme
#   "!theme-name/file.ext"       -- inverse: template wins for every theme EXCEPT
#                                   that one
#
#   Any entry supports bash glob wildcards (*, ?, [...]):
#     "gruvbox-*/*.css"          -- force .css templates for all gruvbox-* themes
#     "*.css"                    -- force .css templates for every theme
#     "!gruvbox-*/vscode.json"   -- exclude vscode.json for gruvbox-* themes
#
# Use this when you maintain your own template for a file or want to fully
# manage a file through Vibranium's template system.
#
# List the output filename without the .tpl suffix, matching exactly what
# appears under ~/.config/vibranium/themed/ or $VIBRANIUM/default/themed/.
# Example: ("alacritty.toml" "my-cool-theme/waybar.css" "!nightfox-nordfox/dunstrc")
vb_force_template_files=(
  # Instead of letting every theme install
  # its own extension and clutter the
  # extensions list, we generate a single
  # extension whenever the theme changes.
  #
  # No clutter. No dependencies. Just clean.
  "vscode.json"

  # Always use the generated Obsidian theme to avoid
  # theme-specific quirks, custom shadows, and other
  # styling inconsistencies. The Vibranium template
  # mirrors Obsidian's original theme structure.
  "obsidian.css"

  # Always prefer builtin GTK theme.
  "gtk.css"

  # Always generate these files.
  # Within the Vibranium ecosystem they have special semantics.
  # For example, if a theme ships its own colors.lua, it will
  # break Hyprland theming because Vibranium depends on specific
  # variable names being present.
  #
  # The same applies to colors.css and any applications that use
  # it for Vibranium-specific named color variables.
  "colors.lua"
  "colors.css"

  # The template system does a good job of generating Hyprland's appearance.
  # If you disable it, keep in mind that some Omarchy community themes define
  # their own animation curves. In such cases, the animation setting shown in
  # Vibranium settings may not match the animations actually being used.
  "hyprland.lua"
)

# Launcher keywords: special words recognised in the rofi search bar.
# Each entry has the form "keyword:action", where action is eval'd as a
# shell command. Both inline expressions and function names work:
#
#   "hello:notify-send Hello"
#   "date:notify-send \"$(date)\""   # escape $ to expand at trigger time, not at source time
#   "kernel:_show_kernel_version"    # function defined in settings.functions
#
# Functions can be defined here (before the array) or in the
# ~/.config/vibranium/settings.functions (preferred way).
# The latter is being sourced by exec scripts that use it.
#
# Keywords also accept positional parameters: everything typed after
# the keyword in the launcher search bar is appended as arguments to
# the action command.

vb_launcher_keywords=(
  "date:_vb_kw_date"
  "updates:_check_updates"
  "stopify:vb-launch-cmd -- spotify"

  # Type "play <query>" in the launcher to search MPD library.
  # The query is passed as --search argument to vb-cmd-play-mpd.
  "play:vb-cmd-play-mpd --search"
)
