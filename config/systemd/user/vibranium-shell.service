[Unit]
Description=Vibranium Shell
PartOf=graphical-session.target
BindsTo=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=QS_CONFIG_PATH=%h/.local/share/vibranium/shell
ExecStart=qs
Restart=always
RestartSec=1s
StartLimitIntervalSec=120
StartLimitBurst=10

[Install]
WantedBy=graphical-session.target

