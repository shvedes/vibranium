[Unit]
Description=Startup functions for Vibranium
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=oneshot
ExecStart=%h/.local/share/vibranium/bin/vb-util-startup
Restart=on-failure

[Install]
WantedBy=graphical-session.target

