<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>utilities-terminal</icon>
	<name>Open Terminal Here</name>
	<submenu></submenu>
	<unique-id>1761167642911348-1</unique-id>
	<command>xdg-terminal-exec --dir=%f</command>
	<description>Open terminal in selected directory</description>
	<range></range>
	<patterns>*</patterns>
	<startup-notify/>
	<directories/>
</action>
<action>
	<icon>image-x-tiff</icon>
	<name>Set as wallpaper</name>
	<submenu></submenu>
	<unique-id>1761243531064717-1</unique-id>
