pragma Singleton

// qmllint disable signal-handler-parameters
import QtQml
import Quickshell
import Quickshell.Io
import qs.common
import "../collections/BoundedCache.js" as BoundedCache

// Themed icon set shipped with the shell (assets/icons). The glyphs live in
// the tree and are recolored in process, so a theme switch paints the live
// palette without touching the user's icon theme.
//
// How it works: a single boot scan reads every svg under assets/icons once,
// keeping raw text in memory (the whole set, tens of KB in total). url()
// then serves each icon as a data URL whose fills/strokes are rewritten to
// the live palette color on demand. Results are memoized per icon and
// palette state, and the memo is bounded and evicted least recently used,
// so a session pays for the palettes and layer variants it is actually
// using and not for every one it passed through. Qt decodes each resulting
// URL once per image, steady state after a theme switch is identical to
// plain file loading, and nothing touches the filesystem. Bindings
// re-evaluate through Theme.colors, so offscreen or stale menus never pay
// for recoloring they do not display.
//
// Two-tone icons: an asset may split its artwork into semantic tones via
// element classes - class="indicator" marks a sub-shape like a mic slash
// or battery bolt. In two-tone mode the root <svg> is body tone, so
// untagged children inherit the primary color through the root's default
// fill/stroke and only indicators opt into the accent color. Animation
// rides on top as a second pre-rasterized indicator layer driven by GPU
// opacity (Icon.qml); the SVG string is never regenerated per frame. See
// assets/icons/README.md ("tone classes") for the contract.
Singleton {
  id: root

  readonly property string tag: "icons"

  // name -> raw svg text; swapped wholesale when the boot scan lands, which
  // re-runs every pending icon binding through the now-populated cache.
  property var _raw: ({})

  // Resolved recolored data URLs, one entry per (name, body hex, accent
  // hex, ghost hex, layer mode, dimTiers) - every input recolor() takes,
  // with the palette resolved, so a served entry is the recolor of exactly
  // those inputs and nothing about it is revalidated after the read.
  //
  // Bounded: the six fields are all reachable at once. A bar binds a large
  // share of the shipped set under several palette keys, a two-tone asset
  // occupies the plain variant plus the two layer variants, a tiered asset
  // one variant per dim level, and a theme switch mints a full second set
  // rather than overwriting the first. The capacity covers a whole working
  // set for the live palette plus a complete second palette, so returning to
  // a palette is served from the cache; past that the least recently used
  // entry is dropped and regenerated by the same single regex pass that
  // produced it the first time.
  //
  // Mutated in place on purpose: entries are written while caller bindings
  // evaluate, so a property write here would notify those same bindings and
  // loop. BoundedCache owns the eviction, and its in-place writes notify
  // nobody for the same reason - which is also why the size and the
  // diagnostics below are functions and not properties.
  readonly property int urlCacheCap: 256
  property var _cache: BoundedCache.create(root.urlCacheCap)

  // Asset feature flags from the tone classes, filled by the boot scan:
  // name -> { indicator: bool, blink: bool, pulse: bool }. Read by
  // Icon.qml to decide whether an indicator layer can exist and which
  // behavior an asset defaults to. Pure data - published once after the scan.
  property var _features: ({})

  // Memo for the tier ghost tone below, mutated in place like _cache (a
  // property write here would notify the caller bindings mid-evaluation).
  // Domain-bounded rather than capacity-bounded: both inputs are resolved
  // palette leaves, so the whole key space is tones-squared and no
  // eviction is needed.
  property var _ghostMemo: ({})

  property int _scanExitCode: -1
  readonly property bool ready: root._scanExitCode === 0
  readonly property int indexedCount: Object.keys(root._raw).length

  // layer: "" -> normal URL (default, monochrome or two-tone when
  //        accentKey is set); "base" -> indicators forced transparent;
  //        "indicator" -> everything but indicators forced transparent.
  //        The split layers stack pixel-perfectly in Icon.qml (same
  //        viewBox, same item geometry), so base + indicator overlays
  //        reassemble the normal render exactly.
  // dimTiers: 0 -> whole glyph (default); N -> tier classes above N
  //        hidden (tiered strength/level glyphs, see recolor below).
  function url(name, key, accentKey, layer, dimTiers) {
    if (!name) return ""
    const colorKey = key ?? "foreground_0"
    // A literal "#rrggbb" key is its own color: arbitrary-color
    // consumers (the color picker's tinted droplet) skip the palette,
    // which only knows named keys. Palette keys resolve through
    // Theme.colors. Note there is no pending state here:
    // Theme.color answers every key from its fallback map (pinned by
    // ui-rest-test.sh), so "" and unknown keys paint black rather than
    // returning "" - see KNOWN_ISSUES #29.
    const hex = colorKey.charAt(0) === "#"
      ? colorKey
      : String(Theme.color(colorKey) ?? "")
    if (hex === "") return ""
    // Two-tone mode engages only with an explicit accentKey: absent or
    // empty means plain monochrome recolor. An
    // invalid accent key likewise paints black through Theme.color's
    // fallback rather than keeping the binding pending (same pin as
    // above) - only a missing asset (raw === undefined) returns "".
    let accent = ""
    if (accentKey) {
      accent = accentKey.charAt(0) === "#"
        ? accentKey
        : String(Theme.color(accentKey) ?? "")
      if (accent === "") return ""
    }
    const mode = layer ?? ""
    const dim = dimTiers ?? 0
    // Ghost tone for dimmed tier groups: body mixed toward the bar
    // background. It rides on the background tone, not only on the body
    // hex, so it is a key field of its own: a background change alters the
    // dimmed tiers of every asset while leaving the body tone alone.
    // Memoized on the resolved pair (tones-squared domain, no eviction):
    // tiered bindings re-evaluate on every volume/wifi change, and the mix
    // must not be repaid on a cache hit.
    const ghost = dim !== 0 ? root._ghostFor(hex, String(Theme.color("background_0") ?? "#000000")) : ""
    // The six fields are the arguments recolor() receives, resolved rather
    // than named. Keying on the symbolic palette names instead would make
    // one slot serve every palette and force the entry to be revalidated
    // against the resolved colors on every read; keying on the resolved
    // values makes a palette change a different key, so two palettes are
    // cached side by side and a served entry cannot be the recolor of
    // different inputs. No field can hold a NUL, so the concatenation is
    // unambiguous and two input sets that differ in any field differ in
    // the key.
    //
    // Raster geometry is deliberately absent: the stored value is the
    // recolored source, not a raster, and sourceSize/DPR belong to the
    // Image that draws it, so one entry serves every size the shell asks
    // for and the decoded-raster cache is Qt's to own.
    const ck = name + "\u0000" + hex + "\u0000" + accent + "\u0000" + ghost
      + "\u0000" + mode + "\u0000" + dim
    const hit = BoundedCache.get(root._cache, ck)
    if (hit !== undefined) return hit
    // The scan publishes its text once, so an entry only ever exists against
    // final source; an asset whose text has not landed is not cached at all.
    const raw = root._raw[name]
    if (raw === undefined) return ""
    const url = "data:image/svg+xml;utf8,"
      + encodeURIComponent(root._rasterSize(root.recolor(raw, hex, accent, mode, dim, ghost)))
    BoundedCache.put(root._cache, ck, url)
    return url
  }

  // Decode-size stamp for served SVGs. Qt Quick ignores `Image.sourceSize`
  // for data: URLs (measured: a data-URL load reports its intrinsic size
  // whatever sourceSize says, while the same file over file: honors it), so
  // a 24px-intrinsic icon shown at 48-56px decodes at 24 and is bilinearly
  // upscaled - correct colors, wrong sharpness. Stamping a large viewport
  // into the served copy makes the decode itself full-size; every display
  // size in the shell only ever downscales from it. Square viewBoxes
  // throughout the set, so one side length fits all, and width/height are
  // present on every asset. Cache-neutral: the stamp is a pure function of
  // the recolored source, so the key needs no new dimension.
  readonly property int rasterSide: 192
  function _rasterSize(svg, side) {
    const s = side ?? root.rasterSide
    return String(svg).replace(/<svg([^>]*)>/, (m, attrs) => {
      const clean = String(attrs).replace(/\swidth="[^"]*"/, "").replace(/\sheight="[^"]*"/, "")
      return "<svg" + clean + ' width="' + s + '" height="' + s + '">'
    })
  }

  // 50/50 mix of two "#rrggbb" colors. The tier ghost tone: body faded
  // toward the bar background - a solid, palette-derived gray that reads
  // as "dimmed" on any theme (an alpha ghost washed out against
  // wallpapers and varied with every surface behind the bar).
  // Served memoized through _ghostFor (the inputs are resolved leaves,
  // so the domain is tones-squared and needs no eviction).
  function _ghostFor(a, b) {
    const k = a + "\u0000" + b
    const hit = root._ghostMemo[k]
    if (hit !== undefined) return hit
    const g = root._mixHex(a, b)
    root._ghostMemo[k] = g
    return g
  }

  function _mixHex(a, b) {
    const pa = parseInt(a.substring(1), 16), pb = parseInt(b.substring(1), 16)
    const ch = (sa, sb, shift) => Math.round((((sa >> shift) & 255) + ((sb >> shift) & 255)) / 2)
    const n = (ch(pa, pb, 16) << 16) | (ch(pa, pb, 8) << 8) | ch(pa, pb, 0)
    return "#" + n.toString(16).padStart(6, "0")
  }

  // Live entry count of the URL cache. A function and not a property: the
  // map is mutated in place, so a binding over the count would evaluate
  // once against an empty cache and then report that number forever.
  function cacheSize() {
    return BoundedCache.size(root._cache)
  }

  // The bound as a fact rather than a claim: the capacity, what the cache
  // holds now, and the counters that show the bound doing its work. Evicted
  // entries are regenerated on the next request, so a count above zero is
  // the cache paying for its own ceiling, not an error.
  function diagnostics() {
    const cache = BoundedCache.diagnostics(root._cache)
    return {
      tag: root.tag,
      ready: root.ready,
      assets: root.indexedCount,
      urlCacheSize: cache.size,
      urlCacheCap: cache.capacity,
      urlCacheHits: cache.hits,
      urlCacheMisses: cache.misses,
      urlCacheStores: cache.stores,
      urlCacheEvictions: cache.evictions
    }
  }

  // One pass over the raw svg text at scan time: does the asset carry
  // indicator elements and which behavior classes do they declare?
  // Runs once per asset per boot - never per frame.
  function _scanFeatures(svg) {
    const f = { indicator: false, blink: false, pulse: false }
    if (!svg.includes("indicator")) return f
    const els = svg.match(/<[a-zA-Z][^>]*>/g) ?? []
    for (let i = 0; i < els.length; i++) {
      const el = els[i]
      if (/^<svg[\s>]/.test(el) || !/class="[^"]*\bindicator\b/.test(el)) continue
      f.indicator = true
      if (/class="[^"]*\bblink\b/.test(el)) f.blink = true
      if (/class="[^"]*\bpulse\b/.test(el)) f.pulse = true
    }
    return f
  }

  // Monochrome rewrite (no accentHex): every concrete fill/stroke becomes
  // hex, in both the attribute and the inline-style forms, except `none` is
  // preserved, since transparent masks must stay transparent.
  //
  // Tone rewrite (accentHex given): colors each element by its tone class -
  // class="indicator" -> accentHex, everything else -> bodyHex (see the
  // tone-class contract in assets/icons/README.md). The rewrite stays a
  // flat string pipeline: assets are machine-formatted with no `>` inside
  // attribute values (contract-tested), so matching one whole element tag
  // and rewriting its paint attributes in place decides the tone per
  // element without any DOM parsing. The root <svg> is body tone: its
  // fill/stroke are the inherited defaults untagged children paint with,
  // so body children need no class of their own.
  //
  // Layer modes (mode "base"/"indicator") build the animation layers:
  // the non-selected tone's paint becomes `none`. Children that carry no
  // paint attributes of their own inherit the root's stroke, which would
  // leak a tone across layers (a bare slash would reappear body-colored
  // in the base layer and the blink would flash accent -> body; the same
  // leak would leave a static bare indicator unpainted in two-tone mode).
  // So every shape element whose tone differs from the inherited body
  // tone is forced to carry explicit paint:
  // present fill/stroke are rewritten to the element's tone, missing ones
  // are injected right after the tag name (fill "none", stroke tone -
  // exactly what the root defaults would have painted). The `stroke=`
  // probes use a boundary so `stroke-width` does not count as a paint
  // attribute. The plain path (no accent, no tiers) never injects: output
  // stays byte-identical
  // to the old recolor for every asset.
  //
  // Tiered glyphs (strength/level indicators like volume/wifi): shapes
  // carry class="tier-N", N counting groups from the base shape outward
  // (speaker / signal dot = 1), and the caller passes dimTiers = how
  // many groups stay visible. recolor turns every tier-N with
  // N > dimTiers into a dimmed ghost tone (a 50/50 mix of the body
  // color toward the bar background), so one asset renders every
  // level; dimTiers 0 paints the whole glyph. Tiers need no accent and
  // work from the plain colorKey; url() keys them into the cache like
  // any other variant.
  function recolor(svg, hex, accentHex, mode, dimTiers, ghostHex) {
    const dim = dimTiers ?? 0
    if (!accentHex && dim === 0)
      return svg.replace(/(fill|stroke)="(?!none)[^"]*"/g, "$1=\"" + hex + "\"")
        .replace(/([;{"'\s])(fill|stroke)(\s*:\s*)(?!none)[^;"'\s}]+/g, "$1$2$3" + hex)
    const toneFor = el => {
      if (/^<svg[\s>]/.test(el)) return hex
      // Tier classes first (see the tier-class contract in
      // assets/icons/README.md): tier-N paints in full body tone while
      // dimTiers >= N (0 paints everything), otherwise in the ghost
      // tone - the outer waves fade first, the base shape last. A
      // visible tier is body paint, so the indicator layer keeps all
      // tiers hidden like any other non-indicator shape.
      const tier = el.match(/class="[^"]*\btier-(\d+)\b/)
      if (tier !== null) {
        if (mode === "indicator") return "none"
        const over = dim !== 0 && Number(tier[1]) > dim
        return over ? (ghostHex || "none") : hex
      }
      const ind = /class="[^"]*\bindicator\b/.test(el)
      if (mode === "base") return ind ? "none" : hex
      if (mode === "indicator") return ind ? accentHex : "none"
      // Static two-tone: the accent is the indicator's own tone, but a
      // bare indicator (no paint attributes) would inherit the root's
      // body color instead - so bare indicators fall back to body tone
      // unless the layer split injects explicit paint for them.
      return ind ? (accentHex || hex) : hex
    }
    return svg.replace(/<[a-zA-Z][^>]*>/g, el => {
      const tone = toneFor(el)
      let out = el
        .replace(/(fill|stroke)="(?!none)[^"]*"/g, (m, attr) => attr + "=\"" + tone + "\"")
        .replace(/([;{"'\s])(fill|stroke)(\s*:\s*)(?!none)[^;"'\s}]+/g,
          (m, pre, attr, sep) => pre + attr + sep + tone)
      const shape = /^<(path|line|circle|rect|polyline|polygon|ellipse)[\s/>]/.test(out)
      if (shape && tone !== hex) {
        if (!/(^|\s)fill=/.test(out))
          out = out.replace(/^<[a-zA-Z]+/, m0 => m0 + " fill=\"none\"")
        if (!/(^|\s)stroke=/.test(out))
          out = out.replace(/^<[a-zA-Z]+/, m0 => m0 + " stroke=\"" + tone + "\"")
      }
      return out
    })
  }

  Process {
    id: scanProc

    stdout: SplitParser {
      onRead: data => {
        const tab = data.indexOf("\t")
        if (tab <= 0) return
        const name = data.substring(0, tab)
        const svg = data.substring(tab + 1)
        root._raw[name] = svg
        root._features[name] = root._scanFeatures(svg)
      }
    }

    // Fresh containers so every binding that resolved against the empty
    // maps during boot re-evaluates.
    onExited: code => {
      root._features = Object.assign({}, root._features)
      root._raw = Object.assign({}, root._raw)
      root._scanExitCode = code
    }
  }

  Component.onCompleted: {
    const dir = Quickshell.shellDir + "/assets/icons"
    // Newlines inside svg carry no meaning - use bash builtins, no tr fork per file.
    scanProc.command = ["/bin/bash", "-c",
      "set -e -o pipefail; "
      + "find " + JSON.stringify(dir) + " -type f,l -name '*.svg' -print0 | "
      + "while IFS= read -r -d '' f; do "
      + "b=${f##*/}; c=$(<\"$f\"); c=${c//$'\\n'/ }; c=${c//$'\\r'/ }; "
      + "printf '%s\\t%s\\n' \"${b%.svg}\" \"$c\"; done"]
    scanProc.running = true
  }
}
