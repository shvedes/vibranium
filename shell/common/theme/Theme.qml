pragma Singleton
pragma ComponentBehavior: Bound

import QtQml
import Quickshell
import Quickshell.Io
import qs.common

// Live view of the theme palette generated by vb-theme-set
// ($VIBRANIUM_STATE/theme/qs.json). The palette is authoritative: qs.json
// ships with every install and loads before first paint matters, so
// lookups have no fallback path - a missing key is a bug to surface, not
// paper over. Consumers bind through color() or read colors directly.
//
// Fully event-driven:
//   boot                    -> reload
//   qs.json edited in place -> watch fires -> reload
//   theme switch            -> vb-theme-set pokes the wallpaper IPC
//                              (Wallpaper.qml), which reads theme.name,
//                              re-resolves the per-theme pointer from
//                              wallpaper.json and reloads the palette
Singleton {
  id: root

  // Live palette, bound straight off the JsonAdapter: each key is one
  // palette leaf, missing keys keep the built-in defaults below. The
  // file is read-only for the shell (written by vb-theme-set), so the
  // adapter never writes back.
  readonly property var colors: ({
    background_0: paletteAdapter.background_0,
    background_1: paletteAdapter.background_1,
    background_2: paletteAdapter.background_2,
    background_3: paletteAdapter.background_3,
    foreground_0: paletteAdapter.foreground_0,
    foreground_1: paletteAdapter.foreground_1,
    accent: paletteAdapter.accent,
    red: paletteAdapter.red,
    green: paletteAdapter.green,
    yellow: paletteAdapter.yellow,
    blue: paletteAdapter.blue,
    cyan: paletteAdapter.cyan,
    orange: paletteAdapter.orange,
    purple: paletteAdapter.purple
  })
  readonly property string tag: "theme"

  function color(key) {
    const v = root.colors[key]
    // Fallback to avoid "Unable to assign [undefined] to QColor" during
    // early boot when paletteFile hasn't loaded yet. The real palette
    // arrives within milliseconds and rebins the binding.
    if (v !== undefined) return v
    // Minimal defaults matching qs.json; keep in sync with theme generation.
    const fallbacks = {
      background_0: "#141414",
      background_1: "#242424",
      background_2: "#393939",
      background_3: "#434343",
      foreground_0: "#dfdfdf",
      foreground_1: "#d5d5d5",
      accent: "#8a8a8a",
      red: "#877070",
      green: "#728872",
      yellow: "#8d8872",
      blue: "#728391",
      cyan: "#728b8d",
      orange: "#8f7d70",
      purple: "#7d7691"
    }
    return fallbacks[key] !== undefined ? fallbacks[key] : "#000000"
  }

  // Forced fresh read; called on boot and by the renderer's refresh poke.
  function reloadPalette() {
    paletteFile.reload()
  }

  FileView {
    id: paletteFile
    path: Paths.themeColorsFile
    watchChanges: true
    printErrors: false

    onFileChanged: paletteFile.reload()
    onLoadFailed: ; // mid-swap miss: keep last known palette

    JsonAdapter {
      id: paletteAdapter
      property string background_0: "#141414"
      property string background_1: "#242424"
      property string background_2: "#393939"
      property string background_3: "#434343"
      property string foreground_0: "#dfdfdf"
      property string foreground_1: "#d5d5d5"
      property string accent: "#8a8a8a"
      property string red: "#877070"
      property string green: "#728872"
      property string yellow: "#8d8872"
      property string blue: "#728391"
      property string cyan: "#728b8d"
      property string orange: "#8f7d70"
      property string purple: "#7d7691"
    }
  }
}
