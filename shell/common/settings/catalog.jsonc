                "desc": "Inserts new windows at the top of their column.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.new_on_top"
                }
            },
            {
                "key": "hypr.master.mfact",
                "type": "float",
                "default": 0.55,
                "label": "Master size factor",
