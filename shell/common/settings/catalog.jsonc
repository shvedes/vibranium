                "values": [
                    "left",
                    "right",
                    "top",
                    "bottom"
                ],
                "valueLabels": {
                    "left": "Left",
                    "right": "Right",
                    "top": "Top",
                    "bottom": "Bottom"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.center_master_fallback"
                }
            },
            {
                "key": "hypr.master.slave_count_for_center_master",
                "type": "int",
                "default": 1,
                "label": "Slave count for center master",
                "sub": "Windows needed to centre",
                "desc": "Number of slave windows required before the master column is centred.",
                "range": {
                    "min": 0,
                    "max": 20
                },
                "step": 1,
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.slave_count_for_center_master"
                }
            },
            {
                "key": "hypr.master.allow_small_split",
                "type": "bool",
                "default": false,
                "label": "Allow small split",
                "sub": "Allow tiny splits",
