    // --- settings page 26/52 (hypr) ---
    {
        "group": "hypr",
        "id": "hyprland-edit",
        "label": "Edit configs",
        "desc": "Open a Hyprland config in a floating terminal.",
        "items": [
            {
                "type": "action",
                "label": "Window Rules",
                "sub": "window-rules.lua",
                "icon": "file-code",
                "command": "vb-launch-terminal --app-id=org.vb.term.float -- ${EDITOR:-nvim} $XDG_CONFIG_HOME/hypr/hyprland.conf.d/window-rules.lua"
            },
            {
                "type": "action",
                "label": "Keybindings",
                "sub": "binds.lua",
                "icon": "keyboard",
                "command": "vb-launch-terminal --app-id=org.vb.term.float -- ${EDITOR:-nvim} $XDG_CONFIG_HOME/hypr/hyprland.conf.d/binds.lua"
            },
            {
                "type": "action",
                "label": "Monitors",
                "sub": "monitors.lua",
                "icon": "monitor",
                "command": "vb-launch-terminal --app-id=org.vb.term.float -- ${EDITOR:-nvim} $XDG_CONFIG_HOME/hypr/hyprland.conf.d/monitors.lua"
            },
            {
                "type": "action",
                "label": "Input",
                "sub": "input.lua",
                "icon": "cursor",
                "command": "vb-launch-terminal --app-id=org.vb.term.float -- ${EDITOR:-nvim} $XDG_CONFIG_HOME/hypr/hyprland.conf.d/input.lua"
            }
        ],
        "options": []
    },
