                    "slave": "Slave",
                    "inherit": "Inherit"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.new_status"
                }
            },
            {
                "key": "hypr.master.new_on_active",
                "type": "string",
                "default": "none",
                "label": "New on active",
                "values": [
                    "before",
                    "after",
                    "none"
                ],
                "valueLabels": {
                    "before": "Before",
                    "after": "After",
                    "none": "None (boundary)"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.new_on_active"
                }
            },
            {
                "key": "hypr.master.new_on_top",
                "type": "bool",
                "default": false,
                "label": "New on top",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.new_on_top"
                }
            },
            {
                "key": "hypr.master.mfact",
                "type": "float",
                "default": 0.55,
                "label": "Master size factor",
                "range": {
                    "min": 0,
                    "max": 1
                },
                "step": 0.05,
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.mfact"
                }
            },
            {
                "key": "hypr.master.center_master_fallback",
                "type": "string",
                "default": "left",
                "label": "Center master fallback",
                "values": [
                    "left",
                    "right",
                    "top",
                    "bottom"
                ],
                "valueLabels": {
                    "left": "Left",
                    "right": "Right",
                    "top": "Top",
                    "bottom": "Bottom"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.center_master_fallback"
                }
            },
            {
                "key": "hypr.master.slave_count_for_center_master",
                "type": "int",
                "default": 1,
                "label": "Slave count for center master",
                "range": {
                    "min": 0,
                    "max": 20
                },
                "step": 1,
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.slave_count_for_center_master"
                }
            },
            {
                "key": "hypr.master.special_scale_factor",
                "type": "float",
                "default": 0.8,
                "label": "Special workspace scale",
                "range": {
                    "min": 0,
                    "max": 1
                },
                "step": 0.05,
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.special_scale_factor"
                }
            },
            {
                "key": "hypr.master.allow_small_split",
                "type": "bool",
                "default": false,
                "label": "Allow small split",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.allow_small_split"
                }
            },
            {
                "key": "hypr.master.smart_resizing",
                "type": "bool",
                "default": false,
                "label": "Smart resizing",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.smart_resizing"
                }
            },
            {
                "key": "hypr.master.drop_at_cursor",
                "type": "bool",
                "default": false,
                "label": "Drop at cursor",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.drop_at_cursor"
                }
            },
            {
                "key": "hypr.master.always_keep_position",
                "type": "bool",
                "default": false,
                "label": "Always keep position",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.always_keep_position"
                }
            },
            {
                "key": "hypr.master.focus_master_on_close",
                "type": "bool",
                "default": false,
                "label": "Focus master on close",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.focus_master_on_close"
                }
            }
        ]
    }
  ],
  "menus": [
    // --- menu page 1/7: main ---
    {
        "id": "main",
        "label": "Vibranium",
        "items": [
            {
                "id": "settings",
                "type": "submenu",
                "label": "Settings",
                "icon": "settings",
                "page": "settings"
            },
            {
                "id": "install",
                "desc": "Packages, themes and fonts.",
                "type": "submenu",
                "label": "Install",
                "icon": "install",
                "page": "install"
            },
            {
                "id": "remove",
                "desc": "Uninstall packages, themes and fonts.",
                "type": "submenu",
                "label": "Remove",
                "icon": "remove",
                "page": "remove"
            },
            {
                "id": "update",
                "desc": "OS packages, AUR, themes and Vibranium itself.",
                "type": "submenu",
                "label": "Update",
                "icon": "update",
                "page": "update"
            },
            {
                "id": "setup",
                "desc": "Hardware and service provisioning presets.",
                "type": "submenu",
                "label": "Setup",
                "icon": "setup",
                "page": "setup",
                "when": "[[ $CHASSIS_TYPE != vm ]]"
            },
            {
                "id": "help",
                "desc": "Documentation and keybinding cheatsheet.",
                "type": "submenu",
                "label": "Help",
                "icon": "help",
                "page": "help"
            }
        ]
    },
    // --- menu page 2/7: setup ---
    {
        "id": "setup",
        "label": "Setup",
        "items": [
            {
                "type": "action",
                "label": "Secure Boot",
                "sub": "Configure Secure Boot easily",
                "icon": "cpu",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-sboot"
            },
            {
                "type": "action",
                "label": "Firewall",
                "sub": "Basic firewall setup",
                "icon": "firewall",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-ufw"
            },
            {
                "type": "action",
                "label": "Docker",
                "sub": "Install & confiure Docker",
                "icon": "docker",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-docker"
            },
            {
                "type": "action",
                "label": "QEMU",
                "sub": "Install and configure VMs",
                "icon": "qemu",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-qemu"
            },
            {
                "type": "action",
                "label": "CUPS",
                "sub": "Install & configure printing",
                "icon": "printer",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-setup-sboot -- vb-setup-cups"
            }
        ]
    },
    // --- menu page 3/7: install ---
    {
        "id": "install",
        "label": "Install",
        "items": [
            {
                "type": "action",
                "label": "Arch Package",
                "sub": "Install official packages",
                "icon": "archlinux",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-install -- vb-pkg-install"
            },
            {
                "type": "action",
                "label": "AUR Package",
                "sub": "Install AUR packages",
                "icon": "package-aur",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-install-aur -- vb-pkg-install --aur"
            },
            {
                "type": "separator"
            },
            {
                "type": "action",
                "label": "Theme",
                "sub": "Install Vibranium themes",
                "icon": "theme",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-theme-install -- vb-theme-install"
            },
            {
                "type": "action",
                "label": "Font",
                "sub": "Install font packages",
                "icon": "font",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-font-install -- vb-pkg-font-install"
            },
            {
                "type": "action",
                "label": "Font (AUR)",
                "sub": "Install font packages",
                "icon": "font",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-font-install-aur -- vb-pkg-font-install --aur"
            },
            {
                "type": "separator"
            },
            {
                "type": "action",
                "label": "PWA",
                "sub": "Install web apps",
                "icon": "webapp",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-webapp-install -- vb-webapp-install"
            },
            {
                "type": "action",
                "label": "TUI",
                "sub": "Install terminal apps",
                "icon": "tui",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-tui-install -- vb-tui-install"
            }
        ]
    },
    // --- menu page 4/7: remove ---
    {
        "id": "remove",
        "label": "Remove",
        "items": [
            {
                "type": "action",
                "label": "Package",
                "sub": "Uninstall packages",
                "icon": "package",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-remove -- vb-pkg-remove"
            },
            {
                "type": "separator"
            },
            {
                "type": "action",
                "label": "Theme",
                "sub": "Uninstall community themes",
                "icon": "theme",
                "call": "themeRemover summon",
                "keepOpen": true
            },
            {
                "type": "action",
                "label": "Font",
                "sub": "Uninstall font packages",
                "icon": "font",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-font-remove -- vb-pkg-font-remove"
            },
            {
                "type": "separator"
            },
            {
                "type": "action",
                "label": "PWA",
                "sub": "Uninstall web apps",
                "icon": "webapp-remove",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-webapp-remove -- vb-webapp-remove"
            },
            {
                "type": "action",
                "label": "TUI",
                "sub": "Uninstall terminal apps",
                "icon": "tui-remove",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-tui-remove -- vb-tui-remove"
            }
        ]
    },
    // --- menu page 5/7: update ---
    {
        "id": "update",
        "label": "Update",
        "items": [
            {
                "type": "action",
                "label": "OS",
                "sub": "Update system packages",
                "icon": "archlinux",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-update -- vb-pkg-update"
            },
            {
                "type": "action",
                "label": "AUR",
                "sub": "Update AUR packages",
                "icon": "package-aur",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-pkg-update-aur -- vb-pkg-update --aur"
            },
            {
                "type": "separator"
            },
            {
                "type": "action",
                "label": "Themes",
                "sub": "Update community themes",
                "icon": "theme",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-theme-update -- vb-theme-update"
            },
            {
                "type": "action",
                "label": "Vibranium",
                "sub": "Update Vibranium",
                "icon": "github",
                "command": "xdg-terminal-exec --app-id=org.vb.term.float --title=vb-update -- vb-update"
            }
        ]
    },
    // --- menu page 6/7: help ---
    {
        "id": "help",
        "label": "Help",
        "items": [
            {
                "type": "action",
                "label": "Hyprland",
                "sub": "Get help with the <b>Hyprland</b> window manager",
                "icon": "hyprland",
                "command": "vb-launch-webapp -- https://wiki.hypr.land"
            },
            {
                "type": "action",
                "label": "Vibranium",
                "sub": "Get help with the <b>Vibranium</b> project",
                "icon": "github",
                "command": "vb-launch-webapp -- https://shvedes.github.io/vibranium"
            },
            {
                "type": "action",
                "label": "Arch Linux",
                "sub": "Get help with the <b>Arch Linux</b> OS",
                "icon": "archlinux",
                "command": "vb-launch-webapp -- https://wiki.archlinux.org"
            },
            {
                "type": "separator"
            },
            {
                "type": "action",
                "label": "Keybindings",
                "sub": "Get help with the current keybindings",
                "icon": "keyboard",
                "call": "keybindings open"
            }
        ]
    },
    // --- menu page 7/7: utilities ---
    {
        "id": "utilities",
        "label": "Utilities",
        "items": [
            {
                "id": "timer",
                "type": "number",
                "label": "Timer",
                "icon": "timer",
                "min": 1,
                "max": 180,
                "step": 1,
                "value": 5,
                "unit": "min",
                "sub": "A basic countdown timer",
                "desc": "Set a countdown timer in minutes.",
                "close": true
            },
            {
                "id": "caffeine",
                "type": "select",
                "label": "Caffeine",
                "sub": "Block system sleep",
                "icon": "caffeine",
                "value": "300",
                "marker": false,
                "options": [
                    {
                        "label": "5 min",
                        "value": "300"
                    },
                    {
                        "label": "10 min",
                        "value": "600"
                    },
                    {
                        "label": "15 min",
                        "value": "900"
                    },
                    {
                        "label": "30 min",
                        "value": "1800"
                    },
                    {
                        "label": "Infinite",
                        "value": "0"
                    }
                ],
                "onCall": "inhibitor start %v",
                "desc": "Prevent system from sleep for a fixed time.",
                "close": true
            },
            {
                "id": "recording",
                "type": "action",
                "label": "Recording",
                "icon": "recording",
                "sub": "Screen recording",
                "call": "recording toggle",
                "close": true
            },
            {
                "type": "separator"
            },
            {
                "id": "reading.mode",
                "type": "toggle",
                "label": "Reading mode",
                "sub": "Apply grayscale shader",
                "icon": "book",
                "checked": "[[ -f $XDG_CONFIG_HOME/hypr/hyprland.conf.d/reading-mode.lua ]]",
                "onToggle": "vb-toggle-reading-mode",
                "close": true,
                "desc": "Applies a grayscale screen shader to reduce eyestrain.",
                "warning": "Visible on screenshots and screen recordings!"
            },
            {
                "id": "copy.track",
                "type": "action",
                "label": "Copy current track",
                "sub": "Copy currently playing track",
                "icon": "music",
                "command": "vb-cmd-copy-track --notify",
                "when": "{ mpc status 2>/dev/null; playerctl status 2>/dev/null; } | grep -qiE '\\[playing\\]|^Playing'"
            },
            {
                "type": "separator"
            },
            {
                "id": "reload",
                "type": "action",
                "label": "Reload Vibranium",
                "icon": "update",
                "command": "vb-cmd-reload --quiet"
            },
            {
                "id": "close.windows",
                "type": "action",
                "label": "Close all windows",
                "icon": "xmark",
                "command": "hyprctl -q eval 'Hypr.Helpers.CloseWindows()'",
                "close": true,
                "confirm": {
                    "stages": 2,
                    "hint": "Press <b>Enter</b> again to close all windows",
                    "armed": "<b><u>Press again to confirm</u></b>",
                    "label": "Close all windows",
                    "command": "hyprctl -q eval 'Hypr.Helpers.CloseWindows()'"
                }
            }
        ]
    }
  ]
}
