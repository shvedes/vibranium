                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.allow_small_split"
                }
            },
            {
                "key": "hypr.master.smart_resizing",
                "type": "bool",
                "default": false,
                "label": "Smart resizing",
                "sub": "Resize by layout",
