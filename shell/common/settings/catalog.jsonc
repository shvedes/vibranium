                "desc": "Expands the clickable area around the cursor hotspot.",
                "range": {
                    "min": 0,
                    "max": 32
                },
                "step": 1,
                "unit": "px",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.hotspot_padding"
                }
            },
            {
                "key": "hypr.cursor.min_refresh_rate",
                "type": "int",
                "default": 60,
                "label": "Min refresh rate",
                "sub": "Minimum redraw rate",
                "desc": "Lowest rate at which the cursor is redrawn while the screen is idle.",
                "range": {
                    "min": 60,
                    "max": 360
                },
                "step": 1,
                "unit": "Hz",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.min_refresh_rate"
                }
            },
            {
                "key": "hypr.cursor.hide_on_key_press",
                "type": "bool",
                "default": false,
                "label": "Hide on key press",
                "sub": "Hide while typing",
                "desc": "Hides the cursor as soon as a key is pressed.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.hide_on_key_press"
                }
            },
            {
                "key": "hypr.cursor.hide_on_touch",
                "type": "bool",
                "default": false,
                "label": "Hide on touch",
                "sub": "Hide on touch input",
                "desc": "Hides the cursor when the screen is touched.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.hide_on_touch"
                }
            },
            {
                "key": "hypr.cursor.hide_on_tablet",
                "type": "bool",
                "default": false,
                "label": "Hide on tablet",
                "sub": "Hide on tablet input",
                "desc": "Hides the cursor while a tablet stylus is in use.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.hide_on_tablet"
                }
            },
            {
                "key": "hypr.cursor.no_warps",
                "type": "bool",
                "default": false,
                "label": "No warps",
                "sub": "Disable cursor warps",
                "desc": "Stops the compositor from teleporting the cursor to a new position.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.no_warps"
                }
            },
            {
                "key": "hypr.cursor.persistent_warps",
                "type": "bool",
                "default": false,
                "label": "Persistent warps",
                "sub": "Keep the warp target",
                "desc": "Keeps a warp in place until the pointer actually moves.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.persistent_warps"
                }
            },
            {
                "key": "hypr.cursor.warp_back_after_non_mouse_input",
                "type": "bool",
                "default": false,
                "label": "Warp back after non-mouse input",
                "sub": "Return after keyboard input",
                "desc": "Moves the cursor back where it was after typing or another non-mouse input.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.warp_back_after_non_mouse_input"
                }
            },
            {
                "key": "hypr.cursor.warp_on_change_workspace",
                "type": "int",
                "default": 0,
                "label": "Warp on workspace change",
                "sub": "Warp to new workspace",
                "desc": "Places the cursor on the workspace you switch to; auto decides from the layout.",
                "values": [
                    0,
                    1,
                    2
                ],
                "valueLabels": {
                    "0": "Disabled",
                    "1": "Enabled",
                    "2": "Force center"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.warp_on_change_workspace"
                }
            },
            {
                "key": "hypr.cursor.warp_on_toggle_special",
                "type": "int",
                "default": 0,
                "label": "Warp on special toggle",
                "sub": "Warp to scratchpad",
                "desc": "Moves the cursor to the special workspace when it is toggled on.",
                "values": [
                    0,
                    1,
                    2
                ],
                "valueLabels": {
                    "0": "Disabled",
                    "1": "Enabled",
                    "2": "Force center"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.warp_on_toggle_special"
                }
            },
            {
                "key": "hypr.cursor.no_break_fs_vrr",
                "type": "int",
                "default": 0,
                "label": "No break fullscreen VRR",
                "sub": "Keep VRR in fullscreen",
                "desc": "Keeps variable refresh rate on while a fullscreen app plays video.",
                "values": [
                    0,
                    1,
                    2
                ],
                "valueLabels": {
                    "0": "Disabled",
                    "1": "Enabled",
                    "2": "Force"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.no_break_fs_vrr"
                }
            },
            {
                "key": "hypr.cursor.zoom_rigid",
                "type": "bool",
                "default": false,
                "label": "Zoom rigid",
                "sub": "Fixed zoom centre",
                "desc": "Zooms around a fixed point instead of following the cursor.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.zoom_rigid"
                }
            },
            {
                "key": "hypr.cursor.zoom_detached_camera",
                "type": "bool",
                "default": false,
                "label": "Zoom detached camera",
                "sub": "Zoom ignores focus",
                "desc": "Leaves the zoomed view in place while focus moves elsewhere.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.zoom_detached_camera"
                }
            },
            {
                "key": "hypr.cursor.zoom_disable_aa",
                "type": "bool",
                "default": false,
                "label": "Zoom disable anti-aliasing",
                "sub": "Crisp zoomed pixels",
                "desc": "Skips smoothing when zoomed in, keeping pixels sharp.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "cursor.zoom_disable_aa"
                }
            }
        ]
    },
    // --- settings page 50/52 (hypr) ---
    {
        "group": "hypr",
        "id": "hyprland-advanced-scrolling",
        "label": "Scrolling",
        "icon": "scroll",
        "options": [
            {
                "key": "hypr.scrolling.direction",
                "type": "string",
                "default": "left",
                "label": "Direction",
                "sub": "New column side",
                "desc": "Where new columns are added: left, right, up or down.",
                "values": [
                    "left",
                    "right",
                    "up",
                    "down"
                ],
                "valueLabels": {
                    "left": "Left",
                    "right": "Right",
                    "up": "Up",
                    "down": "Down"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "scrolling.direction"
                }
            },
            {
                "key": "hypr.scrolling.follow_focus",
                "type": "bool",
                "default": false,
                "label": "Follow focus",
                "sub": "Scroll to focused window",
                "desc": "Keeps the focused window in view by scrolling the layout.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "scrolling.follow_focus"
                }
            },
            {
                "key": "hypr.scrolling.focus_fit_method",
                "type": "int",
                "default": 0,
                "label": "Fit method",
                "sub": "How focus fits the view",
                "desc": "How the view adjusts to a focused window that does not fit.",
                "values": [
                    0,
                    1
                ],
                "valueLabels": {
                    "0": "Center",
                    "1": "Fit"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "scrolling.focus_fit_method"
                }
            },
            {
                "key": "hypr.scrolling.column_width",
                "type": "float",
                "default": 0.5,
                "label": "Column width",
                "sub": "Column width ratio",
                "desc": "Width of each column as a fraction of the screen.",
                "range": {
                    "min": 0.1,
                    "max": 1
                },
                "step": 0.05,
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "scrolling.column_width"
                }
            },
            {
                "key": "hypr.scrolling.follow_min_visible",
                "type": "float",
                "default": 0.2,
                "label": "Follow minimum visible",
                "sub": "Focus visibility threshold",
                "desc": "How much of a focused window must be on screen before the layout scrolls to it.",
                "range": {
                    "min": 0,
                    "max": 1
                },
                "step": 0.05,
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "scrolling.follow_min_visible"
                }
            },
            {
                "key": "hypr.scrolling.wrap_swapcol",
                "type": "bool",
                "default": false,
                "label": "Wrap swapcol",
                "sub": "Wrap column swapping",
                "desc": "Wraps column swaps around the ends of the row instead of stopping.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "scrolling.wrap_swapcol"
                }
            },
            {
                "key": "hypr.scrolling.wrap_focus",
                "type": "bool",
                "default": false,
                "label": "Wrap focus",
                "sub": "Wrap focus at the ends",
                "desc": "Moves focus to the first window when moving past the last, and the other way round.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "scrolling.wrap_focus"
                }
            }
        ]
    },
    // --- settings page 51/52 (hypr) ---
    {
        "group": "hypr",
        "id": "hyprland-advanced-dwindle",
        "label": "Dwindle",
        "icon": "layout",
        "options": [
            {
                "key": "hypr.dwindle.force_split",
                "type": "int",
                "default": 2,
                "label": "Split method",
                "sub": "Split direction rule",
                "desc": "Where a new split goes: follow the cursor, always before, or always after.",
                "values": [
                    0,
                    1,
                    2
                ],
                "valueLabels": {
                    "0": "Follow mouse",
                    "1": "Left",
                    "2": "Right"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.force_split"
                }
            },
            {
                "key": "hypr.dwindle.preserve_split",
                "type": "bool",
                "default": true,
                "label": "Preserve split",
                "sub": "Keep the first direction",
                "desc": "Keeps the original split direction when resizing, even after that window becomes the largest.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.preserve_split"
                }
            },
            {
                "key": "hypr.dwindle.smart_split",
                "type": "bool",
                "default": false,
                "label": "Smart split",
                "sub": "Split where there is room",
                "desc": "Splits the window with enough space instead of the focused one.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.smart_split"
                }
            },
            {
                "key": "hypr.dwindle.smart_resizing",
                "type": "bool",
                "default": false,
                "label": "Smart resizing",
                "sub": "Resize by layout",
                "desc": "Resizes the window that matches the layout direction rather than the one under the cursor.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.smart_resizing"
                }
            },
            {
                "key": "hypr.dwindle.permanent_direction_override",
                "type": "bool",
                "default": false,
                "label": "Direction override",
                "sub": "Keep the cursor direction",
                "desc": "Once a direction is chosen with the cursor, keeps it for later splits in the group.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.permanent_direction_override"
                }
            },
            {
                "key": "hypr.dwindle.split_width_multiplier",
                "type": "float",
                "default": 1,
                "label": "Width multiplier",
                "sub": "New window width",
                "desc": "Width of a newly created window as a fraction of its parent.",
                "range": {
                    "min": 0,
                    "max": 10
                },
                "step": 0.1,
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.split_width_multiplier"
                }
            },
            {
                "key": "hypr.dwindle.use_active_for_splits",
                "type": "bool",
                "default": false,
                "label": "Use active for splits",
                "sub": "Split from active window",
                "desc": "Splits the active window instead of the one under the cursor.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.use_active_for_splits"
                }
            },
            {
                "key": "hypr.dwindle.default_split_ratio",
                "type": "float",
                "default": 1,
                "label": "Split ratio",
                "sub": "Default split ratio",
                "desc": "Width ratio used when a window is split.",
                "range": {
                    "min": 0.1,
                    "max": 1.9
                },
                "step": 0.05,
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.default_split_ratio"
                }
            },
            {
                "key": "hypr.dwindle.split_bias",
                "type": "int",
                "default": 0,
                "label": "Split bias",
                "sub": "Favour earlier windows",
                "desc": "Which window takes the space freed by a closing split.",
                "values": [
                    0,
                    1
                ],
                "valueLabels": {
                    "0": "Directional",
                    "1": "Current window"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.split_bias"
                }
            },
            {
                "key": "hypr.dwindle.precise_mouse_move",
                "type": "bool",
                "default": false,
                "label": "Precise mouse move",
                "sub": "Accurate drag resizing",
                "desc": "Uses the raw pointer position while dragging instead of snapping to window edges.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "dwindle.precise_mouse_move"
                }
            }
        ]
    },
    // --- settings page 52/52 (hypr) ---
    {
        "group": "hypr",
        "id": "hyprland-advanced-master",
        "label": "Master",
        "icon": "layout",
        "options": [
            {
                "key": "hypr.master.orientation",
                "type": "string",
                "default": "left",
                "label": "Orientation",
                "sub": "Master placement",
                "desc": "Where the master column sits: left, right, top or bottom.",
                "values": [
                    "left",
                    "right",
                    "top",
                    "bottom",
                    "center"
                ],
                "valueLabels": {
                    "left": "Left",
                    "right": "Right",
                    "top": "Top",
                    "bottom": "Bottom",
                    "center": "Center"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.orientation"
                }
            },
            {
                "key": "hypr.master.new_status",
                "type": "string",
                "default": "slave",
                "label": "New window status",
                "sub": "New window role",
                "desc": "Whether a new window joins as a master or as a slave.",
                "values": [
                    "master",
                    "slave",
                    "inherit"
                ],
                "valueLabels": {
                    "master": "Master",
                    "slave": "Slave",
                    "inherit": "Inherit"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.new_status"
                }
            },
            {
                "key": "hypr.master.new_on_active",
                "type": "string",
                "default": "none",
                "label": "New on active",
                "sub": "Place beside focus",
                "desc": "Puts a new window beside the focused one instead of on a fixed edge.",
                "values": [
                    "before",
                    "after",
                    "none"
                ],
                "valueLabels": {
                    "before": "Before",
                    "after": "After",
                    "none": "None (boundary)"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
