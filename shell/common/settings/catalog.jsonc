                "range": {
                    "min": 0,
                    "max": 1
                },
                "step": 0.05,
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/advanced.lua",
                    "ctl": "master.mfact"
                }
            },
            {
                "key": "hypr.master.center_master_fallback",
                "type": "string",
                "default": "left",
                "label": "Center master fallback",
                "sub": "Fallback when centred",
