// Vibranium unified catalog: settings pages + menu pages in one file.
// Lives with the shell because every row is editable from the menus.
// Edit this file directly: keep `pages` for settings, `menus` for menus.
// Every settings page carries a `group` (shell|env|hypr) naming the
// store that owns it: Settings keeps shell+env, HyprlandSettings keeps
// hypr. Groups double as the namespace assertion the old per-file
// layout gave for free - a hypr key on a shell page fails to parse.
{
  "title": "Settings",
  "pages": [
    // --- settings page 1/52 (shell) ---
    {
        "group": "shell",
        "label": "General",
        "icon": "settings-general",
        "showItemCount": true,
        "items": [
            {
                "type": "separator"
            },
            {
                "type": "action",
                "label": "Edit environment",
                "sub": "Edit session environment variables",
                "icon": "file",
                "command": "vb-launch-terminal --app-id=org.vb.term -- ${EDITOR:-nvim} $XDG_CONFIG_HOME/vibranium/environment"
            },
            {
                "type": "action",
                "label": "Font selection",
                "sub": "System font",
                "icon": "font",
                "call": "fontPicker open",
                "keepOpen": true
            },
            {
                "type": "action",
                "label": "User wallpapers",
                "sub": "View and manage wallpapers",
                "icon": "file-image",
                "call": "wallpaperPicker open"
            }
        ],
        "options": [
            {
                "key": "shell.wallpaper.enabled",
                "type": "bool",
                "default": true,
                "label": "Show wallpaper",
                "sub": "Show desktop background",
                "desc": "Whether to display desktop background"
            },
            {
                "key": "shell.wallpaper.transition",
                "type": "string",
                "default": "fade",
                "label": "Transition",
                "sub": "Wallpaper swap animation",
                "desc": "How the new wallpaper replaces the old one.",
                "values": [
                    "none",
                    "fade",
                    "slide",
                    "swipe",
                    "circle",
                    "random"
                ],
                "valueLabels": {
                    "none": "None",
                    "fade": "Fade",
                    "slide": "Slide",
                    "swipe": "Swipe",
                    "circle": "Circle",
                    "random": "Random"
                },
                "showIf": [
                    {
                        "key": "shell.wallpaper.enabled",
                        "eq": true
                    },
                    {
                        "key": "hypr.animations.enabled",
                        "eq": true
                    }
                ]
            },
            {
                "key": "shell.wallpaper.transitionSpeed",
                "type": "string",
                "default": "default",
                "label": "Transition speed",
                "sub": "How fast swaps play",
                "desc": "Duration applied to every transition type.",
                "values": [
                    "slow",
                    "default",
                    "fast"
                ],
                "valueLabels": {
                    "slow": "Slow",
                    "default": "Default",
                    "fast": "Fast"
                },
                "showIf": [
                    {
                        "key": "shell.wallpaper.enabled",
                        "eq": true
                    },
                    {
                        "key": "shell.wallpaper.transition",
                        "neq": "none"
                    },
                    {
                        "key": "hypr.animations.enabled",
                        "eq": true
                    }
                ]
            },
            {
                "key": "shell.privacy.overlay",
                "type": "bool",
                "default": true,
                "label": "Privacy dots",
                "sub": "Always-visible capture indicator",
                "desc": "Draw the capture dots on their own overlay surface."
            },
            {
                "key": "shell.privacy.position",
                "type": "string",
                "default": "top-right",
                "label": "Position",
                "sub": "Corner holding the dots",
                "desc": "Which screen corner the dots sit in.",
                "values": [
                    "top-right",
                    "top-left",
                    "bottom-right",
                    "bottom-left"
                ],
                "valueLabels": {
                    "top-right": "Top right",
                    "top-left": "Top left",
                    "bottom-right": "Bottom right",
                    "bottom-left": "Bottom left"
                },
                "showIf": [
                    {
                        "key": "shell.privacy.overlay",
                        "eq": true
                    }
                ]
            },
            {
                "key": "misc.cursorTheme",
                "type": "string",
                "default": "Adwaita",
                "label": "Cursor theme",
                "values": [
                    "Adwaita"
                ],
                "valueLabels": {
                    "Adwaita": "Adwaita"
                }
            },
            {
                "key": "misc.cursorSize",
                "type": "int",
                "default": 24,
                "label": "Cursor size",
                "range": {
                    "min": 16,
                    "max": 200
                },
                "step": 1,
                "unit": " px",
                "values": [
                    16,
                    24,
                    32,
                    48
                ],
                "valueLabels": {
                    "16": "16 px",
                    "24": "24 px",
                    "32": "32 px",
                    "48": "48 px"
                }
            }
        ]
    },
    // --- settings page 2/52 (shell) ---
    {
        "group": "shell",
        "label": "App launcher",
        "icon": "grid",
        "showItemCount": true,
        "options": [
            {
                "key": "shell.launcher.searchEngine",
                "type": "string",
                "default": "duckduckgo",
                "label": "Search engine",
                "sub": "Where to search your queries",
                "desc": "What search engine to use for the search shortcut.",
                "values": [
                    "google",
                    "duckduckgo",
                    "bing",
                    "brave"
                ],
                "valueLabels": {
                    "google": "Google",
                    "duckduckgo": "DuckDuckGo",
                    "bing": "Bing",
                    "brave": "Brave"
                }
            },
            {
                "key": "shell.launcher.showIcons",
                "type": "bool",
                "default": true,
                "label": "Show icons",
                "sub": "Show/hide app icons"
            },
            {
                "key": "shell.launcher.showBadges",
                "type": "bool",
                "default": true,
                "label": "Show PWA/TUI badges",
                "sub": "Show/hide PWA & TUI badges"
            },
            {
                "key": "shell.launcher.showDescriptions",
                "type": "bool",
                "default": true,
                "label": "Show descriptions",
                "sub": "Show/hide app description"
            },
            {
                "key": "shell.launcher.sortMethod",
                "type": "string",
                "default": "alphabetical",
                "label": "Sort order (idle)",
                "sub": "Sorting method",
                "desc": "How to sort apps. Search results are always <u>by relevance</u>.",
                "values": [
                    "alphabetical",
                    "frequency"
                ],
                "valueLabels": {
                    "alphabetical": "Alphabetical",
                    "frequency": "Most used"
                }
            },
            {
                "key": "shell.launcher.autoSelect",
                "type": "bool",
                "default": false,
                "label": "Auto-select",
                "sub": "Auto-select remaining entry"
            },
            {
                "key": "shell.launcher.showClipboardSuggestion",
                "type": "bool",
                "default": true,
                "label": "Clipboard suggestion",
                "sub": "Suggest clipboard contents",
                "desc": "Suggest opening the newest copied file/path/link."
            },
            {
                "key": "APP_LAUNCHER_ALWAYS_FOCUS",
                "type": "bool",
                "default": false,
                "label": "Focus first",
                "sub": "Focus existing windows instead",
                "desc": "Focus existing windows instad of opening new instances.",
                "warning": "Sometimes it can misbehave!"
            }
        ],
        "items": [
            {
                "type": "submenu",
                "label": "Enabled plugins",
                "sub": "Toggle AppLauncher plugins",
                "icon": "list",
                "page": "launcher-enabled"
            },
            {
                "id": "clearUsageHistory",
                "type": "action",
                "icon": "remove",
                "label": "Clear usage history",
                "sub": "Erase the most-used cache",
                "after": "shell.launcher.sortMethod",
                "showIf": [
                    {
                        "key": "shell.launcher.sortMethod",
                        "eq": "frequency"
                    }
                ]
            }
        ]
    },
    // --- settings page 3/52 (shell) ---
    {
        "group": "shell",
        "id": "launcher-enabled",
        "label": "Enabled plugins",
        "icon": "list",
        "showItemCount": true,
        "options": [],
        "items": [
            {
                "id": "launcher-fx",
                "type": "toggle",
                "label": "Currency converter"
            },
            {
                "id": "launcher-unit",
                "type": "toggle",
                "label": "Unit converter"
            },
            {
                "id": "launcher-calc",
                "type": "toggle",
                "label": "Calculator"
            },
            {
                "id": "launcher-websearch",
                "type": "toggle",
                "label": "Web search"
            },
            {
                "id": "launcher-time",
                "type": "toggle",
                "label": "Timezone"
            },
            {
                "id": "launcher-color",
                "type": "toggle",
                "label": "Colors"
            }
        ]
    },
    // --- settings page 4/52 (shell) ---
    {
        "group": "shell",
        "id": "bar",
        "label": "Statusbar",
        "icon": "monitor",
        "showItemCount": true,
        "options": [
            {
                "key": "shell.statusbar.enabled",
                "type": "bool",
                "default": true,
                "label": "Show statusbar",
                "sub": "Display the top/bottom bar",
                "desc": "Master switch for the bar itself."
            },
            {
                "key": "shell.statusbar.showBorder",
                "type": "bool",
                "default": false,
                "label": "Show border",
                "sub": "Add a 1px line to the bar",
                "desc": "Adds a 1px border on the edge facing the screen.",
                "showIf": [
                    {
                        "key": "shell.statusbar.enabled",
                        "eq": true
                    }
                ]
            },
            {
                "key": "shell.statusbar.showShadow",
                "type": "bool",
                "default": true,
                "label": "Show shadow",
                "sub": "Add a soft shadow to the bar",
                "desc": "Adds a subtle shadow along the edge facing the screen.",
                "showIf": [
                    {
                        "key": "shell.statusbar.enabled",
                        "eq": true
                    }
                ]
            },
            {
                "key": "shell.statusbar.blurred",
                "type": "bool",
                "default": false,
                "label": "Transparent",
                "sub": "Make the bar background translucent",
                "desc": "Makes the bar background translucent for compositor blur.",
                "showIf": [
                    {
                        "key": "shell.statusbar.enabled",
                        "eq": true
                    }
                ]
            },
            {
                "key": "shell.statusbar.position",
                "type": "string",
                "default": "top",
                "label": "Position",
                "sub": "Which screen edge the bar sits on",
                "values": [
                    "top",
                    "bottom"
                ],
                "valueLabels": {
                    "top": "Top",
                    "bottom": "Bottom"
                },
                "showIf": [
                    {
                        "key": "shell.statusbar.enabled",
                        "eq": true
                    }
                ]
            },
            {
                "key": "shell.statusbar.layout",
                "type": "layout",
                "label": "Zone layout",
                "default": {
                    "left": [
                        "workspaces"
                    ],
                    "center": [
                        "clock"
                    ],
                    "right": [
                        "keyboardLayout",
                        "caffeine",
                        "timer",
                        "update",
                        "readingMode",
                        "recording",
                        "weather",
                        "nowPlaying",
                        "colorPicker",
                        "powerProfile",
                        "privacy",
                        "printers",
                        "archUpdates",
                        "nightLight",
                        "bluetooth",
                        "network",
                        "volume",
                        "battery",
                        "session"
                    ],
                    "disabled": [
                        "archUpdates",
                        "colorPicker",
                        "nightLight",
                        "keyboardLayout",
                        "weather",
                        "printers",
                        "privacy",
                        "nowPlaying"
                    ]
                },
                "visibility": "internal"
            },
            {
                "key": "shell.statusbar.networkRightClick",
                "type": "string",
                "default": "vb-launch-networkmanager",
                "label": "Right-click action",
                "allowEmpty": true,
                "visibility": "hidden"
            },
            {
                "key": "shell.statusbar.bluetoothRightClick",
                "type": "string",
                "default": "",
                "label": "Right-click action",
                "allowEmpty": true,
                "visibility": "hidden"
            },
            {
                "key": "shell.statusbar.workspacesRightClick",
                "type": "string",
                "default": "",
                "label": "Right-click action",
                "allowEmpty": true,
                "visibility": "hidden"
            },
            {
                "key": "shell.statusbar.trayRightClick",
                "type": "string",
                "default": "",
                "label": "Right-click action",
                "allowEmpty": true,
                "visibility": "hidden"
            },
            {
                "key": "shell.statusbar.logoutRightClick",
                "type": "string",
                "default": "",
                "label": "Right-click action",
                "allowEmpty": true,
                "visibility": "hidden"
            }
        ],
        "items": [
            {
                "type": "submenu",
                "label": "Enabled modules",
                "icon": "list",
                "page": "bar-enabled",
                "showIf": [
                    {
                        "key": "shell.statusbar.enabled",
                        "eq": true
                    }
                ]
            },
            {
                "type": "submenu",
                "label": "Module options",
                "icon": "settings",
                "page": "bar-modules",
                "showIf": [
                    {
                        "key": "shell.statusbar.enabled",
                        "eq": true
                    }
                ]
            }
        ]
    },
    // --- settings page 5/52 (shell) ---
    {
        "group": "shell",
        "id": "bar-enabled",
        "label": "Enabled modules",
        "desc": "Which static modules are shown in the bar.",
        "icon": "apps",
        "showItemCount": true,
        "options": [],
        "items": [
            {
                "id": "bar-privacy",
                "type": "toggle",
                "label": "Privacy"
            },
            {
                "id": "bar-clock",
                "type": "toggle",
                "label": "Clock"
            },
            {
                "id": "bar-keyboardLayout",
                "type": "toggle",
                "label": "Keyboard layout"
            },
            {
                "id": "bar-bluetooth",
                "type": "toggle",
                "label": "Bluetooth"
            },
            {
                "id": "bar-network",
                "type": "toggle",
                "label": "Network"
            },
            {
                "id": "bar-battery",
                "type": "toggle",
                "label": "Battery"
            },
            {
                "id": "bar-volume",
                "type": "toggle",
                "label": "Volume"
            },
            {
                "id": "bar-powerProfile",
                "type": "toggle",
                "label": "Power profile"
            },
            {
                "id": "bar-session",
                "type": "toggle",
                "label": "Power & Tray"
            },
            {
                "id": "bar-archUpdates",
                "type": "toggle",
                "label": "Arch updates"
            },
            {
                "id": "bar-colorPicker",
                "type": "toggle",
                "label": "Color picker"
            },
            {
                "id": "bar-nightLight",
                "type": "toggle",
                "label": "Night Light",
                "when": "[[ \"$CHASSIS_TYPE\" != vm ]]"
            },
            {
                "id": "bar-weather",
                "type": "toggle",
                "label": "Weather"
            },
            {
                "id": "bar-printers",
                "type": "toggle",
                "label": "Printers"
            },
            {
                "id": "bar-nowPlaying",
                "type": "toggle",
                "label": "Now Playing"
            }
        ]
    },
    // --- settings page 6/52 (shell) ---
    {
        "group": "shell",
        "id": "bar-modules",
        "label": "Module options",
        "desc": "Options of each bar module.",
        "icon": "settings",
        "showItemCount": true,
        "items": [
            {
                "type": "submenu",
                "label": "Clock",
                "page": "bar-module-clock"
            },
            {
                "type": "submenu",
                "label": "Volume",
                "page": "bar-module-volume"
            },
            {
                "type": "submenu",
                "label": "Weather",
                "page": "bar-module-weather"
            },
            {
                "type": "submenu",
                "label": "Arch updates",
                "page": "bar-module-archupdates"
            },
            {
                "type": "submenu",
                "label": "Now Playing",
                "page": "bar-module-nowplaying"
            },
            {
                "type": "submenu",
                "label": "Recording",
                "page": "bar-module-recording"
            },
            {
                "type": "submenu",
                "label": "Color Picker",
                "page": "bar-module-colorpicker"
            }
        ],
        "options": []
    },
    // --- settings page 7/52 (shell) ---
    {
        "group": "shell",
        "id": "bar-module-nowplaying",
        "label": "Now Playing",
        "desc": "Options of the bar now playing module.",
        "showItemCount": true,
        "options": [
            {
                "key": "shell.statusbar.nowPlayingTitle",
                "type": "bool",
                "default": false,
                "label": "Show track name",
                "sub": "Title next to the icon",
                "desc": "Show the track name next to the icon."
            },
            {
                "key": "shell.statusbar.nowPlayingFlash",
                "type": "bool",
                "default": true,
                "label": "Flash track name",
                "sub": "Reveal the name on track changes",
                "desc": "When enabled, the track name is briefly revealed on each track change."
            }
        ]
    },
    // --- settings page 8/52 (shell) ---
    {
        "group": "shell",
        "id": "bar-module-recording",
        "label": "Recording",
        "desc": "Options of the bar recording module.",
        "showItemCount": true,
        "options": [
            {
                "key": "shell.statusbar.recordingElapsed",
                "type": "bool",
                "default": false,
                "label": "Elapsed time pill",
                "sub": "Dot plus duration",
                "desc": "Show a pill with elapsed recording time."
            }
        ]
    },
    // --- settings page 9/52 (shell) ---
    {
        "group": "shell",
        "id": "bar-module-volume",
        "label": "Volume",
        "desc": "Options of the bar volume module.",
        "showItemCount": true,
        "options": [
            {
                "key": "shell.statusbar.volumeShowMic",
                "type": "bool",
                "default": false,
                "label": "Show microphone",
                "sub": "Always show mic pill"
            },
            {
                "key": "shell.statusbar.volumeRightClick",
                "type": "string",
                "default": "vb-shell app audioMixer",
                "label": "Right-click action",
                "sub": "Command on right-click",
                "allowEmpty": true,
                "visibility": "hidden"
            },
            {
                "key": "shell.statusbar.volumeMiddleClick",
                "type": "string",
                "default": "",
                "label": "Middle-click action",
                "sub": "Command on middle-click",
                "allowEmpty": true,
                "visibility": "hidden"
            }
        ]
    },
    // --- settings page 10/52 (shell) ---
    {
        "group": "shell",
        "id": "bar-module-clock",
        "label": "Clock",
        "desc": "Options of the bar clock module.",
        "showItemCount": true,
        "options": [
            {
                "key": "shell.statusbar.clockSeconds",
                "type": "bool",
                "default": false,
                "label": "Show seconds",
                "sub": "Display seconds",
                "desc": "Show seconds in the bar clock.",
                "warning": "Heavily affects CPU usage!"
            },
            {
                "key": "shell.statusbar.clockSecondsTooltip",
                "type": "bool",
                "default": false,
                "label": "Show in tooltip",
                "sub": "Display seconds on hover",
                "desc": "Show seconds only in the clock tooltip.",
                "showIf": [
                    {
                        "key": "shell.statusbar.clockSeconds",
                        "eq": true
                    }
                ]
            },
            {
                "key": "shell.statusbar.clockFormat",
                "type": "string",
                "default": "24",
                "label": "Time format",
                "sub": "12- or 24-hour clock",
                "desc": "How the bar clock displays the time.\n24-hour shows 21:30, 12-hour shows 09:30 PM.",
                "values": [
                    "12",
                    "24"
                ],
                "valueLabels": {
                    "12": "12-hour (AM/PM)",
                    "24": "24-hour"
                }
            },
            {
                "key": "shell.statusbar.clockFullDate",
                "type": "bool",
                "default": false,
                "label": "Show full date",
                "sub": "Date before time",
                "desc": "Show full date before time.\nMon, Sep 21 21:30."
            },
            {
                "key": "shell.statusbar.clockRightClick",
                "type": "string",
                "default": "",
                "label": "Right-click action",
                "sub": "Command on right-click",
                "allowEmpty": true,
                "visibility": "hidden"
            }
        ]
    },
    // --- settings page 11/52 (shell) ---
    {
        "group": "shell",
        "id": "bar-module-weather",
        "label": "Weather",
        "desc": "Options of the bar weather module.",
        "showItemCount": true,
        "options": [
            {
                "key": "shell.statusbar.weatherShowTemp",
                "type": "bool",
                "default": false,
                "label": "Show temperature",
                "sub": "Temperature next to the icon",
                "desc": "Show temperature next to the icon."
            },
            {
                "key": "shell.statusbar.weatherFlash",
                "type": "bool",
                "default": true,
                "label": "Flash temperature",
                "sub": "Reveal temperature on updates",
                "desc": "When enabled, the temperature is briefly revealed on each data update.",
                "showIf": [
                    {
                        "key": "shell.statusbar.weatherShowTemp",
                        "eq": false
                    }
                ]
            },
            {
                "key": "shell.statusbar.weatherUnit",
                "type": "string",
                "default": "auto",
                "label": "Units",
                "sub": "Temperature units",
                "values": [
                    "auto",
                    "metric",
                    "imperial"
                ],
                "valueLabels": {
                    "auto": "Auto",
                    "metric": "Metric (°C, km/h)",
                    "imperial": "Imperial (°F, mph)"
                }
            },
            {
                "key": "shell.statusbar.weatherRefreshMinutes",
                "type": "int",
                "default": 15,
                "label": "Refresh interval",
                "sub": "Minutes between forecasts",
                "range": {
                    "min": 5,
                    "max": 120
                },
                "step": 5,
                "unit": " min"
            },
            {
                "key": "shell.statusbar.weatherVerbose",
                "type": "bool",
                "default": false,
                "label": "Verbose forecast",
                "sub": "Per-day details"
            }
        ]
    },
    // --- settings page 12/52 (shell) ---
    {
        "group": "shell",
        "id": "bar-module-archupdates",
        "label": "Arch updates",
        "desc": "Options of the bar updates module.",
        "showItemCount": true,
        "options": [
            {
                "key": "shell.statusbar.archUpdatesHeavyWarning",
                "type": "bool",
                "default": true,
                "label": "Heavy backlog warning",
                "sub": "See description below",
                "desc": "Show the warning message when accumulating many package updates."
            }
        ]
    },
    // --- settings page 13/52 (shell) ---
    {
        "group": "shell",
        "id": "bar-module-colorpicker",
        "label": "Color Picker",
        "desc": "Options of the bar color picker module.",
        "showItemCount": true,
        "options": [
            {
                "key": "shell.colorPicker.showLastColor",
                "type": "bool",
                "default": true,
                "label": "Fill last color",
                "sub": "Fill the bar icon with last copied color"
            }
        ]
    },
    // --- settings page 14/52 (shell) ---
    {
        "group": "shell",
        "label": "Audio",
        "icon": "volume-max",
        "showItemCount": true,
        "items": [
            {
                "type": "separator"
            },
            {
                "type": "action",
                "label": "Volume mixer",
                "icon": "settings-general",
                "sub": "Open the shell's audio mixer",
                "call": "audioMixer toggle"
            }
        ],
        "options": [
            {
                "key": "shell.audio.loopback",
                "type": "bool",
                "default": false,
