        ],
        "options": [
            {
                "key": "hypr.input.natural_scroll",
                "type": "bool",
                "default": false,
                "label": "Natural scrolling",
                "sub": "Invert scroll direction",
                "desc": "Reverses the scroll direction so content moves with the pointer instead of against it.",
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/input.lua",
                    "ctl": "input.natural_scroll"
                }
            },
            {
                "key": "hypr.input.accel_profile",
                "type": "string",
                "default": "flat",
                "label": "Mouse acceleration",
                "sub": "Pointer speed curve",
                "desc": "How pointer speed responds to movement: flat keeps it proportional, adaptive speeds up fast strokes.",
                "values": [
                    "adaptive",
                    "flat"
                ],
                "valueLabels": {
                    "adaptive": "Adaptive",
                    "flat": "Flat"
                },
                "hypr": {
                    "file": "$XDG_CONFIG_HOME/hypr/hyprland.conf.d/input.lua",
