{
  NAME "Create sub"
  OPERATION Create-Printer-Subscription
  GROUP operation-attributes-tag
  ATTR charset attributes-charset utf-8
  ATTR language attributes-natural-language en
  ATTR uri printer-uri $puri
  ATTR name requesting-user-name $user
  GROUP subscription-attributes-tag
  ATTR uri notify-recipient-uri dbus://
  ATTR keyword notify-events printer-state-changed,job-state-changed,job-created,job-progress
  ATTR integer notify-lease-duration 86400
  ATTR octetString notify-user-data VB01-printers
  STATUS successful-ok
  DISPLAY notify-subscription-id
}
